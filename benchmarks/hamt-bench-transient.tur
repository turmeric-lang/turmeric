; hamt-bench-transient.tur
; Benchmark: bulk-build 100,000 entries via transient then seal
; Compare vs sequential hamt/set to verify transient is faster for bulk ops

(defn bench-transient [n :int] :int
  ```c
  void *empty = tur_hamt_new();
  void *t = tur_hamt_transient(empty);
  tur_hamt_free(empty);
  for (int64_t i = 0; i < n; i++) {
      int64_t *k = (int64_t *)malloc(sizeof(int64_t));
      int64_t *v = (int64_t *)malloc(sizeof(int64_t));
      *k = i;
      *v = i * 2;
      uint64_t h = (uint64_t)i * 2654435761ULL;
      tur_hamt_transient_set(t, (int64_t)h, (void *)k, (void *)v);
  }
  void *m = tur_hamt_persistent(t);
  int64_t count = tur_hamt_count(m);
  tur_hamt_free(m);
  return count;
  ```)

(defn main [] :int
  (let [n     100000
        count (bench-transient n)]
    (println count)
    0))
