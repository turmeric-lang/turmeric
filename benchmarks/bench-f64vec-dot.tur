;;; bench-f64vec-dot -- a dot product through the N1 kernel `f64vec-dot`.
;;
;; simd-and-vectorization-plan section 1.3's workload: two arrays of 4096
;; doubles, dotted 200,000 times (819M multiply-adds; the arrays stay in L1/L2,
;; so it is compute-bound).  Beside it: bench-vec-dot.tur, the same over two
;; `(Vec float)` read through `vec-get` (the section 1.1 shape), and
;; bench-f64vec-dot-baseline.c, plain C.  All three print the same total.
;; Results in f64vec-dot-results.md.
(load "stdlib/numvec.tur")
(load "stdlib/math.tur")

(defn reps [^borrow a : F64Vec ^borrow b : F64Vec k : int acc : float] : float
  (if (= k 0)
    acc
    (reps a b {k - 1} {acc + (f64vec-dot a b)})))

(defn main [] : int
  (let [a (f64vec-build 4096 [i] {7.1 + (int->float (mod i 13))})
        b (f64vec-build 4096 [i] {3.25 - (int->float (mod i 7))})]
    (println (reps a b 200000 0.0))
    0))
