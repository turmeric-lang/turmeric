;; Phase HKT §8: fmap-vec benchmark
;;
;; Measures the overhead of typeclass Functor.fmap dispatch over a large vec
;; compared with the monomorphic baseline in fmap-vec-baseline.c.
;;
;; The benchmark creates a vec of 1,000,000 elements and applies the
;; increment function through the typeclass dispatch mechanism.
;;
;; The class is local and Bench-prefixed: the stdlib prelude auto-loads its own
;; Functor now, so redefining it is an error and an instance of the prelude's
;; class here is an orphan (TUR-E0013).  The local class keeps what the
;; 2026-05-13 number measured against fmap-vec-baseline.c.

(defclass BenchFunctor [^f]
  (bench-fmap [container fn] :int))

;; Build a vec of n sequential integers (0..n-1) using inline C
(defn __bench_vec_build [n] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v = malloc(sizeof(*v));
  v->len = (size_t)n; v->cap = (size_t)n;
  v->data = malloc(sizeof(int64_t) * (size_t)n);
  for (size_t i = 0; i < (size_t)n; i++) v->data[i] = (int64_t)i;
  return (int64_t)(intptr_t)v;
  ```)

;; Apply fn over all elements in-place; returns number of elements processed
(defn __bench_vec_fmap_impl [container fn] :int
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *v =
      (struct { int64_t *data; size_t len; size_t cap; } *)(intptr_t)container;
  for (size_t i = 0; i < v->len; i++)
      v->data[i] = ((int64_t(*)(int64_t))(intptr_t)fn)(v->data[i]);
  return (int64_t)v->len;
  ```)

(definstance BenchFunctor [vec]
  (bench-fmap [container fn] (__bench_vec_fmap_impl container fn)))

(defn inc1 [x] :int (+ x 1))

(defn main [] :int
  (let [v (__bench_vec_build 1000000)]
    (.bench-fmap v inc1)
    0))
