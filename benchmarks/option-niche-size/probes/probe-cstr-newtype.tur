;; Probe: can a non-null cstr reach the niche through a defopaque newtype?
;; Shape copied from env/get, which already tests the raw pointer against 0.
(defopaque ^non-null Cstr! :ptr<void>)

(defn getenv-raw [name : cstr] : int
  ```c
  const char *v = getenv(name);
  return (int64_t)(intptr_t)v;
  ```)

(defn env-get [name : cstr] : (Option Cstr!)
  (let [v (getenv-raw name)]
    (if (= v 0) (none) (some (:: v Cstr!)))))

(defn main [] : int
  (let [o (env-get "PATH")
        m (env-get "TUR_DEFINITELY_UNSET_XYZZY")]
    (if (some? o) (println "PATH: some") (println "PATH: none"))
    (if (some? m) (println "unset: some") (println "unset: none"))
    0))
