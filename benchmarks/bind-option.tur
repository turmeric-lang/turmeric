;; Phase HKT §8: bind-option benchmark
;;
;; Measures the overhead of typeclass Monad.bind dispatch over a chain of
;; option values compared with the monomorphic baseline in bind-option-baseline.c.
;;
;; The benchmark chains N bind operations: some(0) >>= (+1) >>= (+1) >>= ../..
;; using a loop with a mutable accumulator.
;;
;; The classes are local and Bench-prefixed: the stdlib prelude auto-loads its
;; own Applicative and Monad now, and redefining them is an error.  Keeping a
;; local one-method class preserves what the 2026-05-13 number measured --
;; dispatch through a dictionary over an erased word, against the C baseline.

(defclass BenchApplicative [^f]
  (bench-pure [a] :int))

(defclass BenchMonad [^m]
  (bench-bind [m f] :int))

;; Option helpers — plain calling convention (non-capturing lambdas)
(defn __bench_opt_some [v] :int
  ```c
  int64_t *p = malloc(sizeof(int64_t) * 2);
  p[0] = 1; p[1] = v;
  return (int64_t)(intptr_t)p;
  ```)

(defn __bench_opt_none [] :int
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  p[0] = 0;
  return (int64_t)(intptr_t)p;
  ```)

(defn __bench_opt_bind [m f] :int
  ```c
  int64_t *p = (int64_t *)(intptr_t)m;
  if (p[0] == 0) return m;
  return ((int64_t(*)(int64_t))(intptr_t)f)(p[1]);
  ```)

(defn __bench_opt_pure [a] :int (__bench_opt_some a))

(defn __bench_opt_val [m] :int
  ```c
  int64_t *p = (int64_t *)(intptr_t)m; return p[1];
  ```)

(definstance BenchApplicative [option] (bench-pure [a] (__bench_opt_pure a)))
(definstance BenchMonad [option] (bench-bind [m f] (__bench_opt_bind m f)))

;; The function applied at each bind step: increment the value
(defn add1 [x] :int (__bench_opt_some (+ x 1)))

(defn main [] :int
  (let [^mut acc (__bench_opt_some 0)]
    (let [^mut i 0]
      (while (< i 100000)
        (set! acc (.bench-bind acc add1))
        (set! i (+ i 1))))
    ;; Print final value (should be 100000) to prevent dead-code elimination
    (println (__bench_opt_val acc)))
  0)
