;; Phase B5: Logic query benchmark
;;
;; Simulates a miniKanren-style logic query using the backtracking monad.
;; Searches for all pairs (x, y) where x + y = 20, x in 1..10.
;; Benchmark: run 10000 iterations of this search.

(defn mzero [] :int
  ```c return 0; ```)

(defn mreturn [x] :int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x;
  cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)

(defn mplus [xs ys] :int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  if (!xc) return ys;
  Cell *head = NULL, *tail = NULL;
  while (xc) {
      Cell *n = malloc(sizeof(Cell));
      n->value = xc->value; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n;
      xc = (Cell*)(intptr_t)xc->next;
  }
  if (tail) tail->next = ys;
  return (int64_t)(intptr_t)head;
  ```)

(defn bt-count [xs] :int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs; int64_t n = 0;
  while (c) { n++; c = (Cell*)(intptr_t)c->next; }
  return n;
  ```)

(defn bt-free [xs]
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) { Cell *nx = (Cell*)(intptr_t)c->next; free(c); c = nx; }
  ```)

;; Find all (x, y) where x + y = target, x in 1..max_x
;; Returns encoded pairs as x * 100 + y (assumes y < 100)
(defn logic-query [target max-x] :int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *result = NULL, *tail = NULL;
  for (int64_t x = 1; x <= max_x; x++) {
      int64_t y = target - x;
      if (y >= 1 && y <= max_x) {
          Cell *c = malloc(sizeof(Cell));
          c->value = x * 100 + y; c->next = 0;
          if (tail) tail->next = (int64_t)(intptr_t)c; else result = c;
          tail = c;
      }
  }
  return (int64_t)(intptr_t)result;
  ```)

;; The driver loop is Turmeric, not inline C: it used to call `logic_query`
;; from a C body by guessing the emitter's mangling of `logic-query`, which
;; stopped linking when the mangling changed.  Calling it from Turmeric lets
;; the compiler resolve the name.
(defn main [] :int
  (let [^mut total 0]
    (let [^mut iter 0]
      (while (< iter 10000)
        (let [results (logic-query 20 19)]
          (set! total (+ total (bt-count results)))
          (bt-free results))
        (set! iter (+ iter 1))))
    (println (/ total 10000)))
  0)
