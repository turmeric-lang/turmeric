{
  "app": "npx ts-node --prefer-ts-exts bin/bench-box.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules"
    ]
  },
  "context": {
    "instanceType": "m7i.xlarge",
    "arch": "x86_64",
    "diskGb": 80,
    "gitRef": "main",
    "repoUrl": "https://github.com/turmeric-lang/turmeric.git",
    "maxUptimeHours": 8,
    "permissionsBoundaryName": "TurmericBenchBoxInstanceBoundary",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws",
      "aws-cn"
    ],
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": false,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-ec2:ebsDefaultGp3Volume": true,
    "@aws-cdk/aws-ec2:launchTemplateDefaultUserData": true,
    "@aws-cdk/core:bootstrapQualifier": "benchbox"
  }
}
