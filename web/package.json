{
  "name": "try-turmeric",
  "version": "0.1.0",
  "description": "Try Turmeric - Web-based REPL for the Turmeric language",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --config dist/try_turmeric/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/try_turmeric/wrangler.json",
    "test": "playwright test",
    "test:prod": "playwright test --config playwright.config.prod.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-static": "^1.49.0",
    "monaco-editor": "^0.45.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.1",
    "wrangler": "^4.93.0"
  },
  "keywords": [
    "turmeric",
    "lisp",
    "repl",
    "webassembly"
  ],
  "author": "Turmeric Language Team",
  "license": "MIT"
}
