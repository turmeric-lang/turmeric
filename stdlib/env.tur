;;; tur/env -- environment variable access (getenv, setenv, unsetenv).
;;;
;;; Thin wrappers plus a convenience all-env snapshot.
;;;
;;; Since: Phase B1
;; stdlib/env.tur -- environment variable access.
;;
;; Thin wrappers around getenv/setenv/unsetenv and a convenience
;; cons-list snapshot of the whole environment via environ(7).
(load "stdlib/effects.tur")
;; stdlib-effect-rows: env/* entry points read or mutate process environment
;; state, so each carries the #{Proc} capability tag.
;;; env/get -- look up an environment variable by name.
;;;
;;; Parameters:
;;;   name -- the variable name as a NUL-terminated cstr (e.g., "HOME")
;;;
;;; Returns:
;;;   A some option whose int64_t value is the cstr pointer, or none if
;;;   the variable is not set.  The returned pointer is owned by the
;;;   OS environment; do not free it.
;;;
;;; Example:
;;;   (env/get "HOME")  ; => some(<cstr ptr>)
;;;
;;; Since: Phase B2

(defn env/get-raw [name : cstr]
  #fx{Proc}
  : int
  ```c
  const char *v = getenv(name);
  return (int64_t)(intptr_t)v;
  ```)
;;; env/get -- by-value: some(value cstr) if set, none otherwise.

(defn env/get [name : cstr]
  #fx{Proc}
  : (Option cstr)
  (let [v (env/get-raw name)] (if (= v 0) (none) (some (:: v :cstr)))))
;;; env/get! -- look up an environment variable, panicking if missing.
;;;
;;; Parameters:
;;;   name -- the variable name as a NUL-terminated cstr
;;;
;;; Returns:
;;;   The value cstr.  Panics if the variable is not set.
;;;
;;; Example:
;;;   (env/get! "HOME")  ; => "/home/user"  ; doctest: value depends on the environment
;;;
;;; Since: Phase B2

(defn env/get! [name : cstr]
  #fx{Proc}
  : cstr
  ```c
  const char *v = getenv(name);
  if (!v) { fprintf(stderr, "env/get!: variable not set: %s\n", name); abort(); }
  return v;
  ```)
;;; env/set -- set an environment variable.
;;;
;;; Parameters:
;;;   name  -- variable name cstr
;;;   value -- new value cstr
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (env/set "MY_VAR" "hello")  ; => 0
;;;
;;; Since: Phase B2

(defn env/set [name : cstr value : cstr]
  #fx{Proc}
  : int
  ```c
  return (int64_t)setenv(name, value, 1);
  ```)
;;; env/unset -- unset an environment variable.
;;;
;;; Parameters:
;;;   name -- variable name cstr
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (env/unset "MY_VAR")  ; => 0
;;;
;;; Since: Phase B2

(defn env/unset [name : cstr]
  #fx{Proc}
  : int
  ```c
  return (int64_t)unsetenv(name);
  ```)
;;; env/all -- return all environment variables as "KEY=VALUE" strings.
;;;
;;; Returns:
;;;   A (Vec cstr) of fresh strdup'd "KEY=VALUE" strings, in environ order.
;;;   The caller owns it: release it with env/all-free.
;;;
;;; Example:
;;;   (let [v (env/all)] (println (vec-len v)) (env/all-free v))
;;;
;;; Since: Phase B2
(defn env/all []
  #fx{Proc}
  : (Vec cstr)
  ```c
  extern char **environ;
  /* stdlib-os-surface-plan P1.3: the (Vec cstr) header layout every Vec
   * producer shares (stdlib/vec.tur), instead of an untyped cons list. */
  struct __tur_vec { int64_t *data; int64_t len; int64_t cap; };
  struct __tur_vec *v = (struct __tur_vec *)malloc(sizeof *v);
  int64_t n = 0;
  while (environ[n]) n++;
  v->len = 0;
  v->cap = n ? n : 1;
  v->data = (int64_t *)malloc((size_t)v->cap * sizeof(int64_t));
  for (int64_t i = 0; i < n && v->data; i++)
    v->data[v->len++] = (int64_t)(intptr_t)strdup(environ[i]);
  return (int64_t)(intptr_t)v;
  ```)
;;; env/all-free -- free a (Vec cstr) returned by env/all.
;;;
;;; Parameters:
;;;   v -- the vector returned by env/all (every string and the Vec itself
;;;        are released)
;;;
;;; Example:
;;;   (env/all-free my-env)
;;;
;;; Since: Phase B2
(defn env/all-free [v : (Vec cstr)] : void
  ```c
  struct __tur_vec { int64_t *data; int64_t len; int64_t cap; };
  struct __tur_vec *h = (struct __tur_vec *)(intptr_t)v;
  if (!h) return;
  for (int64_t i = 0; i < h->len; i++) free((void *)(intptr_t)h->data[i]);
  free(h->data);
  free(h);
  ```)
;;; env/home -- return the HOME environment variable, if set.
;;;
;;; Returns:
;;;   some(value) holding the home directory as a cstr owned by the OS
;;;   environment (do not free it), or none when HOME is unset.
;;;
;;; Example:
;;;   (env/home)  ; => some("/home/user")  ; doctest: value depends on the environment
;;;
;;; Since: Phase B2

(defn env/home [] #fx{Proc} : (Option cstr) (env/get "HOME"))
;;; env/path -- return the PATH environment variable, if set.
;;;
;;; Returns:
;;;   some(value) holding the executable search path as a cstr owned by the OS
;;;   environment (do not free it), or none when PATH is unset.
;;;
;;; Example:
;;;   (env/path)  ; => some("/usr/bin:/bin:/usr/local/bin")  ; doctest: value depends on the environment
;;;
;;; Since: Phase B2

(defn env/path [] #fx{Proc} : (Option cstr) (env/get "PATH"))
;;; env/user -- return the USER environment variable, if set.
;;;
;;; Returns:
;;;   some(value) holding the login name as a cstr owned by the OS
;;;   environment (do not free it), or none when USER is unset.
;;;
;;; Example:
;;;   (env/user)  ; => some("alice")  ; doctest: value depends on the environment
;;;
;;; Since: Phase B2

(defn env/user [] #fx{Proc} : (Option cstr) (env/get "USER"))
;;; env/shell -- return the SHELL environment variable, if set.
;;;
;;; Returns:
;;;   some(value) holding the login shell as a cstr owned by the OS
;;;   environment (do not free it), or none when SHELL is unset.
;;;
;;; Example:
;;;   (env/shell)  ; => some("/bin/bash")  ; doctest: value depends on the environment
;;;
;;; Since: Phase B2

(defn env/shell [] #fx{Proc} : (Option cstr) (env/get "SHELL"))
