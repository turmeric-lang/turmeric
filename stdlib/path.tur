;;; tur/path -- pure path-string manipulation (join, dirname, basename, extension).
;;;
;;; No syscalls; all functions operate on NUL-terminated cstr values.
;;;
;;; Since: Phase B1
;; stdlib/path.tur -- pure path string manipulation.
;;
;; No syscalls; all functions operate on NUL-terminated cstr values and
;; return freshly allocated cstr values that the caller must free.
;;; path/join -- join two path segments with a single slash separator.
;;;
;;; Parameters:
;;;   base    -- the base path cstr
;;;   segment -- the path segment to append
;;;
;;; Returns:
;;;   A new heap-allocated cstr.  Free when done.
;;;   If base ends with '/' no extra separator is added.
;;;
;;; Example:
;;;   (path/join "/usr" "local")  ; => "/usr/local"
;;;
;;; Since: Phase B2
(defn path/join [base : cstr segment : cstr] : cstr
  ```c
  size_t blen = strlen(base);
  size_t slen = strlen(segment);
  int add_sep = (blen > 0 && base[blen - 1] != '/') ? 1 : 0;
  char *out = malloc(blen + add_sep + slen + 1);
  memcpy(out, base, blen);
  if (add_sep) out[blen] = '/';
  memcpy(out + blen + add_sep, segment, slen + 1);
  return out;
  ```)
;;; path/basename -- return the last path component.
;;;
;;; Parameters:
;;;   p -- path cstr
;;;
;;; Returns:
;;;   A new heap-allocated cstr containing the last component.
;;;   Returns a copy of p if no slash is present.
;;;
;;; Example:
;;;   (path/basename "/foo/bar.txt")  ; => "bar.txt"
;;;
;;; Since: Phase B2

(defn path/basename [p : cstr] : cstr
  ```c
  const char *last = strrchr(p, '/');
  const char *name = last ? last + 1 : p;
  return strdup(name);
  ```)
;;; path/dirname -- return the parent directory component.
;;;
;;; Parameters:
;;;   p -- path cstr
;;;
;;; Returns:
;;;   A new heap-allocated cstr of the parent directory.
;;;   Returns "." if no directory component exists, "/" for the root.
;;;
;;; Example:
;;;   (path/dirname "/foo/bar.txt")  ; => "/foo"
;;;
;;; Since: Phase B2

(defn path/dirname [p : cstr] : cstr
  ```c
  const char *last = strrchr(p, '/');
  if (!last) return strdup(".");
  if (last == p) return strdup("/");
  size_t len = (size_t)(last - p);
  char *out = malloc(len + 1);
  memcpy(out, p, len);
  out[len] = '\0';
  return out;
  ```)
;;; path/extension -- return the file extension including the leading dot.
;;;
;;; Parameters:
;;;   p -- path cstr
;;;
;;; Returns:
;;;   A new heap-allocated cstr of the extension (e.g., ".txt"), or an
;;;   empty string heap-copy if there is no extension.
;;;
;;; Example:
;;;   (path/extension "/foo/bar.txt")  ; => ".txt"
;;;   (path/extension "/foo/bar")      ; => ""
;;;
;;; Since: Phase B2

(defn path/extension [p : cstr] : cstr
  ```c
  const char *base = strrchr(p, '/');
  base = base ? base + 1 : p;
  const char *dot = strrchr(base, '.');
  if (!dot || dot == base) return strdup("");
  return strdup(dot);
  ```)
;;; path/stem -- return the filename without its extension.
;;;
;;; Parameters:
;;;   p -- path cstr
;;;
;;; Returns:
;;;   A new heap-allocated cstr of the stem.  Equal to path/basename if
;;;   there is no extension.
;;;
;;; Example:
;;;   (path/stem "/foo/bar.txt")  ; => "bar"
;;;   (path/stem "/foo/bar")      ; => "bar"
;;;
;;; Since: Phase B2

(defn path/stem [p : cstr] : cstr
  ```c
  const char *base = strrchr(p, '/');
  base = base ? base + 1 : p;
  const char *dot = strrchr(base, '.');
  if (!dot || dot == base) return strdup(base);
  size_t len = (size_t)(dot - base);
  char *out = malloc(len + 1);
  memcpy(out, base, len);
  out[len] = '\0';
  return out;
  ```)
;;; path/absolute? -- test whether a path is absolute (starts with '/').
;;;
;;; Parameters:
;;;   p -- path cstr
;;;
;;; Returns:
;;;   true if p starts with '/', false otherwise.
;;;
;;; Example:
;;;   (path/absolute? "/usr/bin")  ; => true
;;;   (path/absolute? "relative")  ; => false
;;;
;;; Since: Phase B2

(defn path/absolute? [p : cstr] : bool
  ```c
  return p != NULL && p[0] == '/';
  ```)
;;; path/normalize -- collapse redundant '.' and '..' segments in a path.
;;;
;;; Resolves single-dot and double-dot components without consulting the
;;; filesystem.  Does not resolve symlinks.
;;;
;;; Parameters:
;;;   p -- path cstr
;;;
;;; Returns:
;;;   A new heap-allocated normalized path cstr.
;;;
;;; Example:
;;;   (path/normalize "/foo/../bar/./baz")  ; => "/bar/baz"
;;;
;;; Since: Phase B2

(defn path/normalize [p : cstr] : cstr
  ```c
  /* Splits on '/' by hand rather than with strtok.
   *
   * strtok is unusable here on the JIT path: c2mir does not pick up its
   * declaration from the MinGW headers, so the call falls back to an implicit
   * `int` return and the 64-bit pointer comes back truncated to 32 bits and
   * sign-extended -- non-NULL, so a loop that only counts tokens looks correct,
   * and a crash the moment one is dereferenced.  Measured: strstr, strchr,
   * strrchr and getenv all return intact pointers in the same translation unit;
   * only strtok truncates.  docs/archive/jit-c2mir-implicit-decl-truncates-pointers.md
   *
   * Hand-splitting also drops strtok's static cursor, which was never
   * thread-safe. */
  size_t plen = strlen(p);
  char *work = malloc(plen + 2);
  if (!work) return NULL;
  memcpy(work, p, plen + 1);
  int is_abs = (work[0] == '/');

  char **segs = malloc((plen + 2) * sizeof(char *));
  if (!segs) { free(work); return NULL; }
  int nseg = 0;

  char *cur = work;
  while (*cur) {
    while (*cur == '/') cur++;          /* skip run of separators */
    if (!*cur) break;
    char *seg = cur;
    while (*cur && *cur != '/') cur++;
    if (*cur) *cur++ = '\0';            /* terminate this segment */
    if (strcmp(seg, ".") == 0) {
      /* current-dir component: drop */
    } else if (strcmp(seg, "..") == 0) {
      if (nseg > 0) nseg--;
    } else {
      segs[nseg++] = seg;
    }
  }

  char *out = malloc(plen + 4);
  if (!out) { free(work); free(segs); return NULL; }
  size_t pos = 0;
  if (is_abs) out[pos++] = '/';
  for (int i = 0; i < nseg; i++) {
    if (i > 0) out[pos++] = '/';
    size_t slen = strlen(segs[i]);
    memcpy(out + pos, segs[i], slen);
    pos += slen;
  }
  if (pos == 0) out[pos++] = '.';
  out[pos] = '\0';
  free(work);
  free(segs);
  return out;
  ```)
