;;; tur/grid -- typed Grid[A]: 2D row-major grid parameterized over element type A.
;;;
;;; Runtime layout: { int64_t *data; int width; int height; int cx; int cy; }.
;;;
;;; Since: Phase TC2-A
;; Phase TC2-A: Typed Grid[A]
;; 2D row-major grid parameterized over element type A.
;; Runtime layout: { int64_t *data; int width; int height; int cx; int cy; }
;;; Grid -- parameterized 2D grid with element type A.
;;;
;;; Since: Phase TC2
(defstruct Grid
  [A]
  (data :ptr<void>)
  (width :int)
  (height :int)
  (cx :int)
  (cy :int))
;;; grid-new -- create a new zero-filled Grid[A].
;;;
;;; Parameters:
;;;   width  -- number of columns
;;;   height -- number of rows
;;;
;;; Returns:
;;;   A new Grid[A] with all elements initialized to 0.
;;;
;;; Example:
;;;   (grid-new 8 8)  ; => 8x8 grid
;;;
;;; Since: Phase TC2

;; The header stores int dimensions, so they must fit one; width * height was
;; unchecked, and a failed calloc left NULL data behind a live handle
;; (security audit WP5, M-5).
(defn grid-new [width : int height : int]
  #fx{}
  : int
  ```c
  if (width < 0 || height < 0 || width > INT32_MAX || height > INT32_MAX ||
      (height > 0 && (uint64_t)width > (SIZE_MAX / sizeof(int64_t)) / (uint64_t)height)) {
    fprintf(stderr, "grid-new: dimensions %lldx%lld out of range\n",
            (long long)width, (long long)height);
    exit(1);
  }
  struct { int64_t *data; int width; int height; int cx; int cy; } *g = malloc(sizeof(*g));
  if (!g) { fprintf(stderr, "grid-new: out of memory\n"); exit(1); }
  g->width  = (int)width;
  g->height = (int)height;
  g->cx = 0;
  g->cy = 0;
  g->data = calloc((size_t)width * (size_t)height, sizeof(int64_t));
  if (!g->data && width > 0 && height > 0) { fprintf(stderr, "grid-new: out of memory\n"); exit(1); }
  return (int64_t)(intptr_t)g;
  ```)
;;; grid-get -- return the element at (x, y).
;;;
;;; Parameters:
;;;   g -- Grid[A]
;;;   x -- column index
;;;   y -- row index
;;;
;;; Returns:
;;;   The element of type A at (x, y).
;;;
;;; Example:
;;;   (grid-get g 0 0)  ; => element at (0,0)
;;;
;;; Since: Phase TC2

;; No bounds check used to stand here: any (x, y) was a wild read from a
;; `#fx{}` function (security audit WP5).
(defn grid-get [g : int x : int y : int]
  #fx{}
  : int
  ```c
  struct { int64_t *data; int width; int height; int cx; int cy; } *grid = (void*)(intptr_t)g;
  if (x < 0 || y < 0 || x >= grid->width || y >= grid->height) {
    char __m[128];
    snprintf(__m, sizeof __m, "grid-get: (%lld, %lld) out of bounds in %dx%d",
             (long long)x, (long long)y, grid->width, grid->height);
    tur_panic(__m);
    return 0;
  }
  return (int64_t)grid->data[(size_t)(y * grid->width + x)];
  ```)
;;; grid-set! -- set the element at (x, y).
;;;
;;; Parameters:
;;;   g -- Grid[A]
;;;   x -- column index
;;;   y -- row index
;;;   v -- new element value of type A
;;;
;;; Example:
;;;   (grid-set! g 0 0 1)
;;;
;;; Since: Phase TC2

;; As grid-get: an unchecked (x, y) was a wild write.
(defn grid-set! [g : int x : int y : int v : int]
  #fx{}
  : void
  ```c
  struct { int64_t *data; int width; int height; int cx; int cy; } *grid = (void*)(intptr_t)g;
  if (x < 0 || y < 0 || x >= grid->width || y >= grid->height) {
    char __m[128];
    snprintf(__m, sizeof __m, "grid-set!: (%lld, %lld) out of bounds in %dx%d",
             (long long)x, (long long)y, grid->width, grid->height);
    tur_panic(__m);
    return;
  }
  TUR_REGION_NOTE(v);   /* region-lock-hardening: see vec-push! */
  grid->data[(size_t)(y * grid->width + x)] = v;
  ```)
;;; grid-width -- return the width of a Grid[A].
;;;
;;; Parameters:
;;;   g -- Grid[A]
;;;
;;; Returns:
;;;   Width (number of columns).
;;;
;;; Example:
;;;   (grid-width g)  ; => 8
;;;
;;; Since: Phase TC2

(defn grid-width [g : int]
  #fx{}
  : int
  ```c
  struct { int64_t *data; int width; int height; int cx; int cy; } *grid = (void*)(intptr_t)g;
  return (int64_t)grid->width;
  ```)
;;; grid-height -- return the height of a Grid[A].
;;;
;;; Parameters:
;;;   g -- Grid[A]
;;;
;;; Returns:
;;;   Height (number of rows).
;;;
;;; Example:
;;;   (grid-height g)  ; => 8
;;;
;;; Since: Phase TC2

(defn grid-height [g : int]
  #fx{}
  : int
  ```c
  struct { int64_t *data; int width; int height; int cx; int cy; } *grid = (void*)(intptr_t)g;
  return (int64_t)grid->height;
  ```)
;;; grid-free -- free a Grid[A] and its data buffer.
;;;
;;; Parameters:
;;;   g -- Grid[A] to free
;;;
;;; Example:
;;;   (grid-free g)
;;;
;;; Since: Phase TC2

(defn grid-free [g : int]
  #fx{}
  : void
  ```c
  struct { int64_t *data; int width; int height; int cx; int cy; } *grid = (void*)(intptr_t)g;
  if (grid->data) free(grid->data);
  free(grid);
  ```)
