;;; tur/range -- Range: continuous interval with inclusive, exclusive, or unbounded ends.
;;;
;;; Supports integer iteration and containment tests.
;;;
;;; Since: Phase LZ4
;; stdlib/range.tur -- Range type (LZ4)
;;
;; A Range represents a continuous interval with inclusive, exclusive, or
;; unbounded endpoints.  It is a value type (not a Seq), but integer ranges
;; can be converted to a Seq via seq/from-range or seq/from-range-step.
;;
;; Internal representation
;;   Bound:      a `:copy` sum -- Inclusive v / Exclusive v / Unbounded
;;               (range-gadt-typeclass-migration-plan B1); there is no null
;;               sentinel, the Unbounded constructor is total.  It goes by
;;               value: a tag and the endpoint, no allocation.
;;   Range:      a `:copy` record of two Bounds, also by value
;;               (adt-gadt-unification-plan slice 3; it was a malloc'd
;;               `struct { int64_t lower; int64_t upper; }` handed around as
;;               an `:int`).
;;
;; All consumers that iterate integers load stdlib/seq/core.tur.  The file
;; does NOT auto-load seq; fixtures that need seq/from-range must load
;; stdlib/seq/core.tur (or any seq layer) before or after this file.
(load "stdlib/seq/core.tur")
;; Eq is auto-loaded (typeclass-eq.tur), but Show and Ord live only in the full
;; stdlib/typeclass.tur. Pull it in so the Show/Ord [Bound] instances below can
;; be declared in Bound's own module (the orphan rule keeps them here, alongside
;; Eq [Bound]). This is safe now that definstance is idempotent -- the primitive
;; instances typeclass.tur shares with the auto-loaded partial stubs
;; (Clone [int], ...) dedupe instead of colliding; see
;; docs/archive/history/load-not-idempotent-typeclass.md. range.tur is on-demand (not
;; auto-loaded, not pulled by `for`/`#r{}`), so the extra instances reach only
;; programs that actually use ranges. (range-gadt-typeclass-migration-plan B2.)

(load "stdlib/typeclass.tur")
;; -------------------------------------------------------------------
;; Bound and accessors
;; -------------------------------------------------------------------
;;; Bound -- a range endpoint: inclusive, exclusive, or unbounded.
;;;
;;; The internal endpoint representation (range-gadt-typeclass-migration-plan
;;; B1).  Declared `:copy` so a shared endpoint can be read by many predicates
;;; without affine move tracking complaining; see
;;; docs/archive/history/defgadt-copy-and-shared-bounds.md.
;;;
;;; It was `(defgadt Bound [A] ...)` with every constructor returning `(Bound
;;; int)`: the parameter was pinned to `int` and never used, so it is gone
;;; (adt-gadt-unification-plan slice 3).  A parametric type's bare name is the
;;; uniform carrier, so the phantom parameter alone kept every endpoint a
;;; malloc'd cell.
;;;
;;; Since: LZ4 (sum form: range-gadt-typeclass-migration-plan B1)

(defdata Bound :copy (Inclusive int) (Exclusive int) (Unbounded))
;;; range-bound-new -- build a Bound with given inclusivity and value.
;;;
;;; Parameters:
;;;   inclusive -- 1 for inclusive, 0 for exclusive
;;;   value     -- the endpoint value
;;;
;;; Returns:
;;;   A Bound: Inclusive when inclusive=1, else Exclusive.
;;;
;;; Since: LZ4


(defn range-bound-new [inclusive : int value : int] : Bound
  (if (= inclusive 1) (Inclusive value) (Exclusive value)))
;;; bound-unbounded? -- true if the endpoint is the Unbounded constructor.
;;;
;;; Parameters:
;;;   b -- a Bound
;;;
;;; Since: range-gadt-typeclass-migration-plan B1

(defn bound-unbounded? [b : Bound] : bool
  (match b (Inclusive _) false (Exclusive _) false (Unbounded) true))
;;; range-bound-inclusive? -- true if the bound is inclusive.
;;;
;;; Parameters:
;;;   b -- a Bound (must not be Unbounded)
;;;
;;; Since: LZ4

(defn range-bound-inclusive? [b : Bound] : bool
  (match b (Inclusive _) true (Exclusive _) false (Unbounded) false))
;;; range-bound-value -- return the endpoint value of a bound.
;;;
;;; Parameters:
;;;   b -- a Bound (Unbounded yields 0)
;;;
;;; Since: LZ4

(defn range-bound-value [b : Bound] : int
  (match b (Inclusive v) v (Exclusive v) v (Unbounded) 0))
;;; range-bound-flip -- return a new bound with the same value but flipped inclusivity.
;;;
;;; Parameters:
;;;   b -- a Bound (must not be Unbounded)
;;;
;;; Since: LZ4

(defn range-bound-flip [b : Bound] : Bound
  (match b
    (Inclusive v)
    (Exclusive v)
    (Exclusive v)
    (Inclusive v)
    (Unbounded)
    (Unbounded)))
;;; Eq [Bound] -- structural equality on range endpoints.
;;;
;;; Two bounds are equal when they share the same constructor and (for
;;; Inclusive / Exclusive) the same value.  The Eq typeclass is auto-loaded, so
;;; this instance adds no new dependency to range.tur's wide auto-load path
;;; (range-gadt-typeclass-migration-plan B2).
;;;
;;; Example:
;;;   (.eq? (Inclusive 3) (Inclusive 3))  ; => true
;;;   (.eq? (Inclusive 3) (Exclusive 3))  ; => false
;;;
;;; Since: range-gadt-typeclass-migration-plan B2

(definstance Eq [Bound]
  (eq? [x y]
    (match x
      (Inclusive a)
      (match y (Inclusive b) (= a b) (Exclusive _) false (Unbounded) false)
      (Exclusive a)
      (match y (Inclusive _) false (Exclusive b) (= a b) (Unbounded) false)
      (Unbounded)
      (match y (Inclusive _) false (Exclusive _) false (Unbounded) true))))
;; bound-show-fmt -- inline-C formatter for a single inclusive/exclusive
;; endpoint: "[v" (kind 1) or "(v" (kind 2).  Backs Show [Bound].

(defn bound-show-fmt [kind : int v : int] : cstr
  ```c
  char *buf = (char *)malloc(32);
  if (kind == 1) snprintf(buf, 32, "[%lld", (long long)v);
  else           snprintf(buf, 32, "(%lld", (long long)v);
  return (const char *)buf;
  ```)
;;; Show [Bound] -- render a lone endpoint: "[v" (Inclusive), "(v" (Exclusive),
;;; or "unbounded".  This is the lower-side bracket form for a single endpoint;
;;; use range->str for a full interval like "[1, 5)".
;;;
;;; Show lives in stdlib/typeclass.tur, loaded at the top of this file, so this
;;; instance can sit in Bound's own module as the orphan rule requires.
;;;
;;; Example:
;;;   (show (Inclusive 3))  ; => "[3"
;;;   (show (Unbounded))    ; => "unbounded"
;;;
;;; Since: range-gadt-typeclass-migration-plan B2
;;; Show [Bound] -- render a lone endpoint as an owned String: "[v" (Inclusive),
;;; "(v" (Exclusive), or "unbounded".  Mixed borrow/malloc: the bracket arms
;;; adopt the bound-show-fmt malloc (leak-free), the Unbounded arm copies the
;;; borrowed literal via from-cstr.


(definstance Show [Bound]
  (show [x]
    (match x
      (Inclusive v)
      (string/adopt-cstr (bound-show-fmt 1 v))
      (Exclusive v)
      (string/adopt-cstr (bound-show-fmt 2 v))
      (Unbounded)
      (string/from-cstr "unbounded"))))
;;; bound-lt? -- strict total order on Bound endpoints, backing Ord [Bound].
;;;
;;; Orders endpoints by position on the number line: Unbounded is the least
;;; element (an open end extends past every bound), endpoints sort by value
;;; ascending, and at an equal value an Inclusive endpoint precedes an Exclusive
;;; one (the inclusive end covers its boundary point, so it lies "to the left").
;;; This is a standalone total order; the directional set-operation selectors
;;; (range-lower-min / range-upper-max / ...) keep their own context-specific
;;; tie-breaking because "unbounded" means -inf on a lower side and +inf on an
;;; upper side -- a distinction a lone Bound cannot carry.
;;;
;;; Parameters:
;;;   x -- the left Bound
;;;   y -- the right Bound
;;;
;;; Returns:
;;;   true when x sorts strictly before y.
;;;
;;; Example:
;;;   (bound-lt? (Unbounded) (Inclusive 0))    ; => true
;;;   (bound-lt? (Inclusive 5) (Exclusive 5))  ; => true
;;;
;;; Since: range-gadt-typeclass-migration-plan B2

(defn bound-lt? [x : Bound y : Bound] : bool
  (match x
    (Unbounded)
    (match y (Unbounded) false (Inclusive _) true (Exclusive _) true)
    (Inclusive a)
    (match y
      (Unbounded)
      false
      (Inclusive b)
      (< a b)
      (Exclusive b)
      (if (= a b) true (< a b)))
    (Exclusive a)
    (match y
      (Unbounded)
      false
      (Inclusive b)
      (if (= a b) false (< a b))
      (Exclusive b)
      (< a b))))
;;; Ord [Bound] -- total ordering on endpoints (see bound-lt? for semantics).

(definstance Ord [Bound]
  (lt? [x y] (bound-lt? x y))
  (lte? [x y] (not (bound-lt? y x)))
  (gt? [x y] (bound-lt? y x))
  (gte? [x y] (not (bound-lt? x y))))
;; -------------------------------------------------------------------
;; Range and accessors
;; -------------------------------------------------------------------
;;; Range -- a continuous interval: a lower and an upper Bound.
;;;
;;; A `:copy` value, so one range can be tested and combined any number of
;;; times.  Build one with the constructors below (closed-range, ...) or
;;; range-new, and read its ends with range-lower / range-upper.
;;;
;;; Since: LZ4 (a typed record: adt-gadt-unification-plan slice 3)

(defstruct Range :copy [lower : Bound upper : Bound])
;;; range-new -- build a Range from lower and upper Bound endpoints.
;;;
;;; Parameters:
;;;   lower -- the lower Bound (Unbounded for unbounded below)
;;;   upper -- the upper Bound (Unbounded for unbounded above)
;;;
;;; Returns:
;;;   The Range.
;;;
;;; Example:
;;;   (range-contains? (range-new (Inclusive 1) (Exclusive 5)) 4)  ; => true
;;;
;;; Since: LZ4

(defn range-new [lower : Bound upper : Bound] : Range (Range lower upper))
;;; range-lower -- return the lower Bound endpoint.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn range-lower [r : Range] : Bound (.lower r))
;;; range-upper -- return the upper Bound endpoint.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn range-upper [r : Range] : Bound (.upper r))
;; Abort helpers.  Each returns :int so it can sit in an if-branch beside an
;; int (seq/from-range); range-intersection / range-gap call them as a guard.

(defn range-abort-not-connected [] : int
  ```c
  fprintf(stderr, "range-intersection: ranges are not connected\n");
  abort();
  return 0;
  ```)

(defn range-abort-connected [] : int
  ```c
  fprintf(stderr, "range-gap: ranges are connected (no gap exists)\n");
  abort();
  return 0;
  ```)

(defn range-abort-unbounded-lower [] : int
  ```c
  fprintf(stderr, "seq/from-range: lower bound must be present\n");
  abort();
  return 0;
  ```)
;; -------------------------------------------------------------------
;; Constructors
;; -------------------------------------------------------------------
;;; closed-range -- [lo, hi] both endpoints inclusive.
;;;
;;; Parameters:
;;;   lo -- lower bound value
;;;   hi -- upper bound value
;;;
;;; Returns:
;;;   A Range representing [lo, hi].
;;;
;;; Example:
;;;   (closed-range 1 5)  ; => [1, 5]
;;;
;;; Since: LZ4


(defn closed-range [lo : int hi : int] : Range
  (range-new (range-bound-new 1 lo) (range-bound-new 1 hi)))
;;; open-range -- (lo, hi) both endpoints exclusive.
;;;
;;; Parameters:
;;;   lo -- lower bound value (excluded)
;;;   hi -- upper bound value (excluded)
;;;
;;; Returns:
;;;   A Range representing (lo, hi).
;;;
;;; Example:
;;;   (open-range 1 5)  ; => (1, 5)
;;;
;;; Since: LZ4

(defn open-range [lo : int hi : int] : Range
  (range-new (range-bound-new 0 lo) (range-bound-new 0 hi)))
;;; closed-open-range -- [lo, hi) inclusive lower, exclusive upper.
;;;
;;; Parameters:
;;;   lo -- lower bound value (included)
;;;   hi -- upper bound value (excluded)
;;;
;;; Returns:
;;;   A Range representing [lo, hi).
;;;
;;; Example:
;;;   (closed-open-range 1 5)  ; => [1, 5)
;;;
;;; Since: LZ4

(defn closed-open-range [lo : int hi : int] : Range
  (range-new (range-bound-new 1 lo) (range-bound-new 0 hi)))
;;; open-closed-range -- (lo, hi] exclusive lower, inclusive upper.
;;;
;;; Parameters:
;;;   lo -- lower bound value (excluded)
;;;   hi -- upper bound value (included)
;;;
;;; Returns:
;;;   A Range representing (lo, hi].
;;;
;;; Example:
;;;   (open-closed-range 1 5)  ; => (1, 5]
;;;
;;; Since: LZ4

(defn open-closed-range [lo : int hi : int] : Range
  (range-new (range-bound-new 0 lo) (range-bound-new 1 hi)))
;;; at-least-range -- [lo, +inf) inclusive lower, unbounded above.
;;;
;;; Parameters:
;;;   lo -- lower bound value (included)
;;;
;;; Returns:
;;;   A Range representing [lo, +inf).
;;;
;;; Example:
;;;   (at-least-range 5)  ; => [5, +inf)
;;;
;;; Since: LZ4

(defn at-least-range [lo : int] : Range
  (range-new (range-bound-new 1 lo) (Unbounded)))
;;; greater-than-range -- (lo, +inf) exclusive lower, unbounded above.
;;;
;;; Parameters:
;;;   lo -- lower bound value (excluded)
;;;
;;; Returns:
;;;   A Range representing (lo, +inf).
;;;
;;; Example:
;;;   (greater-than-range 5)  ; => (5, +inf)
;;;
;;; Since: LZ4

(defn greater-than-range [lo : int] : Range
  (range-new (range-bound-new 0 lo) (Unbounded)))
;;; at-most-range -- (-inf, hi] unbounded below, inclusive upper.
;;;
;;; Parameters:
;;;   hi -- upper bound value (included)
;;;
;;; Returns:
;;;   A Range representing (-inf, hi].
;;;
;;; Example:
;;;   (at-most-range 5)  ; => (-inf, 5]
;;;
;;; Since: LZ4

(defn at-most-range [hi : int] : Range
  (range-new (Unbounded) (range-bound-new 1 hi)))
;;; less-than-range -- (-inf, hi) unbounded below, exclusive upper.
;;;
;;; Parameters:
;;;   hi -- upper bound value (excluded)
;;;
;;; Returns:
;;;   A Range representing (-inf, hi).
;;;
;;; Example:
;;;   (less-than-range 5)  ; => (-inf, 5)
;;;
;;; Since: LZ4

(defn less-than-range [hi : int] : Range
  (range-new (Unbounded) (range-bound-new 0 hi)))
;;; singleton-range -- [v, v] a range containing exactly one value.
;;;
;;; Parameters:
;;;   v -- the single value
;;;
;;; Returns:
;;;   A Range representing [v, v].
;;;
;;; Example:
;;;   (singleton-range 3)  ; => [3, 3]
;;;
;;; Since: LZ4

(defn singleton-range [v : int] : Range
  (range-new (range-bound-new 1 v) (range-bound-new 1 v)))
;;; unbounded-range -- (-inf, +inf) no bounds at all.
;;;
;;; Returns:
;;;   A Range representing all values.
;;;
;;; Example:
;;;   (unbounded-range)  ; => (-inf, +inf)
;;;
;;; Since: LZ4

(defn unbounded-range [] : Range (range-new (Unbounded) (Unbounded)))
;; -------------------------------------------------------------------
;; Internal comparison helpers
;; -------------------------------------------------------------------
;; range-val-in-lower? -- true if v satisfies the lower bound b.
;; b == 0 means unbounded (always satisfied).


(defn range-val-in-lower? [b : Bound v : int] : bool
  (if (bound-unbounded? b)
    true
    (if (range-bound-inclusive? b)
      (>= v (range-bound-value b))
      (> v (range-bound-value b)))))
;; range-val-in-upper? -- true if v satisfies the upper bound b.
;; b == 0 means unbounded (always satisfied).

(defn range-val-in-upper? [b : Bound v : int] : bool
  (if (bound-unbounded? b)
    true
    (if (range-bound-inclusive? b)
      (<= v (range-bound-value b))
      (< v (range-bound-value b)))))
;; range-bound-strictly-before? -- true if upper bound u ends before lower bound l starts.
;; Used for range-overlaps?: if u strictly before l, ranges don't share any value.
;; u == 0 (unbounded above) or l == 0 (unbounded below): never strictly before.

(defn range-bound-strictly-before? [u : Bound l : Bound] : bool
  (if (or (bound-unbounded? u) (bound-unbounded? l))
    false
    (let [uv (range-bound-value u)
          lv (range-bound-value l)]
      (if (< uv lv)
        true
        (if (= uv lv)
          (or (not (range-bound-inclusive? u)) (not (range-bound-inclusive? l)))
          false)))))
;; range-bound-has-gap? -- true if a gap exists between upper bound u and lower bound l.
;; Gap means u and l are so far apart that their ranges cannot form a contiguous interval.
;; Differs from strictly-before: touching [1,3) and [3,5] has no gap but strictly-before.
;; u == 0 or l == 0: no gap.

(defn range-bound-has-gap? [u : Bound l : Bound] : bool
  (if (or (bound-unbounded? u) (bound-unbounded? l))
    false
    (let [uv (range-bound-value u)
          lv (range-bound-value l)]
      (if (< uv lv)
        true
        (if (= uv lv)
          (and (not (range-bound-inclusive? u))
            (not (range-bound-inclusive? l)))
          false)))))
;; -------------------------------------------------------------------
;; Predicates
;; -------------------------------------------------------------------
;;; range-contains? -- true if value v falls within range r.
;;;
;;; Parameters:
;;;   r -- a Range
;;;   v -- value to test
;;;
;;; Returns:
;;;   true if v satisfies both the lower and upper bounds of r.
;;;
;;; Example:
;;;   (range-contains? (closed-range 1 5) 3)  ; => true
;;;   (range-contains? (open-range 1 5) 1)    ; => false
;;;
;;; Since: LZ4


(defn range-contains? [r : Range v : int] : bool
  (and (range-val-in-lower? (range-lower r) v)
    (range-val-in-upper? (range-upper r) v)))
;;; range-encloses? -- true if every value in other is also in r.
;;;
;;; Parameters:
;;;   r     -- the outer Range
;;;   other -- the inner Range
;;;
;;; Returns:
;;;   true if r's lower <= other's lower and r's upper >= other's upper
;;;   (accounting for inclusive/exclusive endpoints).
;;;
;;; Example:
;;;   (range-encloses? (closed-range 0 10) (closed-range 2 8))  ; => true
;;;
;;; Since: LZ4

(defn range-encloses? [r : Range other : Range] : bool
  (let [rl (range-lower r)
        ru (range-upper r)
        ol (range-lower other)
        ou (range-upper other)
        lower-ok (if (bound-unbounded? rl)
                   true
                   (if (bound-unbounded? ol)
                     false
                     (let [rv (range-bound-value rl)
                           ov (range-bound-value ol)]
                       (if (< rv ov)
                         true
                         (if (= rv ov)
                           (or (range-bound-inclusive? rl)
                             (not (range-bound-inclusive? ol)))
                           false)))))
        upper-ok (if (bound-unbounded? ru)
                   true
                   (if (bound-unbounded? ou)
                     false
                     (let [rv (range-bound-value ru)
                           ov (range-bound-value ou)]
                       (if (> rv ov)
                         true
                         (if (= rv ov)
                           (or (range-bound-inclusive? ru)
                             (not (range-bound-inclusive? ou)))
                           false)))))]
    (and lower-ok upper-ok)))
;;; range-connected? -- true if no gap exists between r1 and r2.
;;;
;;; Two ranges are connected if their union forms a contiguous interval
;;; (they overlap, or touch at a point where at least one side is inclusive).
;;;
;;; Parameters:
;;;   r1 -- first Range
;;;   r2 -- second Range
;;;
;;; Returns:
;;;   true if r1 and r2 are connected.
;;;
;;; Example:
;;;   (range-connected? (closed-open-range 1 3) (closed-range 3 5))  ; => true
;;;   (range-connected? (less-than-range 3) (greater-than-range 3))  ; => false
;;;
;;; Since: LZ4

(defn range-connected? [r1 : Range r2 : Range] : bool
  (and (not (range-bound-has-gap? (range-upper r1) (range-lower r2)))
    (not (range-bound-has-gap? (range-upper r2) (range-lower r1)))))
;;; range-overlaps? -- true if r1 and r2 share at least one common value.
;;;
;;; Stronger than range-connected?: touching ranges like [1,3) and [3,5] are
;;; connected but do not overlap (no value is in both).
;;;
;;; Parameters:
;;;   r1 -- first Range
;;;   r2 -- second Range
;;;
;;; Returns:
;;;   true if there exists a value contained in both r1 and r2.
;;;
;;; Example:
;;;   (range-overlaps? (closed-range 1 3) (closed-range 3 5))  ; => true
;;;   (range-overlaps? (closed-open-range 1 3) (closed-range 3 5))  ; => false
;;;
;;; Since: LZ4

(defn range-overlaps? [r1 : Range r2 : Range] : bool
  (and (not (range-bound-strictly-before? (range-upper r1) (range-lower r2)))
    (not (range-bound-strictly-before? (range-upper r2) (range-lower r1)))))
;;; bounded-range? -- true if both endpoints are present.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn bounded-range? [r : Range] : bool
  (and (not (bound-unbounded? (range-lower r)))
    (not (bound-unbounded? (range-upper r)))))
;;; bounded-above? -- true if r has an upper bound.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn bounded-above? [r : Range] : bool
  (not (bound-unbounded? (range-upper r))))
;;; bounded-below? -- true if r has a lower bound.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn bounded-below? [r : Range] : bool
  (not (bound-unbounded? (range-lower r))))
;;; unbounded-above? -- true if r has no upper bound.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn unbounded-above? [r : Range] : bool (bound-unbounded? (range-upper r)))
;;; unbounded-below? -- true if r has no lower bound.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn unbounded-below? [r : Range] : bool (bound-unbounded? (range-lower r)))
;;; singleton-range? -- true if r contains exactly one value.
;;;
;;; A range is a singleton when both bounds are present, equal, and inclusive.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn singleton-range? [r : Range] : bool
  (let [lo (range-lower r)
        hi (range-upper r)]
    (if (or (bound-unbounded? lo) (bound-unbounded? hi))
      false
      (and (range-bound-inclusive? lo)
        (range-bound-inclusive? hi)
        (= (range-bound-value lo) (range-bound-value hi))))))
;;; empty-range? -- true if r contains no values.
;;;
;;; A bounded range is empty when the lower bound is strictly past the upper bound,
;;; or when both bounds share a value but at least one is exclusive.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn empty-range? [r : Range] : bool
  (let [lo (range-lower r)
        hi (range-upper r)]
    (if (or (bound-unbounded? lo) (bound-unbounded? hi))
      false
      (let [lv (range-bound-value lo)
            hv (range-bound-value hi)]
        (if (> lv hv)
          true
          (if (= lv hv)
            (or (not (range-bound-inclusive? lo))
              (not (range-bound-inclusive? hi)))
            false))))))
;;; nonempty-range? -- true if r contains at least one value.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Since: LZ4

(defn nonempty-range? [r : Range] : bool (not (empty-range? r)))
;; -------------------------------------------------------------------
;; Internal bound selection helpers for set operations
;; -------------------------------------------------------------------
;; range-lower-min -- return the less-restrictive of two lower bounds (for span).
;; Unbounded (0) is less restrictive than any bound.


(defn range-lower-min [b1 : Bound b2 : Bound] : Bound
  (if (bound-unbounded? b1)
    b1
    (if (bound-unbounded? b2)
      b2
      (let [v1 (range-bound-value b1)
            v2 (range-bound-value b2)]
        (if (< v1 v2)
          b1
          (if (> v1 v2) b2 (if (range-bound-inclusive? b1) b1 b2)))))))
;; range-upper-max -- return the less-restrictive of two upper bounds (for span).
;; Unbounded (0) is less restrictive than any bound.

(defn range-upper-max [b1 : Bound b2 : Bound] : Bound
  (if (bound-unbounded? b1)
    b1
    (if (bound-unbounded? b2)
      b2
      (let [v1 (range-bound-value b1)
            v2 (range-bound-value b2)]
        (if (> v1 v2)
          b1
          (if (< v1 v2) b2 (if (range-bound-inclusive? b1) b1 b2)))))))
;; range-lower-max -- return the more-restrictive of two lower bounds (for intersection).
;; Unbounded (0) defers to the other bound.

(defn range-lower-max [b1 : Bound b2 : Bound] : Bound
  (if (bound-unbounded? b1)
    b2
    (if (bound-unbounded? b2)
      b1
      (let [v1 (range-bound-value b1)
            v2 (range-bound-value b2)]
        (if (> v1 v2)
          b1
          (if (< v1 v2) b2 (if (not (range-bound-inclusive? b1)) b1 b2)))))))
;; range-upper-min -- return the more-restrictive of two upper bounds (for intersection).
;; Unbounded (0) defers to the other bound.

(defn range-upper-min [b1 : Bound b2 : Bound] : Bound
  (if (bound-unbounded? b1)
    b2
    (if (bound-unbounded? b2)
      b1
      (let [v1 (range-bound-value b1)
            v2 (range-bound-value b2)]
        (if (< v1 v2)
          b1
          (if (> v1 v2) b2 (if (not (range-bound-inclusive? b1)) b1 b2)))))))
;; -------------------------------------------------------------------
;; Set operations
;; -------------------------------------------------------------------
;;; range-span -- smallest range enclosing both r1 and r2 (convex hull).
;;;
;;; Parameters:
;;;   r1 -- first Range
;;;   r2 -- second Range
;;;
;;; Returns:
;;;   A Range whose lower bound is the min of both lowers and whose upper
;;;   bound is the max of both uppers.
;;;
;;; Example:
;;;   (range-span (closed-range 1 3) (closed-range 5 8))  ; => [1, 8]
;;;
;;; Since: LZ4


(defn range-span [r1 : Range r2 : Range] : Range
  (range-new (range-lower-min (range-lower r1) (range-lower r2))
    (range-upper-max (range-upper r1) (range-upper r2))))
;;; range-intersection -- largest range enclosed by both r1 and r2.
;;;
;;; The ranges must be connected (overlapping or touching); if they are not
;;; connected, aborts with an error.
;;;
;;; Parameters:
;;;   r1 -- first Range
;;;   r2 -- second Range
;;;
;;; Returns:
;;;   A Range representing the intersection of r1 and r2.
;;;
;;; Example:
;;;   (range-intersection (closed-range 1 5) (closed-range 3 8))  ; => [3, 5]
;;;
;;; Since: LZ4

(defn range-intersection [r1 : Range r2 : Range] : Range
  (when (not (range-connected? r1 r2)) (range-abort-not-connected))
  (range-new (range-lower-max (range-lower r1) (range-lower r2))
    (range-upper-min (range-upper r1) (range-upper r2))))
;;; range-gap -- largest range lying strictly between r1 and r2.
;;;
;;; The ranges must NOT be connected (a gap must exist); if they are
;;; connected, aborts with an error.
;;;
;;; Parameters:
;;;   r1 -- first Range
;;;   r2 -- second Range
;;;
;;; Returns:
;;;   A Range representing the gap between r1 and r2.  The gap's bounds
;;;   are the flipped endpoints of whichever range ends first and whichever
;;;   starts second.
;;;
;;; Example:
;;;   (range-gap (closed-range 1 3) (closed-range 5 8))    ; => (3, 5)
;;;   (range-gap (closed-open-range 1 3) (open-range 3 8)) ; => [3, 3]
;;;
;;; Since: LZ4

(defn range-gap [r1 : Range r2 : Range] : Range
  (when (range-connected? r1 r2) (range-abort-connected))
  (let [u1       (range-upper r1)
        l2       (range-lower r2)
        u2       (range-upper r2)
        l1       (range-lower r1)
        r1-first (range-bound-has-gap? u1 l2)]
    (if r1-first
      (range-new (range-bound-flip u1) (range-bound-flip l2))
      (range-new (range-bound-flip u2) (range-bound-flip l1)))))
;; -------------------------------------------------------------------
;; Seq integration -- integer ranges only
;; -------------------------------------------------------------------
;;; seq/from-range -- convert a bounded integer Range to a lazy Seq.
;;;
;;; The lower bound must be present (range must not be unbounded below).
;;; An unbounded upper bound produces an infinite sequence.
;;;
;;; Parameters:
;;;   r -- a Range (integer endpoints)
;;;
;;; Returns:
;;;   A Seq yielding each integer in r in ascending order.
;;;
;;; Example:
;;;   (seq-for-each println (seq/from-range (closed-range 1 4)))  ; => 1 2 3 4
;;;   (seq-for-each println (seq/from-range (open-range 1 5)))    ; => 2 3 4
;;;
;;; Since: LZ4


(defn seq/from-range [r : Range] : int
  (let [lo (range-lower r)]
    (if (bound-unbounded? lo)
      (range-abort-unbounded-lower)
      (let [start (if (range-bound-inclusive? lo)
                    (range-bound-value lo)
                    (+ (range-bound-value lo) 1))
            hi    (range-upper r)
            hb    (not (bound-unbounded? hi))
            he    (if hb
                    (if (range-bound-inclusive? hi)
                      (range-bound-value hi)
                      (- (range-bound-value hi) 1))
                    0)]
        (seq-new (fn []
                   (let [s start
                         b hb
                         e he]
                     (gen []
                       (let [^mut i s]
                         (while (if b (<= i e) true) (yield i) (set! i (+ i 1))))))))))))
;;; seq/from-range-step -- convert a bounded integer Range to a Seq with a custom step.
;;;
;;; The lower bound must be present.  Positive step iterates upward; negative step
;;; iterates downward (in which case supply a range with lo > hi or use at-most /
;;; at-least accordingly).  Step must not be zero.
;;;
;;; Parameters:
;;;   step -- increment per element (nonzero)
;;;   r    -- a Range (integer endpoints)
;;;
;;; Returns:
;;;   A Seq yielding each integer in r at the given step.
;;;
;;; Example:
;;;   (seq-for-each println (seq/from-range-step 2 (closed-range 0 8)))
;;;   ; => 0 2 4 6 8
;;;
;;; Since: LZ4

(defn seq/from-range-step [step : int r : Range] : int
  (let [lo (range-lower r)]
    (if (bound-unbounded? lo)
      (range-abort-unbounded-lower)
      (let [start (if (range-bound-inclusive? lo)
                    (range-bound-value lo)
                    (if (> step 0)
                      (+ (range-bound-value lo) 1)
                      (- (range-bound-value lo) 1)))
            hi    (range-upper r)
            hb    (not (bound-unbounded? hi))
            he    (if hb
                    (if (range-bound-inclusive? hi)
                      (range-bound-value hi)
                      (if (> step 0)
                        (- (range-bound-value hi) 1)
                        (+ (range-bound-value hi) 1)))
                    0)]
        (seq-new (fn []
                   (let [s  start
                         st step
                         b  hb
                         e  he]
                     (gen []
                       (let [^mut i s]
                         (while (if b (if (> st 0) (<= i e) (>= i e)) true)
                           (yield i)
                           (set! i (+ i st))))))))))))
