;;; tur/reactor -- lightweight evented I/O reactor.
;;;
;;; Single-threaded event loop for multiplexing file descriptors, timers,
;;; OS signals, and channel receives without requiring the cooperative
;;; scheduler. Create one reactor per thread that needs to poll; reactors
;;; are not thread-safe. The only thread-safe operations are reactor-stop
;;; and reactor-wake.
;;;
;;; Since: Phase R1
;; stdlib/reactor.tur -- Lightweight evented reactor (Phase R1-R6)
;;
;; Thin Turmeric bindings over tur_reactor_* in src/async/reactor.c.
;; The reactor wraps the platform IOBackend (epoll on Linux, kqueue on
;; macOS/BSD) without requiring the cooperative scheduler.
;;
;; Event mask constants (mirror IOEventType in src/async/io.h):
;;   READ  1   -- fd readable / accept ready
;;   WRITE 2   -- fd writable / connect complete
;;   ERROR 4   -- error condition
;;   HUP   8   -- peer hung up / EOF
;;
;; Reactor handle: :ptr<void> (create with reactor-new; free with reactor-free)
;;
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 2) ----
;; EventSourceId wraps the source id (an :int) returned by the reactor-add-*
;; family with a nominally distinct type, so the checker rejects passing an
;; arbitrary integer to reactor-modify-fd / reactor-remove -- only an id minted
;; by a reactor-add-* call is accepted. It lowers to :int in the C ABI. The
;; add-* functions still encode their error case as id -1; unwrap with
;; (:: id :int) to compare against it.
;;
;; API:
;;   reactor-new           []                                   -- ptr<void>
;;   reactor-free          [r]                                  -- nil
;;   reactor-add-fd        [r fd events cb user-data]           -- EventSourceId
;;   reactor-modify-fd     [r id new-events]                    -- int
;;   reactor-remove        [r id]                               -- int
;;   reactor-add-timer     [r delay-ms cb user-data]            -- EventSourceId
;;   reactor-add-interval  [r first-ms interval-ms cb ud]       -- EventSourceId
;;   reactor-add-signal    [r signum cb user-data]              -- EventSourceId
;;   reactor-add-chan      [r ch cb user-data]                  -- EventSourceId
;;   reactor-poll          [r timeout-ms]                       -- int
;;   reactor-run           [r]                                  -- nil
;;   reactor-stop          [r]                                  -- nil
;;   reactor-wake          [r]                                  -- nil
;; ---- Autolink hint ----
;;; reactor/autolink-hint -- ensure programs importing reactor link against libturi.
(defn reactor/autolink-hint [] : int
  ```c
  /* __tur_autolink__: -lturi */
  return 0;
  ```)
;; ---- Source-id handle newtype ----

(defopaque EventSourceId :int)
;; ---- Reactor handle newtype + linearity (stdlib-linearity-affinity-plan, L2) ----
;; Reactor wraps the :ptr<void> handle returned by reactor-new with a nominally
;; distinct type. It is :linear: a reactor owns its platform I/O backend and
;; must be torn down exactly once with reactor-free. Under -Xlinear the checker
;; rejects dropping a Reactor (TUR-E0100) or freeing it twice / using it after
;; free (TUR-E0101). Every reactor accessor (add-*/modify/remove/poll/run/stop/
;; wake) and local-fiber-group-new declare their reactor parameter ^borrow, so a
;; reactor may be registered against, polled, and run any number of times
;; without consuming it; only reactor-free consumes. Reactor lowers to
;; :ptr<void> in the C ABI -- the thin extern wrappers coerce with
;; (:: r :ptr<void>) at the call boundary, so the C surface is unchanged.

(defopaque Reactor :ptr<void> :linear)
;; ---- C surface declarations ----


(extern-c tur_reactor_new [] :ptr)

(extern-c tur_reactor_free [r :ptr] :void)

(extern-c tur_reactor_add_fd
  [r :ptr fd :int events :int cb :int user-data :ptr]
  :int)

(extern-c tur_reactor_modify_fd [r :ptr id :int new-events :int] :int)

(extern-c tur_reactor_remove [r :ptr id :int] :int)

(extern-c tur_reactor_add_timer
  [r :ptr delay-ms :int cb :int user-data :ptr]
  :int)

(extern-c tur_reactor_add_interval
  [r :ptr first-ms :int interval-ms :int cb :int user-data :ptr]
  :int)

(extern-c tur_reactor_add_signal
  [r :ptr signum :int cb :int user-data :ptr]
  :int)

(extern-c tur_reactor_add_chan [r :ptr ch :ptr cb :int user-data :ptr] :int)

(extern-c tur_reactor_poll [r :ptr timeout-ms :int] :int)

(extern-c tur_reactor_run [r :ptr] :void)

(extern-c tur_reactor_stop [r :ptr] :void)

(extern-c tur_reactor_wake [r :ptr] :void)
;; ---- Event mask constants ----
;;; READ -- event mask bit: fd is readable or an accept is ready.
;;;
;;; Since: Phase R2


(def READ 1)
;;; WRITE -- event mask bit: fd is writable or a connect has completed.
;;;
;;; Since: Phase R2

(def WRITE 2)
;;; ERROR -- event mask bit: error condition on the fd.
;;; Always reported; cannot be masked out at registration time.
;;;
;;; Since: Phase R2

(def ERROR 4)
;;; HUP -- event mask bit: the peer hung up or EOF was reached.
;;;
;;; Since: Phase R2

(def HUP 8)
;; ---- Lifecycle ----
;;; reactor-new -- create a new reactor for the current thread.
;;;
;;; The underlying I/O backend is chosen at compile time:
;;; epoll on Linux, kqueue on macOS/BSD. Returns nil on WASM
;;; or if the backend cannot be initialised.
;;;
;;; Returns:
;;;   ptr<void> -- opaque reactor handle, or nil on error
;;;
;;; Example:
;;;   (let [r (reactor-new)]
;;;     (reactor-run r)
;;;     (reactor-free r))
;;;
;;; Since: Phase R1


(defn reactor-new []
  #fx{}
  : Reactor
  ```c
  return (void *)(intptr_t)tur_reactor_new();
  ```)
;;; reactor-free -- free a reactor and unregister all attached sources.
;;;
;;; Parameters:
;;;   r -- reactor handle returned by reactor-new
;;;
;;; Example:
;;;   (reactor-free r)
;;;
;;; Since: Phase R1

(defn reactor-free [r : Reactor]
  #fx{}
  : nil
  (tur_reactor_free (:: r :ptr<void>)))
;; ---- Source registration ----
;;; reactor-add-fd -- watch a file descriptor for I/O events.
;;;
;;; Returns a source id (>= 0) that uniquely identifies this registration.
;;; Pass the id to reactor-modify-fd or reactor-remove to change or cancel
;;; the watch. Returns -1 on error.
;;;
;;; The callback is invoked as (cb source-id events user-data) each time
;;; the fd becomes ready. Events is a bitmask of READ, WRITE, ERROR, HUP.
;;; Callbacks fire on the thread that calls reactor-poll or reactor-run.
;;;
;;; Parameters:
;;;   r         -- reactor handle
;;;   fd        -- file descriptor to watch (must already be open)
;;;   events    -- bitmask of event types to watch: READ | WRITE
;;;   cb        -- closure: (fn [id :int events :int user :ptr<void>] :nil)
;;;   user-data -- opaque value forwarded to cb as its third argument
;;;
;;; Returns:
;;;   EventSourceId -- source id (>= 0), or -1 on error (unwrap with (:: id :int))
;;;
;;; Example:
;;;   (reactor-add-fd r listen-fd READ
;;;     (fn [id events user]
;;;       (handle-accept listen-fd))
;;;     nil)
;;;
;;; Since: Phase R2


;; ^fat on cb (the same fix local-spawn's body got): a captureless callback is
;; a bare C function pointer, not a heap fat-closure box, and reactor.c calls
;; every cb through its fat box's slot 0 -- so a captureless lambda passed as
;; a plain `cb : int` was called through its own code bytes (SIGSEGV in
;; call_tur_*_cb).  Typing cb `^fat` auto-shims it into a heap { fatshim, fn }
;; box the reactor owns and frees at teardown, and lets the checker hold the
;; callback to the arity reactor.c calls it with.  The shim's entry is the
;; all-int64_t carrier signature reactor.c's TurFdCbFn / TurTimerCbFn typedefs
;; call through (checked by tests/run-fnsan.sh).
;; See docs/archive/nil-argument-to-ptr-param-emits-void-expression.md.

(defn reactor-add-fd [^borrow r : Reactor
                      fd : int
                      events : int
                      ^fat cb : (fn [int int ptr<void>] nil)
                      user-data : ptr<void>]
  #fx{}
  : EventSourceId
  (:: (tur_reactor_add_fd (:: r :ptr<void>) fd events cb user-data)
    :EventSourceId))
;;; reactor-modify-fd -- change the watched event mask for a source.
;;;
;;; Parameters:
;;;   r          -- reactor handle
;;;   id         -- source id returned by reactor-add-fd
;;;   new-events -- replacement event bitmask
;;;
;;; Returns:
;;;   int -- 0 on success, -1 if id is not found or the modify fails
;;;
;;; Example:
;;;   (reactor-modify-fd r source-id WRITE)
;;;
;;; Since: Phase R2

(defn reactor-modify-fd [^borrow r : Reactor
                         id : EventSourceId
                         new-events : int]
  #fx{}
  : int
  (tur_reactor_modify_fd (:: r :ptr<void>) (:: id :int) new-events))
;;; reactor-remove -- unregister a source by id.
;;;
;;; After this call the fd is no longer watched and the callback will
;;; not fire again. The fd itself is not closed.
;;;
;;; Parameters:
;;;   r  -- reactor handle
;;;   id -- source id returned by reactor-add-fd
;;;
;;; Returns:
;;;   int -- 0 on success, -1 if id is not found
;;;
;;; Example:
;;;   (reactor-remove r source-id)
;;;
;;; Since: Phase R2

(defn reactor-remove [^borrow r : Reactor id : EventSourceId]
  #fx{}
  : int
  (tur_reactor_remove (:: r :ptr<void>) (:: id :int)))
;;; reactor-add-timer -- register a one-shot timer that fires once.
;;;
;;; The callback fires after delay-ms milliseconds on the thread that calls
;;; reactor-poll or reactor-run. After firing the source is automatically
;;; deactivated; it does not need to be removed manually.
;;;
;;; The callback is invoked as (cb source-id user-data).
;;;
;;; Parameters:
;;;   r         -- reactor handle
;;;   delay-ms  -- milliseconds until the timer fires (>= 0)
;;;   cb        -- closure: (fn [id :int user :ptr<void>] :nil)
;;;   user-data -- opaque value forwarded to cb as its second argument
;;;
;;; Returns:
;;;   EventSourceId -- source id (>= 0), or -1 on error (unwrap with (:: id :int))
;;;
;;; Example:
;;;   (reactor-add-timer r 500
;;;     (fn [id user] :nil (println "fired"))
;;;     nil)
;;;
;;; Since: Phase R4

(defn reactor-add-timer [^borrow r : Reactor
                         delay-ms : int
                         ^fat cb : (fn [int ptr<void>] nil)
                         user-data : ptr<void>]
  #fx{}
  : EventSourceId
  (:: (tur_reactor_add_timer (:: r :ptr<void>) delay-ms cb user-data)
    :EventSourceId))
;;; reactor-add-interval -- register a repeating interval timer.
;;;
;;; The callback fires first after first-ms milliseconds, then every
;;; interval-ms milliseconds thereafter. The source remains active until
;;; reactor-remove is called with its id.
;;;
;;; The callback is invoked as (cb source-id user-data) on each tick.
;;;
;;; Parameters:
;;;   r           -- reactor handle
;;;   first-ms    -- delay before the first fire in milliseconds
;;;   interval-ms -- period between subsequent fires in milliseconds
;;;   cb          -- closure: (fn [id :int user :ptr<void>] :nil)
;;;   user-data   -- opaque value forwarded to cb
;;;
;;; Returns:
;;;   EventSourceId -- source id (>= 0), or -1 on error (unwrap with (:: id :int))
;;;
;;; Example:
;;;   (reactor-add-interval r 0 1000
;;;     (fn [id user] :nil (println "tick"))
;;;     nil)
;;;
;;; Since: Phase R4

(defn reactor-add-interval [^borrow r : Reactor
                            first-ms : int
                            interval-ms : int
                            ^fat cb : (fn [int ptr<void>] nil)
                            user-data : ptr<void>]
  #fx{}
  : EventSourceId
  (:: (tur_reactor_add_interval (:: r :ptr<void>)
        first-ms
        interval-ms
        cb
        user-data)
    :EventSourceId))
;; ---- Running ----
;;; reactor-add-signal -- watch an OS signal via the reactor.
;;;
;;; Uses signalfd on Linux and a self-pipe + sigaction on macOS/BSD.
;;; The signal is masked from normal delivery while the source is active;
;;; calling reactor-remove restores the previous signal disposition.
;;; Returns -1 on WASM or if registration fails.
;;;
;;; The callback is invoked as (cb source-id signum user-data).
;;;
;;; Parameters:
;;;   r         -- reactor handle
;;;   signum    -- OS signal number (e.g. 2 for SIGINT)
;;;   cb        -- closure: (fn [id :int signum :int user :ptr<void>] :nil)
;;;   user-data -- opaque value forwarded to cb
;;;
;;; Returns:
;;;   EventSourceId -- source id (>= 0), or -1 on error (unwrap with (:: id :int))
;;;
;;; Example:
;;;   (reactor-add-signal r 2
;;;     (fn [id sig user] :nil (println "got SIGINT"))
;;;     nil)
;;;
;;; Since: Phase R5


(defn reactor-add-signal [^borrow r : Reactor
                          signum : int
                          ^fat cb : (fn [int int ptr<void>] nil)
                          user-data : ptr<void>]
  #fx{}
  : EventSourceId
  (:: (tur_reactor_add_signal (:: r :ptr<void>) signum cb user-data)
    :EventSourceId))
;;; reactor-add-chan -- watch a channel for one incoming value (one-shot).
;;;
;;; Fires at most once: when a value is available the callback receives
;;; (source-id, value, user-data) and the source is deactivated. Re-register
;;; from the callback for a persistent channel watcher.
;;;
;;; Delivery latency: the channel is checked on every reactor-poll /
;;; reactor-run iteration. For prompt wakeup after chan-send, call
;;; reactor-wake from the sending thread.
;;;
;;; Parameters:
;;;   r         -- reactor handle
;;;   ch        -- channel handle (ptr<void> from chan-new or async-chan-new)
;;;   cb        -- closure: (fn [id :int value :int user :ptr<void>] :nil)
;;;   user-data -- opaque value forwarded to cb
;;;
;;; Returns:
;;;   EventSourceId -- source id (>= 0), or -1 on error (unwrap with (:: id :int))
;;;
;;; Example:
;;;   (reactor-add-chan r stop-chan
;;;     (fn [id v user] :nil (reactor-stop r))
;;;     nil)
;;;
;;; Since: Phase R6

(defn reactor-add-chan [^borrow r : Reactor
                        ch : ptr<void>
                        ^fat cb : (fn [int int ptr<void>] nil)
                        user-data : ptr<void>]
  #fx{}
  : EventSourceId
  (:: (tur_reactor_add_chan (:: r :ptr<void>) ch cb user-data) :EventSourceId))
;; ---- Running ----
;;; reactor-poll -- poll for events once, dispatching ready callbacks.
;;;
;;; Blocks up to timeout-ms milliseconds waiting for events.
;;; Pass -1 to block indefinitely; pass 0 for a non-blocking check.
;;; Returns after all callbacks for this batch have been dispatched.
;;;
;;; Parameters:
;;;   r          -- reactor handle
;;;   timeout-ms -- maximum wait in milliseconds (-1 = forever, 0 = non-blocking)
;;;
;;; Returns:
;;;   int -- number of callbacks dispatched (>= 0), or -1 on error
;;;
;;; Example:
;;;   (reactor-poll r 100)  ; => 0..n
;;;
;;; Since: Phase R1


(defn reactor-poll [^borrow r : Reactor timeout-ms : int]
  #fx{}
  : int
  (tur_reactor_poll (:: r :ptr<void>) timeout-ms))
;;; reactor-run -- run the event loop until stopped or all sources removed.
;;;
;;; Calls reactor-poll in a loop until reactor-stop is called from a callback
;;; or another thread, or until no registered sources remain.
;;;
;;; Parameters:
;;;   r -- reactor handle
;;;
;;; Example:
;;;   (reactor-run r)
;;;
;;; Since: Phase R1

(defn reactor-run [^borrow r : Reactor]
  #fx{}
  : nil
  (tur_reactor_run (:: r :ptr<void>)))
;;; reactor-stop -- ask reactor-run to return after the current dispatch round.
;;;
;;; Thread-safe: safe to call from a callback inside reactor-run or from
;;; another OS thread. reactor-run will return once the current batch of
;;; callbacks is complete.
;;;
;;; Parameters:
;;;   r -- reactor handle
;;;
;;; Example:
;;;   (reactor-stop r)
;;;
;;; Since: Phase R1

(defn reactor-stop [^borrow r : Reactor]
  #fx{}
  : nil
  (tur_reactor_stop (:: r :ptr<void>)))
;;; reactor-wake -- interrupt a reactor blocked in reactor-poll or reactor-run.
;;;
;;; Thread-safe: causes the blocking poll to return immediately so the
;;; calling thread can check external state (e.g. a new fd to register)
;;; before re-entering the loop.
;;;
;;; Parameters:
;;;   r -- reactor handle
;;;
;;; Example:
;;;   (reactor-wake r)
;;;
;;; Since: Phase R1

(defn reactor-wake [^borrow r : Reactor]
  #fx{}
  : nil
  (tur_reactor_wake (:: r :ptr<void>)))
;; ---- Local fiber driver (Phase F2-F7) ----
;;
;; A local fiber group runs cooperative fibers on top of one reactor without
;; starting the global scheduler. The group handle is an opaque ptr<void>
;; (same convention as the reactor handle). One group is bound to one reactor
;; for its lifetime and must not be shared across threads.
;;
;; API:
;;   local-fiber-group-new   [r]                       -- ptr<void> (group)
;;   local-fiber-group-free  [g]                        -- nil
;;   local-spawn             [g body user-data]         -- int (fiber id)
;;   reactor-run-fibers      [g]                         -- int (completed)
;;   local-park-fd           [g fd events timeout-ms]    -- int (events|-2|-1)
;;   local-park-chan         [g ch]                      -- int (value|-1)


(extern-c tur_local_fiber_group_new [r :ptr] :ptr)

(extern-c tur_local_fiber_group_free [g :ptr] :void)

(extern-c tur_local_spawn [g :ptr body :int user-data :ptr] :int)

(extern-c tur_reactor_run_fibers [g :ptr] :int)

(extern-c tur_local_park_fd [g :ptr fd :int events :int timeout-ms :int] :int)

(extern-c tur_local_park_chan [g :ptr ch :ptr] :int)
;;; local-fiber-group-new -- create a fiber group bound to a reactor.
;;;
;;; The group borrows the reactor; do not free the reactor while the group
;;; is alive. One group is bound to one reactor for its lifetime and is not
;;; thread-safe (same rule as the reactor itself).
;;;
;;; Parameters:
;;;   r -- reactor handle returned by reactor-new
;;;
;;; Returns:
;;;   ptr<void> -- opaque local-fiber-group handle, or nil on error
;;;
;;; Example:
;;;   (let [r (reactor-new)
;;;         g (local-fiber-group-new r)]
;;;     (reactor-run-fibers g)
;;;     (local-fiber-group-free g)
;;;     (reactor-free r))
;;;
;;; Since: Phase F2

(defn local-fiber-group-new [^borrow r : Reactor]
  #fx{}
  : ptr<void>
  (tur_local_fiber_group_new (:: r :ptr<void>)))
;;; local-fiber-group-free -- free a fiber group and cancel any parked fibers.
;;;
;;; Any fiber still parked is cancelled: its park source is removed from the
;;; bound reactor and its stack is freed without unwinding (no cleanup hooks).
;;; The bound reactor is not freed.
;;;
;;; Parameters:
;;;   g -- group handle returned by local-fiber-group-new
;;;
;;; Example:
;;;   (local-fiber-group-free g)
;;;
;;; Since: Phase F2

(defn local-fiber-group-free [g : ptr<void>]
  #fx{}
  : nil
  (tur_local_fiber_group_free g))
;;; local-spawn -- spawn a fiber into a group.
;;;
;;; The fiber first runs on the next reactor-run-fibers tick. The body is a
;;; closure taking the user-data pointer; its return value is ignored.
;;;
;;; Parameters:
;;;   g         -- group handle
;;;   body      -- closure: (fn [user :ptr<void>] :nil)
;;;   user-data -- opaque value forwarded to body as its only argument
;;;
;;; Returns:
;;;   int -- fiber id (>= 0), or -1 on error
;;;
;;; Example:
;;;   (local-spawn g
;;;     (fn [user] :nil (println "hello from a fiber"))
;;;     nil)
;;;
;;; Since: Phase F3
;; ^fat on body: a captureless fiber body is a bare C function pointer, not a
;; heap fat-closure box.  Marking it ^fat auto-shims it into a heap
;; { fatshim, fn } box, so (a) the trampoline's fat-pointer dispatch is correct
;; for captureless bodies too, and (b) every body is a heap box the fiber group
;; can own and free at teardown (tur_local_disown_body opts a caller out).

(defn local-spawn [g : ptr<void>
                   ^fat body : (fn [ptr<void>] nil)
                   user-data : ptr<void>]
  #fx{}
  : int
  (tur_local_spawn g body user-data))
;;; reactor-run-fibers -- drive the reactor and pump the group's fibers.
;;;
;;; Runs until either the group is empty and the bound reactor has no
;;; remaining sources, or reactor-stop is called on the bound reactor.
;;; Resumed fibers run until they park or return; parked fibers wake when
;;; their reactor source fires.
;;;
;;; Calling this re-entrantly from inside a fiber of the same group is a
;;; hard error and returns -1 immediately (it would deadlock the pump).
;;;
;;; Parameters:
;;;   g -- group handle
;;;
;;; Returns:
;;;   int -- number of fibers that ran to completion, or -1 on re-entry/error
;;;
;;; Example:
;;;   (local-spawn g (fn [u] :nil (println "hi")) nil)
;;;   (reactor-run-fibers g)  ; => 1
;;;
;;; Since: Phase F3

(defn reactor-run-fibers [g : ptr<void>] #fx{} : int (tur_reactor_run_fibers g))
;;; local-park-fd -- park the running fiber until an fd is ready.
;;;
;;; Registers fd on the bound reactor for events (a READ/WRITE bitmask) and
;;; suspends the current fiber. The fiber resumes when the reactor fires the
;;; source; the source is removed before it runs again (one-shot). If
;;; timeout-ms is >= 0 and elapses first, the fiber resumes with -2.
;;;
;;; Must be called from inside a fiber spawned into g. Outside of one it
;;; returns -1 and leaves the caller running.
;;;
;;; Parameters:
;;;   g          -- group handle
;;;   fd         -- file descriptor to wait on
;;;   events     -- event bitmask (READ | WRITE)
;;;   timeout-ms -- timeout in milliseconds, or -1 to wait forever
;;;
;;; Returns:
;;;   int -- the fired event mask (>= 0), -2 on timeout, or -1 if not in a fiber
;;;
;;; Example:
;;;   (local-park-fd g read-fd READ -1)  ; => 1 when readable
;;;
;;; Since: Phase F4

(defn local-park-fd [g : ptr<void> fd : int events : int timeout-ms : int]
  #fx{}
  : int
  (tur_local_park_fd g fd events timeout-ms))
;;; local-park-chan -- park the running fiber until a channel has a value.
;;;
;;; Registers ch on the bound reactor (one-shot) and suspends the current
;;; fiber. The fiber resumes with the received value when one is available.
;;; As with reactor-add-chan, prompt same-thread delivery requires the sender
;;; to call reactor-wake after chan-send (the driver otherwise blocks in poll).
;;;
;;; Must be called from inside a fiber spawned into g. Outside of one it
;;; returns -1 and leaves the caller running.
;;;
;;; Parameters:
;;;   g  -- group handle
;;;   ch -- channel handle (ptr<void> from chan-new or async-chan-new)
;;;
;;; Returns:
;;;   int -- the received value, or -1 if not in a fiber
;;;
;;; Example:
;;;   (local-park-chan g ch)  ; => the next value sent on ch
;;;
;;; Since: Phase F5

(defn local-park-chan [g : ptr<void> ch : ptr<void>]
  #fx{}
  : int
  (tur_local_park_chan g ch))
