;;; tur/vec -- typed Vec[A]: parameterized growable array.
;;;
;;; Parameterized growable array. Runtime layout identical to tur/vec.
;;;
;;; Since: Phase TC1-A
;; Phase TC1-A: Typed Vec[A]
;; Parameterized growable array. Runtime layout identical to vec.tur.
;; Type parameter A is tracked by the type-checker at call sites only.
;;; Vec -- parameterized growable array with element type A.
;;;
;;; Since: Phase TC1
(defstruct Vec :heap [A] (data :ptr<void>) (len :int) (cap :int))
;;; vec-new -- allocate a new empty Vec[A].
;;;
;;; Returns:
;;;   A new empty Vec[A] with len=0 and cap=0.
;;;
;;; Example:
;;;   (vec-new)  ; => empty Vec
;;;
;;; Since: Phase TC1
;; --- Producer/accessor ABI (end-to-end-monomorphization, Vec typed-pointer
;; slice) ---
;;
;; `Vec` is :heap, so `(Vec A)` lowers to a typed pointer `Vec__A *` to a
;; heap-allocated `{ data, len, cap }` header in every monomorphic position
;; (spec params, Eq[Vec] dispatch).  The producers below stay INLINE-C
;; *carrier bases*: their bodies take/return the int64 carrier (which, for a
;; :heap value, IS the header pointer) and operate on the layout-generic
;; anonymous `{ int64_t *data; int64_t len; int64_t cap; }` struct.  Two
;; reasons this is the right shape rather than pure-Turmeric make-struct/
;; field-access bodies:
;;
;;   1. The interpreter (--interpret) routes a call to a native override ONLY
;;      when the callee's body is inline-C (eval.c: the native-override-for-
;;      inline-C-functions path).  The native_vec_* builtins (src/main.c)
;;      implement Vec over the interpreter's own value model, so keeping these
;;      bodies inline-C preserves interpreter parity for free.  A pure-Turmeric
;;      body would bypass the native and run source that the tree-walker cannot
;;      execute.
;;   2. The element buffer (`data`) is int64-carried for every A, and a
;;      return-typed-A body would mint an A-monomorphized spec (e.g. returning
;;      `double` for A=float) whose carrier read numerically converts the float
;;      bits instead of bit-reinterpreting them.  Inline-C bodies are not
;;      return-specialized, so the carrier base returns the raw int64 and the
;;      call-site `(:: (vec-get v i) :float)` ascription does the correct union
;;      reinterpret.
;;
;; At concrete call sites the typed pointer reaches these int64-carrier bases
;; through the C-3 carrier reinterpret-cast (emit_carrier_bridge), so
;; `(void*)(intptr_t)v` is always valid.  Mutation is visible to all holders
;; because the handle is a shared pointer, never a by-value header copy.


(defn vec-new [A] []
  #fx{}
  : (Vec A)
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *v = malloc(sizeof(*v));
  v->data = NULL;
  v->len = 0;
  v->cap = 0;
  return (__TUR_RET__)(intptr_t)v;
  ```)
;;; vec-len -- return the number of elements in a Vec[A].
;;;
;;; `#reads v` is the trusted claim that this body only READS the vector it is
;;; handed.  It lets a refinement over `(vec-len v)` be treated as a function of
;;; frozen state inside a `frozen` region, so a bounded-index loop invariant can
;;; discharge.  A mutator (`vec-push!`, `vec-set-o!`, ...) deliberately carries
;;; no such claim -- that asymmetry is how the frozen grant tells a reader from
;;; a writer, since the SIGNATURE cannot: both take the vector by value.  See
;;; docs/guides/stateful-refinements-guide.md.
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer
;;;
;;; Returns:
;;;   Element count.
;;;
;;; Example:
;;;   (vec-len my-vec)  ; => 3
;;;
;;; Since: Phase TC1
(defn vec-len [A] [v : (Vec A)]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  return (int)vec->len;
  ```)
;;; vec-get -- return the element at index i (bounds-checked).
;;;
;;; `#reads v` marks this a reader -- see the note on `vec-len`.
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer
;;;   i -- zero-based index
;;;
;;; Returns:
;;;   The element at index i (typed A, stored as int64_t).
;;;
;;; Example:
;;;   (vec-get my-vec 0)  ; => first element
;;;
;;; Since: Phase TC1
(defn vec-get [A] [v : (Vec A) i :int]
  #fx{}
  #reads v
  :A
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (i >= 0 && (size_t)i < (size_t)vec->len) return (int64_t)vec->data[i];
  fprintf(stderr, "vec index out of bounds\n");
  exit(1);
  return 0;
  ```)
;;; vec-push! -- append an element to the Vec[A].
;;;
;;; Parameters:
;;;   v   -- Vec[A] pointer
;;;   val -- element of type A to append
;;;
;;; Example:
;;;   (vec-push! my-vec 42)
;;;
;;; Since: Phase TC1

(defn vec-push! [A] [v : (Vec A) val :A]
  #fx{}
  #writes v
  :nil
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (vec->len >= vec->cap) {
    int64_t new_cap = vec->cap > 0 ? vec->cap * 2 : 4;
    int64_t *new_data = malloc(sizeof(int64_t) * new_cap);
    for (int64_t i = 0; i < vec->len; i++) new_data[i] = vec->data[i];
    free(vec->data);
    vec->data = new_data;
    vec->cap = new_cap;
  }
  /* region-lock-hardening: the buffer is malloc'd and outlives any region
     bracket this push runs inside, so a region-allocated element (a node,
     or an erased `:int` that is one) is an escape the result walk cannot
     see.  The note flags its generation, which then retires instead of
     rewinding -- see src/runtime/region.h. */
  TUR_REGION_NOTE(val);
  vec->data[vec->len++] = (int64_t)val;
  ```)
;;; vec-pop! -- remove and return the last element of a Vec[A].
;;;
;;; Ownership note for MULTI-WORD (> 8 byte by-value struct/ADT) elements: such
;;; an element rides its data slot as a heap box pointer.  vec-pop! returns that
;;; box pointer on the carrier and shrinks len, so ownership of the box TRANSFERS
;;; OUT to the caller -- vec-free will no longer see it.  The usual read pattern
;;; `(:: (vec-pop! v) T)` deref-copies the box to a value and then drops the box,
;;; which leaks it (there is no handle left to free).  To REMOVE the last element
;;; without keeping it, use vec-drop-last! (which frees the box); to look at it,
;;; vec-get before popping.  Single-word A (int/cstr/float/opaque/:heap ptr) has
;;; no box, so vec-pop! is leak-free there.
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer
;;;
;;; Returns:
;;;   The last element of type A (as int64_t), or 0 if empty.
;;;
;;; Example:
;;;   (vec-pop! my-vec)  ; => last element
;;;
;;; Since: Phase TC1

(defn vec-pop! [A] [v : (Vec A)]
  #fx{}
  #writes v
  :A
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (vec->len == 0) return 0;
  return (int64_t)vec->data[--vec->len];
  ```)
;;; vec-drop-last-o! -- remove the last element and (when `boxed`) free its box.
;;;
;;; The removal twin of vec-pop! that keeps NOTHING: it shrinks len and, when
;;; bit 0 of `owned` is set (a wide by-value element whose slot is an owned
;;; heap box), frees that box so it does not leak; when bit 1 is set (an rc<T>
;;; element) it releases the slot's strong reference.  Unlike vec-pop! it returns no value, so
;;; there is no ownership-transfer hazard.  Internal helper for the vec-drop-last!
;;; macro; not called directly.
;;;
;;; Parameters:
;;;   v     -- Vec[A] pointer
;;;   owned -- bit 0: the last slot is an owned element box; bit 1: the
;;;            last slot holds a strong rc<T> reference the Vec owns
;;;
;;; Since: multiword-element-box-lifecycle

(defn vec-drop-last-o! [A] [v : (Vec A) owned : int]
  #fx{}
  #writes v
  :void
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (vec->len == 0) return;
  vec->len--;
  if (owned & 1) {
    void *box = (void*)(intptr_t)vec->data[vec->len];
    if (box) free(box);
  }
  if (owned & 2) {
    RcControlBlock *__e = (RcControlBlock *)(intptr_t)vec->data[vec->len];
    if (__e) { rc_strong_decrement(__e); rc_free_queue_drain(); }
  }
  ```)
;;; vec-drop-last! -- remove the last element of a Vec[A], freeing its box.
;;;
;;; A macro so the multi-word-element decision folds at emit time: it binds v
;;; once and forwards it to vec-drop-last-o! along with `(tur-vec-elem-wide? v)`.
;;; For a wide by-value element the removed slot's heap box is freed; for a
;;; single-word element only len shrinks.  Use this instead of a discarded
;;; `(vec-pop! v)` when you want to drop the last element without keeping it --
;;; vec-pop! would transfer the box out and leak it (see vec-pop!).
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer
;;;
;;; Example:
;;;   (vec-drop-last! my-vec)
;;;
;;; Since: multiword-element-box-lifecycle

(defmacro vec-drop-last! [v]
  `(let [__tur_dl__ ~v]
     (vec-drop-last-o! __tur_dl__
       (+ (tur-vec-elem-wide? __tur_dl__) (* 2 (tur-vec-elem-rc? __tur_dl__))))))
;;; vec-set-o! -- overwrite the element at index i, freeing the old box when
;;; `boxed`.
;;;
;;; Internal helper for the vec-set! macro.  A multi-word by-value element rides
;;; its data slot as an owned heap box; overwriting the slot orphans the old box,
;;; so when bit 0 of `owned` is set the old `data[i]` box is freed before the new
;;; value is stored.  When bit 1 is set (an rc<T> element) the old slot's strong
;;; reference is released instead.  When `owned` is 0 (single-word, non-rc A) the
;;; slot is an inline value / shared pointer the Vec does not own, so it is
;;; overwritten directly.
;;;
;;; Aliasing caveat: freeing the old box invalidates any raw carrier a caller
;;; captured from an earlier `(vec-get v i)`.  The normal read pattern
;;; `(:: (vec-get v i) T)` deref-copies immediately, so no live alias survives
;;; the overwrite -- this holds under the collection's value-semantics ownership
;;; model (the Vec owns its element boxes).
;;;
;;; Parameters:
;;;   v     -- Vec[A] pointer
;;;   i     -- zero-based index
;;;   val   -- new element value of type A
;;;   owned -- bit 0: the slot is an owned element box; bit 1: the slot holds
;;;            a strong rc<T> reference the Vec owns
;;;
;;; Since: multiword-element-box-lifecycle

(defn vec-set-o! [A] [v : (Vec A) i :int val :A owned :int]
  #fx{}
  #writes v
  :void
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (i >= 0 && (size_t)i < (size_t)vec->len) {
    if (owned & 1) {
      void *old = (void*)(intptr_t)vec->data[i];
      if (old) free(old);
    }
    if (owned & 2) {
      RcControlBlock *__o = (RcControlBlock *)(intptr_t)vec->data[i];
      if (__o) { rc_strong_decrement(__o); rc_free_queue_drain(); }
    }
    TUR_REGION_NOTE(val);   /* region-lock-hardening: see vec-push! */
    vec->data[i] = (int64_t)val;
    return;
  }
  fprintf(stderr, "vec-set! index out of bounds\n");
  exit(1);
  ```)
;;; vec-set! -- overwrite the element at index i (freeing any old element box).
;;;
;;; A macro so the multi-word-element decision folds at emit time: it binds v/i/
;;; val once (preserving left-to-right evaluation) and forwards them to
;;; vec-set-o! along with `(tur-vec-elem-wide? v)`.  For a wide by-value element
;;; the overwritten slot's old heap box is freed; for a single-word element the
;;; slot is overwritten directly.  See vec-set-o! for the aliasing caveat.
;;;
;;; Parameters:
;;;   v   -- Vec[A] pointer
;;;   i   -- zero-based index
;;;   val -- new element value of type A
;;;
;;; Example:
;;;   (vec-set! my-vec 0 99)
;;;
;;; Since: Phase TC1

(defmacro vec-set! [v i val]
  `(let [__tur_sv__ ~v
         __tur_si__ ~i
         __tur_sx__ ~val]
     (vec-set-o! __tur_sv__
       __tur_si__
       __tur_sx__
       (+ (tur-vec-elem-wide? __tur_sv__) (* 2 (tur-vec-elem-rc? __tur_sv__))))))
;;; tur-vec-elem-wide? -- 1 if the Vec's element type A is a multi-word (> 8
;;; byte) by-value struct/ADT that rides its data slot as an int64 heap-box
;;; pointer, else 0.  Compiler-intercepted (src/compiler/emit_expr.c) as an
;;; EMIT-TIME type query that peels A out of the `(Vec A)` spine and reuses the
;;; same `type_is_wide_byval_adt` predicate the element-boxing bridge keys on;
;;; this pure-Turmeric fallback body returns 0 for the interpreter (where an
;;; element rides as a TuriStruct pointer, never a C box) and for any call the
;;; backend does not intercept.  vec-free threads it to vec-free-o so a
;;; Vec[Point]-style boxed buffer releases its element boxes on free.
;;;
;;; Since: multiword-element-box-lifecycle

(defn tur-vec-elem-wide? [A] [v : (Vec A)] : int 0)
;;; tur-vec-elem-rc? -- 1 if the Vec's element type A is an `rc<T>`, whose data
;;; slots hold a strong reference the Vec owns, else 0.  Compiler-intercepted
;;; (src/compiler/emit_expr.c) as an EMIT-TIME type query, exactly like its
;;; sibling tur-vec-elem-wide?; this pure-Turmeric fallback body returns 0 for
;;; the interpreter (where an rc rides as a first-class value, never a
;;; carrier-erased control-block pointer) and for any call the backend does not
;;; intercept.
;;;
;;; vec-free / vec-set! / vec-drop-last! thread it as BIT 1 of the `owned` flag
;;; (bit 0 being tur-vec-elem-wide?), so a Vec[rc<T>] releases each element's
;;; strong reference at the same points a Vec[Point] frees each element box.
;;; The matching increment is stamped at the push site by elab
;;; (own_carry_for_arg in src/compiler/elab_call.c).
;;;
;;; Since: collections-cannot-hold-rc-values

(defn tur-vec-elem-rc? [A] [v : (Vec A)] : int 0)
;;; vec-free-o -- free a Vec[A], its data buffer, and (when `boxed`) each
;;; per-element heap box.
;;;
;;; A multi-word by-value element A cannot ride the int64 data slot inline, so
;;; the concrete->carrier escaping bridge boxes it (malloc + copy) at the push
;;; site and stores the box pointer in `data[i]`.  Vec is mutable and NOT
;;; structurally shared, so the Vec owns those boxes outright: when bit 0 of
;;; `owned` is set (threaded by vec-free via the emit-time `tur-vec-elem-wide?`
;;; query) each `data[i]` box is freed before the data buffer.
;;;
;;; Bit 1 (threaded from `tur-vec-elem-rc?`) is the refcount twin: for a
;;; Vec[rc<T>] each slot holds a strong reference taken at the push site, so
;;; every one is released before the buffer goes.  When `owned` is 0 (any
;;; single-word, non-rc A -- :int, :cstr, :float, an opaque handle, a :heap
;;; pointer) the slot holds an inline value / shared pointer that the Vec does
;;; not own, so only the data buffer and header are freed.
;;;
;;; Parameters:
;;;   v     -- Vec[A] pointer to free
;;;   owned -- bit 0: each data slot is an owned element box; bit 1: each
;;;            data slot holds a strong rc<T> reference the Vec owns
;;;
;;; Since: multiword-element-box-lifecycle

(defn vec-free-o [A] [v : (Vec A) owned : int]
  #fx{}
  #writes v
  : void
  ```c
  struct { int64_t *data; int64_t len; int64_t cap; } *vec = (void*)(intptr_t)v;
  if (vec->data) {
    if (owned & 1) {
      for (int64_t i = 0; i < vec->len; i++) {
        void *box = (void*)(intptr_t)vec->data[i];
        if (box) free(box);
      }
    }
    if (owned & 2) {
      for (int64_t i = 0; i < vec->len; i++) {
        RcControlBlock *__e = (RcControlBlock *)(intptr_t)vec->data[i];
        if (__e) rc_strong_decrement(__e);
      }
      rc_free_queue_drain();
    }
    free(vec->data);
  }
  free(vec);
  ```)
;;; vec-free -- free a Vec[A], its data buffer, and any per-element boxes.
;;;
;;; A macro (not a plain defn) so the multi-word-element decision folds at
;;; emit time: it binds v once and forwards it to vec-free-o along with
;;; `(tur-vec-elem-wide? v)`, which the compiler resolves per monomorphization
;;; to 1 for a wide by-value element type (whose data slots are owned heap
;;; boxes) and 0 otherwise.  The interpreter expands the same form; there
;;; `tur-vec-elem-wide?` is 0 and vec-free-o routes to native_vec_free_o (the
;;; per-element boxes do not exist in the tree-walker).
;;;
;;; Parameters:
;;;   v -- Vec[A] pointer to free
;;;
;;; Example:
;;;   (vec-free my-vec)
;;;
;;; Since: Phase TC1

(defmacro vec-free [v]
  `(let [__tur_fv__ ~v]
     (vec-free-o __tur_fv__
       (+ (tur-vec-elem-wide? __tur_fv__) (* 2 (tur-vec-elem-rc? __tur_fv__))))))
;;; vec-push-each__ -- internal helper for the vec-of macro.
;;;
;;; Expands a sequence of pushes onto `v` followed by `v` itself as the
;;; final value. Recursive: each step emits `(do (vec-push! v x) ...)`.

(defmacro vec-push-each__ [v & xs]
  (if (empty? xs)
    v
    (list do (list vec-push! v (first xs)) (list vec-push-each__ v ~@(rest xs)))))
;;; tur-vec-homog__ -- internal: compile-time element homogeneity check.
;;;
;;; Both parameters share the single type variable A, so a call with two
;;; differently-typed arguments is a TUR-E0001 at elaboration. The body is a
;;; no-op; the call exists only to make the type-checker enforce that adjacent
;;; vec-of elements have the same type. No allocation (fixed arity).

(defn tur-vec-homog__ [A] [a :A b :A] :nil ```c (void)a; (void)b; ```)
;;; vec-homog-chain__ -- internal: pairwise-chain tur-vec-homog__ over xs.
;;;
;;; Emits (tur-vec-homog__ x0 x1), (tur-vec-homog__ x1 x2), ... so all
;;; elements transitively unify to one type. Zero or one element: no check.

(defmacro vec-homog-chain__ [& xs]
  (if (empty? xs)
    0
    (if (empty? (rest xs))
      0
      (list do
        (list tur-vec-homog__ (first xs) (second xs))
        (list vec-homog-chain__ ~@(rest xs))))))
;;; vec-empty-like__ -- internal: a fresh empty Vec[A] whose element type A
;;; is grounded by a type-witness value.
;;;
;;; `(vec-new)` on its own returns a bare `:A` result that summarizes to the
;;; int64 carrier, so a `(let [v (vec-new)] ...)` binding freezes at the
;;; carrier and later element reads (`show`/`eq?` dispatch) cannot recover the
;;; concrete element type -- a Vec[cstr] then shows/compares by pointer.  By
;;; threading one already-typed element through `witness : A`, the returned
;;; `(:: (vec-new) (Vec A))` is a genuine `(Vec A)` whose head carries the
;;; concrete element type, so the vec-of result dispatches element typeclass
;;; methods correctly.  The witness value itself is unused (only its type is
;;; consumed), so it never widens or truncates the stored data.

(defn vec-empty-like__ [A] [^borrow witness : A] : (Vec A)
  (:: (vec-new) (Vec A)))
;;; vec-of -- variadic Vec[A] literal.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements, all of type A.
;;;
;;; Returns:
;;;   A fresh Vec[A] populated with xs in order. The element type A may be
;;;   any single-word type (:int, :cstr, :bool, :nil, :float, an opaque
;;;   handle, or a heap struct/ADT pointer); elements are stored through an
;;;   :int carrier slot, so a :float element round-trips as a bit-reinterpret.
;;;   The result's static type is a genuine (Vec A) -- its head carries the
;;;   concrete element type -- so `(show (vec-of "a" "b"))` renders "[a b]" and
;;;   `(eq? (vec-of "a") (vec-of "b"))` compares by the element's Eq instance
;;;   rather than by carrier identity. The handle composes with vec-len,
;;;   vec-get, vec-push!, etc.; vec-get returns :A, so a non-int element is
;;;   read with an ascription, e.g. (:: (vec-get v 0) :float).
;;;
;;; Note: all elements must unify to a single type. Mixing types -- e.g.
;;;   (vec-of 1 "x" 3.14) -- is a type error (TUR-E0001 on the offending
;;;   element). For heterogeneous fixed-arity collections, use tupleN.
;;;   Aggregate (multi-word struct/ADT) element types are not supported by
;;;   the carrier slot; those need a per-element typed layout (see TS3b).
;;;
;;; Note: each element expression is evaluated exactly once (the first is
;;;   bound once and reused as both the type witness and the first push).
;;;
;;; Note: under -Xdata-literals, a [...] vector in expression position lowers
;;;   to this macro, so [1 2 3] is sugar for (vec-of 1 2 3).  See
;;;   docs/guides/data-literals-guide.md.
;;;
;;; Example:
;;;   (vec-of)        ; => empty Vec
;;;   (vec-of 1 2 3)  ; => Vec containing 1, 2, 3
;;;   [1 2 3]         ; => same, with -Xdata-literals
;;;
;;; Since: Phase 2 cons-in-docs cleanup

(defmacro vec-of [& xs]
  (if (empty? xs)
    (list vec-new)
    ;; Bind the first element once; use it both as the (Vec A) type witness
    ;; and as the first push, so the vec's head carries the concrete element
    ;; type A.  A carrier-typed `(vec-new)` binding would freeze at the int64
    ;; carrier and lose element-typeclass dispatch (Show/Eq over cstr, etc.).
    ;; Homogeneity is enforced by vec-push!'s `(Vec A)` element type: a
    ;; mismatched element is a TUR-E0001 at the offending push.
    (list let
      `[__vw ~(first xs)]
      (list let
        `[__v (vec-empty-like__ __vw)]
        (list do
          (list vec-push! __v __vw)
          (list vec-push-each__ __v ~@(rest xs))
          __v)))))
;;; vec-eq? -- compare two Vec[A] element-wise using a comparator.
;;;
;;; This helper hands the comparator RAW slot words -- it reads a->data[i]
;;; straight out of the buffer rather than passing a value across the carrier
;;; boundary. So do list-eq?, option-eq?, result-eq? and pair-eq?, each from
;;; its own payload slots; map-eq? and set-eq-cmp? are the exception, handing
;;; over a HAMT-stored carrier box instead. The difference matters only for an
;;; element whose word is not a box, a niche (Option P) above all: it rides
;;; its slot as the payload pointer itself.
;;;
;;; Either spelling works, here and at every one of those helpers: declare the
;;; comparator's parameter types, or write the comparator inline at the call,
;;; and the value is bridged for you whichever convention it arrived in. A
;;; NAMED comparator with erased parameters over such an element cannot be
;;; given the convention and is refused with TUR-E0715.
;;;
;;; Parameters:
;;;   v1     -- first Vec[A]
;;;   v2     -- second Vec[A]
;;;   cmp-fn -- comparator fn [a :A b :A] :bool, receiving raw slot words
;;;
;;; Returns:
;;;   true if both vecs have the same length and all element pairs satisfy cmp-fn.
;;;
;;; Example:
;;;   (vec-eq? va vb (fn [a b] (= a b)))  ; => true
;;;   (vec-eq? vo wo (fn [a : (Option String) b : (Option String)] : bool
;;;                    (eq? a b)))        ; => true
;;;
;;; Since: Phase TC1

(defn vec-eq? [A] [v1 : int v2 : int ^borrow ^fat cmp-fn : (fn [A A] bool)]
  #fx{}
  : bool
  ```c
  struct { int64_t *data; size_t len; size_t cap; } *a = (void*)(intptr_t)v1;
  struct { int64_t *data; size_t len; size_t cap; } *b = (void*)(intptr_t)v2;
  if (a->len != b->len) return false;
  /* CRU B-3: cmp-fn is a fat closure box; fat-dispatch via slot 0 (a capturing
     element comparator works; captureless lambdas are boxed at the call site). */
  for (size_t i = 0; i < a->len; i++) {
      if (!((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)cmp_fn)[0])((void*)(intptr_t)cmp_fn, a->data[i], b->data[i]))
          return false;
  }
  return true;
  ```)
;;; Eq [Vec] -- element-wise equality using the element type's Eq instance.
;; TC1-5: Phase PTC4 -- constrained Eq instance for Vec[A].
;; Note: element comparison uses integer equality; correct for all primitive A.
;;
;; The by-value `vec-len-byval` / `vec-eq-loop-byval` twins that the old
;; by-value `Eq [Vec]` used were retired once the instance moved to the
;; carrier-based `vec-eq?` delegation below (end-to-end-monomorphization root 2
;; retirement) -- they are no longer reachable, so they are gone (plan step 5).
;; `vec-get-byval` (the Option C twin redirect target for `vec-get` inside
;; specs) and `vec-data-get__` stay; they are part of the shared redirect
;; mechanism still used by Map/Set-bound fixtures.

(defn vec-data-get__ [data : ptr<void> i : int] : int
  ```c return ((int64_t *)(intptr_t)data)[i]; ```)
;;; vec-data-get-checked__ -- bounds-checked indexed read over a raw data ptr.
;; Internal: shared inline-C core for the by-value vec-get-byval (and the
;; carrier vec-get, if it ever delegates).  Aborts on out-of-range like
;; vec-get.


(defn vec-data-get-checked__ [data : ptr<void> i : int len : int] : int
  ```c
  if (i >= 0 && (size_t)i < (size_t)len) return ((int64_t *)(intptr_t)data)[i];
  fprintf(stderr, "vec index out of bounds\n");
  exit(1);
  return 0;
  ```)
;;; vec-get-byval -- by-value Vec[A] indexed read (Option C twin of vec-get).
;; M5 (end-to-end-monomorphization): the by-value counterpart of vec-get.
;; The emitter redirects a `vec-get` call inside a by-value spec body here so
;; the Vec receiver flows by value instead of bridging back to the int64
;; carrier.  Dual-ABI: `.data`/`.len` field access lowers direct in a spec
;; and derefs through the carrier in the (element-agnostic) base.


(defn vec-get-byval [A] [v : (Vec A) i : int] : A
  (:: (vec-data-get-checked__ (.data v) i (.len v)) A))
;;; vec-eq-loop -- pure-Turmeric element-wise Vec[A] comparison (TCO'd index loop).
;;;
;;; Path A specializes this per element type; the self-tail-call lowers to a
;;; goto loop inside the spec (TCO-in-ABI-specs, emit_fns.c eligibility gate),
;;; so deep iteration on large vecs does not grow the C stack.  Unlike the
;;; inline-C `vec-eq?` carrier helper, the receiver flows by value: `vec-get`
;;; is redirected to `vec-get-byval` inside the spec body, so no
;;; `(:: x :int)` relabel and no concrete->carrier bridge is minted at the
;;; `Eq [Vec]` dispatch site.
;;;
;;; The `^Eq A` constraint scopes the element Eq dictionary and each pair is
;;; compared with `(eq? (:: (vec-get x i) A) (:: (vec-get y i) A))` directly --
;;; mirroring vec-show-loop's element dispatch.  This is deliberately NOT a
;;; comparator-closure design: an `(fn [a b] (eq? a b))` lambda passed in from
;;; the Eq[Vec] instance defaults its params to the int64 carrier and bakes a
;;; single non-specialized Eq[int] closure (pointer/word comparison), which is
;;; a silent miscompare for cstr and every other content type.  Reading and
;;; ascribing the element to A here re-drives dispatch per ABI specialization,
;;; so Eq[cstr] (strcmp), Eq[bool], etc. are threaded correctly.
;;;
;;; Parameters:
;;;   x   -- first Vec[A]
;;;   y   -- second Vec[A]
;;;   i   -- current index (start at 0)
;;;   len -- shared length (both vecs are known equal-length by the caller)
;;;
;;; Returns:
;;;   true if x[i..len) equals y[i..len) under Eq[A].
;;;
;;; Example:
;;;   (vec-eq-loop a b 0 (vec-len a))  ; => true
;;;
;;; Since: Phase M4c (TCO-in-ABI-specs)

(defn vec-eq-loop [^Eq A] [x : (Vec A) y : (Vec A) i : int len : int] : bool
  (if (= i len)
    true
    (if (eq? (:: (vec-get x i) A) (:: (vec-get y i) A))
      (vec-eq-loop x y (+ i 1) len)
      false)))
;;; Eq [Vec] -- element-wise equality using the element type's Eq instance.
;; M4c (TCO-in-ABI-specs): the instance body is now pure Turmeric.  Path A
;; specializes `vec-eq-loop` to the concrete element type and the self-tail-
;; call becomes a loop after TCO, so the by-value Vec receiver never bridges
;; back to the int64 carrier.  The inline-C `vec-eq?` helper stays for
;; external callers and the un-specialized (abstract-A) carrier dispatch.
;; The earlier "carrier-based Eq [Vec] breaks the build" finding predated
;; #377 (when `(Vec A)` was a by-value `Vec__int` and the relabel was a
;; struct widening); that no longer holds, and TCO inside ABI specs (gate
;; lifted in emit_fns.c) lets the pure-Turmeric body iterate without a
;; carrier helper at all.  vec-eq-loop dispatches the element `eq?` directly
;; on A, so no carrier-collapsing comparator closure is threaded (that closure
;; hard-coded Eq[int] and silently pointer-compared cstr elements).

(definstance Eq [Vec]
  [(Eq A)]
  (eq? [x y]
    (and (= (vec-len (:: x (Vec A))) (vec-len (:: y (Vec A))))
      (vec-eq-loop (:: x (Vec A)) (:: y (Vec A)) 0 (vec-len (:: x (Vec A)))))))
