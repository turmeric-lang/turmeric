    {"Env/new-sandboxed", "Env/new-sandboxed"},
    {"Env/free", "Env/free"},
    {"eval", "eval"},
    {"eval-file", "eval-file"},
    {"eval!", "eval!"},
    {"eval-free", "eval-free"},
    {"eval-ok?", "eval-ok?"},
    {"eval-err?", "eval-err?"},
    {"eval-err-msg", "eval-err-msg"},
    {"eval-as-int", "eval-as-int"},
    {"eval-as-bool", "eval-as-bool"},
    {"eval-as-cstr", "eval-as-cstr"},
    {"eval-tag", "eval-tag"},
    {"tur/typeclass-clone", "tur/typeclass-clone -- minimal Clone typeclass stub for definstance sites.\n\nSince: Phase B1"},
    {"tur/typeclass-eq", "tur/typeclass-eq -- minimal Eq typeclass stub for typed-collection definstances.\n\nSince: Phase PTC4"},
    {"tur/typeclass-hash", "tur/typeclass-hash -- minimal Hash typeclass stub for typed-collection keys.\n\nSince: Phase GHE0"},
    {"Sum", "Sum -- int under addition. Identity 0."},
    {"Product", "Product -- int under multiplication. Identity 1."},
    {"MinI", "MinI -- int under minimum. Identity is the largest int64."},
    {"MaxI", "MaxI -- int under maximum. Identity is the smallest int64."},
    {"Any", "Any -- bool under disjunction. Identity false."},
    {"All", "All -- bool under conjunction. Identity true."},
    {"Semigroup", "Semigroup [Sum] -- addition."},
    {"Monoid", "Monoid [Sum] -- identity 0."},
    {"law-associative?", "law-associative? -- does combine associate for these three values?\n\nParameters:\n   -- x y z -- values to check\n\nReturns:\n  true when (combine (combine x y) z) equals (combine x (combine y z)).\n\nExample:\n  (law-associative? (:: 1 Sum) (:: 2 Sum) (:: 3 Sum))   ; => true\n\nSince: lattice-vocabulary-plan L2"},
    {"law-identity?", "law-identity? -- is mempty a two-sided identity for this value?\n\nParameters:\n  x -- value to check\n\nReturns:\n  true when (combine (mempty) x) and (combine x (mempty)) both equal x.\n\nExample:\n  (law-identity? (:: 5 Product))   ; => true\n\nSince: lattice-vocabulary-plan L2"},
    {"mconcat-from", "mconcat-from -- fold a Vec into an accumulator with combine.\n\nParameters:\n  v -- the Vec to fold\n  i -- index to start at\n  n -- index to stop before\n  acc -- accumulator\n\nReturns:\n  acc combined with v[i..n).\n\nSince: lattice-vocabulary-plan L4"},
    {"mconcat", "mconcat -- combine every element of a Vec, left to right, from mempty.\n\nParameters:\n  v -- the Vec to fold\n\nReturns:\n  mempty when v is empty, else v[0] combined with the rest in order.\n\nExample:\n  (mconcat (vec-of (:: 1 Sum) (:: 2 Sum) (:: 3 Sum)))   ; => Sum 6\n\nSince: lattice-vocabulary-plan L4"},
    {"JoinSemilattice", "JoinSemilattice [MaxI] -- least upper bound is the larger int."},
    {"BoundedJoin", "BoundedJoin [MaxI] -- least element is the smallest int64."},
    {"MeetSemilattice", "MeetSemilattice [MinI] -- greatest lower bound is the smaller int."},
    {"BoundedMeet", "BoundedMeet [MinI] -- greatest element is the largest int64."},
    {"law-join-associative?", "law-join-associative? -- does join associate?\n\nParameters:\n   -- x y z -- values to check\n\nReturns:\n  true when (join (join x y) z) equals (join x (join y z)).\n\nExample:\n  (law-join-associative? (:: 1 MaxI) (:: 2 MaxI) (:: 3 MaxI))   ; => true\n\nSince: lattice-vocabulary-plan L3"},
    {"law-join-commutative?", "law-join-commutative? -- does join commute?\n\nParameters:\n   -- x y -- values to check\n\nReturns:\n  true when (join x y) equals (join y x).\n\nExample:\n  (law-join-commutative? (:: 1 MaxI) (:: 2 MaxI))   ; => true\n\nSince: lattice-vocabulary-plan L3"},
    {"law-join-idempotent?", "law-join-idempotent? -- is join idempotent?\n\nParameters:\n  x -- value to check\n\nReturns:\n  true when (join x x) equals x.\n\nExample:\n  (law-join-idempotent? (:: 1 MaxI))   ; => true\n\nSince: lattice-vocabulary-plan L3"},
    {"law-bottom-identity?", "law-bottom-identity? -- is bottom a left identity for join?\n\nParameters:\n  x -- value to check\n\nReturns:\n  true when (join (bottom) x) equals x.\n\nExample:\n  (law-bottom-identity? (:: 3 MaxI))   ; => true\n\nSince: lattice-vocabulary-plan L3"},
    {"lattice-leq?", "lattice-leq? -- the partial order induced by join.\n\nParameters:\n  x -- candidate lower value\n  y -- candidate upper value\n\nReturns:\n  true when (join x y) equals y, i.e. x <= y in the lattice order.\n\nExample:\n  (lattice-leq? (:: 3 MaxI) (:: 7 MaxI))   ; => true\n\nSince: lattice-vocabulary-plan L3"},
    {"law-meet-idempotent?", "law-meet-idempotent? -- is meet idempotent?\n\nParameters:\n  x -- value to check\n\nReturns:\n  true when (meet x x) equals x.\n\nExample:\n  (law-meet-idempotent? (:: 1 MinI))   ; => true\n\nSince: lattice-vocabulary-plan L3"},
    {"law-top-identity?", "law-top-identity? -- is top a left identity for meet?\n\nParameters:\n  x -- value to check\n\nReturns:\n  true when (meet (top) x) equals x.\n\nExample:\n  (law-top-identity? (:: 3 MinI))   ; => true\n\nSince: lattice-vocabulary-plan L3"},
    {"tur/typeclass-lattice", "tur/typeclass-lattice -- Semigroup, Monoid, and the selection newtypes.\n\nSince: lattice-vocabulary-plan L2 (lattice four: L3)"},
    {"cstr-compare__", "cstr-compare__ -- internal: strcmp for Ord [cstr]."},
    {"max", "max -- the greater of two Ord values.\n\nParameters:\n  x -- first value\n  y -- second value\n\nReturns:\n  x when (gte? x y), else y.\n\nExample:\n  (max 2.5 7.1)                              ; => 7.1\n    (defn hi [^Ord A] [a : A b : A] : A (max a b))\n\nSince: lattice-vocabulary-plan L1"},
    {"min", "min -- the lesser of two Ord values.\n\nParameters:\n  x -- first value\n  y -- second value\n\nReturns:\n  y when (gte? x y), else x.\n\nExample:\n  (min \"alpha\" \"beta\")   ; => \"alpha\"\n\nSince: lattice-vocabulary-plan L1"},
    {"tur/typeclass-ord", "tur/typeclass-ord -- the Ord typeclass, its primitive instances, and max/min.\n\nSince: Phase 15 (max/min: lattice-vocabulary-plan L1)"},
    {"vec-show-loop", "vec-show-loop -- push \"e0 e1 ...\" element reprs into the builder."},
    {"set-show-loop", "set-show-loop -- push the space-separated element reprs into b."},
    {"map-show-loop", "map-show-loop -- push the space-separated \"k v\" reprs into b."},
    {"show-char-name__", "show-char-name__ -- internal: the reader's name for code n (\"\" if none)."},
    {"show-char-named?__", "show-char-named?__ -- internal: does the reader have a name for code n?"},
    {"show-hex-digit__", "show-hex-digit__ -- internal: the lower-case hex digit for 0..15."},
    {"show-string-fputs", "show-string-fputs -- internal: write a cstr to stdout with no newline."},
    {"print-show", "print-show -- render x via Show and print it (no trailing newline).\n\nExample:\n  (print-show 42)  ; prints: 42\n\nSince: v2 (show-owned-result-plan)"},
    {"show-line", "show-line -- render x via Show and print it with a trailing newline.\n\nExample:\n  (show-line 42)  ; prints: 42\\n\n\nSince: v2 (show-owned-result-plan)"},
    {"tur/typeclass-show", "tur/typeclass-show -- the Show typeclass (owned String result) and its\n\nSince: v2 (show-owned-result-plan, stage 4)"},
    {"Display", "Display [int] -- Display instance for int."},
    {"Debug", "Debug [int] -- Debug instance for int."},
    {"Error", "Error [ptr<void>] -- Error instance for result<T,E> represented as ptr<void>."},
    {"tur/typeclass", "tur/typeclass -- built-in typeclasses: Eq, Ord, Show, Num.\n\nSince: Phase 15"},
    {"with-unique", "with-unique -- scope a uniquely-owned binding over a body.\n\nParameters:\n  binding -- a two-element form `[name init]`: the binding name and its\n   -- uniquely-owned initializer\n  body -- one or more expressions evaluated with `name` in scope\n\nReturns:\n  The value of the last body expression.\n\nExample:\n  (with-unique [u (make-ref 42)]   ; u : ^unique\n      (use-once u))                  ; consumed exactly once\n\nSince: UT3"},
    {"consume", "consume -- thread a unique value through a single transforming call.\n\nParameters:\n  x -- the uniquely-owned value to consume\n  f -- a function that takes ownership of `x` and returns a result\n\nReturns:\n  The result of `(f x)`.\n\nExample:\n  (consume buf buf-finish)   ; => the result of (buf-finish buf)\n\nSince: UT3"},
    {"replace", "replace -- displace a unique value, returning the old one.\n\nParameters:\n  old -- the uniquely-owned value being displaced\n  new -- the replacement value, consumed into the swap\n\nReturns:\n  The displaced `old` value, for the caller to inspect or drop.\n\nExample:\n  (let [displaced (replace current next)]\n      (drop! displaced))   ; old `current` handed back for disposal\n\nSince: UT3"},
    {"tur/unique", "tur/unique -- uniqueness-type patterns (with-unique, consume, replace).\n\nSince: UT3"},
    {"vec-of-sized", "vec-of-sized -- wrap a SizedVec into a Vec, hiding the size index.\n\nParameters:\n  sv -- a SizedVec value whose size index will be sealed\n\nReturns:\n  A value of type (exists [n] (SizedVec n int)) -- representable\n    uniformly regardless of the original size index.\n\nExample:\n  (vec-of-sized (SVCons 1 (SVCons 2 (SVNil))))\n      ; => packed Vec; opening it recovers a length-2 SizedVec.\n\nSince: Phase EX2-4"},
    {"open-vec", "open-vec -- bind the hidden size index and the underlying SizedVec.\n\nParameters:\n  vec-expr -- a Vec value (typically produced by vec-of-sized)\n  n-name -- symbol that names the fresh abstract size index\n  sv-name -- symbol that names the underlying SizedVec\n  body -- one or more body forms evaluated in the binders' scope\n\nReturns:\n  The value of the last body form.\n\nExample:\n  (open-vec (vec-of-sized (SVCons 1 (SVNil))) n sv\n      (sized-vec-len sv))   ; => 1\n\nSince: Phase EX2-4"},
    {"tur/vec-existential", "tur/vec-existential -- Vec[A] as a size-hiding existential for heterogeneous collections.\n\nSince: Phase EX2"},
    {"Vec", "Vec -- parameterized growable array with element type A.\n\nSince: Phase TC1"},
    {"vec-new", "vec-new -- allocate a new empty Vec[A].\n\nReturns:\n  A new empty Vec[A] with len=0 and cap=0.\n\nExample:\n  (vec-new)  ; => empty Vec\n\nSince: Phase TC1"},
    {"vec-len", "vec-len -- return the number of elements in a Vec[A].\n\nParameters:\n  v -- Vec[A] pointer\n\nReturns:\n  Element count.\n\nExample:\n  (vec-len my-vec)  ; => 3\n\nSince: Phase TC1"},
    {"vec-get", "vec-get -- return the element at index i (bounds-checked).\n\nParameters:\n  v -- Vec[A] pointer\n  i -- zero-based index\n\nReturns:\n  The element at index i (typed A, stored as int64_t).\n\nExample:\n  (vec-get my-vec 0)  ; => first element\n\nSince: Phase TC1"},
    {"vec-push!", "vec-push! -- append an element to the Vec[A].\n\nParameters:\n  v -- Vec[A] pointer\n  val -- element of type A to append\n\nExample:\n  (vec-push! my-vec 42)\n\nSince: Phase TC1"},
    {"vec-pop!", "vec-pop! -- remove and return the last element of a Vec[A].\n\nParameters:\n  v -- Vec[A] pointer\n\nReturns:\n  The last element of type A (as int64_t), or 0 if empty.\n\nExample:\n  (vec-pop! my-vec)  ; => last element\n\nSince: Phase TC1"},
    {"vec-drop-last-o!", "vec-drop-last-o! -- remove the last element and (when `boxed`) free its box.\n\nParameters:\n  v -- Vec[A] pointer\n  owned -- bit 0: the last slot is an owned element box; bit 1: the\n   -- last slot holds a strong rc<T> reference the Vec owns\n\nSince: multiword-element-box-lifecycle"},
    {"vec-drop-last!", "vec-drop-last! -- remove the last element of a Vec[A], freeing its box.\n\nParameters:\n  v -- Vec[A] pointer\n\nExample:\n  (vec-drop-last! my-vec)\n\nSince: multiword-element-box-lifecycle"},
    {"vec-set-o!", "vec-set-o! -- overwrite the element at index i, freeing the old box when\n\nParameters:\n  v -- Vec[A] pointer\n  i -- zero-based index\n  val -- new element value of type A\n  owned -- bit 0: the slot is an owned element box; bit 1: the slot holds\n   -- a strong rc<T> reference the Vec owns\n\nSince: multiword-element-box-lifecycle"},
    {"vec-set!", "vec-set! -- overwrite the element at index i (freeing any old element box).\n\nParameters:\n  v -- Vec[A] pointer\n  i -- zero-based index\n  val -- new element value of type A\n\nExample:\n  (vec-set! my-vec 0 99)\n\nSince: Phase TC1"},
    {"tur-vec-elem-wide?", "tur-vec-elem-wide? -- 1 if the Vec's element type A is a multi-word (> 8\n\nSince: multiword-element-box-lifecycle"},
    {"tur-vec-elem-rc?", "tur-vec-elem-rc? -- 1 if the Vec's element type A is an `rc<T>`, whose data\n\nSince: collections-cannot-hold-rc-values"},
    {"vec-free-o", "vec-free-o -- free a Vec[A], its data buffer, and (when `boxed`) each\n\nParameters:\n  v -- Vec[A] pointer to free\n  owned -- bit 0: each data slot is an owned element box; bit 1: each\n   -- data slot holds a strong rc<T> reference the Vec owns\n\nSince: multiword-element-box-lifecycle"},
    {"vec-free", "vec-free -- free a Vec[A], its data buffer, and any per-element boxes.\n\nParameters:\n  v -- Vec[A] pointer to free\n\nExample:\n  (vec-free my-vec)\n\nSince: Phase TC1"},
    {"vec-push-each__", "vec-push-each__ -- internal helper for the vec-of macro."},
    {"tur-vec-homog__", "tur-vec-homog__ -- internal: compile-time element homogeneity check."},
    {"vec-homog-chain__", "vec-homog-chain__ -- internal: pairwise-chain tur-vec-homog__ over xs."},
    {"vec-empty-like__", "vec-empty-like__ -- internal: a fresh empty Vec[A] whose element type A"},
    {"vec-of", "vec-of -- variadic Vec[A] literal.\n\nParameters:\n   -- & xs -- zero or more elements, all of type A.\n\nReturns:\n  A fresh Vec[A] populated with xs in order. The element type A may be\n    any single-word type (:int, :cstr, :bool, :nil, :float, an opaque\n    handle, or a heap struct/ADT pointer); elements are stored through an\n    :int carrier slot, so a :float element round-trips as a bit-reinterpret.\n    The result's static type is a genuine (Vec A) -- its head carries the\n    concrete element type -- so `(show (vec-of \"a\" \"b\"))` renders \"[a b]\" and\n    `(eq? (vec-of \"a\") (vec-of \"b\"))` compares by the element's Eq instance\n    rather than by carrier identity. The handle composes with vec-len,\n    vec-get, vec-push!, etc.; vec-get returns :A, so a non-int element is\n    read with an ascription, e.g. (:: (vec-get v 0) :float).\n  \n  Note: all elements must unify to a single type. Mixing types -- e.g.\n    (vec-of 1 \"x\" 3.14) -- is a type error (TUR-E0001 on the offending\n    element). For heterogeneous fixed-arity collections, use tupleN.\n    Aggregate (multi-word struct/ADT) element types are not supported by\n    the carrier slot; those need a per-element typed layout (see TS3b).\n  \n  Note: each element expression is evaluated exactly once (the first is\n    bound once and reused as both the type witness and the first push).\n  \n  Note: under -Xdata-literals, a [...] vector in expression position lowers\n    to this macro, so [1 2 3] is sugar for (vec-of 1 2 3).  See\n    docs/guides/data-literals-guide.md.\n\nExample:\n  (vec-of)        ; => empty Vec\n    (vec-of 1 2 3)  ; => Vec containing 1, 2, 3\n    [1 2 3]         ; => same, with -Xdata-literals\n\nSince: Phase 2 cons-in-docs cleanup"},
    {"vec-eq?", "vec-eq? -- compare two Vec[A] element-wise using a comparator.\n\nParameters:\n  v1 -- first Vec[A]\n  v2 -- second Vec[A]\n  cmp-fn -- comparator fn [a :A b :A] :bool, receiving raw slot words\n\nReturns:\n  true if both vecs have the same length and all element pairs satisfy cmp-fn.\n\nExample:\n  (vec-eq? va vb (fn [a b] (= a b)))  ; => true\n    (vec-eq? vo wo (fn [a : (Option String) b : (Option String)] : bool\n                     (eq? a b)))        ; => true\n\nSince: Phase TC1"},
    {"vec-data-get__", "Eq [Vec] -- element-wise equality using the element type's Eq instance."},
    {"vec-data-get-checked__", "vec-data-get-checked__ -- bounds-checked indexed read over a raw data ptr."},
    {"vec-get-byval", "vec-get-byval -- by-value Vec[A] indexed read (Option C twin of vec-get)."},
    {"vec-eq-loop", "vec-eq-loop -- pure-Turmeric element-wise Vec[A] comparison (TCO'd index loop).\n\nParameters:\n  x -- first Vec[A]\n  y -- second Vec[A]\n  i -- current index (start at 0)\n  len -- shared length (both vecs are known equal-length by the caller)\n\nReturns:\n  true if x[i..len) equals y[i..len) under Eq[A].\n\nExample:\n  (vec-eq-loop a b 0 (vec-len a))  ; => true\n\nSince: Phase M4c (TCO-in-ABI-specs)"},
    {"tur/vec", "tur/vec -- typed Vec[A]: parameterized growable array.\n\nSince: Phase TC1-A"},
    {"rc/downgrade", "rc/downgrade -- create a non-owning weak<A> observer of an rc<A>.\n\nParameters:\n  r -- the rc<A> to observe (borrowed, not consumed)\n\nReturns:\n  A weak<A> observing the same allocation without owning it. Release it with\n    `weak/drop` when done: a weak is NOT dropped automatically at scope exit,\n    and the control block outlives its value until the last weak goes away.\n\nExample:\n  (let [r (rc/of 42)]\n      (let [w (rc/downgrade r)]\n        (println (rc/strong-count r))   ; => 1 -- a weak adds no strong count\n        (weak/drop w)))\n\nSince: stdlib-weak-ref-audit WR1"},
    {"weak/upgrade", "weak/upgrade -- try to reclaim a strong rc<A> from a weak<A>.\n\nParameters:\n  w -- the weak<A> to upgrade (borrowed, not consumed)\n\nReturns:\n  (Option rc<A>) -- some(strong handle) if alive, none if the value is gone.\n\nExample:\n  (let [o (weak/upgrade w)]\n      (if (some? o)\n        (let [s (weak/unwrap o)]\n          (rc/drop s))          ; the upgraded handle is ours to release\n        (println \"gone\")))\n\nSince: stdlib-weak-ref-audit WR1"},
    {"weak/unwrap", "weak/unwrap -- take the rc<A> out of a successful (weak/upgrade w).\n\nParameters:\n  o -- the (Option rc<A>) returned by weak/upgrade\n\nReturns:\n  The contained rc<A>. The caller owns it and must `rc/drop` it.\n\nExample:\n  (let [o (weak/upgrade w)]\n      (when (some? o)\n        (let [s (weak/unwrap o)]\n          (rc/drop s))))\n\nSince: stdlib-weak-ref-audit WR1"},
    {"weak/alive?", "weak/alive? -- is the weak's referent still alive?\n\nParameters:\n  w -- the weak<A> to test (borrowed, not consumed)\n\nReturns:\n  true if a strong handle still exists, false once the value has been freed.\n\nExample:\n  (let [w (let [r (rc/of 99)] (rc/downgrade r))]\n      (println (weak/alive? w))   ; => false -- r died at scope exit\n      (weak/drop w))\n\nSince: stdlib-weak-ref-audit WR1"},
    {"weak/drop", "weak/drop -- release a weak<A> observation.\n\nParameters:\n  w -- the weak<A> to release (consumed)\n\nReturns:\n  Nothing.\n\nExample:\n  (let [r (rc/of 42)]\n      (let [w (rc/downgrade r)]\n        (weak/drop w)))\n\nSince: stdlib-weak-ref-audit WR1"},
    {"tur/weak", "tur/weak -- weak<T> non-owning references, and the cycle break they exist for.\n\nSince: stdlib-weak-ref-audit WR1"},
    {"save-cont!", "save-cont! -- serialise an opaque serial-continuation handle to a bytes value.\n\nParameters:\n  k -- opaque continuation pointer from serial-shift\n\nReturns:\n  A bytes :ptr<void> on success (a length-prefixed {int64 len; data} buffer\n    the caller owns and must free), or nil if k is nil.\n\nSince: Phase 21"},
    {"resume-cont!", "resume-cont! -- deserialise a bytes value and resume the encoded continuation with v.\n\nParameters:\n  b -- serialised bytes from save-cont!\n  v -- value to pass to the resumed continuation\n\nReturns:\n  The continuation's return value, after rebuilding the chain from b and\n    resuming it with v.  A b that is not a valid continuation buffer for\n    this program is a panic (never a resumed garbage chain); use\n    bytes->serial-cont from stdlib/serial.tur to get a Result instead.\n\nSince: Phase 21"},
    {"workflow-suspend", "workflow-suspend -- suspend the current workflow step by serialising continuation k.\n\nParameters:\n  k -- opaque continuation pointer from serial-shift\n\nReturns:\n  Serialised bytes :ptr<void> from save-cont! (nil if not yet implemented).\n\nExample:\n  (serial-reset\n      (let [ok? (serial-shift (fn [k] (workflow-suspend k)) false)]\n        ...))\n\nSince: Phase 21"},
    {"workflow-resume", "workflow-resume -- resume a previously suspended workflow step with value v.\n\nParameters:\n  b -- bytes value produced by workflow-suspend\n  v -- value to inject into the resumed continuation\n\nReturns:\n  The continuation's return value (0 when not yet implemented).\n\nSince: Phase 21"},
    {"tur/workflow", "tur/workflow -- persistent workflow helpers built on tur/serial.\n\nSince: Phase 21"},
    {"Zipper", "Zipper -- parameterized 1D list zipper with element type A.\n\nSince: Phase TC2"},
    {"zipper-new-raw", "zipper-new -- create a Zipper[A] from left array, focus, and right array.\n\nParameters:\n  left -- pointer to left neighbor array (int64_t*); leftmost = furthest from focus\n  left-len -- number of elements in left\n  focus -- focused element of type A\n  right -- pointer to right neighbor array (int64_t*); rightmost = furthest from focus\n  right-len -- number of elements in right\n\nReturns:\n  A new Zipper[A].\n\nExample:\n  (let [l (make-left-arr)\n          r (make-right-arr)\n          z (zipper-new l 2 5 r 2)]\n      (free l) (free r)             ; caller retains l / r ownership\n      ... use z ...\n      (zipper-free z))             ; frees the copies inside z\n\nSince: Phase TC2"},
    {"zipper-new", "zipper-new -- by-value: recover A from the typed focus element."},
    {"zipper-focus-raw", "zipper-focus -- return the focused element of a Zipper[A].\n\nParameters:\n  z -- Zipper[A]\n\nReturns:\n  The focused element of type A.\n\nExample:\n  (zipper-focus z)  ; => focused element\n\nSince: Phase TC2"},
    {"zipper-focus", "zipper-focus -- by-value: return the focused element typed as A."},
    {"zipper-move-left-raw", "zipper-move-left -- move the focus one step to the left; returns Option[Zipper[A]].\n\nParameters:\n  z -- Zipper[A]\n\nReturns:\n  some(new-zipper) if left neighbor exists, none otherwise.\n\nExample:\n  (zipper-move-left z)  ; => some(z') or none\n\nSince: Phase TC2"},
    {"zipper-move-left", "zipper-move-left -- by-value: some(z') if a left neighbor exists, else none."},
    {"zipper-move-right-raw", "zipper-move-right -- move the focus one step to the right; returns Option[Zipper[A]].\n\nParameters:\n  z -- Zipper[A]\n\nReturns:\n  some(new-zipper) if right neighbor exists, none otherwise.\n\nExample:\n  (zipper-move-right z)  ; => some(z') or none\n\nSince: Phase TC2"},
    {"zipper-move-right", "zipper-move-right -- by-value: some(z') if a right neighbor exists, else none."},
    {"zipper-free-raw", "zipper-free -- free a Zipper[A] and its neighbor arrays.\n\nParameters:\n  z -- Zipper[A] to free\n\nExample:\n  (zipper-free z)\n\nSince: Phase TC2"},
    {"zipper-free", "zipper-free -- by-value: free a Zipper[A] and its neighbor arrays."},
    {"tur/zipper", "tur/zipper -- typed Zipper[A]: 1D list zipper with typed focus and neighbors.\n\nSince: Phase TC2-B"},
    {NULL, NULL}
  };
  const char *n = (const char*)(intptr_t)name;
  if (!n) return 0;
  for (int __i = 0; entries[__i].key; __i++) {
    if (strcmp(entries[__i].key, n) == 0) {
      return (int64_t)(intptr_t)entries[__i].val;
    }
  }
  return 0;
  ```)

