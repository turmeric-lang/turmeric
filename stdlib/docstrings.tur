;; AUTO-GENERATED -- do not edit. Run: just docs
(defmodule tur/docstrings
  (export doc-lookup doc-verified?)

(defn doc-lookup [name : cstr] : cstr
  ```c
  static const struct { const char *key; const char *val; } entries[] = {
    {"arc/autolink-hint", "arc/autolink-hint -- link libturi and hoist the ArcControlBlock decls."},
    {"Arc", "Arc"},
    {"ArcWeak", "ArcWeak"},
    {"arc-new", "arc-new -- allocate an Arc holding an int payload, strong count 1.\n\nParameters:\n  v -- the value to share\n\nReturns:\n  A new Arc with strong count 1 and the weak sentinel held.\n\nExample:\n  (arc-get (arc-new 42))  ; => 42\n\nSince: 2026-08-20"},
    {"arc-clone", "arc-clone -- add a strong reference.\n\nParameters:\n  a -- the Arc to clone (borrowed; the caller keeps its own handle)\n\nReturns:\n  A second Arc onto the same value. Both must be dropped.\n\nExample:\n  (let [a (arc-new 1) b (arc-clone a)]\n      (println (arc-strong-count a)))  ; => 2\n\nSince: 2026-08-20"},
    {"arc-get", "arc-get -- read the shared value.\n\nParameters:\n  a -- the Arc to read (borrowed)\n\nReturns:\n  The contained value; 0 for a null handle or one already dropped.\n\nExample:\n  (arc-get (arc-new 7))  ; => 7\n\nSince: 2026-08-20"},
    {"arc-strong-count", "arc-strong-count -- how many Arc handles share this value.\n\nParameters:\n  a -- the Arc to inspect (borrowed)\n\nReturns:\n  The current strong count; 0 for a null handle.\n\nExample:\n  (arc-strong-count (arc-new 1))  ; => 1\n\nSince: 2026-08-20"},
    {"arc-weak-count", "arc-weak-count -- how many ArcWeak handles point at this value.\n\nParameters:\n  a -- the Arc to inspect (borrowed)\n\nReturns:\n  The weak count excluding the sentinel; 0 for a null handle.\n\nExample:\n  (let [a (arc-new 1) w (arc-downgrade a)]\n      (println (arc-weak-count a)))  ; => 1\n\nSince: 2026-08-20"},
    {"arc-drop", "arc-drop -- release one strong reference.\n\nParameters:\n  a -- the Arc to release (consumed -- do not use it afterwards)\n\nExample:\n  (let [a (arc-new 1)] (arc-drop a))\n\nSince: 2026-08-20"},
    {"arc-downgrade", "arc-downgrade -- make a non-owning ArcWeak from an Arc.\n\nParameters:\n  a -- the Arc to downgrade (borrowed)\n\nReturns:\n  An ArcWeak onto the same control block. Release it with arc-weak-drop.\n\nExample:\n  (let [a (arc-new 1) w (arc-downgrade a)]\n      (arc-weak-drop w) (arc-drop a))\n\nSince: 2026-08-20"},
    {"arc-try-upgrade", "arc-upgrade -- try to get a strong Arc back from a weak handle.\n\nParameters:\n  w -- the ArcWeak to upgrade (borrowed)\n\nReturns:\n  (some Arc) with the strong count incremented if the value is still\n    alive; (none) if the last strong reference has already gone.\n\nExample:\n  (let [a (arc-new 1) w (arc-downgrade a)]\n      (match (arc-upgrade w)\n        ((some b) (arc-drop b) 1)\n        ((none)   0)))              ; => 1\n\nSince: 2026-08-20"},
    {"arc-weak->arc", "arc-weak->arc -- internal: view a weak handle as the strong one it"},
    {"arc-upgrade", "arc-upgrade"},
    {"arc-weak-drop", "arc-weak-drop -- release one weak reference.\n\nParameters:\n  w -- the ArcWeak to release (consumed -- do not use it afterwards)\n\nExample:\n  (let [a (arc-new 1) w (arc-downgrade a)]\n      (arc-weak-drop w) (arc-drop a))\n\nSince: 2026-08-20"},
    {"arc", "tur/arc -- Arc<T>, the thread-safe counterpart to rc<T>.\n\nSince: 2026-08-20"},
    {"ArgSpec", "ArgSpec"},
    {"ArgResult", "ArgResult"},
    {"args/spec-new", "args/spec-new -- create a new empty argument specification.\n\nReturns:\n  A fresh ArgSpec handle.  Free with args/spec-free when done.\n\nExample:\n  (let [spec (args/spec-new)] ...)\n\nSince: Phase A1"},
    {"args/spec-prog", "args/spec-prog -- set the program name displayed in help text.\n\nParameters:\n  spec -- ArgSpec handle from args/spec-new\n  name -- program name cstr\n\nReturns:\n  The same ArgSpec (mutated in place).\n\nExample:\n  (args/spec-prog spec \"mytool\")\n\nSince: Phase A1"},
    {"args/spec-flag", "args/spec-flag -- register a boolean flag in the arg spec.\n\nParameters:\n  spec -- ArgSpec handle\n  name -- flag name including dashes (e.g., \"--verbose\")\n\nReturns:\n  The same ArgSpec (mutated in place).\n\nExample:\n  (args/spec-flag spec \"--verbose\")\n\nSince: Phase A1"},
    {"args/-no-default", "args/-no-default -- the NULL cstr the option cell stores for \"required\"."},
    {"args/-spec-option-raw", "args/-spec-option-raw -- register an option whose default is a cstr or NULL."},
    {"args/spec-option", "args/spec-option -- register a named option in the arg spec.\n\nParameters:\n  spec -- ArgSpec handle\n  name -- option name with dashes (e.g., \"--input\")\n  type -- one of \"string\", \"int\", \"float\", \"bool\"\n  dflt -- (some \"value\") for a default, (none) if the option is required\n\nReturns:\n  The same ArgSpec (mutated in place).\n\nExample:\n  (args/spec-option spec \"--input\" \"string\" (none))\n    (args/spec-option spec \"--count\" \"int\" (some \"1\"))\n\nSince: Phase A1"},
    {"args/spec-subcommand", "args/spec-subcommand -- register a nested subcommand.\n\nParameters:\n  spec -- parent ArgSpec handle\n  name -- subcommand name (e.g., \"build\")\n  sub-spec -- ArgSpec for the subcommand (from args/spec-new)\n\nReturns:\n  The same parent ArgSpec (mutated in place).\n\nExample:\n  (let [sub (args/spec-new)]\n      (args/spec-flag sub \"--release\")\n      (args/spec-subcommand spec \"build\" sub))\n\nSince: Phase A1"},
    {"args/parse", "args/parse -- parse a Turmeric *args* cons list against an arg spec.\n\nParameters:\n  spec -- ArgSpec handle from args/spec-new\n  argv -- Turmeric *args* cons list (the elaborator declares *args* itself\n   -- as :int, so this slot matches that global's own type)\n\nReturns:\n  An ArgResult handle. Free with args/result-free when done.\n\nExample:\n  (let [res (args/parse spec *args*)] ...)\n\nSince: Phase A1"},
    {"args/has?", "args/has? -- check whether a key is present in the result.\n\nParameters:\n  result -- ArgResult handle from args/parse\n  key -- option or flag name without dashes (e.g., \"verbose\")\n\nReturns:\n  true if the key was parsed or injected via a default.\n\nExample:\n  (args/has? res \"verbose\")  ; => true if --verbose was passed\n\nSince: Phase A1"},
    {"args/get-str", "args/get-str -- look up a string value in the result.\n\nParameters:\n  result -- ArgResult handle from args/parse\n  key -- option name without dashes (e.g., \"input\")\n\nReturns:\n  The string value, or 0 (NULL) if the key is not present.\n\nExample:\n  (args/get-str res \"input\")  ; => \"file.txt\"\n\nSince: Phase A1"},
    {"args/get-int", "args/get-int -- look up an integer value in the result.\n\nParameters:\n  result -- ArgResult handle from args/parse\n  key -- option name without dashes\n\nReturns:\n  The parsed integer value, or 0 if the key is not present.\n\nExample:\n  (args/get-int res \"count\")  ; => 5\n\nSince: Phase A1"},
    {"args/get-bool", "args/get-bool -- look up a boolean flag value in the result.\n\nParameters:\n  result -- ArgResult handle from args/parse\n  key -- flag name without dashes (e.g., \"verbose\")\n\nReturns:\n  true if the flag was set (value is \"1\", \"true\", \"yes\", or \"on\").\n\nExample:\n  (args/get-bool res \"verbose\")  ; => true if --verbose was passed\n\nSince: Phase A1"},
    {"args/subcommand", "args/subcommand -- return the matched subcommand name, or 0 if none.\n\nParameters:\n  result -- ArgResult handle from args/parse\n\nReturns:\n  The subcommand name cstr, or 0 if no subcommand was matched.\n\nExample:\n  (args/subcommand res)  ; => \"build\"\n\nSince: Phase A1"},
    {"args/-sub-result-raw", "args/-sub-result-raw -- the raw sub-result slot (0 when no subcommand ran)."},
    {"args/sub-result", "args/sub-result -- the result from subcommand parsing, if one matched.\n\nParameters:\n  result -- ArgResult handle from args/parse\n\nReturns:\n  (some sub-result) if a subcommand was matched, (none) otherwise.\n\nExample:\n  (let [sub (args/sub-result res)]\n      (match sub\n        (Some s) (args/get-bool s \"release\")\n        (None)   false))\n\nSince: Phase A1"},
    {"args/positional", "args/positional -- return the positional arg cons list from the result.\n\nParameters:\n  result -- ArgResult handle from args/parse\n\nReturns:\n  A Turmeric cons list (int64_t) of remaining positional cstr args.\n\nExample:\n  (args/positional res)  ; => cons list\n\nSince: Phase A1"},
    {"args/error?", "args/error? -- check whether parsing produced an error.\n\nParameters:\n  result -- ArgResult handle from args/parse\n\nReturns:\n  true if the result contains a parse error.\n\nExample:\n  (args/error? res)  ; => true if an unknown flag was passed\n\nSince: Phase A1"},
    {"args/error-msg", "args/error-msg -- return the parse error message, or 0 if no error.\n\nParameters:\n  result -- ArgResult handle from args/parse\n\nReturns:\n  The error message cstr, or 0 if there was no error.\n\nExample:\n  (args/error-msg res)  ; => \"required option --input not provided\"\n\nSince: Phase A1"},
    {"args/print-help", "args/print-help -- print usage information to stdout.\n\nParameters:\n  spec -- ArgSpec handle from args/spec-new\n\nExample:\n  (args/print-help spec)\n\nSince: Phase A1"},
    {"args/spec-free", "args/spec-free -- free a spec created by args/spec-new.\n\nParameters:\n  spec -- ArgSpec handle to free\n\nExample:\n  (args/spec-free spec)\n\nSince: Phase A1"},
    {"args/result-free", "args/result-free -- free a result created by args/parse (including sub-results).\n\nParameters:\n  result -- ArgResult handle to free\n\nExample:\n  (args/result-free result)\n\nSince: Phase A1"},
    {"tur/args", "tur/args -- CLI argument parser with a builder-pattern API.\n\nSince: Phase B1"},
    {"arr", "arr -- lift a function to an arrow (identity for function arrows).\n\nParameters:\n  f -- the function to lift\n\nReturns:\n  The function itself.\n\nExample:\n  (arr (fn [x] (+ x 1)))  ; => identity for functions"},
    {">>>", ">>> -- compose two function arrows sequentially (register-class-correct).\n\nParameters:\n  f -- first arrow (A -> B)\n  g -- second arrow (B -> C)\n\nReturns:\n  A closure (fn [A] C) that applies f then g.  Typed as a function, not\n    ptr<void>, so the result can be called directly at its element types.\n\nExample:\n  ((>>> (fn [x : float] : float (+ x 1.0))\n          (fn [x : float] : float (* x 2.0))) 3.0)  ; => 8.0\n\nSince: Phase CA1"},
    {"__arrow_pair_first", "__arrow_pair_first -- inline-C: apply fv to e1 of a heap pair *p,"},
    {"__arrow_pair_second", "__arrow_pair_second -- inline-C: apply fv to e2 of a heap pair *p,"},
    {"__arrow_pair_par", "__arrow_pair_par -- inline-C: apply fv to e1 and gv to e2 of *p."},
    {"__arrow_pair_split", "__arrow_pair_split -- inline-C: produce a heap pair from (fv x, gv x)."},
    {"__arrow_pair_dup", "__arrow_pair_dup -- inline-C: produce a heap pair with both fields = x."},
    {"arrow-first", "arrow-first -- apply a function to the first component of a Tuple2.\n\nParameters:\n  f -- function to apply\n\nReturns:\n  A function on Tuple2 that applies f to the first field.\n\nExample:\n  ((arrow-first (fn [x] (+ x 1))) <heap Tuple2 (5, 10)>)  ; => Tuple2(6, 10)"},
    {"arrow-second", "arrow-second -- apply a function to the second component of a Tuple2.\n\nParameters:\n  f -- function to apply\n\nReturns:\n  A function on Tuple2 that applies f to the second field.\n\nExample:\n  ((arrow-second (fn [x] (+ x 1))) <heap Tuple2 (5, 10)>)  ; => Tuple2(5, 11)"},
    {"par-comp", "par-comp -- parallel composition of two functions on Tuple2 types.\n\nParameters:\n  f -- function a -> b\n  g -- function c -> d\n\nReturns:\n  A function on Tuple2 a c -> Tuple2 b d:\n    (par-comp f g)(tuple2 x y) = tuple2(f x, g y).\n\nExample:\n  ((par-comp inc double) (tuple2 1 2))  ; => Tuple2(2, 4)"},
    {"arrow-split", "arrow-split -- duplicate input and apply two functions, returning a Tuple2.\n\nParameters:\n  f -- function a -> b\n  g -- function a -> c\n\nReturns:\n  A function a -> Tuple2 b c: (arrow-split f g)(x) = tuple2(f x, g x).\n\nExample:\n  ((arrow-split inc double) 3)  ; => Tuple2(4, 6)"},
    {"arrow-const", "arrow-const -- arrow that ignores its input and always returns v.\n\nParameters:\n  v -- the constant value to return\n\nReturns:\n  An arrow (any -> v).\n\nExample:\n  ((arrow-const 42) 999)  ; => 42\n\nSince: Phase B2"},
    {"arrow-dup", "arrow-dup -- arrow that duplicates its input into a Tuple2.\n\nParameters:\n  x -- the value to duplicate\n\nReturns:\n  A Tuple2 of x with itself: Tuple2(x, x).\n\nExample:\n  (tuple2-1st (arrow-dup 7))  ; => 7\n\nSince: Phase B2"},
    {"__ac_pair_first", "__ac_pair_first -- inline-C: apply fv to slot 0 of a heap pair, copy slot 1."},
    {"__ac_pair_second", "__ac_pair_second -- inline-C: copy slot 0 of a heap pair, apply fv to slot 1."},
    {"LoopCell", "LoopCell -- the fed-back `d` slot of an ArrowLoop, as a handle.\n\nSince: arrowloop-lazy-feedback"},
    {"loop-cell-of", "loop-cell-of -- read slot 1 of an ArrowLoop input pair as a LoopCell.\n\nParameters:\n  slot -- the erased slot-1 value handed to the looped arrow\n\nReturns:\n  The same handle, typed as a LoopCell.\n\nExample:\n  (loop-cell-force (loop-cell-of d))  ; => the fed-back value\n\nSince: arrowloop-lazy-feedback"},
    {"loop-cell-ready?", "loop-cell-ready? -- has the fed-back value been written yet?\n\nParameters:\n  c -- the feedback cell\n\nReturns:\n  true when loop-cell-force would succeed, false when it would black-hole.\n\nExample:\n  (if (loop-cell-ready? c) (loop-cell-force c) 0)\n\nSince: arrowloop-lazy-feedback"},
    {"loop-cell-force", "loop-cell-force -- read the fed-back value out of a feedback cell.\n\nParameters:\n  c -- the feedback cell\n\nReturns:\n  The fed-back d value, in the erased arrow carrier.\n\nExample:\n  (let [lp (arrow-loop step)]\n      (loop-cell-force (loop-cell-of (lp 7))))\n\nSince: arrowloop-lazy-feedback"},
    {"__ac_cell_new", "__ac_cell_new -- inline-C: allocate a feedback cell, filled or empty."},
    {"__ac_loop_step", "__ac_loop_step -- inline-C: the lazy (knot-tying) ArrowLoop step.  Allocate"},
    {"__ac_loop_fix_step", "__ac_loop_fix_step -- inline-C: the strict fixpoint ArrowLoop step.  Seed a"},
    {"__ac_loop_delay_step", "__ac_loop_delay_step -- inline-C: one step of the unit-delay ArrowLoop.  The"},
    {"__ac_app", "__ac_app -- inline-C: ArrowApply for (->).  The input pair carries an arrow"},
    {"Arrow", "Arrow [(->)] -- the function arrow: arr is the identity (a plain function"},
    {"ArrowChoice", "ArrowChoice [(->)] -- map an arrow over one arm of an Either, passing the"},
    {"ArrowLoop", "ArrowLoop [(->)] -- lazy (knot-tying) feedback: run the arrow on"},
    {"arrow-loop-lazy", "arrow-loop-lazy -- the bare-surface twin of the ArrowLoop [(->)] instance.\n\nParameters:\n  f -- the looped arrow, a (b, LoopCell) -> (c, d) over the heap-pair layout\n\nReturns:\n  A ptr<void> closure b -> c.\n\nExample:\n  ;; f parks the cell in c, so forcing c after the loop yields d = b * 10.\n    (let [lp (arrow-loop-lazy park-cell-step)]\n      (loop-cell-force (loop-cell-of (lp 7))))  ; => 70\n\nSince: arrowloop-lazy-feedback"},
    {"arrow-loop-fix", "arrow-loop-fix -- feedback by iteration to a fixpoint.\n\nParameters:\n  f -- the looped arrow, a (b, LoopCell) -> (c, d)\n  d0 -- the seed for the fed-back component\n  fuel -- maximum iterations; anything below 1 runs exactly one pass\n\nReturns:\n  A ptr<void> closure b -> c.\n\nExample:\n  ;; newton-step: d' = (d + b/d)/2, c = d  -- integer sqrt by fixpoint.\n    ((arrow-loop-fix newton-step 1 32) 144)  ; => 12\n\nSince: arrowloop-lazy-feedback"},
    {"arrow-loop-delay", "arrow-loop-delay -- feedback through a unit delay (step-indexed).\n\nParameters:\n  f -- the looped arrow, a (b, LoopCell) -> (c, d)\n  d0 -- the value the first call sees fed back\n\nReturns:\n  A ptr<void> closure b -> c, carrying its own feedback state.\n\nExample:\n  ;; sum-step: d' = d + b, c = d + b  -- a running total.\n    (let [acc (arrow-loop-delay sum-step 0)]\n      (acc 1) (acc 2) (acc 3))  ; => 1, 3, 6\n\nSince: arrowloop-lazy-feedback"},
    {"ArrowApply", "ArrowApply [(->)] -- the apply arrow: run the arrow in slot 0 on slot 1."},
    {"Category", "Category [(->)] -- the function arrow: `ident` is the plain identity"},
    {"tur/arrow", "tur/arrow -- arrow combinators over the (->) function arrow, in two surfaces.\n\nSince: Phase CA0"},
    {"async-file-open", "async-file-open -- open a file with O_NONBLOCK and return its file descriptor.\n\nParameters:\n  path -- filesystem path to the file\n  flags -- 0 = O_RDONLY, 1 = O_WRONLY|O_CREAT|O_TRUNC, 2 = O_RDWR\n\nReturns:\n  int -- the file descriptor, or -1 on error\n\nExample:\n  (async-file-open \"/tmp/out.txt\" 1)  ; => 5\n\nSince: Phase T24"},
    {"async-file-read", "async-file-read -- read up to buf-size bytes from a non-blocking file descriptor.\n\nParameters:\n  fd -- file descriptor returned by async-file-open\n  buf-size -- maximum number of bytes to read\n\nReturns:\n  int -- bytes read (>= 0), 0 on EOF, -1 on error\n\nExample:\n  (async-file-read fd 4096)  ; => 128\n\nSince: Phase T24"},
    {"async-file-write", "async-file-write -- write len bytes from data to a non-blocking file descriptor.\n\nParameters:\n  fd -- file descriptor returned by async-file-open\n  data -- pointer to the bytes to write\n  len -- number of bytes to write\n\nReturns:\n  int -- total bytes written, or -1 on error\n\nExample:\n  (async-file-write fd \"hello\" 5)  ; => 5\n\nSince: Phase T24"},
    {"async-file-close", "async-file-close -- close a file descriptor and unregister it from IO polling.\n\nParameters:\n  fd -- file descriptor to close\n\nReturns:\n  int -- 0 on success, -1 on error\n\nExample:\n  (async-file-close fd)  ; => 0\n\nSince: Phase T24"},
    {"async-file-read-buf", "async-file-read-buf -- retrieve the buffer pointer from the last async-file-read call.\n\nReturns:\n  ptr<void> -- pointer to the read buffer stored in fiber-local storage (caller must free)\n\nExample:\n  (async-file-read-buf)  ; => buf-ptr\n\nSince: Phase T24"},
    {"async-file-read-len", "async-file-read-len -- retrieve the byte count from the last async-file-read call.\n\nReturns:\n  int -- number of bytes read in the most recent async-file-read\n\nExample:\n  (async-file-read-len)  ; => 128\n\nSince: Phase T24"},
    {"tur/async_file", "tur/async_file -- non-blocking file I/O integrated with the cooperative scheduler.\n\nSince: Phase T24"},
    {"async-read-stdin", "async-read-stdin -- read up to buf-size bytes from stdin in non-blocking mode.\n\nParameters:\n  buf-size -- maximum number of bytes to read\n\nReturns:\n  int -- bytes read (>= 0), 0 on EOF, -1 on error\n\nExample:\n  (async-read-stdin 1024)  ; => bytes-read count (0 on EOF)\n\nSince: Phase T24"},
    {"async-stdin-buf", "async-stdin-buf -- retrieve the buffer pointer from the last async-read-stdin call.\n\nReturns:\n  ptr<void> -- pointer to the read buffer in fiber-local storage (caller must free)\n\nExample:\n  (async-stdin-buf)  ; => buf-ptr\n\nSince: Phase T24"},
    {"async-stdin-len", "async-stdin-len -- retrieve the byte count from the last async-read-stdin call.\n\nReturns:\n  int -- number of bytes read in the most recent async-read-stdin\n\nExample:\n  (async-stdin-len)  ; => byte count from last async-read-stdin\n\nSince: Phase T24"},
    {"async-write-stdout", "async-write-stdout -- write len bytes from data to stdout in non-blocking mode.\n\nParameters:\n  data -- pointer to the bytes to write\n  len -- number of bytes to write\n\nReturns:\n  int -- total bytes written, or -1 on error\n\nExample:\n  (async-write-stdout \"hello\\n\" 6)  ; => total bytes written (6 here)\n\nSince: Phase T24"},
    {"tur/async_pipe", "tur/async_pipe -- non-blocking stdin/stdout pipe I/O for the cooperative scheduler.\n\nSince: Phase T24"},
    {"async-socket-listen", "async-socket-listen -- create a non-blocking TCP listening socket on the given port.\n\nParameters:\n  port -- TCP port number to bind and listen on\n  backlog -- maximum length of the pending connection queue\n\nReturns:\n  int -- the listen file descriptor, or -1 on error\n\nExample:\n  (async-socket-listen 8080 128)  ; => 4\n\nSince: Phase T24"},
    {"async-socket-accept", "async-socket-accept -- accept an incoming connection, parking the fiber until one arrives.\n\nParameters:\n  listen-fd -- listening file descriptor returned by async-socket-listen\n\nReturns:\n  int -- the accepted client file descriptor, or -1 on error\n\nExample:\n  (async-socket-accept listen-fd)  ; => 7\n\nSince: Phase T24"},
    {"async-socket-connect", "async-socket-connect -- connect to a TCP server at host:port, parking the fiber until complete.\n\nParameters:\n  host -- IPv4 address string (e.g. \"127.0.0.1\")\n  port -- TCP port number to connect to\n\nReturns:\n  int -- the connected file descriptor, or -1 on error\n\nExample:\n  (async-socket-connect \"127.0.0.1\" 8080)  ; => 5\n\nSince: Phase T24"},
    {"async-socket-send", "async-socket-send -- send data on a connected socket, parking the fiber on EAGAIN.\n\nParameters:\n  fd -- connected socket file descriptor\n  data -- pointer to the bytes to send\n  len -- number of bytes to send\n\nReturns:\n  int -- total bytes sent, or -1 on error\n\nExample:\n  (async-socket-send fd \"GET / HTTP/1.0\\r\\n\" 16)  ; => 16\n\nSince: Phase T24"},
    {"async-socket-recv", "async-socket-recv -- receive up to buf-size bytes from a connected socket.\n\nParameters:\n  fd -- connected socket file descriptor\n  buf-size -- maximum number of bytes to receive\n\nReturns:\n  int -- bytes received (> 0), 0 on connection close, -1 on error\n\nExample:\n  (async-socket-recv fd 4096)  ; => 256\n\nSince: Phase T24"},
    {"async-socket-recv-buf", "async-socket-recv-buf -- retrieve the buffer pointer from the last async-socket-recv call.\n\nReturns:\n  ptr<void> -- pointer to the receive buffer in fiber-local storage (caller must free)\n\nExample:\n  (async-socket-recv-buf)  ; => buf-ptr\n\nSince: Phase T24"},
    {"async-socket-recv-len", "async-socket-recv-len -- retrieve the byte count from the last async-socket-recv call.\n\nReturns:\n  int -- number of bytes received in the most recent async-socket-recv\n\nExample:\n  (async-socket-recv-len)  ; => 256\n\nSince: Phase T24"},
    {"async-socket-close", "async-socket-close -- close a socket and unregister it from IO polling.\n\nParameters:\n  fd -- socket file descriptor to close\n\nExample:\n  (async-socket-close fd)\n\nSince: Phase T24"},
    {"tur/async_socket", "tur/async_socket -- non-blocking TCP socket I/O for the cooperative scheduler.\n\nSince: Phase T24"},
    {"AtomicCell", "AtomicCell"},
    {"atomic-new", "atomic-new -- allocate a heap-based atomic int64 cell initialised to init.\n\nParameters:\n  init -- initial integer value stored in the cell\n\nReturns:\n  An AtomicCell handle to the new atomic cell.\n\nExample:\n  (def a (atomic-new 0))  ; => AtomicCell holding 0\n\nSince: Phase T19"},
    {"atomic-load", "atomic-load -- atomically read the current value of the cell.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n\nReturns:\n  The current int64 value (sequentially-consistent load).\n\nExample:\n  (atomic-load a)  ; => 0\n\nSince: Phase T19"},
    {"atomic-store!", "atomic-store! -- atomically write v into the cell.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  v -- new value to store\n\nSince: Phase T19"},
    {"atomic-add!", "atomic-add! -- atomically add delta and return the old value.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  delta -- amount to add (may be negative)\n\nReturns:\n  The value of the cell before the addition.\n\nExample:\n  (atomic-add! a 5)  ; => old value; cell now holds old+5\n\nSince: Phase T19"},
    {"atomic-sub!", "atomic-sub! -- atomically subtract delta and return the old value.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  delta -- amount to subtract\n\nReturns:\n  The value of the cell before the subtraction.\n\nSince: Phase T19"},
    {"atomic-swap!", "atomic-swap! -- atomically replace the cell value with new-val and return the old value.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  new-val -- value to store\n\nReturns:\n  The value of the cell before the swap.\n\nExample:\n  (atomic-swap! a 99)  ; => old value; cell now holds 99\n\nSince: Phase T19"},
    {"atomic-cas!", "atomic-cas! -- compare-and-swap: if cell == expected, set to desired and return true.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n  expected -- value to compare against\n  desired -- value to store if comparison succeeds\n\nReturns:\n  true if the swap occurred, false if the current value differed from expected.\n\nExample:\n  (atomic-cas! a 0 1)  ; => true when cell held 0; cell now holds 1\n\nSince: Phase T19"},
    {"atomic-free", "atomic-free -- free an atomic cell allocated by atomic-new.\n\nParameters:\n  p -- atomic cell pointer from atomic-new\n\nSince: Phase T19"},
    {"tur/atomic", "tur/atomic -- atomic load/store/add/sub/swap/CAS on 64-bit integers.\n\nSince: Phase T19"},
    {"dfs-succeed", "dfs-succeed -- the goal with exactly one solution and no bindings.\n\nReturns:\n  A goal that calls `k` once and propagates its verdict.\n\nExample:\n  (dfs-solve (dfs-succeed) (fn [] true))  ; => 1\n\nSince: SX2"},
    {"dfs-fail", "dfs-fail -- the goal with no solutions.\n\nReturns:\n  A goal that never calls `k` and reports exhaustion.\n\nExample:\n  (dfs-solve (dfs-fail) (fn [] true))  ; => 0\n\nSince: SX2"},
    {"dfs-and", "dfs-and -- conjunction: g2 runs inside each solution of g1.\n\nParameters:\n  g1 -- the outer goal\n  g2 -- the inner goal, tried under each of g1's solutions\n\nReturns:\n  The conjoined goal.\n\nExample:\n  (dfs-and (dfs-set x 1) (dfs-set y 2))   ; one solution: x=1, y=2\n\nSince: SX2"},
    {"dfs-or", "dfs-or -- disjunction: g1's alternatives fully exhausted, then g2's.\n\nParameters:\n  g1 -- tried first, depth-first\n  g2 -- tried after g1 is exhausted\n\nReturns:\n  The disjoined goal.\n\nExample:\n  (dfs-or (dfs-set x 1) (dfs-set x 2))   ; two solutions\n\nSince: SX2"},
    {"dfs-guard", "dfs-guard -- succeed with no bindings iff `pred` holds NOW.\n\nParameters:\n  pred -- evaluated when the search reaches this goal\n\nReturns:\n  A goal with one solution when pred is true, none otherwise.\n\nExample:\n  (dfs-and (dfs-choose-int x 1 3)\n             (dfs-guard (fn [] (> (bt-get x) 1))))   ; x=2, x=3\n\nSince: SX2"},
    {"dfs-set", "dfs-set -- bind a trailed cell to a value.\n\nParameters:\n  c -- the cell\n  v -- the value\n\nReturns:\n  A goal with one solution (the binding) or none (refused write).\n\nSince: SX2"},
    {"dfs-choose-go", "dfs-choose-go -- internal: try binding c to each of lo..hi in order."},
    {"dfs-choose-int", "dfs-choose-int -- nondeterministically bind `c` to an integer in [lo, hi].\n\nParameters:\n  c -- the cell to bind\n  lo -- first candidate (inclusive)\n  hi -- last candidate (inclusive)\n\nReturns:\n  A goal with up to (hi - lo + 1) solutions.\n\nExample:\n  (dfs-choose-int x 1 8)   ; x = 1, then 2, ... then 8\n\nSince: SX2"},
    {"dfs-solve", "dfs-solve -- run a goal depth-first; count solutions.\n\nParameters:\n  goal -- the goal to run\n  on-solution -- reifier + continuation verdict, run per solution\n\nReturns:\n  The number of solutions on-solution saw.\n\nExample:\n  (dfs-solve (dfs-choose-int x 1 3)\n               (fn [] (do (println (bt-get x)) true)))   ; prints 1 2 3 => 3\n  \n  Carries `#fx{Bt}`: this is the entry point that actually runs the search\n  and so brackets, writes and unwinds the trail. The goal CONSTRUCTORS above\n  (`dfs-set`, `dfs-choose-int`, ...) do not carry it -- they only build a\n  closure, and the trail is touched when that closure runs, which is here.\n\nSince: SX2"},
    {"tur/backtrack-dfs", "tur/backtrack-dfs -- depth-first search driver over the backtracking trail."},
    {"Backtrack", "Backtrack -- a kind-(* -> *) handle over the list/non-determinism monad;\n\nSince: stdlib-hkt-consolidation T3"},
    {"bt-nil", "-- Helpers ────────────────────────────────────────────────────────────────\n\nReturns:\n  0 (null pointer representing the empty list)."},
    {"bt-cons", "bt-cons -- prepend a value to a backtrack result list.\n\nParameters:\n  v -- the value to prepend\n  next -- pointer to the existing result list (:int)\n\nReturns:\n  Pointer to the new cell (:int)."},
    {"mzero", "-- Core monad operations ──────────────────────────────────────────────────\n\nReturns:\n  An empty result list (:int null pointer).\n\nExample:\n  (mzero)  ; => 0"},
    {"mreturn", "mreturn -- lift a single value into the backtrack monad.\n\nParameters:\n  x -- the value to return\n\nReturns:\n  A singleton result list containing x (:int).\n\nExample:\n  (mreturn 42)  ; => list containing 42"},
    {"mplus", "mplus -- concatenate (union) two backtrack result lists.\n\nParameters:\n  xs -- first result list (:int)\n  ys -- second result list (:int)\n\nReturns:\n  A new result list with all elements from xs followed by all from ys (:int).\n\nExample:\n  (mplus (mreturn 1) (mreturn 2))  ; => list [1, 2]"},
    {"mbind", "mbind -- concatMap: apply fn to each result and concatenate all outputs.\n\nParameters:\n  ma -- a backtrack result list (:int)\n  fn -- fat closure of type (a -> Backtrack b)\n\nReturns:\n  The concatenated results of applying fn to each element of ma (:int).\n\nExample:\n  (mbind (mreturn 3) (fn [x] (mreturn (* x 2))))  ; => list [6]"},
    {"run-backtrack", "-- Run operations ─────────────────────────────────────────────────────────\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nReturns:\n  The same result list (the list monad is already eager) (:int).\n\nExample:\n  (run-backtrack (mreturn 1))  ; => list [1]"},
    {"run-backtrack-depth", "run-backtrack-depth -- return at most n results from a backtrack computation.\n\nParameters:\n  xs -- a backtrack result list (:int)\n  n -- maximum number of results to return (:int)\n\nReturns:\n  A truncated result list of length at most n (:int).\n\nExample:\n  (run-backtrack-depth my-results 5)  ; => first 5 results"},
    {"choice", "-- Combinators ────────────────────────────────────────────────────────────\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nReturns:\n  xs unchanged (:int)."},
    {"guard", "guard -- succeed with a dummy value when pred is true, fail otherwise.\n\nParameters:\n  pred -- boolean condition\n\nReturns:\n  (mreturn 0) if pred is true, (mzero) otherwise (:int).\n\nExample:\n  (guard (> x 0))  ; => mreturn 0 or mzero"},
    {"fresh", "fresh -- apply a fat closure to a fresh (unbound) logic variable.\n\nParameters:\n  f -- fat closure of type (a -> Backtrack b)\n\nReturns:\n  The result of applying f to the unbound sentinel (:int)."},
    {"once", "once -- keep only the first result from a backtrack computation.\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nReturns:\n  A singleton list containing the first element, or empty if xs is empty (:int).\n\nExample:\n  (once (mplus (mreturn 1) (mreturn 2)))  ; => list [1]"},
    {"interleave", "interleave -- fair interleaving of two backtrack result lists.\n\nParameters:\n  xs -- first result list (:int)\n  ys -- second result list (:int)\n\nReturns:\n  A new list that alternates elements from xs and ys (:int).\n\nExample:\n  (interleave (mreturn 1) (mreturn 2))  ; => list [1, 2] (interleaved)"},
    {"bt-length", "-- List utilities ─────────────────────────────────────────────────────────\n\nParameters:\n  xs -- a backtrack result list (:int)\n\nReturns:\n  The number of elements (:int).\n\nExample:\n  (bt-length (mplus (mreturn 1) (mreturn 2)))  ; => 2"},
    {"bt-print", "bt-print -- print each value in a backtrack result list to stdout.\n\nParameters:\n  xs -- a backtrack result list (:int)"},
    {"__bt-do", "-- backtrack-do macro ─────────────────────────────────────────────────────"},
    {"backtrack-do", "backtrack-do -- monadic do-notation for the backtracking monad.\n\nParameters:\n  forms -- alternating variable names and monadic expressions, then a body\n\nReturns:\n  A backtrack computation (result list) (:int).\n\nExample:\n  (backtrack-do x (mplus (mreturn 1) (mreturn 2))\n                  y (mplus (mreturn 10) (mreturn 20))\n                  (mreturn (+ x y)))  ; => list [11, 21, 12, 22]"},
    {"bt-apply-fat", "-- HKT typeclass instances (stdlib-hkt-consolidation T3) ────────────────────"},
    {"fmap-backtrack-raw", "fmap-backtrack-raw -- worker: map a `:fn` callback over every result."},
    {"ap-backtrack-raw", "ap-backtrack-raw -- int worker: cartesian application of fns to arguments."},
    {"Functor", "Functor [Backtrack] -- map a function over every result value.\n\nExample:\n  (fmap (mreturn 21) (fn [x] (* x 2)))  ; => [42]\n\nSince: stdlib-hkt-consolidation T3"},
    {"Applicative", "Applicative [Backtrack] -- pure is a singleton result; ap forms the cartesian\n\nExample:\n  (ap (mreturn (fn [x] (+ x 1))) (mreturn 41))  ; => [42]\n\nSince: stdlib-hkt-consolidation T3"},
    {"Monad", "Monad [Backtrack] -- bind is concatMap: feed every result into the\n\nExample:\n  (do-m x (mplus (mreturn 1) (mreturn 2)) (mreturn (* x 10)))  ; => [10 20]\n\nSince: stdlib-hkt-consolidation T3"},
    {"Alternative", "Alternative [Backtrack] -- empty is the failing search; alt-or unions the\n\nExample:\n  (alt-or (mreturn 1) (mreturn 2))  ; => [1 2]\n\nSince: stdlib-hkt-consolidation T3"},
    {"tur/backtrack", "tur/backtrack -- backtracking monad (list monad) for non-deterministic search.\n\nSince: Phase CA0"},
    {"Barrier", "Barrier"},
    {"barrier/autolink-hint", "barrier/autolink-hint -- hoist the TurBarrier layout to file scope."},
    {"barrier-new", "barrier-new -- create a barrier that releases every n-th waiter.\n\nParameters:\n  n -- number of threads that must rendezvous; must be >= 1\n\nReturns:\n  A Barrier handle. Free it with barrier-free.\n\nExample:\n  (let [b (barrier-new 3)] (barrier-free b))\n\nSince: 2026-08-20"},
    {"barrier-wait", "barrier-wait -- block until n threads have arrived, then release them all.\n\nParameters:\n  b -- the Barrier to wait on (borrowed)\n\nReturns:\n  true for exactly ONE of the n threads released -- the one whose arrival\n    tripped the barrier -- and false for the rest. Mirrors\n    PTHREAD_BARRIER_SERIAL_THREAD, and is what lets a single thread run the\n    between-phases work (swap buffers, print a summary) with no extra lock.\n\nExample:\n  (if (barrier-wait b) (println \"phase done\") 0)\n\nSince: 2026-08-20"},
    {"barrier-free", "barrier-free -- destroy the barrier and release its memory.\n\nParameters:\n  b -- the Barrier to destroy (consumed)\n\nExample:\n  (barrier-free b)\n\nSince: 2026-08-20"},
    {"tur/barrier", "tur/barrier -- counting barrier: N threads rendezvous, then all proceed.\n\nSince: 2026-08-20"},
    {"bit-shr", "bit-shr -- logical (unsigned) right shift of x by n bits.\n\nParameters:\n  x -- value to shift\n  n -- number of bit positions to shift right\n\nReturns:\n  x shifted right by n bits (unsigned/logical shift; 0-fills high bits).\n\nExample:\n  (bit-shr -1 1)  ; => 9223372036854775807  (fills with 0, not sign bit)\n\nSince: Phase B1"},
    {"float->bits", "float->bits -- reinterpret a float's IEEE-754 bit pattern as an :int.\n\nParameters:\n  x -- the float whose bit pattern is wanted\n\nReturns:\n  The 64 bits of x, as an :int.\n\nExample:\n  (bits->float (float->bits 1.5))  ; => 1.5\n\nSince: 2026-08-29"},
    {"bits->float", "bits->float -- reinterpret an :int's bit pattern as a float.\n\nParameters:\n  b -- the 64 bits to read as a float\n\nReturns:\n  The float those bits denote.\n\nExample:\n  (bits->float (float->bits 2.25))  ; => 2.25\n\nSince: 2026-08-29"},
    {"println-float", "println-float -- print a float with the specified number of decimal places.\n\nParameters:\n  x -- floating-point value to print\n  decimals -- number of decimal places (clamped to 0--17)\n\nReturns:\n  :nil\n\nExample:\n  (println-float 3.14159 6)  ; prints \"3.141590\"\n\nSince: Phase B1"},
    {"tur/bits", "tur/bits -- bitwise operations not expressible as arithmetic in Turmeric.\n\nSince: Phase B1"},
    {"FileSystem", "FileSystem -- opaque handle to a FileSystem capability vtable.\n\nSince: Phase 16"},
    {"Logger", "Logger -- opaque handle to a Logger capability vtable (debug/info/warn/error).\n\nSince: Phase 16"},
    {"Random", "Random -- opaque handle to a Random capability vtable (next-int/next-float).\n\nSince: Phase 16"},
    {"make-FileSystem", "make-FileSystem -- construct a FileSystem capability from four C callbacks.\n\nParameters:\n  read_fn -- (path buf buf_len out_len) -> error code\n  write_fn -- (path data data_len) -> error code\n  delete_fn -- (path) -> error code\n  list_fn -- (path entries max_entries out_count) -> error code\n\nReturns:\n  A heap-allocated FileSystem capability; free with FileSystem-free.\n\nExample:\n  (def fs (make-FileSystem my-read my-write my-delete my-list))\n\nSince: Phase 16"},
    {"FileSystem-free", "FileSystem-free -- free a FileSystem capability allocated by make-FileSystem.\n\nParameters:\n  fs -- FileSystem from make-FileSystem\n\nExample:\n  (FileSystem-free fs)\n\nSince: Phase 16"},
    {"make-Logger", "make-Logger -- construct a Logger capability from four C callbacks (debug/info/warn/error).\n\nParameters:\n  debug_fn -- (msg) -> nil\n  info_fn -- (msg) -> nil\n  warn_fn -- (msg) -> nil\n  error_fn -- (msg) -> nil\n\nReturns:\n  A heap-allocated Logger capability; free with Logger-free.\n\nExample:\n  (def lg (make-Logger on-debug on-info on-warn on-error))\n\nSince: Phase 16"},
    {"Logger-free", "Logger-free -- free a Logger capability allocated by make-Logger.\n\nParameters:\n  log -- Logger from make-Logger\n\nExample:\n  (Logger-free lg)\n\nSince: Phase 16"},
    {"make-Random", "make-Random -- construct a Random capability from two C callbacks.\n\nParameters:\n  next_int_fn -- (min max) -> an integer in [min, max]\n  next_float_fn -- () -> an integer in [0, 10000) representing a float\n\nReturns:\n  A heap-allocated Random capability; free with Random-free.\n\nExample:\n  (def rng (make-Random my-next-int my-next-float))\n\nSince: Phase 16"},
    {"Random-free", "Random-free -- free a Random capability allocated by make-Random.\n\nParameters:\n  rng -- Random from make-Random\n\nExample:\n  (Random-free rng)\n\nSince: Phase 16"},
    {"make-Time", "make-Time -- construct a Time capability from two C callbacks.\n\nParameters:\n  now_fn -- () -> current time in milliseconds since epoch\n  sleep_fn -- (ms) -> nil; sleeps for ms milliseconds\n\nReturns:\n  A heap-allocated Time capability; free with Time-free.\n\nExample:\n  (def clock (make-Time my-now my-sleep))\n\nSince: Phase 16"},
    {"Time-free", "Time-free -- free a Time capability allocated by make-Time.\n\nParameters:\n  t -- Time from make-Time\n\nExample:\n  (Time-free clock)\n\nSince: Phase 16"},
    {"with-capability", "with-capability -- bind capabilities and evaluate body with them in scope.\n\nParameters:\n  bindings -- a binding vector [name cap-expr ...]\n  body -- forms to evaluate with the bindings in scope\n\nExample:\n  (with-capability [fs (make-FileSystem r w d l)] (fs-delete fs \"data.txt\"))\n\nSince: Phase 16"},
    {"default-capability", "default-capability -- return the default implementation for a capability type (currently always nil).\n\nParameters:\n  type_name -- symbolic name of the capability type (unused in v1)\n\nSince: Phase 16"},
    {"fs-read", "fs-read -- call read_file on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability\n  path -- file path to read\n  buf -- output buffer\n  buf_len -- size of buf in bytes\n\nReturns:\n  0 on success, non-zero on error (as returned by the underlying read_file fn).\n\nExample:\n  (fs-read fs \"data.txt\" buf 64)  ; => 0\n\nSince: Phase 16"},
    {"fs-write", "fs-write -- call write_file on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability\n  path -- file path to write\n  data -- data buffer\n  data_len -- number of bytes to write\n\nReturns:\n  0 on success, non-zero on error.\n\nExample:\n  (fs-write fs \"data.txt\" buf 5)  ; => 0\n\nSince: Phase 16"},
    {"fs-delete", "fs-delete -- call delete on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability\n  path -- path of the file to delete\n\nReturns:\n  0 on success, non-zero on error.\n\nExample:\n  (fs-delete fs \"data.txt\")  ; => 0\n\nSince: Phase 16"},
    {"fs-list", "fs-list -- call list on a FileSystem capability.\n\nParameters:\n  fs -- FileSystem capability\n  path -- directory path to list\n  entries -- output buffer for entry name pointers (char **)\n  max_entries -- capacity of entries buffer\n\nReturns:\n  The underlying list fn's error code (0 on success).\n\nExample:\n  (fs-list fs \".\" entries 16)  ; => 0\n\nSince: Phase 16"},
    {"log-debug", "log-debug -- emit a debug-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability\n  msg -- message string to log\n\nExample:\n  (log-debug lg \"starting\")\n\nSince: Phase 16"},
    {"log-info", "log-info -- emit an info-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability\n  msg -- message string to log\n\nExample:\n  (log-info lg \"ready\")\n\nSince: Phase 16"},
    {"log-warn", "log-warn -- emit a warning-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability\n  msg -- message string to log\n\nExample:\n  (log-warn lg \"disk nearly full\")\n\nSince: Phase 16"},
    {"log-error", "log-error -- emit an error-level log message via a Logger capability.\n\nParameters:\n  log -- Logger capability\n  msg -- message string to log\n\nExample:\n  (log-error lg \"write failed\")\n\nSince: Phase 16"},
    {"rng-next-int", "rng-next-int -- return a random integer in [min, max] from a Random capability.\n\nParameters:\n  rng -- Random capability\n  min -- inclusive lower bound\n  max -- inclusive upper bound\n\nReturns:\n  A random integer in [min, max].\n\nExample:\n  (rng-next-int rng 1 6)  ; => 4\n\nSince: Phase 16"},
    {"rng-next-float", "rng-next-float -- return a random pseudo-float in [0, 10000) from a Random capability.\n\nParameters:\n  rng -- Random capability\n\nReturns:\n  Integer in [0, 10000); divide by 10000.0 to get a float in [0.0, 1.0).\n\nExample:\n  (rng-next-float rng)  ; => 2500\n\nSince: Phase 16"},
    {"time-now", "time-now -- return the current time in milliseconds since epoch from a Time capability.\n\nParameters:\n  t -- Time capability\n\nReturns:\n  Current time as an integer (milliseconds since epoch).\n\nExample:\n  (time-now clock)  ; => 1000\n\nSince: Phase 16"},
    {"time-sleep", "time-sleep -- sleep for ms milliseconds via a Time capability.\n\nParameters:\n  t -- Time capability\n  ms -- duration in milliseconds\n\nExample:\n  (time-sleep clock 250)\n\nSince: Phase 16"},
    {"tur/capability", "tur/capability -- capability-passing vtables for controlled side-effect injection.\n\nSince: Phase 16"},
    {"Chan", "Chan"},
    {"AsyncChan", "AsyncChan"},
    {"chan-new", "chan-new -- allocate a new synchronous blocking channel with the given capacity.\n\nParameters:\n  cap -- ring-buffer capacity (number of int64_t slots)\n\nReturns:\n  A Chan handle to the ChanBlock.\n\nExample:\n  (let [ch (chan-new 8)] ...)  ; => Chan\n\nSince: Phase T19-C"},
    {"chan-send", "chan-send -- send a value into a synchronous channel, blocking when full.\n\nParameters:\n  ch -- channel handle returned by chan-new\n  val -- int64_t value to enqueue\n\nExample:\n  (chan-send ch 42)\n\nSince: Phase T19-C"},
    {"chan-recv", "chan-recv -- receive a value from a synchronous channel, blocking when empty.\n\nParameters:\n  ch -- channel handle returned by chan-new\n\nReturns:\n  The next int64_t value dequeued from the channel.\n\nExample:\n  (let [v (chan-recv ch)] ...)  ; => int\n\nSince: Phase T19-C"},
    {"chan-free", "chan-free -- destroy a synchronous channel and release all associated memory.\n\nParameters:\n  ch -- channel handle returned by chan-new\n\nExample:\n  (chan-free ch)\n\nSince: Phase T19-C"},
    {"async-chan-new", "async-chan-new -- allocate a new async buffered channel with the given capacity.\n\nParameters:\n  cap -- ring-buffer capacity (number of int64_t slots)\n\nReturns:\n  An AsyncChan handle to the ChanBlock.\n\nExample:\n  (let [ch (async-chan-new 16)] ...)  ; => AsyncChan\n\nSince: Phase T19-D"},
    {"async-chan-send", "async-chan-send -- send a value into an async channel, blocking when full.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n  val -- int64_t value to enqueue\n\nExample:\n  (async-chan-send ch 99)\n\nSince: Phase T19-D"},
    {"async-chan-recv", "async-chan-recv -- receive a value from an async channel, blocking when empty.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nReturns:\n  The next int64_t value dequeued from the channel.\n\nExample:\n  (let [v (async-chan-recv ch)] ...)  ; => int\n\nSince: Phase T19-D"},
    {"async-chan-try-send", "async-chan-try-send -- attempt to send a value without blocking.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n  val -- int64_t value to enqueue\n\nReturns:\n  true if the value was enqueued; false if the channel was full.\n\nExample:\n  (if (async-chan-try-send ch 7) ...)  ; => bool\n\nSince: Phase T19-D"},
    {"async-chan-try-recv", "async-chan-try-recv -- attempt to receive a value without blocking.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nReturns:\n  The dequeued int64_t value, or INT64_MIN if the channel was empty.\n\nExample:\n  (let [v (async-chan-try-recv ch)] ...)  ; => int (INT64_MIN = empty)\n\nSince: Phase T19-D"},
    {"async-chan-count", "async-chan-count -- return the number of items currently in an async channel.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nReturns:\n  The current item count as an int.\n\nExample:\n  (async-chan-count ch)  ; => int\n\nSince: Phase T19-D"},
    {"async-chan-free", "async-chan-free -- destroy an async channel and release all associated memory.\n\nParameters:\n  ch -- channel handle returned by async-chan-new\n\nExample:\n  (async-chan-free ch)\n\nSince: Phase T19-D"},
    {"tur/chan", "tur/chan -- synchronous and async buffered channels for inter-fiber communication.\n\nSince: Phase T19-C"},
    {"Char", "Char -- a character code point, distinct from int.\n\nSince: parsec-guide-plan P1"},
    {"int->char", "int->char -- the character with the given code.\n\nParameters:\n  i -- a character code (65 is `A`)\n\nReturns:\n  The Char whose code is i.\n\nExample:\n  (char=? (int->char 65) #\\A)  ; => true\n\nSince: parsec-guide-plan P1"},
    {"char->int", "char->int -- the code of a character.\n\nParameters:\n  c -- the character\n\nReturns:\n  c's character code as an int.\n\nExample:\n  (char->int #\\A)  ; => 65\n\nSince: parsec-guide-plan P1"},
    {"char-lit", "char-lit -- int -> Char, the conversion a `#\\A` literal stands for.\n\nParameters:\n  i -- a character code\n\nReturns:\n  The Char whose code is i.\n\nExample:\n  (char->int (char-lit 65))  ; => 65\n\nSince: parsec-guide-plan P1"},
    {"char", "char=? -- are two characters the same?\n\nParameters:\n  a -- a character\n  b -- another character\n\nReturns:\n  true when a and b have the same code.\n\nExample:\n  (char=? #\\a #\\a)  ; => true\n    (char=? #\\a #\\A)  ; => false\n\nSince: parsec-guide-plan P1"},
    {"char<?", "char<? -- does a sort strictly before b (by code)?\n\nParameters:\n  a -- a character\n  b -- another character\n\nReturns:\n  true when a's code is less than b's.\n\nExample:\n  (char<? #\\a #\\b)  ; => true\n\nSince: parsec-guide-plan P1"},
    {"char-between?", "char-between? -- is c within the inclusive range [lo, hi]?\n\nParameters:\n  c -- the character to test\n  lo -- the lowest accepted character\n  hi -- the highest accepted character\n\nReturns:\n  true when lo <= c <= hi by code.\n\nExample:\n  (char-between? #\\q #\\a #\\z)  ; => true\n\nSince: parsec-guide-plan P1"},
    {"digit?", "digit? -- is c an ASCII decimal digit, `0` through `9`?\n\nParameters:\n  c -- the character to test\n\nReturns:\n  true for `0`..`9`.\n\nExample:\n  (digit? #\\7)  ; => true\n    (digit? #\\x)  ; => false\n\nSince: parsec-guide-plan P1"},
    {"upper?", "upper? -- is c an ASCII upper-case letter?\n\nParameters:\n  c -- the character to test\n\nReturns:\n  true for `A`..`Z`.\n\nExample:\n  (upper? #\\Q)  ; => true\n\nSince: parsec-guide-plan P1"},
    {"lower?", "lower? -- is c an ASCII lower-case letter?\n\nParameters:\n  c -- the character to test\n\nReturns:\n  true for `a`..`z`.\n\nExample:\n  (lower? #\\q)  ; => true\n\nSince: parsec-guide-plan P1"},
    {"alpha?", "alpha? -- is c an ASCII letter?\n\nParameters:\n  c -- the character to test\n\nReturns:\n  true for `a`..`z` and `A`..`Z`.\n\nExample:\n  (alpha? #\\k)  ; => true\n    (alpha? #\\5)  ; => false\n\nSince: parsec-guide-plan P1"},
    {"alnum?", "alnum? -- is c an ASCII letter or digit?\n\nParameters:\n  c -- the character to test\n\nReturns:\n  true when (alpha? c) or (digit? c).\n\nExample:\n  (alnum? #\\5)  ; => true\n    (alnum? #\\-)  ; => false\n\nSince: parsec-guide-plan P1"},
    {"space?", "space? -- is c ASCII whitespace?\n\nParameters:\n  c -- the character to test\n\nReturns:\n  true for space, tab, newline, carriage return, vertical tab and form\n    feed.\n\nExample:\n  (space? #\\tab)  ; => true\n\nSince: parsec-guide-plan P1"},
    {"punct?", "punct? -- is c printable ASCII punctuation?\n\nParameters:\n  c -- the character to test\n\nReturns:\n  true for the printable, non-space ASCII characters that are neither\n    letters nor digits (`!`, `(`, `-`, `@`, `~`, ...).\n\nExample:\n  (punct? #\\!)  ; => true\n    (punct? #\\a)  ; => false\n\nSince: parsec-guide-plan P1"},
    {"char-upcase", "char-upcase -- the upper-case form of an ASCII lower-case letter.\n\nParameters:\n  c -- the character to convert\n\nReturns:\n  The matching upper-case letter, or c unchanged when it is not `a`..`z`.\n\nExample:\n  (char->int (char-upcase #\\a))  ; => 65\n\nSince: parsec-guide-plan P1"},
    {"char-downcase", "char-downcase -- the lower-case form of an ASCII upper-case letter.\n\nParameters:\n  c -- the character to convert\n\nReturns:\n  The matching lower-case letter, or c unchanged when it is not `A`..`Z`.\n\nExample:\n  (char->int (char-downcase #\\A))  ; => 97\n\nSince: parsec-guide-plan P1"},
    {"char->digit", "char->digit -- the numeric value of a decimal digit character.\n\nParameters:\n  c -- a digit character, `0`..`9`\n\nReturns:\n  0..9 for a digit; -1 for any other character.\n\nExample:\n  (char->digit #\\7)  ; => 7\n    (char->digit #\\x)  ; => -1\n\nSince: parsec-guide-plan P1"},
    {"Eq", "Eq [Char] -- characters are equal when their codes are."},
    {"Ord", "Ord [Char] -- characters order by code."},
    {"tur/char", "tur/char -- Char, a character code point that is not an int.\n\nSince: parsec-guide-plan P1"},
    {"__identity_new", "__identity_new -- allocate a new Identity comonad cell wrapping x."},
    {"__identity_get", "__identity_get -- read the value stored in an Identity comonad cell."},
    {"__identity_extract", "__identity_extract -- extract the value from an Identity comonad cell."},
    {"__identity_extend", "__identity_extend -- apply fn to the Identity cell and wrap the result."},
    {"__identity_duplicate", "__identity_duplicate -- wrap an Identity cell inside another Identity cell."},
    {"Comonad", "Comonad [identity] -- Comonad instance for the Identity comonad."},
    {"__pair_new", "__pair_new -- allocate a new Pair comonad cell with environment and value."},
    {"__pair_env", "__pair_env -- read the environment component of a Pair comonad cell."},
    {"__pair_val", "__pair_val -- read the value component of a Pair comonad cell."},
    {"__pair_extract", "__pair_extract -- extract the value from a Pair comonad cell."},
    {"__pair_extend", "__pair_extend -- extend over a Pair cell: (e, a) -> (e, f (e, a))."},
    {"__pair_duplicate", "__pair_duplicate -- duplicate a Pair cell: (e, a) -> (e, (e, a))."},
    {"tur/comonad", "tur/comonad -- Comonad typeclass -- the categorical dual of Monad.\n\nSince: Phase CA0"},
    {"Complex", "Complex -- a re/im pair of doubles.\n\nSince: Phase N2"},
    {"complex/of", "complex/of -- build the complex number re + im*i.\n\nParameters:\n  re -- real part\n  im -- imaginary part\n\nReturns:\n  The Complex re + im*i.  This is what the `#cx{re im}` literal expands to.\n\nExample:\n  (complex/re (complex/of 3.25 -1.5))  ; => 3.25\n\nSince: Phase N2"},
    {"complex/from-float", "complex/from-float -- embed a real number in the complex plane.\n\nParameters:\n  x -- the real value\n\nReturns:\n  x + 0i.\n\nExample:\n  (complex/im (complex/from-float 2.5))  ; => 0\n\nSince: Phase N2"},
    {"complex/zero", "complex/zero -- the complex number 0.\n\nReturns:\n  0 + 0i.\n\nExample:\n  (complex/re (complex/zero))  ; => 0\n\nSince: Phase N2"},
    {"complex/one", "complex/one -- the complex number 1.\n\nReturns:\n  1 + 0i.\n\nExample:\n  (complex/re (complex/one))  ; => 1\n\nSince: Phase N2"},
    {"complex/i", "complex/i -- the imaginary unit.\n\nReturns:\n  0 + 1i.\n\nExample:\n  (complex/im (complex/i))  ; => 1\n\nSince: Phase N2"},
    {"complex/re", "complex/re -- the real part.\n\nParameters:\n  z -- a Complex\n\nReturns:\n  The real component.\n\nExample:\n  (complex/re (complex/of 3.25 -1.5))  ; => 3.25\n\nSince: Phase N2"},
    {"complex/im", "complex/im -- the imaginary part.\n\nParameters:\n  z -- a Complex\n\nReturns:\n  The imaginary component.\n\nExample:\n  (complex/im (complex/of 3.25 -1.5))  ; => -1.5\n\nSince: Phase N2"},
    {"complex/real?", "complex/real? -- does this value lie on the real axis?\n\nParameters:\n  z -- a Complex\n\nReturns:\n  true when the imaginary part is exactly 0.\n\nExample:\n  (complex/real? (complex/from-float 2.5))  ; => true\n\nSince: Phase N2"},
    {"complex/add", "complex/add -- sum of two complex numbers.\n\nParameters:\n  x -- left addend\n  y -- right addend\n\nReturns:\n  (a+bi) + (c+di) = (a+c) + (b+d)i.\n\nExample:\n  (complex/re (complex/add (complex/of 3.25 1.5) (complex/of 0.75 0.5)))  ; => 4\n\nSince: Phase N2"},
    {"complex/sub", "complex/sub -- difference of two complex numbers.\n\nParameters:\n  x -- minuend\n  y -- subtrahend\n\nReturns:\n  (a+bi) - (c+di) = (a-c) + (b-d)i.\n\nExample:\n  (complex/im (complex/sub (complex/of 3.25 1.5) (complex/of 0.75 0.5)))  ; => 1\n\nSince: Phase N2"},
    {"complex/neg", "complex/neg -- negate a complex number.\n\nParameters:\n  x -- a Complex\n\nReturns:\n  -(a+bi) = -a - bi.\n\nExample:\n  (complex/re (complex/neg (complex/of 3.25 -1.5)))  ; => -3.25\n\nSince: Phase N2"},
    {"complex/conj", "complex/conj -- complex conjugate.\n\nParameters:\n  x -- a Complex\n\nReturns:\n  conj(a+bi) = a - bi.\n\nExample:\n  (complex/im (complex/conj (complex/of 3.25 -1.5)))  ; => 1.5\n\nSince: Phase N2"},
    {"complex/mul", "complex/mul -- product of two complex numbers.\n\nParameters:\n  x -- left factor\n  y -- right factor\n\nReturns:\n  (a+bi)(c+di) = (ac - bd) + (ad + bc)i, written out as arithmetic rather\n    than deferred to a `__muldc3`-style compiler-runtime helper.\n\nExample:\n  (complex/re (complex/mul (complex/of 3.25 1.5) (complex/of 0.5 2.0)))  ; => -1.375\n\nSince: Phase N2"},
    {"complex/scale", "complex/scale -- multiply a complex number by a real scalar.\n\nParameters:\n  x -- a Complex\n  k -- the real scale factor\n\nReturns:\n  k*(a+bi) = ka + kb*i.\n\nExample:\n  (complex/re (complex/scale (complex/of 3.25 -1.5) 2.0))  ; => 6.5\n\nSince: Phase N2"},
    {"complex/div", "complex/div -- quotient of two complex numbers (Smith's algorithm).\n\nParameters:\n  x -- dividend\n  y -- divisor\n\nReturns:\n  x/y.  The naive `(ac+bd)/(c^2+d^2)` form overflows whenever `c` or `d` is\n    large enough that its square leaves the double range, even when the true\n    quotient is perfectly ordinary.  Smith's algorithm divides through by the\n    larger-magnitude denominator component first, so the intermediates stay\n    near the magnitude of the result:\n  \n      |c| >= |d|:  r = d/c, den = c + d*r, x/y = ((a + b*r) + (b - a*r)i)/den\n      |c| <  |d|:  r = c/d, den = c*r + d, x/y = ((a*r + b) + (b*r - a)i)/den\n  \n    Dividing by the zero complex number yields the IEEE infinity/NaN result\n    float division already produces; it is not an error here.\n\nExample:\n  (complex/re (complex/div (complex/of 3.25 1.5) (complex/of 0.5 0.0)))  ; => 6.5\n\nSince: Phase N2"},
    {"complex/abs2", "complex/abs2 -- squared magnitude |z|^2.\n\nParameters:\n  z -- a Complex\n\nReturns:\n  re^2 + im^2, with no square root.  Prefer this to `complex/abs` when only\n    comparing magnitudes -- it is exact where the square root is not.\n\nExample:\n  (complex/abs2 (complex/of 3.0 4.0))  ; => 25\n\nSince: Phase N2"},
    {"complex/abs", "complex/abs -- magnitude |z|.\n\nParameters:\n  z -- a Complex\n\nReturns:\n  sqrt(re^2 + im^2), computed by scaling out the larger component first\n    (`|a| * sqrt(1 + (b/a)^2)`) so a value whose square would overflow still\n    reports its true magnitude.\n\nExample:\n  (complex/abs (complex/of 3.0 4.0))  ; => 5\n\nSince: Phase N2"},
    {"complex/arg", "complex/arg -- principal argument (phase angle) of z, in radians.\n\nParameters:\n  z -- a Complex\n\nReturns:\n  atan2(im, re), in (-pi, pi].\n\nExample:\n  (complex/arg (complex/of 0.0 1.5))  ; => 1.5708\n\nSince: Phase N2"},
    {"complex/exp", "complex/exp -- e raised to a complex power.\n\nParameters:\n  z -- a Complex\n\nReturns:\n  e^(a+bi) = e^a * (cos b + i sin b), built from the real libm wrappers in\n    stdlib/math.tur rather than from a complex-valued runtime helper.\n\nExample:\n  (complex/re (complex/exp (complex/of 0.0 0.0)))  ; => 1\n\nSince: Phase N2"},
    {"complex/eq?", "complex/eq? -- componentwise equality.\n\nParameters:\n  x -- left value\n  y -- right value\n\nReturns:\n  true when both the real and the imaginary parts compare equal.  This is\n    IEEE float equality, with all the usual caveats.\n\nExample:\n  (complex/eq? (complex/of 3.25 -1.5) (complex/of 3.25 -1.5))  ; => true\n\nSince: Phase N2"},
    {"complex->string", "complex->string -- render a Complex as \"3.25+4.5i\" / \"3.25-4.5i\".\n\nParameters:\n  z -- a Complex\n\nReturns:\n  A fresh owned String.  The sign of the imaginary part is ALWAYS explicit,\n    so the output is unambiguous and never depends on how the imaginary part\n    happens to format.\n\nExample:\n  (complex->string (complex/of 3.25 -1.5))  ; => String \"3.25-1.5i\"\n\nSince: Phase N2"},
    {"Num", "Num [Complex] -- hand-written complex arithmetic behind + - * /."},
    {"Show", "Show [Complex] -- \"3.25+4.5i\" with an always-explicit imaginary sign."},
    {"tur/complex", "tur/complex -- Complex numbers as a plain re/im pair of doubles.\n\nSince: Phase N2 (numeric-tower-rational-complex-plan)"},
    {"MutexGuard", "[linear] MutexGuard -- a linear (exactly-once) RAII wrapper for a held mutex lock.\n\nSince: LT4"},
    {"mutex-guard-lock", "mutex-guard-lock -- lock a mutex and return a MutexGuard RAII token.\n\nParameters:\n  mutex -- a ptr<void> pointing to a pthread_mutex_t.\n\nReturns:\n  A MutexGuard holding the locked mutex.\n\nExample:\n  (let [guard (mutex-guard-lock my-mutex)] ...)\n\nSince: LT4"},
    {"mutex-guard-unlock", "mutex-guard-unlock -- release the mutex held by a MutexGuard.\n\nParameters:\n  guard -- a MutexGuard (by value; guard is consumed).\n\nReturns:\n  0 on success, error code from pthread_mutex_unlock otherwise.\n\nExample:\n  (mutex-guard-unlock guard)  ; => 0\n\nSince: LT4"},
    {"mutex-guard-valid?", "mutex-guard-valid? -- return true if the MutexGuard holds a non-NULL mutex.\n\nParameters:\n  guard -- a MutexGuard value.\n\nReturns:\n  true if the underlying mutex pointer is non-NULL.\n\nExample:\n  (mutex-guard-valid? guard)  ; => true\n\nSince: LT4"},
    {"tur/concurrent", "tur/concurrent -- stub concurrency types for linear resource tracking.\n\nSince: Phase LT4"},
    {"CondVar", "CondVar"},
    {"condvar-new", "condvar-new -- allocate and initialise a new POSIX condition variable.\n\nReturns:\n  A CondVar handle to a heap-allocated pthread_cond_t.\n\nExample:\n  (let [c (condvar-new)] ...)  ; => CondVar\n\nSince: Phase T19-C"},
    {"condvar-wait", "condvar-wait -- atomically release the mutex and wait for a signal on the condition variable.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n  m -- mutex handle (from mutex-new) that the caller already holds\n\nExample:\n  (condvar-wait c m)\n\nSince: Phase T19-C"},
    {"condvar-signal", "condvar-signal -- wake one thread waiting on the condition variable.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n\nExample:\n  (condvar-signal c)\n\nSince: Phase T19-C"},
    {"condvar-broadcast", "condvar-broadcast -- wake all threads waiting on the condition variable.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n\nExample:\n  (condvar-broadcast c)\n\nSince: Phase T19-C"},
    {"condvar-free", "condvar-free -- destroy the condition variable and release its memory.\n\nParameters:\n  c -- condvar handle returned by condvar-new\n\nExample:\n  (condvar-free c)\n\nSince: Phase T19-C"},
    {"tur/condvar", "tur/condvar -- POSIX condition variable (pthread_cond_t) wrapped as ptr<void>.\n\nSince: Phase T19-C"},
    {"contract-enabled?", "contract-enabled?"},
    {"tur-contract-check", "tur-contract-check"},
    {"tur-contract-check-at", "tur-contract-check-at -- tur-contract-check, panicking at the predicate's own site."},
    {"tur-contract-check-inv", "tur-contract-check-inv"},
    {"assert!", "assert!"},
    {"assert-msg!", "assert-msg!"},
    {"require!", "require!"},
    {"require-msg!", "require-msg!"},
    {"ensure!", "ensure!"},
    {"ensure-msg!", "ensure-msg!"},
    {"invariant!", "invariant!"},
    {"invariant-msg!", "invariant-msg!"},
    {"set-contract-handler!", "set-contract-handler!"},
    {"with-contract-handler", "with-contract-handler"},
    {"tur/contract", "tur/contract -- runtime contract macros (assert!, require!, ensure!, ...).\n\nSince: Phase C1"},
    {"cstr-len", "cstr-len -- byte length of a NUL-terminated C string.\n\nParameters:\n  s -- NUL-terminated C string pointer\n\nReturns:\n  Length in bytes, excluding the trailing NUL.\n\nExample:\n  (cstr-len \"hello\")  ; => 5"},
    {"cstr-nth", "cstr-nth -- byte at index i in a NUL-terminated C string.\n\nParameters:\n  s -- NUL-terminated C string pointer\n  i -- zero-based byte index; caller must ensure 0 <= i < (cstr-len s)\n\nReturns:\n  The unsigned byte value at position i.\n\nExample:\n  (cstr-nth \"1+2\" 1)  ; => 43  ('+')"},
    {"cstr-sub", "cstr-sub -- substring [start, end) of a NUL-terminated C string.\n\nParameters:\n  s -- NUL-terminated C string pointer\n  start -- zero-based start byte index (clamped into [0, len])\n  end -- exclusive end byte index (clamped into [start, len])\n\nReturns:\n  A freshly heap-allocated cstr holding the bytes of s in [start, end),\n    NUL-terminated. Out-of-range indices are clamped, so the result is\n    always a valid (possibly empty) string. The caller frees the result.\n\nExample:\n  (cstr-sub \"hello\" 1 4)  ; => \"ell\""},
    {"cstr-eq?", "cstr-eq? -- content equality on two NUL-terminated C strings.\n\nParameters:\n  a -- NUL-terminated C string pointer, or NULL\n  b -- NUL-terminated C string pointer, or NULL\n\nReturns:\n  true when both are NULL, or both are non-NULL and hold the same\n    bytes up to the terminator. false otherwise -- in particular a NULL\n    never equals a non-NULL, including the empty string.\n\nExample:\n  (cstr-eq? \"abc\" (cstr-sub \"abcdef\" 0 3))  ; => true\n    (cstr-eq? \"abc\" \"abd\")                    ; => false"},
    {"cstr-free", "cstr-free -- release a cstr this module heap-allocated.\n\nParameters:\n  s -- a cstr returned by cstr-sub, or NULL\n\nExample:\n  (let [t (cstr-sub \"hello world\" 0 5)]\n      (println t)\n      (cstr-free t))"},
    {"cstr", "tur/cstr -- byte primitives on raw :cstr values.\n\nSince: 2026-07-01"},
    {"csv/emit-row-with-delim-string", "csv/emit-row-with-delim-string -- serialize one row vec with a custom\n\nParameters:\n  v -- a row vec (as from csv/parse)\n  delim -- field separator byte (e.g. 44 = ',')\n\nReturns:\n  An owned String of the delimiter-separated row (no trailing newline),\n    or an empty String if delim is invalid.\n\nExample:\n  (string/to-cstr (csv/emit-row-with-delim-string my-row 59))  ; => \"a;b\"\n\nSince: v2"},
    {"csv/emit-row-string", "csv/emit-row-string -- serialize one row vec (comma-delimited), as an owned\n\nParameters:\n  v -- a row vec (as from csv/parse)\n\nReturns:\n  An owned String of the comma-separated row.\n\nExample:\n  (string/to-cstr (csv/emit-row-string my-row))  ; => \"a,b\"\n\nSince: v2"},
    {"csv/emit-with-delim-string", "csv/emit-with-delim-string -- serialize a cons list of row vecs with a\n\nParameters:\n  rows -- cons list of row vecs (as from csv/parse)\n  delim -- field separator byte (e.g. 44 = ',')\n\nReturns:\n  An owned String of the newline-separated document, or an empty String if\n    delim is invalid.\n\nExample:\n  (string/to-cstr (csv/emit-with-delim-string my-rows 59))  ; => \"a;b\\n1;2\\n\"\n\nSince: v2"},
    {"csv/emit-string", "csv/emit-string -- serialize a cons list of row vecs (comma-delimited) to a\n\nParameters:\n  rows -- cons list of row vecs (as from csv/parse)\n\nReturns:\n  An owned String of the newline-separated CSV document.\n\nExample:\n  (string/to-cstr (csv/emit-string my-rows))  ; => \"a,b\\n1,2\\n\"\n\nSince: v2"},
    {"tur/csv-string", "tur/csv-string -- owned String siblings for the tur/csv emitters.\n\nSince: v2 (string-adoption-stdlib-plan, batch 3)"},
    {"csv/parse-row-with-delim", "csv/parse-row-with-delim -- parse one delimiter-separated line into a vec of field cstrs.\n\nParameters:\n  line -- NUL-terminated delimiter-separated row cstr\n  delim -- delimiter character as ASCII code (e.g., 44 for comma, 9 for tab)\n\nReturns:\n  A heap-allocated vec whose elements are (int64_t)(char*) field cstrs.\n    Both the vec and all field strings are independently heap-allocated.\n    Free with csv/row-free.\n    Returns 0 on invalid delimiter (NUL, quote, CR, LF).\n\nExample:\n  (csv/parse-row-with-delim \"a|b|c\" 124)  ; => vec of 3 fields\n    (csv/parse-row-with-delim \"x\\ty\\tz\" 9)  ; => vec of 3 fields\n    (csv/parse-row-with-delim \"bad\" 0)  ; => 0\n\nSince: Phase D2"},
    {"csv/parse-row", "csv/parse-row -- parse one CSV line into a vec of field cstrs.\n\nParameters:\n  line -- NUL-terminated CSV row cstr\n\nReturns:\n  A heap-allocated vec whose elements are (int64_t)(char*) field cstrs.\n    Both the vec and all field strings are independently heap-allocated.\n    Free with csv/row-free.\n\nExample:\n  (csv/parse-row \"a,\\\"b,c\\\",d\")  ; => vec [\"a\", \"b,c\", \"d\"]\n\nSince: Phase B2"},
    {"csv/row-free", "csv/row-free -- free a row vec and all its field strings.\n\nParameters:\n  v -- vec pointer returned by csv/parse-row or csv/emit-row (may be 0)\n\nExample:\n  (csv/row-free my-row)\n\nSince: Phase B2"},
    {"csv/parse-with-delim", "csv/parse-with-delim -- parse a multi-line delimiter-separated string into a cons list of row vecs.\n\nParameters:\n  s -- NUL-terminated delimiter-separated string (possibly multi-line)\n  delim -- delimiter character as ASCII code (e.g., 44 for comma, 9 for tab)\n\nReturns:\n  A cons list of row vec pointers (each from csv/parse-row-with-delim).\n    Free with csv/free.\n    Returns 0 on invalid delimiter (NUL, quote, CR, LF).\n\nExample:\n  (csv/parse-with-delim \"a\\tb\\n1\\t2\\n\" 9)  ; => cons list of 2 rows\n    (csv/parse-with-delim \"x;y\" 59)  ; => cons list of 1 row\n    (csv/parse-with-delim \"bad\" 0)  ; => 0\n\nSince: Phase D2"},
    {"csv/parse", "csv/parse -- parse a multi-line CSV string into a cons list of row vecs.\n\nParameters:\n  s -- NUL-terminated CSV string (possibly multi-line)\n\nReturns:\n  A cons list of row vec pointers (each from csv/parse-row).\n    Free with csv/free.\n\nExample:\n  (csv/parse \"a,b\\n1,2\\n\")  ; => cons of two row vecs\n\nSince: Phase B2"},
    {"csv/free", "csv/free -- free a cons list of rows returned by csv/parse.\n\nParameters:\n  lst -- cons list of row vecs returned by csv/parse\n\nExample:\n  (csv/free my-csv)\n\nSince: Phase B2"},
    {"csv/emit-row-with-delim", "csv/emit-row-with-delim -- serialize a vec of field cstrs to a delimiter-separated line cstr.\n\nParameters:\n  v -- vec of (int64_t)(char*) field cstrs\n  delim -- delimiter character as ASCII code (e.g., 44 for comma, 9 for tab)\n\nReturns:\n  A heap-allocated NUL-terminated delimiter-separated line without a trailing newline.\n    The caller must free.\n    Returns 0 on invalid delimiter (NUL, quote, CR, LF).\n\nExample:\n  (csv/emit-row-with-delim my-vec 124)  ; => \"a|\\\"b|c\\\"|d\" (pipe-delimited)\n    (csv/emit-row-with-delim (csv/parse-row \"a,b\") 44)  ; => \"a,b\"\n    (csv/emit-row-with-delim (csv/parse-row \"a,b\") 0)  ; => 0\n\nSince: Phase D2"},
    {"csv/emit-row", "csv/emit-row -- serialize a vec of field cstrs to a CSV line cstr.\n\nParameters:\n  v -- vec of (int64_t)(char*) field cstrs\n\nReturns:\n  A heap-allocated NUL-terminated CSV line without a trailing newline.\n    The caller must free.\n\nExample:\n  (csv/emit-row my-vec)  ; => \"a,\\\"b,c\\\",d\"\n\nSince: Phase B2"},
    {"csv/emit-with-delim", "csv/emit-with-delim -- serialize a cons list of row vecs to a full delimiter-separated string.\n\nParameters:\n  rows -- cons list of row vecs (as from csv/parse-with-delim)\n  delim -- delimiter character as ASCII code (e.g., 44 for comma, 9 for tab)\n\nReturns:\n  A heap-allocated NUL-terminated delimiter-separated string with newline-separated rows.\n    The caller must free.\n    Returns 0 on invalid delimiter (NUL, quote, CR, LF).\n\nExample:\n  (csv/emit-with-delim my-rows 9)  ; => \"a\\tb\\n1\\t2\\n\" (TSV)\n    (csv/emit-with-delim (csv/parse \"a,b\\n1,2\\n\") 44)  ; => \"a,b\\n1,2\\n\"\n    (csv/emit-with-delim (csv/parse \"a,b\\n\") 0)  ; => 0\n\nSince: Phase D2"},
    {"csv/emit", "csv/emit -- serialize a cons list of row vecs to a full CSV string.\n\nParameters:\n  rows -- cons list of row vecs (as from csv/parse)\n\nReturns:\n  A heap-allocated NUL-terminated CSV string with newline-separated rows.\n    The caller must free.\n\nExample:\n  (csv/emit my-rows)  ; => \"a,b\\n1,2\\n\"\n\nSince: Phase B2"},
    {"csv/read-file-with-delim", "csv/read-file-with-delim -- read a delimiter-separated file and parse it into a cons list of row vecs.\n\nParameters:\n  path -- NUL-terminated file path cstr\n  delim -- delimiter character as ASCII code (e.g., 44 for comma, 9 for tab)\n\nReturns:\n  A cons list of row vecs (same as csv/parse-with-delim), or 0 on read error or invalid delimiter.\n    Free with csv/free.\n\nExample:\n  (csv/read-file-with-delim \"data.tsv\" 9)  ; => cons list of TSV rows\n    (csv/read-file-with-delim \"/nonexistent\" 44)  ; => 0\n    (csv/read-file-with-delim \"/etc/hosts\" 0)  ; => 0\n\nSince: Phase D2"},
    {"csv/read-file", "csv/read-file -- read a CSV file and parse it into a cons list of row vecs.\n\nParameters:\n  path -- NUL-terminated file path cstr\n\nReturns:\n  A cons list of row vecs (same as csv/parse), or 0 on read error.\n    Free with csv/free.\n\nExample:\n  (csv/read-file \"data.csv\")  ; => cons list of rows\n\nSince: Phase B2"},
    {"csv/write-file-with-delim", "csv/write-file-with-delim -- serialize a cons list of row vecs to a delimiter-separated file.\n\nParameters:\n  path -- NUL-terminated destination path cstr\n  rows -- cons list of row vecs\n  delim -- delimiter character as ASCII code (e.g., 44 for comma, 9 for tab)\n\nReturns:\n  0 on success, -1 on error or invalid delimiter.\n\nExample:\n  (csv/write-file-with-delim \"out.tsv\" my-rows 9)  ; => 0 (TSV file)\n    (csv/write-file-with-delim \"/dev/null\" (csv/parse \"a,b\") 44)  ; => 0\n    (csv/write-file-with-delim \"/dev/null\" (csv/parse \"a\") 0)  ; => -1\n\nSince: Phase D2"},
    {"csv/write-file", "csv/write-file -- serialize a cons list of row vecs to a CSV file.\n\nParameters:\n  path -- NUL-terminated destination path cstr\n  rows -- cons list of row vecs\n\nReturns:\n  0 on success, -1 on error.\n\nExample:\n  (csv/write-file \"out.csv\" my-rows)  ; => 0\n\nSince: Phase B2"},
    {"tur/csv", "tur/csv -- CSV parser and emitter following RFC 4180.\n\nSince: Phase B1"},
    {"digest/sha256-string", "digest/sha256-string -- SHA-256 of a byte buffer as a lowercase-hex String.\n\nParameters:\n  data -- pointer (as :int) to the byte data\n  len -- number of bytes to hash\n\nReturns:\n  An owned String of 64 lowercase hex characters, safe to store or key a map.\n\nExample:\n  (string/to-cstr (digest/sha256-string 0 0))\n    ; => \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n\nSince: v2"},
    {"digest/md5-string", "digest/md5-string -- MD5 of a byte buffer as a lowercase-hex String.\n\nParameters:\n  data -- pointer (as :int) to the byte data\n  len -- number of bytes to hash\n\nReturns:\n  An owned String of 32 lowercase hex characters, safe to store or key a map.\n\nExample:\n  (string/to-cstr (digest/md5-string 0 0))  ; => \"d41d8cd98f00b204e9800998ecf8427e\"\n\nSince: v2"},
    {"tur/digest-string", "tur/digest-string -- owned String siblings for the tur/digest hex digests.\n\nSince: v2 (string-adoption-stdlib-plan, batch 2)"},
    {"digest/sha256-transform!", "digest/sha256-transform! -- one SHA-256 compression round over a 64-byte"},
    {"digest/md5-transform!", "digest/md5-transform! -- one MD5 compression round over a 64-byte block."},
    {"digest/sha256", "digest/sha256 -- compute the SHA-256 digest of a byte buffer.\n\nParameters:\n  data -- pointer (as :int) to the byte data\n  len -- number of bytes to hash\n\nReturns:\n  A heap-allocated vec (:int) of 32 byte values (each 0-255).\n    Free with digest/bytes-free.\n\nExample:\n  (digest/sha256 buf 32)  ; => vec of 32 byte ints\n\nSince: Phase B2"},
    {"digest/sha256-hex", "digest/sha256-hex -- compute the SHA-256 digest as a lowercase hex string.\n\nParameters:\n  data -- pointer (as :int) to the byte data\n  len -- number of bytes to hash\n\nReturns:\n  A heap-allocated 65-byte NUL-terminated cstr (64 hex chars).\n    The caller must free.\n\nExample:\n  (digest/sha256-hex buf 4)  ; => \"9f86d081...\"\n\nSince: Phase B2"},
    {"digest/md5", "digest/md5 -- compute the MD5 digest of a byte buffer.\n\nParameters:\n  data -- pointer (as :int) to the byte data\n  len -- number of bytes to hash\n\nReturns:\n  A heap-allocated vec (:int) of 16 byte values (each 0-255).\n    Free with digest/bytes-free.\n\nExample:\n  (digest/md5 buf 16)  ; => vec of 16 byte ints\n\nSince: Phase B2"},
    {"digest/md5-hex", "digest/md5-hex -- compute the MD5 digest as a lowercase hex string.\n\nParameters:\n  data -- pointer (as :int) to the byte data\n  len -- number of bytes to hash\n\nReturns:\n  A heap-allocated 33-byte NUL-terminated cstr (32 hex chars).\n    The caller must free.\n\nExample:\n  (digest/md5-hex buf 4)  ; => \"93b885ad...\"\n\nSince: Phase B2"},
    {"digest/bytes-free", "digest/bytes-free -- free a digest byte vec returned by digest/sha256 or digest/md5.\n\nParameters:\n  v -- vec pointer returned by a digest function\n\nExample:\n  (digest/bytes-free my-digest)\n\nSince: Phase B2"},
    {"tur/digest", "tur/digest -- SHA-256 and MD5 checksum implementations.\n\nSince: Phase B1"},
    {"spawn-conveying", "spawn-conveying"},
    {"tur/dynvar", "tur/dynvar -- dynamic variables and binding conveyance for cooperative tasks.\n\nSince: Phase DV3"},
    {"IO", "IO -- base effect for all I/O operations.\n\nReturns:\n  nil\n\nExample:\n  (defeffect Write [s :cstr] :nil ^extends IO)\n\nSince: ET4"},
    {"FS", "FS -- capability tag for file-system access (fs, path, tmpfile).\n\nReturns:\n  nil (never performed; used only as a #fx{FS} row annotation)\n\nExample:\n  (defn read-config [p : cstr] #fx{FS} : cstr ...)\n\nSince: stdlib-effect-rows"},
    {"Net", "Net -- capability tag for network access (net, async_socket, httpd).\n\nReturns:\n  nil (never performed; used only as a #fx{Net} row annotation)\n\nExample:\n  (defn http-get [url : cstr] #fx{Net} : cstr ...)\n\nSince: stdlib-effect-rows"},
    {"Proc", "Proc -- capability tag for process/environment access (process, env).\n\nReturns:\n  nil (never performed; used only as a #fx{Proc} row annotation)\n\nExample:\n  (defn spawn [cmd : cstr] #fx{Proc} : int ...)\n\nSince: stdlib-effect-rows"},
    {"Rand", "Rand -- capability tag for non-deterministic randomness (random).\n\nReturns:\n  nil (never performed; used only as a #fx{Rand} row annotation)\n\nExample:\n  (defn rand-u64 [] #fx{Rand} : int ...)\n\nSince: stdlib-effect-rows"},
    {"Write", "Write -- declare an effect that writes a string to the environment.\n\nParameters:\n  s -- the string to write\n\nReturns:\n  nil\n\nExample:\n  (perform (Write \"hello\"))  ; => nil\n\nSince: Phase 19"},
    {"Fail", "Fail -- declare an effect that signals a failure with a message string.\n\nParameters:\n  msg -- the failure message\n\nReturns:\n  nil\n\nExample:\n  (perform (Fail \"something went wrong\"))  ; => nil\n\nSince: Phase 19"},
    {"Read", "Read -- declare an effect that requests an integer value from the environment.\n\nReturns:\n  int -- the integer supplied by the enclosing handler\n\nExample:\n  (perform (Read))  ; => 42\n\nSince: Phase 19"},
    {"GetEnv", "GetEnv -- declare an effect that looks up a named environment variable.\n\nParameters:\n  key -- the environment variable name to look up\n\nReturns:\n  cstr -- the value of the variable, or nil if absent\n\nExample:\n  (perform (GetEnv \"HOME\"))  ; => \"/home/user\"\n\nSince: Phase 19"},
    {"with-write", "with-write -- handle the Write effect by printing to stdout via println.\n\nParameters:\n  body -- the expression whose Write effects are handled\n\nReturns:\n  the return value of body\n\nExample:\n  (with-write (perform (Write \"hello\")))  ; prints \"hello\"\n\nSince: Phase 19"},
    {"with-fail-panic", "with-fail-panic -- handle the Fail effect by panicking with the message.\n\nParameters:\n  body -- the expression whose Fail effects are handled\n\nReturns:\n  the return value of body, or panics on Fail\n\nExample:\n  (with-fail-panic (perform (Fail \"oops\")))  ; panics with \"oops\"\n\nSince: Phase 19"},
    {"with-getenv", "with-getenv -- handle the GetEnv effect by delegating to C getenv(3).\n\nParameters:\n  body -- the expression whose GetEnv effects are handled\n\nReturns:\n  the return value of body\n\nExample:\n  (with-getenv (perform (GetEnv \"PATH\")))  ; => \"/usr/bin:...\"\n\nSince: Phase 19"},
    {"read-int-console", "read-int-console -- read a single integer from stdin via scanf.\n\nReturns:\n  int -- the integer read from stdin\n\nExample:\n  (read-int-console)  ; => 7\n\nSince: Phase 19"},
    {"with-read-console", "with-read-console -- handle the Read effect by reading an integer from stdin.\n\nParameters:\n  body -- the expression whose Read effects are handled\n\nReturns:\n  the return value of body\n\nExample:\n  (with-read-console (perform (Read)))  ; reads integer from stdin\n\nSince: Phase 19"},
    {"Log", "Log -- declare an effect that emits a leveled log message.\n\nParameters:\n  level -- severity label (e.g. \"info\", \"warn\", \"error\")\n  msg -- the message text\n\nReturns:\n  nil\n\nExample:\n  (perform (Log \"info\" \"server started\"))  ; => nil\n\nSince: Phase 19"},
    {"with-stderr-log", "with-stderr-log -- handle the Log effect by printing all messages to stdout.\n\nParameters:\n  body -- the expression whose Log effects are handled\n\nReturns:\n  the return value of body\n\nExample:\n  (with-stderr-log (perform (Log \"warn\" \"low memory\")))  ; prints \"low memory\"\n\nSince: Phase 19"},
    {"with-silent-log", "with-silent-log -- handle the Log effect by suppressing all log output.\n\nParameters:\n  body -- the expression whose Log effects are handled\n\nReturns:\n  the return value of body\n\nExample:\n  (with-silent-log (perform (Log \"debug\" \"ignored\")))  ; no output\n\nSince: Phase 19"},
    {"Abort", "Abort -- declare an effect that signals an unrecoverable abort.\n\nParameters:\n  msg -- the abort message\n\nReturns:\n  int (never actually returned; the handler must not resume k)\n\nExample:\n  (perform (Abort \"fatal error\"))  ; handler should not resume\n\nSince: Phase 19"},
    {"with-abort-panic", "with-abort-panic -- handle the Abort effect by panicking with the message.\n\nParameters:\n  body -- the expression whose Abort effects are handled\n\nReturns:\n  the return value of body, or panics on Abort\n\nExample:\n  (with-abort-panic (perform (Abort \"fatal\")))  ; panics with \"fatal\"\n\nSince: Phase 19"},
    {"Async", "Async -- declare an effect that spawns an async computation and returns a Future.\n\nParameters:\n  thunk -- a zero-argument function pointer to run asynchronously\n\nReturns:\n  ptr<void> -- a Future that can be passed to Await\n\nExample:\n  (perform (Async my-thunk))  ; => future-ptr\n\nSince: Phase T25"},
    {"Await", "Await -- declare an effect that awaits a Future and returns its resolved value.\n\nParameters:\n  future -- a Future pointer previously returned by Async\n\nReturns:\n  int -- the resolved integer value of the future\n\nExample:\n  (perform (Await my-future))  ; => 42\n\nSince: Phase T25"},
    {"with-async", "with-async -- handle the Async effect by running the thunk and resuming with its result.\n\nParameters:\n  body -- the expression whose Async effects are handled\n\nReturns:\n  the return value of body\n\nExample:\n  (with-async (perform (Async my-thunk)))  ; runs thunk inline\n\nSince: Phase T25"},
    {"with-await", "with-await -- handle the Await effect by blocking until the future resolves.\n\nParameters:\n  body -- the expression whose Await effects are handled\n\nReturns:\n  the return value of body\n\nExample:\n  (with-await (perform (Await my-future)))  ; => resolved value\n\nSince: Phase T25"},
    {"tur/effects", "tur/effects -- standard algebraic effects for IO, logging, and randomness.\n\nSince: Phase 19"},
    {"Either", "Either"},
    {"left?", "left? -- is this Either a Left?\n\nParameters:\n  e -- an Either[L R] handle\n\nReturns:\n  true when e is (Left _), false when (Right _).\n\nExample:\n  (left? (Left 3))   ; => true\n    (left? (Right 3))  ; => false\n\nSince: Phase sum-types-either"},
    {"right?", "right? -- is this Either a Right?\n\nParameters:\n  e -- an Either[L R] handle\n\nReturns:\n  true when e is (Right _), false when (Left _).\n\nExample:\n  (right? (Right 3))  ; => true\n    (right? (Left 3))   ; => false\n\nSince: Phase sum-types-either"},
    {"from-left", "from-left -- extract the Left payload, or a default when e is a Right.\n\nParameters:\n  dflt -- value returned when e is a Right\n  e -- an Either[L R] handle\n\nReturns:\n  The L payload when e is (Left l), else dflt.\n\nExample:\n  (from-left 0 (Left 7))   ; => 7\n    (from-left 0 (Right 7))  ; => 0\n\nSince: Phase sum-types-either"},
    {"from-right", "from-right -- extract the Right payload, or a default when e is a Left.\n\nParameters:\n  dflt -- value returned when e is a Left\n  e -- an Either[L R] handle\n\nReturns:\n  The R payload when e is (Right r), else dflt.\n\nExample:\n  (from-right 0 (Right 7))  ; => 7\n    (from-right 0 (Left 7))   ; => 0\n\nSince: Phase sum-types-either"},
    {"either", "either -- eliminate an Either by applying one of two functions.\n\nParameters:\n  on-left -- function applied to the Left payload  (carried as a fat closure)\n  on-right -- function applied to the Right payload (carried as a fat closure)\n  e -- an Either[L R] handle\n\nReturns:\n  (on-left l) when e is (Left l), else (on-right r).\n\nExample:\n  (either negate id (Left 5))   ; => -5\n    (either negate id (Right 5))  ; => 5\n\nSince: Phase sum-types-either"},
    {"either-map", "either-map -- map a function over the Right arm (right-biased).\n\nParameters:\n  f -- function applied to the Right payload (carried as a fat closure)\n  e -- an Either[L R] handle\n\nReturns:\n  (Right (f r)) when e is (Right r), else e unchanged.\n\nExample:\n  (either-map inc (Right 4))  ; => (Right 5)\n    (either-map inc (Left 4))   ; => (Left 4)\n\nSince: Phase sum-types-either"},
    {"either-map-left", "either-map-left -- map a function over the Left arm.\n\nParameters:\n  f -- function applied to the Left payload (carried as a fat closure)\n  e -- an Either[L R] handle\n\nReturns:\n  (Left (f l)) when e is (Left l), else e unchanged.\n\nExample:\n  (either-map-left inc (Left 4))   ; => (Left 5)\n    (either-map-left inc (Right 4))  ; => (Right 4)\n\nSince: Phase sum-types-either"},
    {"tur/either", "tur/either -- binary sum type Either[L R]: Left l or Right r.\n\nSince: Phase sum-types-either"},
    {"env/get-raw", "env/get -- look up an environment variable by name.\n\nParameters:\n  name -- the variable name as a NUL-terminated cstr (e.g., \"HOME\")\n\nReturns:\n  A some option whose int64_t value is the cstr pointer, or none if\n    the variable is not set.  The returned pointer is owned by the\n    OS environment; do not free it.\n\nExample:\n  (env/get \"HOME\")  ; => some(<cstr ptr>)\n\nSince: Phase B2"},
    {"env/get", "env/get -- by-value: some(value cstr) if set, none otherwise."},
    {"env/get!", "env/get! -- look up an environment variable, panicking if missing.\n\nParameters:\n  name -- the variable name as a NUL-terminated cstr\n\nReturns:\n  The value cstr.  Panics if the variable is not set.\n\nExample:\n  (env/get! \"HOME\")  ; => \"/home/user\"  ; doctest: value depends on the environment\n\nSince: Phase B2"},
    {"env/set", "env/set -- set an environment variable.\n\nParameters:\n  name -- variable name cstr\n  value -- new value cstr\n\nReturns:\n  0 on success, -1 on error.\n\nExample:\n  (env/set \"MY_VAR\" \"hello\")  ; => 0\n\nSince: Phase B2"},
    {"env/unset", "env/unset -- unset an environment variable.\n\nParameters:\n  name -- variable name cstr\n\nReturns:\n  0 on success, -1 on error.\n\nExample:\n  (env/unset \"MY_VAR\")  ; => 0\n\nSince: Phase B2"},
    {"env/all", "env/all -- return all environment variables as \"KEY=VALUE\" strings.\n\nReturns:\n  A (Vec cstr) of fresh strdup'd \"KEY=VALUE\" strings, in environ order.\n    The caller owns it: release it with env/all-free.\n\nExample:\n  (let [v (env/all)] (println (vec-len v)) (env/all-free v))\n\nSince: Phase B2"},
    {"env/all-free", "env/all-free -- free a (Vec cstr) returned by env/all.\n\nParameters:\n  v -- the vector returned by env/all (every string and the Vec itself\n   -- are released)\n\nExample:\n  (env/all-free my-env)\n\nSince: Phase B2"},
    {"env/home", "env/home -- return the HOME environment variable, if set.\n\nReturns:\n  some(value) holding the home directory as a cstr owned by the OS\n    environment (do not free it), or none when HOME is unset.\n\nExample:\n  (env/home)  ; => some(\"/home/user\")  ; doctest: value depends on the environment\n\nSince: Phase B2"},
    {"env/path", "env/path -- return the PATH environment variable, if set.\n\nReturns:\n  some(value) holding the executable search path as a cstr owned by the OS\n    environment (do not free it), or none when PATH is unset.\n\nExample:\n  (env/path)  ; => some(\"/usr/bin:/bin:/usr/local/bin\")  ; doctest: value depends on the environment\n\nSince: Phase B2"},
    {"env/user", "env/user -- return the USER environment variable, if set.\n\nReturns:\n  some(value) holding the login name as a cstr owned by the OS\n    environment (do not free it), or none when USER is unset.\n\nExample:\n  (env/user)  ; => some(\"alice\")  ; doctest: value depends on the environment\n\nSince: Phase B2"},
    {"env/shell", "env/shell -- return the SHELL environment variable, if set.\n\nReturns:\n  some(value) holding the login shell as a cstr owned by the OS\n    environment (do not free it), or none when SHELL is unset.\n\nExample:\n  (env/shell)  ; => some(\"/bin/bash\")  ; doctest: value depends on the environment\n\nSince: Phase B2"},
    {"tur/env", "tur/env -- environment variable access (getenv, setenv, unsetenv).\n\nSince: Phase B1"},
    {"Equal", "Equal"},
    {"equal-sym", "equal-sym"},
    {"equal-trans", "equal-trans"},
    {"equal-cong", "equal-cong -- congruence: if a = b then (f a) = (f b) for any f : * -> *.\n\nParameters:\n  eq -- a proof that a = b\n\nReturns:\n  A proof that (f a) = (f b).\n\nExample:\n  (equal-cong Refl)  ; => Refl\n\nSince: Phase G4 (requires HKT)"},
    {"tur/equal", "tur/equal -- type-equality witness (Equal GADT) for type-safe coercions.\n\nSince: Phase G3"},
    {"showable", "showable -- pack a value as a Show-constrained existential.\n\nParameters:\n  x -- any value whose type implements the Show typeclass\n\nReturns:\n  A boxed existential of type (exists [a] [(Show a)] a).  At runtime\n    this is a tur_existential_t* carrying the value and a Show vtable\n    pointer (see Phase EX1e).\n\nExample:\n  (showable 42)\n      ; => packed existential; opening it with show-it prints \"42\".\n\nSince: Phase EX1f"},
    {"show-it", "show-it -- open a Show-constrained existential and call .show on\n\nParameters:\n  s -- a value of type (exists [a] [(Show a)] a) produced by showable\n\nReturns:\n  The :cstr produced by the Show instance attached to the underlying\n    concrete type.\n\nExample:\n  (show-it (showable 42))   ; => \"42\"\n    (show-it (showable true)) ; => \"true\"  (requires Show [bool])\n\nSince: Phase EX1f"},
    {"tur/existential", "tur/existential -- helpers for native pack/open existential types.\n\nSince: Phase EX1"},
    {"Fd", "Fd"},
    {"fd->int", "fd->int -- recover the raw :int file descriptor from an Fd.\n\nParameters:\n  fd -- the Fd handle to unwrap\n\nReturns:\n  The underlying file descriptor as a plain :int.\n\nExample:\n  (if (< (fd->int fd) 0) (handle-error))\n\nSince: I/O sweep"},
    {"int->fd", "int->fd -- wrap a raw :int file descriptor as an Fd.\n\nParameters:\n  n -- a raw file descriptor (e.g. 0/1/2 for stdin/stdout/stderr)\n\nReturns:\n  An Fd wrapping n.\n\nExample:\n  (def stdin-fd (int->fd 0))\n\nSince: I/O sweep"},
    {"fd-valid?", "fd-valid? -- return true if the Fd is a real descriptor (>= 0).\n\nParameters:\n  fd -- the Fd handle to test\n\nReturns:\n  true when the underlying fd is non-negative; false for the -1 error value.\n\nExample:\n  (let [fd (async-socket-accept listen)]\n      (when (fd-valid? fd) (serve fd)))\n\nSince: I/O sweep"},
    {"tur/fd", "tur/fd -- Fd: an opaque newtype over a POSIX file descriptor.\n\nSince: stdlib-opaque-handle-types-plan, I/O sweep"},
    {"FiberHandle", "FiberHandle"},
    {"fiber-new", "fiber-new -- create a new fiber from a function pointer and an optional stack size.\n\nParameters:\n  fn -- zero-argument function pointer to run as the fiber body\n  stack-size -- requested stack size in bytes; 0 uses the default size\n\nReturns:\n  A FiberHandle to the FiberBlock.\n\nExample:\n  (let [f (fiber-new my-fn 0)] ...)  ; => FiberHandle\n\nSince: Phase T21-C"},
    {"fiber-resume", "fiber-resume -- resume a suspended fiber, passing it a value, and return the yielded or final value.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n  arg -- value passed to the fiber as the resume argument\n\nReturns:\n  The int64_t value yielded by the fiber, or its final return value.\n\nExample:\n  (fiber-resume f 0)  ; => int\n\nSince: Phase T21-C"},
    {"fiber-yield", "fiber-yield -- suspend the current fiber and return a value to its caller.\n\nParameters:\n  value -- int64_t value to hand back to the fiber-resume caller\n\nExample:\n  (fiber-yield 42)\n\nSince: Phase T21-C"},
    {"fiber-done?", "fiber-done? -- check whether a fiber has run to completion.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n\nReturns:\n  Non-zero (truthy) if the fiber has returned; 0 if it is still runnable or suspended.\n\nExample:\n  (if (fiber-done? f) ...)  ; => int\n\nSince: Phase T21-C"},
    {"fiber-arg", "fiber-arg -- retrieve the most recent argument value passed to a fiber via fiber-resume.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n\nReturns:\n  The int64_t argument last supplied to fiber-resume, or 0 if the handle is NULL.\n\nExample:\n  (fiber-arg f)  ; => int\n\nSince: Phase T21-C"},
    {"fiber-free", "fiber-free -- release all memory associated with a fiber.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n\nExample:\n  (fiber-free f)\n\nSince: Phase T21-C"},
    {"fiber-local-get", "fiber-local-get -- retrieve a fiber-local value by key from a specific fiber.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n  key -- int64_t key identifying the slot\n\nReturns:\n  The int64_t value stored at key, or 0 if not set.\n\nExample:\n  (fiber-local-get f 1)  ; => int\n\nSince: Phase T21"},
    {"fiber-local-set!", "fiber-local-set! -- store a fiber-local value by key in a specific fiber.\n\nParameters:\n  f -- fiber handle returned by fiber-new\n  key -- int64_t key identifying the slot\n  value -- int64_t value to store\n\nExample:\n  (fiber-local-set! f 1 99)\n\nSince: Phase T21"},
    {"fiber-local-current-get", "fiber-local-current-get -- retrieve a fiber-local value by key from the currently running fiber.\n\nParameters:\n  key -- int64_t key identifying the slot\n\nReturns:\n  The int64_t value stored at key in the current fiber, or 0 if not set.\n\nExample:\n  (fiber-local-current-get 1)  ; => int\n\nSince: Phase T21"},
    {"fiber-local-current-set!", "fiber-local-current-set! -- store a fiber-local value by key in the currently running fiber.\n\nParameters:\n  key -- int64_t key identifying the slot\n  value -- int64_t value to store\n\nExample:\n  (fiber-local-current-set! 1 99)\n\nSince: Phase T21"},
    {"scheduler-yield!", "scheduler-yield! -- yield the current fiber back to the scheduler, re-enqueueing it for the next turn.\n\nExample:\n  (scheduler-yield!)\n\nSince: Phase T21"},
    {"scheduler-park!", "scheduler-park! -- park the current fiber, suspending it without re-enqueueing.\n\nExample:\n  (scheduler-park!)\n\nSince: Phase T21"},
    {"scheduler-unpark!", "scheduler-unpark! -- unpark a specific fiber and add it back to the scheduler run queue.\n\nParameters:\n  f -- fiber handle to unpark\n\nExample:\n  (scheduler-unpark! f)\n\nSince: Phase T21"},
    {"async-sleep", "async-sleep -- sleep for approximately ms milliseconds without blocking the OS thread.\n\nParameters:\n  ms -- duration in milliseconds; values <= 0 return immediately\n\nExample:\n  (async-sleep 100)\n\nSince: Phase T24"},
    {"fiber-thread-id", "fiber-thread-id -- return an integer identifier for the OS thread running the current fiber.\n\nReturns:\n  The current pthread_t cast to int64_t.\n\nExample:\n  (fiber-thread-id)  ; => int\n\nSince: Phase T23"},
    {"tur/fiber", "tur/fiber -- lightweight cooperative fibers backed by the FiberBlock runtime.\n\nSince: Phase T21-C"},
    {"Fix", "Fix -- the fixed-point type of a functor."},
    {"roll", "roll -- wrap one layer of f into a Fix value.\n\nParameters:\n  layer -- a value of type (f (Fix f))\n\nReturns:\n  A Fix value wrapping layer.\n\nExample:\n  (roll my-layer)  ; => (Roll my-layer)\n\nSince: Phase RF2"},
    {"unroll", "unroll -- unwrap one layer of Fix to expose the inner functor value.\n\nParameters:\n  fix -- a Fix value\n\nReturns:\n  The inner f (Fix f) value.\n\nExample:\n  (unroll (roll x))  ; => x\n\nSince: Phase RF2"},
    {"cata", "cata -- catamorphism: fold a Fix value using an F-algebra.\n\nParameters:\n  alg -- a typed fat-closure (function from (f a) to a) stored as :fn\n  fix -- a Fix value to fold\n\nReturns:\n  The result of applying alg to the unwrapped layer.\n\nExample:\n  (cata my-alg leaf-fix)\n\nSince: Phase RF2"},
    {"ana", "ana -- anamorphism: unfold a seed value into a Fix value using a co-algebra.\n\nParameters:\n  coalg -- a typed fat-closure (function from a to (f a)) stored as :fn\n  seed -- the initial seed value\n\nReturns:\n  A Fix value built by applying coalg to seed.\n\nExample:\n  (ana my-coalg seed-value)\n\nSince: Phase RF2"},
    {"tur/fix", "tur/fix -- Fix type: the fixed-point of a functor, with cata and ana.\n\nSince: Phase B1"},
    {"float-range-bound-new", "float-range-bound-new -- allocate a FloatRangeBound with given inclusivity and value.\n\nParameters:\n  inclusive -- 1 for inclusive, 0 for exclusive\n  value -- the endpoint value (float64)\n\nReturns:\n  int64_t pointer to a heap FloatRangeBound.\n\nSince: RR4"},
    {"float-range-bound-inclusive?", "float-range-bound-inclusive? -- true if the bound is inclusive.\n\nParameters:\n  b -- int64_t pointer to a FloatRangeBound (must not be 0)\n\nSince: RR4"},
    {"float-range-bound-value", "float-range-bound-value -- return the endpoint value of a bound.\n\nParameters:\n  b -- int64_t pointer to a FloatRangeBound (must not be 0)\n\nSince: RR4"},
    {"float-range-new", "float-range-new -- allocate a FloatRange from lower and upper bound pointers.\n\nParameters:\n  lower -- 0 for unbounded below, else FloatRangeBound pointer\n  upper -- 0 for unbounded above, else FloatRangeBound pointer\n\nReturns:\n  int64_t pointer to a heap FloatRange.\n\nSince: RR4"},
    {"float-range-lower", "float-range-lower -- return the lower bound pointer (0 = unbounded).\n\nParameters:\n  r -- int64_t pointer to a FloatRange\n\nSince: RR4"},
    {"float-range-upper", "float-range-upper -- return the upper bound pointer (0 = unbounded).\n\nParameters:\n  r -- int64_t pointer to a FloatRange\n\nSince: RR4"},
    {"float-range-val-in-lower?", "float-range-val-in-lower? -- check value against a lower bound."},
    {"float-range-val-in-upper?", "float-range-val-in-upper? -- check value against an upper bound."},
    {"float-closed-range", "float-closed-range -- [lo, hi] both endpoints inclusive.\n\nParameters:\n  lo -- lower bound value\n  hi -- upper bound value\n\nReturns:\n  A FloatRange representing [lo, hi].\n\nExample:\n  (float-closed-range 0.0 1.0)  ; => [0.0, 1.0]\n\nSince: RR4"},
    {"float-open-range", "float-open-range -- (lo, hi) both endpoints exclusive.\n\nParameters:\n  lo -- lower bound value (excluded)\n  hi -- upper bound value (excluded)\n\nReturns:\n  A FloatRange representing (lo, hi).\n\nExample:\n  (float-open-range 0.0 1.0)  ; => (0.0, 1.0)\n\nSince: RR4"},
    {"float-closed-open-range", "float-closed-open-range -- [lo, hi) inclusive lower, exclusive upper.\n\nParameters:\n  lo -- lower bound value (included)\n  hi -- upper bound value (excluded)\n\nReturns:\n  A FloatRange representing [lo, hi).\n\nExample:\n  (float-closed-open-range 0.0 1.0)  ; => [0.0, 1.0)\n\nSince: RR4"},
    {"float-open-closed-range", "float-open-closed-range -- (lo, hi] exclusive lower, inclusive upper.\n\nParameters:\n  lo -- lower bound value (excluded)\n  hi -- upper bound value (included)\n\nReturns:\n  A FloatRange representing (lo, hi].\n\nExample:\n  (float-open-closed-range 0.0 1.0)  ; => (0.0, 1.0]\n\nSince: RR4"},
    {"float-at-least-range", "float-at-least-range -- [lo, +inf) inclusive lower, unbounded above.\n\nParameters:\n  lo -- lower bound value (included)\n\nReturns:\n  A FloatRange representing [lo, +inf).\n\nExample:\n  (float-at-least-range 0.0)  ; => [0.0, +inf)\n\nSince: RR4"},
    {"float-greater-than-range", "float-greater-than-range -- (lo, +inf) exclusive lower, unbounded above.\n\nParameters:\n  lo -- lower bound value (excluded)\n\nReturns:\n  A FloatRange representing (lo, +inf).\n\nExample:\n  (float-greater-than-range 0.0)  ; => (0.0, +inf)\n\nSince: RR4"},
    {"float-at-most-range", "float-at-most-range -- (-inf, hi] unbounded below, inclusive upper.\n\nParameters:\n  hi -- upper bound value (included)\n\nReturns:\n  A FloatRange representing (-inf, hi].\n\nExample:\n  (float-at-most-range 1.0)  ; => (-inf, 1.0]\n\nSince: RR4"},
    {"float-less-than-range", "float-less-than-range -- (-inf, hi) unbounded below, exclusive upper.\n\nParameters:\n  hi -- upper bound value (excluded)\n\nReturns:\n  A FloatRange representing (-inf, hi).\n\nExample:\n  (float-less-than-range 1.0)  ; => (-inf, 1.0)\n\nSince: RR4"},
    {"float-singleton-range", "float-singleton-range -- [v, v] a range containing exactly one value.\n\nParameters:\n  v -- the single value\n\nReturns:\n  A FloatRange representing [v, v].\n\nExample:\n  (float-singleton-range 0.5)  ; => [0.5, 0.5]\n\nSince: RR4"},
    {"float-unbounded-range", "float-unbounded-range -- (-inf, +inf) no bounds at all.\n\nReturns:\n  A FloatRange representing all float values.\n\nExample:\n  (float-unbounded-range)  ; => (-inf, +inf)\n\nSince: RR4"},
    {"float-range-contains?", "float-range-contains? -- true if value v falls within float range r.\n\nParameters:\n  r -- int64_t pointer to a FloatRange\n  v -- float value to test\n\nReturns:\n  true if v satisfies both the lower and upper bounds of r.\n\nExample:\n  (float-range-contains? (float-closed-range 0.0 1.0) 0.5)  ; => true\n    (float-range-contains? (float-open-range 0.0 1.0) 0.0)    ; => false\n\nSince: RR4"},
    {"tur/float-range", "tur/float-range -- FloatRange: continuous interval with inclusive or exclusive ends.\n\nSince: Phase RR4"},
    {"Free", "Free -- the Free monad over a functor f."},
    {"free-pure", "free-pure -- lift a pure value into the Free monad.\n\nParameters:\n  x -- the value to lift\n\nReturns:\n  A Free value in the pure leaf case.\n\nExample:\n  (free-pure 42)  ; => (PureFree 42)\n\nSince: Phase RF3"},
    {"free-lift", "free-lift -- lift one layer of f into Free.\n\nParameters:\n  fx -- a value of type (f a), where a is the \"next step\" value\n\nReturns:\n  A Free value that suspends on fx.\n\nExample:\n  (free-lift (some 5))\n\nSince: Phase RF3"},
    {"free-bind", "free-bind -- monadic bind for Free.\n\nParameters:\n  ma -- a Free value\n  kont -- a continuation from a to (Free f b), typed `(fn [int] int)` over\n   -- the erased Free carrier; a fat closure via the ^fat marker (a bare\n   -- non-capturing fn is auto-shimmed)\n\nReturns:\n  A new Free value representing the sequenced computation.\n\nExample:\n  (free-bind (free-pure 3) (fn [x] (free-pure (* x 2))))  ; => (PureFree 6)\n\nSince: Phase RF3"},
    {"free-fmap", "free-fmap -- functor map for Free: apply a function to all pure leaves.\n\nParameters:\n  free -- a Free value\n  f -- a function from a to b, typed `(fn [int] int)` over the erased\n   -- carrier; a fat closure via the ^fat marker (a bare non-capturing\n   -- fn is auto-shimmed)\n\nReturns:\n  A new Free value with f applied to all pure leaves.\n\nSince: Phase RF3"},
    {"free-run", "free-run -- interpret a Free computation with a natural transformation.\n\nParameters:\n  interp -- a natural transformation from (f a) to a, typed\n   -- `(fn [int] int)` over the erased carrier; a fat closure via the\n   -- ^fat marker (bare fns auto-shimmed)\n  free -- a Free computation to run\n\nReturns:\n  The result of running free under interp.\n\nExample:\n  (free-run my-interp my-program)\n\nSince: Phase RF3"},
    {"tur/free", "tur/free -- Free monad over a functor f for building effect DSLs.\n\nSince: Phase B1"},
    {"StatInfo", "StatInfo"},
    {"TmpFile", "TmpFile"},
    {"fs/stat", "fs/stat -- return file metadata for a path.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  (Ok info) -- a StatInfo over a { size mtime mode } triple; inspect it\n    with fs/stat-size, fs/stat-mtime, fs/stat-mode and release it with\n    fs/stat-free -- or (Err e) when the path is inaccessible.\n\nExample:\n  (match (fs/stat \"/etc/hosts\")\n      (Ok s)  (do (println (fs/stat-size s)) (fs/stat-free s))\n      (Err e) (println (io-error/message e)))\n\nSince: Phase B2"},
    {"fs/stat-free", "fs/stat-free -- free the stat result returned by fs/stat.\n\nParameters:\n  s -- a StatInfo from a successful fs/stat\n\nExample:\n  (fs/stat-free s)\n\nSince: Phase B2"},
    {"fs/stat-size", "fs/stat-size -- extract file size from a stat result.\n\nParameters:\n  s -- stat pointer from fs/stat\n\nReturns:\n  File size in bytes as :int.\n\nExample:\n  (fs/stat-size info)  ; => 221\n\nSince: Phase B2"},
    {"fs/stat-mtime", "fs/stat-mtime -- extract modification time from a stat result.\n\nParameters:\n  s -- stat pointer from fs/stat\n\nReturns:\n  Modification time as a Unix timestamp (:int).\n\nExample:\n  (fs/stat-mtime info)  ; => 1747123456\n\nSince: Phase B2"},
    {"fs/stat-mode", "fs/stat-mode -- extract file mode bits from a stat result.\n\nParameters:\n  s -- stat pointer from fs/stat\n\nReturns:\n  File mode bits as :int (same as st_mode from stat(2)).\n\nExample:\n  (fs/stat-mode info)  ; => 33188\n\nSince: Phase B2"},
    {"fs/exists?", "fs/exists? -- test whether a path exists.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  true if stat(2) succeeds on the path, false otherwise.\n\nExample:\n  (fs/exists? \"/etc/hosts\")  ; => true\n\nSince: Phase B2"},
    {"fs/file?", "fs/file? -- test whether a path is a regular file.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  true if path is a regular file.\n\nExample:\n  (fs/file? \"/etc/hosts\")  ; => true\n\nSince: Phase B2"},
    {"fs/dir?", "fs/dir? -- test whether a path is a directory.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  true if path is a directory.\n\nExample:\n  (fs/dir? \"/tmp\")  ; => true\n\nSince: Phase B2"},
    {"fs/mkdir", "fs/mkdir -- create a directory with mode 0755.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  (Ok nil) on success, or (Err e) carrying the errno.\n\nExample:\n  (fs/mkdir \"/tmp/mydir\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"fs/mkdirp", "fs/mkdirp -- create a directory and all missing parent directories.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  (Ok nil) on success (including when the directory already exists), or\n    (Err e) for the first mkdir that failed for any other reason.\n\nExample:\n  (fs/mkdirp \"/tmp/a/b/c\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"fs/rmdir", "fs/rmdir -- remove an empty directory.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  (Ok nil) on success, or (Err e) carrying the errno.\n\nExample:\n  (fs/rmdir \"/tmp/mydir\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"fs/rm", "fs/rm -- remove a regular file.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  (Ok nil) on success, or (Err e) carrying the errno.\n\nExample:\n  (fs/rm \"/tmp/tmpfile.txt\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"fs/rename", "fs/rename -- rename or move a file.\n\nParameters:\n  src -- source path cstr\n  dst -- destination path cstr\n\nReturns:\n  (Ok nil) on success, or (Err e) carrying the errno.\n\nExample:\n  (fs/rename \"/tmp/a.txt\" \"/tmp/b.txt\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"fs/copy", "fs/copy -- copy a file from src to dst using a read/write loop.\n\nParameters:\n  src -- source path cstr\n  dst -- destination path cstr\n\nReturns:\n  (Ok nil) on success, or (Err e) carrying the errno.\n\nExample:\n  (fs/copy \"/etc/hosts\" \"/tmp/hosts.bak\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"fs/glob", "fs/glob -- list directory entries matching a fnmatch(3) pattern.\n\nParameters:\n  dir -- directory to search (e.g., \"/tmp\")\n  pattern -- fnmatch pattern applied to entry names (e.g., \"*.txt\")\n\nReturns:\n  (Ok paths) -- a (Vec cstr) of fresh heap-allocated full paths, in\n    directory order; release it with fs/paths-free -- or (Err e) when the\n    directory cannot be opened.\n\nExample:\n  (match (fs/glob \"/tmp\" \"*.txt\")\n      (Ok v)  (do (println (vec-len v)) (fs/paths-free v))\n      (Err e) (println (io-error/message e)))\n\nSince: Phase B2"},
    {"fs/paths-free", "fs/paths-free -- free a (Vec cstr) of owned strings and the Vec itself.\n\nParameters:\n  v -- a (Vec cstr) whose element strings are heap-owned\n\nExample:\n  (fs/paths-free paths)\n\nSince: stdlib-os-surface P1"},
    {"fs/tmpfile", "fs/tmpfile -- create a unique temporary file in the system temp directory.\n\nReturns:\n  A linear TmpFile handle wrapping a pair { path-cstr, fd }.\n    The path is heap-allocated; the fd is the open descriptor.\n    Release exactly once with fs/tmpfile-free.  Returns 0 on failure.\n    The directory is resolved at run time: TMPDIR (else /tmp) on POSIX,\n    GetTempPath on Windows -- never a hardcoded \"/tmp\", which a native\n    Windows binary would resolve against the current drive root.\n    Under -Xlinear the checker requires the handle be consumed exactly once\n    (dropping it is TUR-E0100; freeing it twice is TUR-E0101).\n\nExample:\n  (let [t (fs/tmpfile)] (fs/tmpfile-free t))\n\nSince: Phase B2"},
    {"fs/tmpfile-path", "fs/tmpfile-path -- extract the path from an fs/tmpfile pair.\n\nParameters:\n  t -- tmpfile pair from fs/tmpfile\n\nReturns:\n  The path cstr (owned by the pair; do not free separately).\n\nExample:\n  (fs/tmpfile-path my-tmp)  ; => \"/tmp/tur_aB3xYz\"\n\nSince: Phase B2"},
    {"fs/tmpfile-fd", "fs/tmpfile-fd -- extract the file descriptor from an fs/tmpfile pair.\n\nParameters:\n  t -- tmpfile pair from fs/tmpfile\n\nReturns:\n  The open file descriptor as :int.\n\nExample:\n  (fs/tmpfile-fd my-tmp)  ; => 5\n\nSince: Phase B2"},
    {"fs/tmpfile-free", "fs/tmpfile-free -- close the fd and free the tmpfile pair.\n\nParameters:\n  t -- tmpfile pair from fs/tmpfile (may be 0)\n\nExample:\n  (fs/tmpfile-free my-tmp)\n\nSince: Phase B2"},
    {"fs/read-text", "fs/read-text -- read an entire file into a NUL-terminated heap buffer.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  (Ok text) -- a fresh heap-allocated NUL-terminated cstr of the file\n    contents, which the caller owns (release with free) -- or (Err e).\n\nExample:\n  (match (fs/read-text \"/etc/hostname\")\n      (Ok s)  (println s)\n      (Err e) (println (io-error/message e)))\n\nSince: Phase B2"},
    {"fs/write-text", "fs/write-text -- write a NUL-terminated string to a file.\n\nParameters:\n  path -- NUL-terminated destination path cstr\n  content -- NUL-terminated string to write\n\nReturns:\n  (Ok nil) on success, or (Err e) carrying the errno.\n\nExample:\n  (fs/write-text \"/tmp/out.txt\" \"hello\\n\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"fs/append-text", "fs/append-text -- append a NUL-terminated string to a file.\n\nParameters:\n  path -- NUL-terminated destination path cstr\n  content -- NUL-terminated string to append\n\nReturns:\n  (Ok nil) on success, or (Err e) carrying the errno.\n\nExample:\n  (fs/append-text \"/tmp/log.txt\" \"one more line\\n\")  ; => (Ok nil)\n\nSince: stdlib-os-surface P0"},
    {"fs/read-lines", "fs/read-lines -- read a whole file as a vector of lines.\n\nParameters:\n  path -- NUL-terminated path cstr\n\nReturns:\n  (Ok lines) -- a (Vec cstr) of fresh heap strings; release it with\n    fs/paths-free -- or (Err e).\n\nExample:\n  (match (fs/read-lines \"/etc/hosts\")\n      (Ok v)  (do (println (vec-len v)) (fs/paths-free v))\n      (Err e) (println (io-error/message e)))\n\nSince: stdlib-os-surface P2"},
    {"fs/read-dir", "fs/read-dir -- the names in a directory, sorted.\n\nParameters:\n  dir -- the directory to list\n\nReturns:\n  (Ok names) -- a (Vec cstr) of fresh heap strings; release it with\n    fs/paths-free -- or (Err e) when the directory cannot be opened.\n\nExample:\n  (match (fs/read-dir \"/tmp\")\n      (Ok v)  (do (println (vec-len v)) (fs/paths-free v))\n      (Err e) (println (io-error/message e)))\n\nSince: stdlib-os-surface P2"},
    {"fs/path-join", "fs/path-join -- join a directory and a name with one separator.\n\nParameters:\n  dir -- the directory part (a trailing '/' is not doubled)\n  name -- the entry name\n\nReturns:\n  A fresh heap cstr \"dir/name\" the caller owns (release with free).\n\nExample:\n  (fs/path-join \"/tmp\" \"a.txt\")  ; => \"/tmp/a.txt\"\n\nSince: stdlib-os-surface P2"},
    {"fs/free-cstr", "fs/free-cstr -- free a heap cstr (internal)."},
    {"fs/dup-cstr", "fs/dup-cstr -- a fresh heap copy of a cstr (internal)."},
    {"fs/walk-dir?", "fs/walk-dir? -- is path a directory the walk descends into (internal)."},
    {"fs/walk-names", "fs/walk-names -- visit names[i..] of dir, recursing into directories (internal)."},
    {"fs/walk-fn", "fs/walk-fn -- call f on every path under root, depth first.\n\nParameters:\n  root -- the directory to walk\n  f -- (fn [path is-dir] nil), called once per entry\n\nReturns:\n  (Ok nil) once the whole tree was visited, or (Err e) for the first\n    directory that could not be read (the walk stops there).\n\nExample:\n  (fs/walk-fn \"/tmp/proj\" (fn [p : cstr d : bool] : nil (println p)))\n\nSince: stdlib-os-surface P2"},
    {"fs/walk", "fs/walk -- every path under root, depth first, as a vector.\n\nParameters:\n  root -- the directory to walk\n\nReturns:\n  (Ok paths) -- a (Vec cstr) of fresh heap paths, each starting with\n    root; release it with fs/paths-free -- or (Err e) for the first\n    directory that could not be read.\n\nExample:\n  (match (fs/walk \"/tmp/proj\")\n      (Ok v)  (do (println (vec-len v)) (fs/paths-free v))\n      (Err e) (println (io-error/message e)))\n\nSince: stdlib-os-surface P2"},
    {"tur/fs", "tur/fs -- extended file-system operations (stat, readdir, fnmatch, walk).\n\nSince: Phase B1"},
    {"Promise", "Promise"},
    {"Future", "Future"},
    {"future-cell-new", "future-cell-new -- allocate and initialise a shared FutureCell (mutex, condvar, unset).\n\nReturns:\n  A Promise (write-end view of the new FutureCell); free with future-cell-free.\n\nSince: Phase T20-C"},
    {"future-cell-free", "future-cell-free -- destroy the mutex/condvar and free a FutureCell.\n\nParameters:\n  cell -- FutureCell pointer from future-cell-new\n\nSince: Phase T20-C"},
    {"promise-new", "promise-new -- allocate a new unsettled Promise/Future shared cell.\n\nReturns:\n  A Promise (write end); derive the read-end Future with future-of-cell.\n\nExample:\n  (def p (promise-new))\n    (promise-fulfill p 42)\n\nSince: Phase T20-C"},
    {"promise-of-cell", "promise-of-cell -- return the Promise handle for a FutureCell (identity; for API symmetry).\n\nParameters:\n  cell -- FutureCell pointer from promise-new\n\nSince: Phase T20-C"},
    {"future-of-cell", "future-of-cell -- return the Future handle for a FutureCell (identity; for API symmetry).\n\nParameters:\n  cell -- FutureCell pointer from promise-new\n\nSince: Phase T20-C"},
    {"future-handle", "future-handle -- borrow a Promise and derive a Future over the same cell.\n\nParameters:\n  p -- Promise from promise-new (borrowed, not consumed)\n\nReturns:\n  A Future over the same cell; free exactly once with future-free.\n\nExample:\n  (let [p (promise-new)]\n      (let [f (future-handle p)]\n        (promise-fulfill p 42)      ; consumes p, settles\n        (future-get f)              ; read via f\n        (future-free f)))           ; consumes f, frees the cell\n\nSince: stdlib-linearity-affinity (Future aliasing fix)"},
    {"promise-pair", "promise-pair -- expand to a (Promise Future) pair list from a single shared cell.\n\nParameters:\n  cell -- FutureCell pointer from promise-new\n\nSince: Phase T20-C"},
    {"promise-fulfill", "promise-fulfill -- settle a promise with a successful value; wakes all future waiters.\n\nParameters:\n  p -- Promise (FutureCell) pointer\n  v -- fulfillment value\n\nSince: Phase T20-C"},
    {"promise-fail", "promise-fail -- settle a promise with an error code; wakes all future waiters.\n\nParameters:\n  p -- Promise (FutureCell) pointer\n  e -- error/exception code\n\nSince: Phase T20-C"},
    {"promise-free", "promise-free -- free a promise and its shared FutureCell.\n\nParameters:\n  p -- Promise pointer from promise-new\n\nSince: Phase T20-C"},
    {"future-done?", "future-done? -- non-blocking check: return true if the future has been settled.\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nReturns:\n  true if settled (fulfilled or failed), false otherwise.\n\nSince: Phase T20-C"},
    {"future-get", "future-get -- block until the future is settled; return a heap-allocated Result struct.\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nReturns:\n  A :ptr<void> to a Result in the canonical tagged layout (tag 0 = Ok).\n\nExample:\n  (def result (future-get f))\n\nSince: Phase T20-C"},
    {"future-free", "future-free -- free a future and its shared FutureCell.\n\nParameters:\n  f -- Future pointer from promise-new / future-of-cell\n\nSince: Phase T20-C"},
    {"future-of", "future-of -- create a pre-fulfilled future holding value v.\n\nParameters:\n  v -- value the future should carry\n\nReturns:\n  A Future already settled as ok with value v.\n\nExample:\n  (def f (future-of 42))  ; immediately done\n\nSince: Phase T20-C"},
    {"future-error-of", "future-error-of -- create a pre-rejected future with error code e.\n\nParameters:\n  e -- error/exception code\n\nReturns:\n  A Future already settled as failed with exn = e.\n\nSince: Phase T20-C"},
    {"future-cancel", "future-cancel -- cancel a future if not yet settled; sets error code -2 (TUR_FUTURE_CANCELLED).\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nSince: Phase T20-C"},
    {"future-cancelled?", "future-cancelled? -- return true if the future was cancelled (exn == -2).\n\nParameters:\n  f -- Future (FutureCell) pointer\n\nReturns:\n  true if the future was settled via future-cancel, false otherwise.\n\nSince: Phase T20-C"},
    {"future-map", "future-map -- map fn over a fulfilled future value; propagate rejection unchanged.\n\nParameters:\n  f -- source Future pointer\n  fn -- a `(fn [int] int)` closure applied to the fulfilled value\n\nReturns:\n  A new pre-settled Future with fn(value) on success, or the original error on failure.\n\nSince: Phase T20-C"},
    {"future-then", "future-then -- flat-map fn over a future; fn must return a new Future ptr<void>.\n\nParameters:\n  f -- source Future pointer\n  fn -- a `(fn [int] Future)` closure producing the next Future\n\nReturns:\n  The Future returned by fn, or a pre-rejected Future if f was rejected.\n\nSince: Phase T20-C"},
    {"future-race", "future-race -- race two futures; return a new future settled by whichever finishes first.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nReturns:\n  A new pre-settled Future carrying the winner's value or error.\n\nSince: Phase T20-C"},
    {"future-all2", "future-all2 -- await both futures; settle ok with fa's value only if both succeed.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nReturns:\n  A new pre-settled Future: ok with fa's value if both ok, else the first error.\n\nSince: Phase T20-C"},
    {"future-any2", "future-any2 -- return a future settled by the first fulfilled future; both rejecting yields fb's error.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nReturns:\n  A new pre-settled Future with fa's value if fa ok, else fb's outcome.\n\nSince: Phase T20-C"},
    {"future-join", "future-join -- await both futures and produce a new future holding a Tuple2 of their values.\n\nParameters:\n  fa -- first Future pointer\n  fb -- second Future pointer\n\nReturns:\n  A new pre-settled Future whose ok value is a pointer to Tuple2 { e1, e2 };\n    rejected with the first error if either future fails.\n\nSince: Phase T20-C"},
    {"tuple-first", "tuple-first -- read the first element of a Tuple2 returned by future-join.\n\nParameters:\n  tup -- Tuple2 pointer from the ok value of a future-join result\n\nReturns:\n  The int64 first element.\n\nSince: Phase T20-C"},
    {"tuple-second", "tuple-second -- read the second element of a Tuple2 returned by future-join.\n\nParameters:\n  tup -- Tuple2 pointer from the ok value of a future-join result\n\nReturns:\n  The int64 second element.\n\nSince: Phase T20-C"},
    {"tuple-free", "tuple-free -- free a Tuple2 allocated by future-join.\n\nParameters:\n  tup -- Tuple2 pointer to free\n\nSince: Phase T20-C"},
    {"promise-new-pair", "promise-new-pair -- allocate a new unsettled Promise/Future shared cell (alias for promise-new).\n\nSince: Phase T20-C"},
    {"future-race-n", "future-race-n -- race an array of n futures; return a new future settled by the first to finish.\n\nParameters:\n  futures -- pointer to an array of FutureCell* (ptr<void>[n])\n  n -- number of futures in the array\n\nReturns:\n  A new pre-settled Future with the first settled future's outcome.\n\nSince: Phase T20-C"},
    {"future-all-n", "future-all-n -- await all n futures; settle ok (value 0) only if every future succeeds.\n\nParameters:\n  futures -- pointer to an array of FutureCell* (ptr<void>[n])\n  n -- number of futures in the array\n\nReturns:\n  A new pre-settled Future: ok with value 0 if all ok, else the first encountered error.\n\nSince: Phase T20-C"},
    {"future-any-n", "future-any-n -- return a future settled by the first successfully fulfilled future in the array.\n\nParameters:\n  futures -- pointer to an array of FutureCell* (ptr<void>[n])\n  n -- number of futures in the array\n\nReturns:\n  A new pre-settled Future: ok with the first fulfilled value, or failed if all reject.\n\nSince: Phase T20-C"},
    {"future-timeout-thread", "future-timeout-thread -- pthread body for future-timeout. INTERNAL."},
    {"future-with-timeout-tfn", "future-with-timeout-tfn -- pthread body for the timeout half of future-with-timeout. INTERNAL."},
    {"future-with-timeout-wfn", "future-with-timeout-wfn -- pthread body for the wait half of future-with-timeout. INTERNAL."},
    {"future-timeout", "future-timeout -- create a future that settles with error -1 after ms milliseconds.\n\nParameters:\n  ms -- timeout duration in milliseconds\n\nReturns:\n  A Future that will be settled (is_ok = false, exn = -1) after ms ms.\n\nExample:\n  (def t (future-timeout 5000))  ; rejects after 5 seconds\n\nSince: Phase T20-C"},
    {"future-with-timeout", "future-with-timeout -- race a future against a timeout of ms milliseconds.\n\nParameters:\n  f -- source Future pointer\n  ms -- timeout in milliseconds; on expiry the result is rejected with exn = -1\n\nReturns:\n  A new Future settled with f's outcome if f finishes first, otherwise rejected with -1.\n\nSince: Phase T20-C"},
    {"tur/future", "tur/future -- Future<T> and Promise<T> for asynchronous results.\n\nSince: Phase T20-C"},
    {"GVec", "GVec"},
    {"gvec-nil", "gvec-nil -- construct an empty GVec.\n\nReturns:\n  A (GVec int) value representing the empty list.\n\nExample:\n  (gvec-nil)  ; => GVNil\n\nSince: Phase G4"},
    {"gvec-cons", "gvec-cons -- prepend an integer element to a GVec.\n\nParameters:\n  x -- the integer element to prepend\n  v -- the existing (GVec int) to prepend onto\n\nReturns:\n  A new (GVec int) with x at the front.\n\nExample:\n  (gvec-cons 1 (gvec-nil))  ; => GVCons(1, GVNil)\n\nSince: Phase G4"},
    {"gvec-len", "gvec-len -- compute the length of a GVec.\n\nParameters:\n  v -- the (GVec int) to measure\n\nReturns:\n  The number of elements in v as an int.\n\nExample:\n  (gvec-len (gvec-cons 1 (gvec-cons 2 (gvec-nil))))  ; => 2\n\nSince: Phase G4"},
    {"gvec-sum", "gvec-sum -- sum all elements of a GVec.\n\nParameters:\n  v -- the (GVec int) to sum\n\nReturns:\n  The integer sum of all elements; 0 for an empty GVec.\n\nExample:\n  (gvec-sum (gvec-cons 1 (gvec-cons 2 (gvec-cons 3 (gvec-nil)))))  ; => 6\n\nSince: Phase G4"},
    {"gvec-head-or", "gvec-head-or -- return the first element or a default if empty.\n\nParameters:\n  dflt -- the int value to return when v is empty\n  v -- the (GVec int) to inspect\n\nReturns:\n  The head element of v if non-empty, otherwise dflt.\n\nExample:\n  (gvec-head-or 99 (gvec-nil))                      ; => 99\n    (gvec-head-or 99 (gvec-cons 5 (gvec-nil)))        ; => 5\n\nSince: Phase G4"},
    {"gvec-tail", "gvec-tail -- return all elements after the first.\n\nParameters:\n  v -- the (GVec int) to take the tail of\n\nReturns:\n  The tail (GVec int) of v; GVNil if v is empty.\n\nExample:\n  (gvec-tail (gvec-cons 1 (gvec-cons 2 (gvec-nil))))  ; => GVCons(2, GVNil)\n    (gvec-tail (gvec-nil))                                ; => GVNil\n\nSince: Phase G4"},
    {"__gvec-call-fn1", "__gvec-call-fn1 -- apply a ptr<void> closure to one int argument."},
    {"gvmap", "gvmap -- apply an int->int function to every element of a GVec.\n\nParameters:\n  f -- a curried int->int function (e.g. a partial application)\n  v -- the (GVec int) to transform\n\nReturns:\n  A new (GVec int) with f applied to each element.\n\nExample:\n  (defn mul [a :int b :int] :int (* a b))\n    (gvec-sum (gvmap (mul 2) (gvec-cons 1 (gvec-cons 2 (gvec-nil)))))  ; => 6\n\nSince: Phase G4"},
    {"gvzip-with", "gvzip-with -- combine two GVecs element-wise using a binary int->int->int function.\n\nParameters:\n  f -- a two-argument function (int, int) -> int\n  v1 -- the first (GVec int)\n  v2 -- the second (GVec int)\n\nReturns:\n  A (GVec int) of combined values; stops at the shorter input.\n\nExample:\n  (defn add [a :int b :int] :int (+ a b))\n    (gvec-sum (gvzip-with add\n                (gvec-cons 1 (gvec-cons 2 (gvec-nil)))\n                (gvec-cons 10 (gvec-cons 20 (gvec-nil)))))  ; => 33\n\nSince: Phase G4"},
    {"tur/gadt-vec", "tur/gadt-vec -- GVec GADT: a singly-linked list of ints with a phantom type parameter.\n\nSince: Phase G4"},
    {"gen-some?", "gen-some? -- test whether a gen-next result contains a value.\n\nParameters:\n  p -- void* pointer returned by gen-next\n\nReturns:\n  true if p is non-NULL (a value was yielded), false if the\n    generator was exhausted and gen-next returned NULL.\n\nExample:\n  (let [v (gen-next g)]\n      (when (gen-some? v) (println (gen-unwrap v))))\n\nSince: GF2"},
    {"gen-unwrap", "gen-unwrap -- extract the yielded value from a gen-next pointer.\n\nParameters:\n  p -- a non-NULL void* pointer returned by gen-next\n\nReturns:\n  The value that was yielded, at the generator's element type.\n\nExample:\n  (gen-unwrap (gen-next g))  ; => the yielded value\n\nSince: GF2"},
    {"gen-none", "gen-none -- return a null generator result representing no value.\n\nReturns:\n  NULL as :ptr<void>; test with gen-some? to distinguish from a real value.\n\nExample:\n  (gen-none)  ; => NULL\n\nSince: GF2"},
    {"gen-arr-new", "gen-arr-new -- allocate an empty array for use with gen-collect.\n\nReturns:\n  Opaque pointer to an empty array (len=0).\n\nExample:\n  (let [a (gen-arr-new)] ...)\n\nSince: GF2"},
    {"gen-arr-push!", "gen-arr-push! -- append val to the end of a gen-arr array.\n\nParameters:\n  a -- array pointer returned by gen-arr-new\n  val -- int64_t value to append\n\nExample:\n  (gen-arr-push! my-arr 42)\n\nSince: GF2"},
    {"gen-arr-len", "gen-arr-len -- return the number of elements in a gen-arr array.\n\nParameters:\n  a -- array pointer returned by gen-arr-new\n\nReturns:\n  Number of collected elements.\n\nExample:\n  (gen-arr-len my-arr)  ; => 3\n\nSince: GF2"},
    {"gen-arr-get", "gen-arr-get -- return the element at index i in a gen-arr array.\n\nParameters:\n  a -- array pointer returned by gen-arr-new\n  i -- zero-based index\n\nReturns:\n  The int64_t value stored at position i.\n\nExample:\n  (gen-arr-get my-arr 0)  ; => first element\n\nSince: GF2"},
    {"gen-collect", "gen-collect -- materialise all yielded values into a gen-arr array.\n\nParameters:\n  g -- a generator expression\n\nReturns:\n  A gen-arr-new array containing all int64_t values yielded by g.\n    Iterate with gen-arr-len and gen-arr-get.\n\nExample:\n  (let [arr (gen-collect g)]\n      (println (gen-arr-len arr)))\n\nSince: GF2"},
    {"gen-for-each", "gen-for-each -- call f with every value yielded by a generator.\n\nParameters:\n  f -- a one-argument callable applied to each yielded value\n  g -- a generator expression\n\nExample:\n  (gen-for-each println my-gen)\n\nSince: GF2"},
    {"gen-nth", "gen-nth -- return the nth (0-indexed) yielded value, or gen-none.\n\nParameters:\n  n -- zero-based index\n  g -- a generator expression\n\nReturns:\n  The raw void* pointer from gen-next at position n, or gen-none (NULL)\n    if the generator has fewer than n+1 values.\n    Test with gen-some? and extract with gen-unwrap.\n\nExample:\n  (let [v (gen-nth 2 my-gen)]\n      (when (gen-some? v) (println (gen-unwrap v))))\n\nSince: GF2"},
    {"yield*", "yield* -- re-yield every value from an inner generator.\n\nParameters:\n  inner -- a generator expression whose values are to be forwarded\n\nExample:\n  (gen []\n      (yield* inner-gen)\n      (yield 99))\n\nSince: GF2"},
    {"tur/gen", "tur/gen -- generator helpers and macros for consuming and composing generators.\n\nSince: Phase GF2"},
    {"Grid", "Grid -- parameterized 2D grid with element type A.\n\nSince: Phase TC2"},
    {"grid-new", "grid-new -- create a new zero-filled Grid[A].\n\nParameters:\n  width -- number of columns\n  height -- number of rows\n\nReturns:\n  A new Grid[A] with all elements initialized to 0.\n\nExample:\n  (grid-new 8 8)  ; => 8x8 grid\n\nSince: Phase TC2"},
    {"grid-get", "grid-get -- return the element at (x, y).\n\nParameters:\n  g -- Grid[A]\n  x -- column index\n  y -- row index\n\nReturns:\n  The element of type A at (x, y).\n\nExample:\n  (grid-get g 0 0)  ; => element at (0,0)\n\nSince: Phase TC2"},
    {"grid-set!", "grid-set! -- set the element at (x, y).\n\nParameters:\n  g -- Grid[A]\n  x -- column index\n  y -- row index\n  v -- new element value of type A\n\nExample:\n  (grid-set! g 0 0 1)\n\nSince: Phase TC2"},
    {"grid-width", "grid-width -- return the width of a Grid[A].\n\nParameters:\n  g -- Grid[A]\n\nReturns:\n  Width (number of columns).\n\nExample:\n  (grid-width g)  ; => 8\n\nSince: Phase TC2"},
    {"grid-height", "grid-height -- return the height of a Grid[A].\n\nParameters:\n  g -- Grid[A]\n\nReturns:\n  Height (number of rows).\n\nExample:\n  (grid-height g)  ; => 8\n\nSince: Phase TC2"},
    {"grid-free", "grid-free -- free a Grid[A] and its data buffer.\n\nParameters:\n  g -- Grid[A] to free\n\nExample:\n  (grid-free g)\n\nSince: Phase TC2"},
    {"tur/grid", "tur/grid -- typed Grid[A]: 2D row-major grid parameterized over element type A.\n\nSince: Phase TC2-A"},
    {"hamt/new", "hamt/new -- create a new empty persistent HAMT.\n\nReturns:\n  Pointer to a freshly allocated, empty HAMT with reference count 1.\n\nExample:\n  (hamt/new)  ; => <hamt ptr>\n\nSince: Phase P1"},
    {"hamt/free", "hamt/free -- decrement the reference count of a HAMT; free if it reaches zero.\n\nParameters:\n  m -- HAMT pointer\n\nExample:\n  (hamt/free my-map)\n\nSince: Phase P1"},
    {"hamt/retain", "hamt/retain -- increment the reference count of a HAMT and return it.\n\nParameters:\n  m -- HAMT pointer\n\nReturns:\n  The same HAMT pointer m, with its reference count incremented.\n\nExample:\n  (hamt/retain my-map)  ; => my-map\n\nSince: Phase P1"},
    {"hamt/set", "hamt/set -- insert or update a key/value pair; returns a new HAMT.\n\nParameters:\n  m -- source HAMT pointer\n  hash -- 64-bit hash of the key (passed as int64_t)\n  key -- key pointer\n  val -- value pointer\n\nReturns:\n  A new HAMT containing the inserted/updated entry. The original is unchanged.\n\nExample:\n  (hamt/set m (hamt/hash-str \"k\") k v)  ; => <new hamt ptr>\n\nSince: Phase P1"},
    {"hamt/del", "hamt/del -- delete a key from the HAMT; returns a new HAMT.\n\nParameters:\n  m -- source HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nReturns:\n  A new HAMT with the key removed. The original is unchanged.\n\nExample:\n  (hamt/del m (hamt/hash-str \"k\") k)  ; => <new hamt ptr>\n\nSince: Phase P1"},
    {"hamt/get", "hamt/get -- look up a key and return its value, or NULL if absent.\n\nParameters:\n  m -- HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nReturns:\n  The value pointer associated with key, or NULL if not found.\n\nExample:\n  (hamt/get m (hamt/hash-str \"k\") k)  ; => <value ptr or NULL>\n\nSince: Phase P1"},
    {"hamt/has?", "hamt/has? -- check whether a key exists in the HAMT.\n\nParameters:\n  m -- HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nReturns:\n  true if the key is present, false otherwise.\n\nExample:\n  (hamt/has? m (hamt/hash-str \"k\") k)  ; => true\n\nSince: Phase P1"},
    {"hamt/set-cstr", "hamt/set-cstr -- insert or update a string-keyed entry, compared by content.\n\nParameters:\n  m -- source HAMT pointer\n  key -- NUL-terminated string key\n  val -- value pointer\n\nReturns:\n  A new HAMT containing the inserted/updated entry. The original is unchanged.\n\nExample:\n  (hamt/set-cstr m \"name\" v)  ; => <new hamt ptr>\n\nSince: Phase P3"},
    {"hamt/del-cstr", "hamt/del-cstr -- delete a string key, compared by content; returns a new HAMT.\n\nParameters:\n  m -- source HAMT pointer\n  key -- NUL-terminated string key\n\nReturns:\n  A new HAMT with the key removed. The original is unchanged.\n\nExample:\n  (hamt/del-cstr m \"name\")  ; => <new hamt ptr>\n\nSince: Phase P3"},
    {"hamt/get-cstr", "hamt/get-cstr -- look up a string key by content; NULL if absent.\n\nParameters:\n  m -- HAMT pointer\n  key -- NUL-terminated string key\n\nReturns:\n  The value pointer associated with key, or NULL if not found.\n\nExample:\n  (hamt/get-cstr m \"name\")  ; => <value ptr or NULL>\n\nSince: Phase P3"},
    {"hamt/has-cstr?", "hamt/has-cstr? -- check whether a string key exists, compared by content.\n\nParameters:\n  m -- HAMT pointer\n  key -- NUL-terminated string key\n\nReturns:\n  true if the key is present, false otherwise.\n\nExample:\n  (hamt/has-cstr? m \"name\")  ; => true\n\nSince: Phase P3"},
    {"hamt/count", "hamt/count -- return the number of key/value pairs in the HAMT.\n\nParameters:\n  m -- HAMT pointer\n\nReturns:\n  Integer count of entries stored in the HAMT.\n\nExample:\n  (hamt/count my-map)  ; => 3\n\nSince: Phase P1"},
    {"hamt/merge", "hamt/merge -- merge two HAMTs; values from b win on key collision.\n\nParameters:\n  a -- first HAMT pointer\n  b -- second HAMT pointer (wins on collision)\n\nReturns:\n  A new HAMT containing all entries from a and b.\n\nExample:\n  (hamt/merge map-a map-b)  ; => <merged hamt ptr>\n\nSince: Phase P1"},
    {"hamt/hash-str", "hamt/hash-str -- compute an xxHash64 of a NUL-terminated C string.\n\nParameters:\n  str -- NUL-terminated C string to hash\n\nReturns:\n  64-bit hash value as int64_t.\n\nExample:\n  (hamt/hash-str \"hello\")  ; => <hash int>\n\nSince: Phase P1"},
    {"hamt/hash-ptr", "hamt/hash-ptr -- hash a pointer value directly (identity hash).\n\nParameters:\n  ptr -- pointer whose address is used as the hash input\n\nReturns:\n  64-bit hash value derived from the pointer address.\n\nExample:\n  (hamt/hash-ptr my-key)  ; => <hash int>\n\nSince: Phase P1"},
    {"hamt/iter-init", "hamt/iter-init -- initialize a stack-allocated iterator over a HAMT.\n\nParameters:\n  iter -- pre-allocated buffer of at least 64 bytes\n  m -- HAMT pointer to iterate over\n\nExample:\n  (hamt/iter-init iter-buf my-map)\n\nSince: Phase P1"},
    {"hamt/iter-free", "hamt/iter-free -- release any resources held by an iterator.\n\nParameters:\n  iter -- iterator buffer previously passed to hamt/iter-init\n\nExample:\n  (hamt/iter-free iter-buf)\n\nSince: Phase P1"},
    {"hamt/iter-next", "hamt/iter-next -- advance an iterator and write the next entry into out-pointers.\n\nParameters:\n  iter -- iterator buffer\n  hash-out -- pointer that receives the key hash\n  key-out -- pointer that receives the key pointer\n  val-out -- pointer that receives the value pointer\n\nReturns:\n  true if a pair was written; false when the iteration is exhausted.\n\nExample:\n  (hamt/iter-next iter hash-out key-out val-out)  ; => true/false\n\nSince: Phase P1"},
    {"hamt/iter-alloc", "hamt/iter-alloc -- allocate an iterator box for HAMT m.\n\nSince: Phase TCO-Eq-MapSet"},
    {"hamt/iter-destroy!", "hamt/iter-destroy! -- free an iterator box."},
    {"hamt/iter-advance!", "hamt/iter-advance! -- step to the next entry; returns false on exhaustion."},
    {"hamt/iter-cur-hash", "hamt/iter-cur-hash -- current entry's 64-bit hash (only valid after a"},
    {"hamt/iter-cur-key", "hamt/iter-cur-key -- current entry's key pointer."},
    {"hamt/iter-cur-val", "hamt/iter-cur-val -- current entry's value pointer."},
    {"hamt/keyeq", "hamt/keyeq -- read the stamped key comparator off a HAMT (NULL = identity)."},
    {"hamt/get-dynamic", "hamt/get-dynamic -- lookup using the supplied key comparator when"},
    {"hamt/has-dynamic?", "hamt/has-dynamic? -- presence check matching hamt/get-dynamic's semantics."},
    {"hamt/map", "hamt/map -- return a new HAMT with each value replaced by fn(val, ctx).\n\nParameters:\n  m -- source HAMT pointer\n  fn -- C function pointer (val :ptr, ctx :ptr) -> :ptr\n  ctx -- caller-supplied context passed to fn\n\nReturns:\n  A new HAMT with transformed values.\n\nExample:\n  (hamt/map my-map transform-fn ctx)  ; => <new hamt ptr>\n\nSince: Phase P1"},
    {"hamt/filter", "hamt/filter -- return a new HAMT keeping only entries where fn(key, val, ctx) is true.\n\nParameters:\n  m -- source HAMT pointer\n  fn -- C predicate pointer (key :ptr, val :ptr, ctx :ptr) -> bool\n  ctx -- caller-supplied context passed to fn\n\nReturns:\n  A new HAMT containing only the entries that passed the predicate.\n\nExample:\n  (hamt/filter my-map pred-fn ctx)  ; => <filtered hamt ptr>\n\nSince: Phase P1"},
    {"hamt/reduce", "hamt/reduce -- fold all entries into an accumulator using fn(acc, key, val, ctx).\n\nParameters:\n  m -- source HAMT pointer\n  fn -- C function pointer (acc :ptr, key :ptr, val :ptr, ctx :ptr) -> :ptr\n  init -- initial accumulator pointer\n  ctx -- caller-supplied context passed to fn\n\nReturns:\n  Final accumulator pointer after visiting all entries.\n\nExample:\n  (hamt/reduce my-map fold-fn init-acc ctx)  ; => <result ptr>\n\nSince: Phase P1"},
    {"hamt/merge-with", "hamt/merge-with -- merge two HAMTs, resolving key conflicts with fn(val_a, val_b, ctx).\n\nParameters:\n  a -- first HAMT pointer\n  b -- second HAMT pointer\n  fn -- C function pointer (val_a :ptr, val_b :ptr, ctx :ptr) -> :ptr\n  ctx -- caller-supplied context passed to fn\n\nReturns:\n  A new HAMT where colliding keys are resolved by fn instead of last-write-wins.\n\nExample:\n  (hamt/merge-with map-a map-b merge-fn ctx)  ; => <merged hamt ptr>\n\nSince: Phase P1"},
    {"hamt/show", "hamt/show -- return a debug string \"{k->v, ...}\" for the HAMT; caller must free.\n\nParameters:\n  m -- HAMT pointer\n\nReturns:\n  NUL-terminated C string; the caller is responsible for freeing it.\n\nExample:\n  (hamt/show my-map)  ; => \"{...}\"\n\nSince: Phase P1"},
    {"hamt/dump", "hamt/dump -- write the HAMT structure in DOT format to stderr for debugging.\n\nParameters:\n  m -- HAMT pointer to dump\n\nExample:\n  (hamt/dump my-map)\n\nSince: Phase P1"},
    {"hamt/transient", "hamt/transient -- fork a mutable transient from an immutable HAMT.\n\nParameters:\n  m -- immutable HAMT pointer to fork from\n\nReturns:\n  A transient (mutable) view that shares structure with m.\n\nExample:\n  (hamt/transient my-map)  ; => <transient ptr>\n\nSince: Phase P1"},
    {"hamt/transient-set!", "hamt/transient-set! -- mutate a transient by inserting or updating a key in place.\n\nParameters:\n  t -- transient HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n  val -- value pointer\n\nExample:\n  (hamt/transient-set! t (hamt/hash-str \"k\") k v)\n\nSince: Phase P1"},
    {"hamt/transient-del!", "hamt/transient-del! -- mutate a transient by deleting a key in place.\n\nParameters:\n  t -- transient HAMT pointer\n  hash -- 64-bit hash of the key\n  key -- key pointer\n\nExample:\n  (hamt/transient-del! t (hamt/hash-str \"k\") k)\n\nSince: Phase P1"},
    {"hamt/persistent!", "hamt/persistent! -- seal a transient into an immutable HAMT.\n\nParameters:\n  t -- transient HAMT pointer (must not be used after this call)\n\nReturns:\n  A new immutable HAMT containing all mutations applied to the transient.\n\nExample:\n  (hamt/persistent! t)  ; => <immutable hamt ptr>\n\nSince: Phase P1"},
    {"hamt/autolink-hint", "hamt/autolink-hint -- internal marker that triggers hamt.c compilation in tur build/run."},
    {"tur/hamt", "tur/hamt -- persistent hash-array-mapped trie (HAMT) map.\n\nSince: Phase P1"},
    {"hash-int", "hash-int -- hash a 64-bit signed integer via splitmix64 finalizer.\n\nParameters:\n  n -- value to hash\n\nReturns:\n  A 64-bit hash of n as :int.\n\nExample:\n  (hash-int 42)  ; => some stable 64-bit integer\n\nSince: Phase C"},
    {"hash-int8", "hash-int8 -- hash an int8; equals (hash-int (as int n)) via sign-extension.\n\nParameters:\n  n -- int8 value to hash\n\nReturns:\n  Same as (hash-int (as int n)).\n\nExample:\n  (= (hash-int8 42i8) (hash-int 42))  ; => true\n\nSince: Phase C"},
    {"hash-int16", "hash-int16 -- hash an int16; equals (hash-int (as int n)) via sign-extension.\n\nParameters:\n  n -- int16 value to hash\n\nReturns:\n  Same as (hash-int (as int n)).\n\nExample:\n  (= (hash-int16 1000i16) (hash-int 1000))  ; => true\n\nSince: Phase C"},
    {"hash-int32", "hash-int32 -- hash an int32; equals (hash-int (as int n)) via sign-extension.\n\nParameters:\n  n -- int32 value to hash\n\nReturns:\n  Same as (hash-int (as int n)).\n\nExample:\n  (= (hash-int32 100000i32) (hash-int 100000))  ; => true\n\nSince: Phase C"},
    {"hash-int64", "hash-int64 -- hash an int64; identical to hash-int.\n\nParameters:\n  n -- int64 value to hash\n\nReturns:\n  Same as (hash-int (as int n)).\n\nExample:\n  (= (hash-int64 42i64) (hash-int 42))  ; => true\n\nSince: Phase C"},
    {"hash-uint8", "hash-uint8 -- hash a uint8 via zero-extension to :int.\n\nParameters:\n  n -- uint8 value to hash\n\nReturns:\n  Same as (hash-int (as int n)) where (as int n) zero-extends.\n\nExample:\n  (not= (hash-uint8 255u8) (hash-int -1))  ; => true\n\nSince: Phase C"},
    {"hash-uint16", "hash-uint16 -- hash a uint16 via zero-extension to :int.\n\nParameters:\n  n -- uint16 value to hash\n\nReturns:\n  Same as (hash-int (as int n)) where (as int n) zero-extends.\n\nExample:\n  (= (hash-uint16 1000u16) (hash-int 1000))  ; => true\n\nSince: Phase C"},
    {"hash-uint32", "hash-uint32 -- hash a uint32 via zero-extension to :int.\n\nParameters:\n  n -- uint32 value to hash\n\nReturns:\n  Same as (hash-int (as int n)) where (as int n) zero-extends.\n\nExample:\n  (= (hash-uint32 1000u32) (hash-int 1000))  ; => true\n\nSince: Phase C"},
    {"hash-uint64", "hash-uint64 -- hash a uint64 by reinterpreting as :int then hashing.\n\nParameters:\n  n -- uint64 value to hash\n\nReturns:\n  Hash of the 64-bit bit pattern of n.\n\nExample:\n  (hash-uint64 0u64)  ; => same as (hash-int 0)\n\nSince: Phase C"},
    {"tur/hash", "tur/hash -- canonical integer hashing across numeric widths.\n\nSince: Phase C"},
    {"httpd-mw-compress-step", "httpd-mw-compress-step -- internal: post-processing gzip pass.\n\nSince: Phase H8 (M6)"},
    {"mw-compress-with", "mw-compress-with -- gzip the response body when the client accepts gzip.\n\nParameters:\n  min-bytes -- minimum response body size to compress (typical: 256)\n  next -- downstream handler closure (fat-closure :int)\n\nReturns:\n  A wrapped handler closure (:ptr<void>) suitable for httpd-new /\n    compose-middleware.\n\nExample:\n  (compose-middleware base mw-log (mw-compress-with 256))\n\nSince: Phase H8 (M6)"},
    {"mw-compress", "mw-compress -- mw-compress-with default 256-byte threshold.\n\nExample:\n  (compose-middleware base mw-log mw-compress)\n\nSince: Phase H8 (M6)"},
    {"tur/httpd-compress", "stdlib/httpd-compress.tur -- gzip response compression middleware.\n\nSince: Phase H8 (M6)"},
    {"httpd-req-cookie-raw", "httpd-req-cookie-raw -- internal: cookie value as a fresh cstr, or NULL."},
    {"httpd-req-cookie-opt", "httpd-req-cookie-opt -- read a cookie value as an optional owned String.\n\nParameters:\n  conn -- connection handle from the worker\n  name -- cookie name to look up (case-sensitive, per RFC 6265)\n\nReturns:\n  (Option String) -- some owned value on a match, none on any miss.\n\nExample:\n  (let [o (httpd-req-cookie-opt c \"session\")]\n      (if (some? o) (string/to-cstr (unwrap o)) \"<no session>\"))\n\nSince: v2"},
    {"httpd-req-form-raw", "httpd-req-form-raw -- internal: decoded form value as a fresh cstr, or NULL."},
    {"httpd-req-form-opt", "httpd-req-form-opt -- look up a URL-encoded form field as an optional String.\n\nParameters:\n  conn -- connection handle from the worker\n  field -- form field name (case-sensitive, plain ASCII)\n\nReturns:\n  (Option String) -- some decoded owned value on a match, none on any miss.\n\nExample:\n  (let [o (httpd-req-form-opt c \"username\")]\n      (if (some? o) (string/to-cstr (unwrap o)) \"<anonymous>\"))\n\nSince: v2"},
    {"cstr-null?", "cstr-null? -- internal: true iff the cstr pointer is NULL (a miss sentinel)."},
    {"tur/httpd-string", "tur/httpd-string -- optional owned-String accessors for stdlib/httpd.\n\nSince: v2 (string-owned-builders-and-optional-accessors-plan, Part 2)"},
    {"httpd/autolink-hint", "httpd/autolink-hint -- ensure programs using httpd link against libturi + pthreads."},
    {"httpd-register-tls-impl", "httpd-register-tls-impl -- install TLS function pointers into the H5 hook table.\n\nParameters:\n  wrap-fd -- (int64_t)(intptr_t)&tls-wrap-fd\n  handshake -- (int64_t)(intptr_t)&tls-handshake\n  read-fn -- (int64_t)(intptr_t)&tls-read\n  write-fn -- (int64_t)(intptr_t)&tls-write\n  shutdown -- (int64_t)(intptr_t)&tls-shutdown\n  free-fn -- (int64_t)(intptr_t)&tls-free\n\nSince: Phase H5"},
    {"httpd-set-max-body!", "httpd-set-max-body! -- cap the request body size the server will read.\n\nParameters:\n  n -- the new cap in bytes (clamped to [0, 2^31 - 2])\n\nReturns:\n  The previous cap.\n\nExample:\n  (httpd-set-max-body! (* 64 1048576))   ; accept uploads up to 64 MiB\n\nSince: security-audit-plan WP4 (M-4)"},
    {"httpd-set-bind-any!", "httpd-set-bind-any! -- listen on every interface instead of loopback.\n\nParameters:\n  on -- true to bind every interface, false for loopback\n\nReturns:\n  The previous setting.\n\nExample:\n  (httpd-set-bind-any! true)\n    (httpd-new 8080 handler)   ; reachable on every interface\n\nSince: security-audit-plan WP4 (M-4)"},
    {"httpd-set-bind-addr!", "httpd-set-bind-addr! -- listen on one address, IPv4 or IPv6.\n\nParameters:\n  addr -- a numeric IPv4 or IPv6 address, or \"\" to clear\n\nReturns:\n  true if the address was accepted (or cleared), false if it did not parse.\n\nExample:\n  (httpd-set-bind-addr! \"::1\")\n    (httpd-new 8080 handler)   ; IPv6 loopback only\n\nSince: 2026-10-03 (security-audit-plan WP4 residual)"},
    {"httpd-bind-addr", "httpd-bind-addr -- internal: the IPv4 address (host order) to listen on."},
    {"httpd-listen-socket", "httpd-listen-socket -- internal: a bound, listening, non-blocking socket for"},
    {"httpd-status-text", "httpd-status-text -- internal: the reason phrase for a status code."},
    {"httpd-error-response", "httpd-error-response -- internal: a complete close-the-connection response."},
    {"httpd-parse-head", "httpd-parse-head -- internal: parse a request head that is already in memory."},
    {"httpd-resp-head", "httpd-resp-head -- internal: build the response status line + header block."},
    {"httpd-conn-release", "httpd-conn-release -- internal: free everything a request attached to conn."},
    {"httpd-handle", "httpd-handle -- internal: serve one or more HTTP requests on fd, then\n\nSince: Phase H1 (TLS path: Phase H5)"},
    {"httpd-worker", "httpd-worker -- internal: worker thread function.\n\nSince: Phase H3"},
    {"httpd-accept-cb", "httpd-accept-cb -- internal reactor READ callback for the listen fd.\n\nSince: Phase H2"},
    {"httpd-new-pool", "httpd-new-pool -- create an httpd instance with a configurable worker count.\n\nParameters:\n  port -- TCP port to listen on (0 = kernel-assigned)\n  workers -- number of worker threads in the pool (must be > 0)\n  handler -- fat closure: (fn [conn :ptr<void>] :nil)\n\nReturns:\n  ptr<void> -- opaque Httpd handle, or nil on error\n\nSince: Phase H3"},
    {"httpd-new-pool-with-limit", "httpd-new-pool-with-limit -- httpd-new-pool with a pending-connection cap.\n\nParameters:\n  port -- TCP port to listen on (0 = kernel-assigned)\n  workers -- number of worker threads in the pool (must be > 0)\n  handler -- fat closure: (fn [conn :ptr<void>] :nil)\n  max-pending -- queued-connection cap (0 = unlimited; httpd-new-pool\n   -- uses 512)\n\nReturns:\n  ptr<void> -- opaque Httpd handle, or nil on error\n\nExample:\n  (let [h (httpd-new-pool-with-limit 0 4 handler 64)]\n      (httpd-run h)\n      (httpd-free h))\n\nSince: 2026-10-03 (security-audit-plan WP4 residual)"},
    {"httpd-new", "httpd-new -- create a new httpd instance with the default worker pool size (4).\n\nParameters:\n  port -- TCP port to listen on (0 = kernel-assigned)\n  handler -- fat closure: (fn [conn :ptr<void>] :nil)\n\nReturns:\n  ptr<void> -- opaque Httpd handle, or nil on error\n\nExample:\n  (let [h (httpd-new 0 (fn [conn :ptr<void>] :nil\n                           (httpd-resp-status! conn 200)\n                           (httpd-resp-body! conn \"OK\")))]\n      (httpd-run h)\n      (httpd-free h))\n\nSince: Phase H1"},
    {"httpd-new-tls", "httpd-new-tls -- create an httpd instance with TLS termination.\n\nParameters:\n  port -- TCP port to listen on (0 = kernel-assigned)\n  workers -- number of worker threads (must be > 0)\n  handler -- fat closure: (fn [conn :ptr<void>] :nil)\n  ctx -- TLS context handle from tls-ctx-new with cert + key loaded\n\nReturns:\n  ptr<void> -- opaque Httpd handle, or nil if ctx is 0 or TLS ops\n    have not been registered.\n\nExample:\n  (tls-httpd-init)\n    (let [ctx (tls-ctx-new)]\n      (tls-ctx-load-cert-pem ctx \"cert.pem\")\n      (tls-ctx-load-key-pem  ctx \"key.pem\")\n      (let [h (httpd-new-tls 8443 4 my-handler ctx)]\n        (httpd-run h)\n        (httpd-free h)\n        (tls-ctx-free ctx)))\n\nSince: Phase H5"},
    {"httpd-port", "httpd-port -- return the port the server is listening on.\n\nParameters:\n  h -- httpd handle returned by httpd-new\n\nReturns:\n  int -- the actual listening port, or -1 on error\n\nSince: Phase H1"},
    {"httpd-run", "httpd-run -- run the listener reactor until httpd-stop is called.\n\nSince: Phase H1"},
    {"httpd-stop", "httpd-stop -- signal the listener to stop accepting new connections.\n\nSince: Phase H1"},
    {"httpd-free", "httpd-free -- free all resources after httpd-run returns.\n\nSince: Phase H1"},
    {"httpd-req-method", "httpd-req-method -- return the HTTP method from the parsed request.\n\nSince: Phase H1"},
    {"httpd-req-path", "httpd-req-path -- return the request-target path from the parsed request.\n\nSince: Phase H1"},
    {"httpd-req-version", "httpd-req-version -- return the HTTP version from the parsed request line.\n\nReturns:\n  cstr -- \"HTTP/1.0\", \"HTTP/1.1\", etc., or \"\" if unparsed\n\nSince: Phase H4"},
    {"httpd-req-body", "httpd-req-body -- return the request body (NUL-terminated copy).\n\nReturns:\n  cstr -- the request body bytes (NUL-terminated)\n\nSince: Phase H4"},
    {"httpd-req-body-len", "httpd-req-body-len -- return the request body length in bytes.\n\nReturns:\n  int -- number of bytes in the body (0 if no body)\n\nSince: Phase H4"},
    {"httpd-resp-status-get", "httpd-resp-status-get -- return the currently-set response status code.\n\nSince: Phase H6"},
    {"httpd-resp-status!", "httpd-resp-status! -- set the HTTP response status code.\n\nSince: Phase H1"},
    {"httpd-resp-body!", "httpd-resp-body! -- set the HTTP response body (copies the string).\n\nSince: Phase H1"},
    {"httpd-resp-body-bytes!", "httpd-resp-body-bytes! -- binary-safe response body setter.\n\nParameters:\n  conn -- connection handle from the worker\n  bytes -- pointer to raw payload (may contain NUL bytes)\n  len -- byte count to copy\n\nExample:\n  (httpd-resp-body-bytes! c gzip-data gzip-len)\n\nSince: Phase H8 (M6)"},
    {"httpd-req-header", "httpd-req-header -- look up a request header by name (case-insensitive).\n\nParameters:\n  conn -- connection handle from the worker\n  name -- header name to look up (case-insensitive)\n\nReturns:\n  The header value as a cstr (pointer into per-request storage; valid\n    only for the duration of the handler call). Empty string if absent.\n\nExample:\n  (let [ua (httpd-req-header c \"User-Agent\")] ...)\n\nSince: Phase H8 (M0)"},
    {"httpd-req-header?", "httpd-req-header? -- presence test for a request header.\n\nParameters:\n  conn -- connection handle from the worker\n  name -- header name (case-insensitive)\n\nReturns:\n  1 if present, 0 otherwise.\n\nExample:\n  (when (= 1 (httpd-req-header? c \"Authorization\")) ...)\n\nSince: Phase H8 (M0)"},
    {"httpd-resp-header!", "httpd-resp-header! -- set (or replace) a response header.\n\nParameters:\n  conn -- connection handle from the worker\n  name -- header name (case-insensitive on the dedup check)\n  value -- header value\n\nExample:\n  (httpd-resp-header! c \"Content-Type\" \"application/json\")\n\nSince: Phase H8 (M0)"},
    {"httpd-resp-header-add!", "httpd-resp-header-add! -- append a response header without de-duplication.\n\nParameters:\n  conn -- connection handle from the worker\n  name -- header name\n  value -- header value\n\nExample:\n  (httpd-resp-header-add! c \"Set-Cookie\" \"session=abc; Path=/\")\n    (httpd-resp-header-add! c \"Set-Cookie\" \"csrf=xyz; Path=/\")\n\nSince: Phase H8 (M0)"},
    {"httpd-req-cookie", "httpd-req-cookie -- read a single cookie value from the Cookie: header.\n\nParameters:\n  conn -- connection handle from the worker\n  name -- cookie name to look up (case-sensitive)\n\nReturns:\n  The cookie's value as a heap-allocated cstr, OR the empty string \"\"\n    if the header is absent or the cookie is not present.\n  \n    NOTE: when the cookie IS found, the returned cstr is a fresh malloc\n    that the runtime treats as per-call ownership; do not free.  When\n    absent the returned pointer is a literal \"\" and also need not be\n    freed.\n\nExample:\n  (let [sid (httpd-req-cookie c \"session\")]\n      (if (= (cstr-len sid) 0) ...))\n\nSince: Phase H8 (M2)"},
    {"CookieOpts", "CookieOpts -- fully-specified Set-Cookie attributes.\n\nSince: Phase H8 (M2)"},
    {"cookie", "cookie -- construct a CookieOpts with sensible defaults.\n\nParameters:\n  name -- cookie name\n  value -- cookie value\n\nExample:\n  (httpd-set-cookie! c (cookie \"session\" \"abc123\"))\n\nSince: Phase H8 (M2)"},
    {"cookie-full", "cookie-full -- construct a CookieOpts with every attribute explicit.\n\nExample:\n  (httpd-set-cookie! c (cookie-full \"tracking\" \"t1\" \"/api\" \"example.com\"\n                                      3600 1 0 \"None\"))\n\nSince: Phase H8 (M2)"},
    {"httpd-set-cookie!", "httpd-set-cookie! -- emit a Set-Cookie response header from a CookieOpts.\n\nParameters:\n  conn -- connection handle from the worker\n  opts -- CookieOpts value (typically built by `cookie` or `cookie-full`)\n\nExample:\n  (httpd-set-cookie! c (cookie \"session\" \"abc123\"))\n\nSince: Phase H8 (M2); requires the DS1 fix in"},
    {"httpd-req-form", "httpd-req-form -- look up a single URL-encoded form field by name.\n\nParameters:\n  conn -- connection handle from the worker\n  field -- form field name (case-sensitive, plain ASCII)\n\nReturns:\n  The decoded value as a heap-allocated cstr (per-call ownership;\n    do not free explicitly -- the runtime drops it after the handler\n    returns).  Empty string \"\" when the field is absent or the body\n    is empty.\n\nExample:\n  (let [user (httpd-req-form c \"username\")\n          pw   (httpd-req-form c \"password\")] ...)\n\nSince: Phase H8 (M3)"},
    {"httpd-req-json", "httpd-req-json -- lazily parse the request body as JSON.\n\nParameters:\n  conn -- connection handle from the worker\n\nReturns:\n  The parsed JSON node tree as an :int (the json stdlib carrier), or\n    0 when there is no body / parse failed.\n\nExample:\n  (let [doc (httpd-req-json c)\n          nm  (json/get-string (json/get! doc \"name\"))]\n      (httpd-resp-body! c nm))\n\nSince: Phase H8 (M3)"},
    {"mw-json-body", "mw-json-body -- pre-parse the JSON body, 400 on failure.\n\nExample:\n  (let [composed (compose-middleware base mw-json-body)]\n      (httpd-new 0 composed))\n\nSince: Phase H8 (M3)"},
    {"httpd-mw-json-body-precheck", "httpd-mw-json-body-precheck -- internal: returns 1 when the body is"},
    {"CorsOpts", "CorsOpts -- mw-cors configuration.\n\nSince: Phase H8 (M4)"},
    {"default-cors-opts", "default-cors-opts -- permissive defaults suitable for development.\n\nSince: Phase H8 (M4)"},
    {"httpd-mw-cors-is-preflight", "httpd-mw-cors-is-preflight -- internal: 1 iff this is a CORS preflight."},
    {"httpd-mw-cors-emit-preflight", "httpd-mw-cors-emit-preflight -- internal: write the preflight response."},
    {"httpd-mw-cors-decorate", "httpd-mw-cors-decorate -- internal: decorate a normal-flow response."},
    {"httpd-cors-own-str", "mw-cors-with -- CORS middleware factory (positional args).\n\nExample:\n  (compose-middleware base\n      (mw-cors-with \"https://app.example.com\"\n                    \"GET, POST, OPTIONS\"\n                    \"Content-Type, Authorization\"\n                    \"\" 1 60))\n\nSince: Phase H8 (M4)"},
    {"mw-cors-with", "mw-cors-with"},
    {"mw-cors", "mw-cors -- CORS middleware with permissive defaults.\n\nExample:\n  (compose-middleware base mw-cors)\n\nSince: Phase H8 (M4)"},
    {"mw-cors-opts", "mw-cors-opts -- CORS middleware factory configured by a CorsOpts struct.\n\nParameters:\n  opts -- a CorsOpts value (see `default-cors-opts`)\n  next -- downstream handler closure (fat-closure :int)\n\nReturns:\n  A wrapped handler closure (:ptr<void>) suitable for httpd-new /\n    compose-middleware.\n\nExample:\n  (let [opts     (default-cors-opts)\n          composed (compose-middleware base (mw-cors-opts opts))]\n      (httpd-new 0 composed))\n\nSince: Phase H8 (M4)"},
    {"cstr-eq-const-time", "cstr-eq-const-time -- length-then-constant-time XOR cstring compare.\n\nSince: Phase H8 (M5)"},
    {"httpd-mw-basic-auth-check", "httpd-mw-basic-auth-check -- internal: decode + dispatch the verifier."},
    {"httpd-mw-basic-auth-challenge", "httpd-mw-basic-auth-challenge -- internal: emit 401 + WWW-Authenticate."},
    {"mw-basic-auth", "mw-basic-auth -- HTTP Basic Auth middleware factory.\n\nExample:\n  ;; Compare BOTH fields every time and combine the results: returning\n    ;; early on a wrong username tells a caller which usernames exist.\n    (let [verify (fn [u :cstr p :cstr] :int   ; captures nothing -- fine\n                   (let [u-ok (cstr-eq-const-time u \"admin\")\n                         p-ok (cstr-eq-const-time p \"s3cret\")]\n                     (* u-ok p-ok)))\n          composed (compose-middleware base (mw-basic-auth \"app\" verify))]\n      (httpd-new 0 composed))\n\nSince: Phase H8 (M5)"},
    {"httpd-req-multipart-parse", "httpd-req-multipart-parse -- internal: parse the body on first access."},
    {"httpd-req-file", "httpd-req-file -- look up a multipart part by form field name.\n\nExample:\n  (let [p (httpd-req-file c \"upload\")]\n      (when (not= 0 p)\n        (println (httpd-part-filename p))\n        (println (int->cstr (httpd-part-data-len p)))))\n\nSince: Phase H8 (M7)"},
    {"httpd-part-name", "httpd-part-name -- form field name of a part (or \"\" if missing)."},
    {"httpd-part-filename", "httpd-part-filename -- file name attribute (or \"\" for non-file parts)."},
    {"httpd-part-content-type", "httpd-part-content-type -- per-part Content-Type (or \"\" if absent)."},
    {"httpd-part-data", "httpd-part-data -- raw byte buffer (binary-safe, may contain NUL)."},
    {"httpd-part-data-len", "httpd-part-data-len -- byte count of the part's content."},
    {"httpd-async-fiber-body", "httpd-async-fiber-body -- internal: per-request fiber entry point."},
    {"httpd-async-accept-cb", "httpd-async-accept-cb -- internal: reactor READ callback on the listen fd."},
    {"httpd-new-async-with-limit", "httpd-new-async -- create an async (fiber-per-request) httpd handle.\n\nParameters:\n  port -- TCP port to listen on (0 = kernel-assigned)\n  handler -- fat closure: (fn [conn :ptr<void>] :nil)\n\nReturns:\n  ptr<void> -- HttpdAsync handle (or NULL on error)\n  \n  Lifecycle:\n    (let [h (httpd-new-async 0 handler)]\n      (httpd-run-async h)         ;; blocks until httpd-stop-async fires\n      (httpd-async-free h))\n\nSince: Phase H8 (A0+A1)"},
    {"httpd-new-async", "httpd-new-async -- create an async server capped at 512 in-flight requests.\n\nSince: Phase H8 (A0+A1)"},
    {"httpd-run-async", "httpd-run-async -- drive the async server until stopped.\n\nSince: Phase H8 (A0+A1)"},
    {"httpd-stop-async", "httpd-stop-async -- request a graceful shutdown of the async server.\n\nSince: Phase H8 (A0+A1)"},
    {"httpd-async-free", "httpd-async-free -- tear down an async server handle.\n\nSince: Phase H8 (A0+A1)"},
    {"httpd-async-port", "httpd-async-port -- read the bound TCP port on an async server.\n\nSince: Phase H8 (A0+A1)"},
    {"httpd-await-readable", "httpd-await-readable -- suspend the current fiber until conn fd is readable.\n\nSince: Phase H8 (A0)"},
    {"httpd-await-writable", "httpd-await-writable -- suspend until conn fd is writable."},
    {"httpd-await-timer", "httpd-await-timer -- suspend the current fiber for ms milliseconds.\n\nSince: Phase H8 (A0)"},
    {"router-new", "router-new -- create an empty router.\n\nReturns:\n  ptr<void> -- opaque Router handle\n\nSince: Phase H6"},
    {"router-add", "router-add -- register a route with the given method, pattern, and handler.\n\nParameters:\n  r -- router handle\n  method -- HTTP method (\"GET\", \"POST\", etc.)\n  pattern -- path pattern (e.g. \"/users/:id\")\n  handler -- fat closure: (fn [conn :ptr<void>] :nil)\n\nSince: Phase H6"},
    {"router-free", "router-free -- free a router and all registered routes.\n\nParameters:\n  r -- router handle\n\nSince: Phase H6"},
    {"router-dispatch", "router-dispatch -- match the current request against the router's table.\n\nParameters:\n  r -- router handle\n  conn -- connection handle (the one passed to the httpd handler)\n\nSince: Phase H6"},
    {"httpd-param", "httpd-param -- read a captured route parameter set by router-dispatch.\n\nParameters:\n  conn -- connection handle passed to the route handler\n  name -- parameter name (e.g. \"id\" for a \":id\" pattern segment)\n\nReturns:\n  cstr -- the captured value, or \"\" if no parameter with that name\n\nExample:\n  ;; pattern \"/users/:id\" matched against \"/users/42\"\n    (httpd-param conn \"id\")  ; => \"42\"\n\nSince: Phase H6"},
    {"httpd-call", "httpd-call -- invoke a Turmeric handler closure on a connection.\n\nParameters:\n  handler -- handler closure value (int)\n  conn -- connection handle from the worker\n\nSince: Phase H7"},
    {"defroute", "defroute -- macro sugar for (router-add router method pattern handler).\n\nExample:\n  (defroute r \"GET\" \"/\" (fn [c :ptr<void>] :nil ...))\n\nSince: Phase H6"},
    {"httpd-mw-mono-ms", "httpd-mw-mono-ms -- monotonic clock helper (milliseconds). Internal."},
    {"httpd-mw-log-emit", "httpd-mw-log-emit -- emit one log line for a completed request. Internal."},
    {"mw-log", "mw-log -- request logging middleware (stdout).\n\nParameters:\n  next -- downstream handler closure (fat-closure :int)\n\nReturns:\n  A wrapped handler closure (:int) with the same calling convention as\n    handlers passed to httpd-new / httpd-new-pool.\n\nExample:\n  (let [base     (fn [c :ptr<void>] :nil\n                     (httpd-resp-status! c 200)\n                     (httpd-resp-body!   c \"hi\"))\n          composed (mw-log base)]\n      (httpd-new 0 composed))\n\nSince: Phase H8 (M1)"},
    {"compose-middleware", "compose-middleware -- wrap a base handler with multiple middlewares.\n\nParameters:\n  base -- base handler closure (:int)\n  mws -- variadic middleware closures (each `(fn [next :int] :int)`),\n   -- applied right-to-left so the leftmost ends up outermost.\n\nReturns:\n  The fully-wrapped handler closure (:int).\n\nExample:\n  (let [composed (compose-middleware base mw-log)]\n      (httpd-new 0 composed))\n  \n    ;; Multiple middlewares (mw-log is outermost):\n    (let [composed (compose-middleware base mw-log mw-cors mw-auth)]\n      (httpd-new 0 composed))\n\nSince: Phase H8 (M8 core)"},
    {"Handler", "[affine] Handler -- an owned, composed request-handler onion (the result of\n\nSince: automatic R3a (closure-drop-glue)"},
    {"httpd-handler-drop", "httpd-handler-drop -- internal: reclaim a composed Handler onion.\n\nSince: automatic R3a (closure-drop-glue)"},
    {"Drop", "Drop [Handler] -- reclaim the onion when a bound Handler dies unmoved/unborrowed."},
    {"httpd-handler-carrier", "httpd-handler-carrier -- CONSUME a Handler, yielding its raw int64 carrier for\n\nParameters:\n  h -- the composed Handler onion (consumed).\n\nReturns:\n  The raw int64 fat-closure carrier.\n\nExample:\n  (let [composed (compose-middleware-of base mw1 mw2)]\n      (httpd-new-pool 0 1 (httpd-handler-carrier composed)))\n\nSince: automatic R3a (closure-drop-glue)"},
    {"ClosureChain", "[affine] ClosureChain -- an owned runtime-built middleware chain: a cons list whose\n\nSince: automatic R3a (closure-drop-glue)"},
    {"httpd-chain-drop", "httpd-chain-drop -- internal: reclaim a ClosureChain (drop each head factory\n\nSince: automatic R3a (closure-drop-glue)"},
    {"httpd-mw-apply", "httpd-mw-apply -- internal: apply one fat-closure middleware to a handler."},
    {"httpd-mw-fold", "httpd-mw-fold -- internal: right-fold a cons-list of fat-closure"},
    {"httpd-mw-free-spine", "httpd-mw-free-spine -- internal: free the cons-cell spine of a variadic"},
    {"httpd-mw-drop", "httpd-mw-drop -- SUPERSEDED: reclaim a raw-`:int` composed handler onion.\n\nParameters:\n  handler -- the composed handler closure (:int); 0 is a no-op.\n\nReturns:\n  Example (legacy -- prefer the Handler auto-drop):\n    (let [composed (:: (httpd-mw-fold base chain) :Handler)]\n      (httpd-call (:: composed :int) conn))   ; composed auto-drops at scope exit\n\nSince: R3a; superseded by Handler auto-drop (automatic R3a)."},
    {"httpd-mw-free-chain", "httpd-mw-free-chain -- SUPERSEDED: free a runtime-built middleware cons list\n\nParameters:\n  mws -- the middleware cons list (:int); 0 is a no-op.\n\nReturns:\n  Example (legacy -- prefer the ClosureChain auto-drop):\n    (let [chain    (:: (build-chain 70 (tnil)) :ClosureChain)\n          composed (:: (httpd-mw-fold base (:: chain :int)) :Handler)]\n      (httpd-call (:: composed :int) conn))  ; composed + chain auto-drop at scope exit\n\nSince: R3a; superseded by ClosureChain auto-drop (automatic R3a half 2)."},
    {"compose-middleware-of", "compose-middleware-of -- runtime variadic form of compose-middleware.\n\nParameters:\n  base -- base handler, a `(fn [ptr<void>] nil)` closure\n  mws -- variadic fat-closure middlewares; type variable A unifies\n   -- to whatever closure type the call site uses.\n\nReturns:\n  The fully-wrapped handler onion as an owned `Handler` -- bind it and the\n    compiler auto-drops it at scope exit (no explicit `httpd-mw-drop`), or hand\n    it to a server via `httpd-handler-carrier` (which moves it, suppressing the\n    auto-drop so the server owns it).\n\nSince: Phase H8 (M8 core); requires the V1 cast fix in"},
    {"httpd-mw-content-length", "httpd-mw-content-length -- internal: read Content-Length as int64, or -1."},
    {"mw-body-size", "mw-body-size -- reject requests with Content-Length > max-bytes with 413.\n\nParameters:\n  max-bytes -- maximum accepted Content-Length in bytes (>= 0)\n  next -- downstream handler closure (fat-closure :int)\n\nReturns:\n  A wrapped handler closure (:ptr<void>) suitable for httpd-new /\n    compose-middleware.\n\nExample:\n  (let [composed (mw-body-size 1048576 base)]  ; 1 MiB cap\n      (httpd-new 0 composed))\n\nSince: Phase H8 (MW1)"},
    {"httpd-set-attr!", "httpd-set-attr! -- attach a key/value pair to the current request.\n\nParameters:\n  conn -- httpd connection pointer\n  key -- attribute name (cstr)\n  val -- attribute value (cstr)\n\nExample:\n  (httpd-set-attr! c \"user\" \"alice\")\n\nSince: Phase H8 (MW2)"},
    {"httpd-req-attr", "httpd-req-attr -- retrieve a previously set request attribute.\n\nParameters:\n  conn -- httpd connection pointer\n  key -- attribute name (cstr, case-sensitive)\n\nReturns:\n  The attribute value as a cstr, or \"\" when absent.\n\nExample:\n  (let [u (httpd-req-attr c \"user\")] ...)\n\nSince: Phase H8 (MW2)"},
    {"httpd-req-remote-ip", "httpd-req-remote-ip -- return the client's IP address as a cstr.\n\nParameters:\n  conn -- httpd connection pointer\n\nReturns:\n  The client IP as a cstr, or \"\" on failure.\n\nExample:\n  (let [ip (httpd-req-remote-ip c)] ...)\n\nSince: Phase H8 (MW2)"},
    {"RateLimitOpts", "RateLimitOpts -- mw-rate-limit configuration.\n\nSince: Phase H8 (MW2)"},
    {"httpd-mw-ratelimit-new", "httpd-mw-ratelimit-new -- internal: allocate a fresh RL state struct."},
    {"httpd-mw-ratelimit-check", "httpd-mw-ratelimit-check -- internal: bump the counter for ip; return"},
    {"httpd-mw-ratelimit-emit-429", "httpd-mw-ratelimit-emit-429 -- internal: write the 429 response."},
    {"mw-rate-limit", "mw-rate-limit -- sliding-window IP-based rate limiter middleware.\n\nParameters:\n  opts -- RateLimitOpts\n  next -- downstream handler closure (fat-closure :int)\n\nReturns:\n  A wrapped handler closure (:ptr<void>) suitable for httpd-new /\n    compose-middleware.\n\nExample:\n  (let [composed (mw-rate-limit (make-struct RateLimitOpts 60 60) base)]\n      (httpd-new 0 composed))\n\nSince: Phase H8 (MW2)"},
    {"httpd-mw-static-mime", "httpd-mw-static-mime -- internal: map an extension to a Content-Type."},
    {"httpd-mw-static-try", "httpd-mw-static-try -- internal: attempt to serve `path` from `root`"},
    {"httpd-mw-static-fallback", "mw-static -- serve files from a root directory when next returns 404.\n\nParameters:\n  root-dir -- filesystem path to serve files from\n  next -- downstream handler closure (fat-closure :int)\n\nReturns:\n  A wrapped handler closure (:ptr<void>).\n\nExample:\n  (let [composed (mw-static \"./public\" router-handler)]\n      (httpd-new 0 composed))\n\nSince: Phase H8 (MW2)"},
    {"mw-static", "mw-static"},
    {"httpd-mw-recover-500", "httpd-mw-recover-500 -- internal: write a 500 response unless the"},
    {"mw-recover", "mw-recover -- catch a downstream panic and respond 500.\n\nParameters:\n  next -- downstream handler closure (fat-closure :int)\n\nReturns:\n  A wrapped handler closure (:ptr<void>).\n\nExample:\n  (let [base     (fn [c :ptr<void>] :nil (panic \"boom\"))\n          composed (compose-middleware base mw-recover)]\n      (httpd-new 0 composed))\n    ; => client sees \"500 Internal Server Error\"; the server stays up\n\nSince: Phase H8 (MW3)"},
    {"tur/httpd", "tur/httpd -- Lightweight HTTP/1.0 and HTTP/1.1 server.\n\nSince: Phase H1"},
    {"image/build-stamp", "image/build-stamp -- SHA-256 (32 bytes) of the running executable.\n\nReturns:\n  A malloc'd 32-byte buffer (caller frees with image/free-stamp) as an int\n    pointer, or 0 if the executable image could not be read.\n\nSince: Phase AI"},
    {"image/free-stamp", "image/free-stamp -- free a build stamp returned by image/build-stamp."},
    {"image/exists?", "image/exists? -- 1 if a readable file exists at path, else 0."},
    {"image/hook-registry", "image/hook-registry -- backing store for reload/finalize hooks (internal)."},
    {"image/register-reload-hook!", "image/register-reload-hook! -- install a hook run on warm start before resume.\n\nParameters:\n  f -- a zero-arg hook (fn [] int); the return value is ignored\n\nReturns:\n  The number of reload hooks registered so far.\n\nSince: Phase AI (AI5.1)"},
    {"image/run-reload-hooks", "image/run-reload-hooks -- invoke every registered reload hook in order.\n\nSince: Phase AI (AI5.1)"},
    {"image/register-finalize-hook!", "image/register-finalize-hook! -- install a hook run just before a save.\n\nParameters:\n  f -- a zero-arg hook (fn [] int); the return value is ignored\n\nReturns:\n  The number of finalize hooks registered so far.\n\nSince: Phase AI (AI5.3)"},
    {"image/run-finalize-hooks", "image/run-finalize-hooks -- invoke every registered finalize hook in order.\n\nSince: Phase AI (AI5.3)"},
    {"defimage-reload-hook", "defimage-reload-hook -- define a named reload hook function.\n\nExample:\n  (defimage-reload-hook reopen-log\n      (do (reopen-the-log!) 0))\n    ;; ... in main, before with-image-cache-after-init:\n    (image/register-reload-hook! reopen-log)\n\nSince: Phase AI (AI5.1)"},
    {"defimage-finalize-hook", "defimage-finalize-hook -- define a named finalize hook function.\n\nSince: Phase AI (AI5.3)"},
    {"image/global-registry", "image/global-registry -- backing store for image globals (internal)."},
    {"image/free-bytes", "image/free-bytes -- free a bytes value returned by image/snapshot-globals."},
    {"image/bytes-null?", "image/bytes-null? -- true when a bytes/blob value is NULL."},
    {"image/register-global!", "image/register-global! -- register a global's ser/deser pair by name.\n\nParameters:\n  name -- the global's name, the key the image section is matched on\n  ser -- (fn [] ptr<void>): the global's current value as Serializable bytes\n  deser -- (fn [ptr<void>] int): overwrite the global from Serializable bytes\n\nReturns:\n  The number of globals registered so far.\n\nSince: Phase AI (AI3.2)"},
    {"image/null-bytes", "image/null-bytes -- the NULL bytes value (internal)."},
    {"image/global-count", "image/global-count -- how many image globals are registered.\n\nSince: Phase AI (AI3.2)"},
    {"image/snapshot-globals", "image/snapshot-globals -- serialise every registered global into one bytes value.\n\nSince: Phase AI (AI3.3)"},
    {"image/bytes-of", "image/bytes-of -- reinterpret an int carrier as a bytes value (internal)."},
    {"image/restore-globals!", "image/restore-globals! -- overwrite registered globals from a globals section.\n\nParameters:\n  bytes -- a globals section as written by image/snapshot-globals (NULL is a no-op)\n\nReturns:\n  The number of globals restored.\n\nSince: Phase AI (AI3.3)"},
    {"defimage-global", "defimage-global -- declare a mutable global that rides in the image.\n\nExample:\n  (defimage-global counter :int 0)\n    (defn do-init [] : int (do (set! counter 42) 0))\n    (defn main [] : int\n      (do (image/track-globals! counter)\n          (with-image-cache-after-init \"app.img\" do-init do-loop)))\n    ;; a warm start sees counter = 42, not 0\n\nSince: Phase AI (AI3.2)"},
    {"image/track-globals!", "image/track-globals! -- register the named image globals (call at the top of main).\n\nSince: Phase AI (AI3.2)"},
    {"image/crc32-", "image/crc32- -- chainable CRC-32 (zlib convention) over n bytes at p (internal)."},
    {"image/write-image-file!", "image/write-image-file! -- frame continuation k (+ globals) and write to path.\n\nParameters:\n  path -- destination path\n  k -- the serial-continuation handle from serial-shift\n  stamp -- 32-byte build stamp pointer (image/build-stamp), or 0 to zero-fill\n  globals -- a globals section from image/snapshot-globals, or NULL for none\n\nReturns:\n  1 on success, 0 on failure (nil k, unwritable path, short write).\n\nSince: Phase AI (AI3.3)"},
    {"image/save-cont-to-file!", "image/save-cont-to-file! -- serialise continuation k and write it to path.\n\nParameters:\n  path -- destination path\n  k -- the serial-continuation handle from serial-shift\n  stamp -- 32-byte build stamp pointer (image/build-stamp), or 0 to zero-fill\n\nReturns:\n  1 on success, 0 on failure (nil k, unwritable path, short write).\n\nSince: Phase AI"},
    {"image/read-image-file", "image/read-image-file -- read + validate an image into a blob (internal).\n\nSince: Phase AI (AI3.3)"},
    {"image/loadable?", "image/loadable? -- 1 if path is a valid image for `stamp`.\n\nSince: Phase AI"},
    {"image/blob-globals", "image/blob-globals -- the globals section inside a read blob (internal)."},
    {"image/blob-resume!", "image/blob-resume! -- deserialise the blob's continuation and resume it on v."},
    {"image/load-resume-file!", "image/load-resume-file! -- read + validate an image and resume it on v.\n\nParameters:\n  path -- source path\n  stamp -- 32-byte build-stamp pointer to enforce, or 0 to skip the check\n  v -- the value to resume the captured continuation with\n\nReturns:\n  The resumed continuation's value on success (control transfers into the\n    captured tail), or 0 on any validation/I-O failure (no resume occurs).\n\nSince: Phase AI"},
    {"save-image!", "save-image! -- capture the current continuation and write it to path.\n\nSince: Phase AI"},
    {"load-image!", "load-image! -- read an image and resume the continuation it holds.\n\nSince: Phase AI"},
    {"with-image-cache-after-init", "with-image-cache-after-init -- the primary warm-start combinator (AIQ1).\n\nParameters:\n  path -- image cache path\n  init -- a fn [] run only on cold start (expensive setup)\n  loop -- a fn [] run on both paths (the steady-state work)\n   -- This is a macro, not a function: `init` and `loop` are spliced as call\n   -- targets so the captured continuation tail `(loop)` is a call to a *named*\n   -- top-level function. The serial-shift collector reconstructs frames by\n   -- stable name, so the tail cannot be a heap closure -- it must be a named\n   -- (serializable) continuation. Pass top-level `defn` names for init and loop.\n   -- For a *cross-process* warm start to resume correctly, loop must reduce to a\n   -- serializable continuation (named frames, int/cstr/Serializable envs) -- the\n   -- same constraint Serializable continuations impose on serial-shift.\n\nSince: Phase AI"},
    {"with-image-cache", "with-image-cache -- single-body warm-start wrapper.\n\nSince: Phase AI"},
    {"tur/image", "tur/image -- application image dumps via serializable continuations.\n\nSince: Phase AI (application-image-dumps-plan)"},
    {"image-hooks/cstr->raw", "image-hooks/cstr->raw -- reinterpret a :cstr as its raw int64 pointer (internal)."},
    {"image-hooks/file-table", "image-hooks/file-table -- backing store for tracked files (internal)."},
    {"image-hooks/track-file!", "image-hooks/track-file! -- register a file path to reopen on warm start.\n\nParameters:\n  path -- the file path to reopen\n  mode -- the fopen mode (e.g. \"r\", \"a\", \"rb\"); empty defaults to \"r\"\n\nReturns:\n  The 0-based slot id, or -1 if the table is full.\n\nSince: Phase AI (AI5.4)"},
    {"image-hooks/reopen-tracked-files", "image-hooks/reopen-tracked-files -- the reload hook: reopen all tracked files.\n\nSince: Phase AI (AI5.4)"},
    {"image-hooks/slot-handle", "image-hooks/slot-handle -- the current FILE* for a tracked slot.\n\nParameters:\n  id -- the slot id returned by image-hooks/track-file!\n\nReturns:\n  The cached FILE* as an int handle (cast to FILE* in your inline-C), or 0\n    if the slot has not been reopened yet.\n\nSince: Phase AI (AI5.4)"},
    {"image-hooks/tracked-count", "image-hooks/tracked-count -- number of tracked file slots."},
    {"image-hooks/use-reopen-tracked!", "image-hooks/use-reopen-tracked! -- install the tracked-file reopen reload hook.\n\nReturns:\n  The number of reload hooks registered so far (from image.tur).\n\nSince: Phase AI (AI5.4)"},
    {"image-hooks/flush-stdio", "image-hooks/flush-stdio -- the finalize hook: flush stdout and stderr.\n\nSince: Phase AI (AI5.4)"},
    {"image-hooks/use-flush-stdio!", "image-hooks/use-flush-stdio! -- install the stdout/stderr flush finalize hook.\n\nSince: Phase AI (AI5.4)"},
    {"tur/image_hooks", "tur/image-hooks -- standard resource-reacquisition hooks for image dumps.\n\nSince: Phase AI (application-image-dumps-plan, AI5.4)"},
    {"IoError", "IoError"},
    {"io-error/of-code", "io-error/of-code -- wrap a raw errno value as an IoError.\n\nParameters:\n  code -- an errno value (e.g. from a C library you call yourself)\n\nReturns:\n  The IoError carrying code.\n\nExample:\n  (io-error/not-found? (io-error/of-code 2))  ; => true on POSIX (ENOENT)\n\nSince: stdlib-os-surface P1"},
    {"io-error/last", "io-error/last -- the IoError for the calling thread's current errno.\n\nReturns:\n  errno, wrapped.  Only meaningful right after a failed OS call.\n\nExample:\n  (io-error/last)\n\nSince: stdlib-os-surface P1"},
    {"io-error/code", "io-error/code -- the raw errno an IoError carries, for interop.\n\nParameters:\n  e -- an IoError\n\nReturns:\n  The errno value as an int.\n\nExample:\n  (io-error/code e)  ; => 2\n\nSince: stdlib-os-surface P1"},
    {"io-error/message", "io-error/message -- the human-readable description of an IoError.\n\nParameters:\n  e -- an IoError\n\nReturns:\n  strerror(3) text, e.g. \"No such file or directory\".  Static storage:\n    do not free it, and copy it before the next io-error/message call if\n    you need to keep it.\n\nExample:\n  (println (io-error/message e))  ; prints \"No such file or directory\"\n\nSince: stdlib-os-surface P1"},
    {"io-error/not-found?", "io-error/not-found? -- true when the error is \"no such file or directory\".\n\nParameters:\n  e -- an IoError\n\nReturns:\n  true for ENOENT.\n\nExample:\n  (io-error/not-found? e)  ; => true\n\nSince: stdlib-os-surface P1"},
    {"io-error/exists?", "io-error/exists? -- true when the error is \"already exists\".\n\nParameters:\n  e -- an IoError\n\nReturns:\n  true for EEXIST.\n\nExample:\n  (io-error/exists? e)  ; => true after fs/mkdir on an existing dir\n\nSince: stdlib-os-surface P1"},
    {"io-error/permission?", "io-error/permission? -- true when the error is a permission failure.\n\nParameters:\n  e -- an IoError\n\nReturns:\n  true for EACCES or EPERM.\n\nExample:\n  (io-error/permission? e)  ; => true\n\nSince: stdlib-os-surface P1"},
    {"io-error/ok-unit", "io-error/ok-unit -- (Ok nil) as a (Result nil IoError).\n\nReturns:\n  (Ok nil).\n\nExample:\n  (io-error/ok-unit)  ; => (Ok nil)\n\nSince: stdlib-os-surface P2"},
    {"tur/io-error", "tur/io-error -- IoError, the one error type of the fs / io / process surface.\n\nSince: stdlib-os-surface P1"},
    {"DirListing", "DirListing"},
    {"FileStream", "FileStream"},
    {"file-stream-open", "file-stream-open -- open a file as a non-linear FileStream handle.\n\nParameters:\n  path -- filesystem path to open (:cstr).\n  mode -- fopen mode string, e.g. \"rb\" or \"wb\" (:cstr).\n\nReturns:\n  A FileStream wrapping the opened FILE*, or a FileStream wrapping NULL on\n    error.  Check with file-stream-ok? before using.\n\nExample:\n  (let [s (file-stream-open \"/etc/hostname\" \"rb\")] (file-size s))\n\nSince: I/O sweep"},
    {"file-stream-ok?", "file-stream-ok? -- return true if the FileStream wraps a real FILE*.\n\nParameters:\n  f -- a FileStream.\n\nReturns:\n  true if the underlying FILE* is non-NULL, false on open failure.\n\nExample:\n  (file-stream-ok? (file-stream-open \"/etc/hostname\" \"rb\"))  ; => true\n\nSince: I/O sweep"},
    {"file-stream-close", "file-stream-close -- close a FileStream and release the underlying FILE*.\n\nParameters:\n  f -- a FileStream to close.\n\nReturns:\n  0 on success, non-zero on error (mirrors fclose).\n\nExample:\n  (file-stream-close s)  ; => 0\n\nSince: I/O sweep"},
    {"file-size", "file-size -- return the byte size of an already-open FileStream.\n\nParameters:\n  f -- a FileStream (from file-stream-open).\n\nReturns:\n  The file size in bytes as an int.\n\nExample:\n  (file-size my-stream)  ; => 1024"},
    {"Real-FileSystem", "Real-FileSystem"},
    {"Real-FileSystem-free", "Real-FileSystem-free -- release a FileSystem capability created by Real-FileSystem.\n\nParameters:\n  fs -- the FileSystem pointer returned by Real-FileSystem.\n\nSince: Phase 16"},
    {"list-dir", "list-dir -- list all non-hidden entries in a directory.\n\nParameters:\n  path -- the directory path to list (:cstr).\n\nReturns:\n  A NULL-terminated array of strdup'd entry name strings, or NULL\n    on error.  The caller must free each string and then the array itself\n    (or use free-dir-listing).\n\nExample:\n  (let [entries (list-dir \"/tmp\")] ...)\n\nSince: Phase 16"},
    {"free-dir-listing", "free-dir-listing -- free a directory listing returned by list-dir.\n\nParameters:\n  entries -- the NULL-terminated string array returned by list-dir.\n\nSince: Phase 16"},
    {"FileHandle", "[linear] FileHandle -- a linear (exactly-once) handle over a stdio FILE*.\n\nSince: LT4"},
    {"file-open", "file-open -- open a file and return a move-only FileHandle.\n\nParameters:\n  path -- filesystem path to open (:cstr).\n  mode -- fopen mode string, e.g. \"rb\", \"wb\", \"ab\" or \"r+b\" (:cstr).\n\nReturns:\n  (Ok fh) -- a FileHandle that must be closed exactly once with\n    file-close -- or (Err e) carrying the errno of the failed fopen.\n\nExample:\n  (match (file-open \"/etc/hostname\" \"rb\")\n      (Ok fh) (file-close fh)\n      (Err e) (Err e))\n\nSince: LT4"},
    {"file-read", "file-read -- read up to len bytes from fh into buf.\n\nParameters:\n  fh -- an open FileHandle (borrowed; not consumed).\n  buf -- destination buffer as ptr<void>.\n  len -- maximum number of bytes to read.\n\nReturns:\n  (Ok n) -- the number of bytes read; 0 at end of file -- or (Err e) on a\n    read error.\n\nExample:\n  (file-read fh buf 1024)  ; => (Ok 512)\n\nSince: LT4"},
    {"file-close", "file-close -- close a FileHandle and release the underlying FILE*.\n\nParameters:\n  fh -- a FileHandle to close (consumed).\n\nReturns:\n  (Ok nil), or (Err e) when flushing buffered writes failed -- the last\n    place a write error can surface, so do not ignore it after writing.\n\nExample:\n  (file-close fh)  ; => (Ok nil)\n\nSince: LT4"},
    {"SeekFrom", "SeekFrom -- the origin a file-seek offset is measured from.\n\nSince: stdlib-os-surface P0"},
    {"seek-from->whence", "seek-from->whence -- the C whence constant for a SeekFrom."},
    {"file-write", "file-write -- write len bytes from buf to fh.\n\nParameters:\n  fh -- an open FileHandle (borrowed; not consumed).\n  buf -- source buffer as ptr<void>.\n  len -- number of bytes to write.\n\nReturns:\n  (Ok n) with n = len, or (Err e) when fewer bytes could be written.\n\nExample:\n  (file-write fh buf 13)  ; => (Ok 13)\n\nSince: stdlib-os-surface P0"},
    {"file-write-str", "file-write-str -- write a NUL-terminated string to fh (no newline added).\n\nParameters:\n  fh -- an open FileHandle (borrowed; not consumed).\n  s -- the string to write.\n\nReturns:\n  (Ok n) with n = the string's byte length, or (Err e).\n\nExample:\n  (file-write-str fh \"hello\\n\")  ; => (Ok 6)\n\nSince: stdlib-os-surface P0"},
    {"file-seek-raw", "file-seek-raw -- fseek(3) with a C whence constant (internal)."},
    {"file-seek", "file-seek -- move fh's position to offset, measured from whence.\n\nParameters:\n  fh -- an open FileHandle (borrowed; not consumed).\n  offset -- byte offset (may be negative with SeekCurrent / SeekEnd).\n  whence -- SeekStart, SeekCurrent or SeekEnd.\n\nReturns:\n  (Ok pos) -- the new absolute position -- or (Err e), e.g. EINVAL for a\n    position before the start of the file or ESPIPE on a pipe.\n\nExample:\n  (file-seek fh 0 (SeekEnd))  ; => (Ok file-size)\n\nSince: stdlib-os-surface P0"},
    {"file-tell", "file-tell -- the current byte position of fh.\n\nParameters:\n  fh -- an open FileHandle (borrowed; not consumed).\n\nReturns:\n  (Ok pos) from the start of the file, or (Err e) (ESPIPE on a pipe).\n\nExample:\n  (file-tell fh)  ; => (Ok 0)\n\nSince: stdlib-os-surface P0"},
    {"io/read-line", "io/read-line -- read one line from stdin.\n\nReturns:\n  (Some line) -- a fresh heap cstr the caller owns (release with free) --\n    or None at end of input.  End of input is not an error.\n\nExample:\n  (match (io/read-line)\n      (Some s) (println s)\n      (None)   (println \"<eof>\"))\n\nSince: stdlib-os-surface P0"},
    {"io/read-stdin", "io/read-stdin -- read all of stdin into one string.\n\nReturns:\n  (Some text) -- a fresh NUL-terminated heap cstr the caller owns (release\n    with free) -- or None on a read error.  Empty input is (Some \"\").\n\nExample:\n  (match (io/read-stdin) (Some s) (println s) (None) (println \"read failed\"))\n\nSince: stdlib-os-surface P0"},
    {"file-read-line-raw", "file-read-line-raw -- one line, EOF as an errno-0 error (internal)."},
    {"file-read-line", "file-read-line -- read the next line from fh.\n\nParameters:\n  fh -- an open FileHandle (borrowed; not consumed).\n\nReturns:\n  (Ok (Some line)) -- a fresh heap cstr the caller owns (release with\n    free); (Ok (None)) at end of file; (Err e) on a read error, so errors\n    are never mistaken for end of file.\n\nExample:\n  (match (file-read-line fh)\n      (Ok o)  (match o (Some s) (println s) (None) (println \"<eof>\"))\n      (Err e) (println (io-error/message e)))\n\nSince: stdlib-os-surface P2"},
    {"tur/io", "tur/io -- FileSystem capability implementation using libc functions.\n\nSince: Phase 16"},
    {"json/encode-string", "json/encode-string -- serialize a JSON node tree to an owned String.\n\nParameters:\n  node -- a JSON node tree (as from json/decode or the json/* builders)\n\nReturns:\n  An owned String holding the encoded JSON, safe to store or return.\n\nExample:\n  (string/to-cstr (json/encode-string (json/decode \"{\\\"x\\\":1}\")))\n    ; => \"{\\\"x\\\":1}\"\n\nSince: v2"},
    {"tur/json-string", "tur/json-string -- owned String sibling for the tur/json encoder.\n\nSince: v2 (string-adoption-stdlib-plan, batch 3)"},
    {"json/null", "json/null -- create a JSON null node.\n\nReturns:\n  A heap-allocated JSON null node.\n\nExample:\n  (json/null)  ; => <null node>\n\nSince: Phase B2"},
    {"json/bool", "json/bool -- create a JSON boolean node.\n\nParameters:\n  v -- the boolean value\n\nReturns:\n  A heap-allocated JSON bool node.\n\nExample:\n  (json/bool true)  ; => <true node>\n\nSince: Phase B2"},
    {"json/int", "json/int -- create a JSON integer node.\n\nParameters:\n  v -- the integer value\n\nReturns:\n  A heap-allocated JSON int node.\n\nExample:\n  (json/int 42)  ; => <42 node>\n\nSince: Phase B2"},
    {"json/float", "json/float -- create a JSON float node.\n\nParameters:\n  v -- the float value\n\nReturns:\n  A heap-allocated JSON float node.\n\nExample:\n  (json/float 3.14)  ; => <3.14 node>\n\nSince: Phase B2"},
    {"json/string", "json/string -- create a JSON string node from a cstr.\n\nParameters:\n  s -- NUL-terminated cstr (copied internally)\n\nReturns:\n  A heap-allocated JSON string node owning a copy of s.\n\nExample:\n  (json/string \"hello\")  ; => <\"hello\" node>\n\nSince: Phase B2"},
    {"json/array-new", "json/array-new -- create an empty JSON array node.\n\nReturns:\n  A heap-allocated JSON array node backed by a growable vec.\n\nExample:\n  (json/array-new)  ; => <[] node>\n\nSince: Phase B2"},
    {"json/array-push", "json/array-push -- append an element to a JSON array node.\n\nParameters:\n  arr -- JSON array node from json/array-new\n  elem -- JSON node to append\n\nReturns:\n  The same arr pointer (mutated in place).\n\nExample:\n  (json/array-push arr (json/int 1))\n\nSince: Phase B2"},
    {"json/object-new", "json/object-new -- create an empty JSON object node.\n\nReturns:\n  A heap-allocated JSON object node with no entries.\n\nExample:\n  (json/object-new)  ; => <{} node>\n\nSince: Phase B2"},
    {"json/object-put", "json/object-put -- add or update a key-value pair in a JSON object.\n\nParameters:\n  obj -- JSON object node\n  key -- NUL-terminated key cstr (copied internally)\n  val -- JSON value node for the key\n\nReturns:\n  The same obj pointer (mutated in place).\n\nExample:\n  (json/object-put obj \"x\" (json/int 1))\n\nSince: Phase B2"},
    {"json/type", "json/type -- return the type tag of a JSON node.\n\nParameters:\n  node -- JSON node\n\nReturns:\n  0=null 1=bool 2=int 3=float 4=string 5=array 6=object\n\nExample:\n  (json/type (json/int 5))  ; => 2\n\nSince: Phase B2"},
    {"json/get-bool", "json/get-bool -- extract the boolean value from a bool node.\n\nParameters:\n  node -- JSON bool node\n\nReturns:\n  true or false.\n\nExample:\n  (json/get-bool (json/bool 1))  ; => true\n\nSince: Phase B2"},
    {"json/get-int", "json/get-int -- extract the integer value from an int node.\n\nParameters:\n  node -- JSON int node\n\nReturns:\n  The integer value as :int.\n\nExample:\n  (json/get-int (json/int 42))  ; => 42\n\nSince: Phase B2"},
    {"json/get-float", "json/get-float -- extract the float value from a float node.\n\nParameters:\n  node -- JSON float node\n\nReturns:\n  The float value as :float.\n\nExample:\n  (json/get-float (json/float 1.5))  ; => 1.5\n\nSince: Phase B2"},
    {"json/get-string", "json/get-string -- extract the string value from a string node.\n\nParameters:\n  node -- JSON string node\n\nReturns:\n  The string cstr (owned by the node; do not free).\n\nExample:\n  (json/get-string (json/string \"hi\"))  ; => \"hi\"\n\nSince: Phase B2"},
    {"json/array-len", "json/array-len -- return the number of elements in a JSON array node.\n\nParameters:\n  node -- JSON array node\n\nReturns:\n  Number of elements as :int.\n\nExample:\n  (json/array-len my-array)  ; => 3\n\nSince: Phase B2"},
    {"json/array-get", "json/array-get -- get element i from a JSON array node.\n\nParameters:\n  node -- JSON array node\n  i -- zero-based index\n\nReturns:\n  The JSON node at index i, or 0 if out of bounds.\n\nExample:\n  (json/array-get my-array 0)  ; => first element node\n\nSince: Phase B2"},
    {"json/get", "json/get -- look up a key in a JSON object node.\n\nParameters:\n  node -- JSON object node\n  key -- NUL-terminated key cstr\n\nReturns:\n  A some option (:int) containing the value node, or none (0) if the\n    key is absent.\n\nExample:\n  (json/get my-obj \"name\")  ; => some(<node>)\n\nSince: Phase B2"},
    {"json/get!", "json/get! -- look up a key in a JSON object, panicking if absent.\n\nParameters:\n  node -- JSON object node\n  key -- NUL-terminated key cstr\n\nReturns:\n  The value node.  Panics if the key is not found.\n\nExample:\n  (json/get! my-obj \"name\")  ; => <node>\n\nSince: Phase B2"},
    {"json-enc-ensure-", "json/encode -- serialize a JSON node tree to a NUL-terminated cstr.\n\nParameters:\n  node -- root JSON node\n\nReturns:\n  A heap-allocated NUL-terminated JSON string.  The caller must free.\n\nExample:\n  (json/encode (json/int 42))  ; => \"42\"\n\nSince: Phase B2"},
    {"json-enc-append-s-", "json-enc-append-s-"},
    {"json-enc-append-c-", "json-enc-append-c-"},
    {"json-enc-str-", "json-enc-str-"},
    {"json-enc-node-", "json-enc-node-"},
    {"json/encode", "json/encode"},
    {"json-dec-skip-ws-", "json/decode -- parse a JSON string into a node tree.\n\nParameters:\n  s -- NUL-terminated JSON cstr to parse\n\nReturns:\n  A heap-allocated JSON node tree on success, or 0 on parse error.\n    Free with json/free when done.\n\nExample:\n  (json/decode \"{\\\"x\\\":1}\")  ; => <object node>\n\nSince: Phase B2"},
    {"json-dec-parse-string-", "json-dec-parse-string-"},
    {"json-dec-parse-value-", "json-dec-parse-value-"},
    {"json/decode", "json/decode"},
    {"json/decode-file!", "json/decode-file! -- read a whole file and decode it as JSON.\n\nParameters:\n  path -- the file to read\n\nReturns:\n  The root JSON node, or 0 on malformed JSON.\n\nExample:\n  (json/decode-file! \"config.json\")   ; => node, or a panic if unreadable\n\nSince: json-str-result-and-file-readers-missing (2026-09-02)"},
    {"json-free-node-", "json/free -- recursively free a JSON node tree.\n\nParameters:\n  node -- root JSON node to free (may be 0)\n\nExample:\n  (json/free my-node)\n\nSince: Phase B2"},
    {"json/free", "json/free"},
    {"tur/json", "tur/json -- JSON encode and decode with no external dependencies.\n\nSince: Phase B1"},
    {"Kleisli", "Kleisli -- a kind (* -> * -> *) arrow handle; carrier is a fat closure\n\nSince: Phase CA2"},
    {"k-apply-raw", "k-apply-raw -- internal: invoke a fat closure carrier on x, returning the"},
    {"kleisli", "kleisli -- wrap a fat closure `A -> Option B` as a Kleisli arrow.\n\nParameters:\n  f -- the underlying partial function (returns an int-level Option)\n\nReturns:\n  A Kleisli A B wrapping f.\n\nExample:\n  (kleisli (fn [x] (if (= x 0) (none) (some (/ 100 x)))))\n\nSince: Phase CA2"},
    {"k-apply", "k-apply -- run a Kleisli arrow on an input, returning its int-level Option.\n\nParameters:\n  k -- the Kleisli arrow\n  x -- the input value\n\nReturns:\n  The Option result (int carrier): `some y` or `none`.\n\nExample:\n  (some? (k-apply (kleisli (fn [x] (some x))) 7))  ; => true\n\nSince: Phase CA2"},
    {"ArrowZero", "ArrowZero [Kleisli] -- the honest zero arrow over Option: ignore the input"},
    {"tur/kleisli", "tur/kleisli -- the Kleisli arrow over Option: `Kleisli A B = A -> Option B`.\n\nSince: Phase CA2"},
    {"Lens", "Lens"},
    {"lens", "lens -- build a Lens from a getter and a setter.\n\nParameters:\n  get -- reads the focused A out of the whole S\n  put -- returns a new S with the focused A replaced\n\nReturns:\n  A Lens S A pairing `get` and `put`.\n\nExample:\n  (lens (fn [p : Point] : int (.x p))\n          (fn [nx : int p : Point] : Point\n            (make-struct Point :x nx :y (.y p))))\n\nSince: constrained-hkt-forall slice 4"},
    {"view", "view -- read the focused A out of the whole S.\n\nParameters:\n  l -- the lens\n  s -- the whole value\n\nReturns:\n  The focused part A.\n\nExample:\n  (view point-x p)   ; => (.x p)\n\nSince: constrained-hkt-forall slice 4"},
    {"set", "set -- replace the focused A, returning the updated S.\n\nParameters:\n  l -- the lens\n  a -- the new focused value\n  s -- the whole value\n\nReturns:\n  A new S with the focus replaced by `a`.\n\nExample:\n  (set point-x 42 p)   ; => p with x = 42\n\nSince: constrained-hkt-forall slice 4"},
    {"over", "over -- apply a function to the focused A, returning the updated S.\n\nParameters:\n  l -- the lens\n  f -- transforms the focused value\n  s -- the whole value\n\nReturns:\n  A new S with the focus mapped through `f`.\n\nExample:\n  (over point-x (fn [v : int] : int (* v 10)) p)   ; => p with x *= 10\n\nSince: constrained-hkt-forall slice 4"},
    {"tur/lens", "tur/lens -- first-class functional lenses (getter/setter optics).\n\nSince: constrained-hkt-forall slice 4"},
    {"List", "List -- a typed view over the int64 cons-list carrier, carrying a phantom\n\nSince: end-to-end-monomorphization-plan (Phase 1.1)"},
    {"list-of", "list-of -- build a (List A) from N values, recovering A from the rest type.\n\nParameters:\n   -- & xs -- zero or more elements, all of type A.\n\nReturns:\n  A (List A) over the int64 cons-list carrier the variadic collector builds.\n    With zero arguments, the empty list (carrier 0).\n\nExample:\n  (list-empty? (list-of))      ; => true\n    (list-empty? (list-of 1 2))  ; => false\n\nSince: end-to-end-monomorphization-plan (Phase 1.1)"},
    {"list-empty?", "list-empty? -- is a (List A) the empty list?\n\nParameters:\n  xs -- the (List A) to inspect\n\nReturns:\n  true when xs is empty (carrier 0), false otherwise.\n\nExample:\n  (list-empty? (list-of))   ; => true\n    (list-empty? (list-of 9)) ; => false\n\nSince: end-to-end-monomorphization-plan (Phase 1.1)"},
    {"list->carrier", "list->carrier -- recover the raw int64 cons-list carrier from a (List A).\n\nParameters:\n  xs -- the (List A) to unwrap\n\nReturns:\n  The underlying int64 cons-list pointer (0 for empty), suitable as input\n    to the untyped carrier helpers (list-head, list-tail, list-length, ...).\n\nExample:\n  (list-head (list->carrier (list-of 7 8)))  ; => 7\n\nSince: end-to-end-monomorphization-plan (Phase 1.1)"},
    {"list-count", "list-count -- number of elements in a (List A), correct for aggregate A.\n\nParameters:\n  xs -- the (List A) to measure\n\nReturns:\n  Integer length (0 for the empty list).\n\nExample:\n  (list-count (list-of 1 2 3))  ; => 3\n\nSince: Phase G4 (carrier<->concrete ABI crossing audit)"},
    {"list-nil", "list-nil -- the empty (List A).\n\nReturns:\n  The empty list (carrier 0); its element type comes from the context.\n\nExample:\n  (list-empty? (:: (list-nil) (List int)))  ; => true\n\nSince: parsec-guide-plan P5"},
    {"list-cons", "list-cons -- prepend x to xs.\n\nParameters:\n  x -- the new first element\n  xs -- the rest of the list\n\nReturns:\n  A (List A) whose first element is x, followed by xs.\n\nExample:\n  (list-count (list-cons 1 (list-of 2 3)))  ; => 3\n\nSince: parsec-guide-plan P5"},
    {"list-first", "list-first -- the first element of a non-empty list.\n\nParameters:\n  xs -- a non-empty (List A); check with list-empty? first\n\nReturns:\n  The first element.\n\nExample:\n  (list-first (list-of 7 8))  ; => 7\n\nSince: parsec-guide-plan P5"},
    {"list-rest", "list-rest -- everything after the first element of a non-empty list.\n\nParameters:\n  xs -- a non-empty (List A)\n\nReturns:\n  The (List A) after the first element (empty for a one-element list).\n\nExample:\n  (list-first (list-rest (list-of 7 8)))  ; => 8\n\nSince: parsec-guide-plan P5"},
    {"list-foldl", "list-foldl -- fold a list from the left.\n\nParameters:\n  xs -- the list to fold\n  init -- the starting accumulator\n  f -- (fn [acc x] acc'), called once per element, first to last\n\nReturns:\n  The final accumulator.\n\nExample:\n  (list-foldl (list-of 1 2 3) 0 (fn [acc : int x : int] : int (+ acc x)))  ; => 6\n\nSince: parsec-guide-plan P5"},
    {"list-reverse-onto__", "list-reverse-onto__ -- internal: prepend xs, reversed, onto acc."},
    {"list-reverse", "list-reverse -- the elements of xs in reverse order.\n\nParameters:\n  xs -- the list to reverse\n\nReturns:\n  A new (List A), last element first.\n\nExample:\n  (list-first (list-reverse (list-of 1 2 3)))  ; => 3\n\nSince: parsec-guide-plan P5"},
    {"list-map-onto__", "list-map-onto__ -- internal: map f over xs, consing results onto acc in reverse."},
    {"list-map", "list-map -- apply f to every element.\n\nParameters:\n  xs -- the list to map over\n  f -- the function applied to each element\n\nReturns:\n  A new (List B) of the results, in the original order.\n\nExample:\n  (list-first (list-map (list-of 1 2) (fn [x : int] : int (* x 10))))  ; => 10\n\nSince: parsec-guide-plan P5"},
    {"list->string-loop__", "list->string-loop__ -- internal: append each Char of xs to the builder."},
    {"list->string", "list->string -- the characters of a (List Char) as a String.\n\nParameters:\n  xs -- the characters, first to last\n\nReturns:\n  A fresh owned String.\n\nExample:\n  (string/to-cstr (list->string (list-of #\\h #\\i)))  ; => \"hi\"\n\nSince: parsec-guide-plan P5"},
    {"tur/list-typed", "tur/list-typed -- a phantom-typed (List A) view over the int64 cons-list\n\nSince: end-to-end-monomorphization-plan (Phase 1.1)"},
    {"Cons", "Cons -- parameterized cons cell with typed head and tail.\n\nSince: Phase TC1"},
    {"tcons", "tcons -- prepend a value to a typed list.\n\nParameters:\n  h -- head element of type A\n  t -- tail list as the :int carrier (another typed list, which coerces\n   -- to the carrier, a carrier-level list, or tnil)\n\nReturns:\n  A new (Cons A) cell with h at the front. The head slot is laid out as A's\n    concrete C type (e.g. a `double` field for a float head), exactly like\n    `tcons-of`. A (Cons A) carrier coerces to the :int carrier in argument\n    position, so the result still composes with the list-head/list-tail\n    walkers and the carrier-level list helpers (nest (tcons x (tcons ...))\n    just like before).  This is the carrier-level constructor -- the tail\n    arrives as the `:int` word the carrier helpers produce and is ascribed\n    to `(Cons A)` here; `tcons-of` is the typed-tail twin.\n\nExample:\n  (tcons 1 (tcons 2 (tnil)))    ; => (Cons int)    [1, 2]\n    (tcons 1.5 (tnil))            ; => (Cons float)  double-headed cell\n\nSince: Phase TC1"},
    {"tcons-of", "tcons-of -- typed Cons[A] constructor with a typed head slot.\n\nParameters:\n  h -- head element of type A\n  t -- tail link, a (Cons A) (another cell, or (tnil) for the end)\n\nReturns:\n  A (Cons A) value whose head field is laid out as the concrete C type\n    for A (e.g. `double` for `:float`), with no user-side bit-cast, and\n    whose tail is the typed link.\n\nExample:\n  (let [c (tcons-of 1.5 (tnil))]\n      (.head c))  ; => 1.5, read as a `double` field\n\nSince: Phase TS3"},
    {"tnil", "tnil -- return an empty typed list.\n\nReturns:\n  The empty (Cons A): the NULL link.  Its element type is taken from the\n    context -- `(tcons-of 1 (tnil))` pins A to int -- and it coerces to the\n    `:int` carrier 0 wherever a carrier-level list is expected.\n\nExample:\n  (tnil)  ; => empty list\n\nSince: Phase TC1"},
    {"tnil?", "tnil? -- check whether a typed list is empty.\n\nParameters:\n  l -- List[A], a (Cons A)\n\nReturns:\n  true if l is the empty list, false otherwise.\n\nExample:\n  (tnil? (tnil))         ; => true\n    (tnil? (tcons 1 (tnil)))  ; => false\n\nSince: Phase TC1"},
    {"thead", "thead -- return the head element of a non-empty typed list.\n\nParameters:\n  l -- Cons[A]\n\nReturns:\n  The head element of type A.\n\nExample:\n  (let [l (:: (make-struct Cons 42 (tnil)) (Cons int))]\n      (thead l))  ; => 42\n\nSince: Phase TC1"},
    {"ttail", "ttail -- return the tail of a non-empty typed list.\n\nParameters:\n  l -- Cons[A]\n\nReturns:\n  The tail list, a (Cons A) -- the NULL link (carrier 0) after the last\n    cell.  It coerces to the :int carrier in argument position, so\n    `(tnil? (ttail l))` and the carrier-level helpers still take it.\n\nExample:\n  (let [l (:: (make-struct Cons 1 (tnil)) (Cons int))]\n      (tnil? (ttail l)))  ; => true\n\nSince: Phase TC1"},
    {"tlength-acc__", "tlength-acc__ -- internal: tail-recursive count behind `tlength`."},
    {"tlength", "tlength -- count the elements of a typed (Cons A) list.\n\nParameters:\n  xs -- the (Cons A) list to measure\n\nReturns:\n  Integer length.\n\nExample:\n  (tlength (:: (list (some 1) (some 2)) (Cons (Option int))))  ; => 2\n\nSince: Phase G4 (carrier<->concrete ABI crossing audit)"},
    {"list-length", "list-length -- count the number of elements in a typed list.\n\nParameters:\n  l -- List[A]\n\nReturns:\n  Integer length.\n\nExample:\n  (list-length (list 1 2))  ; => 2\n\nSince: Phase TC1"},
    {"list-eq?", "list-eq? -- compare two typed lists element-wise.\n\nParameters:\n  l1 -- first List[A]\n  l2 -- second List[A]\n  cmp-fn -- comparator fn [a :int b :int] :bool\n\nReturns:\n  true if both lists have the same elements in the same order.\n\nExample:\n  (list-eq? (list 1) (list 1) (fn [a b] (= a b)))  ; => true\n\nSince: Phase TC1"},
    {"cons-eq-go", "cons-eq-go -- by-value structural equality walk over two non-nil (Cons A) cells.\n\nParameters:\n  c1 -- first head cell, a non-nil (Cons A)\n  c2 -- second head cell, a non-nil (Cons A)\n\nReturns:\n  true when both chains have equal heads in the same order and equal length.\n\nExample:\n  (cons-eq-go (:: (tcons 1 (tnil)) (Cons int))\n                (:: (tcons 1 (tnil)) (Cons int)))  ; => true\n\nSince: Phase TCE (typed-collection-eq-consumers)"},
    {"__cons-fmap", "__cons-fmap -- apply a typed thunk to every head element of a Cons list.\n\nParameters:\n  cell -- raw Cons list pointer (0 for nil)\n  f -- typed fat-closure applied to each head element\n\nReturns:\n  A new Cons list with f applied to every head, or 0 for empty input.\n\nSince: Phase TS5"},
    {"tur-list-homog__", "tur-list-homog__ -- internal: compile-time element homogeneity check."},
    {"list-homog-chain__", "list-homog-chain__ -- internal: pairwise-chain tur-list-homog__ over xs."},
    {"list-build__", "list-build__ -- internal: right-fold xs into a typed (tcons-of ...) chain."},
    {"list", "list -- construct a typed list from N values via nested tcons-of.\n\nParameters:\n   -- & xs -- zero or more values, all of a single element type A.\n\nReturns:\n  The right-folded (tcons-of ... (tnil)) chain, typed as (Cons A) where A\n    is the element type recovered from the literal -- so (list 7.1 2.5) is a\n    (Cons float) whose head slot is a `double`, and (list 1 2 3) is a\n    (Cons int). A (Cons A) carrier coerces to :int in argument position, so\n    the result still composes with list-length, list-eq?, and the rest of the\n    :int-taking carrier API; an empty (list) is the bare :int carrier 0.\n  \n  Note: all elements must unify to a single type. Mixing types -- e.g.\n    (list 1 \"x\" 3.14) -- is a type error (TUR-E0001 on the offending\n    element). That genuinely-heterogeneous case is the one place to reach for\n    tuple2, tuple3, tuple4, or tuple5 instead; a homogeneous non-int list\n    (like a float list) is exactly what this macro now builds directly.\n\nExample:\n  (list)          ; => (tnil), carrier 0\n    (list 1 2 3)    ; => (Cons int):   tcons-of 1 (tcons-of 2 (tcons-of 3 (tnil)))\n    (list 7.1 2.5)  ; => (Cons float): a double-headed cons chain\n    ; Heterogeneous -- type error:\n    ; (list 1 \"x\")  ; => TUR-E0001: expected int, got cstr; use tuple2 instead\n\nSince: List literal macro"},
    {"list*", "list* -- prepend values onto an existing list tail.\n\nParameters:\n   -- & args -- one or more arguments; the last is the existing tail list,\n   -- prior arguments are prepended left-to-right.\n\nReturns:\n  The right-folded (tcons-of ... tail) chain where tail is the last\n    argument. With a single argument, returns it unchanged (identity on the\n    tail). Routing through the polymorphic-head tcons-of means a non-int\n    prefix (e.g. a float) specializes its head slot, mirroring (list ...).\n  \n  Note: each prefix element pins its own cons cell's head type; the prefix\n    elements should share the tail's element type. A (Cons A) tail coerces to\n    the :int tail carrier, so the chain composes with the carrier list API.\n    For genuinely heterogeneous needs, use tupleN.\n\nExample:\n  (list* (tnil))                    ; => (tnil)\n    (list* 1 2 (tnil))                ; => (tcons-of 1 (tcons-of 2 (tnil)))\n    (list* 1 2 (list 3 4))            ; => (Cons int) of 1 2 3 4\n    (list* 7.1 (list 2.5))            ; => (Cons float) of 7.1 2.5\n\nSince: List literal macro"},
    {"list-head", "list-head -- head element of a non-empty carrier-level list."},
    {"list-tail", "list-tail -- tail pointer of a non-empty carrier-level list."},
    {"list-concat", "list-concat -- concatenate two lists.\n\nParameters:\n  l1 -- first List[A]\n  l2 -- second List[A]\n\nReturns:\n  A new list with all elements of l1 followed by all elements of l2.\n    Returns l2 directly when l1 is empty (no allocation).\n  \n  Note: l1 and l2 elements must share the same type (all :int at carrier\n    level). An empty l1 returns l2 directly (no allocation). This function\n    is a prerequisite for unquote-splicing in list-quasiquote-plan.md;\n    the N-ary signature should be preserved.\n\nExample:\n  (list-concat (list) (list 1 2))        ; => (list 1 2)\n    (list-concat (list 1 2) (list))        ; => (list 1 2)\n    (list-concat (list 1 2) (list 3 4))    ; => (list 1 2 3 4)\n\nSince: List literal macro"},
    {"car", "car -- head of a cons-built list (classic-Lisp alias for list-head).\n\nParameters:\n  l -- a non-empty carrier-level list (e.g. built with cons or list)\n\nReturns:\n  The head element (carrier :int).\n\nExample:\n  (car (cons 11 (cons 22 (tnil))))  ; => 11\n\nSince: Phase TC1"},
    {"cdr", "cdr -- tail of a cons-built list (classic-Lisp alias for list-tail).\n\nParameters:\n  l -- a non-empty carrier-level list (e.g. built with cons or list)\n\nReturns:\n  The tail list (carrier :int; 0 when l had a single element).\n\nExample:\n  (car (cdr (cons 11 (cons 22 (tnil)))))  ; => 22\n\nSince: Phase TC1"},
    {"null?", "null? -- test a cons-built list for emptiness (the :int-taking twin of tnil?).\n\nParameters:\n  l -- a carrier-level list (a (Cons A) coerces to it in argument position)\n\nReturns:\n  true when l is the empty list, false otherwise.\n\nExample:\n  (null? (tnil))             ; => true\n    (null? (cons 1 (tnil)))    ; => false\n\nSince: Phase TC1"},
    {"length", "length -- count the elements of a cons-built list (alias for list-length).\n\nParameters:\n  l -- a carrier-level list\n\nReturns:\n  Integer length.\n\nExample:\n  (length (list 1 2 3))  ; => 3\n\nSince: Phase TC1"},
    {"tur/list", "tur/list -- typed singly-linked List[A] with Cons cells.\n\nSince: Phase TC1-B"},
    {"Real-Logger", "Real-Logger"},
    {"Real-Logger-free", "Real-Logger-free -- release a Logger capability created by Real-Logger.\n\nParameters:\n  log -- the Logger pointer returned by Real-Logger.\n\nSince: Phase 16"},
    {"Simple-Logger", "Simple-Logger -- create a lightweight Logger capability without timestamps.\n\nReturns:\n  A heap-allocated Logger struct whose debug/info methods write to\n    stdout and warn/error methods write to stderr, each line prefixed\n    with only the level tag (e.g. \"[DEBUG] ...\").\n    Free with Simple-Logger-free when done.\n\nExample:\n  (let [log (Simple-Logger)] ...)\n\nSince: Phase 16"},
    {"Simple-Logger-free", "Simple-Logger-free -- release a Logger capability created by Simple-Logger.\n\nParameters:\n  log -- the Logger pointer returned by Simple-Logger.\n\nSince: Phase 16"},
    {"Null-Logger", "Null-Logger -- create a silent Logger capability that discards all messages.\n\nReturns:\n  A heap-allocated Logger struct where all four methods (debug, info,\n    warn, error) are no-ops.  Useful as a default/test double.\n    Free with Null-Logger-free when done.\n\nExample:\n  (let [log (Null-Logger)] ...)\n\nSince: Phase 16"},
    {"Null-Logger-free", "Null-Logger-free -- release a Logger capability created by Null-Logger.\n\nParameters:\n  log -- the Logger pointer returned by Null-Logger.\n\nSince: Phase 16"},
    {"log-debug-direct", "log-debug-direct -- write a DEBUG message directly to stdout.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nExample:\n  (log-debug-direct \"starting up\")\n    ; prints: [DEBUG] starting up\n\nSince: Phase 16"},
    {"log-info-direct", "log-info-direct -- write an INFO message directly to stdout.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nExample:\n  (log-info-direct \"server ready\")\n    ; prints: [INFO] server ready\n\nSince: Phase 16"},
    {"log-warn-direct", "log-warn-direct -- write a WARN message directly to stderr.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nExample:\n  (log-warn-direct \"config missing, using defaults\")\n    ; prints to stderr: [WARN] config missing, using defaults\n\nSince: Phase 16"},
    {"log-error-direct", "log-error-direct -- write an ERROR message directly to stderr.\n\nParameters:\n  msg -- the message string to log (:cstr).\n\nExample:\n  (log-error-direct \"fatal: out of memory\")\n    ; prints to stderr: [ERROR] fatal: out of memory\n\nSince: Phase 16"},
    {"tur/log", "tur/log -- Logger capability implementation using stderr/stdout.\n\nSince: Phase 16"},
    {"Term", "Term"},
    {"Subst", "Subst"},
    {"UnifyResult", "UnifyResult"},
    {"Lookup", "Lookup"},
    {"Stream", "Stream"},
    {"st-force", "st-force -- run a delayed stream one step."},
    {"st-pull", "st-pull -- force a stream until it is mature (StNil or StCons).\n\nParameters:\n  xs -- a possibly-delayed stream\n\nReturns:\n  The same stream forced to StNil or StCons.\n\nSince: lazy-streams"},
    {"Goal", "Goal -- a kind-(* -> *) handle over a miniKanren goal `Subst -> Stream`;\n\nSince: stdlib-hkt-consolidation T3"},
    {"st-append", "-- Solution stream (list / backtracking monad) ─────────────────────────────"},
    {"st-append-dfs", "st-append-dfs -- concatenate two solution streams DEPTH-FIRST.\n\nParameters:\n  xs -- first solution stream\n  ys -- second solution stream\n\nReturns:\n  xs's solutions, then ys's.\n\nExample:\n  (st-length (st-append-dfs (mreturn s) (mreturn s)))  ; => 2\n\nSince: lazy-streams"},
    {"st-bind", "st-bind -- concatMap: apply f to each state and concatenate the streams."},
    {"st-length", "st-length -- count the states in a solution stream."},
    {"st-take", "st-take -- keep at most n states from the front of a solution stream."},
    {"term-int", "-- Term constructors ────────────────────────────────────────────────────────\n\nParameters:\n  n -- integer value\n\nReturns:\n  A TInt term.\n\nExample:\n  (term-int 42)  ; => integer term 42"},
    {"term-var", "term-var -- construct a logic variable term with the given id.\n\nParameters:\n  id -- unique variable identifier\n\nReturns:\n  A TVar term.\n\nExample:\n  (term-var 0)  ; => logic variable 0"},
    {"term-pair", "term-pair -- construct a logic pair term from two sub-terms.\n\nParameters:\n  a -- first sub-term\n  b -- second sub-term\n\nReturns:\n  A TPair term.\n\nExample:\n  (term-pair (term-int 1) (term-int 2))  ; => pair term (1 . 2)"},
    {"term-nil", "term-nil -- construct the nil/empty logic term.\n\nReturns:\n  A TNil term.\n\nExample:\n  (term-nil)  ; => nil term"},
    {"term-int-val", "-- Term accessors ───────────────────────────────────────────────────────────\n\nParameters:\n  t -- a Term\n\nReturns:\n  The integer payload of a TInt, or 0 for any other term."},
    {"term-var-id", "term-var-id -- read the variable id from a VAR term (0 otherwise).\n\nParameters:\n  t -- a Term\n\nReturns:\n  The id of a TVar, or 0 for any other term."},
    {"term-pair-fst", "term-pair-fst -- read the first sub-term of a PAIR term (TNil otherwise).\n\nParameters:\n  t -- a Term\n\nReturns:\n  The first component of a TPair, or TNil for any other term."},
    {"term-pair-snd", "term-pair-snd -- read the second sub-term of a PAIR term (TNil otherwise).\n\nParameters:\n  t -- a Term\n\nReturns:\n  The second component of a TPair, or TNil for any other term."},
    {"subs-empty", "-- Substitution operations ──────────────────────────────────────────────────\n\nReturns:\n  An empty Subst with next fresh-var id 0."},
    {"subst-next", "subst-next -- read the next unused fresh-variable id from the base of a"},
    {"subst-set-next", "subst-set-next -- set the fresh-variable counter at the base of a"},
    {"subst-lookup", "subst-lookup -- find the term bound to var-id in a substitution."},
    {"logic-walk", "logic-walk -- follow variable bindings in a substitution until ground.\n\nParameters:\n  t -- the term to walk\n  subs -- the substitution\n\nReturns:\n  The fully walked term (a ground term or an unbound variable).\n\nExample:\n  (logic-walk (term-var 0) subs)  ; => bound term or the variable itself"},
    {"unify-walked", "unify-walked -- structural unification of two already-walked terms."},
    {"logic-unify", "logic-unify -- structurally unify two terms, extending the substitution.\n\nParameters:\n  t1 -- first term\n  t2 -- second term\n  subs -- current substitution\n\nReturns:\n  (UOk subs') on success, or (UFail) on unification failure.\n\nExample:\n  (logic-unify (term-var 0) (term-int 5) (subs-empty))  ; => (UOk {x0=5})"},
    {"apply-goal", "-- Goal application ─────────────────────────────────────────────────────────\n\nParameters:\n  g -- a goal\n  state -- the current search state (Subst)\n\nReturns:\n  The solution Stream."},
    {"unify-goal-impl", "-- Goal constructors ────────────────────────────────────────────────────────"},
    {"lequal", "lequal -- goal that unifies two terms (miniKanren ==).\n\nParameters:\n  t1 -- first term\n  t2 -- second term\n\nReturns:\n  A goal (Goal int) that succeeds iff t1 and t2 unify.\n\nExample:\n  (run-logic 1 (lequal (term-int 5) (term-int 5)))  ; => one solution"},
    {"succeed", "succeed -- goal that always succeeds without changing the substitution.\n\nReturns:\n  A goal (Goal int) that adds the current state unchanged to the solutions.\n\nExample:\n  (run-logic 1 (succeed))  ; => one solution"},
    {"fail", "fail -- goal that always fails, producing no solutions.\n\nReturns:\n  A goal (Goal int) that produces an empty solution stream.\n\nExample:\n  (run-logic 1 (fail))  ; => empty stream"},
    {"conjoined-impl", "conjoined-impl -- implementation helper for conjunction."},
    {"conjoined-raw", "conjoined-raw -- worker behind conjoined / Monad bind sequencing."},
    {"conjoined", "conjoined -- goal that applies g1 then g2 to each result (conjunction).\n\nParameters:\n  g1 -- first goal (Goal A)\n  g2 -- second goal (Goal B)\n\nReturns:\n  A goal (Goal B) that succeeds only when both g1 and g2 succeed.\n\nExample:\n  (run-logic 1 (conjoined (lequal x (term-int 1)) (succeed)))  ; => [x=1]\n\nSince: Phase B1"},
    {"disjoined-impl", "disjoined-impl -- implementation helper for disjunction."},
    {"disjoined-raw", "disjoined-raw -- worker behind disjoined / Alternative alt-or."},
    {"disjoined", "disjoined -- goal that combines results from g1 and g2 (disjunction).\n\nParameters:\n  g1 -- first goal (Goal A)\n  g2 -- second goal (Goal A)\n\nReturns:\n  A goal (Goal A) whose solutions are the union of g1's and g2's.\n\nExample:\n  (run-logic 2 (disjoined (lequal x (term-int 1)) (lequal x (term-int 2))))\n    ; => [x=1, x=2]\n\nSince: Phase B1"},
    {"fresh-impl", "fresh-impl -- implementation helper for fresh variable introduction."},
    {"zzz", "zzz -- delay a goal so a recursive relation can be written at all.\n\nParameters:\n  g -- a goal EXPRESSION, not evaluated until the stream is pulled\n\nReturns:\n  A goal that yields an immature stream.\n\nExample:\n  (run-logic 1 (zzz (nats)))   ; terminates\n\nSince: lazy-streams"},
    {"disjoined-dfs-impl", "disjoined-dfs -- disjunction that searches DEPTH-FIRST.\n\nParameters:\n  g1 -- first goal\n  g2 -- second goal\n\nReturns:\n  A goal yielding g1's solutions then g2's.\n\nExample:\n  (run-logic 1 (disjoined-dfs (lequal x (term-int 1)) (lequal x (term-int 2))))\n\nSince: lazy-streams"},
    {"disjoined-dfs", "disjoined-dfs"},
    {"run-logic", "-- Runner ───────────────────────────────────────────────────────────────────\n\nParameters:\n  n -- maximum number of solutions\n  g -- goal to run (Goal A)\n\nReturns:\n  A Stream of at most n solution states.\n\nExample:\n  (run-logic 1 (fresh (fn [x] (lequal x (term-int 3)))))  ; => one solution"},
    {"stream-empty?", "-- Result helpers ───────────────────────────────────────────────────────────"},
    {"first-state", "first-state -- extract the first solution substitution from a run-logic\n\nParameters:\n  results -- solution stream from run-logic\n\nReturns:\n  The first Subst, or the empty substitution if the stream is empty."},
    {"reify-walk", "reify-walk -- walk a term through the first solution's substitution.\n\nParameters:\n  t -- the term to reify\n  results -- solution stream from run-logic\n\nReturns:\n  The walked term (ground term or unbound variable); t itself if there are\n    no solutions.\n\nExample:\n  (reify-walk my-var (run-logic 1 my-goal))  ; => ground term or variable"},
    {"bind-goal-raw", "-- HKT typeclass instances (stdlib-hkt-consolidation T3) ────────────────────"},
    {"fmap-goal-raw", "fmap-goal-raw -- worker: map a callback over each solution state."},
    {"tur/logic", "tur/logic -- miniKanren-style logic programming (unification, goals, streams).\n\nSince: Phase B1"},
    {"cond", "cond"},
    {"when", "when"},
    {"unless", "unless"},
    {"must!", "must!"},
    {"must-msg!", "must-msg!"},
    {"ignore!", "ignore!"},
    {"do-m", "do-m"},
    {"for", "for"},
    {"curry", "curry"},
    {"doc", "doc"},
    {"with-resource", "with-resource"},
    {"must-use", "must-use"},
    {"as->", "as->"},
    {"dot", "dot"},
    {"derive-show-rest__", "derive-show-rest__"},
    {"derive-show-body__", "derive-show-body__"},
    {"derive-show-cstr", "derive-show-cstr"},
    {"derive-show-string-rest__", "derive-show-string-rest__"},
    {"derive-show-string-body__", "derive-show-string-body__"},
    {"derive-show", "derive-show"},
    {"derive-debug-rest__", "derive-debug-rest__"},
    {"derive-debug-body__", "derive-debug-body__"},
    {"derive-debug", "derive-debug"},
    {"derive-display-rest__", "derive-display-rest__"},
    {"derive-display-body__", "derive-display-body__"},
    {"derive-display", "derive-display"},
    {"tur/macros", "tur/macros -- core control-flow and utility macros (cond, when, for, do-m, ...).\n\nSince: Phase M7"},
    {"Map", "Map -- parameterized persistent map with key type K and value type V.\n\nSince: Phase TM0"},
    {"map-new", "map-new -- create a new empty typed map.\n\nReturns:\n  An empty Map[K V].\n\nExample:\n  (:: (map-new) (Map int int))  ; => empty Map[int int]\n\nSince: Phase TM0"},
    {"map-empty-for", "map-empty-for -- internal: an empty Map[K V] whose K/V are pinned by a\n\nSince: Phase TMS3"},
    {"map-hamt", "map-hamt -- internal accessor for the HAMT backing store."},
    {"map-wrap", "map-wrap -- internal constructor from a HAMT pointer."},
    {"map-assoc-eq-o", "============================================================================"},
    {"map-get-eq-o", "map-get-eq-o -- raw lookup: explicit hash, boxed carrier key, comparator."},
    {"map-has-eq-o?", "map-has-eq-o? -- raw existence test: explicit hash, boxed carrier key."},
    {"map-dissoc-eq-o", "map-dissoc-eq-o -- raw removal: explicit hash, boxed carrier key, comparator."},
    {"map-assoc-eq", "----------------------------------------------------------------------------\n\nParameters:\n  m -- source Map[K V]\n  h -- precomputed content hash of key\n  key -- key of type K\n  val -- value of type V\n  keyeq -- a captureless (c-fn [K K] bool) used to compare keys that share a\n   -- hash. Must carry no environment (it is called as a bare C function\n   -- pointer); pass a top-level defn or a captureless lambda, or a\n   -- MapKey carrier comparator like tur-int-carrier-eq? /\n   -- tur-cstr-key-eq?. A capturing closure is rejected at compile time.\n\nReturns:\n  A new Map[K V] with the entry inserted or updated. Keys that are equal\n    under keyeq (not just identical pointers) collapse to one entry.\n\nExample:\n  (map-assoc-eq m (cstr-hash k) k v tur-cstr-key-eq?)\n\nSince: TCE4"},
    {"map-get-eq", "map-get-eq -- look up a key using an explicit hash and key-equality fn.\n\nParameters:\n  m -- Map[K V]\n  h -- precomputed content hash of key\n  key -- key of type K\n  keyeq -- key comparison fn (see map-assoc-eq)\n\nReturns:\n  The value of type V, or 0 (none) if absent.\n\nExample:\n  (map-get-eq m (cstr-hash k) k tur-cstr-key-eq?)\n\nSince: TCE4"},
    {"map-has-eq?", "map-has-eq? -- key-existence test using an explicit hash and equality fn.\n\nParameters:\n  m -- Map[K V]\n  h -- precomputed content hash of key\n  key -- key of type K\n  keyeq -- key comparison fn (see map-assoc-eq)\n\nReturns:\n  true if the key is present under keyeq, false otherwise.\n\nExample:\n  (map-has-eq? m (cstr-hash k) k tur-cstr-key-eq?)  ; => true or false\n\nSince: TCE4"},
    {"map-dissoc-eq", "map-dissoc-eq -- remove a key using an explicit hash and equality fn.\n\nParameters:\n  m -- source Map[K V]\n  h -- precomputed content hash of key\n  key -- key of type K\n  keyeq -- key comparison fn (see map-assoc-eq)\n\nReturns:\n  A new Map[K V] with the key removed.\n\nExample:\n  (map-dissoc-eq m (cstr-hash k) k tur-cstr-key-eq?)\n\nSince: TCE4"},
    {"cstr-hash", "cstr-hash -- xxHash64 of a NUL-terminated string's contents.\n\nParameters:\n  s -- the string to hash\n\nReturns:\n  The 64-bit content hash, so equal text hashes equally regardless of\n    pointer identity.\n\nExample:\n  (cstr-hash \"key\")  ; => <stable content hash>\n\nSince: TCE4"},
    {"tur-cstr-key-eq?", "tur-cstr-key-eq? -- internal: content equality of two string keys."},
    {"tur-int-carrier-eq?", "============================================================================"},
    {"tur-f32-carrier-eq?", "tur-f32-carrier-eq? -- carrier comparator for :float32 keys."},
    {"tur-f64-carrier-eq?", "tur-f64-carrier-eq? -- carrier comparator for :float (float64) keys."},
    {"MapKey", "MapKey [int] -- one-word identity carrier; integer-equality comparator."},
    {"tur-map-kcheck", "============================================================================"},
    {"tur-wide-byval?", "map-assoc -- insert or update a key/value pair; returns a new map.\n\nParameters:\n  m -- source Map[K V]\n  key -- key of type K (must satisfy Hash[K] and MapKey[K]).\n   -- Inline float keys (:float32 / :float) are bit-reinterpreted into\n   -- the carrier and compared by value; cstr keys are compared by\n   -- content; one-word keys are unchanged.\n  val -- value of type V (any type: scalar, float, or a heap handle)\n\nReturns:\n  A new Map[K V] with the entry inserted or updated. Keys equal under\n    Eq[K] (not just identical) collapse to one entry.\n\nExample:\n  (map-assoc (:: (map-new) (Map cstr int)) \"name\" 1)  ; => Map {\"name\" -> 1}\n    (map-assoc (:: (map-new) (Map int int)) 42 100)     ; => Map {42 -> 100}\n\nSince: multiword-value-box-lifecycle"},
    {"tur-rc-value?", "tur-rc-value? -- 1 if V is an rc<T>, else 0.  The refcount-side twin of\n\nSince: collections-cannot-hold-rc-values (map side, step c)"},
    {"map-assoc", "map-assoc"},
    {"map-get", "map-get -- look up a key; returns the value or 0 (none) if absent.\n\nParameters:\n  m -- Map[K V]\n  key -- key of type K (must satisfy Hash[K] and MapKey[K])\n\nReturns:\n  The value of type V, or 0 (none) if absent. For a non-int value type read\n    the result with an ascription, e.g. (:: (map-get m k) :float). When V is\n    `any` a miss is the nil box (falsy under Saffron truthiness), on both\n    back ends.\n\nExample:\n  (map-get m \"name\")  ; => value or 0\n\nSince: Phase TMS3 (macro accessor; was map-get-g; GHE3)"},
    {"map-has?", "map-has? -- check whether a key exists in the map.\n\nParameters:\n  m -- Map[K V]\n  key -- key of type K (must satisfy Hash[K] and MapKey[K])\n\nReturns:\n  true if the key is present under Eq[K], false otherwise.\n\nExample:\n  (map-has? m \"name\")  ; => true or false\n\nSince: Phase TMS3 (macro accessor; was map-has-g?; GHE3)"},
    {"map-dissoc", "map-dissoc -- remove a key from the map; returns a new map.\n\nParameters:\n  m -- source Map[K V]\n  key -- key of type K (must satisfy Hash[K] and MapKey[K])\n\nReturns:\n  A new Map[K V] with the key removed.\n\nExample:\n  (map-dissoc m \"name\")  ; => map without \"name\"\n\nSince: Phase TMS3 (macro accessor; was map-dissoc-g; GHE3)"},
    {"map-count", "map-count -- return the number of entries in the map.\n\nParameters:\n  m -- Map[K V]\n\nReturns:\n  Integer count of key/value pairs.\n\nExample:\n  (map-count my-map)  ; => 3\n\nSince: Phase TM0"},
    {"map-merge", "map-merge -- merge two maps; values from b win on key collision.\n\nParameters:\n  a -- first Map[K V]\n  b -- second Map[K V] (wins on collision)\n\nReturns:\n  A new Map[K V] containing all entries from both maps.\n\nExample:\n  (map-merge map-a map-b)  ; => merged map\n\nSince: Phase TM0"},
    {"map-free", "map-free -- free the Map wrapper (does not free HAMT; use map-free-all for that).\n\nParameters:\n  m -- Map[K V] to free\n\nExample:\n  (map-free my-map)\n\nSince: Phase TM0"},
    {"map-eq-raw?", "map-eq? -- compare two maps for structural equality using a value comparator.\n\nParameters:\n  m1 -- first Map[K V]\n  m2 -- second Map[K V]\n  val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair\n\nReturns:\n  true if both maps have identical keys and all corresponding values satisfy val-cmp.\n\nExample:\n  (map-eq? ma mb (fn [a b] (= a b)))  ; => true\n\nSince: Phase TM0"},
    {"map-eq?", "map-eq? -- typed structural equality over Map[K V] (delegates to map-eq-raw?).\n\nParameters:\n  m1 -- first Map[K V]\n  m2 -- second Map[K V]\n  val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair\n\nReturns:\n  true if both maps have identical keys and all corresponding values satisfy val-cmp.\n\nSince: Phase TM0 (typed surface: TMS3)"},
    {"map-eq-raw-k?", "map-eq-raw-k? -- like map-eq-raw? but compares keys with an explicit"},
    {"map-eq-k?", "map-eq-k? -- structural equality over Map[K V] with an explicit key"},
    {"map-eq-dynamic", "Eq [Map] -- structural equality using the value type's Eq instance."},
    {"map-iter-cur-val-as", "map-iter-cur-val-as -- typed read of an iter box's current value."},
    {"map-get-dynamic-as", "map-get-dynamic-as -- typed lookup against m2's hamt, threading m1's"},
    {"map-eq-loop", "map-eq-loop -- pure-Turmeric structural-equality walk over m1's HAMT.\n\nParameters:\n  iter -- hamt/iter-alloc-allocated handle scanning m1\n  m2-hamt -- raw HAMT pointer of the second map (from map-hamt)\n  keyeq -- stamped key comparator (from hamt/keyeq on m1's hamt)\n  val-cmp -- value comparator fn [a :V b :V] :bool\n\nReturns:\n  true iff every entry of m1 is present in m2 under keyeq with an\n    equal value under val-cmp.\n\nSince: Phase TCO-Eq-MapSet"},
    {"map-eq-driver", "map-eq-driver -- allocate the iter box, run map-eq-loop, free.\n\nSince: Phase TCO-Eq-MapSet"},
    {"map-assoc-consuming__", "map-assoc-consuming__ -- internal: assoc, then free the map assoc'd INTO."},
    {"hamt-assoc-each__", "hamt-assoc-each__ -- internal helper for the hamt-of macro."},
    {"tur-map-homog__", "tur-map-homog__ -- internal: compile-time homogeneity check (see vec.tur)."},
    {"hamt-homog-chain__", "hamt-homog-chain__ -- internal: enforce homogeneous keys and values."},
    {"hamt-of", "hamt-of -- variadic Map literal: alternating key/value arguments.\n\nParameters:\n   -- & kvs -- an even number of arguments, alternating key then value.\n   -- Keys may be any Hash/MapKey scalar type K (:int, :cstr, :bool,\n   -- :float32, :float); all keys must unify to a single K and all\n   -- values to a single V, else TUR-E0001 on the offending element.\n   -- String keys are compared by content; int/bool by value; float\n   -- keys round-trip by value.\n\nReturns:\n  A fresh Map[K V] populated with the given entries; later duplicate keys\n    win.  map-get returns the value type V, so a non-int value is read with\n    an ascription, e.g. (:: (map-get m k) :cstr).\n  \n  Note: this is the lowering target of the #map{...} data literal\n    (-Xdata-literals).  Writing #map{:a 1 :b 2} is preferred over calling\n    hamt-of directly.  A non-empty literal is seeded from a value-pinned\n    empty (map-empty-for) so the key/value types flow from the first pair;\n    an empty (hamt-of) yields a bare (map-new) that must be annotated by the\n    surrounding context.\n\nExample:\n  (hamt-of)              ; => empty Map (annotate at the binding site)\n    (hamt-of 1 10 2 20)    ; => Map {1 -> 10, 2 -> 20}\n    (hamt-of \"a\" 1 \"b\" 2)  ; => Map {\"a\" -> 1, \"b\" -> 2}, content-keyed\n\nSince: DL1 (data-literals-plan); typed surface: TMS3"},
    {"tur/map", "tur/map -- typed Map[K V]: persistent hash map requiring Hash[K] and MapKey[K].\n\nSince: Phase TM0 (typed surface: Phase TMS2)"},
    {"sqrt", "sqrt -- square root of a float (double precision).\n\nParameters:\n  x -- non-negative float value\n\nReturns:\n  The square root of x.\n\nExample:\n  (sqrt 2.0)  ; => 1.41421\n\nSince: Phase B1"},
    {"fabs", "fabs -- absolute value of a float.\n\nParameters:\n  x -- float value\n\nReturns:\n  The absolute value of x.\n\nExample:\n  (fabs -3.5)  ; => 3.5\n\nSince: Phase B1"},
    {"floor", "floor -- largest integer not greater than x.\n\nParameters:\n  x -- float value\n\nReturns:\n  Floor of x as a float.\n\nExample:\n  (floor 3.7)  ; => 3\n\nSince: Phase B1"},
    {"ceil", "ceil -- smallest integer not less than x.\n\nParameters:\n  x -- float value\n\nReturns:\n  Ceiling of x as a float.\n\nExample:\n  (ceil 3.2)  ; => 4\n\nSince: Phase B1"},
    {"pow", "pow -- x raised to the power y.\n\nParameters:\n  x -- base value\n  y -- exponent\n\nReturns:\n  x^y as a float.\n\nExample:\n  (pow 2.0 10.0)  ; => 1024\n\nSince: Phase B1"},
    {"exp", "exp -- e raised to the power x.\n\nParameters:\n  x -- float exponent\n\nReturns:\n  e^x.\n\nExample:\n  (exp 1.0)  ; => 2.71828\n\nSince: Phase N2"},
    {"log", "log -- natural logarithm of a float.\n\nParameters:\n  x -- positive float value\n\nReturns:\n  ln(x).\n\nExample:\n  (log 2.718281828459045)  ; => 1\n\nSince: Phase N2"},
    {"sin", "sin -- sine of an angle in radians.\n\nParameters:\n  x -- angle in radians\n\nReturns:\n  sin(x).\n\nExample:\n  (sin 0.5)  ; => 0.479426\n\nSince: Phase N2"},
    {"cos", "cos -- cosine of an angle in radians.\n\nParameters:\n  x -- angle in radians\n\nReturns:\n  cos(x).\n\nExample:\n  (cos 0.5)  ; => 0.877583\n\nSince: Phase N2"},
    {"atan2", "atan2 -- principal arc tangent of y/x, using the signs of both arguments\n\nParameters:\n  y -- ordinate\n  x -- abscissa\n\nReturns:\n  The angle in radians in (-pi, pi].\n\nExample:\n  (atan2 1.5 0.0)  ; => 1.5708\n\nSince: Phase N2"},
    {"int->float", "int->float -- convert an integer to a float via numeric cast.\n\nParameters:\n  n -- integer value\n\nReturns:\n  The integer converted to a double-precision float.\n\nExample:\n  (int->float 42)  ; => 42\n\nSince: Phase B1"},
    {"float->int", "float->int -- truncate a float to an integer.\n\nParameters:\n  x -- float value\n\nReturns:\n  The float truncated toward zero as an int.\n\nExample:\n  (float->int 3.9)  ; => 3\n\nSince: Phase B1"},
    {"printf-float6", "printf-float6 -- print a float to stdout with 6 decimal places followed by a\n\nParameters:\n  x -- float value to print\n\nSince: Phase B1"},
    {"tan", "tan -- tangent of a float (radians).\n\nParameters:\n  x -- angle in radians\n\nReturns:\n  tan(x).\n\nExample:\n  (tan 0.0)  ; => 0\n\nSince: r7rs-lang-plan R5"},
    {"asin", "asin -- arc sine of a float.\n\nParameters:\n  x -- a value in [-1, 1]\n\nReturns:\n  asin(x), in radians.\n\nExample:\n  (asin 1.0)  ; => 1.5708\n\nSince: r7rs-lang-plan R5"},
    {"acos", "acos -- arc cosine of a float.\n\nParameters:\n  x -- a value in [-1, 1]\n\nReturns:\n  acos(x), in radians.\n\nExample:\n  (acos 1.0)  ; => 0\n\nSince: r7rs-lang-plan R5"},
    {"atan", "atan -- arc tangent of a float (one argument; see atan2 for two).\n\nParameters:\n  x -- any float\n\nReturns:\n  atan(x), in radians.\n\nExample:\n  (atan 1.0)  ; => 0.785398\n\nSince: r7rs-lang-plan R5"},
    {"trunc", "trunc -- round a float toward zero.\n\nParameters:\n  x -- any float\n\nReturns:\n  The integral float nearest x in the direction of zero.\n\nExample:\n  (trunc -7.1)  ; => -7\n\nSince: r7rs-lang-plan R5"},
    {"rint", "rint -- round a float to the nearest integral float, ties to even.\n\nParameters:\n  x -- any float\n\nReturns:\n  The nearest integral float, ties to even.\n\nExample:\n  (rint 6.5)  ; => 6\n\nSince: r7rs-lang-plan R5"},
    {"tur/math", "tur/math -- thin wrappers around libm functions (sin, cos, sqrt, ...).\n\nSince: Phase B1"},
    {"Mutex", "Mutex"},
    {"mutex-new", "mutex-new -- allocate and initialise a new POSIX mutex.\n\nReturns:\n  A Mutex handle to a heap-allocated pthread_mutex_t.\n\nExample:\n  (let [m (mutex-new)] ...)  ; => Mutex\n\nSince: Phase T19-C"},
    {"mutex-lock", "mutex-lock -- acquire the mutex, blocking until it is available.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nExample:\n  (mutex-lock m)\n\nSince: Phase T19-C"},
    {"mutex-unlock", "mutex-unlock -- release the mutex.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nExample:\n  (mutex-unlock m)\n\nSince: Phase T19-C"},
    {"mutex-try-lock", "mutex-try-lock -- attempt to acquire the mutex without blocking.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nReturns:\n  true if the mutex was successfully acquired; false if it was already held.\n\nExample:\n  (if (mutex-try-lock m) ...)  ; => bool\n\nSince: Phase T19-C"},
    {"mutex-free", "mutex-free -- destroy the mutex and release its memory.\n\nParameters:\n  m -- mutex handle returned by mutex-new\n\nExample:\n  (mutex-free m)\n\nSince: Phase T19-C"},
    {"with-lock", "with-lock -- run body with the mutex held, releasing it afterwards.\n\nParameters:\n  m -- a Mutex handle (borrowed; with-lock does not consume or free it)\n  body -- one or more forms; the last one's value is returned\n\nReturns:\n  The value of the last body form.\n\nExample:\n  (let [m (mutex-new)]\n      (println (with-lock m (+ 1 41)))   ; => 42\n      (mutex-free m))\n  \n  Two caveats worth knowing:\n  \n  `m` is evaluated twice -- once to lock, once to unlock -- so pass a\n  VARIABLE, not a call. `(with-lock (get-mutex) ...)` would lock one mutex\n  and unlock whatever the second call returns. A macro cannot bind it once\n  instead, because `Mutex` is `:linear`: a `let` binding moves the handle,\n  and the checker then rejects the scope for dropping it unconsumed\n  (TUR-E0100).\n  \n  The unlock is not panic-safe. If the body panics, the mutex stays locked.\n  Guarding against that needs the unlock on an unwind path, which\n  `catch-unwind` can express at the call site when it matters.\n\nSince: 2026-08-20"},
    {"tur/mutex", "tur/mutex -- POSIX mutex (pthread_mutex_t) wrapped as ptr<void>.\n\nSince: Phase T19-C"},
    {"MutableMap", "MutableMap -- parameterized in-place hash table with key K, value V.\n\nSince: Phase F5 (cross-plan-followups)"},
    {"mutmap-new", "mutmap-new -- create a new empty MutableMap[K V] with default\n\nReturns:\n  An empty MutableMap[K V].  K/V are inferred from later use\n    (e.g. the first mutmap-set!), like vec-new's element type.\n\nExample:\n  (mutmap-new)  ; => empty MutableMap\n\nSince: Phase F5"},
    {"mutmap-len", "mutmap-len -- live entry count (excludes tombstones).\n\nParameters:\n  m -- MutableMap[K V]\n\nReturns:\n  Number of live (key, value) entries.\n\nExample:\n  (mutmap-len mm)  ; => 0\n\nSince: Phase F5"},
    {"mutmap-set!", "mutmap-set! -- insert or update (key, value).  Mutates m in place.\n\nParameters:\n  m -- MutableMap[K V]\n  h -- precomputed hash of key (Hash[K])\n  key -- key\n  val -- value\n\nReturns:\n  nil.\n\nExample:\n  (mutmap-set! mm 1 1 100)\n\nSince: Phase F5"},
    {"mutmap-get", "mutmap-get -- look up the value bound to key, or 0 if absent.\n\nParameters:\n  m -- MutableMap[K V]\n  h -- precomputed hash of key (Hash[K])\n  key -- key\n\nReturns:\n  The bound value, or 0 if key is not present.  Callers needing\n    to distinguish \"absent\" from \"value = 0\" should use\n    mutmap-has? first.\n\nExample:\n  (mutmap-get mm 1 1)  ; => 100\n\nSince: Phase F5"},
    {"mutmap-has?", "mutmap-has? -- check whether key is present.\n\nParameters:\n  m -- MutableMap[K V]\n  h -- precomputed hash of key\n  key -- key\n\nReturns:\n  true if key is present (value of any kind), false otherwise.\n\nExample:\n  (mutmap-has? mm 1 1)  ; => true\n\nSince: Phase F5"},
    {"mutmap-delete!", "mutmap-delete! -- remove (key, value) if present.  Mutates m\n\nParameters:\n  m -- MutableMap[K V]\n  h -- precomputed hash of key\n  key -- key\n\nReturns:\n  true if key was present (and is now removed), false otherwise.\n\nExample:\n  (mutmap-delete! mm 1 1)  ; => true\n\nSince: Phase F5"},
    {"mutmap-cap", "mutmap-cap -- slot-array capacity (number of probe slots, a power of two).\n\nParameters:\n  m -- MutableMap[K V]\n\nReturns:\n  The backing storage capacity (>= mutmap-len; includes EMPTY and\n    DELETED slots).  Used as the iteration bound for mutmap-slot-* walks.\n\nExample:\n  (mutmap-cap mm)  ; => 16\n\nSince: Phase F5"},
    {"mutmap-slot-occupied?", "mutmap-slot-occupied? -- is slot i a live (OCCUPIED) entry?\n\nParameters:\n  m -- MutableMap[K V]\n  i -- slot index in [0, mutmap-cap m)\n\nReturns:\n  true iff slot i holds a live entry (not EMPTY, not a DELETED tombstone).\n\nExample:\n  (mutmap-slot-occupied? mm 0)  ; => true / false\n\nSince: Phase F5"},
    {"mutmap-slot-hash", "mutmap-slot-hash -- precomputed hash stored in slot i.\n\nParameters:\n  m -- MutableMap[K V]\n  i -- slot index in [0, mutmap-cap m)\n\nReturns:\n  The hash recorded for slot i (meaningful only when the slot is OCCUPIED).\n\nExample:\n  (mutmap-slot-hash mm 0)\n\nSince: Phase F5"},
    {"mutmap-slot-key", "mutmap-slot-key -- key stored in slot i.\n\nParameters:\n  m -- MutableMap[K V]\n  i -- slot index in [0, mutmap-cap m)\n\nReturns:\n  The key in slot i (meaningful only when the slot is OCCUPIED).\n\nExample:\n  (mutmap-slot-key mm 0)\n\nSince: Phase F5"},
    {"mutmap-slot-value", "mutmap-slot-value -- value stored in slot i.\n\nParameters:\n  m -- MutableMap[K V]\n  i -- slot index in [0, mutmap-cap m)\n\nReturns:\n  The value in slot i (meaningful only when the slot is OCCUPIED).\n\nExample:\n  (mutmap-slot-value mm 0)\n\nSince: Phase F5"},
    {"mutmap-eq-storage?", "mutmap-eq-storage? -- structural equality over two raw storage pointers."},
    {"mutmap-eq-loop", "mutmap-eq-loop -- pure-Turmeric structural-equality walk (self-tail slot loop).\n\nParameters:\n  m1 -- first MutableMap[K V]\n  m2 -- second MutableMap[K V]\n  i -- current slot index (start at 0)\n  cap -- slot bound (mutmap-cap m1)\n  val-cmp -- value comparator fn [a :V b :V] :bool\n\nReturns:\n  true iff every live entry of m1[i..cap) is present in m2 with an\n    equal value under val-cmp.\n\nExample:\n  (mutmap-eq-loop a b 0 (mutmap-cap a) (fn [x y] (= x y)))\n\nSince: Phase F5"},
    {"mutmap-eq?", "mutmap-eq? -- structural equality.  Two MutableMap[K V]s are equal iff\n\nParameters:\n  m1 -- MutableMap[K V]\n  m2 -- MutableMap[K V]\n  val-cmp -- comparator fn [a :int b :int] :bool for values\n\nReturns:\n  true iff m1 and m2 have the same set of (key, value) pairs.\n\nExample:\n  (mutmap-eq? ma mb (fn [a b] (= a b)))\n\nSince: Phase F5"},
    {"mutmap-free", "mutmap-free -- free the storage and wrapper.\n\nParameters:\n  m -- MutableMap[K V] to free\n\nExample:\n  (mutmap-free mm)\n\nSince: Phase F5"},
    {"tur/mutmap", "tur/mutmap -- MutableMap[K V]: mutable open-addressed hash table.\n\nSince: Phase F5"},
    {"Nat", "Nat"},
    {"nat-zero", "nat-zero -- construct the Zero natural number.\n\nReturns:\n  A (Nat) value representing zero.\n\nExample:\n  (nat-zero)  ; => Zero\n\nSince: Phase G4"},
    {"nat-succ", "nat-succ -- construct the successor of a natural number.\n\nParameters:\n  n -- the predecessor (Nat) value\n\nReturns:\n  A (Nat) value representing n+1.\n\nExample:\n  (nat-succ (nat-zero))  ; => Succ(Zero)\n\nSince: Phase G4"},
    {"nat-to-int", "nat-to-int -- convert a type-level Nat to a runtime integer.\n\nParameters:\n  n -- the (Nat) value to convert\n\nReturns:\n  The integer representation of n.\n\nExample:\n  (nat-to-int (Succ (Succ (Zero))))  ; => 2\n\nSince: Phase G4"},
    {"nat-add", "nat-add -- add two type-level Nat values.\n\nParameters:\n  a -- first (Nat) value\n  b -- second (Nat) value\n\nReturns:\n  A (Nat) representing a + b.\n\nExample:\n  (nat-to-int (nat-add (Succ (Zero)) (Succ (Succ (Zero)))))  ; => 3\n\nSince: Phase G4"},
    {"tur/nat", "tur/nat -- type-level natural numbers via GADT for phantom length annotations.\n\nSince: Phase G4"},
    {"Socket", "[linear] Socket -- a linear (exactly-once) wrapper around a POSIX socket fd.\n\nSince: LT4"},
    {"socket-fd", "socket-fd -- return the underlying file descriptor from a Socket as an Fd.\n\nParameters:\n  s -- a Socket value.\n\nReturns:\n  The underlying file descriptor wrapped as an Fd.\n\nExample:\n  (socket-fd my-socket)  ; => Fd wrapping 5\n\nSince: LT4"},
    {"socket-valid?", "socket-valid? -- return true if the Socket wraps a non-negative fd.\n\nParameters:\n  s -- a Socket value.\n\nReturns:\n  true if fd >= 0, false otherwise.\n\nExample:\n  (socket-valid? my-socket)  ; => true\n\nSince: LT4"},
    {"socket-close", "socket-close -- close a Socket and release the underlying fd.\n\nParameters:\n  s -- a Socket to close (by value; handle is consumed).\n\nReturns:\n  0 on success, -1 on error.\n\nExample:\n  (socket-close my-socket)  ; => 0\n\nSince: LT4"},
    {"tur/net", "tur/net -- stub networking type (Socket) for linear resource tracking.\n\nSince: Phase LT4"},
    {"Option", "tur/option -- typed Option[A]: parameterized optional value.\n\nSince: Phase TC1"},
    {"some", "some -- wrap a value of type A in a some Option[A].\n\nParameters:\n  x -- the value to wrap (type A)\n\nReturns:\n  An Option[A] carrying the Some variant.\n\nExample:\n  (some 42)  ; => some(42)\n\nSince: Phase TC1"},
    {"none", "none -- return the none Option[A].\n\nReturns:\n  The None variant.  (SR3 slice A: on the carrier path None IS the null\n    carrier -- construction allocates nothing, and every reader treats 0 as\n    none.  A tagged None box remains valid on the read side.)\n\nExample:\n  (none)  ; => none\n\nSince: Phase TC1"},
    {"some?", "some? -- check whether an Option[A] contains a value.\n\nParameters:\n  o -- Option[A]\n\nReturns:\n  true if o is some, false if o is none.\n\nExample:\n  (some? (some 1))  ; => true\n    (some? (none))    ; => false\n\nSince: Phase TC1"},
    {"none?", "none? -- check whether an Option[A] is empty.\n\nParameters:\n  o -- Option[A]\n\nReturns:\n  true if o is none, false if o is some.\n\nExample:\n  (none? (none))    ; => true\n    (none? (some 1))  ; => false\n\nSince: 2026-08-20"},
    {"unwrap", "unwrap -- extract the value from a typed Option[A].\n\nParameters:\n  o -- Option[A]\n\nReturns:\n  The contained value of type A; the zero value of A when o is none\n    (preserving the pre-sum behaviour, where none's dead value slot held\n    `(default-of A)`).\n\nExample:\n  (unwrap (some 7))  ; => 7\n\nSince: Phase TC1"},
    {"unwrap-or", "unwrap-or -- extract the value or return a default.\n\nParameters:\n  o -- Option[A]\n  dflt -- value to return if o is none (type A)\n\nReturns:\n  The contained value, or default if none.\n\nExample:\n  (unwrap-or (none) 99)   ; => 99\n    (unwrap-or (some 7) 99) ; => 7\n\nSince: Phase TC1"},
    {"unwrap-or-carrier", "unwrap-or-carrier -- carrier-ABI shim for the Track A cascade: extract the"},
    {"option-free", "option-free -- free a heap-allocated Option[A].\n\nParameters:\n  o -- Option[A] to free (may be none / 0)\n\nExample:\n  (option-free my-opt)\n\nSince: Phase TC1"},
    {"option-map", "option-map -- apply a function to the contained value if some.\n\nParameters:\n  o -- Option[A]\n  f -- function A -> B\n\nReturns:\n  Option[B] with f applied if some, or none.\n\nExample:\n  (option-map (some 3) (fn [x] (* x 2)))  ; => some(6)\n  \n  Note:\n    Mapping over a *literal* `(none)` with an *unannotated* lambda leaves the\n    element type under-determined (`(none)` carries no element type) and fails\n    to compile -- annotate the lambda or map over a typed Option value. See\n    docs/archive/history/option-map-literal-none-unannotated-fn-no-A-inference.md.\n\nSince: Phase TC1"},
    {"option-eq?", "option-eq? -- compare two Option[A] values using a comparator.\n\nParameters:\n  o1 -- first Option[A]\n  o2 -- second Option[A]\n  cmp-fn -- comparator fn [a :int b :int] :bool\n\nReturns:\n  true if both none, or both some with equal values.\n\nExample:\n  (option-eq? (some 1) (some 1) (fn [a b] (= a b)))  ; => true\n\nSince: Phase TC1"},
    {"TurMutCell", "TurMutCell -- internal: the shared heap cell of a `^mut` a lambda captures.\n\nSince: v0.56"},
    {"Pair", "Pair -- parameterized two-element tuple with element types A and B.\n\nSince: Phase TC1"},
    {"pair", "pair -- construct a Pair[A B].\n\nParameters:\n  a -- first element (type A)\n  b -- second element (type B)\n\nReturns:\n  A Pair[A B] value.\n\nExample:\n  (pair 1 2)  ; => (1, 2)\n\nSince: Phase TC1"},
    {"pair-fst", "pair-fst -- return the first element of a Pair[A B].\n\nParameters:\n  p -- Pair[A B]\n\nReturns:\n  The first element of type A.\n\nExample:\n  (pair-fst (pair 10 20))  ; => 10\n\nSince: Phase TC1"},
    {"pair-snd", "pair-snd -- return the second element of a Pair[A B].\n\nParameters:\n  p -- Pair[A B]\n\nReturns:\n  The second element of type B.\n\nExample:\n  (pair-snd (pair 10 20))  ; => 20\n\nSince: Phase TC1"},
    {"pair-free", "pair-free -- compatibility no-op for Pair[A B] values.\n\nParameters:\n  p -- Pair[A B]\n\nExample:\n  (pair-free my-pair)\n\nSince: Phase TC1"},
    {"pair-eq?", "pair-eq? -- compare two Pair[A B] values element-wise.\n\nParameters:\n  p1 -- first Pair[A B]\n  p2 -- second Pair[A B]\n  fst-cmp -- comparator for first element fn [a :int b :int] :bool\n  snd-cmp -- comparator for second element fn [a :int b :int] :bool\n\nReturns:\n  true if both first and second elements are equal under their comparators.\n\nExample:\n  (pair-eq? (pair 1 2) (pair 1 2) (fn [a b] (= a b)) (fn [a b] (= a b)))  ; => true\n\nSince: Phase TC1"},
    {"pair-eq-carrier?", "pair-eq-carrier? -- legacy carrier-ABI helper used inside Pair's Eq instance."},
    {"tur/pair", "tur/pair -- typed Pair[A B]: parameterized two-element tuple.\n\nSince: Phase TC1-F"},
    {"Panic", "Panic"},
    {"result-panic", "result-panic -- extract the Panic handle from a caught (err ...) result.\n\nParameters:\n  r -- the :int result box returned by catch-unwind / catch-panic-of\n\nReturns:\n  The opaque Panic handle from the err slot (0 when r is ok).\n\nExample:\n  (let [r (catch-unwind (fn [] :int (panic \"boom\")))]\n      (panic-message (result-panic r)))  ; => \"boom\"\n\nSince: Phase R2"},
    {"panic-message", "panic-message -- the message string carried by a caught Panic.\n\nParameters:\n  p -- a Panic handle (see result-panic)\n\nReturns:\n  The panic message for a string panic, or \"\" when none is available.\n\nSince: Phase R2"},
    {"panic-file", "panic-file -- source file of the panic call site.\n\nParameters:\n  p -- a Panic handle\n\nReturns:\n  The source file path, or \"\" when unknown.\n\nSince: Phase R2"},
    {"panic-line", "panic-line -- source line of the panic call site.\n\nParameters:\n  p -- a Panic handle\n\nReturns:\n  The source line, or 0 when unknown.\n\nSince: Phase R2"},
    {"panic-type", "panic-type -- the TypeKind tag of the panic payload.\n\nParameters:\n  p -- a Panic handle\n\nReturns:\n  The integer TypeKind of the boxed payload (e.g. the tag for :cstr for a\n    plain string panic), or 0 when unknown.\n\nSince: Phase R2"},
    {"tur/panic", "stdlib/panic -- inspect panics recovered by catch-unwind.\n\nSince: Phase R2"},
    {"Parser", "Parser -- a kind-(* -> *) handle over a backtracking parser; carrier is the\n\nSince: stdlib-hkt-consolidation T2"},
    {"pair-new", "pair-new -- allocate a new Pair holding two int64_t values.\n\nParameters:\n  a -- the first field value.\n  b -- the second field value.\n\nReturns:\n  Pointer (as int64_t) to a heap-allocated Pair{first=a, second=b}.\n\nExample:\n  (pair-new 1 2)  ; => Pair{first=1, second=2}"},
    {"pair-first", "pair-first -- extract the first field from a Pair.\n\nParameters:\n  p -- pointer (as int64_t) to a Pair.\n\nReturns:\n  The int64_t value stored in the first field.\n\nExample:\n  (pair-first (pair-new 7 8))  ; => 7"},
    {"pair-second", "pair-second -- extract the second field from a Pair.\n\nParameters:\n  p -- pointer (as int64_t) to a Pair.\n\nReturns:\n  The int64_t value stored in the second field.\n\nExample:\n  (pair-second (pair-new 7 8))  ; => 8"},
    {"input-new", "input-new -- create a new Input from a C string and a starting position.\n\nParameters:\n  s -- the source string (:cstr).\n  pos -- the initial character position (0-based).\n\nReturns:\n  Pointer (as int64_t) to a heap-allocated Input{str, pos}.\n\nExample:\n  (input-new \"hello\" 0)  ; => Input at position 0"},
    {"input-at-end", "input-at-end -- test whether an Input is at the end of its string.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nReturns:\n  true if the current character is '\\0', false otherwise.\n\nExample:\n  (input-at-end (input-new \"\" 0))  ; => true"},
    {"input-current-char", "input-current-char -- return the character at the current position.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nReturns:\n  The ASCII code of the current character as an int64_t (unsigned byte).\n\nExample:\n  (input-current-char (input-new \"abc\" 0))  ; => 97  ; 'a'"},
    {"input-advance", "input-advance -- return a new Input advanced by one character.\n\nParameters:\n  inp -- pointer (as int64_t) to the current Input.\n\nReturns:\n  A new heap-allocated Input with pos incremented by 1.\n\nExample:\n  (input-pos (input-advance (input-new \"ab\" 0)))  ; => 1"},
    {"input-pos", "input-pos -- return the current position index of an Input.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nReturns:\n  The int64_t character offset into the source string.\n\nExample:\n  (input-pos (input-new \"abc\" 2))  ; => 2"},
    {"input-remaining", "input-remaining -- count bytes remaining in an Input.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nReturns:\n  The number of bytes from the current position to the terminating '\\0'.\n\nExample:\n  (input-remaining (input-new \"abc\" 1))  ; => 2"},
    {"input-rest", "input-rest -- the unread suffix of an Input, as a borrowed cstr.\n\nParameters:\n  inp -- pointer (as int64_t) to an Input.\n\nReturns:\n  A pointer into the source string at the current position (not a copy).\n\nExample:\n  (input-rest (input-new \"abc\" 1))  ; => \"bc\""},
    {"apply-fat", "apply-fat -- invoke a fat closure with one argument.\n\nParameters:\n  f -- pointer (as int64_t) to a fat closure.\n  arg -- the single int64_t argument to pass.\n\nReturns:\n  The int64_t return value of the closure.\n\nExample:\n  (apply-fat my-fn 42)  ; => result of calling my-fn with 42"},
    {"apply-parser", "apply-parser -- run a parser fat closure against an Input.\n\nParameters:\n  p -- pointer (as int64_t) to a parser fat closure.\n  inp -- pointer (as int64_t) to the Input to parse.\n\nReturns:\n  A Cell list of Pair(value, remaining-Input) results.\n\nExample:\n  (apply-parser (item-raw) (input-new \"a\" 0))  ; => Cell{Pair(97, Input@1)}"},
    {"pfail-raw", "pfail-raw -- carrier worker behind pfail: a parser with no results."},
    {"pfail", "pfail -- a Parser that always fails, consuming no input.\n\nReturns:\n  A (Parser A) that yields no results for any input. This is the\n    `Alternative`/`MonadPlus` zero for parsers (see `empty`).\n\nExample:\n  (run-parser-full (:: (pfail) (Parser Char)) \"abc\")  ; => (none)\n\nSince: stdlib-hkt-consolidation T2"},
    {"pure-impl", "pure-impl -- internal implementation for pure.\n\nParameters:\n  _v -- the value to return.\n  inp -- the current Input (passed through unchanged)."},
    {"pure-parser", "pure-parser -- carrier worker behind `Applicative [Parser]`'s `pure`.\n\nParameters:\n  v -- the value to embed in the parse result.\n\nReturns:\n  A parser that returns Pair(v, inp) without advancing the input.\n\nExample:\n  (apply-parser (pure-parser 99) (input-new \"\" 0))  ; => Cell{Pair(99, Input@0)}"},
    {"item-impl", "item-impl -- internal implementation for item.\n\nParameters:\n  inp -- the current Input."},
    {"item-raw", "item-raw -- carrier worker behind item: yields the next byte's code."},
    {"item", "item -- a Parser that consumes exactly one character.\n\nReturns:\n  A (Parser Char) yielding the next character, or failing at the end of\n    the input.\n\nExample:\n  (parse-first (item) \"A\")  ; => #\\A\n\nSince: Phase B1 (Char: parsec-guide-plan P3)"},
    {"satisfy-impl", "satisfy-impl -- internal implementation for satisfy.\n\nParameters:\n  pred -- the character predicate.\n  inp -- the current Input."},
    {"satisfy", "satisfy -- a Parser for one character that passes a predicate.\n\nParameters:\n  pred -- (fn [Char] bool), true for the characters to accept\n\nReturns:\n  A (Parser Char) that consumes the next character when (pred c) holds,\n    and fails (consuming nothing) otherwise or at the end of the input.\n\nExample:\n  (parse-first (satisfy digit?) \"7\")  ; => #\\7\n    (run-parser-full (satisfy digit?) \"x\")  ; => (none)\n\nSince: parsec-guide-plan P3"},
    {"pchar-impl", "pchar-impl -- internal implementation for pchar.\n\nParameters:\n  _c -- the expected character code.\n  inp -- the current Input."},
    {"pchar-raw", "pchar-raw -- carrier worker behind pchar / pchar-int: match one code."},
    {"pchar", "pchar -- a Parser that matches one specific character.\n\nParameters:\n  c -- the character to match, e.g. `#\\A`\n\nReturns:\n  A (Parser Char) that succeeds with c when the next character is c, and\n    fails otherwise.\n\nExample:\n  (parse-first (pchar #\\A) \"A\")  ; => #\\A\n\nSince: Phase B1 (Char: parsec-guide-plan P3)"},
    {"pchar-int", "pchar-int -- DEPRECATED: the old integer-code form of pchar.\n\nParameters:\n  c -- the character code to match\n\nReturns:\n  A (Parser int) yielding c when the next character has that code.\n\nExample:\n  (parse-first (pchar-int 65) \"A\")  ; => 65\n\nSince: parsec-guide-plan P3 (deprecated on arrival)"},
    {"pstring-c-impl", "pstring-c-impl -- internal C implementation for pstring.\n\nParameters:\n  s_raw -- the pattern string as a raw int64_t pointer.\n  inp -- the current Input."},
    {"cstr->int", "cstr->int -- reinterpret a :cstr pointer as an int64_t without copying.\n\nParameters:\n  s -- the C string to reinterpret.\n\nReturns:\n  The raw pointer value of s as an int64_t."},
    {"pstring", "pstring -- a Parser that matches a literal string.\n\nParameters:\n  s -- the text to match, e.g. \"true\" (borrowed; it must outlive the parser)\n\nReturns:\n  A (Parser String) that consumes s when the input continues with it,\n    producing a fresh owned String holding s; fails otherwise.\n\nExample:\n  (string/to-cstr (parse-first (pstring \"hi\") \"hi\"))  ; => \"hi\"\n\nSince: Phase B1 (String: parsec-guide-plan P6)"},
    {"or-parser-impl", "or-parser-impl -- internal implementation for or-parser.\n\nParameters:\n  lp -- the first parser (int64_t fat-closure pointer).\n  lq -- the second parser (int64_t fat-closure pointer).\n  inp -- the current Input."},
    {"or-parser-raw", "or-parser-raw -- int-carrier worker behind or-parser / Alternative alt-or."},
    {"or-parser", "or-parser -- try two parsers and return all successes from either.\n\nParameters:\n  p -- the first parser to try.\n  q -- the second parser to try.\n\nReturns:\n  A parser that returns the concatenation of results from p and q\n    applied to the same input (full backtracking).\n\nExample:\n  (parse-first (or-parser (pchar #\\A) (pchar #\\B)) \"B\")  ; => #\\B\n\nSince: Phase B1"},
    {"or-else-raw", "or-else-raw -- carrier worker: p's results, or q's when p has none."},
    {"bind-parser-inner", "bind-parser-inner -- apply continuation f to a single parse Pair.\n\nParameters:\n  lf -- the continuation fat closure (value -> Parser).\n  pair -- a Pair(value, remaining-Input) from the first parser."},
    {"bind-parser-impl", "bind-parser-impl -- internal implementation for bind-parser.\n\nParameters:\n  lp -- the first parser.\n  lf -- the continuation fat closure.\n  inp -- the current Input."},
    {"bind-parser", "bind-parser -- carrier worker behind `Monad [Parser]`'s `bind` / `do-m`.\n\nParameters:\n  p -- the first parser.\n  f -- a `:fn` continuation of type value -> Parser; receives the parsed\n   -- value and returns the next parser to run. A `(fn ...)` literal\n   -- coerces into this slot.\n\nReturns:\n  A parser that runs p, then for each result calls (f value) and runs\n    the resulting parser on the remaining input.\n\nExample:\n  (bind-parser (item-raw) (fn [c] (pure-parser c)))  ; identity parser"},
    {"then-parser-impl", "then-parser-impl -- internal implementation for then-parser.\n\nParameters:\n  lp -- the first parser (result discarded).\n  lq -- the second parser (result kept).\n  inp -- the current Input."},
    {"then-parser-raw", "then-parser-raw -- int-carrier worker behind then-parser."},
    {"then-parser", "then-parser -- sequence two parsers, keeping only the second's result.\n\nParameters:\n  p -- parser whose result is discarded.\n  q -- parser whose result is kept.\n\nReturns:\n  A parser that runs p, then runs q on the remaining input,\n    returning only q's results.\n\nExample:\n  (parse-first (then-parser (pchar #\\() (item)) \"(x\")  ; => #\\x\n\nSince: Phase B1"},
    {"then-left-impl", "then-left-impl -- internal implementation for then-left-raw."},
    {"then-left-raw", "then-left-raw -- carrier worker: run p then q, keeping p's result."},
    {"many-c-impl", "many-c-impl -- internal C implementation of greedy zero-or-more repetition.\n\nParameters:\n  p_raw -- parser fat closure as int64_t.\n  inp -- the current Input."},
    {"many-raw", "many-raw -- carrier worker behind many."},
    {"many", "many -- greedily match a parser zero or more times.\n\nParameters:\n  p -- the parser to repeat.\n\nReturns:\n  A (Parser (List A)) that always succeeds: the values of every match, in\n    order, and the empty list when p does not match at all.  Greedy -- it\n    takes as many matches as it can and does not offer shorter ones.\n\nExample:\n  (list-count (parse-first (many (satisfy digit?)) \"123\"))  ; => 3\n    (list-empty? (parse-first (many (satisfy digit?)) \"\"))    ; => true\n\nSince: Phase B1 (List: parsec-guide-plan P5)"},
    {"many1-impl", "many1-impl -- internal implementation for many1.\n\nParameters:\n  _p -- the parser to repeat.\n  inp -- the current Input."},
    {"many1-raw", "many1-raw -- carrier worker behind many1."},
    {"many1", "many1 -- greedily match a parser one or more times.\n\nParameters:\n  p -- the parser to repeat.\n\nReturns:\n  A (Parser (List A)) like `many`, except that it fails unless p matches\n    at least once.\n\nExample:\n  (list-count (parse-first (many1 (satisfy digit?)) \"42\"))  ; => 2\n    (run-parser-full (many1 (satisfy digit?)) \"\")            ; => (none)\n\nSince: Phase B1 (List: parsec-guide-plan P5)"},
    {"optional-c-impl", "optional-c-impl -- internal C implementation for optional.\n\nParameters:\n  p_raw -- parser fat closure as int64_t.\n  inp -- the current Input."},
    {"optional-raw", "optional-raw -- carrier worker behind optional."},
    {"optional", "optional -- match a parser zero or one times.\n\nParameters:\n  p -- the parser to attempt.\n\nReturns:\n  A (Parser (Option A)) that always succeeds: `(some v)` when p matched\n    (consuming what p consumed), `(none)` when it did not (consuming\n    nothing).  Test the result with `some?` / `none?`, read it with `unwrap`\n    or `unwrap-or` -- never compare it with 0.\n\nExample:\n  (some? (parse-first (optional (pchar #\\-)) \"-\"))  ; => true\n    (some? (parse-first (optional (pchar #\\-)) \"\"))   ; => false\n\nSince: Phase B1 (Option: parsec-guide-plan P4)"},
    {"spaces", "spaces -- skip zero or more whitespace characters.\n\nReturns:\n  A (Parser (List Char)) that always succeeds, consuming any run of\n    space, tab, newline or carriage return (see `space?`).\n\nExample:\n  (list-count (parse-first (spaces) \"  \\t\"))  ; => 3\n\nSince: parsec-guide-plan"},
    {"token", "token -- run p, then skip any whitespace after it.\n\nParameters:\n  p -- the parser for the token itself\n\nReturns:\n  A (Parser A) producing p's value.\n\nExample:\n  (parse-first (token (pchar #\\x)) \"x   \")  ; => #\\x\n\nSince: parsec-guide-plan"},
    {"between", "between -- run left, p, right, keeping only p's value.\n\nParameters:\n  left -- the opening parser, e.g. (pchar #\\()\n  right -- the closing parser, e.g. (pchar #\\))\n  p -- the parser for what sits between them\n\nReturns:\n  A (Parser A) producing p's value.\n\nExample:\n  (parse-first (between (pchar #\\[) (pchar #\\]) (item)) \"[x]\")  ; => #\\x\n\nSince: parsec-guide-plan"},
    {"sep-by1-impl", "sep-by1-impl -- internal implementation for sep-by1.\n\nParameters:\n  lp -- the element parser.\n  lsep -- the separator parser.\n  inp -- the current Input."},
    {"sep-by1-raw", "sep-by1-raw -- carrier worker behind sep-by1."},
    {"sep-by1", "sep-by1 -- one or more p, separated by sep.\n\nParameters:\n  p -- the element parser\n  sep -- the separator parser (its values are discarded)\n\nReturns:\n  A (Parser (List A)) of the elements, in order; fails unless at least\n    one element matches.\n\nExample:\n  (list-count (parse-first (sep-by1 (satisfy digit?) (pchar #\\,)) \"1,2,3\"))  ; => 3\n\nSince: parsec-guide-plan"},
    {"sep-by", "sep-by -- zero or more p, separated by sep.\n\nParameters:\n  p -- the element parser\n  sep -- the separator parser (its values are discarded)\n\nReturns:\n  A (Parser (List A)) of the elements, in order -- the empty list when\n    not even one element matches.\n\nExample:\n  (list-count (parse-first (sep-by (satisfy digit?) (pchar #\\,)) \"1,2\"))  ; => 2\n    (list-empty? (parse-first (sep-by (satisfy digit?) (pchar #\\,)) \"\"))   ; => true\n\nSince: parsec-guide-plan"},
    {"ParseResult", "ParseResult -- one (possibly partial) parse: the value and where it stopped.\n\nSince: parsec-guide-plan P7"},
    {"parse-result-value", "parse-result-value -- the value a parse produced.\n\nParameters:\n  r -- one element of a run-parser result\n\nReturns:\n  The parsed value.\n\nExample:\n  (parse-result-value (list-first (run-parser (item) \"ab\")))  ; => #\\a\n\nSince: parsec-guide-plan P7"},
    {"parse-result-rest", "parse-result-rest -- the input a parse left unread.\n\nParameters:\n  r -- one element of a run-parser result\n\nReturns:\n  A fresh owned String holding the unconsumed suffix (\"\" for a full parse).\n\nExample:\n  (string/to-cstr (parse-result-rest (list-first (run-parser (item) \"ab\"))))  ; => \"b\"\n\nSince: parsec-guide-plan P7"},
    {"run-parser-raw", "run-parser-raw -- carrier worker: the raw result Cell list for p on s."},
    {"run-parser", "run-parser -- every parse of s, complete or partial.\n\nParameters:\n  p -- the parser to run\n  s -- the input text\n\nReturns:\n  A (List (ParseResult A)) -- empty when p cannot read any prefix of s.\n\nExample:\n  (list-count (run-parser (alt-or (pchar #\\a) (item)) \"ab\"))  ; => 2\n\nSince: Phase B1 (typed: parsec-guide-plan P7)"},
    {"run-parser-full-raw", "run-parser-full-raw -- internal: the first result Cell that consumed all"},
    {"run-parser-full", "run-parser-full -- the first parse that consumes all of s.\n\nParameters:\n  p -- the parser to run\n  s -- the input text\n\nReturns:\n  `(some v)` for the first parse (in backtracking order) that read all of\n    s, `(none)` when every parse left input over or none succeeded.\n\nExample:\n  (some? (run-parser-full (pchar #\\A) \"A\"))   ; => true\n    (some? (run-parser-full (pchar #\\A) \"AB\"))  ; => false (leftover \"B\")\n\nSince: Phase B1 (typed: parsec-guide-plan P7)"},
    {"parse-failure-message", "parse-failure-message -- internal: \"parse failed at: ...\" for parse-first."},
    {"parse-fail__", "parse-fail__ -- internal: panic with parse-failure-message."},
    {"parse-first", "parse-first -- the value of the first full parse, or a panic.\n\nParameters:\n  p -- the parser to run\n  s -- the input text\n\nReturns:\n  The value `run-parser-full` would wrap in `some`.  When there is none\n    it panics with `parse failed at: \"<unread input>\"`.\n\nExample:\n  (parse-first (pchar #\\A) \"A\")  ; => #\\A\n    (parse-first (pchar #\\A) \"B\")  ; panics: parse failed at: \"B\"\n\nSince: parsec-guide-plan P7"},
    {"fmap-parser-raw", "fmap-parser-raw -- worker: map a `:fn` callback over the value arm of a parser."},
    {"ap-parser-raw", "ap-parser-raw -- int worker: sequential application of a parser of functions."},
    {"tur/parsec", "tur/parsec -- typed parser combinators over a backtracking result list.\n\nSince: Phase B1 (typed surface: parsec-guide-plan)"},
    {"path/join-string", "path/join-string -- join two path segments, returning an owned String.\n\nExample:\n  (string/to-cstr (path/join-string \"/usr\" \"local\"))  ; => \"/usr/local\"\n\nSince: v2"},
    {"path/basename-string", "path/basename-string -- final path component, as an owned String.\n\nSince: v2"},
    {"path/dirname-string", "path/dirname-string -- parent directory, as an owned String.\n\nSince: v2"},
    {"path/extension-string", "path/extension-string -- file extension, as an owned String.\n\nSince: v2"},
    {"path/stem-string", "path/stem-string -- basename without its extension, as an owned String.\n\nSince: v2"},
    {"path/normalize-string", "path/normalize-string -- normalized path, as an owned String.\n\nSince: v2"},
    {"tur/path-string", "tur/path-string -- owned String siblings for stdlib/path.\n\nSince: v2 (string-adoption-stdlib-plan, batch 1)"},
    {"path/join", "path/join -- join two path segments with a single slash separator.\n\nParameters:\n  base -- the base path cstr\n  segment -- the path segment to append\n\nReturns:\n  A new heap-allocated cstr.  Free when done.\n    If base ends with '/' no extra separator is added.\n\nExample:\n  (path/join \"/usr\" \"local\")  ; => \"/usr/local\"\n\nSince: Phase B2"},
    {"path/basename", "path/basename -- return the last path component.\n\nParameters:\n  p -- path cstr\n\nReturns:\n  A new heap-allocated cstr containing the last component.\n    Returns a copy of p if no slash is present.\n\nExample:\n  (path/basename \"/foo/bar.txt\")  ; => \"bar.txt\"\n\nSince: Phase B2"},
    {"path/dirname", "path/dirname -- return the parent directory component.\n\nParameters:\n  p -- path cstr\n\nReturns:\n  A new heap-allocated cstr of the parent directory.\n    Returns \".\" if no directory component exists, \"/\" for the root.\n\nExample:\n  (path/dirname \"/foo/bar.txt\")  ; => \"/foo\"\n\nSince: Phase B2"},
    {"path/extension", "path/extension -- return the file extension including the leading dot.\n\nParameters:\n  p -- path cstr\n\nReturns:\n  A new heap-allocated cstr of the extension (e.g., \".txt\"), or an\n    empty string heap-copy if there is no extension.\n\nExample:\n  (path/extension \"/foo/bar.txt\")  ; => \".txt\"\n    (path/extension \"/foo/bar\")      ; => \"\"\n\nSince: Phase B2"},
    {"path/stem", "path/stem -- return the filename without its extension.\n\nParameters:\n  p -- path cstr\n\nReturns:\n  A new heap-allocated cstr of the stem.  Equal to path/basename if\n    there is no extension.\n\nExample:\n  (path/stem \"/foo/bar.txt\")  ; => \"bar\"\n    (path/stem \"/foo/bar\")      ; => \"bar\"\n\nSince: Phase B2"},
    {"path/absolute?", "path/absolute? -- test whether a path is absolute (starts with '/').\n\nParameters:\n  p -- path cstr\n\nReturns:\n  true if p starts with '/', false otherwise.\n\nExample:\n  (path/absolute? \"/usr/bin\")  ; => true\n    (path/absolute? \"relative\")  ; => false\n\nSince: Phase B2"},
    {"path/normalize", "path/normalize -- collapse redundant '.' and '..' segments in a path.\n\nParameters:\n  p -- path cstr\n\nReturns:\n  A new heap-allocated normalized path cstr.\n\nExample:\n  (path/normalize \"/foo/../bar/./baz\")  ; => \"/bar/baz\"\n\nSince: Phase B2"},
    {"tur/path", "tur/path -- pure path-string manipulation (join, dirname, basename, extension).\n\nSince: Phase B1"},
    {"Pid", "Pid"},
    {"ChildHandle", "ChildHandle"},
    {"process/pid", "process/pid -- return the current process ID.\n\nReturns:\n  The PID of the calling process as a Pid.\n\nExample:\n  (process/pid)  ; => 12345\n\nSince: Phase B2"},
    {"process/ppid", "process/ppid -- return the parent process ID.\n\nReturns:\n  The PPID of the calling process as a Pid.\n\nExample:\n  (process/ppid)  ; => 1\n\nSince: Phase B2"},
    {"process/exit", "process/exit -- terminate the process with the given exit code.\n\nParameters:\n  code -- exit status (0 = success, non-zero = failure)\n\nExample:\n  (process/exit 0)\n\nSince: Phase B2"},
    {"Signal", "Signal -- a signal to deliver to (or that terminated) a process.\n\nSince: stdlib-os-surface P0"},
    {"signal->number", "signal->number -- the platform signal number for a Signal (POSIX values)."},
    {"number->signal", "number->signal -- the Signal for a platform signal number."},
    {"ExitStatus", "ExitStatus -- how a reaped child process ended.\n\nSince: stdlib-os-surface P1"},
    {"exit-status/success?", "exit-status/success? -- true for (Exited 0).\n\nParameters:\n  st -- an ExitStatus\n\nReturns:\n  true when the child exited normally with status 0.\n\nExample:\n  (exit-status/success? (Exited 0))  ; => true\n\nSince: stdlib-os-surface P1"},
    {"process/exec-raw", "process/exec-raw -- execvp with a cons-carrier arg list (internal)."},
    {"process/exec", "process/exec -- replace the current process image with a new program.\n\nParameters:\n  path -- the program to run (also passed as argv[0])\n  args -- the remaining arguments, one cstr each\n\nReturns:\n  Only on failure: the IoError execvp reported (e.g. not-found).\n\nExample:\n  (process/exec \"/bin/ls\" \"-l\")\n\nSince: Phase B2"},
    {"process/spawn-raw", "process/spawn-raw -- start a child; its pid, or -errno on failure (internal)."},
    {"process/child-of-raw", "process/child-of-raw -- wrap a live child's pid as its ChildHandle (internal)."},
    {"process/spawn", "process/spawn -- start a new child process running path.\n\nParameters:\n  path -- the program to run (PATH is searched when it has no slash; also\n   -- passed as argv[0])\n  args -- the remaining arguments, one cstr each\n\nReturns:\n  (Ok child) -- a linear ChildHandle to reap exactly once with\n    process/wait -- or (Err e) when the child could not be started\n    (e.g. io-error/not-found? for a missing program).\n\nExample:\n  (match (process/spawn \"/bin/ls\" \"-l\")\n      (Ok child) (process/wait child)\n      (Err e)    (Err e))\n\nSince: Phase B2"},
    {"process/wait-raw", "process/wait-raw -- reap a child; an encoded status (internal)."},
    {"process/decode-wait", "process/decode-wait -- turn a process/wait-raw code into a Result (internal)."},
    {"process/wait", "process/wait -- wait for a child process to end, consuming its handle.\n\nParameters:\n  child -- ChildHandle from process/spawn (consumed)\n\nReturns:\n  (Ok status) -- (Exited code) or (Signaled sig) -- or (Err e) when\n    waiting failed.\n\nExample:\n  (process/wait child)  ; => (Ok (Exited 0))\n\nSince: Phase B2"},
    {"process/run", "process/run -- run a program to completion.\n\nParameters:\n  path -- the program to run (PATH searched when it has no slash)\n  args -- the remaining arguments, one cstr each\n\nReturns:\n  (Ok status) -- how the child ended -- or (Err e) when it could not be\n    started or waited for.\n\nExample:\n  (process/run \"/bin/ls\" \"-l\" \"/tmp\")  ; => (Ok (Exited 0))\n\nSince: Phase B2"},
    {"process/capture-raw", "process/capture-raw -- popen-based stdout capture (internal)."},
    {"process/capture", "process/capture -- run a program and capture its stdout as a string.\n\nParameters:\n  path -- the program to run\n  args -- the remaining arguments, one cstr each\n\nReturns:\n  (Ok out) -- a fresh heap cstr of everything the child wrote to stdout,\n    which the caller owns (release with free) -- or (Err e) when the\n    command could not be started.\n\nExample:\n  (process/capture \"echo\" \"hi\")  ; => (Ok \"hi\\n\")\n\nSince: Phase B2"},
    {"process/cwd", "process/cwd -- return the current working directory.\n\nReturns:\n  (Ok dir) -- a fresh heap cstr the caller owns (release with free) -- or\n    (Err e).\n\nExample:\n  (process/cwd)  ; => (Ok \"/home/user/project\")\n\nSince: Phase B2"},
    {"process/chdir", "process/chdir -- change the current working directory.\n\nParameters:\n  path -- the target directory path cstr\n\nReturns:\n  (Ok nil), or (Err e) carrying the errno.\n\nExample:\n  (process/chdir \"/tmp\")  ; => (Ok nil)\n\nSince: Phase B2"},
    {"process/child-pid", "process/child-pid -- the process id of a spawned child, without reaping it.\n\nParameters:\n  child -- ChildHandle from process/spawn (borrowed; still must be waited)\n\nReturns:\n  The child's Pid.  On Windows the handle is a process HANDLE, and this\n    answers its process id via GetProcessId.\n\nExample:\n  (process/kill (process/child-pid child) (SigTerm))\n\nSince: stdlib-os-surface P0"},
    {"process/kill-raw", "process/kill-raw -- kill(2) with a signal number (internal)."},
    {"process/kill", "process/kill -- send a signal to a process.\n\nParameters:\n  pid -- target process (process/child-pid gives a spawned child's)\n  sig -- the Signal to send\n\nReturns:\n  (Ok nil), or (Err e).  On Windows only SigKill and SigTerm map (both to\n    TerminateProcess); any other Signal is an EINVAL error.\n\nExample:\n  (process/kill (process/child-pid child) (SigKill))  ; => (Ok nil)\n\nSince: stdlib-os-surface P0"},
    {"ProcOutput", "ProcOutput -- everything process/output collects from a finished child.\n\nSince: stdlib-os-surface P2"},
    {"ProcOpts", "ProcOpts -- how process/output starts the child.\n\nSince: stdlib-os-surface P2"},
    {"process/default-opts", "process/default-opts -- ProcOpts with empty stdin, inherited cwd and env.\n\nReturns:\n  (ProcOpts (None) (None) (None)).\n\nExample:\n  (process/output (process/default-opts) \"ls\" \"-l\")\n\nSince: stdlib-os-surface P2"},
    {"ProcRun", "ProcRun -- the raw outcome of process/output-raw (internal)."},
    {"process/output-raw", "process/output-raw -- spawn with three pipes and collect (internal)."},
    {"process/proc-run-out", "process/proc-run-out -- take the captured stdout (internal)."},
    {"process/proc-run-err", "process/proc-run-err -- take the captured stderr (internal)."},
    {"process/proc-run-code", "process/proc-run-code -- the encoded exit status (internal)."},
    {"process/proc-run-free", "process/proc-run-free -- free the ProcRun record, not its strings (internal)."},
    {"process/finish-output", "process/finish-output -- move a ProcRun into a ProcOutput (internal)."},
    {"process/output-with", "process/output-with -- run the raw spawn with opts' cwd and env (internal)."},
    {"process/output", "process/output -- run a program to completion and collect everything.\n\nParameters:\n  opts -- a ProcOpts (process/default-opts for the plain case)\n  path -- the program to run (PATH searched when it has no slash)\n  args -- the remaining arguments, one cstr each\n\nReturns:\n  (Ok (ProcOutput out err status)), or (Err e) when the child could not be\n    started (e.g. not-found, or a cwd that does not exist).  On Windows this\n    is not implemented yet and answers an ENOSYS IoError.\n\nExample:\n  (match (process/output (process/default-opts) \"sh\" \"-c\" \"echo hi; echo oops >&2\")\n      (Ok o)  (println (.out o))      ; prints \"hi\"\n      (Err e) (println (io-error/message e)))\n\nSince: stdlib-os-surface P2"},
    {"tur/process", "tur/process -- process management: pid, spawn, wait, exec, cwd, chdir.\n\nSince: Phase B1"},
