;;; tur/process -- process management: pid, spawn, wait, exec, cwd, chdir.
;;;
;;; Wrappers around unistd.h and sys/wait.h primitives.
;;;
;;; Since: Phase B1
;; stdlib/process.tur -- process management: pid, spawn, wait, exec, cwd, chdir.
;;
;; Wrappers around unistd.h / sys/wait.h primitives.
;; process/capture uses popen(3) for capturing stdout.
;;
;; NOTE on argv: the argv parameter is a raw cons list. The (cons ...) examples
;; in the docstrings below are interpreter idioms -- `cons` is an interpreter
;; native and is NOT available when you `tur build` / `tur emit-c`. In compiled
;; programs, pass 0 for an empty argv, build the list with an inline-C cons stub,
;; or use a stdlib list helper. See the "Interpreter-only natives" section of
;; docs/guides/c-integration-guide.md.
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, I/O sweep) ----
;; Pid wraps a process id (an :int) with a nominally distinct type, so the
;; checker rejects passing an exit code, a byte count, or any unrelated integer
;; to process/wait -- only a pid produced by process/pid / -ppid / -spawn is
;; accepted. process/spawn still encodes its error case as pid -1; recover the
;; raw integer with (:: pid :int) to compare against it. Pid lowers to :int in
;; the C ABI, so the inline-C bodies are unchanged.
(defopaque Pid :int)
;; ---- Linearity (stdlib-linearity-affinity-plan, L2) ----
;; ChildHandle is the handle to a spawned child process. It is :linear: a
;; spawned child must be reaped exactly once with process/wait, which consumes
;; the handle. Under -Xlinear the checker rejects dropping a ChildHandle
;; (TUR-E0100) -- forgetting to wait, which would leak a zombie -- or waiting on
;; it twice (TUR-E0101). ChildHandle is nominally distinct from Pid so the
;; checker also rejects passing a self/parent Pid (from process/pid /
;; process/ppid) to process/wait, and vice versa. Like Pid it lowers to :int in
;; the C ABI; process/spawn still encodes fork failure as a ChildHandle wrapping
;; -1, recoverable with (:: child :int).

(defopaque ChildHandle :int :linear)
;; stdlib-effect-rows: every process/* entry point touches OS process state, so
;; each carries the #{Proc} capability tag.  Callers that opt into effect-row
;; checking (by annotating their own row) must declare #{Proc} to use them.

(load "stdlib/effects.tur")
;;; process/pid -- return the current process ID.
;;;
;;; Returns:
;;;   The PID of the calling process as a Pid.
;;;
;;; Example:
;;;   (process/pid)  ; => 12345
;;;
;;; Since: Phase B2

(defn process/pid []
  #fx{Proc}
  : Pid
  ```c
  #include <unistd.h>
  return (int64_t)getpid();
  ```)
;;; process/ppid -- return the parent process ID.
;;;
;;; Returns:
;;;   The PPID of the calling process as a Pid.
;;;
;;; Example:
;;;   (process/ppid)  ; => 1
;;;
;;; Since: Phase B2

(defn process/ppid []
  #fx{Proc}
  : Pid
  ```c
  #include <unistd.h>
  return (int64_t)getppid();
  ```)
;;; process/exit -- terminate the process with the given exit code.
;;;
;;; Parameters:
;;;   code -- exit status (0 = success, non-zero = failure)
;;;
;;; Example:
;;;   (process/exit 0)
;;;
;;; Since: Phase B2

(defn process/exit [code : int]
  #fx{Proc}
  : void
  ```c
  exit((int)code);
  ```)
;;; process/exec -- replace the current process image with a new program.
;;;
;;; Linearises the Turmeric cons list argv into a NULL-terminated char**
;;; and calls execvp(3).  Does not return on success.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path to the executable
;;;   argv -- cons list of cstr arguments (head = argv[0])
;;;
;;; Returns:
;;;   -1 if execvp fails (errno set); does not return on success.
;;;
;;; Example:
;;;   (process/exec "/bin/ls" (cons "/bin/ls" (cons "-l" 0)))
;;;
;;; Since: Phase B2

(defn process/exec [path : cstr argv : int]
  #fx{Proc}
  : int
  ```c
  #include <unistd.h>
  int argc = 0;
  int64_t tmp = argv;
  while (tmp) { argc++; tmp = ((int64_t*)(intptr_t)tmp)[1]; }
  char **args = (char**)malloc((argc + 1) * sizeof(char*));
  tmp = argv;
  for (int i = 0; i < argc; i++) {
    int64_t *cell = (int64_t*)(intptr_t)tmp;
    args[i] = (char*)(intptr_t)cell[0];
    tmp = cell[1];
  }
  args[argc] = NULL;
  execvp(path, args);
  free(args);
  return -1;
  ```)
;;; process/spawn -- fork and exec a new child process.
;;;
;;; Parameters:
;;;   path -- path to the executable
;;;   argv -- cons list of cstr arguments (head = argv[0])
;;;
;;; Returns:
;;;   The child as a ChildHandle on success, or a ChildHandle wrapping -1 on
;;;   fork failure.  The handle is linear: reap it exactly once with
;;;   process/wait.
;;;
;;; Example:
;;;   (let [child (process/spawn "/bin/ls" (cons "/bin/ls" (cons "-l" 0)))]
;;;     (process/wait child))
;;;
;;; Since: Phase B2

(defn process/spawn [path : cstr argv : int]
  #fx{Proc}
  : ChildHandle
  ```c
  #ifdef _WIN32
  #include <process.h>
#else
  #include <unistd.h>
#endif
  int argc = 0;
  int64_t tmp = argv;
  while (tmp) { argc++; tmp = ((int64_t*)(intptr_t)tmp)[1]; }
  char **args = (char**)malloc((argc + 1) * sizeof(char*));
  tmp = argv;
  for (int i = 0; i < argc; i++) {
    int64_t *cell = (int64_t*)(intptr_t)tmp;
    args[i] = (char*)(intptr_t)cell[0];
    tmp = cell[1];
  }
  args[argc] = NULL;
#ifdef _WIN32
  /* No fork on Windows.  _spawnvp(_P_NOWAIT) is fork+execvp in one call and
   * returns a process HANDLE (not a pid) that process/wait reaps with _cwait.
   * ChildHandle is opaque to callers, so its meaning is unchanged. */
  intptr_t child = _spawnvp(_P_NOWAIT, path, (const char *const *)args);
  free(args);
  return (int64_t)child;   /* -1 on failure, matching the POSIX branch */
#else
  pid_t pid = fork();
  if (pid < 0) { free(args); return -1; }
  if (pid == 0) { execvp(path, args); _exit(127); }
  free(args);
  return (int64_t)pid;
#endif
  ```)
;;; process/wait -- wait for a child process to exit, consuming its handle.
;;;
;;; Parameters:
;;;   child -- ChildHandle returned by process/spawn (consumed)
;;;
;;; Returns:
;;;   The exit status code (0 = clean exit), -1 on error.
;;;
;;; Example:
;;;   (process/wait child)  ; => 0
;;;
;;; Since: Phase B2

(defn process/wait [child : ChildHandle]
  #fx{Proc}
  : int
  ```c
  #ifdef _WIN32
  /* _cwait yields the child's exit code directly -- there is no POSIX
   * wait-status word to unpack, so no WIFEXITED/WEXITSTATUS here. */
  #include <process.h>
  int status = 0;
  if (_cwait(&status, (intptr_t)child, 0) == -1) return -1;
  return (int64_t)status;
#else
  #include <sys/wait.h>
  int status = 0;
  if (waitpid((pid_t)child, &status, 0) < 0) return -1;
  if (WIFEXITED(status)) return (int64_t)WEXITSTATUS(status);
  return -1;
#endif
  ```)
;;; process/run -- spawn a child process and wait for it to finish.
;;;
;;; Parameters:
;;;   path -- path to the executable
;;;   argv -- cons list of cstr arguments
;;;
;;; Returns:
;;;   An ok result (:int pointer) containing the exit code, or an err
;;;   result containing a strdup'd error message cstr.  Free with
;;;   result-free when done.
;;;
;;; Example:
;;;   (process/run "/bin/ls" (cons "/bin/ls" 0))
;;;
;;; Since: Phase B2

(defn process/run [path : cstr argv : int]
  #fx{Proc}
  : int
  ```c
  #include <unistd.h>
  #include <sys/wait.h>
  int argc = 0;
  int64_t tmp = argv;
  while (tmp) { argc++; tmp = ((int64_t*)(intptr_t)tmp)[1]; }
  char **args = (char**)malloc((argc + 1) * sizeof(char*));
  tmp = argv;
  for (int i = 0; i < argc; i++) {
    int64_t *cell = (int64_t*)(intptr_t)tmp;
    args[i] = (char*)(intptr_t)cell[0];
    tmp = cell[1];
  }
  args[argc] = NULL;
  #define _RUN_RESULT(ok_flag, oval, eval) \
    do { \
      return (ok_flag) ? tur_box_ok((oval)) : tur_box_err((eval)); \
    } while(0)
  pid_t pid = fork();
  if (pid < 0) { free(args); _RUN_RESULT(false, 0, (int64_t)(intptr_t)strdup("fork failed")); }
  if (pid == 0) { execvp(path, args); _exit(127); }
  free(args);
  int status = 0;
  if (waitpid(pid, &status, 0) < 0) _RUN_RESULT(false, 0, (int64_t)(intptr_t)strdup("waitpid failed"));
  int code = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
  _RUN_RESULT(true, (int64_t)code, 0);
  #undef _RUN_RESULT
  ```)
;;; process/capture -- run a command and capture its stdout as a string.
;;;
;;; Uses popen(3) internally; argument values are single-quote wrapped
;;; before being passed to the shell.
;;;
;;; Parameters:
;;;   path -- path to the executable
;;;   argv -- cons list of cstr arguments
;;;
;;; Returns:
;;;   An ok result containing a heap-allocated NUL-terminated cstr of the
;;;   captured stdout, or an err result with an error message cstr.
;;;   Free captured output with free(); free the result with result-free.
;;;
;;; Example:
;;;   (process/capture "/bin/echo" (cons "/bin/echo" (cons "hi" 0)))
;;;
;;; Since: Phase B2

(defn process/capture [path : cstr argv : int]
  #fx{Proc}
  : int
  ```c
  int argc = 0;
  int64_t tmp = argv;
  while (tmp) { argc++; tmp = ((int64_t*)(intptr_t)tmp)[1]; }
  char **args = (char**)malloc((argc + 1) * sizeof(char*));
  tmp = argv;
  for (int i = 0; i < argc; i++) {
    int64_t *cell = (int64_t*)(intptr_t)tmp;
    args[i] = (char*)(intptr_t)cell[0];
    tmp = cell[1];
  }
  args[argc] = NULL;
  /* build shell command string with single-quoted args */
  size_t cmd_cap = strlen(path) + 8;
  for (int i = 0; i < argc; i++) cmd_cap += strlen(args[i]) + 6;
  char *cmd = malloc(cmd_cap);
  size_t cpos = 0;
  for (int i = 0; i < argc; i++) {
    if (i > 0) cmd[cpos++] = ' ';
    cmd[cpos++] = '\'';
    size_t alen = strlen(args[i]);
    memcpy(cmd + cpos, args[i], alen);
    cpos += alen;
    cmd[cpos++] = '\'';
  }
  cmd[cpos] = '\0';
  free(args);
  FILE *fp = popen(cmd, "r");
  free(cmd);
  #define _CAP_RESULT(ok_flag, oval, eval) \
    do { \
      return (ok_flag) ? tur_box_ok((oval)) : tur_box_err((eval)); \
    } while(0)
  if (!fp) _CAP_RESULT(false, 0, (int64_t)(intptr_t)strdup("popen failed"));
  size_t cap = 4096, len = 0;
  char *buf = malloc(cap);
  size_t n;
  while ((n = fread(buf + len, 1, cap - len - 1, fp)) > 0) {
    len += n;
    if (len + 1 >= cap) { cap *= 2; buf = realloc(buf, cap); }
  }
  pclose(fp);
  buf[len] = '\0';
  _CAP_RESULT(true, (int64_t)(intptr_t)buf, 0);
  #undef _CAP_RESULT
  ```)
;;; process/cwd -- return the current working directory.
;;;
;;; Returns:
;;;   A heap-allocated NUL-terminated cstr of the cwd, or NULL on error.
;;;   The caller must free the returned string.
;;;
;;; Example:
;;;   (process/cwd)  ; => "/home/user/project"
;;;
;;; Since: Phase B2

(defn process/cwd []
  #fx{Proc}
  : cstr
  ```c
  #include <unistd.h>
  char *buf = malloc(4096);
  if (!getcwd(buf, 4096)) { free(buf); return NULL; }
  return buf;
  ```)
;;; process/chdir -- change the current working directory.
;;;
;;; Parameters:
;;;   path -- the target directory path cstr
;;;
;;; Returns:
;;;   0 on success, -1 on error (errno set).
;;;
;;; Example:
;;;   (process/chdir "/tmp")  ; => 0
;;;
;;; Since: Phase B2

(defn process/chdir [path : cstr]
  #fx{Proc}
  : int
  ```c
  #include <unistd.h>
  return (int64_t)chdir(path);
  ```)
;; ============================================================================
;; stdlib-os-surface-plan P0.4: signals and process/kill
;; ============================================================================
;;; Signal -- a signal to deliver to (or that terminated) a process.
;;;
;;; SigTerm / SigKill / SigInt / SigHup name the common ones; SigOther carries
;;; any other platform signal number as an escape hatch.  A tagged union rather
;;; than a raw signal number, so call sites say what they send.
;;;
;;; Since: stdlib-os-surface P0
(defdata Signal :copy (SigTerm) (SigKill) (SigInt) (SigHup) (SigOther int))
;;; signal->number -- the platform signal number for a Signal (POSIX values).
(defn signal->number [s : Signal] : int
  (match s
    (SigTerm) 15
    (SigKill) 9
    (SigInt) 2
    (SigHup) 1
    (SigOther n) n))
;;; number->signal -- the Signal for a platform signal number.
(defn number->signal [n : int] : Signal
  (cond
    (= n 15) (SigTerm)
    (= n 9) (SigKill)
    (= n 2) (SigInt)
    (= n 1) (SigHup)
    :else (SigOther n)))
;;; process/child-pid -- the process id of a spawned child, without reaping it.
;;;
;;; Parameters:
;;;   child -- ChildHandle from process/spawn (borrowed; still must be waited)
;;;
;;; Returns:
;;;   The child's Pid.  On Windows the handle is a process HANDLE, and this
;;;   answers its process id via GetProcessId.
;;;
;;; Example:
;;;   (process/kill (process/child-pid child) (SigTerm))
;;;
;;; Since: stdlib-os-surface P0
(defn process/child-pid [^borrow child : ChildHandle] : Pid
  ```c
#ifdef _WIN32
  return (int64_t)GetProcessId((HANDLE)(intptr_t)child);
#else
  return (int64_t)child;
#endif
  ```)
;;; process/kill-raw -- kill(2) with a signal number (internal).
(defn process/kill-raw [pid : Pid signo : int]
  #fx{Proc}
  : int
  ```c
#ifdef _WIN32
  /* Windows has no signals.  Termination is the only thing that maps:
   * SIGKILL (9) and SIGTERM (15) both become TerminateProcess; anything else
   * is reported as an error rather than silently ignored. */
  if (signo != 9 && signo != 15) return -1;
  HANDLE h = OpenProcess(PROCESS_TERMINATE, FALSE, (DWORD)pid);
  if (!h) return -1;
  BOOL ok = TerminateProcess(h, 128 + (UINT)signo);
  CloseHandle(h);
  return ok ? 0 : -1;
#else
  #include <signal.h>
  return (int64_t)kill((pid_t)pid, (int)signo);
#endif
  ```)
;;; process/kill -- send a signal to a process.
;;;
;;; Parameters:
;;;   pid -- target process (process/child-pid gives a spawned child's)
;;;   sig -- the Signal to send
;;;
;;; Returns:
;;;   0 on success, -1 on error.  On Windows only SigKill and SigTerm map
;;;   (both to TerminateProcess); any other Signal returns -1.
;;;
;;; Example:
;;;   (process/kill (process/child-pid child) (SigKill))  ; => 0
;;;
;;; Since: stdlib-os-surface P0
(defn process/kill [pid : Pid sig : Signal]
  #fx{Proc}
  : int
  (process/kill-raw pid (signal->number sig)))
