;;; tur/process -- process management: pid, spawn, wait, exec, cwd, chdir.
;;;
;;; Wrappers around unistd.h and sys/wait.h primitives.
;;;
;;; Since: Phase B1
;; stdlib/process.tur -- process management: pid, spawn, wait, exec, cwd, chdir.
;;
;; Wrappers around unistd.h / sys/wait.h primitives.
;; process/capture uses popen(3) for capturing stdout.
;;
;; stdlib-os-surface-plan P1: arguments are variadic cstrs after the program
;; -- (process/run "/bin/ls" "-l" "/tmp") -- and argv[0] is the program itself,
;; so callers no longer build a cons list.  Every fallible operation returns
;; (Result T IoError) (stdlib/io-error.tur); a reaped child reports an
;; ExitStatus, so a killed child cannot be mistaken for an exit code.
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, I/O sweep) ----
;; Pid wraps a process id (an :int) with a nominally distinct type, so the
;; checker rejects passing an exit code, a byte count, or any unrelated integer
;; to process/wait -- only a pid produced by process/pid / -ppid / -spawn is
;; accepted. Pid lowers to :int in the C ABI, so the inline-C bodies are
;; unchanged.
(defopaque Pid :int)
;; ---- Linearity (stdlib-linearity-affinity-plan, L2) ----
;; ChildHandle is the handle to a spawned child process. It is :linear: a
;; spawned child must be reaped exactly once with process/wait, which consumes
;; the handle. Under -Xlinear the checker rejects dropping a ChildHandle
;; (TUR-E0100) -- forgetting to wait, which would leak a zombie -- or waiting on
;; it twice (TUR-E0101). ChildHandle is nominally distinct from Pid so the
;; checker also rejects passing a self/parent Pid (from process/pid /
;; process/ppid) to process/wait, and vice versa. Like Pid it lowers to :int in
;; the C ABI.  process/spawn answers (Result ChildHandle IoError), so a
;; ChildHandle always names a real child.

(defopaque ChildHandle :int :linear)
;; stdlib-effect-rows: every process/* entry point touches OS process state, so
;; each carries the #{Proc} capability tag.  Callers that opt into effect-row
;; checking (by annotating their own row) must declare #{Proc} to use them.

(load "stdlib/effects.tur")

(load "stdlib/io-error.tur")
;;; process/pid -- return the current process ID.
;;;
;;; Returns:
;;;   The PID of the calling process as a Pid.
;;;
;;; Example:
;;;   (process/pid)  ; => 12345
;;;
;;; Since: Phase B2

(defn process/pid []
  #fx{Proc}
  : Pid
  ```c
  #include <unistd.h>
  return (int64_t)getpid();
  ```)
