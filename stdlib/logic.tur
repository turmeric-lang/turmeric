;;; tur/logic -- miniKanren-style logic programming (unification, goals, streams).
;;;
;;; Pure Turmeric (no inline-C): terms, substitutions, and the solution stream
;;; are all `defdata` sum types walked with `match`, so the miniKanren engine
;;; runs identically under the compiled path and the tree-walking interpreter
;;; (`tur --interpret` / the WASM REPL).
;;;
;;; Representation:
;;;   Term   -- a tagged union: TInt / TVar / TPair / TNil.
;;;   Subst  -- the search state: a persistent association list whose base
;;;             (SNil next) carries the next unused fresh-variable id, so a
;;;             single value threads both the bindings and the fresh counter.
;;;             This replaces the old global fresh-var counter.
;;;   Stream -- the solution stream (the list / backtracking monad): StNil /
;;;             StCons subst rest. A goal maps a Subst to a Stream of Substs.
;;;
;;; Goal is a fat-closure handle `Subst -> Stream`, exposed as a kind-(* -> *)
;;; opaque `(Goal A)` so it can carry real Functor / Applicative / Monad /
;;; Alternative instances (disjunction is `alt-or`, conjunction is `do-m`).
;;;
;;; Since: Phase B1
;; Term type for miniKanren.
;;   TInt  n     -- an integer value
;;   TVar  id    -- a logic variable identified by id
;;   TPair a b   -- a cons pair of two sub-terms
;;   TNil        -- the empty term
;; :copy -- a Term handle is an immutable tagged value with no owned resources,
;; so it is freely copyable (like Option/Either).
(defdata Term :copy (TInt :int) (TVar :int) (TPair :Term :Term) (TNil))
;; Substitution / search state: a persistent association list from var-id to
;; Term, whose base node carries the next unused fresh-variable id.
;;   SNil next              -- the empty substitution; next = fresh-var counter
;;   SBind var-id term rest -- var-id is bound to term, over rest
;; Prepending bindings preserves the base SNil, so the fresh counter rides along
;; through unification for free.

(defdata Subst :copy (SNil :int) (SBind :int :Term :Subst))
;; UnifyResult: the tagged outcome of unification -- UFail on mismatch, or
;; UOk carrying the extended substitution. Replaces the old -1 sentinel.

(defdata UnifyResult :copy (UFail) (UOk :Subst))
;; Lookup: the tagged outcome of a substitution lookup -- LMissing when the
;; variable is unbound, or LFound carrying the bound term.

(defdata Lookup :copy (LMissing) (LFound :Term))
;; Stream: the solution stream (list / backtracking monad) of search states.
;;   StNil             -- no solutions
;;   StCons subst rest -- one solution substitution, followed by the rest
;;   StInc thunk       -- an IMMATURE stream: the rest of the search, not yet
;;                        run.  This is what makes `run-logic 1` cost one
;;                        solution instead of the whole search space, and what
;;                        lets a recursive relation terminate at all.

(defdata Stream :copy (StNil) (StCons :Subst :Stream) (StInc (fn [] Stream)))

;; The thunk field is declared with its real type, `(fn [] Stream)`.
;;
;; It used to be an opaque `(defopaque StThunk :ptr<void>)` carrier with a
;; `(:: ... :StThunk)` wrapper at every construction site and an
;; `(:: th (fn [] Stream))` at the force site, because a bare `:fn` field
;; accepted a capturing closure and segfaulted when forced.  That is fixed;
;; what kept the workaround alive afterwards was narrower than the note here
;; claimed, and was NOT the `:fn` field at all -- see
;; docs/archive/workaround-stthunk-opaque-carrier.md.

;;; st-force -- run a delayed stream one step.

(defn st-force [th : (fn [] Stream)] : Stream (th))
;;; st-pull -- force a stream until it is mature (StNil or StCons).
;;;
;;; This is where laziness is cashed in: every consumer that needs to look at
;;; the head of a stream pulls first, and only that much of the search runs.
;;;
;;; Parameters:
;;;   xs -- a possibly-delayed stream
;;;
;;; Returns:
;;;   The same stream forced to StNil or StCons.
;;;
;;; Since: lazy-streams

(defn st-pull [xs : Stream] : Stream
  (match xs (StInc th) (st-pull (st-force th)) _ xs))
;;; Goal -- a kind-(* -> *) handle over a miniKanren goal `Subst -> Stream`;
;;; carrier is the fat-closure pointer.
;;;
;;; Since: stdlib-hkt-consolidation T3

(defopaque Goal [A] :ptr<void>)
;;; -- Solution stream (list / backtracking monad) ─────────────────────────────
;;; st-append -- concatenate two solution streams.

(defn st-append [xs : Stream ys : Stream] : Stream
  (match xs
    (StNil)
    ys
    (StInc th)
    ;; SWAP: hand the other branch the next turn.  This one line is the whole
    ;; of fair interleaving -- and it only means anything because the result is
    ;; itself immature, which is what an earlier `mplus-i` in the guide missed.
    (let [lth th
          lys ys]
      (StInc (fn [] (let [_ lth] (st-append lys (st-force lth))))))
    (StCons v rest)
    (StCons v (st-append rest ys))))
;;; st-append-dfs -- concatenate two solution streams DEPTH-FIRST.
;;;
;;; Same as `st-append` but WITHOUT the swap, so the left branch is exhausted
;;; before the right is touched. Still lazy -- it defers through an immature
;;; stream rather than forcing it -- so `run-logic n` still costs n solutions.
;;;
;;; Use when a goal's left branch is known to terminate and you want the
;;; leftmost solution cheaply. `st-append` reaches a solution at depth d
;;; breadth-first, which is what makes it complete on infinite relations and
;;; what makes it slower on a goal whose only solutions are deep.
;;;
;;; Prefer `st-append` unless you have measured. Depth-first is faster on the
;;; goals it terminates on and diverges on the ones it does not, which is the
;;; whole reason the default swaps.
;;;
;;; Parameters:
;;;   xs -- first solution stream
;;;   ys -- second solution stream
;;;
;;; Returns:
;;;   xs's solutions, then ys's.
;;;
;;; Example:
;;;   (st-length (st-append-dfs (mreturn s) (mreturn s)))  ; => 2
;;;
;;; Since: lazy-streams

(defn st-append-dfs [xs : Stream ys : Stream] : Stream
  (match xs
    (StNil)
    ys
    (StInc th)
    (let [lth th
          lys ys]
      (StInc (fn [] (let [_ lth] (st-append-dfs (st-force lth) lys)))))
    (StCons v rest)
    (StCons v (st-append-dfs rest ys))))
;;; st-bind -- concatMap: apply f to each state and concatenate the streams.
;;; f is a `Subst -> Stream` callback (arrives as a first-class `:fn` value).

(defn st-bind [xs : Stream f : (fn [Subst] Stream)] : Stream
  (match xs
    (StNil)
    (StNil)
    (StInc th)
    (let [lth th
          lf  f]
      (StInc (fn [] (let [_ lth] (st-bind (st-force lth) lf)))))
    (StCons v rest)
    (st-append (f v) (st-bind rest f))))
;;; st-length -- count the states in a solution stream.

(defn st-length [xs : Stream] : int
  (match (st-pull xs) (StCons v rest) (+ 1 (st-length rest)) _ 0))
;;; st-take -- keep at most n states from the front of a solution stream.

(defn st-take [n : int xs : Stream] : Stream
  (if (<= n 0)
    (StNil)
    (match (st-pull xs)
      (StCons v rest)
      (StCons v (st-take (- n 1) rest))
      _
      (StNil))))
;;; mzero -- the empty solution stream (no solutions).
;;;
;;; Returns:
;;;   An empty Stream.

(defn mzero [] : Stream (StNil))
;;; mreturn -- wrap a single substitution as a one-solution stream.
;;;
;;; Parameters:
;;;   s -- the search state (Subst)
;;;
;;; Returns:
;;;   A singleton Stream containing s.

(defn mreturn [s : Subst] : Stream (StCons s (StNil)))
;;; mplus -- concatenate (union) two solution streams.
;;;
;;; Parameters:
;;;   xs -- first solution stream
;;;   ys -- second solution stream
;;;
;;; Returns:
;;;   A Stream with all of xs's solutions followed by all of ys's.

(defn mplus [xs : Stream ys : Stream] : Stream (st-append xs ys))
;;; mbind -- apply a `Subst -> Stream` continuation to each solution and
;;; concatenate the results.
;;;
;;; Parameters:
;;;   ma -- a solution stream
;;;   fn -- a `Subst -> Stream` callback
;;;
;;; Returns:
;;;   The concatenated solution stream.

(defn mbind [ma : Stream fn : (fn [Subst] Stream)] : Stream (st-bind ma fn))
;;; bt-length -- count the number of solutions in a solution stream.
;;;
;;; Parameters:
;;;   xs -- solution stream
;;;
;;; Returns:
;;;   Number of solutions.

(defn bt-length [xs : Stream] : int (st-length xs))
;;; -- Term constructors ────────────────────────────────────────────────────────
;;; term-int -- construct a logic term representing an integer value.
;;;
;;; Parameters:
;;;   n -- integer value
;;;
;;; Returns:
;;;   A TInt term.
;;;
;;; Example:
;;;   (term-int 42)  ; => integer term 42

(defn term-int [n : int] : Term (TInt n))
;;; term-var -- construct a logic variable term with the given id.
;;;
;;; Parameters:
;;;   id -- unique variable identifier
;;;
;;; Returns:
;;;   A TVar term.
;;;
;;; Example:
;;;   (term-var 0)  ; => logic variable 0

(defn term-var [id : int] : Term (TVar id))
;;; term-pair -- construct a logic pair term from two sub-terms.
;;;
;;; Parameters:
;;;   a -- first sub-term
;;;   b -- second sub-term
;;;
;;; Returns:
;;;   A TPair term.
;;;
;;; Example:
;;;   (term-pair (term-int 1) (term-int 2))  ; => pair term (1 . 2)

(defn term-pair [a : Term b : Term] : Term (TPair a b))
;;; term-nil -- construct the nil/empty logic term.
;;;
;;; Returns:
;;;   A TNil term.
;;;
;;; Example:
;;;   (term-nil)  ; => nil term

(defn term-nil [] : Term (TNil))
;;; -- Term accessors ───────────────────────────────────────────────────────────
;;; term-int-val -- read the integer value from an INT term (0 otherwise).
;;;
;;; Parameters:
;;;   t -- a Term
;;;
;;; Returns:
;;;   The integer payload of a TInt, or 0 for any other term.

(defn term-int-val [t : Term] : int (match t (TInt n) n _ 0))
;;; term-var-id -- read the variable id from a VAR term (0 otherwise).
;;;
;;; Parameters:
;;;   t -- a Term
;;;
;;; Returns:
;;;   The id of a TVar, or 0 for any other term.

(defn term-var-id [t : Term] : int (match t (TVar id) id _ 0))
;;; term-pair-fst -- read the first sub-term of a PAIR term (TNil otherwise).
;;;
;;; Parameters:
;;;   t -- a Term
;;;
;;; Returns:
;;;   The first component of a TPair, or TNil for any other term.

(defn term-pair-fst [t : Term] : Term (match t (TPair a b) a _ (TNil)))
;;; term-pair-snd -- read the second sub-term of a PAIR term (TNil otherwise).
;;;
;;; Parameters:
;;;   t -- a Term
;;;
;;; Returns:
;;;   The second component of a TPair, or TNil for any other term.

(defn term-pair-snd [t : Term] : Term (match t (TPair a b) b _ (TNil)))
;;; -- Substitution operations ──────────────────────────────────────────────────
;;; subs-empty -- return the empty substitution (fresh counter at 0).
;;;
;;; Returns:
;;;   An empty Subst with next fresh-var id 0.

(defn subs-empty [] : Subst (SNil 0))
;;; subst-next -- read the next unused fresh-variable id from the base of a
;;; substitution.

(defn subst-next [s : Subst] : int
  (match s (SNil n) n (SBind v term rest) (subst-next rest)))
;;; subst-set-next -- set the fresh-variable counter at the base of a
;;; substitution, preserving all bindings.

(defn subst-set-next [s : Subst n : int] : Subst
  (match s
    (SNil m)
    (SNil n)
    (SBind v term rest)
    (SBind v term (subst-set-next rest n))))
;;; subst-lookup -- find the term bound to var-id in a substitution.
;;; Returns (LFound term) when var-id is bound, (LMissing) otherwise.

(defn subst-lookup [vid : int subs : Subst] : Lookup
  (match subs
    (SNil n)
    (LMissing)
    (SBind v term rest)
    (if (= v vid) (LFound term) (subst-lookup vid rest))))
;;; logic-walk -- follow variable bindings in a substitution until ground.
;;;
;;; Parameters:
;;;   t    -- the term to walk
;;;   subs -- the substitution
;;;
;;; Returns:
;;;   The fully walked term (a ground term or an unbound variable).
;;;
;;; Example:
;;;   (logic-walk (term-var 0) subs)  ; => bound term or the variable itself

(defn logic-walk [t : Term subs : Subst] : Term
  (match t
    (TVar vid)
    (match (subst-lookup vid subs)
      (LMissing)
      t
      (LFound bound)
      (logic-walk bound subs))
    _
    t))
;;; unify-walked -- structural unification of two already-walked terms.
;;; No occurs check (matching standard miniKanren).

(defn unify-walked [a : Term b : Term subs : Subst] : UnifyResult
  (match a
    (TVar v1)
    (match b
      (TVar v2)
      (if (= v1 v2) (UOk subs) (UOk (SBind v1 b subs)))
      _
      (UOk (SBind v1 b subs)))
    (TInt n1)
    (match b
      (TInt n2)
      (if (= n1 n2) (UOk subs) (UFail))
      (TVar v2)
      (UOk (SBind v2 a subs))
      _
      (UFail))
    (TNil)
    (match b (TNil) (UOk subs) (TVar v2) (UOk (SBind v2 a subs)) _ (UFail))
    (TPair a1 a2)
    (match b
      (TPair b1 b2)
      (match (unify-walked (logic-walk a1 subs) (logic-walk b1 subs) subs)
        (UFail)
        (UFail)
        (UOk s2)
        (unify-walked (logic-walk a2 s2) (logic-walk b2 s2) s2))
      (TVar v2)
      (UOk (SBind v2 a subs))
      _
      (UFail))))
;;; logic-unify -- structurally unify two terms, extending the substitution.
;;;
;;; No occurs check is performed.  Returns a tagged UnifyResult.
;;;
;;; Parameters:
;;;   t1   -- first term
;;;   t2   -- second term
;;;   subs -- current substitution
;;;
;;; Returns:
;;;   (UOk subs') on success, or (UFail) on unification failure.
;;;
;;; Example:
;;;   (logic-unify (term-var 0) (term-int 5) (subs-empty))  ; => (UOk {x0=5})

(defn logic-unify [t1 : Term t2 : Term subs : Subst] : UnifyResult
  (unify-walked (logic-walk t1 subs) (logic-walk t2 subs) subs))
;;; -- Goal application ─────────────────────────────────────────────────────────
;;; apply-goal -- run a goal against a search state, yielding a solution stream.
;;;
;;; Parameters:
;;;   g     -- a goal
;;;   state -- the current search state (Subst)
;;;
;;; Returns:
;;;   The solution Stream.

(defn apply-goal [g : (Goal int) state : Subst] : Stream
  ((:: g (fn [Subst] Stream)) state))
;;; -- Goal constructors ────────────────────────────────────────────────────────
;;; unify-goal-impl -- implementation helper: unify two terms against a state.

(defn unify-goal-impl [lt1 : Term lt2 : Term state : Subst] : Stream
  (match (logic-unify lt1 lt2 state) (UFail) (mzero) (UOk s2) (mreturn s2)))
;;; lequal -- goal that unifies two terms (miniKanren ==).
;;;
;;; Parameters:
;;;   t1 -- first term
;;;   t2 -- second term
;;;
;;; Returns:
;;;   A goal (Goal int) that succeeds iff t1 and t2 unify.
;;;
;;; Example:
;;;   (run-logic 1 (lequal (term-int 5) (term-int 5)))  ; => one solution

(defn lequal [t1 : Term t2 : Term] : (Goal int)
  (:: (let [lt1 t1
            lt2 t2]
        (fn [state : Subst] (let [_ lt1] (unify-goal-impl lt1 lt2 state))))
    :Goal))
;;; succeed -- goal that always succeeds without changing the substitution.
;;;
;;; Returns:
;;;   A goal (Goal int) that adds the current state unchanged to the solutions.
;;;
;;; Example:
;;;   (run-logic 1 (succeed))  ; => one solution

(defn succeed [] : (Goal int) (:: (fn [state : Subst] (mreturn state)) :Goal))
;;; fail -- goal that always fails, producing no solutions.
;;;
;;; Returns:
;;;   A goal (Goal int) that produces an empty solution stream.
;;;
;;; Example:
;;;   (run-logic 1 (fail))  ; => empty stream

(defn fail [] : (Goal int) (:: (fn [state : Subst] (mzero)) :Goal))
;;; conjoined-impl -- implementation helper for conjunction.

(defn conjoined-impl [lg1 : (Goal int) lg2 : (Goal int) state : Subst] : Stream
  (let [lg22 lg2]
    (mbind (apply-goal lg1 state)
      (fn [s : Subst] (let [_ lg22] (apply-goal lg22 s))))))
;;; conjoined-raw -- worker behind conjoined / Monad bind sequencing.

(defn conjoined-raw [g1 : (Goal int) g2 : (Goal int)] : (Goal int)
  (let [lg1 g1
        lg2 g2]
    (:: (fn [state : Subst] (let [_ lg1] (conjoined-impl lg1 lg2 state))) :Goal)))
;;; conjoined -- goal that applies g1 then g2 to each result (conjunction).
;;;
;;; Equivalent to sequencing the two goals with `do-m` against the
;;; `Monad [Goal]` instance.
;;;
;;; Parameters:
;;;   g1 -- first goal (Goal A)
;;;   g2 -- second goal (Goal B)
;;;
;;; Returns:
;;;   A goal (Goal B) that succeeds only when both g1 and g2 succeed.
;;;
;;; Example:
;;;   (run-logic 1 (conjoined (lequal x (term-int 1)) (succeed)))  ; => [x=1]
;;;
;;; Since: Phase B1

(defn conjoined [A B] [g1 : (Goal A) g2 : (Goal B)] : (Goal B)
  (:: (conjoined-raw (:: g1 (Goal int)) (:: g2 (Goal int))) (Goal B)))
;;; disjoined-impl -- implementation helper for disjunction.

(defn disjoined-impl [lg1 : (Goal int) lg2 : (Goal int) state : Subst] : Stream
  (mplus (apply-goal lg1 state) (apply-goal lg2 state)))
;;; disjoined-raw -- worker behind disjoined / Alternative alt-or.

(defn disjoined-raw [g1 : (Goal int) g2 : (Goal int)] : (Goal int)
  (let [lg1 g1
        lg2 g2]
    (:: (fn [state : Subst] (let [_ lg1] (disjoined-impl lg1 lg2 state))) :Goal)))
;;; disjoined -- goal that combines results from g1 and g2 (disjunction).
;;;
;;; This is the worker behind `Alternative [Goal]`'s `alt-or` method.
;;;
;;; Parameters:
;;;   g1 -- first goal (Goal A)
;;;   g2 -- second goal (Goal A)
;;;
;;; Returns:
;;;   A goal (Goal A) whose solutions are the union of g1's and g2's.
;;;
;;; Example:
;;;   (run-logic 2 (disjoined (lequal x (term-int 1)) (lequal x (term-int 2))))
;;;   ; => [x=1, x=2]
;;;
;;; Since: Phase B1

(defn disjoined [A] [g1 : (Goal A) g2 : (Goal A)] : (Goal A)
  (:: (disjoined-raw (:: g1 (Goal int)) (:: g2 (Goal int))) (Goal A)))
;;; fresh-impl -- implementation helper for fresh variable introduction.
;; lf is passed ^fat: it is a `(Term -> Goal)` callback that may capture, so the
;; callee fat-dispatches it through slot 0.

(defn fresh-impl [^fat lf : (fn [Term] (Goal int)) state : Subst] : Stream
  (let [n   (subst-next state)
        nv  (TVar n)
        st2 (subst-set-next state (+ n 1))]
    (apply-goal (lf nv) st2)))
;;; fresh -- create a new logic variable and pass it to a goal-building function.
;;;
;;; The callback is taken ^fat, so a capturing lambda -- e.g. the inner goal of a
;;; nested `fresh` that closes over the outer variable -- dispatches correctly.
;;; A caller's lambda parameter type is inferred, so `(fresh (fn [x] ...))` needs
;;; no annotation on `x`.
;;;
;;; Parameters:
;;;   f -- a (Term -> Goal) callback
;;;
;;; Returns:
;;;   A goal (Goal int) that introduces a fresh variable and runs (f var).
;;;
;;; Example:
;;;   (run-logic 1 (fresh (fn [x] (lequal x (term-int 7)))))  ; => [x=7]

(defn fresh [^fat f : (fn [Term] (Goal int))] : (Goal int)
  (:: (let [lf f] (fn [state : Subst] (let [_ lf] (fresh-impl lf state))))
    :Goal))
;;; zzz -- delay a goal so a recursive relation can be written at all.
;;;
;;; Without this, a self-recursive relation diverges while the goal is being
;;; BUILT, before any search runs:
;;; ```turmeric
;;;   (defn nats [] : (Goal int) (disjoined (succeed) (nats)))   ; SIGSEGV
;;; ```
;;; `disjoined` takes its goals strictly, so `(nats)` calls itself forever.
;;; `zzz` wraps the goal EXPRESSION unevaluated, so nothing recurses until the
;;; resulting stream is pulled -- and then only one step at a time:
;;; ```turmeric
;;;   (defn nats [] : (Goal int) (disjoined (succeed) (zzz (nats))))
;;; ```
;;; This is the `Zzz` of the miniKanren literature. It is a macro and has to
;;; be: a function would evaluate its argument at the call site, which is the
;;; divergence it exists to prevent.
;;;
;;; Parameters:
;;;   g -- a goal EXPRESSION, not evaluated until the stream is pulled
;;;
;;; Returns:
;;;   A goal that yields an immature stream.
;;;
;;; Example:
;;;   (run-logic 1 (zzz (nats)))   ; terminates
;;;
;;; Since: lazy-streams

(defmacro zzz [g]
  `(:: (fn [state : Subst] (StInc (fn [] (apply-goal ~g state)))) :Goal))
;;; disjoined-dfs -- disjunction that searches DEPTH-FIRST.
;;;
;;; `disjoined` interleaves, which is what makes it complete on relations with
;;; infinitely many solutions. That costs more to reach a solution that sits
;;; deep in the left branch, because interleaving gets there breadth-first.
;;; This variant keeps the old depth-first order.
;;;
;;; It is NOT complete: on a goal whose left branch has infinitely many
;;; solutions it never reaches the right one. Reach for it only when the left
;;; branch is known finite.
;;;
;;; Parameters:
;;;   g1 -- first goal
;;;   g2 -- second goal
;;;
;;; Returns:
;;;   A goal yielding g1's solutions then g2's.
;;;
;;; Example:
;;;   (run-logic 1 (disjoined-dfs (lequal x (term-int 1)) (lequal x (term-int 2))))
;;;
;;; Since: lazy-streams

(defn disjoined-dfs-impl [lg1 : (Goal int) lg2 : (Goal int) state : Subst] : Stream
  (st-append-dfs (apply-goal lg1 state) (apply-goal lg2 state)))

(defn disjoined-dfs [A] [g1 : (Goal A) g2 : (Goal A)] : (Goal A)
  (:: (let [l1 (:: g1 (Goal int))
            l2 (:: g2 (Goal int))]
        (fn [state : Subst] (let [_ l1] (disjoined-dfs-impl l1 l2 state))))
    :Goal))
;;; -- Runner ───────────────────────────────────────────────────────────────────
;;; run-logic -- run a goal with an empty state and return up to n solutions.
;;;
;;; Parameters:
;;;   n -- maximum number of solutions
;;;   g -- goal to run (Goal A)
;;;
;;; Returns:
;;;   A Stream of at most n solution states.
;;;
;;; Example:
;;;   (run-logic 1 (fresh (fn [x] (lequal x (term-int 3)))))  ; => one solution

(defn run-logic [A] [n : int g : (Goal A)] : Stream
  (let [init (subs-empty)] (st-take n (apply-goal (:: g (Goal int)) init))))
;;; -- Result helpers ───────────────────────────────────────────────────────────
;;; stream-empty? -- is a solution stream empty?

(defn stream-empty? [xs : Stream] : bool
  (match (st-pull xs) (StNil) true _ false))
;;; first-state -- extract the first solution substitution from a run-logic
;;; stream.
;;;
;;; Parameters:
;;;   results -- solution stream from run-logic
;;;
;;; Returns:
;;;   The first Subst, or the empty substitution if the stream is empty.

(defn first-state [results : Stream] : Subst
  (match (st-pull results) (StCons v rest) v _ (subs-empty)))
;;; reify-walk -- walk a term through the first solution's substitution.
;;;
;;; Parameters:
;;;   t       -- the term to reify
;;;   results -- solution stream from run-logic
;;;
;;; Returns:
;;;   The walked term (ground term or unbound variable); t itself if there are
;;;   no solutions.
;;;
;;; Example:
;;;   (reify-walk my-var (run-logic 1 my-goal))  ; => ground term or variable

(defn reify-walk [t : Term results : Stream] : Term
  (if (stream-empty? results) t (logic-walk t (first-state results))))
;;; -- HKT typeclass instances (stdlib-hkt-consolidation T3) ────────────────────
;;
;; Goal is a kind-(* -> *) handle (carrier: the goal fat-closure pointer). The
;; instances delegate to the pure solution-stream monad above. The continuation
;; parameter of `fmap` / `bind` arrives as a typeclass-method poly closure;
;; because a `:fn` value is a first-class callable, the worker declares its
;; callback `:fn` and applies it directly.
;;; bind-goal-raw -- worker: conjunction that threads the state into the `:fn`
;;; continuation, which returns the next goal.

(defn bind-goal-raw [g : (Goal int) k : fn] : (Goal int)
  (let [lg g]
    (:: (fn [state : Subst]
          (let [_ lg]
            (mbind (apply-goal lg state)
              (fn [s : Subst] (apply-goal (:: (k s) (Goal int)) s)))))
      :Goal)))
;;; fmap-goal-raw -- worker: map a callback over each solution state.
;;;
;;; The callback is typed `(fn [Subst] Subst)` rather than a bare `:fn`.  That
;;; is not just hygiene: a bare `:fn` result is an erased carrier word, so the
;;; body had to ascribe it back with `(:: (f s) :Subst)` -- a no-op cast while
;;; Subst rides the int64 carrier, and a real representation change the moment
;;; it does not (SR4).  Spelling the signature deletes the reinterpret.

(defn fmap-goal-raw [g : (Goal int) f : (fn [Subst] Subst)] : (Goal int)
  (let [lg g]
    (:: (fn [state : Subst]
          (let [_ lg]
            (mbind (apply-goal lg state) (fn [s : Subst] (mreturn (f s))))))
      :Goal)))
;;; Functor [Goal] -- map a function over each solution state.
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Functor [Goal]
  (fmap [container fn] (:: (fmap-goal-raw (:: container (Goal int)) fn) :Goal)))
;;; Applicative [Goal] -- pure is the always-succeeding goal (state preserved);
;;; ap sequences the two goals (conjunction) keeping the second's states.
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Applicative [Goal]
  (pure [x] (succeed))
  (ap [ff fa] (:: (conjoined-raw (:: ff (Goal int)) (:: fa (Goal int))) :Goal)))
;;; Monad [Goal] -- bind is conjunction: run the goal, then feed each resulting
;;; state into the continuation (which returns the next goal). This is what
;;; `do-m` / `for` lower onto for goal-conjunction chains.
;;;
;;; Example:
;;;   (do-m _ (lequal x (term-int 1)) (lequal y (term-int 2)))
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Monad [Goal]
  (bind [ma fn] (:: (bind-goal-raw (:: ma (Goal int)) fn) :Goal)))
;;; Alternative [Goal] -- empty is the failing goal; alt-or is disjunction (the
;;; miniKanren disj): it unions the solutions of both goals.
;;;
;;; Example:
;;;   (alt-or (lequal x (term-int 1)) (lequal x (term-int 2)))
;;;
;;; Since: stdlib-hkt-consolidation T3

(definstance Alternative [Goal]
  (empty [a] (fail))
  (alt-or [a b] (:: (disjoined-raw (:: a (Goal int)) (:: b (Goal int))) :Goal)))
