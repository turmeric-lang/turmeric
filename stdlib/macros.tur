;;; tur/macros -- core control-flow and utility macros (cond, when, for, do-m, ...).
;;;
;;; Auto-loaded for all programs. Macros here are globally visible without an
;;; explicit import because the tur/ namespace is implicitly imported.
;;;
;;; Since: Phase M7
;; Standard library macros for Turmeric
;; Phase 7: Core macros
;; Phase M7: Wrapped in (defmodule tur/macros ...). The auto-loader treats
;; modules under the `tur/` namespace as implicitly imported, so the macros
;; below remain visible globally just like in pre-module code.
(defmodule tur/macros
  (export cond
    when
    unless
    must!
    must-msg!
    ignore!
    do-m
    for
    doc
    as->
    curry
    with-resource
    must-use
    derive-show
    derive-show-string-body__
    derive-show-string-rest__
    derive-show-cstr
    derive-show-body__
    derive-show-rest__
    derive-debug
    derive-debug-body__
    derive-debug-rest__
    derive-display
    derive-display-body__
    derive-display-rest__)
  ;; The fallback clause is spelled `:else` or bare `else`; the two are exactly
  ;; the same clause.  An unbound symbol evaluates to its own Form in the
  ;; compile-time evaluator, so `(= (first clauses) else)` is a Form comparison
  ;; against the symbol `else` -- the same thing `(list if ...)` below relies on.
  ;; Bare `else` was previously TUR-E0003 `unbound symbol 'else'`, so nothing
  ;; that used to compile changes meaning.
  (defmacro cond [& clauses]
    (if (empty? clauses)
      nil
      (if (= (first clauses) :else)
        (second clauses)
        (if (= (first clauses) else)
          (second clauses)
          (list if
            (first clauses)
            (second clauses)
            (list cond ~@(rest (rest clauses))))))))
  ;; `when` / `unless` take a BODY, not a single form.  They were `[test body]`
  ;; for a long time, which made every multi-statement body pay an explicit
  ;; `(do ...)` -- and made `(when c a b)` a hard error whose primary location
  ;; was this file rather than the call site.  `& body` matches `for`,
  ;; `with-resource` and `while`, and it is what `fmt_when` and the turi
  ;; docstrings already describe.  `(when c)` is `(do)`, i.e. nil.
  (defmacro when [test & body] (if test (do ~@body)))
  (defmacro unless [test & body] (if test nil (do ~@body)))
  ;; lattice-vocabulary-plan L1: `min` / `max` were macros here.  They expanded
  ;; to the BUILTIN `<=` / `>=`, so they worked only where those operators do --
  ;; int and float concretely, and nowhere else.  `(max "a" "b")` was
  ;; `operator lookup failed for '>=' ... first arg type cstr`, and inside a
  ;; constrained generic `(defn f [^Ord A] [x : A y : A] : A (max x y))` it was
  ;; the same failure at `type tyvar` -- which is precisely where a `max` earns
  ;; its keep (a pointwise maximum over an abstract element type).
  ;;
  ;; They are DEFAULT METHODS on `Ord` now (stdlib/typeclass.tur), so they work
  ;; for every Ord instance and inside generics.  Macro expansion precedes
  ;; typeclass dispatch, so the two cannot coexist: a macro named `max` makes
  ;; the method unreachable at every call site.
  ;;
  ;; BREAKING: `max` / `min` now require `(load "stdlib/typeclass.tur")`.  This
  ;; file is auto-loaded and typeclass.tur is not, so a bare program that called
  ;; `(max 3 9)` must load it.
  (defmacro must! [expr] (option-must expr))
  (defmacro must-msg! [expr msg] (option-expect expr msg))
  (defmacro ignore! [expr] (do expr nil))
  ;; `& ^syntax forms`: the steps are bound as raw forms rather than
  ;; substituted into the body and evaluated with it -- a step that is
  ;; itself a `(do-m ...)` (`(many (do-m _ sep x p (pure x)))`) would
  ;; otherwise be expanded at macro time and its `(fn ...)` read back as a
  ;; compile-time function value (parsec-guide-plan P8).
  (defmacro do-m [& ^syntax forms]
    (if (empty? forms)
      nil
      (if (empty? (rest forms))
        (first forms)
        (list .bind
          (second forms)
          (list fn `[~(first forms)] (list do-m ~@(rest (rest forms))))))))
  (defmacro for [binding-vec & body]
    (if (empty? binding-vec)
      (list .pure (list do ~@body))
      (let [first-b (first binding-vec)
            rest-bv (rest binding-vec)]
        (if (= first-b :when)
          (let [pred (first rest-bv)
                more (rest rest-bv)]
            (if (empty? more)
              (list if pred (list .pure (list do ~@body)) (list .empty 0))
              (list if pred (list for (list ~@more) ~@body) (list .empty 0))))
          (let [var  first-b
                coll (first rest-bv)
                more (rest rest-bv)]
            (if (empty? more)
              (list .bind coll (list fn `[~var] (list .pure (list do ~@body))))
              (let [next-first (first more)
                    next-rest  (rest more)]
                (if (= next-first :when)
                  (let [pred  (first next-rest)
                        after (rest next-rest)]
                    (if (empty? after)
                      (list .bind
                        coll
                        (list fn
                          `[~var]
                          (list if
                            pred
                            (list .pure (list do ~@body))
                            (list .empty var))))
                      (list .bind
                        coll
                        (list fn
                          `[~var]
                          (list if
                            pred
                            (list for (list ~@after) ~@body)
                            (list .empty var))))))
                  (list .bind
                    coll
                    (list fn `[~var] (list for (list ~@more) ~@body)))))))))))
  (defmacro curry [f] `(fn [a] (fn [b] (~f a b))))
  ;; (doc vec-map), (doc 'vec-map) and (doc "vec-map") all expand to
  ;; (doc-print "vec-map"): the name is read at expansion time, so a bare
  ;; symbol is never evaluated as a variable.  doc-print is an interpreter
  ;; native (src/turi/interpreter_natives.c).
  (defmacro doc [name]
    (list doc-print (if (string? name) name (symbol-name name))))
  (defmacro with-resource [binding & body]
    (let [bname (first binding)
          binit (second binding)]
      (list let `[~bname ~binit] (list do ~@body))))
  (defmacro must-use [expr]
    (list let
      (vec (quote ^relevant) (quote __must_use_val) expr)
      __must_use_val))
  (defmacro as-> [expr name & forms]
    (if (empty? forms)
      expr
      (let [next-form       (first forms)
            next-name       (if (< (count forms) 2) name (second forms))
            remaining-forms (if (< (count forms) 2)
                              (rest forms)
                              (rest (rest forms)))]
        `(let [~next-name ~next-form]
           (as-> ~next-name ~next-name ~@remaining-forms)))))
  (defmacro dot [thing method & args] (cons (list '. method) (cons thing args)))
  (defmacro derive-show-rest__ [& fields]
    (if (empty? fields)
      " }"
      (let [field         (first fields)
            rest-fields   (rest fields)
            is-vec        (vec? field)
            label         (if is-vec
                            (symbol-name (first field))
                            (symbol-name field))
            accessor-sym  (if is-vec (second field) field)
            accessor-form (if is-vec
                            (list accessor-sym __p)
                            (list (dot-sym accessor-sym) __p))
            prefix        (str-append ", " label " = ")]
        (list str-concat
          prefix
          (list str-concat
            (list .show accessor-form)
            (list derive-show-rest__ ~@rest-fields))))))
  (defmacro derive-show-body__ [TypeName & fields]
    (let [type-str (symbol-name TypeName)]
      (if (empty? fields)
        (str-append type-str " { }")
        (let [field         (first fields)
              rest-fields   (rest fields)
              is-vec        (vec? field)
              label         (if is-vec
                              (symbol-name (first field))
                              (symbol-name field))
              accessor-sym  (if is-vec (second field) field)
              accessor-form (if is-vec
                              (list accessor-sym __p)
                              (list (dot-sym accessor-sym) __p))
              first-prefix  (str-append type-str " { " label " = ")]
          (list str-concat
            first-prefix
            (list str-concat
              (list .show accessor-form)
              (list derive-show-rest__ ~@rest-fields)))))))
  ;; derive-show-cstr -- derive a `cstr`-bodied `Show` instance for a struct,
  ;; joining `"Type { f = v, ... }"` with str-concat over each field's `.show`.
  ;; For programs that define their OWN minimal local `Show` class -- rendering
  ;; to cstr -- and never load the String stack.  The emitted body needs three
  ;; things in scope at the call site:
  ;;
  ;;   1. a `Show` class `(defclass Show [a] (show [x] : cstr))`;
  ;;   2. a `str-concat` of type `(cstr cstr) -> cstr`;
  ;;   3. a cstr `Show` instance for EACH field's type.
  ;;
  ;; `stdlib/str-build.tur` is the intended source of (2): a dependency-free leaf
  ;; providing `str-concat` and `int->str`, both with interpreter natives, so a
  ;; local-`Show` program built on it runs on BOTH the compiled and `--interpret`
  ;; paths without any inline-C.  A missing str-concat (1) or field instance (3)
  ;; surfaces as a compile error attributed to this macro, not the call site.
  ;;
  ;;   (load "stdlib/str-build.tur")
  ;;   (defclass Show [a] (show [x] : cstr))
  ;;   (definstance Show [int] (show [x] : cstr (int->str x)))
  ;;   (defstruct Point :copy [x : int y : int])
  ;;   (derive-show-cstr Point x y)         ; => Show[Point] "Point { x = .., y = .. }"
  ;;
  ;; The stdlib `Show` returns an owned `String` (since show-owned-result-plan
  ;; stage 4), so use plain `derive-show` with it -- `derive-show-cstr` against
  ;; the stdlib Show is a type error (str-concat expects cstr, the field `.show`
  ;; yields String).
  (defmacro derive-show-cstr [TypeName & fields]
    (list definstance
      Show
      (vec TypeName)
      (list show (vec __p) :cstr (list derive-show-body__ TypeName ~@fields))))
  ;; derive-show -- derive the owned-String `Show` instance for a struct.
  ;; Emits the stdlib `Show` instance whose `show` builds the "Type { f = v, ... }"
  ;; rendering through a StringBuilder over each field's `show` (releasing every
  ;; intermediate element String), so the result is a single owned String
  ;; (refcount 1) with no per-field concat leak.  This is the deriver to use with
  ;; the stdlib `Show` (owned String since stage 4); it needs String/StringBuilder
  ;; in scope (a program that loaded stdlib/typeclass.tur or stdlib/string.tur).
  ;; The sibling `derive-show-cstr` covers the minimal local-`Show`-class case.
  (defmacro derive-show-string-rest__ [& fields]
    (if (empty? fields)
      (list do (list builder/push-cstr! __b " }") (list builder/finish __b))
      (let [field         (first fields)
            rest-fields   (rest fields)
            is-vec        (vec? field)
            label         (if is-vec
                            (symbol-name (first field))
                            (symbol-name field))
            accessor-sym  (if is-vec (second field) field)
            accessor-form (if is-vec
                            (list accessor-sym __p)
                            (list (dot-sym accessor-sym) __p))
            prefix        (str-append ", " label " = ")]
        (list do
          (list builder/push-cstr! __b prefix)
          (list let
            (vec __e (list show accessor-form))
            (list do
              (list builder/push-string! __b __e)
              (list string/release __e)))
          (list derive-show-string-rest__ ~@rest-fields)))))
  (defmacro derive-show-string-body__ [TypeName & fields]
    (let [type-str (symbol-name TypeName)]
      (if (empty? fields)
        (list let
          (vec __b (list builder/new))
          (list do
            (list builder/push-cstr! __b (str-append type-str " { }"))
            (list builder/finish __b)))
        (let [field         (first fields)
              rest-fields   (rest fields)
              is-vec        (vec? field)
              label         (if is-vec
                              (symbol-name (first field))
                              (symbol-name field))
              accessor-sym  (if is-vec (second field) field)
              accessor-form (if is-vec
                              (list accessor-sym __p)
                              (list (dot-sym accessor-sym) __p))
              first-prefix  (str-append type-str " { " label " = ")]
          (list let
            (vec __b (list builder/new))
            (list do
              (list builder/push-cstr! __b first-prefix)
              (list let
                (vec __e (list show accessor-form))
                (list do
                  (list builder/push-string! __b __e)
                  (list string/release __e)))
              (list derive-show-string-rest__ ~@rest-fields)))))))
  (defmacro derive-show [TypeName & fields]
    (list definstance
      Show
      (vec TypeName)
      (list show (vec __p) (list derive-show-string-body__ TypeName ~@fields))))
  (defmacro derive-debug-rest__ [& fields]
    (if (empty? fields)
      ")"
      (let [field         (first fields)
            rest-fields   (rest fields)
            is-vec        (vec? field)
            label         (if is-vec
                            (symbol-name (first field))
                            (symbol-name field))
            accessor-sym  (if is-vec (second field) field)
            accessor-form (if is-vec
                            (list accessor-sym __p)
                            (list (dot-sym accessor-sym) __p))
            field-prefix  (str-append " (" label " ")]
        (list str-concat
          field-prefix
          (list str-concat
            (list .debug accessor-form)
            (list str-concat ")" (list derive-debug-rest__ ~@rest-fields)))))))
  (defmacro derive-debug-body__ [TypeName & fields]
    (let [type-str (symbol-name TypeName)]
      (if (empty? fields)
        (str-append "(" type-str ")")
        (let [field         (first fields)
              rest-fields   (rest fields)
              is-vec        (vec? field)
              label         (if is-vec
                              (symbol-name (first field))
                              (symbol-name field))
              accessor-sym  (if is-vec (second field) field)
              accessor-form (if is-vec
                              (list accessor-sym __p)
                              (list (dot-sym accessor-sym) __p))
              first-prefix  (str-append "(" type-str " (" label " ")]
          (list str-concat
            first-prefix
            (list str-concat
              (list .debug accessor-form)
              (list str-concat ")" (list derive-debug-rest__ ~@rest-fields))))))))
  (defmacro derive-debug [TypeName & fields]
    (list definstance
      Debug
      (vec TypeName)
      (list debug (vec __p) :cstr (list derive-debug-body__ TypeName ~@fields))))
  (defmacro derive-display-rest__ [& fields]
    (if (empty? fields)
      " }"
      (let [field         (first fields)
            rest-fields   (rest fields)
            is-vec        (vec? field)
            label         (if is-vec
                            (symbol-name (first field))
                            (symbol-name field))
            accessor-sym  (if is-vec (second field) field)
            accessor-form (if is-vec
                            (list accessor-sym __p)
                            (list (dot-sym accessor-sym) __p))
            prefix        (str-append ", " label " = ")]
        (list str-concat
          prefix
          (list str-concat
            (list .display accessor-form)
            (list derive-display-rest__ ~@rest-fields))))))
  (defmacro derive-display-body__ [TypeName & fields]
    (let [type-str (symbol-name TypeName)]
      (if (empty? fields)
        (str-append type-str " { }")
        (let [field         (first fields)
              rest-fields   (rest fields)
              is-vec        (vec? field)
              label         (if is-vec
                              (symbol-name (first field))
                              (symbol-name field))
              accessor-sym  (if is-vec (second field) field)
              accessor-form (if is-vec
                              (list accessor-sym __p)
                              (list (dot-sym accessor-sym) __p))
              first-prefix  (str-append type-str " { " label " = ")]
          (list str-concat
            first-prefix
            (list str-concat
              (list .display accessor-form)
              (list derive-display-rest__ ~@rest-fields)))))))
  (defmacro derive-display [TypeName & fields]
    (list definstance
      Display
      (vec TypeName)
      (list display
        (vec __p)
        :cstr
        (list derive-display-body__ TypeName ~@fields)))))
