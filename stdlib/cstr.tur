;;; tur/cstr -- byte primitives on raw :cstr values.
;;;
;;; Small pure-Turmeric surface for reading the length of a NUL-terminated
;;; C string and the byte at a given index. Sits below `stdlib/str.tur`,
;;; which wraps a `:cstr` in a length-tagged view struct. Use these when
;;; you just want to walk a literal like `"1+2*(3+4)"` byte by byte
;;; without allocating a view.
;;;
;;; Not autoloaded: `(import cstr :refer [cstr-len cstr-nth])` explicitly.
;;; See docs/archive/history/no-cstr-byte-primitives-pure-turmeric.md for why (an
;;; earlier attempt to autoload perturbed Vec element-type inference).
;;;
;;; Since: 2026-07-01
(defmodule cstr
  (export cstr-len
    cstr-nth
    cstr-byte-is?
    cstr-char-at
    cstr-starts-with?
    cstr-ends-with?
    cstr-index-of
    cstr-index-of-char
    cstr-span-while
    cstr-sub
    cstr-eq?
    cstr-free)
  ;;; cstr-len -- byte length of a NUL-terminated C string.
  ;;;
  ;;; Parameters:
  ;;;   s -- NUL-terminated C string pointer
  ;;;
  ;;; Returns:
  ;;;   Length in bytes, excluding the trailing NUL.
  ;;;
  ;;; Example:
  ;;;   (cstr-len "hello")  ; => 5
  (defn cstr-len [s : cstr] : int
    ```c
    return (int64_t)strlen((const char *)(intptr_t)s);
    ```)
  ;;; cstr-nth -- byte at index i in a NUL-terminated C string.
  ;;;
  ;;; Parameters:
  ;;;   s -- NUL-terminated C string pointer
  ;;;   i -- zero-based byte index; caller must ensure 0 <= i < (cstr-len s)
  ;;;
  ;;; Returns:
  ;;;   The unsigned byte value at position i.
  ;;;
  ;;; Example:
  ;;;   (cstr-nth "1+2" 1)  ; => 43  ('+')
  (defn cstr-nth [s : cstr i : int] : int
    ```c
    return (int64_t)(unsigned char)((const char *)(intptr_t)s)[i];
    ```)
  ;;; cstr-byte-is? -- is the byte at index i of s the character c?
  ;;;
  ;;; Unlike cstr-nth this checks the index: it is false when i is negative
  ;;; or at or past the terminator, so a scanner needs no separate length
  ;;; test and no magic numbers.  c should be ASCII, as for string/byte-is?.
  ;;; A cstr stores no length, so every call measures s: cheap for a line or
  ;;; a token, but a byte-by-byte walk over a long text should make it a
  ;;; String once and use string/byte-is?.
  ;;;
  ;;; Parameters:
  ;;;   s -- NUL-terminated C string pointer
  ;;;   i -- a byte index; out of range is not an error
  ;;;   c -- the character to compare with
  ;;;
  ;;; Returns:
  ;;;   true iff 0 <= i < (cstr-len s) and the byte at i is c's code.
  ;;;
  ;;; Example:
  ;;;   (cstr-byte-is? "a,b" 1 #\,)  ; => true
  ;;;   (cstr-byte-is? "a,b" 3 #\,)  ; => false
  ;;;
  ;;; Since: markdown-library-plan S1
  (defn cstr-byte-is? [s : cstr i : int c : Char] : bool
    (and (>= i 0) (< i (cstr-len s)) (= (cstr-nth s i) (char->int c))))
  ;;; cstr-char-at -- the byte at index i of s as a Char, or (none).
  ;;;
  ;;; The checked counterpart of cstr-nth, for comparing with character
  ;;; literals.  Measures s on every call, like cstr-byte-is?.
  ;;;
  ;;; Parameters:
  ;;;   s -- NUL-terminated C string pointer
  ;;;   i -- a byte index; out of range is not an error
  ;;;
  ;;; Returns:
  ;;;   (some c) holding the byte at i, or (none) when i is negative or at or
  ;;;   past the terminator.
  ;;;
  ;;; Example:
  ;;;   (cstr-char-at "hi" 1)  ; => (some #\i)
  ;;;
  ;;; Since: markdown-library-plan S1
  (defn cstr-char-at [s : cstr i : int] : (Option Char)
    (if (and (>= i 0) (< i (cstr-len s)))
      (some (int->char (cstr-nth s i)))
      (none)))
  ;; ---- Search (markdown-library-plan S2) -----------------------------------
  ;; The non-allocating string/ searches for a cstr, so scanning a literal or a
  ;; line from fs/read-lines needs no copy.  Each measures its arguments once
  ;; per call; the walk itself is cstr-nth.
  ;;; cstr-match-at -- internal: do bytes [k, n) of p equal s's from at+k on?
  (defn cstr-match-at [s : cstr p : cstr at : int k : int n : int] : bool
    (if (>= k n)
      true
      (if (= (cstr-nth s (+ at k)) (cstr-nth p k))
        (cstr-match-at s p at (+ k 1) n)
        false)))
  ;;; cstr-starts-with? -- true iff s begins with prefix.
  ;;;
  ;;; Parameters:
  ;;;   s      -- NUL-terminated C string pointer
  ;;;   prefix -- NUL-terminated C string pointer
  ;;;
  ;;; Returns:
  ;;;   true iff the first (cstr-len prefix) bytes of s are prefix's.  Every
  ;;;   string starts with "".
  ;;;
  ;;; Example:
  ;;;   (cstr-starts-with? "# Title" "# ")  ; => true
  ;;;
  ;;; Since: markdown-library-plan S2
  (defn cstr-starts-with? [s : cstr prefix : cstr] : bool
    (let [m (cstr-len prefix)]
      (and (<= m (cstr-len s)) (cstr-match-at s prefix 0 0 m))))
  ;;; cstr-ends-with? -- true iff s ends with suffix.
  ;;;
  ;;; Parameters:
  ;;;   s      -- NUL-terminated C string pointer
  ;;;   suffix -- NUL-terminated C string pointer
  ;;;
  ;;; Returns:
  ;;;   true iff the last (cstr-len suffix) bytes of s are suffix's.  Every
  ;;;   string ends with "".
  ;;;
  ;;; Example:
  ;;;   (cstr-ends-with? "guide.md" ".md")  ; => true
  ;;;
  ;;; Since: markdown-library-plan S2
  (defn cstr-ends-with? [s : cstr suffix : cstr] : bool
    (let [n (cstr-len s)
          m (cstr-len suffix)]
      (and (<= m n) (cstr-match-at s suffix (- n m) 0 m))))
  ;;; cstr-index-of-loop -- internal: first match of needle (length m) at i..last.
  (defn cstr-index-of-loop [s : cstr needle : cstr m : int i : int last : int] : (Option int)
    (if (> i last)
      (none)
      (if (cstr-match-at s needle i 0 m)
        (some i)
        (cstr-index-of-loop s needle m (+ i 1) last))))
  ;;; cstr-index-of -- byte offset of the first occurrence of needle in s.
  ;;;
  ;;; Parameters:
  ;;;   s      -- NUL-terminated C string pointer to search
  ;;;   needle -- NUL-terminated C string pointer to find
  ;;;
  ;;; Returns:
  ;;;   (some i) for the lowest i where needle occurs, or (none).  The empty
  ;;;   needle is found at 0.
  ;;;
  ;;; Example:
  ;;;   (cstr-index-of "key: value" ": ")  ; => (some 3)
  ;;;
  ;;; Since: markdown-library-plan S2
  (defn cstr-index-of [s : cstr needle : cstr] : (Option int)
    (let [m (cstr-len needle)]
      (cstr-index-of-loop s needle m 0 (- (cstr-len s) m))))
  ;;; cstr-index-of-byte-loop -- internal: first i in [i, n) holding byte b.
  (defn cstr-index-of-byte-loop [s : cstr b : int i : int n : int] : (Option int)
    (if (>= i n)
      (none)
      (if (= (cstr-nth s i) b) (some i) (cstr-index-of-byte-loop s b (+ i 1) n))))
  ;;; cstr-index-of-char -- byte offset of the first c in s.
  ;;;
  ;;; Parameters:
  ;;;   s -- NUL-terminated C string pointer to search
  ;;;   c -- the character to find (ASCII; see cstr-byte-is?)
  ;;;
  ;;; Returns:
  ;;;   (some i) for the lowest i holding c, or (none).  The terminator is
  ;;;   not searched, so a NUL byte is never found.
  ;;;
  ;;; Example:
  ;;;   (cstr-index-of-char "a=b" #\=)  ; => (some 1)
  ;;;
  ;;; Since: markdown-library-plan S2
  (defn cstr-index-of-char [s : cstr c : Char] : (Option int)
    (cstr-index-of-byte-loop s (char->int c) 0 (cstr-len s)))
  ;;; cstr-span-loop -- internal: first i in [i, n) whose byte fails pred, else n.
  (defn cstr-span-loop [s : cstr pred : (fn [Char] bool) i : int n : int] : int
    (if (>= i n)
      n
      (if (pred (int->char (cstr-nth s i))) (cstr-span-loop s pred (+ i 1) n) i)))
  ;;; cstr-span-while -- the index where a run of bytes satisfying pred ends.
  ;;;
  ;;; string/span-while for a cstr: scans from start while pred holds.
  ;;;
  ;;; Parameters:
  ;;;   s     -- NUL-terminated C string pointer to scan
  ;;;   start -- the byte offset to start at (clamped into [0, (cstr-len s)])
  ;;;   pred  -- the test each byte must pass to continue the run
  ;;;
  ;;; Returns:
  ;;;   The end of the run: an index in [start, (cstr-len s)].
  ;;;
  ;;; Example:
  ;;;   (cstr-span-while "  - item" 0 space?)  ; => 2
  ;;;
  ;;; Since: markdown-library-plan S2
  (defn cstr-span-while [s : cstr start : int pred : (fn [Char] bool)] : int
    (let [n (cstr-len s)]
      (cstr-span-loop s pred (if (< start 0) 0 (if (> start n) n start)) n)))
  ;;; cstr-sub -- substring [start, end) of a NUL-terminated C string.
  ;;;
  ;;; Parameters:
  ;;;   s     -- NUL-terminated C string pointer
  ;;;   start -- zero-based start byte index (clamped into [0, len])
  ;;;   end   -- exclusive end byte index (clamped into [start, len])
  ;;;
  ;;; Returns:
  ;;;   A freshly heap-allocated cstr holding the bytes of s in [start, end),
  ;;;   NUL-terminated. Out-of-range indices are clamped, so the result is
  ;;;   always a valid (possibly empty) string. The caller frees the result.
  ;;;
  ;;; Example:
  ;;;   (cstr-sub "hello" 1 4)  ; => "ell"
  (defn cstr-sub [s : cstr start : int end : int] : cstr
    ```c
    const char *cs = (const char *)(intptr_t)s;
    long slen = (long)strlen(cs);
    long a = (long)start, b = (long)end;
    if (a < 0) a = 0;
    if (b > slen) b = slen;
    if (b < a) b = a;
    size_t outlen = (size_t)(b - a);
    char *out = malloc(outlen + 1);
    memcpy(out, cs + a, outlen);
    out[outlen] = '\0';
    return (const char *)out;
    ```)
  ;;; cstr-eq? -- content equality on two NUL-terminated C strings.
  ;;;
  ;;; The `=` operator has no `cstr` overload at all (comparing two `cstr`
  ;;; values with it is a TUR-E0006 operator-lookup error), so a byte-wise
  ;;; comparison needs a named function. `(eq? a b)` from the auto-loaded
  ;;; `Eq[cstr]` instance is the same comparison reached through typeclass
  ;;; dispatch; this is the direct call, for code that walks bytes with the
  ;;; rest of this module and does not otherwise want typeclass machinery.
  ;;;
  ;;; Parameters:
  ;;;   a -- NUL-terminated C string pointer, or NULL
  ;;;   b -- NUL-terminated C string pointer, or NULL
  ;;;
  ;;; Returns:
  ;;;   true when both are NULL, or both are non-NULL and hold the same
  ;;;   bytes up to the terminator. false otherwise -- in particular a NULL
  ;;;   never equals a non-NULL, including the empty string.
  ;;;
  ;;; Example:
  ;;;   (cstr-eq? "abc" (cstr-sub "abcdef" 0 3))  ; => true
  ;;;   (cstr-eq? "abc" "abd")                    ; => false
  (defn cstr-eq? [a : cstr b : cstr] : bool
    ```c
    const char *x = (const char *)(intptr_t)a;
    const char *y = (const char *)(intptr_t)b;
    if (x == NULL && y == NULL) return true;
    if (x == NULL || y == NULL) return false;
    return strcmp(x, y) == 0;
    ```)
  ;;; cstr-free -- release a cstr this module heap-allocated.
  ;;;
  ;;; `cstr-sub` hands back a malloc'd string and documents that the caller
  ;;; frees it, but `drop!` wants a `ref<T>` and rejects a bare `cstr`, so
  ;;; without this there is no way to honor that contract from Turmeric --
  ;;; every caller had to drop into inline C. Pass only a pointer this module
  ;;; allocated: a string literal is static, and freeing one is undefined.
  ;;; NULL is accepted and ignored, matching free(3).
  ;;;
  ;;; Parameters:
  ;;;   s -- a cstr returned by cstr-sub, or NULL
  ;;;
  ;;; Example:
  ;;;   (let [t (cstr-sub "hello world" 0 5)]
  ;;;     (println t)
  ;;;     (cstr-free t))
  (defn cstr-free [s : cstr] : void
    ```c
    free((void *)(intptr_t)s);
    ```))
