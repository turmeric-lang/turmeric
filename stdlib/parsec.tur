;;; tur/parsec -- typed parser combinators over a backtracking result list.
;;;
;;; A `(Parser A)` reads text and produces an `A`.  Build small parsers --
;;; `(pchar #\=)`, `(satisfy digit?)`, `(pstring "true")` -- and combine them
;;; with `do-m` (sequencing), `alt-or` (choice), `fmap` (transforming a
;;; result), `many` / `many1` / `optional` / `sep-by` (repetition), then run
;;; the result with `parse-first`, `run-parser-full` or `run-parser`.  Every
;;; combinator is typed: characters are `Char`, repetition yields a
;;; `(List A)`, an optional piece an `(Option A)`, a literal a `String`.
;;;
;;; Parsing is fully backtracking: `alt-or` keeps the successes of both
;;; branches and a runner picks the first that consumed all of the input.
;;; `many`, `many1` and `optional` are greedy (one result each).
;;;
;;; See docs/guides/parsec-tutorial.md and docs/guides/parsec-guide.md.
;;;
;;; Since: Phase B1 (typed surface: parsec-guide-plan)
;; stdlib/parsec.tur -- Parser combinator library
;;
;; Built on the backtracking monad (list monad, inlined from backtrack.tur).
;;
;; Parser<a> = fat-closure: Input -> list (Pair a Input)
;;
;;   Input  = { int64_t str (cstr as int64_t), int64_t pos }
;;   Pair   = { int64_t first, int64_t second }
;;   Cell   = { int64_t value, int64_t next }  (backtrack result list)
;;
;; Two layers:
;;   * The CARRIER layer (mzero ... many-c-impl, the *-raw / *-impl workers)
;;     works on int64 words: a parser is a fat-closure pointer, a value is the
;;     word the carrier holds.  It is what the typed layer and the typeclass
;;     instances delegate to.
;;   * The TYPED layer (item, pchar, satisfy, pstring, many, optional, the
;;     runners ...) gives each parser its `(Parser A)` and each result its real
;;     type.  A Char is its code, a String / (List A) / (Option A) built here is
;;     the pointer the carrier holds, so the typed layer is ascriptions over the
;;     same workers.
;;
;; A parser's result rides that int64 word.  One-word results -- int, Char,
;; String, (List A), a `:heap` struct, an Option this module built -- are
;; exact.  A by-value aggregate handed to `pure` (`(pure (pair a b))`, a plain
;; defstruct) does NOT survive the carrier today: see
;; docs/reported/byvalue-aggregate-erased-to-dangling-stack-address.md.
;;
;; Calling conventions of the carrier layer:
;;   - Parser constructors return :ptr<void>  (fat closure pointer)
;;   - Functions accepting parsers take :int  (the int64_t of the pointer)
;;   - A constructor whose body is a captureless `(fn ...)` annotates its
;;     return as `^fat :ptr<void>` so the compiler boxes the bare function
;;     pointer into a one-cell fat closure at the tail.
;;
;; stdlib-hkt-consolidation T2: Parser is a kind-(* -> *) opaque type
;; constructor `(Parser A)` with real Functor / Applicative / Monad /
;; Alternative instances, so parser code uses the generic `do-m` / `for` /
;; `bind` / `alt-or` / `fmap` / `pure` surface from stdlib/macros.tur.  The
;; bespoke bind-parser / or-parser combinators remain as the workers the
;; instances delegate to.
(load "stdlib/string.tur")

(load "stdlib/list-typed.tur")
;;; Parser -- a kind-(* -> *) handle over a backtracking parser; carrier is the
;;; fat-closure pointer (Input -> list (Pair A Input)).
;;;
;;; Since: stdlib-hkt-consolidation T2
(defopaque Parser [A] :ptr<void>)
;; ── Backtracking monad (inlined from backtrack.tur) ──────────────────────────
;;; mzero -- return the empty backtracking result (failure).
;;;
;;; Returns:
;;;   0, the null pointer representing no results.
;;;
;;; Example:
;;;   (mzero)  ; => 0

(defn mzero [] : int ```c return 0; ```)
;;; mreturn -- lift a single value into the backtracking monad.
;;;
;;; Parameters:
;;;   x -- the int64_t value to wrap.
;;;
;;; Returns:
;;;   A newly allocated Cell containing x with a null next pointer.
;;;
;;; Example:
;;;   (mreturn 42)  ; => Cell{value=42, next=NULL}

(defn mreturn [x] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = x; cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)
;;; mplus -- concatenate two backtracking result lists.
;;;
;;; Parameters:
;;;   xs -- the first Cell list (copied into a fresh list).
;;;   ys -- the second Cell list (appended by pointer, not copied).
;;;
;;; Returns:
;;;   A new Cell list containing all results from xs followed by ys.
;;;
;;; Example:
;;;   (mplus (mreturn 1) (mreturn 2))  ; => Cell{1} -> Cell{2}

(defn mplus [xs ys] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *xc = (Cell*)(intptr_t)xs;
  if (!xc) return ys;
  Cell *head = NULL, *tail = NULL;
  while (xc) {
      Cell *n = malloc(sizeof(Cell));
      n->value = xc->value; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n; xc = (Cell*)(intptr_t)xc->next;
  }
  if (tail) tail->next = ys;
  return (int64_t)(intptr_t)head;
  ```)
;;; mbind -- monadic bind for the backtracking monad.
;;;
;;; Parameters:
;;;   ma -- a Cell list of values to thread through fn.
;;;   fn -- a fat closure `(fn [int] int)`: a value to a Cell list.
;;;
;;; Returns:
;;;   The concatenated results of applying fn to every value in ma,
;;;   preserving original order.
;;;
;;; Example:
;;;   (mbind (mreturn 1) (fn [x] (mreturn (* x 2))))  ; => Cell{2}

(defn mbind [ma : int ^borrow ^fat fn : (fn [int] int)] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  Cell *cell = (Cell*)(intptr_t)ma;
  if (!cell) return 0;
  int64_t *fat = (int64_t*)(intptr_t)fn;
  int64_t thunk = fat[0];
  Cell *rev = NULL;
  while (cell) {
      int64_t sub = ((int64_t(*)(void*, int64_t))(intptr_t)thunk)((void*)fat, cell->value);
      Cell *sc = (Cell*)(intptr_t)sub;
      while (sc) {
          Cell *n = malloc(sizeof(Cell));
          n->value = sc->value; n->next = (int64_t)(intptr_t)rev; rev = n;
          sc = (Cell*)(intptr_t)sc->next;
      }
      cell = (Cell*)(intptr_t)cell->next;
  }
  Cell *result = NULL;
  while (rev) {
      Cell *tmp = (Cell*)(intptr_t)rev->next;
      rev->next = (int64_t)(intptr_t)result; result = rev; rev = tmp;
  }
  return (int64_t)(intptr_t)result;
  ```)
;;; bt-nil -- return the empty backtracking list.
;;;
;;; Returns:
;;;   0 (null pointer).

(defn bt-nil [] : int ```c return 0; ```)
;;; bt-cons -- prepend a value onto a backtracking Cell list.
;;;
;;; Parameters:
;;;   v   -- the int64_t value to prepend.
;;;   nxt -- the existing Cell list to prepend onto.
;;;
;;; Returns:
;;;   A new Cell with value v pointing to nxt.
;;;
;;; Example:
;;;   (bt-cons 3 (bt-nil))  ; => Cell{3, NULL}

(defn bt-cons [v nxt] : int
  ```c
  struct { int64_t value; int64_t next; } *cell = malloc(sizeof(*cell));
  cell->value = v; cell->next = nxt;
  return (int64_t)(intptr_t)cell;
  ```)
;;; bt-length -- count elements in a backtracking Cell list.
;;;
;;; Parameters:
;;;   xs -- the Cell list to measure.
;;;
;;; Returns:
;;;   The number of cells in the list as an int64_t.
;;;
;;; Example:
;;;   (bt-length (bt-cons 1 (bt-cons 2 (bt-nil))))  ; => 2

(defn bt-length [xs] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  int64_t n = 0;
  Cell *c = (Cell*)(intptr_t)xs;
  while (c) { n++; c = (Cell*)(intptr_t)c->next; }
  return n;
  ```)
;; ── Pair helpers ─────────────────────────────────────────────────────────────
;;; pair-new -- allocate a new Pair holding two int64_t values.
;;;
;;; Parameters:
;;;   a -- the first field value.
;;;   b -- the second field value.
;;;
;;; Returns:
;;;   Pointer (as int64_t) to a heap-allocated Pair{first=a, second=b}.
;;;
;;; Example:
;;;   (pair-new 1 2)  ; => Pair{first=1, second=2}


(defn pair-new [a b] : int
  ```c
  Tuple2 *p = malloc(sizeof(Tuple2));
  p->e1 = a; p->e2 = b;
  return (int64_t)(intptr_t)p;
  ```)
;;; pair-first -- extract the first field from a Pair.
;;;
;;; Parameters:
;;;   p -- pointer (as int64_t) to a Pair.
;;;
;;; Returns:
;;;   The int64_t value stored in the first field.
;;;
;;; Example:
;;;   (pair-first (pair-new 7 8))  ; => 7

(defn pair-first [p] : int ```c return ((Tuple2 *)(intptr_t)p)->e1; ```)
;;; pair-second -- extract the second field from a Pair.
;;;
;;; Parameters:
;;;   p -- pointer (as int64_t) to a Pair.
;;;
;;; Returns:
;;;   The int64_t value stored in the second field.
;;;
;;; Example:
;;;   (pair-second (pair-new 7 8))  ; => 8

(defn pair-second [p] : int ```c return ((Tuple2 *)(intptr_t)p)->e2; ```)
;; ── Input ────────────────────────────────────────────────────────────────────
;;
;; Input stores the source string as int64_t (raw pointer) to allow capture
;; in fat closures without cstr-to-int64_t coercion issues.
;;; input-new -- create a new Input from a C string and a starting position.
;;;
;;; Parameters:
;;;   s   -- the source string (:cstr).
;;;   pos -- the initial character position (0-based).
;;;
;;; Returns:
;;;   Pointer (as int64_t) to a heap-allocated Input{str, pos}.
;;;
;;; Example:
;;;   (input-new "hello" 0)  ; => Input at position 0


(defn input-new [s : cstr pos] : int
  ```c
  struct { int64_t str; int64_t pos; } *inp = malloc(sizeof(*inp));
  inp->str = (int64_t)(intptr_t)s; inp->pos = pos;
  return (int64_t)(intptr_t)inp;
  ```)
;;; input-at-end -- test whether an Input is at the end of its string.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   true if the current character is '\0', false otherwise.
;;;
;;; Example:
;;;   (input-at-end (input-new "" 0))  ; => true

(defn input-at-end [inp] : bool
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  const char *s = (const char*)(intptr_t)i->str;
  return s[i->pos] == '\0';
  ```)
;;; input-current-char -- return the character at the current position.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   The ASCII code of the current character as an int64_t (unsigned byte).
;;;
;;; Example:
;;;   (input-current-char (input-new "abc" 0))  ; => 97  ; 'a'

(defn input-current-char [inp] : int
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  const char *s = (const char*)(intptr_t)i->str;
  return (int64_t)(unsigned char)s[i->pos];
  ```)
;;; input-advance -- return a new Input advanced by one character.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to the current Input.
;;;
;;; Returns:
;;;   A new heap-allocated Input with pos incremented by 1.
;;;
;;; Example:
;;;   (input-pos (input-advance (input-new "ab" 0)))  ; => 1

(defn input-advance [inp] : int
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  struct { int64_t str; int64_t pos; } *n = malloc(sizeof(*n));
  n->str = i->str; n->pos = i->pos + 1;
  return (int64_t)(intptr_t)n;
  ```)
;;; input-pos -- return the current position index of an Input.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   The int64_t character offset into the source string.
;;;
;;; Example:
;;;   (input-pos (input-new "abc" 2))  ; => 2

(defn input-pos [inp] : int
  ```c return ((struct { int64_t str; int64_t pos; } *)(intptr_t)inp)->pos; ```)
;;; input-remaining -- count bytes remaining in an Input.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   The number of bytes from the current position to the terminating '\0'.
;;;
;;; Example:
;;;   (input-remaining (input-new "abc" 1))  ; => 2

(defn input-remaining [inp] : int
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  const char *s = (const char*)(intptr_t)i->str;
  int64_t len = 0; while (s[i->pos + len]) len++;
  return len;
  ```)
;;; input-rest -- the unread suffix of an Input, as a borrowed cstr.
;;;
;;; Parameters:
;;;   inp -- pointer (as int64_t) to an Input.
;;;
;;; Returns:
;;;   A pointer into the source string at the current position (not a copy).
;;;
;;; Example:
;;;   (input-rest (input-new "abc" 1))  ; => "bc"

(defn input-rest [inp] : cstr
  ```c
  struct { int64_t str; int64_t pos; } *i = (void*)(intptr_t)inp;
  return (const char*)(intptr_t)i->str + i->pos;
  ```)
;; ── Fat-closure and parser application ───────────────────────────────────────
;; apply-fat: call any fat closure with a single int64_t argument
;;; apply-fat -- invoke a fat closure with one argument.
;;;
;;; Parameters:
;;;   f   -- pointer (as int64_t) to a fat closure.
;;;   arg -- the single int64_t argument to pass.
;;;
;;; Returns:
;;;   The int64_t return value of the closure.
;;;
;;; Example:
;;;   (apply-fat my-fn 42)  ; => result of calling my-fn with 42


(defn apply-fat [f : int arg : int] : int ((:: f (fn [int] int)) arg))
;; apply-parser: call a parser fat closure with an Input
;;; apply-parser -- run a parser fat closure against an Input.
;;;
;;; Parameters:
;;;   p   -- pointer (as int64_t) to a parser fat closure.
;;;   inp -- pointer (as int64_t) to the Input to parse.
;;;
;;; Returns:
;;;   A Cell list of Pair(value, remaining-Input) results.
;;;
;;; Example:
;;;   (apply-parser (item-raw) (input-new "a" 0))  ; => Cell{Pair(97, Input@1)}


(defn apply-parser [p : int inp : int] : int ((:: p (fn [int] int)) inp))
;; ── Core parsers ─────────────────────────────────────────────────────────────
;; pfail: always fails
;;; pfail-raw -- carrier worker behind pfail: a parser with no results.

(defn pfail-raw [] ^fat :ptr<void> (fn [inp] (mzero)))
;;; pfail -- a Parser that always fails, consuming no input.
;;;
;;; Returns:
;;;   A (Parser A) that yields no results for any input. This is the
;;;   `Alternative`/`MonadPlus` zero for parsers (see `empty`).
;;;
;;; Example:
;;;   (run-parser-full (:: (pfail) (Parser Char)) "abc")  ; => (none)
;;;
;;; Since: stdlib-hkt-consolidation T2

(defn pfail [A] [] : (Parser A) (:: (pfail-raw) :Parser))
;; pure v: succeed with v, consume no input
;;; pure-impl -- internal implementation for pure.
;;; Parameters:
;;;   _v  -- the value to return.
;;;   inp -- the current Input (passed through unchanged).

(defn pure-impl [_v inp] : int (mreturn (pair-new _v inp)))
;;; pure-parser -- carrier worker behind `Applicative [Parser]`'s `pure`.
;;;
;;; Parameters:
;;;   v -- the value to embed in the parse result.
;;;
;;; Returns:
;;;   A parser that returns Pair(v, inp) without advancing the input.
;;;
;;; Example:
;;;   (apply-parser (pure-parser 99) (input-new "" 0))  ; => Cell{Pair(99, Input@0)}

(defn pure-parser [v] : ptr<void>
  (let [_v v] (fn [inp] (let [_ _v] (pure-impl _v inp)))))
;; item: consume one character; fail at end of input
;;; item-impl -- internal implementation for item.
;;; Parameters:
;;;   inp -- the current Input.

(defn item-impl [inp] : int
  (if (input-at-end inp)
    (mzero)
    (mreturn (pair-new (input-current-char inp) (input-advance inp)))))
;;; item-raw -- carrier worker behind item: yields the next byte's code.

(defn item-raw [] ^fat :ptr<void> (fn [inp] (item-impl inp)))
;;; item -- a Parser that consumes exactly one character.
;;;
;;; Returns:
;;;   A (Parser Char) yielding the next character, or failing at the end of
;;;   the input.
;;;
;;; Example:
;;;   (parse-first (item) "A")  ; => #\A
;;;
;;; Since: Phase B1 (Char: parsec-guide-plan P3)

(defn item [] : (Parser Char) (:: (item-raw) :Parser))
;;; satisfy-impl -- internal implementation for satisfy.
;;; Parameters:
;;;   pred -- the character predicate.
;;;   inp  -- the current Input.

(defn satisfy-impl [pred : (fn [Char] bool) inp] : int
  (if (input-at-end inp)
    (mzero)
    (let [c (input-current-char inp)]
      (if (pred (int->char c))
        (mreturn (pair-new c (input-advance inp)))
        (mzero)))))
;;; satisfy -- a Parser for one character that passes a predicate.
;;;
;;; The general single-character parser: `item`, `pchar` and every character
;;; class are `satisfy` with a particular predicate.  stdlib/char.tur's
;;; `digit?`, `alpha?`, `alnum?`, `space?`, `upper?`, `lower?` and `punct?`
;;; drop straight in.
;;;
;;; Parameters:
;;;   pred -- (fn [Char] bool), true for the characters to accept
;;;
;;; Returns:
;;;   A (Parser Char) that consumes the next character when (pred c) holds,
;;;   and fails (consuming nothing) otherwise or at the end of the input.
;;;
;;; Example:
;;;   (parse-first (satisfy digit?) "7")  ; => #\7
;;;   (run-parser-full (satisfy digit?) "x")  ; => (none)
;;;
;;; Since: parsec-guide-plan P3

(defn satisfy [pred : (fn [Char] bool)] : (Parser Char)
  (:: (fn [inp] (satisfy-impl pred inp)) :Parser))
;; pchar c: consume if current char equals c
;;; pchar-impl -- internal implementation for pchar.
;;; Parameters:
;;;   _c  -- the expected character code.
;;;   inp -- the current Input.

(defn pchar-impl [_c inp] : int
  (if (input-at-end inp)
    (mzero)
    (if (= (input-current-char inp) _c)
      (mreturn (pair-new _c (input-advance inp)))
      (mzero))))
;;; pchar-raw -- carrier worker behind pchar / pchar-int: match one code.

(defn pchar-raw [c : int] : ptr<void>
  (let [_c c] (fn [inp] (let [_ _c] (pchar-impl _c inp)))))
;;; pchar -- a Parser that matches one specific character.
;;;
;;; Parameters:
;;;   c -- the character to match, e.g. `#\A`
;;;
;;; Returns:
;;;   A (Parser Char) that succeeds with c when the next character is c, and
;;;   fails otherwise.
;;;
;;; Example:
;;;   (parse-first (pchar #\A) "A")  ; => #\A
;;;
;;; Since: Phase B1 (Char: parsec-guide-plan P3)

(defn pchar [c : Char] : (Parser Char) (:: (pchar-raw (char->int c)) :Parser))
;;; pchar-int -- DEPRECATED: the old integer-code form of pchar.
;;;
;;; Kept for one release so code written against `(pchar 65)` keeps building;
;;; write `(pchar #\A)` instead.  Its results are character codes, not Chars.
;;;
;;; Parameters:
;;;   c -- the character code to match
;;;
;;; Returns:
;;;   A (Parser int) yielding c when the next character has that code.
;;;
;;; Example:
;;;   (parse-first (pchar-int 65) "A")  ; => 65
;;;
;;; Since: parsec-guide-plan P3 (deprecated on arrival)

(defn pchar-int [c : int] : (Parser int) (:: (pchar-raw c) :Parser))
;; pstring s: consume if input starts with the C string s
;;; pstring-c-impl -- internal C implementation for pstring.
;;; Parameters:
;;;   s_raw -- the pattern string as a raw int64_t pointer.
;;;   inp   -- the current Input.

(defn pstring-c-impl [s_raw inp] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  typedef struct { int64_t str; int64_t pos; } Input;
  extern size_t strlen(const char *);
  extern void *tur_string_from_cstr(const char *s);
  const char *s = (const char*)(intptr_t)s_raw;
  Input *i = (Input*)(intptr_t)inp;
  const char *src = (const char*)(intptr_t)i->str;
  size_t slen = strlen(s);
  for (size_t j = 0; j < slen; j++) {
      if (src[i->pos + j] != s[j]) return 0;
  }
  Input *new_inp = malloc(sizeof(Input));
  new_inp->str = i->str; new_inp->pos = i->pos + (int64_t)slen;
  /* Each match hands back its own owned String (refcount 1). */
  Tuple2 *pr = malloc(sizeof(Tuple2));
  pr->e1 = (int64_t)(intptr_t)tur_string_from_cstr(s);
  pr->e2 = (int64_t)(intptr_t)new_inp;
  Cell *cell = malloc(sizeof(Cell)); cell->value = (int64_t)(intptr_t)pr; cell->next = 0;
  return (int64_t)(intptr_t)cell;
  ```)
;;; cstr->int -- reinterpret a :cstr pointer as an int64_t without copying.
;;;
;;; Parameters:
;;;   s -- the C string to reinterpret.
;;;
;;; Returns:
;;;   The raw pointer value of s as an int64_t.

(defn cstr->int [s : cstr] : int ```c return (int64_t)(intptr_t)s; ```)
;;; pstring -- a Parser that matches a literal string.
;;;
;;; Parameters:
;;;   s -- the text to match, e.g. "true" (borrowed; it must outlive the parser)
;;;
;;; Returns:
;;;   A (Parser String) that consumes s when the input continues with it,
;;;   producing a fresh owned String holding s; fails otherwise.
;;;
;;; Example:
;;;   (string/to-cstr (parse-first (pstring "hi") "hi"))  ; => "hi"
;;;
;;; Since: Phase B1 (String: parsec-guide-plan P6)

(defn pstring [s : cstr] : (Parser String)
  (:: (let [_s (cstr->int s)] (fn [inp] (let [_ _s] (pstring-c-impl _s inp))))
    :Parser))
;; ── Combinators ──────────────────────────────────────────────────────────────
;; or-parser p q: try p, then q, return all successes (backtracking)
;;; or-parser-impl -- internal implementation for or-parser.
;;; Parameters:
;;;   lp  -- the first parser (int64_t fat-closure pointer).
;;;   lq  -- the second parser (int64_t fat-closure pointer).
;;;   inp -- the current Input.

(defn or-parser-impl [lp lq inp] : int
  (mplus (apply-parser lp inp) (apply-parser lq inp)))
;;; or-parser-raw -- int-carrier worker behind or-parser / Alternative alt-or.

(defn or-parser-raw [p q] : ptr<void>
  (let [lp p
        lq q]
    (fn [inp] (let [_ lp] (or-parser-impl lp lq inp)))))
;;; or-parser -- try two parsers and return all successes from either.
;;;
;;; This is the typed `(Parser A)` worker behind the `Alternative [Parser]`
;;; `alt-or` method; write `alt-or`.
;;;
;;; Parameters:
;;;   p -- the first parser to try.
;;;   q -- the second parser to try.
;;;
;;; Returns:
;;;   A parser that returns the concatenation of results from p and q
;;;   applied to the same input (full backtracking).
;;;
;;; Example:
;;;   (parse-first (or-parser (pchar #\A) (pchar #\B)) "B")  ; => #\B
;;;
;;; Since: Phase B1

(defn or-parser [A] [p : (Parser A) q : (Parser A)] : (Parser A)
  (:: (or-parser-raw (:: p :int) (:: q :int)) :Parser))
;;; or-else-raw -- carrier worker: p's results, or q's when p has none.
;;;
;;; The biased choice behind sep-by: q runs only if p fails outright.

(defn or-else-raw [p q] : ptr<void>
  (let [lp p
        lq q]
    (fn [inp]
      (let [_ lp
            r (apply-parser lp inp)]
        (if (= r 0) (apply-parser lq inp) r)))))
;; bind-parser p f: apply p, then for each (v, inp'), apply (f v) as a parser
;; f must be a fat closure: value -> Parser
;;; bind-parser-inner -- apply continuation f to a single parse Pair.
;;; Parameters:
;;;   lf   -- the continuation fat closure (value -> Parser).
;;;   pair -- a Pair(value, remaining-Input) from the first parser.

(defn bind-parser-inner [f : fn pair] : int
  (apply-parser (f (pair-first pair)) (pair-second pair)))
;;; bind-parser-impl -- internal implementation for bind-parser.
;;; Parameters:
;;;   lp  -- the first parser.
;;;   lf  -- the continuation fat closure.
;;;   inp -- the current Input.

(defn bind-parser-impl [lp f : fn inp] : int
  (mbind (apply-parser lp inp) (fn [pair] (bind-parser-inner f pair))))
;;; bind-parser -- carrier worker behind `Monad [Parser]`'s `bind` / `do-m`.
;;;
;;; Parameters:
;;;   p -- the first parser.
;;;   f -- a `:fn` continuation of type value -> Parser; receives the parsed
;;;        value and returns the next parser to run. A `(fn ...)` literal
;;;        coerces into this slot.
;;;
;;; Returns:
;;;   A parser that runs p, then for each result calls (f value) and runs
;;;   the resulting parser on the remaining input.
;;;
;;; Example:
;;;   (bind-parser (item-raw) (fn [c] (pure-parser c)))  ; identity parser

(defn bind-parser [p f : fn] : ptr<void>
  (let [lp p] (fn [inp] (let [_ lp] (bind-parser-impl lp f inp)))))
;; then-parser p q: apply p, discard result, apply q
;;; then-parser-impl -- internal implementation for then-parser.
;;; Parameters:
;;;   lp  -- the first parser (result discarded).
;;;   lq  -- the second parser (result kept).
;;;   inp -- the current Input.

(defn then-parser-impl [lp lq inp] : int
  (let [lq2 lq]
    (mbind (apply-parser lp inp)
      (fn [pair] (let [_ lq2] (apply-parser lq2 (pair-second pair)))))))
;;; then-parser-raw -- int-carrier worker behind then-parser.

(defn then-parser-raw [p q] : ptr<void>
  (let [lp p
        lq q]
    (fn [inp] (let [_ lp] (then-parser-impl lp lq inp)))))
;;; then-parser -- sequence two parsers, keeping only the second's result.
;;;
;;; Equivalent to `(do-m _ p v q (pure v))`.
;;;
;;; Parameters:
;;;   p -- parser whose result is discarded.
;;;   q -- parser whose result is kept.
;;;
;;; Returns:
;;;   A parser that runs p, then runs q on the remaining input,
;;;   returning only q's results.
;;;
;;; Example:
;;;   (parse-first (then-parser (pchar #\() (item)) "(x")  ; => #\x
;;;
;;; Since: Phase B1

(defn then-parser [A B] [p : (Parser A) q : (Parser B)] : (Parser B)
  (:: (then-parser-raw (:: p :int) (:: q :int)) :Parser))
;;; then-left-impl -- internal implementation for then-left-raw.

(defn then-left-impl [lp lq inp] : int
  (let [lq2 lq]
    (mbind (apply-parser lp inp)
      (fn [pair]
        (let [_ lq2
              v (pair-first pair)]
          (mbind (apply-parser lq2 (pair-second pair))
            (fn [qpair] (let [_ v] (mreturn (pair-new v (pair-second qpair)))))))))))
;;; then-left-raw -- carrier worker: run p then q, keeping p's result.

(defn then-left-raw [p q] : ptr<void>
  (let [lp p
        lq q]
    (fn [inp] (let [_ lp] (then-left-impl lp lq inp)))))
;; many p: match p zero or more times (greedy); returns one result
;;; many-c-impl -- internal C implementation of greedy zero-or-more repetition.
;;; Parameters:
;;;   p_raw -- parser fat closure as int64_t.
;;;   inp   -- the current Input.

(defn many-c-impl [p_raw inp] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  typedef struct { int64_t str; int64_t pos; } Input;
  int64_t *fat_p = (int64_t*)(intptr_t)p_raw;
  int64_t thunk_p = fat_p[0];
  int64_t current_inp = inp;
  Cell *rev_list = NULL;
  for (;;) {
      int64_t matches = ((int64_t(*)(void*, int64_t))(intptr_t)thunk_p)((void*)fat_p, current_inp);
      if (!matches) break;
      Cell *match_cell = (Cell*)(intptr_t)matches;
      Tuple2 *pr = (Tuple2*)(intptr_t)match_cell->value;
      Input *old_i = (Input*)(intptr_t)current_inp;
      Input *new_i = (Input*)(intptr_t)pr->e2;
      if (new_i->pos <= old_i->pos) break;
      Cell *nc = malloc(sizeof(Cell)); nc->value = pr->e1; nc->next = (int64_t)(intptr_t)rev_list; rev_list = nc;
      current_inp = pr->e2;
  }
  Cell *fwd = NULL;
  while (rev_list) {
      Cell *tmp = (Cell*)(intptr_t)rev_list->next;
      rev_list->next = (int64_t)(intptr_t)fwd; fwd = rev_list; rev_list = tmp;
  }
  /* The matched values, first to last, as a cons chain: the (List A) carrier. */
  Tuple2 *result_pair = malloc(sizeof(Tuple2)); result_pair->e1 = (int64_t)(intptr_t)fwd; result_pair->e2 = current_inp;
  Cell *result_cell = malloc(sizeof(Cell)); result_cell->value = (int64_t)(intptr_t)result_pair; result_cell->next = 0;
  return (int64_t)(intptr_t)result_cell;
  ```)
;;; many-raw -- carrier worker behind many.

(defn many-raw [_p] : ptr<void> (fn [inp] (let [_ _p] (many-c-impl _p inp))))

;;; many -- greedily match a parser zero or more times.
;;;
;;; Parameters:
;;;   p -- the parser to repeat.
;;;
;;; Returns:
;;;   A (Parser (List A)) that always succeeds: the values of every match, in
;;;   order, and the empty list when p does not match at all.  Greedy -- it
;;;   takes as many matches as it can and does not offer shorter ones.
;;;
;;; Example:
;;;   (list-count (parse-first (many (satisfy digit?)) "123"))  ; => 3
;;;   (list-empty? (parse-first (many (satisfy digit?)) ""))    ; => true
;;;
;;; Since: Phase B1 (List: parsec-guide-plan P5)

(defn many [A] [p : (Parser A)] : (Parser (List A))
  (:: (many-raw (:: p :int)) :Parser))
;; many1 p: one or more; fails if p doesn't match at least once
;;; many1-impl -- internal implementation for many1.
;;; Parameters:
;;;   _p  -- the parser to repeat.
;;;   inp -- the current Input.

(defn many1-impl [_p inp] : int
  (if (= (apply-parser _p inp) 0) (mzero) (many-c-impl _p inp)))
;;; many1-raw -- carrier worker behind many1.

(defn many1-raw [_p] : ptr<void> (fn [inp] (let [_ _p] (many1-impl _p inp))))

;;; many1 -- greedily match a parser one or more times.
;;;
;;; Parameters:
;;;   p -- the parser to repeat.
;;;
;;; Returns:
;;;   A (Parser (List A)) like `many`, except that it fails unless p matches
;;;   at least once.
;;;
;;; Example:
;;;   (list-count (parse-first (many1 (satisfy digit?)) "42"))  ; => 2
;;;   (run-parser-full (many1 (satisfy digit?)) "")            ; => (none)
;;;
;;; Since: Phase B1 (List: parsec-guide-plan P5)

(defn many1 [A] [p : (Parser A)] : (Parser (List A))
  (:: (many1-raw (:: p :int)) :Parser))
;; optional p: Some on a match, None (consuming nothing) when p fails
;;; optional-c-impl -- internal C implementation for optional.
;;; Parameters:
;;;   p_raw -- parser fat closure as int64_t.
;;;   inp   -- the current Input.

(defn optional-c-impl [p_raw inp] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  int64_t *fat_p = (int64_t*)(intptr_t)p_raw;
  int64_t r = ((int64_t(*)(void*, int64_t))(intptr_t)fat_p[0])((void*)fat_p, inp);
  if (!r) {
      /* p failed: one result, None, at the unchanged position. */
      Tuple2 *pr = malloc(sizeof(Tuple2)); pr->e1 = tur_none(); pr->e2 = inp;
      Cell *c = malloc(sizeof(Cell)); c->value = (int64_t)(intptr_t)pr; c->next = 0;
      return (int64_t)(intptr_t)c;
  }
  /* p matched: each of its results, wrapped in Some (the Option carrier box). */
  Cell *head = NULL, *tail = NULL;
  for (Cell *c = (Cell*)(intptr_t)r; c; c = (Cell*)(intptr_t)c->next) {
      Tuple2 *old = (Tuple2*)(intptr_t)c->value;
      Tuple2 *pr = malloc(sizeof(Tuple2)); pr->e1 = tur_some_int(old->e1); pr->e2 = old->e2;
      Cell *n = malloc(sizeof(Cell)); n->value = (int64_t)(intptr_t)pr; n->next = 0;
      if (tail) tail->next = (int64_t)(intptr_t)n; else head = n;
      tail = n;
  }
  return (int64_t)(intptr_t)head;
  ```)
;;; optional-raw -- carrier worker behind optional.

(defn optional-raw [_p] : ptr<void>
  (fn [inp] (let [_ _p] (optional-c-impl _p inp))))

;;; optional -- match a parser zero or one times.
;;;
;;; Parameters:
;;;   p -- the parser to attempt.
;;;
;;; Returns:
;;;   A (Parser (Option A)) that always succeeds: `(some v)` when p matched
;;;   (consuming what p consumed), `(none)` when it did not (consuming
;;;   nothing).  Test the result with `some?` / `none?`, read it with `unwrap`
;;;   or `unwrap-or` -- never compare it with 0.
;;;
;;; Example:
;;;   (some? (parse-first (optional (pchar #\-)) "-"))  ; => true
;;;   (some? (parse-first (optional (pchar #\-)) ""))   ; => false
;;;
;;; Since: Phase B1 (Option: parsec-guide-plan P4)

(defn optional [A] [p : (Parser A)] : (Parser (Option A))
  (:: (optional-raw (:: p :int)) :Parser))
;;; spaces -- skip zero or more whitespace characters.
;;;
;;; Returns:
;;;   A (Parser (List Char)) that always succeeds, consuming any run of
;;;   space, tab, newline or carriage return (see `space?`).
;;;
;;; Example:
;;;   (list-count (parse-first (spaces) "  \t"))  ; => 3
;;;
;;; Since: parsec-guide-plan

(defn spaces [] : (Parser (List Char)) (many (satisfy space?)))
;;; token -- run p, then skip any whitespace after it.
;;;
;;; Lexing with `token` keeps whitespace handling out of the grammar: each
;;; token eats the spaces that follow it.
;;;
;;; Parameters:
;;;   p -- the parser for the token itself
;;;
;;; Returns:
;;;   A (Parser A) producing p's value.
;;;
;;; Example:
;;;   (parse-first (token (pchar #\x)) "x   ")  ; => #\x
;;;
;;; Since: parsec-guide-plan

(defn token [A] [p : (Parser A)] : (Parser A)
  (:: (then-left-raw (:: p :int) (:: (spaces) :int)) :Parser))
;;; between -- run left, p, right, keeping only p's value.
;;;
;;; Parameters:
;;;   left  -- the opening parser, e.g. (pchar #\()
;;;   right -- the closing parser, e.g. (pchar #\))
;;;   p     -- the parser for what sits between them
;;;
;;; Returns:
;;;   A (Parser A) producing p's value.
;;;
;;; Example:
;;;   (parse-first (between (pchar #\[) (pchar #\]) (item)) "[x]")  ; => #\x
;;;
;;; Since: parsec-guide-plan

(defn between [A L R] [left : (Parser L) right : (Parser R) p : (Parser A)] : (Parser A)
  (:: (then-left-raw (then-parser-raw (:: left :int) (:: p :int))
        (:: right :int))
    :Parser))
;;; sep-by1-impl -- internal implementation for sep-by1.
;;; Parameters:
;;;   lp    -- the element parser.
;;;   lsep  -- the separator parser.
;;;   inp   -- the current Input.

(defn sep-by1-impl [lp lsep inp] : int
  (let [lrest (:: (then-parser-raw lsep lp) :int)]
    (mbind (apply-parser lp inp)
      (fn [pair]
        (let [_ lrest
              v (pair-first pair)]
          (mbind (many-c-impl lrest (pair-second pair))
            (fn [mpair]
              (let [_ v]
                (mreturn (pair-new (:: (tcons v (pair-first mpair)) :int)
                           (pair-second mpair)))))))))))
;;; sep-by1-raw -- carrier worker behind sep-by1.

(defn sep-by1-raw [lp lsep] : ptr<void>
  (fn [inp] (let [_ lp] (sep-by1-impl lp lsep inp))))

;;; sep-by1 -- one or more p, separated by sep.
;;;
;;; Parameters:
;;;   p   -- the element parser
;;;   sep -- the separator parser (its values are discarded)
;;;
;;; Returns:
;;;   A (Parser (List A)) of the elements, in order; fails unless at least
;;;   one element matches.
;;;
;;; Example:
;;;   (list-count (parse-first (sep-by1 (satisfy digit?) (pchar #\,)) "1,2,3"))  ; => 3
;;;
;;; Since: parsec-guide-plan

(defn sep-by1 [A S] [p : (Parser A) sep : (Parser S)] : (Parser (List A))
  (:: (sep-by1-raw (:: p :int) (:: sep :int)) :Parser))
;;; sep-by -- zero or more p, separated by sep.
;;;
;;; Parameters:
;;;   p   -- the element parser
;;;   sep -- the separator parser (its values are discarded)
;;;
;;; Returns:
;;;   A (Parser (List A)) of the elements, in order -- the empty list when
;;;   not even one element matches.
;;;
;;; Example:
;;;   (list-count (parse-first (sep-by (satisfy digit?) (pchar #\,)) "1,2"))  ; => 2
;;;   (list-empty? (parse-first (sep-by (satisfy digit?) (pchar #\,)) ""))   ; => true
;;;
;;; Since: parsec-guide-plan

(defn sep-by [A S] [p : (Parser A) sep : (Parser S)] : (Parser (List A))
  (:: (or-else-raw (:: (sep-by1 p sep) :int) (pure-parser 0)) :Parser))
;; ── Runners ──────────────────────────────────────────────────────────────────
;;; ParseResult -- one (possibly partial) parse: the value and where it stopped.
;;;
;;; An element of what `run-parser` returns.  Read it with
;;; `parse-result-value` and `parse-result-rest`.
;;;
;;; Since: parsec-guide-plan P7
(defopaque ParseResult [A] :int)
;;; parse-result-value -- the value a parse produced.
;;;
;;; Parameters:
;;;   r -- one element of a run-parser result
;;;
;;; Returns:
;;;   The parsed value.
;;;
;;; Example:
;;;   (parse-result-value (list-first (run-parser (item) "ab")))  ; => #\a
;;;
;;; Since: parsec-guide-plan P7

(defn parse-result-value [A] [r : (ParseResult A)] : A
  (:: (pair-first (:: r :int)) A))
;;; parse-result-rest -- the input a parse left unread.
;;;
;;; Parameters:
;;;   r -- one element of a run-parser result
;;;
;;; Returns:
;;;   A fresh owned String holding the unconsumed suffix ("" for a full parse).
;;;
;;; Example:
;;;   (string/to-cstr (parse-result-rest (list-first (run-parser (item) "ab"))))  ; => "b"
;;;
;;; Since: parsec-guide-plan P7

(defn parse-result-rest [A] [r : (ParseResult A)] : String
  (string/from-cstr (input-rest (pair-second (:: r :int)))))
;;; run-parser-raw -- carrier worker: the raw result Cell list for p on s.

(defn run-parser-raw [A] [p : (Parser A) s : cstr] : int
  (let [inp (input-new s 0)] (apply-parser (:: p :int) inp)))
;;; run-parser -- every parse of s, complete or partial.
;;;
;;; The debugging runner: it shows each way p can read a prefix of s, in the
;;; order the backtracking produced them.
;;;
;;; Parameters:
;;;   p -- the parser to run
;;;   s -- the input text
;;;
;;; Returns:
;;;   A (List (ParseResult A)) -- empty when p cannot read any prefix of s.
;;;
;;; Example:
;;;   (list-count (run-parser (alt-or (pchar #\a) (item)) "ab"))  ; => 2
;;;
;;; Since: Phase B1 (typed: parsec-guide-plan P7)

(defn run-parser [A] [p : (Parser A) s : cstr] : (List (ParseResult A))
  (:: (run-parser-raw p s) (List (ParseResult A))))
;;; run-parser-full-raw -- internal: the first result Cell that consumed all
;;; of its input, or 0.

(defn run-parser-full-raw [results] : int
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  typedef struct { int64_t str; int64_t pos; } Input;
  Cell *c = (Cell*)(intptr_t)results;
  while (c) {
      Tuple2 *pr = (Tuple2*)(intptr_t)c->value;
      Input *inp_p = (Input*)(intptr_t)pr->e2;
      const char *s = (const char*)(intptr_t)inp_p->str;
      if (s[inp_p->pos] == '\0') return (int64_t)(intptr_t)c;
      c = (Cell*)(intptr_t)c->next;
  }
  return 0;
  ```)
;;; run-parser-full -- the first parse that consumes all of s.
;;;
;;; Parameters:
;;;   p -- the parser to run
;;;   s -- the input text
;;;
;;; Returns:
;;;   `(some v)` for the first parse (in backtracking order) that read all of
;;;   s, `(none)` when every parse left input over or none succeeded.
;;;
;;; Example:
;;;   (some? (run-parser-full (pchar #\A) "A"))   ; => true
;;;   (some? (run-parser-full (pchar #\A) "AB"))  ; => false (leftover "B")
;;;
;;; Since: Phase B1 (typed: parsec-guide-plan P7)

(defn run-parser-full [A] [p : (Parser A) s : cstr] : (Option A)
  (let [c (run-parser-full-raw (run-parser-raw p s))]
    (if (= c 0) (none) (some (:: (pair-first (list-head c)) A)))))
;;; parse-failure-message -- internal: "parse failed at: ..." for parse-first.
;;;
;;; Names where the longest partial parse stopped (the whole input when
;;; nothing parsed), so a failing test says where to look.

(defn parse-failure-message [results s : cstr] : cstr
  ```c
  typedef struct { int64_t value; int64_t next; } Cell;
  typedef struct { int64_t str; int64_t pos; } Input;
  extern size_t strlen(const char *);
  int64_t best = 0;
  for (Cell *c = (Cell*)(intptr_t)results; c; c = (Cell*)(intptr_t)c->next) {
      Input *ip = (Input*)(intptr_t)((Tuple2*)(intptr_t)c->value)->e2;
      if (ip->pos > best) best = ip->pos;
  }
  size_t n = strlen(s) * 2 + 64;
  char *msg = malloc(n);
  if (best == 0)
      snprintf(msg, n, "parse failed at: \"%s\"", s);
  else
      snprintf(msg, n, "parse failed at: \"%s\" (after \"%.*s\")",
               s + best, (int)best, s);
  return msg;
  ```)
;;; parse-fail__ -- internal: panic with parse-failure-message.

(defn parse-fail__ [results s : cstr] : int
  (do (panic (parse-failure-message results s)) 0))
;;; parse-first -- the value of the first full parse, or a panic.
;;;
;;; A convenience for `main` and tests, where input that does not parse is a
;;; programming error.  Anywhere a bad input is expected, use
;;; `run-parser-full` and handle `(none)`.
;;;
;;; Parameters:
;;;   p -- the parser to run
;;;   s -- the input text
;;;
;;; Returns:
;;;   The value `run-parser-full` would wrap in `some`.  When there is none
;;;   it panics with `parse failed at: "<unread input>"`.
;;;
;;; Example:
;;;   (parse-first (pchar #\A) "A")  ; => #\A
;;;   (parse-first (pchar #\A) "B")  ; panics: parse failed at: "B"
;;;
;;; Since: parsec-guide-plan P7

(defn parse-first [A] [p : (Parser A) s : cstr] : A
  (let [results (run-parser-raw p s)
        c       (run-parser-full-raw results)]
    (:: (if (= c 0) (parse-fail__ results s) (pair-first (list-head c))) A)))
;; ── HKT typeclass instances (stdlib-hkt-consolidation T2) ────────────────────
;;
;; Parser is a kind-(* -> *) handle (carrier: the fat-closure pointer), so the
;; standard Functor / Applicative / Monad / Alternative instances are all
;; directly expressible and own their type (no orphans). Each method delegates
;; to a worker above. The continuation parameter of `fmap` / `bind` arrives as a
;; typeclass-method poly closure; now that a `:fn` value is a first-class
;; callable, the worker declares its callback `:fn` and applies it directly
;; (captured into the deferred parser closure), so the instance bodies just hand
;; the continuation straight through -- no `^fat`-sink shim, no `apply-fat`.
;;; fmap-parser-raw -- worker: map a `:fn` callback over the value arm of a parser.

(defn fmap-parser-raw [p f : fn] : ptr<void>
  (let [lp p]
    (fn [inp]
      (let [_ lp]
        (mbind (apply-parser lp inp)
          (fn [pair]
            (mreturn (pair-new (f (pair-first pair)) (pair-second pair)))))))))
;;; ap-parser-raw -- int worker: sequential application of a parser of functions.

(defn ap-parser-raw [pf pa] : ptr<void>
  (let [lpf pf
        lpa pa]
    (fn [inp]
      (let [_ lpf]
        (mbind (apply-parser lpf inp)
          (fn [fpair]
            (let [_ lpa]
              (mbind (apply-parser lpa (pair-second fpair))
                (fn [apair]
                  (mreturn (pair-new (apply-fat (pair-first fpair)
                                       (pair-first apair))
                             (pair-second apair))))))))))))
;;; Functor [Parser] -- map a function over each parsed value.
;;;
;;; Example:
;;;   (fmap (satisfy digit?) char->digit)  ; a (Parser int): the digit's value
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Functor [Parser]
  (fmap [container fn] (:: (fmap-parser-raw (:: container :int) fn) :Parser)))
;;; Applicative [Parser] -- pure injects a value without consuming input; ap
;;; runs a parser of functions then a parser of arguments, applying one to the
;;; other.
;;;
;;; Example:
;;;   (:: (pure 42) (Parser int))  ; succeeds with 42, consumes nothing
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Applicative [Parser]
  (pure [x] (:: (pure-parser x) :Parser))
  (ap [ff fa] (:: (ap-parser-raw (:: ff :int) (:: fa :int)) :Parser)))
;;; Monad [Parser] -- bind sequences parsers, threading each parsed value into
;;; the continuation. This is what `do-m` / `for` lower onto.
;;;
;;; Example:
;;;   (do-m a (item) b (item) (pure (char=? a b)))  ; two equal characters?
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Monad [Parser]
  (bind [ma k] (:: (bind-parser (:: ma :int) k) :Parser)))
;;; Alternative [Parser] -- empty is the always-failing parser; alt-or runs both
;;; parsers and unions their results (full backtracking choice).
;;;
;;; Example:
;;;   (alt-or (pchar #\Y) (pchar #\N))  ; match 'Y' or 'N'
;;;
;;; Since: stdlib-hkt-consolidation T2

(definstance Alternative [Parser]
  (empty [a] (:: (pfail-raw) :Parser))
  (alt-or [a b] (:: (or-parser-raw (:: a :int) (:: b :int)) :Parser)))
