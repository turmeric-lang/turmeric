;; --- public surface.  len / ref / set! are inline-C themselves, not wrappers
;; over a raw body, so a panic is reported at the CALLER's line (as vec-get's
;; is) and so turi's natives are keyed by the public names. ---
;;; f32vec-new -- allocate a F32Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh F32Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (f32vec-new 4 (:: 3.25 float32))]
;;;     (f32vec-ref v 2))   ; => (:: 3.25 float32)
;;;
;;; Since: Phase N0

(defn f32vec-new [n : int init : float32] : F32Vec
  (:: (unsafe (__f32vec-new-raw n (as float init))) :F32Vec))
;;; f32vec-id__ -- internal: hand the array straight back.
;;;
;;; `f32vec-of` wraps its `let` in this so the binding that receives the result is
;;; seen to be initialised by a call, and owns it: a `let` that yields a moved
;;; local is read as "moved during init", and the scope-exit Drop is skipped.

(defn f32vec-id__ [v : F32Vec] : F32Vec v)
;;; f32vec-of -- a F32Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type float32
;;;
;;; Returns:
;;;   A fresh F32Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))]
;;;     (f32vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro f32vec-of [& xs]
  (list f32vec-id__
        (list let `[__nv (f32vec-new (numvec-count__ ~@xs) (as float32 0.0))]
          (list numvec-fill__ f32vec-set! __nv 0 ~@xs))))
;;; f32vec-free -- release a F32Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound F32Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (f32vec-free v)
;;;
;;; Since: Phase N0

(defn f32vec-free [v : F32Vec] : nil
  (unsafe (__f32vec-free-raw (:: v :int))))
;;; Drop [F32Vec] -- free the array when a bound F32Vec dies unmoved.

(definstance Drop [F32Vec] (drop [x] : void (f32vec-free x)))
;;; f32vec-len -- the element count of a F32Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (f32vec-new 8 (:: 3.25 float32))]
;;;     (f32vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn f32vec-len [^borrow v : F32Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; f32vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed float32.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))]
;;;     (f32vec-ref v 1))   ; => (:: 2.5 float32)
;;;
;;; Since: Phase N0

(defn f32vec-ref [^borrow v : F32Vec i : int]
  #fx{}
  #reads v
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("f32vec-ref: index out of bounds");
  return 0;
  ```)
;;; f32vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (f32vec-set! v 0 (:: 3.25 float32))
;;;
;;; Since: Phase N0

;;; f32vec-widen__ -- internal: an element as the wide type the inline-C setter takes.
;;;
;;; A typed function, so the call checks x against float32 exactly as any call
;;; does: an `int` variable is refused, not truncated on the way in.

(defn f32vec-widen__ [x : float32] : float (as float x))

(defn f32vec-set-w__ [^borrow v : F32Vec i : int x : float]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  /* a number, never a pointer: no TUR_REGION_NOTE (Region Store Hooks). */
  if (i >= 0 && i < a->len) { a->data[i] = (float)x; return; }
  tur_panic("f32vec-set!: index out of bounds");
  ```)
;;; f32vec-set! -- store x at index i (bounds-checked).  A macro: see below.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element, of type float32
;;;
;;; Note: a macro rather than a function, because an inline-C function with a
;;; float32 parameter warns (TUR-W0037).  It checks x against float32 (through
;;; f32vec-widen__) and expands at the call, so a panic names the caller's line.
;;;
;;; Example:
;;;   (f32vec-set! v 0 (:: 3.25 float32))
;;;
;;; Since: Phase N0

(defmacro f32vec-set! [v i x]
  (list f32vec-set-w__ v i (list f32vec-widen__ x)))
;;; f32vec-copy -- a fresh F32Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (f32vec-copy v)] (f32vec-set! c 0 (:: 3.25 float32)))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn f32vec-copy [^borrow v : F32Vec] : F32Vec
  (:: (unsafe (__f32vec-copy-raw (:: v :int))) :F32Vec))
;;; f32vec->vec-go__ -- internal: push v[i..n) onto out.

(defn f32vec->vec-go__ [^borrow v : F32Vec out : (Vec float32) i : int n : int] : (Vec float32)
  (if (>= i n)
    out
    (do
      (vec-push! out (f32vec-ref v i))
      (f32vec->vec-go__ v out {i + 1} n))))
;;; f32vec->vec -- copy a F32Vec into a fresh (Vec float32).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (f32vec-of (:: 1.5 float32) (:: 2.5 float32))
;;;         v (f32vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn f32vec->vec [^borrow v : F32Vec] : (Vec float32)
  (f32vec->vec-go__ v (:: (vec-new) (Vec float32)) 0 (f32vec-len v)))
;;; vec->f32vec-go__ -- internal: store src[i..n) into out.

(defn vec->f32vec-go__ [^borrow out : F32Vec ^borrow src : (Vec float32) i : int n : int] : nil
  (if (>= i n)
    nil
    (do
      (f32vec-set! out i (:: (vec-get src i) float32))
      (vec->f32vec-go__ out src {i + 1} n))))
;;; vec->f32vec -- copy a (Vec float32) into a fresh F32Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A F32Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of (:: 1.5 float32) (:: 2.5 float32))
;;;         a (vec->f32vec v)]
;;;     (f32vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->f32vec [^borrow src : (Vec float32)] : F32Vec
  (let [out (f32vec-new (vec-len src) (as float32 0.0))]
    (vec->f32vec-go__ out src 0 (vec-len src))
    out))
;;; f32vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn f32vec-show-loop__ [^borrow v : F32Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (f32vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (f32vec-show-loop__ v {i + 1} n b))))
;;; f32vec-show -- render a F32Vec as an owned "#f32vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))]
;;;     (f32vec-show v))   ; => String "#f32vec[1.5 2.5]"
;;;
;;; Since: Phase N0

(defn f32vec-show [^borrow v : F32Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#f32vec[")
      (f32vec-show-loop__ v 0 (f32vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; ===== I64Vec: 64-bit integers =====
;;; I64Vec -- a fixed-length, unboxed array of 64-bit integers (int).
;;;
;;; Opaque handle to a `struct { int64_t len; int64_t *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `i64vec-new` or
;;; `i64vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine I64Vec :int)
;; --- raw layer (private): allocation.  turi has native twins. ---

(defn __i64vec-new-raw [n : int init : int]
  #fx{Unsafe}
  : int
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(int64_t)) {
    tur_panic("i64vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; int64_t *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "i64vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(int64_t) + 32);
  if (!b->raw) { fprintf(stderr, "i64vec-new: out of memory\n"); abort(); }
  b->data = (int64_t *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = (int64_t)init;
  return (int64_t)(intptr_t)b;
  ```)

(defn __i64vec-free-raw [b : int]
  #fx{Unsafe}
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *v = (void*)(intptr_t)b;
  if (v) { free(v->raw); free(v); }
  ```)

(defn __i64vec-copy-raw [b : int]
  #fx{Unsafe}
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *v = (void*)(intptr_t)b;
  struct { int64_t len; int64_t *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "i64vec-copy: out of memory\n"); abort(); }
  c->len = v->len;
  c->raw = malloc((size_t)v->len * sizeof(int64_t) + 32);
  if (!c->raw) { fprintf(stderr, "i64vec-copy: out of memory\n"); abort(); }
  c->data = (int64_t *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (v->len > 0) memcpy(c->data, v->data, (size_t)v->len * sizeof(int64_t));
  return (int64_t)(intptr_t)c;
  ```)
;; --- public surface.  len / ref / set! are inline-C themselves, not wrappers
;; over a raw body, so a panic is reported at the CALLER's line (as vec-get's
;; is) and so turi's natives are keyed by the public names. ---
;;; i64vec-new -- allocate a I64Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh I64Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (i64vec-new 4 7)]
;;;     (i64vec-ref v 2))   ; => 7
;;;
;;; Since: Phase N0

(defn i64vec-new [n : int init : int] : I64Vec
  (:: (unsafe (__i64vec-new-raw n init)) :I64Vec))
;;; i64vec-id__ -- internal: hand the array straight back.
;;;
;;; `i64vec-of` wraps its `let` in this so the binding that receives the result is
;;; seen to be initialised by a call, and owns it: a `let` that yields a moved
;;; local is read as "moved during init", and the scope-exit Drop is skipped.

(defn i64vec-id__ [v : I64Vec] : I64Vec v)
;;; i64vec-of -- a I64Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type int
;;;
;;; Returns:
;;;   A fresh I64Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)]
;;;     (i64vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro i64vec-of [& xs]
  (list i64vec-id__
        (list let `[__nv (i64vec-new (numvec-count__ ~@xs) 0)]
          (list numvec-fill__ i64vec-set! __nv 0 ~@xs))))
;;; i64vec-free -- release a I64Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound I64Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (i64vec-free v)
;;;
;;; Since: Phase N0

(defn i64vec-free [v : I64Vec] : nil
  (unsafe (__i64vec-free-raw (:: v :int))))
;;; Drop [I64Vec] -- free the array when a bound I64Vec dies unmoved.

(definstance Drop [I64Vec] (drop [x] : void (i64vec-free x)))
;;; i64vec-len -- the element count of a I64Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (i64vec-new 8 7)]
;;;     (i64vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn i64vec-len [^borrow v : I64Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; i64vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed int.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)]
;;;     (i64vec-ref v 1))   ; => 2
;;;
;;; Since: Phase N0

(defn i64vec-ref [^borrow v : I64Vec i : int]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("i64vec-ref: index out of bounds");
  return 0;
  ```)
;;; i64vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (i64vec-set! v 0 7)
;;;
;;; Since: Phase N0

;;; i64vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (i64vec-set! v 0 7)
;;;
;;; Since: Phase N0

(defn i64vec-set! [^borrow v : I64Vec i : int x : int]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  /* a number, never a pointer: no TUR_REGION_NOTE (Region Store Hooks). */
  if (i >= 0 && i < a->len) { a->data[i] = x; return; }
  tur_panic("i64vec-set!: index out of bounds");
  ```)
;;; i64vec-copy -- a fresh I64Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (i64vec-copy v)] (i64vec-set! c 0 7))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn i64vec-copy [^borrow v : I64Vec] : I64Vec
  (:: (unsafe (__i64vec-copy-raw (:: v :int))) :I64Vec))
;;; i64vec->vec-go__ -- internal: push v[i..n) onto out.

(defn i64vec->vec-go__ [^borrow v : I64Vec out : (Vec int) i : int n : int] : (Vec int)
  (if (>= i n)
    out
    (do
      (vec-push! out (i64vec-ref v i))
      (i64vec->vec-go__ v out {i + 1} n))))
;;; i64vec->vec -- copy a I64Vec into a fresh (Vec int).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (i64vec-of 1 2)
;;;         v (i64vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn i64vec->vec [^borrow v : I64Vec] : (Vec int)
  (i64vec->vec-go__ v (:: (vec-new) (Vec int)) 0 (i64vec-len v)))
;;; vec->i64vec-go__ -- internal: store src[i..n) into out.

(defn vec->i64vec-go__ [^borrow out : I64Vec ^borrow src : (Vec int) i : int n : int] : nil
  (if (>= i n)
    nil
    (do
      (i64vec-set! out i (:: (vec-get src i) int))
      (vec->i64vec-go__ out src {i + 1} n))))
;;; vec->i64vec -- copy a (Vec int) into a fresh I64Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A I64Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of 1 2)
;;;         a (vec->i64vec v)]
;;;     (i64vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->i64vec [^borrow src : (Vec int)] : I64Vec
  (let [out (i64vec-new (vec-len src) 0)]
    (vec->i64vec-go__ out src 0 (vec-len src))
    out))
;;; i64vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn i64vec-show-loop__ [^borrow v : I64Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (i64vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (i64vec-show-loop__ v {i + 1} n b))))
;;; i64vec-show -- render a I64Vec as an owned "#i64vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)]
;;;     (i64vec-show v))   ; => String "#i64vec[1 2]"
;;;
;;; Since: Phase N0

(defn i64vec-show [^borrow v : I64Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#i64vec[")
      (i64vec-show-loop__ v 0 (i64vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; ===== I32Vec: 32-bit integers =====
;;; I32Vec -- a fixed-length, unboxed array of 32-bit integers (int32).
;;;
;;; Opaque handle to a `struct { int64_t len; int32_t *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `i32vec-new` or
;;; `i32vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine I32Vec :int)
;; --- raw layer (private): allocation.  turi has native twins. ---

(defn __i32vec-new-raw [n : int init : int]
  #fx{Unsafe}
  : int
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(int32_t)) {
    tur_panic("i32vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; int32_t *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "i32vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(int32_t) + 32);
  if (!b->raw) { fprintf(stderr, "i32vec-new: out of memory\n"); abort(); }
  b->data = (int32_t *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = (int32_t)init;
  return (int64_t)(intptr_t)b;
  ```)

(defn __i32vec-free-raw [b : int]
  #fx{Unsafe}
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *v = (void*)(intptr_t)b;
  if (v) { free(v->raw); free(v); }
  ```)

(defn __i32vec-copy-raw [b : int]
  #fx{Unsafe}
  : int
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *v = (void*)(intptr_t)b;
  struct { int64_t len; int32_t *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "i32vec-copy: out of memory\n"); abort(); }
  c->len = v->len;
  c->raw = malloc((size_t)v->len * sizeof(int32_t) + 32);
  if (!c->raw) { fprintf(stderr, "i32vec-copy: out of memory\n"); abort(); }
  c->data = (int32_t *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
