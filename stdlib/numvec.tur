;;; tur/numvec -- typed numeric arrays: F64Vec, F32Vec, I64Vec, I32Vec, U8Vec.
;;;
;;; GENERATED by tools/gen-numvec.py -- edit the template there, not this file.
;;;
;;; A fixed-length, homogeneous, unboxed array of one numeric element type, in
;;; the manner of Racket's `flvector`.  Each type is its own opaque handle over
;;; one C layout:
;;;
;;; ```c
;;; struct { int64_t len; T *data; void *raw; }   /* T = double, float, ... */
;;; ```
;;;
;;; `data` is 32-byte aligned (`raw` is the malloc block it was carved from,
;;; and what `free` is given), so an aligned SIMD load is legal on it and gcc
;;; can skip its peeling prologue.  The element is its real width: a `U8Vec`
;;; uses one byte a slot, not eight as a `Vec` does.
;;;
;;; | Type   | Element   | Constructor               |
;;; |--------|-----------|---------------------------|
;;; | F64Vec | `float`   | `(f64vec-new n init)`     |
;;; | F32Vec | `float32` | `(f32vec-new n init)`     |
;;; | I64Vec | `int`     | `(i64vec-new n init)`     |
;;; | I32Vec | `int32`   | `(i32vec-new n init)`     |
;;; | U8Vec  | `uint8`   | `(u8vec-new n init)`      |
;;;
;;; Every type has these operations, named by its prefix `P` (`f64vec`,
;;; `f32vec`, `i64vec`, `i32vec`, `u8vec`):
;;;
;;; - access: `P-new`, `P-of`, `P-len`, `P-ref`, `P-set!`, `P-copy`, `P->vec`,
;;;   `vec->P`, `P-show`;
;;; - bulk kernels (phase N1), each one C loop that vectorizes at tur's default
;;;   -O2 build as well as at `--release`:
;;;   `P-fill!`, `P-copy!`, `P-add!`, `P-sum`, `P-min`, `P-max`, and except on
;;;   U8Vec `P-scale!`, `P-axpy!`, `P-dot`; the float types add
;;;   `P-sum-ordered`.  A float reduction uses a fixed eight-lane order, so it
;;;   is vectorized without -ffast-math and is bit-identical on every engine;
;;;   integer arithmetic wraps;
;;; - loops (phase N2): `P-for`, `P-for-index`, `P-fold`, `P-build`, which
;;;   bind elements, never an index the program could get wrong, and read
;;;   through the unchecked `P-ref-unchecked` / `P-set-unchecked!`
;;;   (`#fx{Unsafe}`).  A loop that only reads an array vectorizes; one that
;;;   stores into one does not yet (see the plan's N2 notes).
;;;
;;; Ownership: each type is `^affine` with a `Drop` instance, so a let-bound
;;; array is freed at scope exit, exactly once, and moving it (returning it,
;;; passing it to a consumer) hands that duty on.  The accessors take it
;;; `^borrow`.  `P-free` consumes an array early.
;;;
;;; A temporary handed straight to an accessor that returns a number --
;;; `(f64vec-len (f64vec-new 4 0.0))` -- is freed after the call.  One handed to
;;; anything else (`P-copy`, `P->vec`, `P-show`, or after an argument with side
;;; effects) has no owner and is not freed, so bind it first:
;;; `(let [v (f64vec-new 4 0.0)] (f64vec-show v))`
;;; (docs/reported/borrowed-drop-temporary-leaks-outside-the-hoist.md).
;;;
;;; A closure that captures an array the enclosing scope OWNS takes it over
;;; (the scope can no longer use it, and the closure frees it); one that
;;; captures a `^borrow` parameter borrows it, and frees nothing.
;;;
;;; Length is fixed at construction.  Growth stays `Vec`'s job; `P->vec` and
;;; `vec->P` convert.  An index outside `[0, len)` panics, at the caller's
;;; line, on every engine.
;;;
;;; Region stores: an element store writes a number, never a pointer, so the
;;; setters carry no TUR_REGION_NOTE (CLAUDE.md, "Region Store Hooks" covers a
;;; caller's word that can outlive a bracket -- a pointer).
;;;
;;; Since: Phase N0 (simd-and-vectorization-plan)
(load "stdlib/typeclass.tur")

;;; numvec-of__ -- internal: the flat body of every `P-of`.
;;;
;;; `(numvec-of__ new set! zero v x0 x1 ...)` expands to
;;; `(let [v (new n zero)] (do (set! v 0 x0) (set! v 1 x1) ... v))`.  A
;;; procedural macro, so it counts its arguments and emits one flat body: a
;;; template macro recurses once per element and stops at the 256-deep
;;; expansion limit.  `v` comes from the caller, minted there with `(gensym)`,
;;; which is fresh against the program's own names (`syntax-gensym` here is
;;; fresh only against the macro-time env's).

(defmacro* numvec-of__
  [new setter zero v & xs]
  (let [n (syntax-len xs)]
    (letrec [sets
             (fn [i : int acc : Syntax] : Syntax
               (if (< i 0)
                 acc
                 (sets (- i 1)
                   (syntax-cons `(~setter ~v
                                   ~(int->syntax i)
                                   ~(syntax-nth xs i))
                     acc))))]
      (let [mk   `(~new ~(int->syntax n) ~zero)
            bind (syntax-vec v mk)
            body (syntax-cons (sym->syntax "do") (sets (- n 1) (syntax-list v)))]
        `(let ~bind ~body)))))
;; ===== F64Vec: 64-bit floats =====
;;; F64Vec -- a fixed-length, unboxed array of 64-bit floats (float).
;;;
;;; Opaque handle to a `struct { int64_t len; double *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `f64vec-new` or
;;; `f64vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine F64Vec :int)
;; Every operation that touches the header is an inline-C body of its own,
;; never a Turmeric wrapper over a raw one, so a panic is reported at the
;; CALLER's line (as vec-get's is) and turi's natives are keyed by the public
;; names.  An element store writes a number, never a pointer, so the setter
;; carries no TUR_REGION_NOTE (CLAUDE.md, "Region Store Hooks").
;;; f64vec-new -- allocate a F64Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh F64Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (f64vec-new 4 7.1)]
;;;     (f64vec-ref v 2))   ; => 7.1
;;;
;;; Since: Phase N0

(defn f64vec-new [n : int init : float]
  #fx{}
  : F64Vec
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(double)) {
    tur_panic("f64vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; double *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "f64vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(double) + 32);
  if (!b->raw) { fprintf(stderr, "f64vec-new: out of memory\n"); abort(); }
  b->data = (double *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = init;
  return (int64_t)(intptr_t)b;
  ```)
;;; f64vec-of -- a F64Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type float
;;;
;;; Returns:
;;;   A fresh F64Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)]
;;;     (f64vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro f64vec-of [& xs]
  (let [v (gensym "nv")] (list numvec-of__ f64vec-new f64vec-set! 0.0 v ~@xs)))
;;; f64vec-free -- release a F64Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound F64Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (f64vec-free v)
;;;
;;; Since: Phase N0

(defn f64vec-free [v : F64Vec]
  #fx{}
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  if (a) { free(a->raw); free(a); }
  ```)
;;; Drop [F64Vec] -- free the array when a bound F64Vec dies unmoved.

(definstance Drop [F64Vec] (drop [x] : void (f64vec-free x)))
;;; f64vec-len -- the element count of a F64Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (f64vec-new 8 7.1)]
;;;     (f64vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn f64vec-len [^borrow v : F64Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; f64vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed float.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)]
;;;     (f64vec-ref v 1))   ; => 2.5
;;;
;;; Since: Phase N0

(defn f64vec-ref [^borrow v : F64Vec i : int]
  #fx{}
  #reads v
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("f64vec-ref: index out of bounds");
  return 0;
  ```)
;;; f64vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (f64vec-set! v 0 7.1)
;;;
;;; Since: Phase N0

(defn f64vec-set! [^borrow v : F64Vec i : int x : float]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) { a->data[i] = x; return; }
  tur_panic("f64vec-set!: index out of bounds");
  ```)
;;; f64vec-copy -- a fresh F64Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (f64vec-copy v)] (f64vec-set! c 0 7.1))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn f64vec-copy [^borrow v : F64Vec]
  #fx{}
  : F64Vec
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  struct { int64_t len; double *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "f64vec-copy: out of memory\n"); abort(); }
  c->len = a->len;
  c->raw = malloc((size_t)a->len * sizeof(double) + 32);
  if (!c->raw) { fprintf(stderr, "f64vec-copy: out of memory\n"); abort(); }
  c->data = (double *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (a->len > 0) memcpy(c->data, a->data, (size_t)a->len * sizeof(double));
  return (int64_t)(intptr_t)c;
  ```)
;;; f64vec->vec-go__ -- internal: push v[i..n) onto out.

(defn f64vec->vec-go__ [^borrow v : F64Vec out : (Vec float) i : int n : int] : (Vec float)
  (if (>= i n)
    out
    (do (vec-push! out (f64vec-ref v i)) (f64vec->vec-go__ v out (+ i 1) n))))
;;; f64vec->vec -- copy a F64Vec into a fresh (Vec float).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (f64vec-of 1.5 2.5)
;;;         v (f64vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn f64vec->vec [^borrow v : F64Vec] : (Vec float)
  (f64vec->vec-go__ v (:: (vec-new) (Vec float)) 0 (f64vec-len v)))
;;; vec->f64vec-go__ -- internal: store src[i..n) into out.

(defn vec->f64vec-go__ [^borrow out : F64Vec
                        ^borrow src : (Vec float)
                        i : int
                        n : int] : nil
  (if (>= i n)
    nil
    (do
      (f64vec-set! out i (:: (vec-get src i) float))
      (vec->f64vec-go__ out src (+ i 1) n))))
;;; vec->f64vec -- copy a (Vec float) into a fresh F64Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A F64Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of 1.5 2.5)
;;;         a (vec->f64vec v)]
;;;     (f64vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->f64vec [^borrow src : (Vec float)] : F64Vec
  (let [out (f64vec-new (vec-len src) 0.0)]
    (vec->f64vec-go__ out src 0 (vec-len src))
    out))
;;; f64vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn f64vec-show-loop__ [^borrow v : F64Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (f64vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (f64vec-show-loop__ v (+ i 1) n b))))
;;; f64vec-show -- render a F64Vec as an owned "#f64vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)]
;;;     (f64vec-show v))   ; => String "#f64vec[1.5 2.5]"
;;;
;;; Since: Phase N0

(defn f64vec-show [^borrow v : F64Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#f64vec[")
      (f64vec-show-loop__ v 0 (f64vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; --- N1 bulk kernels, N2 unchecked access and loops (tools/gen-numvec.py) ---
;;; f64vec-fill! -- store x in every slot.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   x -- the value
;;;
;;; Example:
;;;   (f64vec-fill! v 1.5)
;;;
;;; Since: Phase N1

(defn f64vec-fill! [^borrow v : F64Vec x : float]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  double *d = a->data;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = x;
    d[i + 1] = x;
    d[i + 2] = x;
    d[i + 3] = x;
    d[i + 4] = x;
    d[i + 5] = x;
    d[i + 6] = x;
    d[i + 7] = x;
  }
  for (; i < n; i++) d[i] = x;
  ```)
;;; f64vec-copy! -- copy src's elements into dst (same length, or a panic).
;;;
;;; Parameters:
;;;   dst -- the array written (borrowed)
;;;   src -- the array read (borrowed)
;;;
;;; Example:
;;;   (f64vec-copy! dst src)
;;;
;;; Since: Phase N1

(defn f64vec-copy! [^borrow dst : F64Vec ^borrow src : F64Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; double *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("f64vec-copy!: length mismatch");
      return;
    }
  if (y->len > 0) memmove(y->data, x->data, (size_t)y->len * sizeof(double));
  ```)
;;; f64vec-scale! -- multiply every element by s, in place.
;;;
;;; Integer arithmetic wraps.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   s -- the factor
;;;
;;; Example:
;;;   (f64vec-scale! v 2.5)
;;;
;;; Since: Phase N1

(defn f64vec-scale! [^borrow v : F64Vec s : float]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  double *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) d[i] = d[i] * s;
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = d[i] * s;
    d[i + 1] = d[i + 1] * s;
    d[i + 2] = d[i + 2] * s;
    d[i + 3] = d[i + 3] * s;
    d[i + 4] = d[i + 4] * s;
    d[i + 5] = d[i + 5] * s;
    d[i + 6] = d[i + 6] * s;
    d[i + 7] = d[i + 7] * s;
  }
  for (; i < n; i++) d[i] = d[i] * s;
  #endif
  ```)
;;; f64vec-add! -- dst[i] += src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; dst and src may be the same array.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   src -- the array added (borrowed)
;;;
;;; Example:
;;;   (f64vec-add! y x)
;;;
;;; Since: Phase N1

(defn f64vec-add! [^borrow dst : F64Vec ^borrow src : F64Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; double *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("f64vec-add!: length mismatch");
      return;
    }
  int64_t n = y->len;
  double *yd = y->data;
  const double *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) yd[i] = yd[i] + xd[i];
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    double y0 = yd[i], x0 = xd[i];
    double y1 = yd[i + 1], x1 = xd[i + 1];
    double y2 = yd[i + 2], x2 = xd[i + 2];
    double y3 = yd[i + 3], x3 = xd[i + 3];
    double y4 = yd[i + 4], x4 = xd[i + 4];
    double y5 = yd[i + 5], x5 = xd[i + 5];
    double y6 = yd[i + 6], x6 = xd[i + 6];
    double y7 = yd[i + 7], x7 = xd[i + 7];
    yd[i] = y0 + x0;
    yd[i + 1] = y1 + x1;
    yd[i + 2] = y2 + x2;
    yd[i + 3] = y3 + x3;
    yd[i + 4] = y4 + x4;
    yd[i + 5] = y5 + x5;
    yd[i + 6] = y6 + x6;
    yd[i + 7] = y7 + x7;
  }
  for (; i < n; i++) yd[i] = yd[i] + xd[i];
  #endif
  ```)
;;; f64vec-axpy! -- dst[i] += s * src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; the multiply and the add are not fused.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   s -- the factor
;;;   src -- the array scaled and added (borrowed)
;;;
;;; Example:
;;;   (f64vec-axpy! y 2.5 x)
;;;
;;; Since: Phase N1

(defn f64vec-axpy! [^borrow dst : F64Vec s : float ^borrow src : F64Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; double *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("f64vec-axpy!: length mismatch");
      return;
    }
  int64_t n = y->len;
  double *yd = y->data;
  const double *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) { double m = s * xd[i]; yd[i] = yd[i] + m; }
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    double y0 = yd[i], x0 = xd[i];
    double y1 = yd[i + 1], x1 = xd[i + 1];
    double y2 = yd[i + 2], x2 = xd[i + 2];
    double y3 = yd[i + 3], x3 = xd[i + 3];
    double y4 = yd[i + 4], x4 = xd[i + 4];
    double y5 = yd[i + 5], x5 = xd[i + 5];
    double y6 = yd[i + 6], x6 = xd[i + 6];
    double y7 = yd[i + 7], x7 = xd[i + 7];
    double m0 = s * x0;
    double m1 = s * x1;
    double m2 = s * x2;
    double m3 = s * x3;
    double m4 = s * x4;
    double m5 = s * x5;
    double m6 = s * x6;
    double m7 = s * x7;
    yd[i] = y0 + m0;
    yd[i + 1] = y1 + m1;
    yd[i + 2] = y2 + m2;
    yd[i + 3] = y3 + m3;
    yd[i + 4] = y4 + m4;
    yd[i + 5] = y5 + m5;
    yd[i + 6] = y6 + m6;
    yd[i + 7] = y7 + m7;
  }
  for (; i < n; i++) { double m = s * xd[i]; yd[i] = yd[i] + m; }
  #endif
  ```)
;;; f64vec-sum -- the sum of the elements.
;;;
;;; A float sum is computed in eight interleaved partial sums (lane k
;;; takes the elements i with i mod 8 = k), combined in one fixed tree:
;;; the same answer on every engine and machine, and vectorizable without
;;; -ffast-math.  It can differ in the last bits from `-sum-ordered`, the
;;; left-to-right sum.  An integer sum wraps modulo 2^64; a narrow element
;;; is widened to `int` first.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)] (f64vec-sum v))
;;;
;;; Since: Phase N1

(defn f64vec-sum [^borrow v : F64Vec]
  #fx{}
  #reads v
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  const double *d = a->data;
  double s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    s[0] = s[0] + d[i];
    s[1] = s[1] + d[i + 1];
    s[2] = s[2] + d[i + 2];
    s[3] = s[3] + d[i + 3];
    s[4] = s[4] + d[i + 4];
    s[5] = s[5] + d[i + 5];
    s[6] = s[6] + d[i + 6];
    s[7] = s[7] + d[i + 7];
  }
  for (; i < n; i++) s[i & 7] = s[i & 7] + d[i];
  return ((s[0] + s[1]) + (s[2] + s[3])) + ((s[4] + s[5]) + (s[6] + s[7]));
  ```)
;;; f64vec-sum-ordered -- the strict left-to-right sum of the elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)] (f64vec-sum-ordered v))
;;;
;;; Since: Phase N1

(defn f64vec-sum-ordered [^borrow v : F64Vec]
  #fx{}
  #reads v
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  const double *d = a->data;
  double s = 0;
  for (int64_t i = 0; i < n; i++) s = s + d[i];
  return s;
  ```)
;;; f64vec-dot -- the dot product of two arrays (same length, or a panic).
;;;
;;; Floats use the same eight-lane order as `-sum`.  Integers wrap modulo
;;; 2^64; an `int32` product is formed in 64 bits.
;;;
;;; Parameters:
;;;   a -- the first array (borrowed)
;;;   b -- the second array (borrowed)
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (let [a (f64vec-of 1.5 2.5) b (f64vec-of 2.5 1.5)] (f64vec-dot a b))
;;;
;;; Since: Phase N1

(defn f64vec-dot [^borrow a : F64Vec ^borrow b : F64Vec]
  #fx{}
  #reads [a b]
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *y = (void*)(intptr_t)a;
  struct { int64_t len; double *data; void *raw; } *x = (void*)(intptr_t)b;
  if (y->len != x->len) {
      tur_panic("f64vec-dot: length mismatch");
      return 0;
    }
  int64_t n = y->len;
  const double *yd = y->data;
  const double *xd = x->data;
  double s0 = 0, s1 = 0, s2 = 0, s3 = 0, s4 = 0, s5 = 0, s6 = 0, s7 = 0;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    { double m = yd[i] * xd[i]; s0 = s0 + m; }
    { double m = yd[i + 1] * xd[i + 1]; s1 = s1 + m; }
    { double m = yd[i + 2] * xd[i + 2]; s2 = s2 + m; }
    { double m = yd[i + 3] * xd[i + 3]; s3 = s3 + m; }
    { double m = yd[i + 4] * xd[i + 4]; s4 = s4 + m; }
    { double m = yd[i + 5] * xd[i + 5]; s5 = s5 + m; }
    { double m = yd[i + 6] * xd[i + 6]; s6 = s6 + m; }
    { double m = yd[i + 7] * xd[i + 7]; s7 = s7 + m; }
  }
  if (i < n) { double m = yd[i] * xd[i]; s0 = s0 + m; }
  if (i + 1 < n) { double m = yd[i + 1] * xd[i + 1]; s1 = s1 + m; }
  if (i + 2 < n) { double m = yd[i + 2] * xd[i + 2]; s2 = s2 + m; }
  if (i + 3 < n) { double m = yd[i + 3] * xd[i + 3]; s3 = s3 + m; }
  if (i + 4 < n) { double m = yd[i + 4] * xd[i + 4]; s4 = s4 + m; }
  if (i + 5 < n) { double m = yd[i + 5] * xd[i + 5]; s5 = s5 + m; }
  if (i + 6 < n) { double m = yd[i + 6] * xd[i + 6]; s6 = s6 + m; }
  return ((s0 + s1) + (s2 + s3)) + ((s4 + s5) + (s6 + s7));
  ```)
;;; f64vec-min -- the smallest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)] (f64vec-min v))   ; => 1.5
;;;
;;; Since: Phase N1

(defn f64vec-min [^borrow v : F64Vec]
  #fx{}
  #reads v
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("f64vec-min: empty array");
      return 0;
    }
  const double *d = a->data;
  double m0 = d[0], m1 = d[0], m2 = d[0], m3 = d[0], m4 = d[0], m5 = d[0], m6 = d[0], m7 = d[0];
  double z0 = 0, z1 = 0;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    double x0 = d[i], x1 = d[i + 1], x2 = d[i + 2], x3 = d[i + 3], x4 = d[i + 4], x5 = d[i + 5], x6 = d[i + 6], x7 = d[i + 7];
    m0 = x0 < m0 ? x0 : m0;
    m1 = x1 < m1 ? x1 : m1;
    m2 = x2 < m2 ? x2 : m2;
    m3 = x3 < m3 ? x3 : m3;
    m4 = x4 < m4 ? x4 : m4;
    m5 = x5 < m5 ? x5 : m5;
    m6 = x6 < m6 ? x6 : m6;
    m7 = x7 < m7 ? x7 : m7;
    double p0 = (x0 + x2) + (x4 + x6);
    double p1 = (x1 + x3) + (x5 + x7);
    z0 = z0 + p0;
    z1 = z1 + p1;
  }
  double m[8] = {m0, m1, m2, m3, m4, m5, m6, m7};
  double z = z0 + z1;
  for (; i < n; i++) {
    double x = d[i];
    m[i & 7] = x < m[i & 7] ? x : m[i & 7];
    z = z + x;
  }
  if (z != z) {
    for (int64_t j = 0; j < n; j++) if (d[j] != d[j]) return d[j];
  }
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] < m[k] ? m[k + w] : m[k];
  return m[0];
  ```)
;;; f64vec-max -- the largest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)] (f64vec-max v))   ; => 2.5
;;;
;;; Since: Phase N1

(defn f64vec-max [^borrow v : F64Vec]
  #fx{}
  #reads v
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("f64vec-max: empty array");
      return 0;
    }
  const double *d = a->data;
  double m0 = d[0], m1 = d[0], m2 = d[0], m3 = d[0], m4 = d[0], m5 = d[0], m6 = d[0], m7 = d[0];
  double z0 = 0, z1 = 0;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    double x0 = d[i], x1 = d[i + 1], x2 = d[i + 2], x3 = d[i + 3], x4 = d[i + 4], x5 = d[i + 5], x6 = d[i + 6], x7 = d[i + 7];
    m0 = x0 > m0 ? x0 : m0;
    m1 = x1 > m1 ? x1 : m1;
    m2 = x2 > m2 ? x2 : m2;
    m3 = x3 > m3 ? x3 : m3;
    m4 = x4 > m4 ? x4 : m4;
    m5 = x5 > m5 ? x5 : m5;
    m6 = x6 > m6 ? x6 : m6;
    m7 = x7 > m7 ? x7 : m7;
    double p0 = (x0 + x2) + (x4 + x6);
    double p1 = (x1 + x3) + (x5 + x7);
    z0 = z0 + p0;
    z1 = z1 + p1;
  }
  double m[8] = {m0, m1, m2, m3, m4, m5, m6, m7};
  double z = z0 + z1;
  for (; i < n; i++) {
    double x = d[i];
    m[i & 7] = x > m[i & 7] ? x : m[i & 7];
    z = z + x;
  }
  if (z != z) {
    for (int64_t j = 0; j < n; j++) if (d[j] != d[j]) return d[j];
  }
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] > m[k] ? m[k + w] : m[k];
  return m[0];
  ```)
;;; f64vec-ref-unchecked -- the element at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  The loop macros
;;; (`-for`, `-fold`, ...) use it where they have already checked the index.
;;; Its body calls nothing, so a call to it carries no panic check, and a
;;; loop of such calls can vectorize.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (unsafe (f64vec-ref-unchecked v 0))
;;;
;;; Since: Phase N2

(defn f64vec-ref-unchecked [^borrow v : F64Vec i : int]
  #fx{Unsafe}
  #reads v
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->data[i];
  ```)
;;; f64vec-set-unchecked! -- store x at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  Stores a number: no
;;; TUR_REGION_NOTE (see the module header).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;   x -- the new element
;;;
;;; Example:
;;;   (unsafe (f64vec-set-unchecked! v 0 1.5))
;;;
;;; Since: Phase N2

(defn f64vec-set-unchecked! [^borrow v : F64Vec i : int x : float]
  #fx{Unsafe}
  #writes v
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  a->data[i] = x;
  ```)
;;; f64vec-for -- run body once per element of one or two F64Vecs.
;;;
;;; `(for [x v] body...)` binds x to each element of v in order;
;;; `(for [x v y w] body...)` walks v and w together (same length, or a panic
;;; before the first pass).  No index is in scope, so none can be wrong: the
;;; reads are `f64vec-ref-unchecked`, the body sees plain elements, and the loop
;;; carries no bounds check or panic test -- gcc can vectorize it at -O3.  An
;;; array argument that is not a name is evaluated once, and freed after.
;;;
;;; Parameters:
;;;   bindings -- `[x v]` or `[x v y w]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)] (f64vec-for [x v] (println x)))
;;;
;;; Since: Phase N2

(defmacro f64vec-for [bv & body]
  (let [i    (gensym "i")
        n    (gensym "n")
        x    (first bv)
        v    (second bv)
        more (rest (rest bv))]
    (if (list? v)
      (let [t (gensym "nv")] `(let [~t ~v] (f64vec-for [~x ~t ~@more] ~@body)))
      (if (empty? more)
        `(let [^mut ~i 0
               ~n      (f64vec-len ~v)]
           (while (< ~i ~n)
             (let [~x (unsafe (f64vec-ref-unchecked ~v ~i))] ~@body)
             (set! ~i (+ ~i 1))))
        (let [y (first more)
              w (second more)]
          (if (list? w)
            (let [t (gensym "nv")]
              `(let [~t ~w] (f64vec-for [~x ~v ~y ~t] ~@body)))
            `(let [^mut ~i 0
                   ~n      (f64vec-same-len__ ~v ~w)]
               (while (< ~i ~n)
                 (let [~x (unsafe (f64vec-ref-unchecked ~v ~i))
                       ~y (unsafe (f64vec-ref-unchecked ~w ~i))]
                   ~@body)
                 (set! ~i (+ ~i 1))))))))))
;;; f64vec-for-index -- run body once per element, with its index.
;;;
;;; `(for-index [i x v] body...)` binds i (read-only) and x = v[i].
;;;
;;; Parameters:
;;;   bindings -- `[i x v]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)] (f64vec-for-index [i x v] (println i)))
;;;
;;; Since: Phase N2

(defmacro f64vec-for-index [bv & body]
  (let [i  (gensym "i")
        n  (gensym "n")
        iv (first bv)
        x  (second bv)
        v  (first (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (f64vec-for-index [~iv ~x ~t] ~@body)))
      `(let [^mut ~i 0
             ~n      (f64vec-len ~v)]
         (while (< ~i ~n)
           (let [~iv ~i
                 ~x  (unsafe (f64vec-ref-unchecked ~v ~i))]
             ~@body)
           (set! ~i (+ ~i 1)))))))
;;; f64vec-fold -- fold the elements of a F64Vec into an accumulator.
;;;
;;; `(fold [acc init x v] body)`: acc starts at init, and for each element x
;;; in order becomes the value of body (which sees acc and x).  The result is
;;; the final acc.  A float sum written this way is the strict left fold, so
;;; gcc keeps it scalar; `f64vec-sum` is the vectorized one.
;;;
;;; Parameters:
;;;   bindings -- `[acc init x v]`
;;;   body     -- the new accumulator
;;;
;;; Returns:
;;;   The final accumulator.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)] (f64vec-fold [n 0 x v] (+ n 1)))   ; => 2
;;;
;;; Since: Phase N2

(defmacro f64vec-fold [bv body]
  (let [i    (gensym "i")
        n    (gensym "n")
        acc  (first bv)
        init (second bv)
        x    (first (rest (rest bv)))
        v    (second (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (f64vec-fold [~acc ~init ~x ~t] ~body)))
      `(let [^mut ~i   0
             ~n        (f64vec-len ~v)
             ^mut ~acc ~init]
         (while (< ~i ~n)
           (let [~x (unsafe (f64vec-ref-unchecked ~v ~i))] (set! ~acc ~body))
           (set! ~i (+ ~i 1)))
         ~acc))))
;;; f64vec-build -- a fresh F64Vec of n elements, element i the value of expr.
;;;
;;; `(build n [i] expr)`, after Racket's `for/flvector`: i is bound to each
;;; index in turn, and expr runs outside any `unsafe`.
;;;
;;; Parameters:
;;;   n    -- the length (evaluated once)
;;;   i    -- the index name, in a vector
;;;   expr -- the element at i, of type float
;;;
;;; Returns:
;;;   A fresh F64Vec, owned by the caller.
;;;
;;; Example:
;;;   (let [v (f64vec-build 3 [i] 1.5)] (f64vec-len v))   ; => 3
;;;
;;; Since: Phase N2

(defmacro f64vec-build [n bv expr]
  (let [i   (gensym "i")
        m   (gensym "n")
        e   (gensym "e")
        out (gensym "out")
        iv  (first bv)]
    `(let [~m      ~n
           ~out    (f64vec-new ~m 0.0)
           ^mut ~i 0]
       (while (< ~i ~m)
         (let [~iv ~i
               ~e  ~expr]
           (unsafe (f64vec-set-unchecked! ~out ~i ~e)))
         (set! ~i (+ ~i 1)))
       ~out)))
;;; f64vec-same-len__ -- internal: the common length of two arrays, or a panic.

(defn f64vec-same-len__ [^borrow a : F64Vec ^borrow b : F64Vec]
  #fx{}
  #reads [a b]
  : int
  ```c
  struct { int64_t len; double *data; void *raw; } *x = (void*)(intptr_t)a;
  struct { int64_t len; double *data; void *raw; } *y = (void*)(intptr_t)b;
  if (x->len != y->len) {
    tur_panic("f64vec-for: length mismatch");
    return 0;
  }
  return x->len;
  ```)
;; ===== F32Vec: 32-bit floats =====
;;; F32Vec -- a fixed-length, unboxed array of 32-bit floats (float32).
;;;
;;; Opaque handle to a `struct { int64_t len; float *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `f32vec-new` or
;;; `f32vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine F32Vec :int)
;; Every operation that touches the header is an inline-C body of its own,
;; never a Turmeric wrapper over a raw one, so a panic is reported at the
;; CALLER's line (as vec-get's is) and turi's natives are keyed by the public
;; names.  An element store writes a number, never a pointer, so the setter
;; carries no TUR_REGION_NOTE (CLAUDE.md, "Region Store Hooks").
;;; f32vec-new -- allocate a F32Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh F32Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (f32vec-new 4 (:: 3.25 float32))]
;;;     (f32vec-ref v 2))   ; => (:: 3.25 float32)
;;;
;;; Since: Phase N0

(defn f32vec-new [n : int init : float32]
  #fx{}
  : F32Vec
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(float)) {
    tur_panic("f32vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; float *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "f32vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(float) + 32);
  if (!b->raw) { fprintf(stderr, "f32vec-new: out of memory\n"); abort(); }
  b->data = (float *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = init;
  return (int64_t)(intptr_t)b;
  ```)
;;; f32vec-of -- a F32Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type float32
;;;
;;; Returns:
;;;   A fresh F32Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))]
;;;     (f32vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro f32vec-of [& xs]
  (let [v (gensym "nv")]
    (list numvec-of__ f32vec-new f32vec-set! (list as float32 0.0) v ~@xs)))
;;; f32vec-free -- release a F32Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound F32Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (f32vec-free v)
;;;
;;; Since: Phase N0

(defn f32vec-free [v : F32Vec]
  #fx{}
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  if (a) { free(a->raw); free(a); }
  ```)
;;; Drop [F32Vec] -- free the array when a bound F32Vec dies unmoved.

(definstance Drop [F32Vec] (drop [x] : void (f32vec-free x)))
;;; f32vec-len -- the element count of a F32Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (f32vec-new 8 (:: 3.25 float32))]
;;;     (f32vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn f32vec-len [^borrow v : F32Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; f32vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed float32.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))]
;;;     (f32vec-ref v 1))   ; => (:: 2.5 float32)
;;;
;;; Since: Phase N0

(defn f32vec-ref [^borrow v : F32Vec i : int]
  #fx{}
  #reads v
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("f32vec-ref: index out of bounds");
  return 0;
  ```)
;;; f32vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (f32vec-set! v 0 (:: 3.25 float32))
;;;
;;; Since: Phase N0

(defn f32vec-set! [^borrow v : F32Vec i : int x : float32]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) { a->data[i] = x; return; }
  tur_panic("f32vec-set!: index out of bounds");
  ```)
;;; f32vec-copy -- a fresh F32Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (f32vec-copy v)] (f32vec-set! c 0 (:: 3.25 float32)))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn f32vec-copy [^borrow v : F32Vec]
  #fx{}
  : F32Vec
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  struct { int64_t len; float *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "f32vec-copy: out of memory\n"); abort(); }
  c->len = a->len;
  c->raw = malloc((size_t)a->len * sizeof(float) + 32);
  if (!c->raw) { fprintf(stderr, "f32vec-copy: out of memory\n"); abort(); }
  c->data = (float *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (a->len > 0) memcpy(c->data, a->data, (size_t)a->len * sizeof(float));
  return (int64_t)(intptr_t)c;
  ```)
;;; f32vec->vec-go__ -- internal: push v[i..n) onto out.

(defn f32vec->vec-go__ [^borrow v : F32Vec out : (Vec float32) i : int n : int] : (Vec float32)
  (if (>= i n)
    out
    (do (vec-push! out (f32vec-ref v i)) (f32vec->vec-go__ v out (+ i 1) n))))
;;; f32vec->vec -- copy a F32Vec into a fresh (Vec float32).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (f32vec-of (:: 1.5 float32) (:: 2.5 float32))
;;;         v (f32vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn f32vec->vec [^borrow v : F32Vec] : (Vec float32)
  (f32vec->vec-go__ v (:: (vec-new) (Vec float32)) 0 (f32vec-len v)))
;;; vec->f32vec-go__ -- internal: store src[i..n) into out.

(defn vec->f32vec-go__ [^borrow out : F32Vec
                        ^borrow src : (Vec float32)
                        i : int
                        n : int] : nil
  (if (>= i n)
    nil
    (do
      (f32vec-set! out i (:: (vec-get src i) float32))
      (vec->f32vec-go__ out src (+ i 1) n))))
;;; vec->f32vec -- copy a (Vec float32) into a fresh F32Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A F32Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of (:: 1.5 float32) (:: 2.5 float32))
;;;         a (vec->f32vec v)]
;;;     (f32vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->f32vec [^borrow src : (Vec float32)] : F32Vec
  (let [out (f32vec-new (vec-len src) (as float32 0.0))]
    (vec->f32vec-go__ out src 0 (vec-len src))
    out))
;;; f32vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn f32vec-show-loop__ [^borrow v : F32Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (f32vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (f32vec-show-loop__ v (+ i 1) n b))))
;;; f32vec-show -- render a F32Vec as an owned "#f32vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))]
;;;     (f32vec-show v))   ; => String "#f32vec[1.5 2.5]"
;;;
;;; Since: Phase N0

(defn f32vec-show [^borrow v : F32Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#f32vec[")
      (f32vec-show-loop__ v 0 (f32vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; --- N1 bulk kernels, N2 unchecked access and loops (tools/gen-numvec.py) ---
;;; f32vec-fill! -- store x in every slot.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   x -- the value
;;;
;;; Example:
;;;   (f32vec-fill! v (:: 1.5 float32))
;;;
;;; Since: Phase N1

(defn f32vec-fill! [^borrow v : F32Vec x : float32]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  float *d = a->data;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = x;
    d[i + 1] = x;
    d[i + 2] = x;
    d[i + 3] = x;
    d[i + 4] = x;
    d[i + 5] = x;
    d[i + 6] = x;
    d[i + 7] = x;
  }
  for (; i < n; i++) d[i] = x;
  ```)
;;; f32vec-copy! -- copy src's elements into dst (same length, or a panic).
;;;
;;; Parameters:
;;;   dst -- the array written (borrowed)
;;;   src -- the array read (borrowed)
;;;
;;; Example:
;;;   (f32vec-copy! dst src)
;;;
;;; Since: Phase N1

(defn f32vec-copy! [^borrow dst : F32Vec ^borrow src : F32Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; float *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("f32vec-copy!: length mismatch");
      return;
    }
  if (y->len > 0) memmove(y->data, x->data, (size_t)y->len * sizeof(float));
  ```)
;;; f32vec-scale! -- multiply every element by s, in place.
;;;
;;; Integer arithmetic wraps.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   s -- the factor
;;;
;;; Example:
;;;   (f32vec-scale! v (:: 2.5 float32))
;;;
;;; Since: Phase N1

(defn f32vec-scale! [^borrow v : F32Vec s : float32]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  float *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) d[i] = d[i] * s;
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = d[i] * s;
    d[i + 1] = d[i + 1] * s;
    d[i + 2] = d[i + 2] * s;
    d[i + 3] = d[i + 3] * s;
    d[i + 4] = d[i + 4] * s;
    d[i + 5] = d[i + 5] * s;
    d[i + 6] = d[i + 6] * s;
    d[i + 7] = d[i + 7] * s;
  }
  for (; i < n; i++) d[i] = d[i] * s;
  #endif
  ```)
;;; f32vec-add! -- dst[i] += src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; dst and src may be the same array.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   src -- the array added (borrowed)
;;;
;;; Example:
;;;   (f32vec-add! y x)
;;;
;;; Since: Phase N1

(defn f32vec-add! [^borrow dst : F32Vec ^borrow src : F32Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; float *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("f32vec-add!: length mismatch");
      return;
    }
  int64_t n = y->len;
  float *yd = y->data;
  const float *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) yd[i] = yd[i] + xd[i];
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    float y0 = yd[i], x0 = xd[i];
    float y1 = yd[i + 1], x1 = xd[i + 1];
    float y2 = yd[i + 2], x2 = xd[i + 2];
    float y3 = yd[i + 3], x3 = xd[i + 3];
    float y4 = yd[i + 4], x4 = xd[i + 4];
    float y5 = yd[i + 5], x5 = xd[i + 5];
    float y6 = yd[i + 6], x6 = xd[i + 6];
    float y7 = yd[i + 7], x7 = xd[i + 7];
    yd[i] = y0 + x0;
    yd[i + 1] = y1 + x1;
    yd[i + 2] = y2 + x2;
    yd[i + 3] = y3 + x3;
    yd[i + 4] = y4 + x4;
    yd[i + 5] = y5 + x5;
    yd[i + 6] = y6 + x6;
    yd[i + 7] = y7 + x7;
  }
  for (; i < n; i++) yd[i] = yd[i] + xd[i];
  #endif
  ```)
;;; f32vec-axpy! -- dst[i] += s * src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; the multiply and the add are not fused.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   s -- the factor
;;;   src -- the array scaled and added (borrowed)
;;;
;;; Example:
;;;   (f32vec-axpy! y (:: 2.5 float32) x)
;;;
;;; Since: Phase N1

(defn f32vec-axpy! [^borrow dst : F32Vec s : float32 ^borrow src : F32Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; float *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("f32vec-axpy!: length mismatch");
      return;
    }
  int64_t n = y->len;
  float *yd = y->data;
  const float *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) { float m = s * xd[i]; yd[i] = yd[i] + m; }
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    float y0 = yd[i], x0 = xd[i];
    float y1 = yd[i + 1], x1 = xd[i + 1];
    float y2 = yd[i + 2], x2 = xd[i + 2];
    float y3 = yd[i + 3], x3 = xd[i + 3];
    float y4 = yd[i + 4], x4 = xd[i + 4];
    float y5 = yd[i + 5], x5 = xd[i + 5];
    float y6 = yd[i + 6], x6 = xd[i + 6];
    float y7 = yd[i + 7], x7 = xd[i + 7];
    float m0 = s * x0;
    float m1 = s * x1;
    float m2 = s * x2;
    float m3 = s * x3;
    float m4 = s * x4;
    float m5 = s * x5;
    float m6 = s * x6;
    float m7 = s * x7;
    yd[i] = y0 + m0;
    yd[i + 1] = y1 + m1;
    yd[i + 2] = y2 + m2;
    yd[i + 3] = y3 + m3;
    yd[i + 4] = y4 + m4;
    yd[i + 5] = y5 + m5;
    yd[i + 6] = y6 + m6;
    yd[i + 7] = y7 + m7;
  }
  for (; i < n; i++) { float m = s * xd[i]; yd[i] = yd[i] + m; }
  #endif
  ```)
;;; f32vec-sum -- the sum of the elements.
;;;
;;; A float sum is computed in eight interleaved partial sums (lane k
;;; takes the elements i with i mod 8 = k), combined in one fixed tree:
;;; the same answer on every engine and machine, and vectorizable without
;;; -ffast-math.  It can differ in the last bits from `-sum-ordered`, the
;;; left-to-right sum.  An integer sum wraps modulo 2^64; a narrow element
;;; is widened to `int` first.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))] (f32vec-sum v))
;;;
;;; Since: Phase N1

(defn f32vec-sum [^borrow v : F32Vec]
  #fx{}
  #reads v
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  const float *d = a->data;
  float s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    s[0] = s[0] + d[i];
    s[1] = s[1] + d[i + 1];
    s[2] = s[2] + d[i + 2];
    s[3] = s[3] + d[i + 3];
    s[4] = s[4] + d[i + 4];
    s[5] = s[5] + d[i + 5];
    s[6] = s[6] + d[i + 6];
    s[7] = s[7] + d[i + 7];
  }
  for (; i < n; i++) s[i & 7] = s[i & 7] + d[i];
  return ((s[0] + s[1]) + (s[2] + s[3])) + ((s[4] + s[5]) + (s[6] + s[7]));
  ```)
;;; f32vec-sum-ordered -- the strict left-to-right sum of the elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))] (f32vec-sum-ordered v))
;;;
;;; Since: Phase N1

(defn f32vec-sum-ordered [^borrow v : F32Vec]
  #fx{}
  #reads v
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  const float *d = a->data;
  float s = 0;
  for (int64_t i = 0; i < n; i++) s = s + d[i];
  return s;
  ```)
;;; f32vec-dot -- the dot product of two arrays (same length, or a panic).
;;;
;;; Floats use the same eight-lane order as `-sum`.  Integers wrap modulo
;;; 2^64; an `int32` product is formed in 64 bits.
;;;
;;; Parameters:
;;;   a -- the first array (borrowed)
;;;   b -- the second array (borrowed)
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (let [a (f32vec-of (:: 1.5 float32) (:: 2.5 float32)) b (f32vec-of (:: 2.5 float32) (:: 1.5 float32))] (f32vec-dot a b))
;;;
;;; Since: Phase N1

(defn f32vec-dot [^borrow a : F32Vec ^borrow b : F32Vec]
  #fx{}
  #reads [a b]
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *y = (void*)(intptr_t)a;
  struct { int64_t len; float *data; void *raw; } *x = (void*)(intptr_t)b;
  if (y->len != x->len) {
      tur_panic("f32vec-dot: length mismatch");
      return 0;
    }
  int64_t n = y->len;
  const float *yd = y->data;
  const float *xd = x->data;
  float s0 = 0, s1 = 0, s2 = 0, s3 = 0, s4 = 0, s5 = 0, s6 = 0, s7 = 0;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    { float m = yd[i] * xd[i]; s0 = s0 + m; }
    { float m = yd[i + 1] * xd[i + 1]; s1 = s1 + m; }
    { float m = yd[i + 2] * xd[i + 2]; s2 = s2 + m; }
    { float m = yd[i + 3] * xd[i + 3]; s3 = s3 + m; }
    { float m = yd[i + 4] * xd[i + 4]; s4 = s4 + m; }
    { float m = yd[i + 5] * xd[i + 5]; s5 = s5 + m; }
    { float m = yd[i + 6] * xd[i + 6]; s6 = s6 + m; }
    { float m = yd[i + 7] * xd[i + 7]; s7 = s7 + m; }
  }
  if (i < n) { float m = yd[i] * xd[i]; s0 = s0 + m; }
  if (i + 1 < n) { float m = yd[i + 1] * xd[i + 1]; s1 = s1 + m; }
  if (i + 2 < n) { float m = yd[i + 2] * xd[i + 2]; s2 = s2 + m; }
  if (i + 3 < n) { float m = yd[i + 3] * xd[i + 3]; s3 = s3 + m; }
  if (i + 4 < n) { float m = yd[i + 4] * xd[i + 4]; s4 = s4 + m; }
  if (i + 5 < n) { float m = yd[i + 5] * xd[i + 5]; s5 = s5 + m; }
  if (i + 6 < n) { float m = yd[i + 6] * xd[i + 6]; s6 = s6 + m; }
  return ((s0 + s1) + (s2 + s3)) + ((s4 + s5) + (s6 + s7));
  ```)
;;; f32vec-min -- the smallest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))] (f32vec-min v))   ; => (:: 1.5 float32)
;;;
;;; Since: Phase N1

(defn f32vec-min [^borrow v : F32Vec]
  #fx{}
  #reads v
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("f32vec-min: empty array");
      return 0;
    }
  const float *d = a->data;
  float m0 = d[0], m1 = d[0], m2 = d[0], m3 = d[0], m4 = d[0], m5 = d[0], m6 = d[0], m7 = d[0];
  float z0 = 0, z1 = 0;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    float x0 = d[i], x1 = d[i + 1], x2 = d[i + 2], x3 = d[i + 3], x4 = d[i + 4], x5 = d[i + 5], x6 = d[i + 6], x7 = d[i + 7];
    m0 = x0 < m0 ? x0 : m0;
    m1 = x1 < m1 ? x1 : m1;
    m2 = x2 < m2 ? x2 : m2;
    m3 = x3 < m3 ? x3 : m3;
    m4 = x4 < m4 ? x4 : m4;
    m5 = x5 < m5 ? x5 : m5;
    m6 = x6 < m6 ? x6 : m6;
    m7 = x7 < m7 ? x7 : m7;
    float p0 = (x0 + x2) + (x4 + x6);
    float p1 = (x1 + x3) + (x5 + x7);
    z0 = z0 + p0;
    z1 = z1 + p1;
  }
  float m[8] = {m0, m1, m2, m3, m4, m5, m6, m7};
  float z = z0 + z1;
  for (; i < n; i++) {
    float x = d[i];
    m[i & 7] = x < m[i & 7] ? x : m[i & 7];
    z = z + x;
  }
  if (z != z) {
    for (int64_t j = 0; j < n; j++) if (d[j] != d[j]) return d[j];
  }
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] < m[k] ? m[k + w] : m[k];
  return m[0];
  ```)
;;; f32vec-max -- the largest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))] (f32vec-max v))   ; => (:: 2.5 float32)
;;;
;;; Since: Phase N1

(defn f32vec-max [^borrow v : F32Vec]
  #fx{}
  #reads v
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("f32vec-max: empty array");
      return 0;
    }
  const float *d = a->data;
  float m0 = d[0], m1 = d[0], m2 = d[0], m3 = d[0], m4 = d[0], m5 = d[0], m6 = d[0], m7 = d[0];
  float z0 = 0, z1 = 0;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    float x0 = d[i], x1 = d[i + 1], x2 = d[i + 2], x3 = d[i + 3], x4 = d[i + 4], x5 = d[i + 5], x6 = d[i + 6], x7 = d[i + 7];
    m0 = x0 > m0 ? x0 : m0;
    m1 = x1 > m1 ? x1 : m1;
    m2 = x2 > m2 ? x2 : m2;
    m3 = x3 > m3 ? x3 : m3;
    m4 = x4 > m4 ? x4 : m4;
    m5 = x5 > m5 ? x5 : m5;
    m6 = x6 > m6 ? x6 : m6;
    m7 = x7 > m7 ? x7 : m7;
    float p0 = (x0 + x2) + (x4 + x6);
    float p1 = (x1 + x3) + (x5 + x7);
    z0 = z0 + p0;
    z1 = z1 + p1;
  }
  float m[8] = {m0, m1, m2, m3, m4, m5, m6, m7};
  float z = z0 + z1;
  for (; i < n; i++) {
    float x = d[i];
    m[i & 7] = x > m[i & 7] ? x : m[i & 7];
    z = z + x;
  }
  if (z != z) {
    for (int64_t j = 0; j < n; j++) if (d[j] != d[j]) return d[j];
  }
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] > m[k] ? m[k + w] : m[k];
  return m[0];
  ```)
;;; f32vec-ref-unchecked -- the element at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  The loop macros
;;; (`-for`, `-fold`, ...) use it where they have already checked the index.
;;; Its body calls nothing, so a call to it carries no panic check, and a
;;; loop of such calls can vectorize.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (unsafe (f32vec-ref-unchecked v 0))
;;;
;;; Since: Phase N2

(defn f32vec-ref-unchecked [^borrow v : F32Vec i : int]
  #fx{Unsafe}
  #reads v
  : float32
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->data[i];
  ```)
;;; f32vec-set-unchecked! -- store x at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  Stores a number: no
;;; TUR_REGION_NOTE (see the module header).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;   x -- the new element
;;;
;;; Example:
;;;   (unsafe (f32vec-set-unchecked! v 0 (:: 1.5 float32)))
;;;
;;; Since: Phase N2

(defn f32vec-set-unchecked! [^borrow v : F32Vec i : int x : float32]
  #fx{Unsafe}
  #writes v
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *a = (void*)(intptr_t)v;
  a->data[i] = x;
  ```)
;;; f32vec-for -- run body once per element of one or two F32Vecs.
;;;
;;; `(for [x v] body...)` binds x to each element of v in order;
;;; `(for [x v y w] body...)` walks v and w together (same length, or a panic
;;; before the first pass).  No index is in scope, so none can be wrong: the
;;; reads are `f32vec-ref-unchecked`, the body sees plain elements, and the loop
;;; carries no bounds check or panic test -- gcc can vectorize it at -O3.  An
;;; array argument that is not a name is evaluated once, and freed after.
;;;
;;; Parameters:
;;;   bindings -- `[x v]` or `[x v y w]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))] (f32vec-for [x v] (println x)))
;;;
;;; Since: Phase N2

(defmacro f32vec-for [bv & body]
  (let [i    (gensym "i")
        n    (gensym "n")
        x    (first bv)
        v    (second bv)
        more (rest (rest bv))]
    (if (list? v)
      (let [t (gensym "nv")] `(let [~t ~v] (f32vec-for [~x ~t ~@more] ~@body)))
      (if (empty? more)
        `(let [^mut ~i 0
               ~n      (f32vec-len ~v)]
           (while (< ~i ~n)
             (let [~x (unsafe (f32vec-ref-unchecked ~v ~i))] ~@body)
             (set! ~i (+ ~i 1))))
        (let [y (first more)
              w (second more)]
          (if (list? w)
            (let [t (gensym "nv")]
              `(let [~t ~w] (f32vec-for [~x ~v ~y ~t] ~@body)))
            `(let [^mut ~i 0
                   ~n      (f32vec-same-len__ ~v ~w)]
               (while (< ~i ~n)
                 (let [~x (unsafe (f32vec-ref-unchecked ~v ~i))
                       ~y (unsafe (f32vec-ref-unchecked ~w ~i))]
                   ~@body)
                 (set! ~i (+ ~i 1))))))))))
;;; f32vec-for-index -- run body once per element, with its index.
;;;
;;; `(for-index [i x v] body...)` binds i (read-only) and x = v[i].
;;;
;;; Parameters:
;;;   bindings -- `[i x v]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))] (f32vec-for-index [i x v] (println i)))
;;;
;;; Since: Phase N2

(defmacro f32vec-for-index [bv & body]
  (let [i  (gensym "i")
        n  (gensym "n")
        iv (first bv)
        x  (second bv)
        v  (first (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (f32vec-for-index [~iv ~x ~t] ~@body)))
      `(let [^mut ~i 0
             ~n      (f32vec-len ~v)]
         (while (< ~i ~n)
           (let [~iv ~i
                 ~x  (unsafe (f32vec-ref-unchecked ~v ~i))]
             ~@body)
           (set! ~i (+ ~i 1)))))))
;;; f32vec-fold -- fold the elements of a F32Vec into an accumulator.
;;;
;;; `(fold [acc init x v] body)`: acc starts at init, and for each element x
;;; in order becomes the value of body (which sees acc and x).  The result is
;;; the final acc.  A float sum written this way is the strict left fold, so
;;; gcc keeps it scalar; `f32vec-sum` is the vectorized one.
;;;
;;; Parameters:
;;;   bindings -- `[acc init x v]`
;;;   body     -- the new accumulator
;;;
;;; Returns:
;;;   The final accumulator.
;;;
;;; Example:
;;;   (let [v (f32vec-of (:: 1.5 float32) (:: 2.5 float32))] (f32vec-fold [n 0 x v] (+ n 1)))   ; => 2
;;;
;;; Since: Phase N2

(defmacro f32vec-fold [bv body]
  (let [i    (gensym "i")
        n    (gensym "n")
        acc  (first bv)
        init (second bv)
        x    (first (rest (rest bv)))
        v    (second (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (f32vec-fold [~acc ~init ~x ~t] ~body)))
      `(let [^mut ~i   0
             ~n        (f32vec-len ~v)
             ^mut ~acc ~init]
         (while (< ~i ~n)
           (let [~x (unsafe (f32vec-ref-unchecked ~v ~i))] (set! ~acc ~body))
           (set! ~i (+ ~i 1)))
         ~acc))))
;;; f32vec-build -- a fresh F32Vec of n elements, element i the value of expr.
;;;
;;; `(build n [i] expr)`, after Racket's `for/flvector`: i is bound to each
;;; index in turn, and expr runs outside any `unsafe`.
;;;
;;; Parameters:
;;;   n    -- the length (evaluated once)
;;;   i    -- the index name, in a vector
;;;   expr -- the element at i, of type float32
;;;
;;; Returns:
;;;   A fresh F32Vec, owned by the caller.
;;;
;;; Example:
;;;   (let [v (f32vec-build 3 [i] (:: 1.5 float32))] (f32vec-len v))   ; => 3
;;;
;;; Since: Phase N2

(defmacro f32vec-build [n bv expr]
  (let [i   (gensym "i")
        m   (gensym "n")
        e   (gensym "e")
        out (gensym "out")
        iv  (first bv)]
    `(let [~m      ~n
           ~out    (f32vec-new ~m (as float32 0.0))
           ^mut ~i 0]
       (while (< ~i ~m)
         (let [~iv ~i
               ~e  ~expr]
           (unsafe (f32vec-set-unchecked! ~out ~i ~e)))
         (set! ~i (+ ~i 1)))
       ~out)))
;;; f32vec-same-len__ -- internal: the common length of two arrays, or a panic.

(defn f32vec-same-len__ [^borrow a : F32Vec ^borrow b : F32Vec]
  #fx{}
  #reads [a b]
  : int
  ```c
  struct { int64_t len; float *data; void *raw; } *x = (void*)(intptr_t)a;
  struct { int64_t len; float *data; void *raw; } *y = (void*)(intptr_t)b;
  if (x->len != y->len) {
    tur_panic("f32vec-for: length mismatch");
    return 0;
  }
  return x->len;
  ```)
;; ===== I64Vec: 64-bit integers =====
;;; I64Vec -- a fixed-length, unboxed array of 64-bit integers (int).
;;;
;;; Opaque handle to a `struct { int64_t len; int64_t *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `i64vec-new` or
;;; `i64vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine I64Vec :int)
;; Every operation that touches the header is an inline-C body of its own,
;; never a Turmeric wrapper over a raw one, so a panic is reported at the
;; CALLER's line (as vec-get's is) and turi's natives are keyed by the public
;; names.  An element store writes a number, never a pointer, so the setter
;; carries no TUR_REGION_NOTE (CLAUDE.md, "Region Store Hooks").
;;; i64vec-new -- allocate a I64Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh I64Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (i64vec-new 4 7)]
;;;     (i64vec-ref v 2))   ; => 7
;;;
;;; Since: Phase N0

(defn i64vec-new [n : int init : int]
  #fx{}
  : I64Vec
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(int64_t)) {
    tur_panic("i64vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; int64_t *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "i64vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(int64_t) + 32);
  if (!b->raw) { fprintf(stderr, "i64vec-new: out of memory\n"); abort(); }
  b->data = (int64_t *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = init;
  return (int64_t)(intptr_t)b;
  ```)
;;; i64vec-of -- a I64Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type int
;;;
;;; Returns:
;;;   A fresh I64Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)]
;;;     (i64vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro i64vec-of [& xs]
  (let [v (gensym "nv")] (list numvec-of__ i64vec-new i64vec-set! 0 v ~@xs)))
;;; i64vec-free -- release a I64Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound I64Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (i64vec-free v)
;;;
;;; Since: Phase N0

(defn i64vec-free [v : I64Vec]
  #fx{}
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (a) { free(a->raw); free(a); }
  ```)
;;; Drop [I64Vec] -- free the array when a bound I64Vec dies unmoved.

(definstance Drop [I64Vec] (drop [x] : void (i64vec-free x)))
;;; i64vec-len -- the element count of a I64Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (i64vec-new 8 7)]
;;;     (i64vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn i64vec-len [^borrow v : I64Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; i64vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed int.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)]
;;;     (i64vec-ref v 1))   ; => 2
;;;
;;; Since: Phase N0

(defn i64vec-ref [^borrow v : I64Vec i : int]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("i64vec-ref: index out of bounds");
  return 0;
  ```)
;;; i64vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (i64vec-set! v 0 7)
;;;
;;; Since: Phase N0

(defn i64vec-set! [^borrow v : I64Vec i : int x : int]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) { a->data[i] = x; return; }
  tur_panic("i64vec-set!: index out of bounds");
  ```)
;;; i64vec-copy -- a fresh I64Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (i64vec-copy v)] (i64vec-set! c 0 7))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn i64vec-copy [^borrow v : I64Vec]
  #fx{}
  : I64Vec
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  struct { int64_t len; int64_t *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "i64vec-copy: out of memory\n"); abort(); }
  c->len = a->len;
  c->raw = malloc((size_t)a->len * sizeof(int64_t) + 32);
  if (!c->raw) { fprintf(stderr, "i64vec-copy: out of memory\n"); abort(); }
  c->data = (int64_t *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (a->len > 0) memcpy(c->data, a->data, (size_t)a->len * sizeof(int64_t));
  return (int64_t)(intptr_t)c;
  ```)
;;; i64vec->vec-go__ -- internal: push v[i..n) onto out.

(defn i64vec->vec-go__ [^borrow v : I64Vec out : (Vec int) i : int n : int] : (Vec int)
  (if (>= i n)
    out
    (do (vec-push! out (i64vec-ref v i)) (i64vec->vec-go__ v out (+ i 1) n))))
;;; i64vec->vec -- copy a I64Vec into a fresh (Vec int).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (i64vec-of 1 2)
;;;         v (i64vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn i64vec->vec [^borrow v : I64Vec] : (Vec int)
  (i64vec->vec-go__ v (:: (vec-new) (Vec int)) 0 (i64vec-len v)))
;;; vec->i64vec-go__ -- internal: store src[i..n) into out.

(defn vec->i64vec-go__ [^borrow out : I64Vec
                        ^borrow src : (Vec int)
                        i : int
                        n : int] : nil
  (if (>= i n)
    nil
    (do
      (i64vec-set! out i (:: (vec-get src i) int))
      (vec->i64vec-go__ out src (+ i 1) n))))
;;; vec->i64vec -- copy a (Vec int) into a fresh I64Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A I64Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of 1 2)
;;;         a (vec->i64vec v)]
;;;     (i64vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->i64vec [^borrow src : (Vec int)] : I64Vec
  (let [out (i64vec-new (vec-len src) 0)]
    (vec->i64vec-go__ out src 0 (vec-len src))
    out))
;;; i64vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn i64vec-show-loop__ [^borrow v : I64Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (i64vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (i64vec-show-loop__ v (+ i 1) n b))))
;;; i64vec-show -- render a I64Vec as an owned "#i64vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)]
;;;     (i64vec-show v))   ; => String "#i64vec[1 2]"
;;;
;;; Since: Phase N0

(defn i64vec-show [^borrow v : I64Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#i64vec[")
      (i64vec-show-loop__ v 0 (i64vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; --- N1 bulk kernels, N2 unchecked access and loops (tools/gen-numvec.py) ---
;;; i64vec-fill! -- store x in every slot.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   x -- the value
;;;
;;; Example:
;;;   (i64vec-fill! v 1)
;;;
;;; Since: Phase N1

(defn i64vec-fill! [^borrow v : I64Vec x : int]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  int64_t *d = a->data;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = x;
    d[i + 1] = x;
    d[i + 2] = x;
    d[i + 3] = x;
    d[i + 4] = x;
    d[i + 5] = x;
    d[i + 6] = x;
    d[i + 7] = x;
  }
  for (; i < n; i++) d[i] = x;
  ```)
;;; i64vec-copy! -- copy src's elements into dst (same length, or a panic).
;;;
;;; Parameters:
;;;   dst -- the array written (borrowed)
;;;   src -- the array read (borrowed)
;;;
;;; Example:
;;;   (i64vec-copy! dst src)
;;;
;;; Since: Phase N1

(defn i64vec-copy! [^borrow dst : I64Vec ^borrow src : I64Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; int64_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("i64vec-copy!: length mismatch");
      return;
    }
  if (y->len > 0) memmove(y->data, x->data, (size_t)y->len * sizeof(int64_t));
  ```)
;;; i64vec-scale! -- multiply every element by s, in place.
;;;
;;; Integer arithmetic wraps.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   s -- the factor
;;;
;;; Example:
;;;   (i64vec-scale! v 2)
;;;
;;; Since: Phase N1

(defn i64vec-scale! [^borrow v : I64Vec s : int]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  int64_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) d[i] = (int64_t)((uint64_t)d[i] * (uint64_t)s);
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = (int64_t)((uint64_t)d[i] * (uint64_t)s);
    d[i + 1] = (int64_t)((uint64_t)d[i + 1] * (uint64_t)s);
    d[i + 2] = (int64_t)((uint64_t)d[i + 2] * (uint64_t)s);
    d[i + 3] = (int64_t)((uint64_t)d[i + 3] * (uint64_t)s);
    d[i + 4] = (int64_t)((uint64_t)d[i + 4] * (uint64_t)s);
    d[i + 5] = (int64_t)((uint64_t)d[i + 5] * (uint64_t)s);
    d[i + 6] = (int64_t)((uint64_t)d[i + 6] * (uint64_t)s);
    d[i + 7] = (int64_t)((uint64_t)d[i + 7] * (uint64_t)s);
  }
  for (; i < n; i++) d[i] = (int64_t)((uint64_t)d[i] * (uint64_t)s);
  #endif
  ```)
;;; i64vec-add! -- dst[i] += src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; dst and src may be the same array.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   src -- the array added (borrowed)
;;;
;;; Example:
;;;   (i64vec-add! y x)
;;;
;;; Since: Phase N1

(defn i64vec-add! [^borrow dst : I64Vec ^borrow src : I64Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; int64_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("i64vec-add!: length mismatch");
      return;
    }
  int64_t n = y->len;
  int64_t *yd = y->data;
  const int64_t *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) yd[i] = (int64_t)((uint64_t)yd[i] + (uint64_t)xd[i]);
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    int64_t y0 = yd[i], x0 = xd[i];
    int64_t y1 = yd[i + 1], x1 = xd[i + 1];
    int64_t y2 = yd[i + 2], x2 = xd[i + 2];
    int64_t y3 = yd[i + 3], x3 = xd[i + 3];
    int64_t y4 = yd[i + 4], x4 = xd[i + 4];
    int64_t y5 = yd[i + 5], x5 = xd[i + 5];
    int64_t y6 = yd[i + 6], x6 = xd[i + 6];
    int64_t y7 = yd[i + 7], x7 = xd[i + 7];
    yd[i] = (int64_t)((uint64_t)y0 + (uint64_t)x0);
    yd[i + 1] = (int64_t)((uint64_t)y1 + (uint64_t)x1);
    yd[i + 2] = (int64_t)((uint64_t)y2 + (uint64_t)x2);
    yd[i + 3] = (int64_t)((uint64_t)y3 + (uint64_t)x3);
    yd[i + 4] = (int64_t)((uint64_t)y4 + (uint64_t)x4);
    yd[i + 5] = (int64_t)((uint64_t)y5 + (uint64_t)x5);
    yd[i + 6] = (int64_t)((uint64_t)y6 + (uint64_t)x6);
    yd[i + 7] = (int64_t)((uint64_t)y7 + (uint64_t)x7);
  }
  for (; i < n; i++) yd[i] = (int64_t)((uint64_t)yd[i] + (uint64_t)xd[i]);
  #endif
  ```)
;;; i64vec-axpy! -- dst[i] += s * src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; the multiply and the add are not fused.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   s -- the factor
;;;   src -- the array scaled and added (borrowed)
;;;
;;; Example:
;;;   (i64vec-axpy! y 2 x)
;;;
;;; Since: Phase N1

(defn i64vec-axpy! [^borrow dst : I64Vec s : int ^borrow src : I64Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; int64_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("i64vec-axpy!: length mismatch");
      return;
    }
  int64_t n = y->len;
  int64_t *yd = y->data;
  const int64_t *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) { uint64_t m = (uint64_t)s * (uint64_t)xd[i]; yd[i] = (int64_t)((uint64_t)yd[i] + m); }
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    int64_t y0 = yd[i], x0 = xd[i];
    int64_t y1 = yd[i + 1], x1 = xd[i + 1];
    int64_t y2 = yd[i + 2], x2 = xd[i + 2];
    int64_t y3 = yd[i + 3], x3 = xd[i + 3];
    int64_t y4 = yd[i + 4], x4 = xd[i + 4];
    int64_t y5 = yd[i + 5], x5 = xd[i + 5];
    int64_t y6 = yd[i + 6], x6 = xd[i + 6];
    int64_t y7 = yd[i + 7], x7 = xd[i + 7];
    uint64_t m0 = (uint64_t)s * (uint64_t)x0;
    uint64_t m1 = (uint64_t)s * (uint64_t)x1;
    uint64_t m2 = (uint64_t)s * (uint64_t)x2;
    uint64_t m3 = (uint64_t)s * (uint64_t)x3;
    uint64_t m4 = (uint64_t)s * (uint64_t)x4;
    uint64_t m5 = (uint64_t)s * (uint64_t)x5;
    uint64_t m6 = (uint64_t)s * (uint64_t)x6;
    uint64_t m7 = (uint64_t)s * (uint64_t)x7;
    yd[i] = (int64_t)((uint64_t)y0 + m0);
    yd[i + 1] = (int64_t)((uint64_t)y1 + m1);
    yd[i + 2] = (int64_t)((uint64_t)y2 + m2);
    yd[i + 3] = (int64_t)((uint64_t)y3 + m3);
    yd[i + 4] = (int64_t)((uint64_t)y4 + m4);
    yd[i + 5] = (int64_t)((uint64_t)y5 + m5);
    yd[i + 6] = (int64_t)((uint64_t)y6 + m6);
    yd[i + 7] = (int64_t)((uint64_t)y7 + m7);
  }
  for (; i < n; i++) { uint64_t m = (uint64_t)s * (uint64_t)xd[i]; yd[i] = (int64_t)((uint64_t)yd[i] + m); }
  #endif
  ```)
;;; i64vec-sum -- the sum of the elements.
;;;
;;; A float sum is computed in eight interleaved partial sums (lane k
;;; takes the elements i with i mod 8 = k), combined in one fixed tree:
;;; the same answer on every engine and machine, and vectorizable without
;;; -ffast-math.  It can differ in the last bits from `-sum-ordered`, the
;;; left-to-right sum.  An integer sum wraps modulo 2^64; a narrow element
;;; is widened to `int` first.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)] (i64vec-sum v))
;;;
;;; Since: Phase N1

(defn i64vec-sum [^borrow v : I64Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  const int64_t *d = a->data;
  uint64_t s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    s[0] = s[0] + (uint64_t)d[i];
    s[1] = s[1] + (uint64_t)d[i + 1];
    s[2] = s[2] + (uint64_t)d[i + 2];
    s[3] = s[3] + (uint64_t)d[i + 3];
    s[4] = s[4] + (uint64_t)d[i + 4];
    s[5] = s[5] + (uint64_t)d[i + 5];
    s[6] = s[6] + (uint64_t)d[i + 6];
    s[7] = s[7] + (uint64_t)d[i + 7];
  }
  for (; i < n; i++) s[i & 7] = s[i & 7] + (uint64_t)d[i];
  return (int64_t)(((s[0] + s[1]) + (s[2] + s[3])) + ((s[4] + s[5]) + (s[6] + s[7])));
  ```)
;;; i64vec-dot -- the dot product of two arrays (same length, or a panic).
;;;
;;; Floats use the same eight-lane order as `-sum`.  Integers wrap modulo
;;; 2^64; an `int32` product is formed in 64 bits.
;;;
;;; Parameters:
;;;   a -- the first array (borrowed)
;;;   b -- the second array (borrowed)
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (let [a (i64vec-of 1 2) b (i64vec-of 2 1)] (i64vec-dot a b))
;;;
;;; Since: Phase N1

(defn i64vec-dot [^borrow a : I64Vec ^borrow b : I64Vec]
  #fx{}
  #reads [a b]
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *y = (void*)(intptr_t)a;
  struct { int64_t len; int64_t *data; void *raw; } *x = (void*)(intptr_t)b;
  if (y->len != x->len) {
      tur_panic("i64vec-dot: length mismatch");
      return 0;
    }
  int64_t n = y->len;
  const int64_t *yd = y->data;
  const int64_t *xd = x->data;
  uint64_t s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    s[0] = s[0] + (uint64_t)yd[i] * (uint64_t)xd[i];
    s[1] = s[1] + (uint64_t)yd[i + 1] * (uint64_t)xd[i + 1];
    s[2] = s[2] + (uint64_t)yd[i + 2] * (uint64_t)xd[i + 2];
    s[3] = s[3] + (uint64_t)yd[i + 3] * (uint64_t)xd[i + 3];
    s[4] = s[4] + (uint64_t)yd[i + 4] * (uint64_t)xd[i + 4];
    s[5] = s[5] + (uint64_t)yd[i + 5] * (uint64_t)xd[i + 5];
    s[6] = s[6] + (uint64_t)yd[i + 6] * (uint64_t)xd[i + 6];
    s[7] = s[7] + (uint64_t)yd[i + 7] * (uint64_t)xd[i + 7];
  }
  for (; i < n; i++) s[i & 7] = s[i & 7] + (uint64_t)yd[i] * (uint64_t)xd[i];
  return (int64_t)(((s[0] + s[1]) + (s[2] + s[3])) + ((s[4] + s[5]) + (s[6] + s[7])));
  ```)
;;; i64vec-min -- the smallest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)] (i64vec-min v))   ; => 1
;;;
;;; Since: Phase N1

(defn i64vec-min [^borrow v : I64Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("i64vec-min: empty array");
      return 0;
    }
  const int64_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  int64_t m = d[0];
  for (int64_t i = 1; i < n; i++) m = d[i] < m ? d[i] : m;
  return m;
  #else
  int64_t m[8];
  for (int k = 0; k < 8; k++) m[k] = d[0];
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    m[0] = d[i] < m[0] ? d[i] : m[0];
    m[1] = d[i + 1] < m[1] ? d[i + 1] : m[1];
    m[2] = d[i + 2] < m[2] ? d[i + 2] : m[2];
    m[3] = d[i + 3] < m[3] ? d[i + 3] : m[3];
    m[4] = d[i + 4] < m[4] ? d[i + 4] : m[4];
    m[5] = d[i + 5] < m[5] ? d[i + 5] : m[5];
    m[6] = d[i + 6] < m[6] ? d[i + 6] : m[6];
    m[7] = d[i + 7] < m[7] ? d[i + 7] : m[7];
  }
  for (; i < n; i++) m[i & 7] = d[i] < m[i & 7] ? d[i] : m[i & 7];
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] < m[k] ? m[k + w] : m[k];
  return m[0];
  #endif
  ```)
;;; i64vec-max -- the largest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)] (i64vec-max v))   ; => 2
;;;
;;; Since: Phase N1

(defn i64vec-max [^borrow v : I64Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("i64vec-max: empty array");
      return 0;
    }
  const int64_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  int64_t m = d[0];
  for (int64_t i = 1; i < n; i++) m = d[i] > m ? d[i] : m;
  return m;
  #else
  int64_t m[8];
  for (int k = 0; k < 8; k++) m[k] = d[0];
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    m[0] = d[i] > m[0] ? d[i] : m[0];
    m[1] = d[i + 1] > m[1] ? d[i + 1] : m[1];
    m[2] = d[i + 2] > m[2] ? d[i + 2] : m[2];
    m[3] = d[i + 3] > m[3] ? d[i + 3] : m[3];
    m[4] = d[i + 4] > m[4] ? d[i + 4] : m[4];
    m[5] = d[i + 5] > m[5] ? d[i + 5] : m[5];
    m[6] = d[i + 6] > m[6] ? d[i + 6] : m[6];
    m[7] = d[i + 7] > m[7] ? d[i + 7] : m[7];
  }
  for (; i < n; i++) m[i & 7] = d[i] > m[i & 7] ? d[i] : m[i & 7];
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] > m[k] ? m[k + w] : m[k];
  return m[0];
  #endif
  ```)
;;; i64vec-ref-unchecked -- the element at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  The loop macros
;;; (`-for`, `-fold`, ...) use it where they have already checked the index.
;;; Its body calls nothing, so a call to it carries no panic check, and a
;;; loop of such calls can vectorize.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (unsafe (i64vec-ref-unchecked v 0))
;;;
;;; Since: Phase N2

(defn i64vec-ref-unchecked [^borrow v : I64Vec i : int]
  #fx{Unsafe}
  #reads v
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->data[i];
  ```)
;;; i64vec-set-unchecked! -- store x at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  Stores a number: no
;;; TUR_REGION_NOTE (see the module header).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;   x -- the new element
;;;
;;; Example:
;;;   (unsafe (i64vec-set-unchecked! v 0 1))
;;;
;;; Since: Phase N2

(defn i64vec-set-unchecked! [^borrow v : I64Vec i : int x : int]
  #fx{Unsafe}
  #writes v
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *a = (void*)(intptr_t)v;
  a->data[i] = x;
  ```)
;;; i64vec-for -- run body once per element of one or two I64Vecs.
;;;
;;; `(for [x v] body...)` binds x to each element of v in order;
;;; `(for [x v y w] body...)` walks v and w together (same length, or a panic
;;; before the first pass).  No index is in scope, so none can be wrong: the
;;; reads are `i64vec-ref-unchecked`, the body sees plain elements, and the loop
;;; carries no bounds check or panic test -- gcc can vectorize it at -O3.  An
;;; array argument that is not a name is evaluated once, and freed after.
;;;
;;; Parameters:
;;;   bindings -- `[x v]` or `[x v y w]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)] (i64vec-for [x v] (println x)))
;;;
;;; Since: Phase N2

(defmacro i64vec-for [bv & body]
  (let [i    (gensym "i")
        n    (gensym "n")
        x    (first bv)
        v    (second bv)
        more (rest (rest bv))]
    (if (list? v)
      (let [t (gensym "nv")] `(let [~t ~v] (i64vec-for [~x ~t ~@more] ~@body)))
      (if (empty? more)
        `(let [^mut ~i 0
               ~n      (i64vec-len ~v)]
           (while (< ~i ~n)
             (let [~x (unsafe (i64vec-ref-unchecked ~v ~i))] ~@body)
             (set! ~i (+ ~i 1))))
        (let [y (first more)
              w (second more)]
          (if (list? w)
            (let [t (gensym "nv")]
              `(let [~t ~w] (i64vec-for [~x ~v ~y ~t] ~@body)))
            `(let [^mut ~i 0
                   ~n      (i64vec-same-len__ ~v ~w)]
               (while (< ~i ~n)
                 (let [~x (unsafe (i64vec-ref-unchecked ~v ~i))
                       ~y (unsafe (i64vec-ref-unchecked ~w ~i))]
                   ~@body)
                 (set! ~i (+ ~i 1))))))))))
;;; i64vec-for-index -- run body once per element, with its index.
;;;
;;; `(for-index [i x v] body...)` binds i (read-only) and x = v[i].
;;;
;;; Parameters:
;;;   bindings -- `[i x v]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)] (i64vec-for-index [i x v] (println i)))
;;;
;;; Since: Phase N2

(defmacro i64vec-for-index [bv & body]
  (let [i  (gensym "i")
        n  (gensym "n")
        iv (first bv)
        x  (second bv)
        v  (first (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (i64vec-for-index [~iv ~x ~t] ~@body)))
      `(let [^mut ~i 0
             ~n      (i64vec-len ~v)]
         (while (< ~i ~n)
           (let [~iv ~i
                 ~x  (unsafe (i64vec-ref-unchecked ~v ~i))]
             ~@body)
           (set! ~i (+ ~i 1)))))))
;;; i64vec-fold -- fold the elements of a I64Vec into an accumulator.
;;;
;;; `(fold [acc init x v] body)`: acc starts at init, and for each element x
;;; in order becomes the value of body (which sees acc and x).  The result is
;;; the final acc.  A float sum written this way is the strict left fold, so
;;; gcc keeps it scalar; `i64vec-sum` is the vectorized one.
;;;
;;; Parameters:
;;;   bindings -- `[acc init x v]`
;;;   body     -- the new accumulator
;;;
;;; Returns:
;;;   The final accumulator.
;;;
;;; Example:
;;;   (let [v (i64vec-of 1 2)] (i64vec-fold [n 0 x v] (+ n 1)))   ; => 2
;;;
;;; Since: Phase N2

(defmacro i64vec-fold [bv body]
  (let [i    (gensym "i")
        n    (gensym "n")
        acc  (first bv)
        init (second bv)
        x    (first (rest (rest bv)))
        v    (second (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (i64vec-fold [~acc ~init ~x ~t] ~body)))
      `(let [^mut ~i   0
             ~n        (i64vec-len ~v)
             ^mut ~acc ~init]
         (while (< ~i ~n)
           (let [~x (unsafe (i64vec-ref-unchecked ~v ~i))] (set! ~acc ~body))
           (set! ~i (+ ~i 1)))
         ~acc))))
;;; i64vec-build -- a fresh I64Vec of n elements, element i the value of expr.
;;;
;;; `(build n [i] expr)`, after Racket's `for/flvector`: i is bound to each
;;; index in turn, and expr runs outside any `unsafe`.
;;;
;;; Parameters:
;;;   n    -- the length (evaluated once)
;;;   i    -- the index name, in a vector
;;;   expr -- the element at i, of type int
;;;
;;; Returns:
;;;   A fresh I64Vec, owned by the caller.
;;;
;;; Example:
;;;   (let [v (i64vec-build 3 [i] 1)] (i64vec-len v))   ; => 3
;;;
;;; Since: Phase N2

(defmacro i64vec-build [n bv expr]
  (let [i   (gensym "i")
        m   (gensym "n")
        e   (gensym "e")
        out (gensym "out")
        iv  (first bv)]
    `(let [~m      ~n
           ~out    (i64vec-new ~m 0)
           ^mut ~i 0]
       (while (< ~i ~m)
         (let [~iv ~i
               ~e  ~expr]
           (unsafe (i64vec-set-unchecked! ~out ~i ~e)))
         (set! ~i (+ ~i 1)))
       ~out)))
;;; i64vec-same-len__ -- internal: the common length of two arrays, or a panic.

(defn i64vec-same-len__ [^borrow a : I64Vec ^borrow b : I64Vec]
  #fx{}
  #reads [a b]
  : int
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *x = (void*)(intptr_t)a;
  struct { int64_t len; int64_t *data; void *raw; } *y = (void*)(intptr_t)b;
  if (x->len != y->len) {
    tur_panic("i64vec-for: length mismatch");
    return 0;
  }
  return x->len;
  ```)
;; ===== I32Vec: 32-bit integers =====
;;; I32Vec -- a fixed-length, unboxed array of 32-bit integers (int32).
;;;
;;; Opaque handle to a `struct { int64_t len; int32_t *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `i32vec-new` or
;;; `i32vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine I32Vec :int)
;; Every operation that touches the header is an inline-C body of its own,
;; never a Turmeric wrapper over a raw one, so a panic is reported at the
;; CALLER's line (as vec-get's is) and turi's natives are keyed by the public
;; names.  An element store writes a number, never a pointer, so the setter
;; carries no TUR_REGION_NOTE (CLAUDE.md, "Region Store Hooks").
;;; i32vec-new -- allocate a I32Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh I32Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (i32vec-new 4 (as int32 7))]
;;;     (i32vec-ref v 2))   ; => (as int32 7)
;;;
;;; Since: Phase N0

(defn i32vec-new [n : int init : int32]
  #fx{}
  : I32Vec
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(int32_t)) {
    tur_panic("i32vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; int32_t *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "i32vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(int32_t) + 32);
  if (!b->raw) { fprintf(stderr, "i32vec-new: out of memory\n"); abort(); }
  b->data = (int32_t *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = init;
  return (int64_t)(intptr_t)b;
  ```)
;;; i32vec-of -- a I32Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type int32
;;;
;;; Returns:
;;;   A fresh I32Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))]
;;;     (i32vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro i32vec-of [& xs]
  (let [v (gensym "nv")]
    (list numvec-of__ i32vec-new i32vec-set! (list as int32 0) v ~@xs)))
;;; i32vec-free -- release a I32Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound I32Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (i32vec-free v)
;;;
;;; Since: Phase N0

(defn i32vec-free [v : I32Vec]
  #fx{}
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (a) { free(a->raw); free(a); }
  ```)
;;; Drop [I32Vec] -- free the array when a bound I32Vec dies unmoved.

(definstance Drop [I32Vec] (drop [x] : void (i32vec-free x)))
;;; i32vec-len -- the element count of a I32Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (i32vec-new 8 (as int32 7))]
;;;     (i32vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn i32vec-len [^borrow v : I32Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; i32vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed int32.
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))]
;;;     (i32vec-ref v 1))   ; => (as int32 2)
;;;
;;; Since: Phase N0

(defn i32vec-ref [^borrow v : I32Vec i : int]
  #fx{}
  #reads v
  : int32
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("i32vec-ref: index out of bounds");
  return 0;
  ```)
;;; i32vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (i32vec-set! v 0 (as int32 7))
;;;
;;; Since: Phase N0

(defn i32vec-set! [^borrow v : I32Vec i : int x : int32]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) { a->data[i] = x; return; }
  tur_panic("i32vec-set!: index out of bounds");
  ```)
;;; i32vec-copy -- a fresh I32Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (i32vec-copy v)] (i32vec-set! c 0 (as int32 7)))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn i32vec-copy [^borrow v : I32Vec]
  #fx{}
  : I32Vec
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  struct { int64_t len; int32_t *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "i32vec-copy: out of memory\n"); abort(); }
  c->len = a->len;
  c->raw = malloc((size_t)a->len * sizeof(int32_t) + 32);
  if (!c->raw) { fprintf(stderr, "i32vec-copy: out of memory\n"); abort(); }
  c->data = (int32_t *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (a->len > 0) memcpy(c->data, a->data, (size_t)a->len * sizeof(int32_t));
  return (int64_t)(intptr_t)c;
  ```)
;;; i32vec->vec-go__ -- internal: push v[i..n) onto out.

(defn i32vec->vec-go__ [^borrow v : I32Vec out : (Vec int32) i : int n : int] : (Vec int32)
  (if (>= i n)
    out
    (do (vec-push! out (i32vec-ref v i)) (i32vec->vec-go__ v out (+ i 1) n))))
;;; i32vec->vec -- copy a I32Vec into a fresh (Vec int32).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (i32vec-of (as int32 1) (as int32 2))
;;;         v (i32vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn i32vec->vec [^borrow v : I32Vec] : (Vec int32)
  (i32vec->vec-go__ v (:: (vec-new) (Vec int32)) 0 (i32vec-len v)))
;;; vec->i32vec-go__ -- internal: store src[i..n) into out.

(defn vec->i32vec-go__ [^borrow out : I32Vec
                        ^borrow src : (Vec int32)
                        i : int
                        n : int] : nil
  (if (>= i n)
    nil
    (do
      (i32vec-set! out i (:: (vec-get src i) int32))
      (vec->i32vec-go__ out src (+ i 1) n))))
;;; vec->i32vec -- copy a (Vec int32) into a fresh I32Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A I32Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of (as int32 1) (as int32 2))
;;;         a (vec->i32vec v)]
;;;     (i32vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->i32vec [^borrow src : (Vec int32)] : I32Vec
  (let [out (i32vec-new (vec-len src) (as int32 0))]
    (vec->i32vec-go__ out src 0 (vec-len src))
    out))
;;; i32vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn i32vec-show-loop__ [^borrow v : I32Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (i32vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (i32vec-show-loop__ v (+ i 1) n b))))
;;; i32vec-show -- render a I32Vec as an owned "#i32vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))]
;;;     (i32vec-show v))   ; => String "#i32vec[1 2]"
;;;
;;; Since: Phase N0

(defn i32vec-show [^borrow v : I32Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#i32vec[")
      (i32vec-show-loop__ v 0 (i32vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; --- N1 bulk kernels, N2 unchecked access and loops (tools/gen-numvec.py) ---
;;; i32vec-fill! -- store x in every slot.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   x -- the value
;;;
;;; Example:
;;;   (i32vec-fill! v (as int32 1))
;;;
;;; Since: Phase N1

(defn i32vec-fill! [^borrow v : I32Vec x : int32]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  int32_t *d = a->data;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = x;
    d[i + 1] = x;
    d[i + 2] = x;
    d[i + 3] = x;
    d[i + 4] = x;
    d[i + 5] = x;
    d[i + 6] = x;
    d[i + 7] = x;
  }
  for (; i < n; i++) d[i] = x;
  ```)
;;; i32vec-copy! -- copy src's elements into dst (same length, or a panic).
;;;
;;; Parameters:
;;;   dst -- the array written (borrowed)
;;;   src -- the array read (borrowed)
;;;
;;; Example:
;;;   (i32vec-copy! dst src)
;;;
;;; Since: Phase N1

(defn i32vec-copy! [^borrow dst : I32Vec ^borrow src : I32Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; int32_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("i32vec-copy!: length mismatch");
      return;
    }
  if (y->len > 0) memmove(y->data, x->data, (size_t)y->len * sizeof(int32_t));
  ```)
;;; i32vec-scale! -- multiply every element by s, in place.
;;;
;;; Integer arithmetic wraps.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   s -- the factor
;;;
;;; Example:
;;;   (i32vec-scale! v (as int32 2))
;;;
;;; Since: Phase N1

(defn i32vec-scale! [^borrow v : I32Vec s : int32]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  int32_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) d[i] = (int32_t)((uint32_t)d[i] * (uint32_t)s);
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = (int32_t)((uint32_t)d[i] * (uint32_t)s);
    d[i + 1] = (int32_t)((uint32_t)d[i + 1] * (uint32_t)s);
    d[i + 2] = (int32_t)((uint32_t)d[i + 2] * (uint32_t)s);
    d[i + 3] = (int32_t)((uint32_t)d[i + 3] * (uint32_t)s);
    d[i + 4] = (int32_t)((uint32_t)d[i + 4] * (uint32_t)s);
    d[i + 5] = (int32_t)((uint32_t)d[i + 5] * (uint32_t)s);
    d[i + 6] = (int32_t)((uint32_t)d[i + 6] * (uint32_t)s);
    d[i + 7] = (int32_t)((uint32_t)d[i + 7] * (uint32_t)s);
  }
  for (; i < n; i++) d[i] = (int32_t)((uint32_t)d[i] * (uint32_t)s);
  #endif
  ```)
;;; i32vec-add! -- dst[i] += src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; dst and src may be the same array.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   src -- the array added (borrowed)
;;;
;;; Example:
;;;   (i32vec-add! y x)
;;;
;;; Since: Phase N1

(defn i32vec-add! [^borrow dst : I32Vec ^borrow src : I32Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; int32_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("i32vec-add!: length mismatch");
      return;
    }
  int64_t n = y->len;
  int32_t *yd = y->data;
  const int32_t *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) yd[i] = (int32_t)((uint32_t)yd[i] + (uint32_t)xd[i]);
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    int32_t y0 = yd[i], x0 = xd[i];
    int32_t y1 = yd[i + 1], x1 = xd[i + 1];
    int32_t y2 = yd[i + 2], x2 = xd[i + 2];
    int32_t y3 = yd[i + 3], x3 = xd[i + 3];
    int32_t y4 = yd[i + 4], x4 = xd[i + 4];
    int32_t y5 = yd[i + 5], x5 = xd[i + 5];
    int32_t y6 = yd[i + 6], x6 = xd[i + 6];
    int32_t y7 = yd[i + 7], x7 = xd[i + 7];
    yd[i] = (int32_t)((uint32_t)y0 + (uint32_t)x0);
    yd[i + 1] = (int32_t)((uint32_t)y1 + (uint32_t)x1);
    yd[i + 2] = (int32_t)((uint32_t)y2 + (uint32_t)x2);
    yd[i + 3] = (int32_t)((uint32_t)y3 + (uint32_t)x3);
    yd[i + 4] = (int32_t)((uint32_t)y4 + (uint32_t)x4);
    yd[i + 5] = (int32_t)((uint32_t)y5 + (uint32_t)x5);
    yd[i + 6] = (int32_t)((uint32_t)y6 + (uint32_t)x6);
    yd[i + 7] = (int32_t)((uint32_t)y7 + (uint32_t)x7);
  }
  for (; i < n; i++) yd[i] = (int32_t)((uint32_t)yd[i] + (uint32_t)xd[i]);
  #endif
  ```)
;;; i32vec-axpy! -- dst[i] += s * src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; the multiply and the add are not fused.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   s -- the factor
;;;   src -- the array scaled and added (borrowed)
;;;
;;; Example:
;;;   (i32vec-axpy! y (as int32 2) x)
;;;
;;; Since: Phase N1

(defn i32vec-axpy! [^borrow dst : I32Vec s : int32 ^borrow src : I32Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; int32_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("i32vec-axpy!: length mismatch");
      return;
    }
  int64_t n = y->len;
  int32_t *yd = y->data;
  const int32_t *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) { uint32_t m = (uint32_t)s * (uint32_t)xd[i]; yd[i] = (int32_t)((uint32_t)yd[i] + m); }
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    int32_t y0 = yd[i], x0 = xd[i];
    int32_t y1 = yd[i + 1], x1 = xd[i + 1];
    int32_t y2 = yd[i + 2], x2 = xd[i + 2];
    int32_t y3 = yd[i + 3], x3 = xd[i + 3];
    int32_t y4 = yd[i + 4], x4 = xd[i + 4];
    int32_t y5 = yd[i + 5], x5 = xd[i + 5];
    int32_t y6 = yd[i + 6], x6 = xd[i + 6];
    int32_t y7 = yd[i + 7], x7 = xd[i + 7];
    uint32_t m0 = (uint32_t)s * (uint32_t)x0;
    uint32_t m1 = (uint32_t)s * (uint32_t)x1;
    uint32_t m2 = (uint32_t)s * (uint32_t)x2;
    uint32_t m3 = (uint32_t)s * (uint32_t)x3;
    uint32_t m4 = (uint32_t)s * (uint32_t)x4;
    uint32_t m5 = (uint32_t)s * (uint32_t)x5;
    uint32_t m6 = (uint32_t)s * (uint32_t)x6;
    uint32_t m7 = (uint32_t)s * (uint32_t)x7;
    yd[i] = (int32_t)((uint32_t)y0 + m0);
    yd[i + 1] = (int32_t)((uint32_t)y1 + m1);
    yd[i + 2] = (int32_t)((uint32_t)y2 + m2);
    yd[i + 3] = (int32_t)((uint32_t)y3 + m3);
    yd[i + 4] = (int32_t)((uint32_t)y4 + m4);
    yd[i + 5] = (int32_t)((uint32_t)y5 + m5);
    yd[i + 6] = (int32_t)((uint32_t)y6 + m6);
    yd[i + 7] = (int32_t)((uint32_t)y7 + m7);
  }
  for (; i < n; i++) { uint32_t m = (uint32_t)s * (uint32_t)xd[i]; yd[i] = (int32_t)((uint32_t)yd[i] + m); }
  #endif
  ```)
;;; i32vec-sum -- the sum of the elements.
;;;
;;; A float sum is computed in eight interleaved partial sums (lane k
;;; takes the elements i with i mod 8 = k), combined in one fixed tree:
;;; the same answer on every engine and machine, and vectorizable without
;;; -ffast-math.  It can differ in the last bits from `-sum-ordered`, the
;;; left-to-right sum.  An integer sum wraps modulo 2^64; a narrow element
;;; is widened to `int` first.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))] (i32vec-sum v))
;;;
;;; Since: Phase N1

(defn i32vec-sum [^borrow v : I32Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  const int32_t *d = a->data;
  uint64_t s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    s[0] = s[0] + (uint64_t)(int64_t)d[i];
    s[1] = s[1] + (uint64_t)(int64_t)d[i + 1];
    s[2] = s[2] + (uint64_t)(int64_t)d[i + 2];
    s[3] = s[3] + (uint64_t)(int64_t)d[i + 3];
    s[4] = s[4] + (uint64_t)(int64_t)d[i + 4];
    s[5] = s[5] + (uint64_t)(int64_t)d[i + 5];
    s[6] = s[6] + (uint64_t)(int64_t)d[i + 6];
    s[7] = s[7] + (uint64_t)(int64_t)d[i + 7];
  }
  for (; i < n; i++) s[i & 7] = s[i & 7] + (uint64_t)(int64_t)d[i];
  return (int64_t)(((s[0] + s[1]) + (s[2] + s[3])) + ((s[4] + s[5]) + (s[6] + s[7])));
  ```)
;;; i32vec-dot -- the dot product of two arrays (same length, or a panic).
;;;
;;; Floats use the same eight-lane order as `-sum`.  Integers wrap modulo
;;; 2^64; an `int32` product is formed in 64 bits.
;;;
;;; Parameters:
;;;   a -- the first array (borrowed)
;;;   b -- the second array (borrowed)
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (let [a (i32vec-of (as int32 1) (as int32 2)) b (i32vec-of (as int32 2) (as int32 1))] (i32vec-dot a b))
;;;
;;; Since: Phase N1

(defn i32vec-dot [^borrow a : I32Vec ^borrow b : I32Vec]
  #fx{}
  #reads [a b]
  : int
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *y = (void*)(intptr_t)a;
  struct { int64_t len; int32_t *data; void *raw; } *x = (void*)(intptr_t)b;
  if (y->len != x->len) {
      tur_panic("i32vec-dot: length mismatch");
      return 0;
    }
  int64_t n = y->len;
  const int32_t *yd = y->data;
  const int32_t *xd = x->data;
  uint64_t s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    s[0] = s[0] + (uint64_t)((int64_t)yd[i] * (int64_t)xd[i]);
    s[1] = s[1] + (uint64_t)((int64_t)yd[i + 1] * (int64_t)xd[i + 1]);
    s[2] = s[2] + (uint64_t)((int64_t)yd[i + 2] * (int64_t)xd[i + 2]);
    s[3] = s[3] + (uint64_t)((int64_t)yd[i + 3] * (int64_t)xd[i + 3]);
    s[4] = s[4] + (uint64_t)((int64_t)yd[i + 4] * (int64_t)xd[i + 4]);
    s[5] = s[5] + (uint64_t)((int64_t)yd[i + 5] * (int64_t)xd[i + 5]);
    s[6] = s[6] + (uint64_t)((int64_t)yd[i + 6] * (int64_t)xd[i + 6]);
    s[7] = s[7] + (uint64_t)((int64_t)yd[i + 7] * (int64_t)xd[i + 7]);
  }
  for (; i < n; i++) s[i & 7] = s[i & 7] + (uint64_t)((int64_t)yd[i] * (int64_t)xd[i]);
  return (int64_t)(((s[0] + s[1]) + (s[2] + s[3])) + ((s[4] + s[5]) + (s[6] + s[7])));
  ```)
;;; i32vec-min -- the smallest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A int32.
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))] (i32vec-min v))   ; => (as int32 1)
;;;
;;; Since: Phase N1

(defn i32vec-min [^borrow v : I32Vec]
  #fx{}
  #reads v
  : int32
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("i32vec-min: empty array");
      return 0;
    }
  const int32_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  int32_t m = d[0];
  for (int64_t i = 1; i < n; i++) m = d[i] < m ? d[i] : m;
  return m;
  #else
  int32_t m[8];
  for (int k = 0; k < 8; k++) m[k] = d[0];
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    m[0] = d[i] < m[0] ? d[i] : m[0];
    m[1] = d[i + 1] < m[1] ? d[i + 1] : m[1];
    m[2] = d[i + 2] < m[2] ? d[i + 2] : m[2];
    m[3] = d[i + 3] < m[3] ? d[i + 3] : m[3];
    m[4] = d[i + 4] < m[4] ? d[i + 4] : m[4];
    m[5] = d[i + 5] < m[5] ? d[i + 5] : m[5];
    m[6] = d[i + 6] < m[6] ? d[i + 6] : m[6];
    m[7] = d[i + 7] < m[7] ? d[i + 7] : m[7];
  }
  for (; i < n; i++) m[i & 7] = d[i] < m[i & 7] ? d[i] : m[i & 7];
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] < m[k] ? m[k + w] : m[k];
  return m[0];
  #endif
  ```)
;;; i32vec-max -- the largest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A int32.
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))] (i32vec-max v))   ; => (as int32 2)
;;;
;;; Since: Phase N1

(defn i32vec-max [^borrow v : I32Vec]
  #fx{}
  #reads v
  : int32
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("i32vec-max: empty array");
      return 0;
    }
  const int32_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  int32_t m = d[0];
  for (int64_t i = 1; i < n; i++) m = d[i] > m ? d[i] : m;
  return m;
  #else
  int32_t m[8];
  for (int k = 0; k < 8; k++) m[k] = d[0];
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    m[0] = d[i] > m[0] ? d[i] : m[0];
    m[1] = d[i + 1] > m[1] ? d[i + 1] : m[1];
    m[2] = d[i + 2] > m[2] ? d[i + 2] : m[2];
    m[3] = d[i + 3] > m[3] ? d[i + 3] : m[3];
    m[4] = d[i + 4] > m[4] ? d[i + 4] : m[4];
    m[5] = d[i + 5] > m[5] ? d[i + 5] : m[5];
    m[6] = d[i + 6] > m[6] ? d[i + 6] : m[6];
    m[7] = d[i + 7] > m[7] ? d[i + 7] : m[7];
  }
  for (; i < n; i++) m[i & 7] = d[i] > m[i & 7] ? d[i] : m[i & 7];
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] > m[k] ? m[k + w] : m[k];
  return m[0];
  #endif
  ```)
;;; i32vec-ref-unchecked -- the element at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  The loop macros
;;; (`-for`, `-fold`, ...) use it where they have already checked the index.
;;; Its body calls nothing, so a call to it carries no panic check, and a
;;; loop of such calls can vectorize.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;
;;; Returns:
;;;   A int32.
;;;
;;; Example:
;;;   (unsafe (i32vec-ref-unchecked v 0))
;;;
;;; Since: Phase N2

(defn i32vec-ref-unchecked [^borrow v : I32Vec i : int]
  #fx{Unsafe}
  #reads v
  : int32
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->data[i];
  ```)
;;; i32vec-set-unchecked! -- store x at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  Stores a number: no
;;; TUR_REGION_NOTE (see the module header).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;   x -- the new element
;;;
;;; Example:
;;;   (unsafe (i32vec-set-unchecked! v 0 (as int32 1)))
;;;
;;; Since: Phase N2

(defn i32vec-set-unchecked! [^borrow v : I32Vec i : int x : int32]
  #fx{Unsafe}
  #writes v
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *a = (void*)(intptr_t)v;
  a->data[i] = x;
  ```)
;;; i32vec-for -- run body once per element of one or two I32Vecs.
;;;
;;; `(for [x v] body...)` binds x to each element of v in order;
;;; `(for [x v y w] body...)` walks v and w together (same length, or a panic
;;; before the first pass).  No index is in scope, so none can be wrong: the
;;; reads are `i32vec-ref-unchecked`, the body sees plain elements, and the loop
;;; carries no bounds check or panic test -- gcc can vectorize it at -O3.  An
;;; array argument that is not a name is evaluated once, and freed after.
;;;
;;; Parameters:
;;;   bindings -- `[x v]` or `[x v y w]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))] (i32vec-for [x v] (println x)))
;;;
;;; Since: Phase N2

(defmacro i32vec-for [bv & body]
  (let [i    (gensym "i")
        n    (gensym "n")
        x    (first bv)
        v    (second bv)
        more (rest (rest bv))]
    (if (list? v)
      (let [t (gensym "nv")] `(let [~t ~v] (i32vec-for [~x ~t ~@more] ~@body)))
      (if (empty? more)
        `(let [^mut ~i 0
               ~n      (i32vec-len ~v)]
           (while (< ~i ~n)
             (let [~x (unsafe (i32vec-ref-unchecked ~v ~i))] ~@body)
             (set! ~i (+ ~i 1))))
        (let [y (first more)
              w (second more)]
          (if (list? w)
            (let [t (gensym "nv")]
              `(let [~t ~w] (i32vec-for [~x ~v ~y ~t] ~@body)))
            `(let [^mut ~i 0
                   ~n      (i32vec-same-len__ ~v ~w)]
               (while (< ~i ~n)
                 (let [~x (unsafe (i32vec-ref-unchecked ~v ~i))
                       ~y (unsafe (i32vec-ref-unchecked ~w ~i))]
                   ~@body)
                 (set! ~i (+ ~i 1))))))))))
;;; i32vec-for-index -- run body once per element, with its index.
;;;
;;; `(for-index [i x v] body...)` binds i (read-only) and x = v[i].
;;;
;;; Parameters:
;;;   bindings -- `[i x v]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))] (i32vec-for-index [i x v] (println i)))
;;;
;;; Since: Phase N2

(defmacro i32vec-for-index [bv & body]
  (let [i  (gensym "i")
        n  (gensym "n")
        iv (first bv)
        x  (second bv)
        v  (first (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (i32vec-for-index [~iv ~x ~t] ~@body)))
      `(let [^mut ~i 0
             ~n      (i32vec-len ~v)]
         (while (< ~i ~n)
           (let [~iv ~i
                 ~x  (unsafe (i32vec-ref-unchecked ~v ~i))]
             ~@body)
           (set! ~i (+ ~i 1)))))))
;;; i32vec-fold -- fold the elements of a I32Vec into an accumulator.
;;;
;;; `(fold [acc init x v] body)`: acc starts at init, and for each element x
;;; in order becomes the value of body (which sees acc and x).  The result is
;;; the final acc.  A float sum written this way is the strict left fold, so
;;; gcc keeps it scalar; `i32vec-sum` is the vectorized one.
;;;
;;; Parameters:
;;;   bindings -- `[acc init x v]`
;;;   body     -- the new accumulator
;;;
;;; Returns:
;;;   The final accumulator.
;;;
;;; Example:
;;;   (let [v (i32vec-of (as int32 1) (as int32 2))] (i32vec-fold [n 0 x v] (+ n 1)))   ; => 2
;;;
;;; Since: Phase N2

(defmacro i32vec-fold [bv body]
  (let [i    (gensym "i")
        n    (gensym "n")
        acc  (first bv)
        init (second bv)
        x    (first (rest (rest bv)))
        v    (second (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (i32vec-fold [~acc ~init ~x ~t] ~body)))
      `(let [^mut ~i   0
             ~n        (i32vec-len ~v)
             ^mut ~acc ~init]
         (while (< ~i ~n)
           (let [~x (unsafe (i32vec-ref-unchecked ~v ~i))] (set! ~acc ~body))
           (set! ~i (+ ~i 1)))
         ~acc))))
;;; i32vec-build -- a fresh I32Vec of n elements, element i the value of expr.
;;;
;;; `(build n [i] expr)`, after Racket's `for/flvector`: i is bound to each
;;; index in turn, and expr runs outside any `unsafe`.
;;;
;;; Parameters:
;;;   n    -- the length (evaluated once)
;;;   i    -- the index name, in a vector
;;;   expr -- the element at i, of type int32
;;;
;;; Returns:
;;;   A fresh I32Vec, owned by the caller.
;;;
;;; Example:
;;;   (let [v (i32vec-build 3 [i] (as int32 1))] (i32vec-len v))   ; => 3
;;;
;;; Since: Phase N2

(defmacro i32vec-build [n bv expr]
  (let [i   (gensym "i")
        m   (gensym "n")
        e   (gensym "e")
        out (gensym "out")
        iv  (first bv)]
    `(let [~m      ~n
           ~out    (i32vec-new ~m (as int32 0))
           ^mut ~i 0]
       (while (< ~i ~m)
         (let [~iv ~i
               ~e  ~expr]
           (unsafe (i32vec-set-unchecked! ~out ~i ~e)))
         (set! ~i (+ ~i 1)))
       ~out)))
;;; i32vec-same-len__ -- internal: the common length of two arrays, or a panic.

(defn i32vec-same-len__ [^borrow a : I32Vec ^borrow b : I32Vec]
  #fx{}
  #reads [a b]
  : int
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *x = (void*)(intptr_t)a;
  struct { int64_t len; int32_t *data; void *raw; } *y = (void*)(intptr_t)b;
  if (x->len != y->len) {
    tur_panic("i32vec-for: length mismatch");
    return 0;
  }
  return x->len;
  ```)
;; ===== U8Vec: bytes =====
;;; U8Vec -- a fixed-length, unboxed array of bytes (uint8).
;;;
;;; Opaque handle to a `struct { int64_t len; uint8_t *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `u8vec-new` or
;;; `u8vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine U8Vec :int)
;; Every operation that touches the header is an inline-C body of its own,
;; never a Turmeric wrapper over a raw one, so a panic is reported at the
;; CALLER's line (as vec-get's is) and turi's natives are keyed by the public
;; names.  An element store writes a number, never a pointer, so the setter
;; carries no TUR_REGION_NOTE (CLAUDE.md, "Region Store Hooks").
;;; u8vec-new -- allocate a U8Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh U8Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (u8vec-new 4 (as uint8 200))]
;;;     (u8vec-ref v 2))   ; => (as uint8 200)
;;;
;;; Since: Phase N0

(defn u8vec-new [n : int init : uint8]
  #fx{}
  : U8Vec
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(uint8_t)) {
    tur_panic("u8vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; uint8_t *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "u8vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(uint8_t) + 32);
  if (!b->raw) { fprintf(stderr, "u8vec-new: out of memory\n"); abort(); }
  b->data = (uint8_t *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = init;
  return (int64_t)(intptr_t)b;
  ```)
;;; u8vec-of -- a U8Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type uint8
;;;
;;; Returns:
;;;   A fresh U8Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))]
;;;     (u8vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro u8vec-of [& xs]
  (let [v (gensym "nv")]
    (list numvec-of__ u8vec-new u8vec-set! (list as uint8 0) v ~@xs)))
;;; u8vec-free -- release a U8Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound U8Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (u8vec-free v)
;;;
;;; Since: Phase N0

(defn u8vec-free [v : U8Vec]
  #fx{}
  : nil
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (a) { free(a->raw); free(a); }
  ```)
;;; Drop [U8Vec] -- free the array when a bound U8Vec dies unmoved.

(definstance Drop [U8Vec] (drop [x] : void (u8vec-free x)))
;;; u8vec-len -- the element count of a U8Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (u8vec-new 8 (as uint8 200))]
;;;     (u8vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn u8vec-len [^borrow v : U8Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; u8vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed uint8.
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))]
;;;     (u8vec-ref v 1))   ; => (as uint8 2)
;;;
;;; Since: Phase N0

(defn u8vec-ref [^borrow v : U8Vec i : int]
  #fx{}
  #reads v
  : uint8
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("u8vec-ref: index out of bounds");
  return 0;
  ```)
;;; u8vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (u8vec-set! v 0 (as uint8 200))
;;;
;;; Since: Phase N0

(defn u8vec-set! [^borrow v : U8Vec i : int x : uint8]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) { a->data[i] = x; return; }
  tur_panic("u8vec-set!: index out of bounds");
  ```)
;;; u8vec-copy -- a fresh U8Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (u8vec-copy v)] (u8vec-set! c 0 (as uint8 200)))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn u8vec-copy [^borrow v : U8Vec]
  #fx{}
  : U8Vec
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  struct { int64_t len; uint8_t *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "u8vec-copy: out of memory\n"); abort(); }
  c->len = a->len;
  c->raw = malloc((size_t)a->len * sizeof(uint8_t) + 32);
  if (!c->raw) { fprintf(stderr, "u8vec-copy: out of memory\n"); abort(); }
  c->data = (uint8_t *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (a->len > 0) memcpy(c->data, a->data, (size_t)a->len * sizeof(uint8_t));
  return (int64_t)(intptr_t)c;
  ```)
;;; u8vec->vec-go__ -- internal: push v[i..n) onto out.

(defn u8vec->vec-go__ [^borrow v : U8Vec out : (Vec uint8) i : int n : int] : (Vec uint8)
  (if (>= i n)
    out
    (do (vec-push! out (u8vec-ref v i)) (u8vec->vec-go__ v out (+ i 1) n))))
;;; u8vec->vec -- copy a U8Vec into a fresh (Vec uint8).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (u8vec-of (as uint8 1) (as uint8 2))
;;;         v (u8vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn u8vec->vec [^borrow v : U8Vec] : (Vec uint8)
  (u8vec->vec-go__ v (:: (vec-new) (Vec uint8)) 0 (u8vec-len v)))
;;; vec->u8vec-go__ -- internal: store src[i..n) into out.

(defn vec->u8vec-go__ [^borrow out : U8Vec
                       ^borrow src : (Vec uint8)
                       i : int
                       n : int] : nil
  (if (>= i n)
    nil
    (do
      (u8vec-set! out i (:: (vec-get src i) uint8))
      (vec->u8vec-go__ out src (+ i 1) n))))
;;; vec->u8vec -- copy a (Vec uint8) into a fresh U8Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A U8Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of (as uint8 1) (as uint8 2))
;;;         a (vec->u8vec v)]
;;;     (u8vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->u8vec [^borrow src : (Vec uint8)] : U8Vec
  (let [out (u8vec-new (vec-len src) (as uint8 0))]
    (vec->u8vec-go__ out src 0 (vec-len src))
    out))
;;; u8vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn u8vec-show-loop__ [^borrow v : U8Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (u8vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (u8vec-show-loop__ v (+ i 1) n b))))
;;; u8vec-show -- render a U8Vec as an owned "#u8vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))]
;;;     (u8vec-show v))   ; => String "#u8vec[1 2]"
;;;
;;; Since: Phase N0

(defn u8vec-show [^borrow v : U8Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#u8vec[")
      (u8vec-show-loop__ v 0 (u8vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; --- N1 bulk kernels, N2 unchecked access and loops (tools/gen-numvec.py) ---
;;; u8vec-fill! -- store x in every slot.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   x -- the value
;;;
;;; Example:
;;;   (u8vec-fill! v (as uint8 1))
;;;
;;; Since: Phase N1

(defn u8vec-fill! [^borrow v : U8Vec x : uint8]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  uint8_t *d = a->data;
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    d[i] = x;
    d[i + 1] = x;
    d[i + 2] = x;
    d[i + 3] = x;
    d[i + 4] = x;
    d[i + 5] = x;
    d[i + 6] = x;
    d[i + 7] = x;
  }
  for (; i < n; i++) d[i] = x;
  ```)
;;; u8vec-copy! -- copy src's elements into dst (same length, or a panic).
;;;
;;; Parameters:
;;;   dst -- the array written (borrowed)
;;;   src -- the array read (borrowed)
;;;
;;; Example:
;;;   (u8vec-copy! dst src)
;;;
;;; Since: Phase N1

(defn u8vec-copy! [^borrow dst : U8Vec ^borrow src : U8Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; uint8_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("u8vec-copy!: length mismatch");
      return;
    }
  if (y->len > 0) memmove(y->data, x->data, (size_t)y->len * sizeof(uint8_t));
  ```)
;;; u8vec-add! -- dst[i] += src[i] for every i (same length, or a panic).
;;;
;;; Integer arithmetic wraps; dst and src may be the same array.
;;;
;;; Parameters:
;;;   dst -- the array updated (borrowed)
;;;   src -- the array added (borrowed)
;;;
;;; Example:
;;;   (u8vec-add! y x)
;;;
;;; Since: Phase N1

(defn u8vec-add! [^borrow dst : U8Vec ^borrow src : U8Vec]
  #fx{}
  #writes dst
  #reads src
  : nil
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *y = (void*)(intptr_t)dst;
  struct { int64_t len; uint8_t *data; void *raw; } *x = (void*)(intptr_t)src;
  if (y->len != x->len) {
      tur_panic("u8vec-add!: length mismatch");
      return;
    }
  int64_t n = y->len;
  uint8_t *yd = y->data;
  const uint8_t *xd = x->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  for (int64_t i = 0; i < n; i++) yd[i] = (uint8_t)((uint8_t)yd[i] + (uint8_t)xd[i]);
  #else
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    uint8_t y0 = yd[i], x0 = xd[i];
    uint8_t y1 = yd[i + 1], x1 = xd[i + 1];
    uint8_t y2 = yd[i + 2], x2 = xd[i + 2];
    uint8_t y3 = yd[i + 3], x3 = xd[i + 3];
    uint8_t y4 = yd[i + 4], x4 = xd[i + 4];
    uint8_t y5 = yd[i + 5], x5 = xd[i + 5];
    uint8_t y6 = yd[i + 6], x6 = xd[i + 6];
    uint8_t y7 = yd[i + 7], x7 = xd[i + 7];
    yd[i] = (uint8_t)((uint8_t)y0 + (uint8_t)x0);
    yd[i + 1] = (uint8_t)((uint8_t)y1 + (uint8_t)x1);
    yd[i + 2] = (uint8_t)((uint8_t)y2 + (uint8_t)x2);
    yd[i + 3] = (uint8_t)((uint8_t)y3 + (uint8_t)x3);
    yd[i + 4] = (uint8_t)((uint8_t)y4 + (uint8_t)x4);
    yd[i + 5] = (uint8_t)((uint8_t)y5 + (uint8_t)x5);
    yd[i + 6] = (uint8_t)((uint8_t)y6 + (uint8_t)x6);
    yd[i + 7] = (uint8_t)((uint8_t)y7 + (uint8_t)x7);
  }
  for (; i < n; i++) yd[i] = (uint8_t)((uint8_t)yd[i] + (uint8_t)xd[i]);
  #endif
  ```)
;;; u8vec-sum -- the sum of the elements.
;;;
;;; A float sum is computed in eight interleaved partial sums (lane k
;;; takes the elements i with i mod 8 = k), combined in one fixed tree:
;;; the same answer on every engine and machine, and vectorizable without
;;; -ffast-math.  It can differ in the last bits from `-sum-ordered`, the
;;; left-to-right sum.  An integer sum wraps modulo 2^64; a narrow element
;;; is widened to `int` first.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))] (u8vec-sum v))
;;;
;;; Since: Phase N1

(defn u8vec-sum [^borrow v : U8Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  const uint8_t *d = a->data;
  uint64_t total = 0;
  int64_t i = 0;
  while (i + 8 <= n) {
    int64_t stop = n - i < ((int64_t)1 << 24) ? n : i + ((int64_t)1 << 24);
    uint32_t s[8] = {0, 0, 0, 0, 0, 0, 0, 0};
    for (; i + 8 <= stop; i += 8) {
      s[0] = s[0] + (uint32_t)d[i];
      s[1] = s[1] + (uint32_t)d[i + 1];
      s[2] = s[2] + (uint32_t)d[i + 2];
      s[3] = s[3] + (uint32_t)d[i + 3];
      s[4] = s[4] + (uint32_t)d[i + 4];
      s[5] = s[5] + (uint32_t)d[i + 5];
      s[6] = s[6] + (uint32_t)d[i + 6];
      s[7] = s[7] + (uint32_t)d[i + 7];
    }
    total = total + ((((uint64_t)s[0] + s[1]) + ((uint64_t)s[2] + s[3]))
                   + (((uint64_t)s[4] + s[5]) + ((uint64_t)s[6] + s[7])));
  }
  for (; i < n; i++) total = total + (uint64_t)d[i];
  return (int64_t)total;
  ```)
;;; u8vec-min -- the smallest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A uint8.
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))] (u8vec-min v))   ; => (as uint8 1)
;;;
;;; Since: Phase N1

(defn u8vec-min [^borrow v : U8Vec]
  #fx{}
  #reads v
  : uint8
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("u8vec-min: empty array");
      return 0;
    }
  const uint8_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  uint8_t m = d[0];
  for (int64_t i = 1; i < n; i++) m = d[i] < m ? d[i] : m;
  return m;
  #else
  uint8_t m[8];
  for (int k = 0; k < 8; k++) m[k] = d[0];
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    m[0] = d[i] < m[0] ? d[i] : m[0];
    m[1] = d[i + 1] < m[1] ? d[i + 1] : m[1];
    m[2] = d[i + 2] < m[2] ? d[i + 2] : m[2];
    m[3] = d[i + 3] < m[3] ? d[i + 3] : m[3];
    m[4] = d[i + 4] < m[4] ? d[i + 4] : m[4];
    m[5] = d[i + 5] < m[5] ? d[i + 5] : m[5];
    m[6] = d[i + 6] < m[6] ? d[i + 6] : m[6];
    m[7] = d[i + 7] < m[7] ? d[i + 7] : m[7];
  }
  for (; i < n; i++) m[i & 7] = d[i] < m[i & 7] ? d[i] : m[i & 7];
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] < m[k] ? m[k + w] : m[k];
  return m[0];
  #endif
  ```)
;;; u8vec-max -- the largest element (an empty array panics).
;;;
;;; A NaN element makes the result NaN (the first NaN, by index).  Which of two equal elements
;;; (0.0 and -0.0) is returned is fixed by the reduction order, the same
;;; on every engine.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A uint8.
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))] (u8vec-max v))   ; => (as uint8 2)
;;;
;;; Since: Phase N1

(defn u8vec-max [^borrow v : U8Vec]
  #fx{}
  #reads v
  : uint8
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  int64_t n = a->len;
  if (n == 0) {
      tur_panic("u8vec-max: empty array");
      return 0;
    }
  const uint8_t *d = a->data;
  /* clang vectorizes the plain loop; gcc -O2 only the written-out body */
  #if defined(__clang__)
  uint8_t m = d[0];
  for (int64_t i = 1; i < n; i++) m = d[i] > m ? d[i] : m;
  return m;
  #else
  uint8_t m[8];
  for (int k = 0; k < 8; k++) m[k] = d[0];
  int64_t i = 0;
  for (; i + 8 <= n; i += 8) {
    m[0] = d[i] > m[0] ? d[i] : m[0];
    m[1] = d[i + 1] > m[1] ? d[i + 1] : m[1];
    m[2] = d[i + 2] > m[2] ? d[i + 2] : m[2];
    m[3] = d[i + 3] > m[3] ? d[i + 3] : m[3];
    m[4] = d[i + 4] > m[4] ? d[i + 4] : m[4];
    m[5] = d[i + 5] > m[5] ? d[i + 5] : m[5];
    m[6] = d[i + 6] > m[6] ? d[i + 6] : m[6];
    m[7] = d[i + 7] > m[7] ? d[i + 7] : m[7];
  }
  for (; i < n; i++) m[i & 7] = d[i] > m[i & 7] ? d[i] : m[i & 7];
  for (int w = 4; w >= 1; w /= 2)
    for (int k = 0; k < w; k++) m[k] = m[k + w] > m[k] ? m[k + w] : m[k];
  return m[0];
  #endif
  ```)
;;; u8vec-ref-unchecked -- the element at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  The loop macros
;;; (`-for`, `-fold`, ...) use it where they have already checked the index.
;;; Its body calls nothing, so a call to it carries no panic check, and a
;;; loop of such calls can vectorize.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;
;;; Returns:
;;;   A uint8.
;;;
;;; Example:
;;;   (unsafe (u8vec-ref-unchecked v 0))
;;;
;;; Since: Phase N2

(defn u8vec-ref-unchecked [^borrow v : U8Vec i : int]
  #fx{Unsafe}
  #reads v
  : uint8
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->data[i];
  ```)
;;; u8vec-set-unchecked! -- store x at index i, NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: call it inside `(unsafe ...)`.  Stores a number: no
;;; TUR_REGION_NOTE (see the module header).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; the caller proves 0 <= i < len
;;;   x -- the new element
;;;
;;; Example:
;;;   (unsafe (u8vec-set-unchecked! v 0 (as uint8 1)))
;;;
;;; Since: Phase N2

(defn u8vec-set-unchecked! [^borrow v : U8Vec i : int x : uint8]
  #fx{Unsafe}
  #writes v
  : nil
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *a = (void*)(intptr_t)v;
  a->data[i] = x;
  ```)
;;; u8vec-for -- run body once per element of one or two U8Vecs.
;;;
;;; `(for [x v] body...)` binds x to each element of v in order;
;;; `(for [x v y w] body...)` walks v and w together (same length, or a panic
;;; before the first pass).  No index is in scope, so none can be wrong: the
;;; reads are `u8vec-ref-unchecked`, the body sees plain elements, and the loop
;;; carries no bounds check or panic test -- gcc can vectorize it at -O3.  An
;;; array argument that is not a name is evaluated once, and freed after.
;;;
;;; Parameters:
;;;   bindings -- `[x v]` or `[x v y w]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))] (u8vec-for [x v] (println x)))
;;;
;;; Since: Phase N2

(defmacro u8vec-for [bv & body]
  (let [i    (gensym "i")
        n    (gensym "n")
        x    (first bv)
        v    (second bv)
        more (rest (rest bv))]
    (if (list? v)
      (let [t (gensym "nv")] `(let [~t ~v] (u8vec-for [~x ~t ~@more] ~@body)))
      (if (empty? more)
        `(let [^mut ~i 0
               ~n      (u8vec-len ~v)]
           (while (< ~i ~n)
             (let [~x (unsafe (u8vec-ref-unchecked ~v ~i))] ~@body)
             (set! ~i (+ ~i 1))))
        (let [y (first more)
              w (second more)]
          (if (list? w)
            (let [t (gensym "nv")]
              `(let [~t ~w] (u8vec-for [~x ~v ~y ~t] ~@body)))
            `(let [^mut ~i 0
                   ~n      (u8vec-same-len__ ~v ~w)]
               (while (< ~i ~n)
                 (let [~x (unsafe (u8vec-ref-unchecked ~v ~i))
                       ~y (unsafe (u8vec-ref-unchecked ~w ~i))]
                   ~@body)
                 (set! ~i (+ ~i 1))))))))))
;;; u8vec-for-index -- run body once per element, with its index.
;;;
;;; `(for-index [i x v] body...)` binds i (read-only) and x = v[i].
;;;
;;; Parameters:
;;;   bindings -- `[i x v]`
;;;   body     -- the forms to run per element
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))] (u8vec-for-index [i x v] (println i)))
;;;
;;; Since: Phase N2

(defmacro u8vec-for-index [bv & body]
  (let [i  (gensym "i")
        n  (gensym "n")
        iv (first bv)
        x  (second bv)
        v  (first (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (u8vec-for-index [~iv ~x ~t] ~@body)))
      `(let [^mut ~i 0
             ~n      (u8vec-len ~v)]
         (while (< ~i ~n)
           (let [~iv ~i
                 ~x  (unsafe (u8vec-ref-unchecked ~v ~i))]
             ~@body)
           (set! ~i (+ ~i 1)))))))
;;; u8vec-fold -- fold the elements of a U8Vec into an accumulator.
;;;
;;; `(fold [acc init x v] body)`: acc starts at init, and for each element x
;;; in order becomes the value of body (which sees acc and x).  The result is
;;; the final acc.  A float sum written this way is the strict left fold, so
;;; gcc keeps it scalar; `u8vec-sum` is the vectorized one.
;;;
;;; Parameters:
;;;   bindings -- `[acc init x v]`
;;;   body     -- the new accumulator
;;;
;;; Returns:
;;;   The final accumulator.
;;;
;;; Example:
;;;   (let [v (u8vec-of (as uint8 1) (as uint8 2))] (u8vec-fold [n 0 x v] (+ n 1)))   ; => 2
;;;
;;; Since: Phase N2

(defmacro u8vec-fold [bv body]
  (let [i    (gensym "i")
        n    (gensym "n")
        acc  (first bv)
        init (second bv)
        x    (first (rest (rest bv)))
        v    (second (rest (rest bv)))]
    (if (list? v)
      (let [t (gensym "nv")]
        `(let [~t ~v] (u8vec-fold [~acc ~init ~x ~t] ~body)))
      `(let [^mut ~i   0
             ~n        (u8vec-len ~v)
             ^mut ~acc ~init]
         (while (< ~i ~n)
           (let [~x (unsafe (u8vec-ref-unchecked ~v ~i))] (set! ~acc ~body))
           (set! ~i (+ ~i 1)))
         ~acc))))
;;; u8vec-build -- a fresh U8Vec of n elements, element i the value of expr.
;;;
;;; `(build n [i] expr)`, after Racket's `for/flvector`: i is bound to each
;;; index in turn, and expr runs outside any `unsafe`.
;;;
;;; Parameters:
;;;   n    -- the length (evaluated once)
;;;   i    -- the index name, in a vector
;;;   expr -- the element at i, of type uint8
;;;
;;; Returns:
;;;   A fresh U8Vec, owned by the caller.
;;;
;;; Example:
;;;   (let [v (u8vec-build 3 [i] (as uint8 1))] (u8vec-len v))   ; => 3
;;;
;;; Since: Phase N2

(defmacro u8vec-build [n bv expr]
  (let [i   (gensym "i")
        m   (gensym "n")
        e   (gensym "e")
        out (gensym "out")
        iv  (first bv)]
    `(let [~m      ~n
           ~out    (u8vec-new ~m (as uint8 0))
           ^mut ~i 0]
       (while (< ~i ~m)
         (let [~iv ~i
               ~e  ~expr]
           (unsafe (u8vec-set-unchecked! ~out ~i ~e)))
         (set! ~i (+ ~i 1)))
       ~out)))
;;; u8vec-same-len__ -- internal: the common length of two arrays, or a panic.

(defn u8vec-same-len__ [^borrow a : U8Vec ^borrow b : U8Vec]
  #fx{}
  #reads [a b]
  : int
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *x = (void*)(intptr_t)a;
  struct { int64_t len; uint8_t *data; void *raw; } *y = (void*)(intptr_t)b;
  if (x->len != y->len) {
    tur_panic("u8vec-for: length mismatch");
    return 0;
  }
  return x->len;
  ```)
