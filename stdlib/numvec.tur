;;; tur/numvec -- typed numeric arrays: F64Vec, F32Vec, I64Vec, I32Vec, U8Vec.
;;;
;;; GENERATED by tools/gen-numvec.py -- edit the template there, not this file.
;;;
;;; A fixed-length, homogeneous, unboxed array of one numeric element type, in
;;; the manner of Racket's `flvector`.  Each type is its own opaque handle over
;;; one C layout:
;;;
;;; ```c
;;; struct { int64_t len; T *data; void *raw; }   /* T = double, float, ... */
;;; ```
;;;
;;; `data` is 32-byte aligned (`raw` is the malloc block it was carved from,
;;; and what `free` is given), so an aligned SIMD load is legal on it and gcc
;;; can skip its peeling prologue.  The element is its real width: a `U8Vec`
;;; uses one byte a slot, not eight as a `Vec` does.
;;;
;;; | Type   | Element   | Constructor               |
;;; |--------|-----------|---------------------------|
;;; | F64Vec | `float`   | `(f64vec-new n init)`     |
;;; | F32Vec | `float32` | `(f32vec-new n init)`     |
;;; | I64Vec | `int`     | `(i64vec-new n init)`     |
;;; | I32Vec | `int32`   | `(i32vec-new n init)`     |
;;; | U8Vec  | `uint8`   | `(u8vec-new n init)`      |
;;;
;;; Every type has the same nine operations, named by its prefix `P` (`f64vec`,
;;; `f32vec`, `i64vec`, `i32vec`, `u8vec`):
;;; `P-new`, `P-of`, `P-len`, `P-ref`, `P-set!`, `P-copy`, `P->vec`,
;;; `vec->P`, `P-show`.
;;;
;;; Ownership: each type is `^affine` with a `Drop` instance, so a let-bound
;;; array is freed at scope exit, exactly once, and moving it (returning it,
;;; passing it to a consumer) hands that duty on.  The accessors take it
;;; `^borrow`.  `P-free` consumes an array early.
;;;
;;; Bind an array before passing it on.  A temporary handed straight to an
;;; accessor -- `(f64vec-len (f64vec-new 4 0.0))` -- is never bound, so no scope
;;; frees it: write `(let [v (f64vec-new 4 0.0)] (f64vec-len v))`.
;;;
;;; Length is fixed at construction.  Growth stays `Vec`'s job; `P->vec` and
;;; `vec->P` convert.  An index outside `[0, len)` panics, at the caller's
;;; line, on every engine.
;;;
;;; Region stores: an element store writes a number, never a pointer, so the
;;; setters carry no TUR_REGION_NOTE (CLAUDE.md, "Region Store Hooks" covers a
;;; caller's word that can outlive a bracket -- a pointer).
;;;
;;; Since: Phase N0 (simd-and-vectorization-plan)
(load "stdlib/typeclass.tur")

;;; numvec-count__ -- internal: the number of arguments, as a `+` chain.

(defmacro numvec-count__ [& xs]
  (if (empty? xs)
    0
    (list + 1 (list numvec-count__ ~@(rest xs)))))
;;; numvec-fill__ -- internal: store xs at i, i+1, ... with `setter`, yield v.

(defmacro numvec-fill__ [setter v i & xs]
  (if (empty? xs)
    v
    (list do
      (list setter v i (first xs))
      (list numvec-fill__ setter v (list + i 1) ~@(rest xs)))))
;; ===== F64Vec: 64-bit floats =====
;;; F64Vec -- a fixed-length, unboxed array of 64-bit floats (float).
;;;
;;; Opaque handle to a `struct { int64_t len; double *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `f64vec-new` or
;;; `f64vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine F64Vec :int)
;; --- raw layer (private): allocation.  turi has native twins. ---

(defn __f64vec-new-raw [n : int init : float]
  #fx{Unsafe}
  : int
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(double)) {
    tur_panic("f64vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; double *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "f64vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(double) + 32);
  if (!b->raw) { fprintf(stderr, "f64vec-new: out of memory\n"); abort(); }
  b->data = (double *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = (double)init;
  return (int64_t)(intptr_t)b;
  ```)

(defn __f64vec-free-raw [b : int]
  #fx{Unsafe}
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *v = (void*)(intptr_t)b;
  if (v) { free(v->raw); free(v); }
  ```)

(defn __f64vec-copy-raw [b : int]
  #fx{Unsafe}
  : int
  ```c
  struct { int64_t len; double *data; void *raw; } *v = (void*)(intptr_t)b;
  struct { int64_t len; double *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "f64vec-copy: out of memory\n"); abort(); }
  c->len = v->len;
  c->raw = malloc((size_t)v->len * sizeof(double) + 32);
  if (!c->raw) { fprintf(stderr, "f64vec-copy: out of memory\n"); abort(); }
  c->data = (double *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (v->len > 0) memcpy(c->data, v->data, (size_t)v->len * sizeof(double));
  return (int64_t)(intptr_t)c;
  ```)
;; --- public surface.  len / ref / set! are inline-C themselves, not wrappers
;; over a raw body, so a panic is reported at the CALLER's line (as vec-get's
;; is) and so turi's natives are keyed by the public names. ---
;;; f64vec-new -- allocate a F64Vec of n elements, every one init.
;;;
;;; Parameters:
;;;   n    -- element count (>= 0; a negative or absurd n panics)
;;;   init -- the value every slot starts with
;;;
;;; Returns:
;;;   A fresh F64Vec, owned by the caller and freed at scope exit.
;;;
;;; Example:
;;;   (let [v (f64vec-new 4 7.1)]
;;;     (f64vec-ref v 2))   ; => 7.1
;;;
;;; Since: Phase N0

(defn f64vec-new [n : int init : float] : F64Vec
  (:: (unsafe (__f64vec-new-raw n init)) :F64Vec))
;;; f64vec-id__ -- internal: hand the array straight back.
;;;
;;; `f64vec-of` wraps its `let` in this so the binding that receives the result is
;;; seen to be initialised by a call, and owns it: a `let` that yields a moved
;;; local is read as "moved during init", and the scope-exit Drop is skipped.

(defn f64vec-id__ [v : F64Vec] : F64Vec v)
;;; f64vec-of -- a F64Vec holding the given elements, in order.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of type float
;;;
;;; Returns:
;;;   A fresh F64Vec of length (count xs).
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)]
;;;     (f64vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defmacro f64vec-of [& xs]
  (list f64vec-id__
        (list let `[__nv (f64vec-new (numvec-count__ ~@xs) 0.0)]
          (list numvec-fill__ f64vec-set! __nv 0 ~@xs))))
;;; f64vec-free -- release a F64Vec now, consuming it.
;;;
;;; Rarely needed: a let-bound F64Vec is freed at scope exit.  Call it to
;;; release a large array before the scope ends.
;;;
;;; Parameters:
;;;   v -- the array (consumed)
;;;
;;; Example:
;;;   (f64vec-free v)
;;;
;;; Since: Phase N0

(defn f64vec-free [v : F64Vec] : nil
  (unsafe (__f64vec-free-raw (:: v :int))))
;;; Drop [F64Vec] -- free the array when a bound F64Vec dies unmoved.

(definstance Drop [F64Vec] (drop [x] : void (f64vec-free x)))
;;; f64vec-len -- the element count of a F64Vec.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   The length fixed at construction.
;;;
;;; Example:
;;;   (let [v (f64vec-new 8 7.1)]
;;;     (f64vec-len v))   ; => 8
;;;
;;; Since: Phase N0

(defn f64vec-len [^borrow v : F64Vec]
  #fx{}
  #reads v
  : int
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  return a->len;
  ```)
;;; f64vec-ref -- the element at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;
;;; Returns:
;;;   The element, typed float.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)]
;;;     (f64vec-ref v 1))   ; => 2.5
;;;
;;; Since: Phase N0

(defn f64vec-ref [^borrow v : F64Vec i : int]
  #fx{}
  #reads v
  : float
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  if (i >= 0 && i < a->len) return a->data[i];
  tur_panic("f64vec-ref: index out of bounds");
  return 0;
  ```)
;;; f64vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (f64vec-set! v 0 7.1)
;;;
;;; Since: Phase N0

;;; f64vec-set! -- store x at index i (bounds-checked).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;   i -- zero-based index; outside [0, len) panics
;;;   x -- the new element
;;;
;;; Example:
;;;   (f64vec-set! v 0 7.1)
;;;
;;; Since: Phase N0

(defn f64vec-set! [^borrow v : F64Vec i : int x : float]
  #fx{}
  #writes v
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *a = (void*)(intptr_t)v;
  /* a number, never a pointer: no TUR_REGION_NOTE (Region Store Hooks). */
  if (i >= 0 && i < a->len) { a->data[i] = x; return; }
  tur_panic("f64vec-set!: index out of bounds");
  ```)
;;; f64vec-copy -- a fresh F64Vec with the same elements.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An independent copy, owned by the caller.
;;;
;;; Example:
;;;   (let [c (f64vec-copy v)] (f64vec-set! c 0 7.1))   ; v is unchanged
;;;
;;; Since: Phase N0

(defn f64vec-copy [^borrow v : F64Vec] : F64Vec
  (:: (unsafe (__f64vec-copy-raw (:: v :int))) :F64Vec))
;;; f64vec->vec-go__ -- internal: push v[i..n) onto out.

(defn f64vec->vec-go__ [^borrow v : F64Vec out : (Vec float) i : int n : int] : (Vec float)
  (if (>= i n)
    out
    (do
      (vec-push! out (f64vec-ref v i))
      (f64vec->vec-go__ v out {i + 1} n))))
;;; f64vec->vec -- copy a F64Vec into a fresh (Vec float).
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   A growable Vec holding the same elements; the caller frees it.
;;;
;;; Example:
;;;   (let [a (f64vec-of 1.5 2.5)
;;;         v (f64vec->vec a)]
;;;     (vec-len v))   ; => 2
;;;
;;; Since: Phase N0

(defn f64vec->vec [^borrow v : F64Vec] : (Vec float)
  (f64vec->vec-go__ v (:: (vec-new) (Vec float)) 0 (f64vec-len v)))
;;; vec->f64vec-go__ -- internal: store src[i..n) into out.

(defn vec->f64vec-go__ [^borrow out : F64Vec ^borrow src : (Vec float) i : int n : int] : nil
  (if (>= i n)
    nil
    (do
      (f64vec-set! out i (:: (vec-get src i) float))
      (vec->f64vec-go__ out src {i + 1} n))))
;;; vec->f64vec -- copy a (Vec float) into a fresh F64Vec.
;;;
;;; Parameters:
;;;   src -- the Vec (borrowed)
;;;
;;; Returns:
;;;   A F64Vec of the same length and elements, owned by the caller.
;;;
;;; Example:
;;;   (let [v (vec-of 1.5 2.5)
;;;         a (vec->f64vec v)]
;;;     (f64vec-len a))   ; => 2
;;;
;;; Since: Phase N0

(defn vec->f64vec [^borrow src : (Vec float)] : F64Vec
  (let [out (f64vec-new (vec-len src) 0.0)]
    (vec->f64vec-go__ out src 0 (vec-len src))
    out))
;;; f64vec-show-loop__ -- internal: push "e0 e1 ..." onto the builder.

(defn f64vec-show-loop__ [^borrow v : F64Vec i : int n : int b : StringBuilder] : StringBuilder
  (if (= i n)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (f64vec-ref v i))]
        (do (builder/push-string! b es) (string/release es)))
      (f64vec-show-loop__ v {i + 1} n b))))
;;; f64vec-show -- render a F64Vec as an owned "#f64vec[a b c]" String.
;;;
;;; Parameters:
;;;   v -- the array (borrowed)
;;;
;;; Returns:
;;;   An owned String; release it with string/release.
;;;
;;; Example:
;;;   (let [v (f64vec-of 1.5 2.5)]
;;;     (f64vec-show v))   ; => String "#f64vec[1.5 2.5]"
;;;
;;; Since: Phase N0

(defn f64vec-show [^borrow v : F64Vec] : String
  (let [b (builder/new)]
    (do
      (builder/push-cstr! b "#f64vec[")
      (f64vec-show-loop__ v 0 (f64vec-len v) b)
      (builder/push-cstr! b "]")
      (builder/finish b))))
;; ===== F32Vec: 32-bit floats =====
;;; F32Vec -- a fixed-length, unboxed array of 32-bit floats (float32).
;;;
;;; Opaque handle to a `struct { int64_t len; float *data; void *raw; }`.
;;; `^affine`: freed at scope exit by its `Drop` instance.  Use `f32vec-new` or
;;; `f32vec-of` to make one.
;;;
;;; Since: Phase N0
(defopaque ^affine F32Vec :int)
;; --- raw layer (private): allocation.  turi has native twins. ---

(defn __f32vec-new-raw [n : int init : float]
  #fx{Unsafe}
  : int
  ```c
  /* the data block is 32-byte aligned; n * sizeof wrapped for a huge n would
     leave a tiny block under a huge recorded len, so the bound is explicit. */
  if (n < 0 || (uint64_t)n > (SIZE_MAX - 64) / sizeof(float)) {
    tur_panic("f32vec-new: length out of range");
    return 0;
  }
  struct { int64_t len; float *data; void *raw; } *b = malloc(sizeof(*b));
  if (!b) { fprintf(stderr, "f32vec-new: out of memory\n"); abort(); }
  b->len = n;
  b->raw = malloc((size_t)n * sizeof(float) + 32);
  if (!b->raw) { fprintf(stderr, "f32vec-new: out of memory\n"); abort(); }
  b->data = (float *)(((uintptr_t)b->raw + 31) & ~(uintptr_t)31);
  for (int64_t i = 0; i < n; i++) b->data[i] = (float)init;
  return (int64_t)(intptr_t)b;
  ```)

(defn __f32vec-free-raw [b : int]
  #fx{Unsafe}
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *v = (void*)(intptr_t)b;
  if (v) { free(v->raw); free(v); }
  ```)

(defn __f32vec-copy-raw [b : int]
  #fx{Unsafe}
  : int
  ```c
  struct { int64_t len; float *data; void *raw; } *v = (void*)(intptr_t)b;
  struct { int64_t len; float *data; void *raw; } *c = malloc(sizeof(*c));
  if (!c) { fprintf(stderr, "f32vec-copy: out of memory\n"); abort(); }
  c->len = v->len;
  c->raw = malloc((size_t)v->len * sizeof(float) + 32);
  if (!c->raw) { fprintf(stderr, "f32vec-copy: out of memory\n"); abort(); }
  c->data = (float *)(((uintptr_t)c->raw + 31) & ~(uintptr_t)31);
  if (v->len > 0) memcpy(c->data, v->data, (size_t)v->len * sizeof(float));
  return (int64_t)(intptr_t)c;
