;;; tur/mutex -- POSIX mutex (pthread_mutex_t) wrapped as ptr<void>.
;;;
;;; Suitable for single-threaded and multi-threaded programs.
;;;
;;; Since: Phase T19-C
;; stdlib/mutex.tur -- POSIX mutex (Phase T19-C)
;;
;; Wraps pthread_mutex_t as a :ptr<void>.  Suitable for single-threaded and
;; multi-threaded use (default PTHREAD_MUTEX_DEFAULT attributes).
;;
;; API:
;;   mutex-new          []                    -- Mutex
;;   mutex-lock         [^borrow m :Mutex]    -- nil
;;   mutex-unlock       [^borrow m :Mutex]    -- nil
;;   mutex-try-lock     [^borrow m :Mutex]    -- bool   (true = acquired)
;;   mutex-free         [m :Mutex]            -- nil    (consumes the handle)
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 2) ----
;; Mutex wraps the underlying :ptr<void> with a nominally distinct type so the
;; checker rejects passing an unrelated handle (a CondVar, an RwLock, a channel)
;; where a Mutex is expected. It lowers to :ptr<void> in the C ABI, so the
;; inline-C bodies are unchanged.
;;
;; ---- Linearity (stdlib-linearity-affinity-plan, L1) ----
;; Mutex is :linear: it owns a heap-allocated pthread_mutex_t that must be
;; destroyed exactly once with mutex-free. Under -Xlinear the checker rejects
;; dropping a Mutex (TUR-E0100) or freeing it twice (TUR-E0101). The multi-use
;; accessors mutex-lock / mutex-unlock / mutex-try-lock declare their handle
;; parameter ^borrow, so locking and unlocking repeatedly reads the handle
;; without consuming it; only mutex-free consumes. Locking a freed Mutex is a
;; TUR-E0101. See docs/archive/history/stdlib-linear-handle-borrows.md.
(defopaque ^linear Mutex :ptr<void>)
;;; mutex-new -- allocate and initialise a new POSIX mutex.
;;;
;;; Returns:
;;;   A Mutex handle to a heap-allocated pthread_mutex_t.
;;;
;;; Example:
;;;   (let [m (mutex-new)] ...)  ; => Mutex
;;;
;;; Since: Phase T19-C

(defn mutex-new [] : Mutex
  ```c
  pthread_mutex_t *m = (pthread_mutex_t *)malloc(sizeof(pthread_mutex_t));
  if (!m) { fprintf(stderr, "mutex-new: out of memory\n"); abort(); }
  pthread_mutex_init(m, NULL);
  return (void *)(intptr_t)m;
  ```)
;;; mutex-lock -- acquire the mutex, blocking until it is available.
;;;
;;; Parameters:
;;;   m -- mutex handle returned by mutex-new
;;;
;;; Example:
;;;   (mutex-lock m)
;;;
;;; Since: Phase T19-C

(defn mutex-lock [^borrow m : Mutex] : nil
  ```c
  pthread_mutex_lock((pthread_mutex_t *)m);
  ```)
;;; mutex-unlock -- release the mutex.
;;;
;;; Parameters:
;;;   m -- mutex handle returned by mutex-new
;;;
;;; Example:
;;;   (mutex-unlock m)
;;;
;;; Since: Phase T19-C

(defn mutex-unlock [^borrow m : Mutex] : nil
  ```c
  pthread_mutex_unlock((pthread_mutex_t *)m);
  ```)
;;; mutex-try-lock -- attempt to acquire the mutex without blocking.
;;;
;;; Parameters:
;;;   m -- mutex handle returned by mutex-new
;;;
;;; Returns:
;;;   true if the mutex was successfully acquired; false if it was already held.
;;;
;;; Example:
;;;   (if (mutex-try-lock m) ...)  ; => bool
;;;
;;; Since: Phase T19-C

(defn mutex-try-lock [^borrow m : Mutex] : bool
  ```c
  return pthread_mutex_trylock((pthread_mutex_t *)m) == 0;
  ```)
;;; mutex-free -- destroy the mutex and release its memory.
;;;
;;; Parameters:
;;;   m -- mutex handle returned by mutex-new
;;;
;;; Example:
;;;   (mutex-free m)
;;;
;;; Since: Phase T19-C

(defn mutex-free [m : Mutex] : nil
  ```c
  pthread_mutex_destroy((pthread_mutex_t *)m);
  free((void*)(intptr_t)m);
  ```)
;;; with-lock -- run body with the mutex held, releasing it afterwards.
;;;
;;; The scoped counterpart to the raw `mutex-lock` / `mutex-unlock` pair: the
;;; body's value is the form's value, and the unlock cannot be forgotten on the
;;; way out. Replaces the hand-written
;;; `(mutex-lock m) ... (mutex-unlock m)` sandwich, where the release drifts
;;; away from the acquire as the body grows and an early return skips it.
;;;
;;; Parameters:
;;;   m    -- a Mutex handle (borrowed; with-lock does not consume or free it)
;;;   body -- one or more forms; the last one's value is returned
;;;
;;; Returns:
;;;   The value of the last body form.
;;;
;;; Example:
;;;   (let [m (mutex-new)]
;;;     (println (with-lock m (+ 1 41)))   ; => 42
;;;     (mutex-free m))
;;;
;;; Two caveats worth knowing:
;;;
;;; `m` is evaluated twice -- once to lock, once to unlock -- so pass a
;;; VARIABLE, not a call. `(with-lock (get-mutex) ...)` would lock one mutex
;;; and unlock whatever the second call returns. A macro cannot bind it once
;;; instead, because `Mutex` is `:linear`: a `let` binding moves the handle,
;;; and the checker then rejects the scope for dropping it unconsumed
;;; (TUR-E0100).
;;;
;;; The unlock is not panic-safe. If the body panics, the mutex stays locked.
;;; Guarding against that needs the unlock on an unwind path, which
;;; `catch-unwind` can express at the call site when it matters.
;;;
;;; Since: 2026-08-20
(defmacro with-lock [m & body]
  (do
    (mutex-lock m)
    (let [__wl-result (do ~@body)] (mutex-unlock m) __wl-result)))
