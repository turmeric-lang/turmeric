;;; tur/httpd -- Lightweight HTTP/1.0 and HTTP/1.1 server.
;;;
;;; Single-process HTTP server. The listener thread runs a tur/reactor
;;; loop that watches the listen socket for READ events; each accepted
;;; connection is dispatched (via a shared queue) to a worker thread that
;;; reads the request, invokes the handler, and writes the response.
;;; HTTP/1.1 keep-alive is supported: a worker loops on the same socket
;;; until the client requests Connection: close or a read timeout fires.
;;;
;;; Handler calling convention: the server dispatches a handler through the
;;; fat-closure protocol (read slot 0 as the thunk, pass the record itself
;;; as the env). The closure-entry parameters that take a handler, verifier,
;;; or middleware `next` are annotated `^fat`, so a bare *non-capturing* fn
;;; is auto-shimmed into a fat closure at the call site -- you no longer have
;;; to capture a dummy variable to force heap allocation. Inside the handler,
;;; use httpd-req-* to read the parsed request and httpd-resp-*! to set the
;;; response.
;;;
;;; Since: Phase H1
;; stdlib/httpd.tur -- Lightweight HTTP server (Phase H1-H7)
;;
;; H1: TCP listener + blocking thread-per-connection.
;; H2: Reactor-backed listener (replaces the blocking accept loop).
;; H3: Fixed worker pool serving a shared Mutex<Queue<fd>> instead of
;;     spawning one OS thread per connection.
;; H4: HTTP/1.1 persistent connections (keep-alive) and Content-Length
;;     request body parsing.
;; H5-H7: see docs/tur-httpd-plan.md.
;;
;; HttpdBlock layout:
;;   { int listen_fd; int64_t handler;
;;     void *reactor;          // listener reactor
;;     int   listen_src_id;
;;     void *accept_clos;      // synthetic fat closure { __fn, hb }
;;     // worker pool
;;     pthread_t *workers;
;;     int n_workers;
;;     // shared fd queue
;;     int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
;;     int fdq_closed;
;;     pthread_mutex_t fdq_mtx;
;;     pthread_cond_t  fdq_cv;
;;     volatile int stop_flag; }
;;
;; HttpdConn layout (per-request, lives on the worker's stack):
;;   { int fd; int64_t handler;
;;     char method[16]; char path[1024]; char version[16];
;;     char *body; int body_len;
;;     int resp_status; char *resp_body; int resp_body_len;
;;     int client_keep_alive;
;;     void *route_params;   // RouteParam linked list (H6) }
;;
;; API:
;;   httpd-new          [port :int handler :int]         -- ptr<void>
;;   httpd-new-pool     [port :int workers :int h :int]  -- ptr<void>
;;   httpd-port         [h :ptr<void>]                   -- int
;;   httpd-run          [h :ptr<void>]                   -- nil
;;   httpd-stop         [h :ptr<void>]                   -- nil
;;   httpd-free         [h :ptr<void>]                   -- nil
;;   httpd-req-method   [conn :ptr<void>]                -- cstr
;;   httpd-req-path     [conn :ptr<void>]                -- cstr
;;   httpd-req-version  [conn :ptr<void>]                -- cstr
;;   httpd-req-body     [conn :ptr<void>]                -- cstr
;;   httpd-req-body-len [conn :ptr<void>]                -- int
;;   httpd-resp-status! [conn :ptr<void> status :int]    -- nil
;;   httpd-resp-body!   [conn :ptr<void> body :cstr]     -- nil
;; M3 body parsers (JSON) reuse stdlib/json's parser/free, so pull it in.
(load "stdlib/json.tur")
;; mw-cors owns its config strings as Drop-typeclass String captures so the
;; closure drop-glue releases them (Model R); needs the String API.

(load "stdlib/string.tur")

(load "stdlib/effects.tur")
;; stdlib-effect-rows: the httpd server constructors (which bind+listen) and
;; the run/stop lifecycle functions carry the #{Net} capability tag.  The
;; in-memory request/response accessors and middleware helpers operate on the
;; connection struct only and stay untagged.
;;; httpd/autolink-hint -- ensure programs using httpd link against libturi + pthreads.
;;; Also hoists the file-scope httpd_tls_ops struct and instance used by the H5
;;; TLS hook registry (see httpd-register-tls-impl and httpd-new-tls).

(defn httpd/autolink-hint [] : int
  ```c
  /* __tur_autolink__: -lturi -pthread */
  /* __tur_include__: #include <stdint.h> */
  /* __tur_include__: #include <string.h> */
  /* __tur_include__: #include <strings.h> */
  /* __tur_include__: typedef struct { long long wrap_fd; long long handshake; long long read_fn; long long write_fn; long long shutdown; long long free_fn; } httpd_tls_ops_t; */
  /* __tur_include__: static httpd_tls_ops_t httpd_tls_ops = {0,0,0,0,0,0}; */
  /* __tur_include__: static int64_t httpd_max_body = 8388608; */
  /* __tur_include__: static int httpd_bind_any = 0; */
  /* __tur_include__: static char httpd_bind_addr_s[64] = {0}; */
  /* __tur_include__: typedef struct __HttpdHeader { char *name; char *value; struct __HttpdHeader *next; } HttpdHeader; */
  /* __tur_include__: typedef struct __HttpdAttr { char *key; char *value; struct __HttpdAttr *next; } HttpdAttr; */
  /* __tur_include__: typedef struct __HttpdOwnedStr { char *s; struct __HttpdOwnedStr *next; } HttpdOwnedStr; */
  /* __tur_include__: typedef struct { int fd; int64_t handler; char method[16]; char path[1024]; char version[16]; char *body; int body_len; int resp_status; char *resp_body; int resp_body_len; int client_keep_alive; void *route_params; int64_t tls; void *req_headers; void *resp_headers; int64_t req_json_cache; void *req_multipart_parts; void *fiber_group; void *attr_list; void *owned_cstrs; } HttpdConn; */
  /* __tur_include__: static const char *httpd_mp_find(const char *h, const char *e, const char *n, size_t nl) { if (!h || !e || nl == 0) return 0; for (; h + nl <= e; h++) if (memcmp(h, n, nl) == 0) return h; return 0; } */
  /* __tur_include__: static int httpd_hdr_param(const char *v, const char *ve, const char *key, char *out, int cap) { size_t kl = strlen(key); const char *q = (const char *)memchr(v, ';', (size_t)(ve - v)); while (q && q < ve) { q++; while (q < ve && (*q == ' ' || *q == '\t')) q++; const char *ks = q; while (q < ve && *q != '=' && *q != ';') q++; const char *ke = q; while (ke > ks && (ke[-1] == ' ' || ke[-1] == '\t')) ke--; if (q >= ve || *q == ';') continue; q++; while (q < ve && (*q == ' ' || *q == '\t')) q++; int hit = (size_t)(ke - ks) == kl && strncasecmp(ks, key, kl) == 0; int n = 0; if (q < ve && *q == '"') { q++; while (q < ve && *q != '"') { if (*q == '\\' && q + 1 < ve) q++; if (hit && n + 1 < cap) out[n++] = *q; q++; } if (q < ve) q++; } else { while (q < ve && *q != ';' && *q != ' ' && *q != '\t') { if (hit && n + 1 < cap) out[n++] = *q; q++; } } if (hit) { out[n] = '\0'; return n; } q = (const char *)memchr(q, ';', (size_t)(ve - q)); } return -1; } */
  /* __tur_include__: static char *httpd_conn_own_cstr(HttpdConn *c, char *s) { if (!c || !s) return s; HttpdOwnedStr *n = (HttpdOwnedStr *)malloc(sizeof(HttpdOwnedStr)); if (!n) return s; n->s = s; n->next = (HttpdOwnedStr *)c->owned_cstrs; c->owned_cstrs = n; return s; } */
  return 0;
  ```)
;;; httpd-register-tls-impl -- install TLS function pointers into the H5 hook table.
;;;
;;; Called once by user code after importing tur/tls (the spice provides a
;;; one-liner helper that captures these pointers and forwards them here).
;;; Without this call, httpd-new-tls fails cleanly because the function
;;; pointer table is all zeros.
;;;
;;; Parameters:
;;;   wrap-fd   -- (int64_t)(intptr_t)&tls-wrap-fd
;;;   handshake -- (int64_t)(intptr_t)&tls-handshake
;;;   read-fn   -- (int64_t)(intptr_t)&tls-read
;;;   write-fn  -- (int64_t)(intptr_t)&tls-write
;;;   shutdown  -- (int64_t)(intptr_t)&tls-shutdown
;;;   free-fn   -- (int64_t)(intptr_t)&tls-free
;;;
;;; Since: Phase H5

(defn httpd-register-tls-impl [wrap-fd : int
                               handshake : int
                               read-fn : int
                               write-fn : int
                               shutdown : int
                               free-fn : int] : nil
  ```c
  httpd_tls_ops.wrap_fd   = (int64_t)wrap_fd;
  httpd_tls_ops.handshake = (int64_t)handshake;
  httpd_tls_ops.read_fn   = (int64_t)read_fn;
  httpd_tls_ops.write_fn  = (int64_t)write_fn;
  httpd_tls_ops.shutdown  = (int64_t)shutdown;
  httpd_tls_ops.free_fn   = (int64_t)free_fn;
  ```)
;; ---- libturi reactor C surface ----


(extern-c tur_reactor_new [] :ptr)

(extern-c tur_reactor_free [r :ptr] :void)

(extern-c tur_reactor_add_fd
  [r :ptr fd :int events :int cb :int user-data :ptr]
  :int)

(extern-c tur_reactor_remove [r :ptr id :int] :int)

(extern-c tur_reactor_disown_cb [r :ptr id :int] :void)

(extern-c tur_reactor_linger_close [r :ptr fd :int timeout-ms :int] :int)

(extern-c tur_reactor_run [r :ptr] :void)

(extern-c tur_reactor_stop [r :ptr] :void)

(extern-c tur_reactor_wake [r :ptr] :void)

(extern-c tur_local_fiber_group_new [r :ptr] :ptr)

(extern-c tur_local_fiber_group_free [g :ptr] :void)

(extern-c tur_local_spawn [g :ptr body :int user-data :ptr] :int)

(extern-c tur_local_disown_body [g :ptr fiber-id :int] :void)

(extern-c tur_local_park_fd [g :ptr fd :int events :int timeout-ms :int] :int)

(extern-c tur_reactor_run_fibers [g :ptr] :int)
;; ---------------------------------------------------------------------------
;; Request-head parsing, response-head building and per-request cleanup,
;; shared by the blocking pool (httpd-handle) and the async server
;; (httpd-async-fiber-body).  Each used to carry its own copy, and the copies
;; had already drifted (the async cleanup leaked multipart parts and
;; attributes; the blocking status table had no 401).  One copy is also what
;; tests/fuzz drives: httpd-parse-head takes bytes, not a socket.
;; See docs/upcoming/security-audit-plan.md (M-4).
;; ---------------------------------------------------------------------------
;;; httpd-set-max-body! -- cap the request body size the server will read.
;;;
;;; A request whose Content-Length exceeds the cap is answered 413 and the
;;; connection closed before any of the body is read or allocated.  The
;;; default is 8 MiB.  This is the server-wide ceiling; mw-body-size applies a
;;; lower per-route limit on top of it.
;;;
;;; Parameters:
;;;   n -- the new cap in bytes (clamped to [0, 2^31 - 2])
;;;
;;; Returns:
;;;   The previous cap.
;;;
;;; Example:
;;;   (httpd-set-max-body! (* 64 1048576))   ; accept uploads up to 64 MiB
;;;
;;; Since: security-audit-plan WP4 (M-4)

(defn httpd-set-max-body! [n : int] : int
  ```c
  int64_t prev = httpd_max_body;
  if (n < 0) n = 0;
  if (n > 2147483646) n = 2147483646;   /* conn->body_len is an int */
  httpd_max_body = n;
  return prev;
  ```)
;;; httpd-set-bind-any! -- listen on every interface instead of loopback.
;;;
;;; Servers bind 127.0.0.1 by default, so a program that starts httpd is not
;;; reachable from the network until it says so.  Call this (or set the
;;; environment variable TUR_HTTPD_BIND_ANY=1) before httpd-new / httpd-new-pool
;;; / httpd-new-async to bind 0.0.0.0.  TUR_BIND_LOOPBACK, which the test
;;; harnesses export, still forces loopback.
;;;
;;; Parameters:
;;;   on -- true to bind every interface, false for loopback
;;;
;;; Returns:
;;;   The previous setting.
;;;
;;; Example:
;;;   (httpd-set-bind-any! true)
;;;   (httpd-new 8080 handler)   ; reachable on every interface
;;;
;;; Since: security-audit-plan WP4 (M-4)

(defn httpd-set-bind-any! [on : bool] : bool
  ```c
  int prev = httpd_bind_any;
  httpd_bind_any = on ? 1 : 0;
  return prev != 0;
  ```)
;;; httpd-set-bind-addr! -- listen on one address, IPv4 or IPv6.
;;;
;;; httpd-set-bind-any! chooses between loopback and every interface; this
;;; names the interface -- a numeric address like "192.168.1.5", "::1" or
;;; "::" (every IPv6 interface).  It applies to the servers created after it
;;; (httpd-new, httpd-new-pool, httpd-new-async, ...) and wins over
;;; httpd-set-bind-any!.  "" clears it, back to that default.  An address
;;; that does not parse is refused and the setting is left as it was.
;;; TUR_BIND_LOOPBACK, which the test harnesses export, still forces loopback
;;; -- of the address's own family (127.0.0.1 or ::1).
;;;
;;; Parameters:
;;;   addr -- a numeric IPv4 or IPv6 address, or "" to clear
;;;
;;; Returns:
;;;   true if the address was accepted (or cleared), false if it did not parse.
;;;
;;; Example:
;;;   (httpd-set-bind-addr! "::1")
;;;   (httpd-new 8080 handler)   ; IPv6 loopback only
;;;
;;; Since: 2026-10-03 (security-audit-plan WP4 residual)

(defn httpd-set-bind-addr! [addr : cstr] : bool
  ```c
  if (!addr) return false;
  if (!*addr) { httpd_bind_addr_s[0] = '\0'; return true; }
  if (strlen(addr) >= sizeof httpd_bind_addr_s) return false;
  unsigned char probe[16];
  if (inet_pton(AF_INET, addr, probe) != 1 && inet_pton(AF_INET6, addr, probe) != 1)
      return false;
  memcpy(httpd_bind_addr_s, addr, strlen(addr) + 1);
  return true;
  ```)
;;; httpd-bind-addr -- internal: the IPv4 address (host order) to listen on.

(defn httpd-bind-addr [] : int
  ```c
  if (getenv("TUR_BIND_LOOPBACK")) return (int64_t)INADDR_LOOPBACK;
  const char *e = getenv("TUR_HTTPD_BIND_ANY");
  int any = httpd_bind_any || (e && *e && strcmp(e, "0") != 0);
  return (int64_t)(any ? INADDR_ANY : INADDR_LOOPBACK);
  ```)
;;; httpd-listen-socket -- internal: a bound, listening, non-blocking socket for
;;; `port` on the configured address (httpd-set-bind-addr!, else loopback or
;;; every interface per httpd-bind-addr), or -1.  Shared by the constructors.

(defn httpd-listen-socket [port : int] : int
  ```c
  #include <fcntl.h>
  const char *a = httpd_bind_addr_s;
  int fam = AF_INET;
  unsigned char a6[16];
  if (a[0] && inet_pton(AF_INET, a, a6) != 1) {
      if (inet_pton(AF_INET6, a, a6) != 1) return -1;
      fam = AF_INET6;
  }
  int loop = getenv("TUR_BIND_LOOPBACK") != NULL;
  struct sockaddr_storage ss;
  memset(&ss, 0, sizeof ss);
  socklen_t sl;
  if (fam == AF_INET) {
      struct sockaddr_in *s4 = (struct sockaddr_in *)&ss;
      s4->sin_family = AF_INET;
      s4->sin_port   = htons((uint16_t)port);
      /* No explicit address, or forced loopback: exactly the old default. */
      if (!a[0] || loop) s4->sin_addr.s_addr = htonl((uint32_t)httpd_hybind_hyaddr());
      else inet_pton(AF_INET, a, &s4->sin_addr);
      sl = (socklen_t)sizeof *s4;
  } else {
      struct sockaddr_in6 *s6 = (struct sockaddr_in6 *)&ss;
      s6->sin6_family = AF_INET6;
      s6->sin6_port   = htons((uint16_t)port);
      if (loop) ((unsigned char *)&s6->sin6_addr)[15] = 1;   /* ::1 */
      else memcpy(&s6->sin6_addr, a6, 16);
      sl = (socklen_t)sizeof *s6;
  }
  int fd = socket(fam, SOCK_STREAM, 0);
  if (fd < 0) return -1;
  int opt = 1;
  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
  int flags = fcntl(fd, F_GETFL, 0);
  fcntl(fd, F_SETFL, flags | O_NONBLOCK);
  if (bind(fd, (struct sockaddr *)&ss, sl) < 0) { close(fd); return -1; }
  if (listen(fd, 128) < 0) { close(fd); return -1; }
  return fd;
  ```)
;;; httpd-status-text -- internal: the reason phrase for a status code.

(defn httpd-status-text [status : int] : cstr
  ```c
  switch (status) {
    case 200: return "OK";
    case 201: return "Created";
    case 204: return "No Content";
    case 301: return "Moved Permanently";
    case 302: return "Found";
    case 303: return "See Other";
    case 304: return "Not Modified";
    case 307: return "Temporary Redirect";
    case 400: return "Bad Request";
    case 401: return "Unauthorized";
    case 403: return "Forbidden";
    case 404: return "Not Found";
    case 405: return "Method Not Allowed";
    case 413: return "Payload Too Large";
    case 414: return "URI Too Long";
    case 429: return "Too Many Requests";
    case 500: return "Internal Server Error";
    case 501: return "Not Implemented";
    case 503: return "Service Unavailable";
    default:  return "OK";
  }
  ```)
;;; httpd-error-response -- internal: a complete close-the-connection response.
;;;
;;; Writes "HTTP/1.1 <status> <text>" with an empty body and Connection: close
;;; into buf (at most cap bytes) and returns its length.

(defn httpd-error-response [status : int buf : ptr<void> cap : int] : int
  ```c
  int n = snprintf((char *)buf, (size_t)cap,
      "HTTP/1.1 %d %s\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
      (int)status, httpd_hystatus_hytext(status));
  if (n < 0) return 0;
  return n >= (int)cap ? (int64_t)cap - 1 : (int64_t)n;
  ```)
;;; httpd-parse-head -- internal: parse a request head that is already in memory.
;;;
;;; `buf` holds `total` bytes (NUL-terminated) that include the whole header
;;; block.  Fills the connection's method / path / version / req_headers and
;;; client_keep_alive, stores the validated Content-Length through `out`
;;; (an int64_t*), and returns the header block's length in bytes.  A request
;;; the server must refuse returns the negated status to answer it with:
;;;   -400  malformed, negative or conflicting Content-Length, or both
;;;         Content-Length and Transfer-Encoding (the request-smuggling shape),
;;;         or a method / version too long for its field
;;;   -413  Content-Length above httpd-set-max-body!'s cap
;;;   -414  a request target too long for the path field
;;;   -501  Transfer-Encoding (chunked bodies are not implemented, and reading
;;;         the chunks as the next request would desync the connection)
;;; Pure over its input: no socket, which is what the fuzz target relies on.

(defn httpd-parse-head [c : ptr<void>
                        buf : ptr<void>
                        total : int
                        out : ptr<void>] : int
  ```c
  HttpdConn *conn = (HttpdConn *)c;
  char *bp = (char *)buf;
  int64_t *out_clen = (int64_t *)out;
  *out_clen = 0;
  char *hdr_end = strstr(bp, "\r\n\r\n");
  if (!hdr_end) hdr_end = strstr(bp, "\n\n");
  if (!hdr_end) return -400;
  int hdr_sep_len = (hdr_end[0] == '\r') ? 4 : 2;
  int64_t hdrs_total = (int64_t)(hdr_end - bp) + hdr_sep_len;
  /* Parse request line: METHOD SP PATH SP VERSION CRLF */
  char *line_end = strpbrk(bp, "\r\n");
  if (!line_end || line_end > bp + total) line_end = bp + total;
  char *p = bp;
  if (p < line_end) {
      char *sp = (char *)memchr(p, ' ', (size_t)(line_end - p));
      if (sp) {
          int l = (int)(sp - p);
          /* An oversized field used to be left "" and the request served
           * anyway (security-audit-plan WP4, item 5). */
          if (l >= 15) return -400;
          if (l > 0) {
              memcpy(conn->method, p, (size_t)l);
              conn->method[l] = '\0';
          }
          p = sp + 1;
      }
  }
  if (p < line_end) {
      char *sp = (char *)memchr(p, ' ', (size_t)(line_end - p));
      if (sp) {
          int l = (int)(sp - p);
          if (l >= 1023) return -414;
          if (l > 0) {
              memcpy(conn->path, p, (size_t)l);
              conn->path[l] = '\0';
          }
          p = sp + 1;
          char *vlen_end = (char *)memchr(p, '\r', (size_t)(line_end - p));
          if (!vlen_end) vlen_end = line_end;
          int vl = (int)(vlen_end - p);
          if (vl >= 15) return -400;
          if (vl > 0) {
              memcpy(conn->version, p, (size_t)vl);
              conn->version[vl] = '\0';
          }
      } else {
          int l = (int)(line_end - p);
          if (l >= 1023) return -414;
          if (l > 0) {
              memcpy(conn->path, p, (size_t)l);
              conn->path[l] = '\0';
          }
      }
  }
  /* Scan headers: pick out Connection / Content-Length / Transfer-Encoding,
   * AND capture every header into conn->req_headers so middleware can read
   * arbitrary names via httpd-req-header. */
  int is_http_11  = (strstr(conn->version, "1.1") != NULL);
  int conn_keep   = is_http_11;   /* default by version */
  int conn_close  = 0;
  int have_cl = 0, have_te = 0, bad_cl = 0, big_cl = 0;
  int64_t content_len = 0;
  HttpdHeader *req_tail = NULL;
  char *h = strpbrk(bp, "\r\n");
  if (h) {
      while (h[0] == '\r' || h[0] == '\n') h++;
      while (h < hdr_end) {
          char *eol = strpbrk(h, "\r\n");
          if (!eol || eol > hdr_end) eol = hdr_end;
          if (eol > h) {
              char *colon = (char *)memchr(h, ':', (size_t)(eol - h));
              if (colon) {
                  int name_len = (int)(colon - h);
                  char *val = colon + 1;
                  while (val < eol && (*val == ' ' || *val == '\t')) val++;
                  int val_len = (int)(eol - val);
                  if (name_len == 10 && strncasecmp(h, "Connection", 10) == 0) {
                      /* A comma-separated token list, each token whole:
                       * `closed` is not `close` (WP4, item 6). */
                      const char *t = val;
                      while (t < eol) {
                          while (t < eol && (*t == ' ' || *t == '\t' || *t == ',')) t++;
                          const char *te = t;
                          while (te < eol && *te != ',') te++;
                          const char *tt = te;
                          while (tt > t && (tt[-1] == ' ' || tt[-1] == '\t')) tt--;
                          size_t tl = (size_t)(tt - t);
                          if (tl == 5  && strncasecmp(t, "close", 5) == 0) conn_close = 1;
                          if (tl == 10 && strncasecmp(t, "keep-alive", 10) == 0) conn_keep = 1;
                          t = te;
                      }
                  } else if (name_len == 14 && strncasecmp(h, "Content-Length", 14) == 0) {
                      /* The whole value must be decimal digits (optional
                       * trailing blanks): no sign, no "10abc", and no silent
                       * truncation to int -- `(int)strtol` used to turn
                       * 4294967306 into 10.  Repeats must agree. */
                      const char *q = val, *qe = eol;
                      while (qe > q && (qe[-1] == ' ' || qe[-1] == '\t')) qe--;
                      int64_t v = 0;
                      if (q == qe) bad_cl = 1;
                      for (; q < qe; q++) {
                          if (*q < '0' || *q > '9') { bad_cl = 1; break; }
                          if (v > (INT64_MAX - 9) / 10) { big_cl = 1; break; }
                          v = v * 10 + (int64_t)(*q - '0');
                      }
                      if (!bad_cl && !big_cl) {
                          if (have_cl && v != content_len) bad_cl = 1;
                          have_cl = 1;
                          content_len = v;
                      }
                  } else if (name_len == 17 && strncasecmp(h, "Transfer-Encoding", 17) == 0) {
                      have_te = 1;
                  }
                  /* M0: stash a copy on req_headers (always, even for
                   * Connection / Content-Length, so a handler can read
                   * them by name without a second special case). */
                  if (name_len > 0) {
                      HttpdHeader *rh = (HttpdHeader *)calloc(1, sizeof(HttpdHeader));
                      if (rh) {
                          rh->name  = (char *)malloc((size_t)name_len + 1);
                          rh->value = (char *)malloc((size_t)val_len  + 1);
                          if (rh->name && rh->value) {
                              memcpy(rh->name,  h,   (size_t)name_len); rh->name[name_len]  = '\0';
                              if (val_len > 0) memcpy(rh->value, val, (size_t)val_len);
                              rh->value[val_len] = '\0';
                              if (req_tail) { req_tail->next = rh; req_tail = rh; }
                              else { conn->req_headers = rh; req_tail = rh; }
                          } else {
                              if (rh->name)  free(rh->name);
                              if (rh->value) free(rh->value);
                              free(rh);
                          }
                      }
                  }
              }
          }
          if (eol >= hdr_end) break;
          h = eol;
          while (h < hdr_end && (h[0] == '\r' || h[0] == '\n')) h++;
      }
  }
  conn->client_keep_alive = (conn_keep && !conn_close);
  if (bad_cl) return -400;
  if (have_te) return have_cl ? -400 : -501;
  if (big_cl || content_len > httpd_max_body) return -413;
  *out_clen = content_len;
  return hdrs_total;
  ```)
;;; httpd-resp-head -- internal: build the response status line + header block.
;;;
;;; Returns a malloc'd buffer (caller frees) holding everything up to and
;;; including the blank line, and stores its length through `out` (an
;;; int64_t*); NULL on allocation failure.  A user-set Content-Length is
;;; dropped (the server owns the byte count), and so is any header whose name
;;; or value would break the framing -- a CR or LF in either (response
;;; splitting when a handler echoes request data into a header), or a name
;;; with a colon or blank in it.

(defn httpd-resp-head [c : ptr<void> is11 : int out : ptr<void>] : ptr<void>
  ```c
  HttpdConn *conn = (HttpdConn *)c;
  int64_t *out_len = (int64_t *)out;
  *out_len = 0;
  int status = conn->resp_status ? conn->resp_status : 200;
  const char *stxt = httpd_hystatus_hytext((int64_t)status);
  int blen = conn->resp_body ? conn->resp_body_len : 0;
  const char *ver  = is11 ? "HTTP/1.1" : "HTTP/1.0";
  const char *chdr = conn->client_keep_alive ? "keep-alive" : "close";
  int has_content_type = 0;
  for (HttpdHeader *rh = (HttpdHeader *)conn->resp_headers; rh; rh = rh->next) {
      if (rh->name && strcasecmp(rh->name, "Content-Type") == 0) { has_content_type = 1; break; }
  }
  size_t cap = 1024, len = 0;
  char *hb = (char *)malloc(cap);
  if (!hb) return NULL;
  int n = snprintf(hb, cap, "%s %d %s\r\nContent-Length: %d\r\nConnection: %s\r\n%s",
                   ver, status, stxt, blen, chdr,
                   has_content_type ? "" : "Content-Type: text/plain; charset=utf-8\r\n");
  if (n < 0 || (size_t)n >= cap) { free(hb); return NULL; }
  len = (size_t)n;
  for (HttpdHeader *rh = (HttpdHeader *)conn->resp_headers; rh; rh = rh->next) {
      if (!rh->name || !*rh->name || strcasecmp(rh->name, "Content-Length") == 0) continue;
      const char *v = rh->value ? rh->value : "";
      if (strpbrk(rh->name, "\r\n: \t") || strpbrk(v, "\r\n")) continue;
      size_t nlen = strlen(rh->name), vlen = strlen(v);
      size_t need = len + nlen + vlen + 5;   /* ": " + "\r\n" + NUL */
      if (need > cap) {
          size_t nc = cap;
          while (nc < need) nc *= 2;
          char *nh = (char *)realloc(hb, nc);
          if (!nh) { free(hb); return NULL; }
          hb = nh; cap = nc;
      }
      memcpy(hb + len, rh->name, nlen); len += nlen;
      hb[len++] = ':'; hb[len++] = ' ';
      memcpy(hb + len, v, vlen); len += vlen;
      hb[len++] = '\r'; hb[len++] = '\n';
  }
  if (len + 3 > cap) {
      char *nh = (char *)realloc(hb, len + 3);
      if (!nh) { free(hb); return NULL; }
      hb = nh;
  }
  hb[len++] = '\r'; hb[len++] = '\n'; hb[len] = '\0';
  *out_len = (int64_t)len;
  return hb;
  ```)
;;; httpd-conn-release -- internal: free everything a request attached to conn.
;;;
;;; The body, the response body, both header lists, the cached JSON body, the
;;; multipart parts, the attribute list and the owned accessor strings.  Leaves
;;; conn reusable (every freed field is reset).

(defn httpd-conn-release [c : ptr<void>] : nil
  ```c
  HttpdConn *conn = (HttpdConn *)c;
  if (!conn) return;
  if (conn->body)      { free(conn->body); conn->body = NULL; }
  if (conn->resp_body) { free(conn->resp_body); conn->resp_body = NULL; }
  for (int which = 0; which < 2; which++) {
      HttpdHeader *rh = (HttpdHeader *)(which ? conn->resp_headers : conn->req_headers);
      while (rh) {
          HttpdHeader *nx = rh->next;
          if (rh->name)  free(rh->name);
          if (rh->value) free(rh->value);
          free(rh);
          rh = nx;
      }
  }
  conn->req_headers = NULL;
  conn->resp_headers = NULL;
  /* M3: free any cached JSON body parsed by httpd-req-json / mw-json-body. */
  if (conn->req_json_cache) {
      json_slfree(conn->req_json_cache);
      conn->req_json_cache = 0;
  }
  /* M7: free any cached multipart parts. */
  if (conn->req_multipart_parts) {
      /* Same shape as HttpdPart below; redeclared here so cleanup is
       * self-contained. */
      typedef struct __HttpdPart {
          char *name; char *filename; char *content_type;
          char *data; int data_len;
          struct __HttpdPart *next;
      } HttpdPart;
      HttpdPart *pp = (HttpdPart *)conn->req_multipart_parts;
      while (pp) {
          HttpdPart *nx = pp->next;
          if (pp->name)         free(pp->name);
          if (pp->filename)     free(pp->filename);
          if (pp->content_type) free(pp->content_type);
          if (pp->data)         free(pp->data);
          free(pp);
          pp = nx;
      }
      conn->req_multipart_parts = NULL;
  }
  /* MW2: free per-request attribute list. */
  if (conn->attr_list) {
      HttpdAttr *ap = (HttpdAttr *)conn->attr_list;
      while (ap) {
          HttpdAttr *nx = ap->next;
          if (ap->key)   free(ap->key);
          if (ap->value) free(ap->value);
          free(ap);
          ap = nx;
      }
      conn->attr_list = NULL;
  }
  /* httpd-request-accessor-cstr-leak: free the per-request accessor strings
   * (httpd-req-cookie / httpd-req-form results) registered on owned_cstrs. */
  if (conn->owned_cstrs) {
      HttpdOwnedStr *op = (HttpdOwnedStr *)conn->owned_cstrs;
      while (op) {
          HttpdOwnedStr *nx = op->next;
          if (op->s) free(op->s);
          free(op);
          op = nx;
      }
      conn->owned_cstrs = NULL;
  }
  ```)
;;; httpd-handle -- internal: serve one or more HTTP requests on fd, then
;;; close fd. Loops while the client keeps the connection alive.
;;;
;;; HTTP/1.1 keep-alive semantics:
;;;   - HTTP/1.1: connection kept alive unless Connection: close.
;;;   - HTTP/1.0: connection closed unless Connection: keep-alive.
;;;   - A SO_RCVTIMEO of 5 seconds bounds idle keep-alive holding time.
;;;
;;; When `tls` is non-zero it is an opaque TLS connection handle obtained
;;; from the spice's tls-wrap-fd + tls-handshake; reads and writes are
;;; routed through the registered TLS ops instead of recv/send.
;;;
;;; Since: Phase H1 (TLS path: Phase H5)

(defn httpd-handle [fd : int handler : int tls : int] : nil
  ```c
  typedef int64_t (*httpd_tls_io_fn)(int64_t, int64_t, int64_t);
  typedef void    (*httpd_tls_void_fn)(int64_t);
  /* 5 second receive timeout bounds idle keep-alive connections. */
  struct timeval tv;
  tv.tv_sec = 5; tv.tv_usec = 0;
  setsockopt((int)fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
  int keep_going = 1;
  while (keep_going) {
      HttpdConn _conn;
      HttpdConn *conn = &_conn;
      memset(conn, 0, sizeof(HttpdConn));
      conn->fd = (int)fd;
      conn->handler = (int64_t)handler;
      conn->tls = (int64_t)tls;
      /* M0: grow the read buffer on demand so large header blocks no
       * longer truncate at 8 KB. Start at 8 KB; double until headers fit
       * or a hard cap is reached (defends against runaway headers). */
      size_t buf_cap = 8192;
      size_t buf_max = 262144;  /* 256 KB hard cap on header block */
      char  *buf     = (char *)malloc(buf_cap);
      if (!buf) break;
      buf[0] = '\0';
      int total = 0;
      ssize_t n;
      char *hdr_end = NULL;
      while (!hdr_end) {
          if ((size_t)total + 1 >= buf_cap) {
              if (buf_cap >= buf_max) break;
              size_t new_cap = buf_cap * 2;
              if (new_cap > buf_max) new_cap = buf_max;
              char *nb = (char *)realloc(buf, new_cap);
              if (!nb) break;
              buf = nb;
              buf_cap = new_cap;
          }
          if (conn->tls && httpd_tls_ops.read_fn) {
              n = (ssize_t)((httpd_tls_io_fn)(intptr_t)httpd_tls_ops.read_fn)(
                      conn->tls, (int64_t)(intptr_t)(buf + total),
                      (int64_t)(buf_cap - 1 - (size_t)total));
          } else {
              n = recv(conn->fd, buf + total,
                       (size_t)(buf_cap - 1 - (size_t)total), 0);
          }
          if (n <= 0) break;
          /* Resume the terminator search where the last one stopped (less
           * the terminator's own length): rescanning the whole buffer after
           * every recv made a peer trickling bytes up to the 256 KiB cap cost
           * O(n^2) (WP4, item 1). */
          int scan4 = total > 3 ? total - 3 : 0;
          int scan2 = total > 1 ? total - 1 : 0;
          total += (int)n;
          buf[total] = '\0';
          hdr_end = strstr(buf + scan4, "\r\n\r\n");
          if (!hdr_end) hdr_end = strstr(buf + scan2, "\n\n");
      }
      if (!hdr_end) { free(buf); break; }  /* peer closed, timed out, or oversized */
      /* security-audit-plan M-4: the head is parsed by httpd-parse-head, the
       * one parser both server paths share, which also validates the
       * Content-Length against httpd-set-max-body!'s cap BEFORE anything is
       * allocated for the body. */
      int64_t content_len = 0;
      int64_t hdrs_total = httpd_hyparse_hyhead((void *)conn, (void *)buf,
                                                (int64_t)total, (void *)&content_len);
      if (hdrs_total < 0) {
          char eb[160];
          int64_t el = httpd_hyerror_hyresponse(-hdrs_total, (void *)eb, (int64_t)sizeof eb);
          if (conn->tls && httpd_tls_ops.write_fn) {
              ((httpd_tls_io_fn)(intptr_t)httpd_tls_ops.write_fn)(
                  conn->tls, (int64_t)(intptr_t)eb, el);
          } else {
              send(conn->fd, eb, (size_t)el, 0);
          }
          free(buf);
          httpd_hyconn_hyrelease((void *)conn);
          break;
      }
      int is_http_11 = (strstr(conn->version, "1.1") != NULL);
      /* Read body if Content-Length present. */
      if (content_len > 0) {
          int64_t body_in_buf = (int64_t)total - hdrs_total;
          if (body_in_buf < 0) body_in_buf = 0;
          if (body_in_buf > content_len) body_in_buf = content_len;
          conn->body = (char *)malloc((size_t)content_len + 1);
          if (!conn->body) { free(buf); httpd_hyconn_hyrelease((void *)conn); break; }
          if (body_in_buf > 0) memcpy(conn->body, buf + hdrs_total, (size_t)body_in_buf);
          int64_t got = body_in_buf;
          while (got < content_len) {
              ssize_t r;
              if (conn->tls && httpd_tls_ops.read_fn) {
                  r = (ssize_t)((httpd_tls_io_fn)(intptr_t)httpd_tls_ops.read_fn)(
                          conn->tls, (int64_t)(intptr_t)(conn->body + got), content_len - got);
              } else {
                  r = recv(conn->fd, conn->body + got, (size_t)(content_len - got), 0);
              }
              if (r <= 0) break;
              got += (int64_t)r;
          }
          conn->body[got] = '\0';
          conn->body_len = (int)got;
          /* A body shorter than its Content-Length (timeout, peer closed) is
           * not a request: drop the connection rather than hand the handler
           * a truncated one. */
          if (got < content_len) { free(buf); httpd_hyconn_hyrelease((void *)conn); break; }
      }
      /* Read buffer is no longer needed past this point. */
      free(buf);
      /* Dispatch to handler. */
      int64_t *fat = (int64_t *)(intptr_t)conn->handler;
      /* The handler is `(fn [c : ptr<void>] : nil)`, whose slot 0 is
         `void (void *, int64_t)`: an untyped `ptr<void>` parameter is the
         word in a closure slot (fnsan-ptr-void-fn-slot-word).  Spelling it
         any other way makes this an indirect call through a mismatched
         function-pointer type -- UB that -fsanitize=function reports and that
         CFI / CET-BTI / WASM call_indirect turn into a hard failure.  See
         docs/archive/reactor-fd-callback-fn-ptr-type-mismatch.md */
      typedef void (*fn1_t)(void *, int64_t);
      ((fn1_t)(intptr_t)fat[0])((void *)fat, (int64_t)(intptr_t)conn);
      /* Write response. */
      const char *body = conn->resp_body ? conn->resp_body : "";
      int         blen = conn->resp_body ? conn->resp_body_len : 0;
      int64_t hlen = 0;
      char *hbuf = (char *)httpd_hyresp_hyhead((void *)conn, (int64_t)is_http_11, (void *)&hlen);
      if (!hbuf) {
          /* fall back to a minimal status-only response */
          char tiny[160];
          int64_t tl = httpd_hyerror_hyresponse(500, (void *)tiny, (int64_t)sizeof tiny);
          if (conn->tls && httpd_tls_ops.write_fn) {
              ((httpd_tls_io_fn)(intptr_t)httpd_tls_ops.write_fn)(
                  conn->tls, (int64_t)(intptr_t)tiny, tl);
          } else {
              send(conn->fd, tiny, (size_t)tl, 0);
          }
          keep_going = 0;
      } else {
          if (conn->tls && httpd_tls_ops.write_fn) {
              ((httpd_tls_io_fn)(intptr_t)httpd_tls_ops.write_fn)(
                  conn->tls, (int64_t)(intptr_t)hbuf, hlen);
              if (blen > 0) {
                  ((httpd_tls_io_fn)(intptr_t)httpd_tls_ops.write_fn)(
                      conn->tls, (int64_t)(intptr_t)body, (int64_t)blen);
              }
          } else {
              send(conn->fd, hbuf, (size_t)hlen, 0);
              if (blen > 0) send(conn->fd, body, (size_t)blen, 0);
          }
          free(hbuf);
          keep_going = conn->client_keep_alive;
      }
      httpd_hyconn_hyrelease((void *)conn);
  }
  if (tls && httpd_tls_ops.shutdown) {
      ((httpd_tls_void_fn)(intptr_t)httpd_tls_ops.shutdown)((int64_t)tls);
  }
  if (tls && httpd_tls_ops.free_fn) {
      ((httpd_tls_void_fn)(intptr_t)httpd_tls_ops.free_fn)((int64_t)tls);
  }
  close((int)fd);
  ```)
;;; httpd-worker -- internal: worker thread function.
;;;
;;; Pops fds from the shared queue and processes them sequentially via
;;; httpd-handle. Exits when the queue is closed and drained.
;;;
;;; Since: Phase H3

(defn httpd-worker [arg : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  typedef int64_t (*httpd_tls_wrap_fn)(int64_t, int64_t);
  typedef int64_t (*httpd_tls_handshake_fn)(int64_t);
  typedef void    (*httpd_tls_void_fn)(int64_t);
  HttpdBlock *hb = (HttpdBlock *)arg;
  for (;;) {
      int fd = -1;
      pthread_mutex_lock(&hb->fdq_mtx);
      while (hb->fdq_count == 0 && !hb->fdq_closed)
          pthread_cond_wait(&hb->fdq_cv, &hb->fdq_mtx);
      if (hb->fdq_count == 0 && hb->fdq_closed) {
          pthread_mutex_unlock(&hb->fdq_mtx);
          break;
      }
      fd = hb->fdq[hb->fdq_head];
      hb->fdq_head = (hb->fdq_head + 1) % hb->fdq_cap;
      hb->fdq_count--;
      pthread_mutex_unlock(&hb->fdq_mtx);
      int64_t tls = 0;
      if (hb->tls_ctx && httpd_tls_ops.wrap_fd && httpd_tls_ops.handshake) {
          tls = ((httpd_tls_wrap_fn)(intptr_t)httpd_tls_ops.wrap_fd)(
                    (int64_t)(intptr_t)hb->tls_ctx, (int64_t)fd);
          if (tls == 0) { close(fd); continue; }
          int hrc = (int)((httpd_tls_handshake_fn)(intptr_t)httpd_tls_ops.handshake)(tls);
          if (hrc != 0) {
              if (httpd_tls_ops.free_fn) {
                  ((httpd_tls_void_fn)(intptr_t)httpd_tls_ops.free_fn)(tls);
              }
              close(fd);
              continue;
          }
      }
      httpd_hyhandle((int64_t)fd, hb->handler, tls);
  }
  return NULL;
  ```)
;;; httpd-accept-cb -- internal reactor READ callback for the listen fd.
;;;
;;; Drains the listen queue, pushing each accepted fd onto the shared
;;; worker queue and signalling one waiting worker. env[1] is the
;;; HttpdBlock pointer (synthetic fat closure built in httpd-new).
;;;
;;; Since: Phase H2

;;; NOTE: the trailing `user`/`user-data` slot is typed `: int` DELIBERATELY
;;; (an exception to the no-lazy-:int rule): this defn is hand-packed into a
;;; fat box's slot 0 (see the `clos[0] = ...` below / reactor.c park boxes),
;;; and the reactor invokes slot 0 through the fat-entry CARRIER convention
;;; (typedefs in src/async/reactor.c) -- every value parameter is int64_t.  A
;;; `ptr<void>` spelling emits a `void *` C parameter, which -fsanitize=function
;;; flags (and CFI/CET-BTI/WASM reject) at every dispatch.
(defn httpd-accept-cb [env : ptr<void> id : int events : int user : int] : nil
  ```c
  (void)id; (void)events; (void)user;
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  int64_t *fat = (int64_t *)env;
  HttpdBlock *hb = (HttpdBlock *)(intptr_t)fat[1];
  /* Drain pending accepts; the listen fd is non-blocking. */
  for (;;) {
      int cfd = accept(hb->listen_fd, NULL, NULL);
      if (cfd < 0) break;
      /* Clear O_NONBLOCK on the connection fd so worker recv() respects
       * the SO_RCVTIMEO set in httpd-handle. (accept() can inherit
       * non-blocking from the listen fd on some platforms.) */
      {
          int cflags = fcntl(cfd, F_GETFL, 0);
          fcntl(cfd, F_SETFL, cflags & ~O_NONBLOCK);
      }
      pthread_mutex_lock(&hb->fdq_mtx);
      if (hb->fdq_closed) { pthread_mutex_unlock(&hb->fdq_mtx); close(cfd); break; }
      /* The pending-connection cap (httpd-new-pool-with-limit; 512 by
       * default).  Every queued connection holds an fd until a worker frees
       * up, so an unbounded queue let a flood of connections exhaust the
       * process's descriptors.  Refuse past the cap with a 503, as the async
       * server does past its in-flight cap. */
      if (hb->fdq_max > 0 && hb->fdq_count >= hb->fdq_max) {
          pthread_mutex_unlock(&hb->fdq_mtx);
          const char *resp =
              "HTTP/1.0 503 Service Unavailable\r\n"
              "Content-Length: 19\r\n"
              "Connection: close\r\n"
              "\r\n"
              "server at capacity\n";
          (void)send(cfd, resp, strlen(resp), 0);
          /* Linger rather than close(): closing over the unread request
           * sends RST, and a client that has not read the 503 yet loses it
           * (see httpd-async-accept-cb). */
          (void)tur_reactor_linger_close(hb->reactor, cfd, 2000);
          continue;
      }
      /* Grow the queue if full (doubling). */
      if (hb->fdq_count == hb->fdq_cap) {
          int new_cap = hb->fdq_cap * 2;
          int *new_q = (int *)malloc((size_t)new_cap * sizeof(int));
          if (!new_q) {
              pthread_mutex_unlock(&hb->fdq_mtx);
              close(cfd);
              break;
          }
          for (int i = 0; i < hb->fdq_count; i++)
              new_q[i] = hb->fdq[(hb->fdq_head + i) % hb->fdq_cap];
          free(hb->fdq);
          hb->fdq = new_q;
          hb->fdq_head = 0;
          hb->fdq_tail = hb->fdq_count;
          hb->fdq_cap  = new_cap;
      }
      hb->fdq[hb->fdq_tail] = cfd;
      hb->fdq_tail = (hb->fdq_tail + 1) % hb->fdq_cap;
      hb->fdq_count++;
      pthread_cond_signal(&hb->fdq_cv);
      pthread_mutex_unlock(&hb->fdq_mtx);
  }
  ```)
;;; httpd-new-pool -- create an httpd instance with a configurable worker count.
;;;
;;; At most 512 accepted connections wait for a free worker; past that a
;;; connection is answered 503 and closed.  httpd-new-pool-with-limit sets
;;; another cap.
;;;
;;; Parameters:
;;;   port    -- TCP port to listen on (0 = kernel-assigned)
;;;   workers -- number of worker threads in the pool (must be > 0)
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;
;;; Returns:
;;;   ptr<void> -- opaque Httpd handle, or nil on error
;;;
;;; Since: Phase H3

(defn httpd-new-pool [port : int
                      workers : int
                      ^fat handler : (fn [ptr<void>] nil)]
  #fx{Net}
  : ptr<void>
  ```c
  #include <fcntl.h>
  /* Ignore SIGPIPE so a peer closing early returns EPIPE from send()
   * instead of terminating the process. signal() is declared manually
   * to avoid pulling <signal.h> into this function-body scope. */
  typedef void (*tur_sig_fn)(int);
  extern tur_sig_fn signal(int, tur_sig_fn);
  /* SIGPIPE = 13 on POSIX; SIG_IGN = (void (*)(int))1. */
  signal(13, (tur_sig_fn)(intptr_t)1);
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  if (workers <= 0) workers = 4;
  /* `workers * sizeof(pthread_t)` wrapped for a huge count and the first
     pthread_create wrote past the block; the spawn loop is `int i` too
     (security audit WP5, M-5). */
  if (workers > INT32_MAX || (uint64_t)workers > SIZE_MAX / sizeof(pthread_t)) {
    TUR_CLOSURE_DROP(handler);
    return NULL;
  }
  /* Loopback unless the program opted in to every interface with
   * httpd-set-bind-any! / TUR_HTTPD_BIND_ANY=1, or named one with
   * httpd-set-bind-addr! (security-audit-plan M-4: a server that is reachable
   * from the network should be one somebody asked for).  TUR_BIND_LOOPBACK,
   * which the test suite exports, still forces loopback. */
  int fd = (int)httpd_hylisten_hysocket(port);
  if (fd < 0) { TUR_CLOSURE_DROP(handler); return NULL; }
  HttpdBlock *hb = (HttpdBlock *)calloc(1, sizeof(HttpdBlock));
  if (!hb) { close(fd); TUR_CLOSURE_DROP(handler); return NULL; }
  hb->listen_fd = fd;
  hb->handler   = (int64_t)handler;
  hb->n_workers = (int)workers;
  /* Initialise the shared queue with a small capacity (will grow). */
  hb->fdq_cap = 16;
  /* WP4 residual item 3: a default pending-connection cap, the same 512 as
   * httpd-new-async's in-flight default; httpd-new-pool-with-limit sets
   * another (0 = unlimited). */
  hb->fdq_max = 512;
  hb->fdq     = (int *)malloc((size_t)hb->fdq_cap * sizeof(int));
  if (!hb->fdq) { close(fd); TUR_CLOSURE_DROP(handler); free(hb); return NULL; }
  pthread_mutex_init(&hb->fdq_mtx, NULL);
  pthread_cond_init(&hb->fdq_cv,  NULL);
  /* Reactor + accept callback (synthetic fat closure { __fn, hb }). */
  hb->reactor = tur_reactor_new();
  if (!hb->reactor) { free(hb->fdq); close(fd); TUR_CLOSURE_DROP(handler); free(hb); return NULL; }
  int64_t *clos = (int64_t *)malloc(2 * sizeof(int64_t));
  if (!clos) {
      tur_reactor_free(hb->reactor);
      free(hb->fdq); close(fd); TUR_CLOSURE_DROP(handler); free(hb); return NULL;
  }
  clos[0] = (int64_t)(intptr_t)httpd_hyaccept_hycb;
  clos[1] = (int64_t)(intptr_t)hb;
  hb->accept_clos = (void *)clos;
  hb->listen_src_id = (int)tur_reactor_add_fd(hb->reactor, fd, 1,
      (int64_t)(intptr_t)clos, NULL);
  /* The reactor owns cb boxes by default and frees them at teardown; this
   * accept box is cached in hb->accept_clos and freed by httpd itself, so
   * disown it to avoid a double free. */
  tur_reactor_disown_cb(hb->reactor, hb->listen_src_id);
  if (hb->listen_src_id < 0) {
      free(clos);
      tur_reactor_free(hb->reactor);
      free(hb->fdq); close(fd); TUR_CLOSURE_DROP(handler); free(hb); return NULL;
  }
  /* Spawn worker threads. */
  hb->workers = (pthread_t *)malloc((size_t)workers * sizeof(pthread_t));
  if (!hb->workers) {
      tur_reactor_remove(hb->reactor, hb->listen_src_id);
      free(clos);
      tur_reactor_free(hb->reactor);
      free(hb->fdq); close(fd); TUR_CLOSURE_DROP(handler); free(hb); return NULL;
  }
  for (int i = 0; i < workers; i++) {
      pthread_create(&hb->workers[i], NULL,
                     (void *(*)(void *))httpd_hyworker, (void *)hb);
  }
  return (void *)hb;
  ```)
;;; httpd-new-pool-with-limit -- httpd-new-pool with a pending-connection cap.
;;;
;;; Each worker serves one connection at a time; accepted connections wait
;;; in a queue for a free worker, each holding a descriptor.  When
;;; `max-pending` connections are already waiting, a new one is answered
;;; `503 Service Unavailable` and closed instead of queued.
;;;
;;; Parameters:
;;;   port        -- TCP port to listen on (0 = kernel-assigned)
;;;   workers     -- number of worker threads in the pool (must be > 0)
;;;   handler     -- fat closure: (fn [conn :ptr<void>] :nil)
;;;   max-pending -- queued-connection cap (0 = unlimited; httpd-new-pool
;;;                  uses 512)
;;;
;;; Returns:
;;;   ptr<void> -- opaque Httpd handle, or nil on error
;;;
;;; Example:
;;;   (let [h (httpd-new-pool-with-limit 0 4 handler 64)]
;;;     (httpd-run h)
;;;     (httpd-free h))
;;;
;;; Since: 2026-10-03 (security-audit-plan WP4 residual)

(defn httpd-new-pool-with-limit [port : int
                                 workers : int
                                 ^fat handler : (fn [ptr<void>] nil)
                                 max-pending : int]
  #fx{Net}
  : ptr<void>
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  /* The handler's ownership passes to httpd-new-pool, which releases it on
   * every refusal.  The reactor does not run until httpd-run, so no
   * connection is accepted under the default cap before this one is set. */
  HttpdBlock *hb = (HttpdBlock *)httpd_hynew_hypool((int64_t)port,
                                                (int64_t)workers,
                                                (int64_t)handler);
  if (!hb) return NULL;
  hb->fdq_max = max_pending <= 0 ? 0
              : max_pending > INT32_MAX ? INT32_MAX : (int)max_pending;
  return (void *)hb;
  ```)
;;; httpd-new -- create a new httpd instance with the default worker pool size (4).
;;;
;;; Parameters:
;;;   port    -- TCP port to listen on (0 = kernel-assigned)
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;
;;; Returns:
;;;   ptr<void> -- opaque Httpd handle, or nil on error
;;;
;;; Example:
;;;   (let [h (httpd-new 0 (fn [conn :ptr<void>] :nil
;;;                          (httpd-resp-status! conn 200)
;;;                          (httpd-resp-body! conn "OK")))]
;;;     (httpd-run h)
;;;     (httpd-free h))
;;;
;;; Since: Phase H1

(defn httpd-new [port : int ^fat handler : (fn [ptr<void>] nil)]
  #fx{Net}
  : ptr<void>
  (httpd-new-pool port 4 handler))
;;; httpd-new-tls -- create an httpd instance with TLS termination.
;;;
;;; The accept loop is identical to the plaintext path; each accepted fd
;;; is wrapped with tls-wrap-fd + driven through tls-handshake on the
;;; worker that pops it. Reads and writes inside httpd-handle then go
;;; through the registered TLS ops instead of recv/send.
;;;
;;; Prerequisites:
;;;   * The tur/tls spice must be linked (otherwise the function-pointer
;;;     table is all zeros and this constructor returns NULL).
;;;   * The user must call (tls-httpd-init) once -- exported by the
;;;     spice's tls/httpd module -- before calling httpd-new-tls.
;;;
;;; Parameters:
;;;   port    -- TCP port to listen on (0 = kernel-assigned)
;;;   workers -- number of worker threads (must be > 0)
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;   ctx     -- TLS context handle from tls-ctx-new with cert + key loaded
;;;
;;; Returns:
;;;   ptr<void> -- opaque Httpd handle, or nil if ctx is 0 or TLS ops
;;;   have not been registered.
;;;
;;; Example:
;;;   (tls-httpd-init)
;;;   (let [ctx (tls-ctx-new)]
;;;     (tls-ctx-load-cert-pem ctx "cert.pem")
;;;     (tls-ctx-load-key-pem  ctx "key.pem")
;;;     (let [h (httpd-new-tls 8443 4 my-handler ctx)]
;;;       (httpd-run h)
;;;       (httpd-free h)
;;;       (tls-ctx-free ctx)))
;;;
;;; Since: Phase H5

(defn httpd-new-tls [port : int
                     workers : int
                     ^fat handler : (fn [ptr<void>] nil)
                     ctx : int]
  #fx{Net}
  : ptr<void>
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  /* handler is passed ^fat (this fn owns the heap box).  On an early refusal it
   * is never handed to httpd-new-pool, so release it here or it leaks -- via
   * TUR_CLOSURE_DROP so a compose-middleware onion is fully reclaimed (flag-off,
   * a plain free of the outer box). */
  if (ctx == 0) {
      fprintf(stderr, "httpd-new-tls: ctx is 0\n");
      TUR_CLOSURE_DROP(handler);
      return NULL;
  }
  if (!httpd_tls_ops.wrap_fd || !httpd_tls_ops.handshake ||
      !httpd_tls_ops.read_fn || !httpd_tls_ops.write_fn) {
      fprintf(stderr,
          "httpd-new-tls: TLS ops not registered "
          "-- did you forget to import tls/httpd and call tls-httpd-init?\n");
      TUR_CLOSURE_DROP(handler);
      return NULL;
  }
  HttpdBlock *hb = (HttpdBlock *)httpd_hynew_hypool((int64_t)port,
                                                (int64_t)workers,
                                                (int64_t)handler);
  if (!hb) return NULL;
  hb->tls_ctx = (void *)(intptr_t)ctx;
  return (void *)hb;
  ```)
;;; httpd-port -- return the port the server is listening on.
;;;
;;; Useful when httpd-new was called with port 0 (kernel-assigned).
;;;
;;; Parameters:
;;;   h -- httpd handle returned by httpd-new
;;;
;;; Returns:
;;;   int -- the actual listening port, or -1 on error
;;;
;;; Since: Phase H1

(defn httpd-port [h : ptr<void>] : int
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  struct sockaddr_storage addr;
  socklen_t len = sizeof(addr);
  if (getsockname(hb->listen_fd, (struct sockaddr *)&addr, &len) < 0) return -1;
  if (addr.ss_family == AF_INET6)
      return (int64_t)ntohs(((struct sockaddr_in6 *)&addr)->sin6_port);
  return (int64_t)ntohs(((struct sockaddr_in *)&addr)->sin_port);
  ```)
;;; httpd-run -- run the listener reactor until httpd-stop is called.
;;;
;;; Since: Phase H1

(defn httpd-run [h : ptr<void>]
  #fx{Net}
  : nil
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  tur_reactor_run(hb->reactor);
  ```)
;;; httpd-stop -- signal the listener to stop accepting new connections.
;;;
;;; Thread-safe. Stops the listener reactor and closes the shared queue
;;; so workers exit when drained.
;;;
;;; Since: Phase H1

(defn httpd-stop [h : ptr<void>]
  #fx{Net}
  : nil
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  hb->stop_flag = 1;
  /* Close the listener NOW, not at httpd-free (same rationale as
   * httpd-stop-async): the kernel completes handshakes into the backlog
   * whether or not accept() ever runs, so a connection racing the stop
   * would otherwise sit ESTABLISHED, unanswered, until httpd-free -- and a
   * peer blocked in recv() on it may be what the caller is joining first. */
  if (hb->listen_fd >= 0) { close(hb->listen_fd); hb->listen_fd = -1; }
  if (hb->reactor) {
      tur_reactor_stop(hb->reactor);
      tur_reactor_wake(hb->reactor);
  }
  pthread_mutex_lock(&hb->fdq_mtx);
  hb->fdq_closed = 1;
  pthread_cond_broadcast(&hb->fdq_cv);
  pthread_mutex_unlock(&hb->fdq_mtx);
  ```)
;;; httpd-free -- free all resources after httpd-run returns.
;;;
;;; Joins the worker threads, removes the reactor source, frees the
;;; reactor and synthetic accept closure, closes the listen socket,
;;; drains and frees the shared queue, and frees the HttpdBlock.
;;;
;;; Since: Phase H1

(defn httpd-free [h : ptr<void>] : nil
  ```c
  typedef struct {
      int listen_fd; int64_t handler;
      void *reactor; int listen_src_id; void *accept_clos;
      pthread_t *workers; int n_workers;
      int *fdq; int fdq_head; int fdq_tail; int fdq_count; int fdq_cap;
      int fdq_closed;
      pthread_mutex_t fdq_mtx;
      pthread_cond_t  fdq_cv;
      volatile int stop_flag;
      void *tls_ctx;
      int   fdq_max;     /* pending-connection cap; 0 = unlimited */
  } HttpdBlock;
  HttpdBlock *hb = (HttpdBlock *)h;
  if (hb->workers) {
      for (int i = 0; i < hb->n_workers; i++)
          pthread_join(hb->workers[i], NULL);
      free(hb->workers);
  }
  if (hb->reactor) {
      if (hb->listen_src_id >= 0) tur_reactor_remove(hb->reactor, hb->listen_src_id);
      tur_reactor_free(hb->reactor);
  }
  /* accept_clos is a hand-rolled synthetic { __fn, hb } box (no codegen
   * drop-glue header), so it is freed with a plain free -- NOT TUR_CLOSURE_DROP,
   * which would read a header 8 bytes before this un-headered allocation. */
  if (hb->accept_clos) free(hb->accept_clos);
  /* Free the user handler box. It is passed ^fat (always a heap fat-closure
   * box) and nothing else frees it, so this is the sole free -- no double free.
   * For a bare handler this reclaims the whole thing; for a compose-middleware
   * onion, TUR_CLOSURE_DROP releases the outermost layer AND (under
   * closure-drop-glue, graduated 2026-07-22) walks the inner captured `next` boxes via the
   * env's drop-glue header, so the whole onion is freed.  Flag-off,
   * TUR_CLOSURE_DROP is a plain free of the outer box (the inner boxes leak, as
   * before). */
  if (hb->handler) TUR_CLOSURE_DROP(hb->handler);
  if (hb->listen_fd >= 0) close(hb->listen_fd);
  if (hb->fdq) {
      /* Close any pending fds we never got to. */
      while (hb->fdq_count > 0) {
          close(hb->fdq[hb->fdq_head]);
          hb->fdq_head = (hb->fdq_head + 1) % hb->fdq_cap;
          hb->fdq_count--;
      }
      free(hb->fdq);
  }
  pthread_mutex_destroy(&hb->fdq_mtx);
  pthread_cond_destroy(&hb->fdq_cv);
  free(hb);
  ```)
;;; httpd-req-method -- return the HTTP method from the parsed request.
