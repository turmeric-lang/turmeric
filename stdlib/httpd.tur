;;; httpd-resp-status! -- set the HTTP response status code.
;;;
;;; Since: Phase H1

(defn httpd-resp-status! [conn : ptr<void> status : int] : nil
  ```c
  ((HttpdConn *)conn)->resp_status = (int)status;
  ```)
;;; httpd-resp-body! -- set the HTTP response body (copies the string).
;;;
;;; Since: Phase H1

(defn httpd-resp-body! [conn : ptr<void> body : cstr] : nil
  ```c
  HttpdConn *c = (HttpdConn *)conn;
  if (c->resp_body) { free(c->resp_body); c->resp_body = NULL; c->resp_body_len = 0; }
  if (!body) return;
  size_t len = strlen(body);
  c->resp_body = (char *)malloc(len + 1);
  if (!c->resp_body) return;
  memcpy(c->resp_body, body, len + 1);
  c->resp_body_len = (int)len;
  ```)
;;; httpd-resp-body-bytes! -- binary-safe response body setter.
;;;
;;; Like httpd-resp-body! but takes a (ptr, byte-count) pair instead of a
;;; NUL-terminated cstr, so the body may contain embedded NUL bytes
;;; (e.g. gzip output, raw binary payloads).  Copies `len` bytes from
;;; `bytes` into a fresh response-body allocation; the writer emits
;;; exactly `len` bytes regardless of any embedded NULs.
;;;
;;; Parameters:
;;;   conn  -- connection handle from the worker
;;;   bytes -- pointer to raw payload (may contain NUL bytes)
;;;   len   -- byte count to copy
;;;
;;; Example:
;;;   (httpd-resp-body-bytes! c gzip-data gzip-len)
;;;
;;; Since: Phase H8 (M6)

(defn httpd-resp-body-bytes! [conn : ptr<void> bytes : ptr<void> len : int] : nil
  ```c
  HttpdConn *c = (HttpdConn *)conn;
  if (c->resp_body) { free(c->resp_body); c->resp_body = NULL; c->resp_body_len = 0; }
  if (!bytes || len <= 0) return;
  c->resp_body = (char *)malloc((size_t)len + 1);
  if (!c->resp_body) return;
  memcpy(c->resp_body, bytes, (size_t)len);
  c->resp_body[len] = '\0';
  c->resp_body_len = (int)len;
  ```)
;; =============================================================================
;; M0: Arbitrary request / response header access
;; =============================================================================
;;
;; The H1-H7 surface only exposed Method, Path, Version, Body, Status.
;; M0 widens this so middleware can read any request header by name and
;; set/append any response header.  All header storage is per-iteration
;; (freed in httpd-handle's cleanup); handlers never need to free.
;;
;; Request reads are case-insensitive; missing headers return "".
;; Response writes:
;;   - `httpd-resp-header!`     replaces any existing entry with `name`.
;;   - `httpd-resp-header-add!` always appends (for `Set-Cookie`, `Vary`).
;;   - A user-set `Content-Length` is silently dropped by the writer
;;     (the actual response body length is authoritative).
;;   - If no `Content-Type` is set, the writer defaults to
;;     `text/plain; charset=utf-8`.
;;; httpd-req-header -- look up a request header by name (case-insensitive).
;;;
;;; Returns the empty string if the header is absent.
;;;
;;; Parameters:
;;;   conn -- connection handle from the worker
;;;   name -- header name to look up (case-insensitive)
;;;
;;; Returns:
;;;   The header value as a cstr (pointer into per-request storage; valid
;;;   only for the duration of the handler call). Empty string if absent.
;;;
;;; Example:
;;;   (let [ua (httpd-req-header c "User-Agent")] ...)
;;;
;;; Since: Phase H8 (M0)

(defn httpd-req-header [conn : ptr<void> name : cstr] : cstr
  ```c
  if (!conn || !name) return "";
  HttpdHeader *h = (HttpdHeader *)((HttpdConn *)conn)->req_headers;
  while (h) {
      if (h->name && strcasecmp(h->name, name) == 0) {
          return h->value ? h->value : "";
      }
      h = h->next;
  }
  return "";
  ```)
;;; httpd-req-header? -- presence test for a request header.
;;;
;;; Parameters:
;;;   conn -- connection handle from the worker
;;;   name -- header name (case-insensitive)
;;;
;;; Returns:
;;;   1 if present, 0 otherwise.
;;;
;;; Example:
;;;   (when (= 1 (httpd-req-header? c "Authorization")) ...)
;;;
;;; Since: Phase H8 (M0)

(defn httpd-req-header? [conn : ptr<void> name : cstr] : int
  ```c
  if (!conn || !name) return 0;
  HttpdHeader *h = (HttpdHeader *)((HttpdConn *)conn)->req_headers;
  while (h) {
      if (h->name && strcasecmp(h->name, name) == 0) return 1;
      h = h->next;
  }
  return 0;
  ```)
;;; httpd-resp-header! -- set (or replace) a response header.
;;;
;;; If `name` is already present on the response, its value is replaced.
;;; Otherwise a new entry is appended.  Use `httpd-resp-header-add!` for
;;; truly repeatable headers like `Set-Cookie` or `Vary`.
;;;
;;; Parameters:
;;;   conn  -- connection handle from the worker
;;;   name  -- header name (case-insensitive on the dedup check)
;;;   value -- header value
;;;
;;; Example:
;;;   (httpd-resp-header! c "Content-Type" "application/json")
;;;
;;; Since: Phase H8 (M0)

(defn httpd-resp-header! [conn : ptr<void> name : cstr value : cstr] : nil
  ```c
  if (!conn || !name) return;
  HttpdConn *c = (HttpdConn *)conn;
  /* Replace if name already present. */
  HttpdHeader *h = (HttpdHeader *)c->resp_headers;
  while (h) {
      if (h->name && strcasecmp(h->name, name) == 0) {
          if (h->value) free(h->value);
          size_t vl = value ? strlen(value) : 0;
          h->value = (char *)malloc(vl + 1);
          if (h->value) {
              if (vl > 0) memcpy(h->value, value, vl);
              h->value[vl] = '\0';
          }
          return;
      }
      h = h->next;
  }
  /* Append new entry. */
  HttpdHeader *nh = (HttpdHeader *)calloc(1, sizeof(HttpdHeader));
  if (!nh) return;
  size_t nl = strlen(name);
  size_t vl = value ? strlen(value) : 0;
  nh->name  = (char *)malloc(nl + 1);
  nh->value = (char *)malloc(vl + 1);
  if (!nh->name || !nh->value) {
      if (nh->name)  free(nh->name);
      if (nh->value) free(nh->value);
      free(nh);
      return;
  }
  memcpy(nh->name, name, nl); nh->name[nl] = '\0';
  if (vl > 0) memcpy(nh->value, value, vl);
  nh->value[vl] = '\0';
  /* Append at tail. */
  HttpdHeader *t = (HttpdHeader *)c->resp_headers;
  if (!t) { c->resp_headers = nh; return; }
  while (t->next) t = t->next;
  t->next = nh;
  ```)
;;; httpd-resp-header-add! -- append a response header without de-duplication.
;;;
;;; Use for headers that legitimately repeat -- `Set-Cookie`, `Vary`,
;;; `WWW-Authenticate` -- where each entry is independent.  For single-
;;; valued headers, prefer `httpd-resp-header!`.
;;;
;;; Parameters:
;;;   conn  -- connection handle from the worker
;;;   name  -- header name
;;;   value -- header value
;;;
;;; Example:
;;;   (httpd-resp-header-add! c "Set-Cookie" "session=abc; Path=/")
;;;   (httpd-resp-header-add! c "Set-Cookie" "csrf=xyz; Path=/")
;;;
;;; Since: Phase H8 (M0)

(defn httpd-resp-header-add! [conn : ptr<void> name : cstr value : cstr] : nil
  ```c
  if (!conn || !name) return;
  HttpdConn *c = (HttpdConn *)conn;
  HttpdHeader *nh = (HttpdHeader *)calloc(1, sizeof(HttpdHeader));
  if (!nh) return;
  size_t nl = strlen(name);
  size_t vl = value ? strlen(value) : 0;
  nh->name  = (char *)malloc(nl + 1);
  nh->value = (char *)malloc(vl + 1);
  if (!nh->name || !nh->value) {
      if (nh->name)  free(nh->name);
      if (nh->value) free(nh->value);
      free(nh);
      return;
  }
  memcpy(nh->name, name, nl); nh->name[nl] = '\0';
  if (vl > 0) memcpy(nh->value, value, vl);
  nh->value[vl] = '\0';
  HttpdHeader *t = (HttpdHeader *)c->resp_headers;
  if (!t) { c->resp_headers = nh; return; }
  while (t->next) t = t->next;
  t->next = nh;
  ```)
;; =============================================================================
;; M2: Cookie middleware (depends on M0)
;; =============================================================================
;;
;; Cookies live as request headers (`Cookie: a=1; b=2`) and response headers
;; (`Set-Cookie: ...`, possibly repeated).  M2 layers a small read + write
;; surface on top of M0.
;;
;; Read:
;;   (httpd-req-cookie conn name)    -- parsed value, "" if absent
;;
;; Write:
;;   (httpd-set-cookie! conn opts)   -- emits Set-Cookie via header-add!
;;   (cookie name value)             -- CookieOpts with sensible defaults
;;   (cookie-full name value path
;;                domain max-age
;;                secure http-only
;;                same-site)         -- CookieOpts with everything explicit
;;
;; Defaults from `cookie`:
;;   Path=/, no Domain, no Max-Age (session cookie), HttpOnly, SameSite=Lax,
;;   not Secure (caller must opt in -- typically required on TLS).
;;; httpd-req-cookie -- read a single cookie value from the Cookie: header.
;;;
;;; Parses the request's `Cookie:` header (using httpd-req-header) into
;;; name=value pairs separated by `;` and returns the value for `name`.
;;; Case-sensitive on the cookie name (per RFC 6265).
;;;
;;; Parameters:
;;;   conn -- connection handle from the worker
;;;   name -- cookie name to look up (case-sensitive)
;;;
;;; Returns:
;;;   The cookie's value as a heap-allocated cstr, OR the empty string ""
;;;   if the header is absent or the cookie is not present.
;;;
;;;   NOTE: when the cookie IS found, the returned cstr is a fresh malloc
;;;   that the runtime treats as per-call ownership; do not free.  When
;;;   absent the returned pointer is a literal "" and also need not be
;;;   freed.
;;;
;;; Example:
;;;   (let [sid (httpd-req-cookie c "session")]
;;;     (if (= (cstr-len sid) 0) ...))
;;;
;;; Since: Phase H8 (M2)

(defn httpd-req-cookie [conn : ptr<void> name : cstr] : cstr
  ```c
  if (!conn || !name || !*name) return "";
  HttpdHeader *h = (HttpdHeader *)((HttpdConn *)conn)->req_headers;
  const char *cookie_hdr = NULL;
  while (h) {
      if (h->name && strcasecmp(h->name, "Cookie") == 0) {
          cookie_hdr = h->value ? h->value : "";
          break;
      }
      h = h->next;
  }
  if (!cookie_hdr) return "";
  size_t nlen = strlen(name);
  const char *p = cookie_hdr;
  while (*p) {
      /* Skip leading whitespace / separators. */
      while (*p == ' ' || *p == '\t' || *p == ';') p++;
      if (!*p) break;
      const char *kstart = p;
      while (*p && *p != '=' && *p != ';') p++;
      size_t klen = (size_t)(p - kstart);
      const char *vstart = NULL;
      size_t vlen = 0;
      if (*p == '=') {
          p++;
          vstart = p;
          while (*p && *p != ';') p++;
          vlen = (size_t)(p - vstart);
      }
      if (klen == nlen && strncmp(kstart, name, nlen) == 0) {
          char *out = (char *)malloc(vlen + 1);
          if (!out) return "";
          if (vlen > 0) memcpy(out, vstart, vlen);
          out[vlen] = '\0';
          /* httpd-request-accessor-cstr-leak: register the fresh malloc on the
           * per-request owned-cstr list so httpd-handle's cleanup frees it at
           * request end -- the docstring's "per-call ownership; do not free"
           * contract is now actually implemented. */
          return httpd_conn_own_cstr((HttpdConn *)conn, out);
      }
  }
  return "";
  ```)
;;; CookieOpts -- fully-specified Set-Cookie attributes.
;;;
;;; Field conventions:
;;;   path       -- "" omits the Path attribute
;;;   domain     -- "" omits the Domain attribute
;;;   max-age    -- -1 omits the Max-Age attribute; 0 expires immediately
;;;   secure     -- 0 / 1: include the "Secure" flag
;;;   http-only  -- 0 / 1: include the "HttpOnly" flag
;;;   same-site  -- "" omits; "Lax" / "Strict" / "None" otherwise
;;;
;;; Since: Phase H8 (M2)

(defstruct CookieOpts
  [name : cstr
   value : cstr
   path : cstr
   domain : cstr
   max-age : int
   secure : int
   http-only : int
   same-site : cstr])
;;; cookie -- construct a CookieOpts with sensible defaults.
;;;
;;; Defaults: Path=/, no Domain, no Max-Age (session cookie), not Secure
;;; (callers on TLS should opt in via `cookie-full`), HttpOnly,
;;; SameSite=Lax.
;;;
;;; Parameters:
;;;   name  -- cookie name
;;;   value -- cookie value
;;;
;;; Example:
;;;   (httpd-set-cookie! c (cookie "session" "abc123"))
;;;
;;; Since: Phase H8 (M2)

(defn cookie [name : cstr value : cstr] : CookieOpts
  (make-struct CookieOpts name value "/" "" -1 0 1 "Lax"))
;;; cookie-full -- construct a CookieOpts with every attribute explicit.
;;;
;;; Use this when the defaults from `cookie` are wrong, e.g. cross-site
;;; flows that need SameSite=None + Secure, or long-lived cookies that
;;; need a Max-Age.  See `CookieOpts` for the per-field semantics.
;;;
;;; Example:
;;;   (httpd-set-cookie! c (cookie-full "tracking" "t1" "/api" "example.com"
;;;                                     3600 1 0 "None"))
;;;
;;; Since: Phase H8 (M2)

(defn cookie-full [name : cstr
                   value : cstr
                   path : cstr
                   domain : cstr
                   max-age : int
                   secure : int
                   http-only : int
                   same-site : cstr] : CookieOpts
  (make-struct CookieOpts
    name
    value
    path
    domain
    max-age
    secure
    http-only
    same-site))
;;; httpd-set-cookie! -- emit a Set-Cookie response header from a CookieOpts.
;;;
;;; Serialises the opts into a single `Set-Cookie` value and appends it
;;; via `httpd-resp-header-add!`.  Calling this multiple times produces
;;; multiple Set-Cookie lines, as RFC 6265 requires.
;;;
;;; Parameters:
;;;   conn -- connection handle from the worker
;;;   opts -- CookieOpts value (typically built by `cookie` or `cookie-full`)
;;;
;;; Example:
;;;   (httpd-set-cookie! c (cookie "session" "abc123"))
;;;
;;; Since: Phase H8 (M2); requires the DS1 fix in
;;;        docs/archive/history/defstruct-inline-c-byvalue-callsite-plan.md.

(defn httpd-set-cookie! [conn : ptr<void> opts : CookieOpts] : nil
  ```c
  if (!conn) return;
  const char *cname  = opts.name      ? opts.name      : "";
  const char *cval   = opts.value     ? opts.value     : "";
  const char *cpath  = opts.path      ? opts.path      : "";
  const char *cdom   = opts.domain    ? opts.domain    : "";
  const char *csame  = opts.same_site ? opts.same_site : "";
  if (!*cname) return;
  /* Sized to the attributes rather than a fixed 2 KiB: the old buffer summed
   * snprintf's would-be lengths into n, so once name=value passed 2 KiB,
   * sizeof(buf) - n wrapped and the next attribute was written past the end
   * of the stack buffer (security-audit-plan M-4). */
  size_t cap = strlen(cname) + strlen(cval) + strlen(cpath) + strlen(cdom)
             + strlen(csame) + 128;
  char *buf = (char *)malloc(cap);
  if (!buf) return;
  size_t n = 0;
  #define HTTPD_COOKIE_ADD(...) do { \
      int w_ = snprintf(buf + n, cap - n, __VA_ARGS__); \
      if (w_ > 0) n += ((size_t)w_ < cap - n) ? (size_t)w_ : cap - n - 1; \
  } while (0)
  HTTPD_COOKIE_ADD("%s=%s", cname, cval);
  if (*cpath)              HTTPD_COOKIE_ADD("; Path=%s",   cpath);
  if (*cdom)               HTTPD_COOKIE_ADD("; Domain=%s", cdom);
  if (opts.max_age >= 0)   HTTPD_COOKIE_ADD("; Max-Age=%lld", (long long)opts.max_age);
  if (opts.secure)         HTTPD_COOKIE_ADD("; Secure");
  if (opts.http_only)      HTTPD_COOKIE_ADD("; HttpOnly");
  if (*csame)              HTTPD_COOKIE_ADD("; SameSite=%s", csame);
  #undef HTTPD_COOKIE_ADD
  __TUR_CNAME_httpd-resp-header-add!__((void *)conn, "Set-Cookie", buf);
  free(buf);
  ```)
;; =============================================================================
;; M3: Body parsers -- URL-encoded forms + JSON
;; =============================================================================
;;
;; Both parsers branch on the request's `Content-Type:` header (read via
;; httpd-req-header) and operate over the already-buffered body.
;;
;; URL-encoded (application/x-www-form-urlencoded):
;;   (httpd-req-form conn field)        -- single value, decoded; "" if absent
;;   (See http-mw-form fixture for usage; key percent-decoding is not yet
;;    supported -- field names should be plain ASCII.)
;;
;; JSON (application/json):
;;   (httpd-req-json conn)              -- json/decode tree, cached per-iteration
;;   (mw-json-body next)                -- pre-parse middleware; 400 on malformed
;;
;; Both surfaces are pure Turmeric on top of M0; only the JSON cache field
;; on HttpdConn (req_json_cache) and its iteration-cleanup hook touch the
;; C core (see httpd-handle).
;;; httpd-req-form -- look up a single URL-encoded form field by name.
;;;
;;; Walks the request body (which must already have been received -- the
;;; worker reads Content-Length bytes) looking for `name=value` separated
;;; by `&`. The value is percent-decoded and `+` is converted to ` ` per
;;; the application/x-www-form-urlencoded convention.
;;;
;;; Parameters:
;;;   conn  -- connection handle from the worker
;;;   field -- form field name (case-sensitive, plain ASCII)
;;;
;;; Returns:
;;;   The decoded value as a heap-allocated cstr (per-call ownership;
;;;   do not free explicitly -- the runtime drops it after the handler
;;;   returns).  Empty string "" when the field is absent or the body
;;;   is empty.
;;;
;;; Example:
;;;   (let [user (httpd-req-form c "username")
;;;         pw   (httpd-req-form c "password")] ...)
;;;
;;; Since: Phase H8 (M3)

(defn httpd-req-form [conn : ptr<void> field : cstr] : cstr
  ```c
  if (!conn || !field || !*field) return "";
  HttpdConn *c = (HttpdConn *)conn;
  if (!c->body || c->body_len <= 0) return "";
  size_t flen = strlen(field);
  const char *p   = c->body;
  const char *end = c->body + c->body_len;
  while (p < end) {
      const char *kstart = p;
      while (p < end && *p != '=' && *p != '&') p++;
      size_t klen = (size_t)(p - kstart);
      const char *vstart = NULL;
      const char *vend   = NULL;
      if (p < end && *p == '=') {
          p++;
          vstart = p;
          while (p < end && *p != '&') p++;
          vend = p;
      }
      if (klen == flen && strncmp(kstart, field, flen) == 0) {
          size_t vlen = vend ? (size_t)(vend - vstart) : 0;
          char *out = (char *)malloc(vlen + 1);
          if (!out) return "";
          size_t oi = 0;
          for (size_t i = 0; i < vlen; i++) {
              char ch = vstart[i];
              if (ch == '+') {
                  out[oi++] = ' ';
              } else if (ch == '%' && i + 2 < vlen) {
                  char hex[3] = { vstart[i+1], vstart[i+2], '\0' };
                  /* strtoul rejects bad hex -> 0; that's fine here. */
                  unsigned long uv = strtoul(hex, NULL, 16);
                  out[oi++] = (char)uv;
                  i += 2;
              } else {
                  out[oi++] = ch;
              }
          }
          out[oi] = '\0';
          /* httpd-request-accessor-cstr-leak: register on the per-request
           * owned-cstr list so httpd-handle's cleanup frees it at request end. */
          return httpd_conn_own_cstr(c, out);
      }
      if (p < end && *p == '&') p++;
  }
  return "";
  ```)
;;; httpd-req-json -- lazily parse the request body as JSON.
;;;
;;; First call invokes `json/decode` on the request body and caches the
;;; resulting node tree on the connection (req_json_cache).  Subsequent
;;; calls return the cached pointer.  The iteration cleanup in
;;; httpd-handle calls `json/free` so handlers never free explicitly.
;;;
;;; Returns 0 (nil tree) when the body is absent or json/decode fails
;;; on the input; use `mw-json-body` if you want a 400 short-circuit on
;;; malformed JSON.
;;;
;;; Parameters:
;;;   conn -- connection handle from the worker
;;;
;;; Returns:
;;;   The parsed JSON node tree as an :int (the json stdlib carrier), or
;;;   0 when there is no body / parse failed.
;;;
;;; Example:
;;;   (let [doc (httpd-req-json c)
;;;         nm  (json/get-string (json/get! doc "name"))]
;;;     (httpd-resp-body! c nm))
;;;
;;; Since: Phase H8 (M3)

(defn httpd-req-json [conn : ptr<void>] : int
  ```c
  if (!conn) return 0;
  HttpdConn *c = (HttpdConn *)conn;
  if (c->req_json_cache) return c->req_json_cache;
  if (!c->body || c->body_len <= 0) return 0;
  /* json_sldecode is the C name for json/decode. */
  int64_t tree = json_sldecode(c->body);
  c->req_json_cache = tree;
  return tree;
  ```)
;;; mw-json-body -- pre-parse the JSON body, 400 on failure.
;;;
;;; Wraps a base handler so that, before `next` runs, the request body is
;;; parsed via httpd-req-json.  On parse failure (json/decode returned 0
;;; AND the body is non-empty) the middleware sets status 400 with a
;;; small text body and does NOT call `next`.  On success the cached
;;; tree is available to the inner handler via httpd-req-json, which
;;; returns the same pointer.
;;;
;;; Tip: only wrap routes that genuinely require a JSON body; an empty
;;; body or a route that does not expect JSON should not 400.  Check
;;; `(= "application/json" (httpd-req-header c "Content-Type"))` at the
;;; route layer if you want stricter gating.
;;;
;;; Example:
;;;   (let [composed (compose-middleware base mw-json-body)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M3)

(defn mw-json-body [^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (let [_n next]
    (fn [c : ptr<void>] : nil
      (if (= 1 (httpd-mw-json-body-precheck c))
        (do
          (httpd-resp-status! c 400)
          (httpd-resp-body! c "malformed JSON body"))
        (httpd-call _n c)))))
;;; httpd-mw-json-body-precheck -- internal: returns 1 when the body is
;;; non-empty but json/decode failed, 0 otherwise. Used by mw-json-body
;;; to drive the 400 short-circuit; lives as a fixed-arity helper so the
;;; if-form inside mw-json-body can stay in Turmeric.

(defn httpd-mw-json-body-precheck [conn : ptr<void>] : int
  ```c
  if (!conn) return 0;
  HttpdConn *c = (HttpdConn *)conn;
  if (!c->body || c->body_len <= 0) return 0;  /* empty body -> not malformed */
  if (c->req_json_cache) return 0;             /* already parsed once -> ok */
  int64_t tree = json_sldecode(c->body);
  if (tree == 0) return 1;                     /* parse failed -> malformed */
  c->req_json_cache = tree;
  return 0;
  ```)
;; =============================================================================
;; M4: CORS middleware -- preflight short-circuit + response decoration
;; =============================================================================
;;
;; mw-cors handles two cases:
;;
;;   1. Preflight (an `OPTIONS` request carrying `Access-Control-Request-
;;      Method`): short-circuit with 204 and the appropriate
;;      Access-Control-Allow-* headers, without calling `next`.
;;
;;   2. Normal request: call `next`, then decorate the response with
;;      Access-Control-Allow-Origin (and Allow-Credentials / Expose-Headers
;;      when configured).
;;
;; Caveat: `allow-origin = "*"` combined with `allow-credentials = 1` is
;; INVALID per the CORS spec.  Browsers reject the response and the
;; request fails.  Either echo the request's `Origin:` or list specific
;; origins when credentials are required.
;;; CorsOpts -- mw-cors configuration.
;;;
;;; Field conventions:
;;;   allow-origin      -- single value; "*" for any (no credentials),
;;;                        or a specific origin
;;;   allow-methods     -- comma-separated list emitted on preflight
;;;   allow-headers     -- comma-separated list emitted on preflight
;;;   expose-headers    -- comma-separated list emitted on normal responses
;;;                        (or "" to omit)
;;;   allow-credentials -- 0 / 1; emits Allow-Credentials: true on both paths
;;;   max-age           -- preflight cache lifetime in seconds, or -1 to omit
;;;
;;; Since: Phase H8 (M4)

(defstruct CorsOpts
  [allow-origin : cstr
   allow-methods : cstr
   allow-headers : cstr
   expose-headers : cstr
   allow-credentials : int
   max-age : int])
;;; default-cors-opts -- permissive defaults suitable for development.
;;;
;;; allow-origin = "*", standard set of methods, Content-Type allowed,
;;; no expose-headers, no credentials, no max-age.  Tighten for prod.
;;;
;;; Since: Phase H8 (M4)

(defn default-cors-opts [] : CorsOpts
  (make-struct CorsOpts
    "*"
    "GET, POST, PUT, DELETE, OPTIONS"
    "Content-Type"
    ""
    0
    -1))
;;; httpd-mw-cors-is-preflight -- internal: 1 iff this is a CORS preflight.

(defn httpd-mw-cors-is-preflight [conn : ptr<void>] : int
  ```c
  if (!conn) return 0;
  const char *m = httpd_hyreq_hymethod((void *)conn);
  if (!m || strcmp(m, "OPTIONS") != 0) return 0;
  return __TUR_CNAME_httpd-req-header?__((void *)conn, "Access-Control-Request-Method");
  ```)
;;; httpd-mw-cors-emit-preflight -- internal: write the preflight response.
;;;
;;; Takes primitive fields rather than a CorsOpts value.  This originally
;;; side-stepped a closure-capture codegen bug with by-pointer defstruct
;;; params (the inner closure env stored the caller's `const CorsOpts *`
;;; into a by-value field).  That bug is now fixed (see
;;; docs/archive/history/stdlib-type-erasure-cleanup-plan.md A5/B5), so a future
;;; refactor may capture a `CorsOpts` directly; the primitive surface is
;;; retained for now to keep this change scoped to the codegen fix.

(defn httpd-mw-cors-emit-preflight [conn : ptr<void>
                                    allow-origin : cstr
                                    allow-methods : cstr
                                    allow-headers : cstr
                                    allow-credentials : int
                                    max-age : int] : nil
  ```c
  if (!conn) return;
  __TUR_CNAME_httpd-resp-status!__((void *)conn, 204);
  __TUR_CNAME_httpd-resp-body!__((void *)conn, "");
  const char *ao = allow_origin  ? allow_origin  : "*";
  const char *am = allow_methods ? allow_methods : "";
  const char *ah = allow_headers ? allow_headers : "";
  __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Allow-Origin",  ao);
  if (*am) __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Allow-Methods", am);
  if (*ah) __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Allow-Headers", ah);
  if (allow_credentials) {
      __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Allow-Credentials", "true");
  }
  if (max_age >= 0) {
      char buf[32];
      snprintf(buf, sizeof(buf), "%lld", (long long)max_age);
      __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Max-Age", buf);
  }
  ```)
;;; httpd-mw-cors-decorate -- internal: decorate a normal-flow response.

(defn httpd-mw-cors-decorate [conn : ptr<void>
                              allow-origin : cstr
                              expose-headers : cstr
                              allow-credentials : int] : nil
  ```c
  if (!conn) return;
  const char *ao = allow_origin   ? allow_origin   : "*";
  const char *eh = expose_headers ? expose_headers : "";
  __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Allow-Origin", ao);
  if (*eh) __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Expose-Headers", eh);
  if (allow_credentials) {
      __TUR_CNAME_httpd-resp-header!__((void *)conn, "Access-Control-Allow-Credentials", "true");
  }
  ```)
;;; mw-cors-with -- CORS middleware factory (positional args).
;;;
;;; (mw-cors-with ao am ah eh ac ma) is a one-arg function suitable for
;;; compose-middleware: given a downstream handler `next`, returns a
;;; wrapped handler that either short-circuits a preflight or decorates
;;; the normal response.
;;;
;;; For a struct-valued, curry-friendly equivalent, use `mw-cors-opts`:
;;; `(mw-cors-opts opts)` partially applies a `CorsOpts` value and returns a
;;; one-arg middleware usable directly in `compose-middleware`.  The curried
;;; `__pap` env that captures the `CorsOpts` value once triggered a codegen
;;; bug (a struct stored into an `int64_t` env field); that bug is now fixed
;;; (stdlib-type-erasure-cleanup-plan A5/B5).
;;;
;;; See `CorsOpts` / `default-cors-opts` for field semantics.
;;;
;;; Example:
;;;   (compose-middleware base
;;;     (mw-cors-with "https://app.example.com"
;;;                   "GET, POST, OPTIONS"
;;;                   "Content-Type, Authorization"
;;;                   "" 1 60))
;;;
;;; Since: Phase H8 (M4)
;;; httpd-cors-own-str -- internal: heap-copy a cstr for a server-lifetime
;;; capture, preserving NULL.
;;;
;;; mw-cors-with stores its origin/methods/headers strings in a middleware
;;; closure that lives for the whole server run.  Capturing the caller's cstr
;;; BY BORROW dangles if the caller passed a computed/freed buffer (see
;;; string-adoption-stdlib-plan.md, items 2/3).  This returns an OWNED String
;;; (a refcounted copy) the closure keeps for its lifetime.  Under
;;; With closure-drop-glue (graduated 2026-07-22) the String is a Drop-typeclass capture, so the
;;; closure's drop-glue releases it when the middleware is torn down (Model R);
;;; flag-off it lives to process exit, as before.

(defn httpd-cors-own-str [s : cstr] : String (string/from-cstr s))

(defn mw-cors-with [allow-origin : cstr
                    allow-methods : cstr
                    allow-headers : cstr
                    expose-headers : cstr
                    allow-credentials : int
                    max-age : int
                    ^fat next : (fn [ptr<void>] nil)] : ptr<void>
  ;; Own the captured strings so the server-lifetime closure never holds a
  ;; borrowed pointer into a caller buffer that may be freed (the dangling
  ;; hazard when allow-origin/headers are computed rather than literals).  The
  ;; owned String captures are Drop-released by the closure drop-glue (Model R);
  ;; the emit helpers take a borrowed `cstr` view via string/to-cstr.
  (let [_ao (httpd-cors-own-str allow-origin)
        _am (httpd-cors-own-str allow-methods)
        _ah (httpd-cors-own-str allow-headers)
        _eh (httpd-cors-own-str expose-headers)
        _ac allow-credentials
        _ma max-age
        _n  next]
    (fn [c : ptr<void>] : nil
      (if (= 1 (httpd-mw-cors-is-preflight c))
        (httpd-mw-cors-emit-preflight c
          (string/to-cstr _ao)
          (string/to-cstr _am)
          (string/to-cstr _ah)
          _ac
          _ma)
        (do
          (httpd-call _n c)
          (httpd-mw-cors-decorate c
            (string/to-cstr _ao)
            (string/to-cstr _eh)
            _ac))))))
;;; mw-cors -- CORS middleware with permissive defaults.
;;;
;;; `(mw-cors next)` applies the `default-cors-opts` settings: allow-origin
;;; `*`, standard methods, Content-Type allowed, no credentials.  Use
;;; `mw-cors-with` for customised settings.
;;;
;;; Example:
;;;   (compose-middleware base mw-cors)
;;;
;;; Since: Phase H8 (M4)

(defn mw-cors [^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (mw-cors-with "*"
    "GET, POST, PUT, DELETE, OPTIONS"
    "Content-Type"
    ""
    0
    -1
    next))
;;; mw-cors-opts -- CORS middleware factory configured by a CorsOpts struct.
;;;
;;; `(mw-cors-opts opts next)` returns a wrapped handler; the curried form
;;; `(mw-cors-opts opts)` is a one-arg middleware value suitable for
;;; `compose-middleware`:
;;;
;;;   (compose-middleware base (mw-cors-opts my-opts))
;;;
;;; This is the struct-valued counterpart to the positional `mw-cors-with`.
;;; The curried partial application captures the `CorsOpts` value in the
;;; auto-generated `__pap` env; that codegen path was once broken (a struct
;;; stored into an `int64_t` env field) and is now fixed
;;; (stdlib-type-erasure-cleanup-plan A5/B5).
;;;
;;; Parameters:
;;;   opts -- a CorsOpts value (see `default-cors-opts`)
;;;   next -- downstream handler closure (fat-closure :int)
;;;
;;; Returns:
;;;   A wrapped handler closure (:ptr<void>) suitable for httpd-new /
;;;   compose-middleware.
;;;
;;; Example:
;;;   (let [opts     (default-cors-opts)
;;;         composed (compose-middleware base (mw-cors-opts opts))]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M4)

(defn mw-cors-opts [opts : CorsOpts ^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (mw-cors-with (.allow-origin opts)
    (.allow-methods opts)
    (.allow-headers opts)
    (.expose-headers opts)
    (.allow-credentials opts)
    (.max-age opts)
    next))
;; =============================================================================
;; M5: HTTP Basic Auth middleware
;; =============================================================================
;;
;; mw-basic-auth reads `Authorization: Basic <base64>` from the request,
;; base64-decodes the user:pass pair, and calls a user-supplied verifier
;; closure `(fn [user :cstr pass :cstr] :int)`.  On verifier failure the
;; middleware emits 401 + `WWW-Authenticate: Basic realm="..."` and does
;; NOT call `next`.
;;
;; Security caveats:
;;
;; * Basic Auth ships credentials in the clear (the base64 encoding is
;;   reversible).  Always run behind TLS in production -- see
;;   `httpd-new-tls` (Phase H5).
;;
;; * The verifier closure SHOULD use a constant-time comparison for the
;;   password check to avoid timing-leak attacks.  `cstr-eq-const-time`
;;   is provided as a convenience.
;;; cstr-eq-const-time -- length-then-constant-time XOR cstring compare.
;;;
;;; Returns 1 when both strings have the same length AND all bytes match,
;;; 0 otherwise.  The byte comparison runs over the full length even on
;;; the first mismatch, hiding the position of the difference from a
;;; timing observer.  The length check is variable-time (different
;;; lengths => clearly different secrets), which is the standard
;;; trade-off for cstring credential checks.
;;;
;;; Since: Phase H8 (M5)

(defn cstr-eq-const-time [a : cstr b : cstr] : int
  ```c
  if (!a || !b) return 0;
  size_t la = strlen(a);
  size_t lb = strlen(b);
  if (la != lb) return 0;
  unsigned char diff = 0;
  for (size_t i = 0; i < la; i++) diff |= (unsigned char)(a[i] ^ b[i]);
  return diff == 0 ? 1 : 0;
  ```)
;;; httpd-mw-basic-auth-check -- internal: decode + dispatch the verifier.

(defn httpd-mw-basic-auth-check [conn : ptr<void> verifier : int] : int
  ```c
  if (!conn || !verifier) return 0;
  const char *hdr = httpd_hyreq_hyheader((void *)conn, "Authorization");
  if (!hdr || !*hdr) return 0;
  /* Must start with "Basic ", case-insensitive. */
  if (strncasecmp(hdr, "Basic ", 6) != 0) return 0;
  const char *b64 = hdr + 6;
  while (*b64 == ' ') b64++;
  size_t blen = strlen(b64);
  if (blen == 0) return 0;
  /* Base64-decode into a per-call heap buffer.  Output size <= input size. */
  /* Designated initializers with ranges ([0 ... 255] = -1) are a GNU
   * extension that c2mir cannot parse, which pushed every httpd program to
   * the JIT's cc fallback.  Build the table at runtime instead. */
  signed char tab[256];
  for (int i = 0; i < 256; i++) tab[i] = -1;
  for (int i = 'A'; i <= 'Z'; i++) tab[i] = (signed char)(i - 'A');
  for (int i = 'a'; i <= 'z'; i++) tab[i] = (signed char)(i - 'a' + 26);
  for (int i = '0'; i <= '9'; i++) tab[i] = (signed char)(i - '0' + 52);
  tab[(int)'+'] = 62;
  tab[(int)'/'] = 63;
  char *raw = (char *)malloc(blen + 1);
  if (!raw) return 0;
  size_t   out  = 0;
  uint32_t buf  = 0;
  int      bits = 0;
  for (size_t i = 0; i < blen; i++) {
      char ch = b64[i];
      if (ch == '=' || ch == ' ' || ch == '\r' || ch == '\n') continue;
      signed char v = tab[(unsigned char)ch];
      if (v < 0) { free(raw); return 0; }   /* malformed */
      buf = (buf << 6) | (uint32_t)v;
      bits += 6;
      if (bits >= 8) {
          bits -= 8;
          raw[out++] = (char)((buf >> bits) & 0xFFu);
      }
  }
  raw[out] = '\0';
  /* A decoded NUL would truncate the user or password the verifier sees
   * ("secret\0junk" checked as "secret"): refuse the header instead. */
  if (memchr(raw, '\0', out)) { free(raw); return 0; }
  /* Split on the first ':' -- everything before is user, after is pass. */
  char *colon = (char *)memchr(raw, ':', out);
  if (!colon) { free(raw); return 0; }
  *colon = '\0';
  const char *user = raw;
  const char *pass = colon + 1;
  /* Call verifier (fat closure taking two cstr args, returning int). */
  int64_t *fat = (int64_t *)(intptr_t)verifier;
  typedef int64_t (*fn2_t)(void *, const char *, const char *);
  int64_t ok = ((fn2_t)(intptr_t)fat[0])((void *)fat, user, pass);
  /* MW2: on success, publish the verified username via httpd-set-attr!
   * so downstream handlers can read it back through (httpd-req-attr c "user"). */
  if (ok) __TUR_CNAME_httpd-set-attr!__((void *)conn, "user", user);
  free(raw);
  return (int)(ok ? 1 : 0);
  ```)
;;; httpd-mw-basic-auth-challenge -- internal: emit 401 + WWW-Authenticate.

(defn httpd-mw-basic-auth-challenge [conn : ptr<void> realm : cstr] : nil
  ```c
  if (!conn) return;
  __TUR_CNAME_httpd-resp-status!__((void *)conn, 401);
  __TUR_CNAME_httpd-resp-body!__((void *)conn, "Unauthorized");
  char buf[256];
  const char *r = (realm && *realm) ? realm : "restricted";
  snprintf(buf, sizeof(buf), "Basic realm=\"%s\"", r);
  __TUR_CNAME_httpd-resp-header!__((void *)conn, "WWW-Authenticate", buf);
  ```)
;;; mw-basic-auth -- HTTP Basic Auth middleware factory.
;;;
;;; `realm` is the value placed in the `WWW-Authenticate: Basic
;;; realm="..."` challenge.  `verifier` is a closure of type
;;; `(fn [user :cstr pass :cstr] :int)` returning 1 to authorise and
;;; 0 to reject.  Use `cstr-eq-const-time` in the verifier body for the
;;; password check.  The `verifier` parameter is `^fat`, so a bare
;;; non-capturing verifier is auto-shimmed into a fat closure -- it need
;;; not capture a free variable to be dispatched safely.
;;;
;;; ALWAYS run Basic Auth behind TLS (see `httpd-new-tls`); the encoding
;;; is reversible and traverses the wire in clear text otherwise.
;;;
;;; Example:
;;;   ;; Compare BOTH fields every time and combine the results: returning
;;;   ;; early on a wrong username tells a caller which usernames exist.
;;;   (let [verify (fn [u :cstr p :cstr] :int   ; captures nothing -- fine
;;;                  (let [u-ok (cstr-eq-const-time u "admin")
;;;                        p-ok (cstr-eq-const-time p "s3cret")]
;;;                    (* u-ok p-ok)))
;;;         composed (compose-middleware base (mw-basic-auth "app" verify))]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M5)

(defn mw-basic-auth [realm : cstr
                     ^fat verifier : (fn [cstr cstr] int)
                     ^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (let [_r realm
        _v verifier
        _n next]
    (fn [c : ptr<void>] : nil
      (if (= 1 (httpd-mw-basic-auth-check c _v))
        (httpd-call _n c)
        (httpd-mw-basic-auth-challenge c _r)))))
;; =============================================================================
;; M7: Multipart form-data parser
;; =============================================================================
;;
;; Parses `multipart/form-data` request bodies into a per-iteration linked
;; list of HttpdPart records kept on the conn (req_multipart_parts).
;; Parsing is lazy: the first call to httpd-req-file (or
;; httpd-req-multipart-count) triggers the walk.
;;
;; Surface:
;;   (httpd-req-file conn field)        -- handle (:ptr<void>) of part
;;                                         with form-field name = `field`,
;;                                         or 0 when absent
;;   (httpd-part-name part)             -- form field name
;;   (httpd-part-filename part)         -- file name attribute, or ""
;;   (httpd-part-content-type part)     -- "text/plain" / "application/octet-stream" / ...
;;   (httpd-part-data part)             -- raw bytes buffer (:ptr<void>)
;;   (httpd-part-data-len part)         -- byte count (:int)
;;
;; The Part struct is defined in C only; callers see opaque pointers and
;; go through the accessors above.  This avoids the defstruct-by-value
;; codegen issues that bit M2 / M4 and keeps the API binary-safe (Part
;; data is raw bytes, not a cstr -- it may contain embedded NULs).
;;
;; Limits:
;;   - Body size is already bounded by Content-Length at the worker
;;     read.  The parser additionally caps the number of parts at 64
;;     to defend against pathological inputs.
;;; httpd-req-multipart-parse -- internal: parse the body on first access.
;;; Returns 1 on success (parts list populated), 0 on absent / malformed
;;; / non-multipart content.

(defn httpd-req-multipart-parse [conn : ptr<void>] : int
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  if (!conn) return 0;
  HttpdConn *c = (HttpdConn *)conn;
  if (c->req_multipart_parts) return 1;
  if (!c->body || c->body_len <= 0) return 0;
  /* httpd-residual-request-hardening item 10.  Only a multipart media type
   * carries parts (RFC 7578), and `boundary` is a PARAMETER of it, matched by
   * name in any case (httpd_hdr_param) -- not the first "boundary=" anywhere
   * in the value, which a quoted `charset="boundary=x"` could supply.
   * RFC 2046 caps a boundary at 70 characters. */
  const char *ct = httpd_hyreq_hyheader((void *)conn, "Content-Type");
  if (!ct || !*ct) return 0;
  while (*ct == ' ' || *ct == '\t') ct++;
  if (strncasecmp(ct, "multipart/", 10) != 0) return 0;
  char boundary[128];
  int bi = httpd_hdr_param(ct, ct + strlen(ct), "boundary", boundary,
                           (int)sizeof(boundary));
  if (bi <= 0 || bi > 70) return 0;
  char delim[140];
  int dlen = snprintf(delim, sizeof(delim), "--%s", boundary);
  char crlf_delim[144];
  int cdlen = snprintf(crlf_delim, sizeof(crlf_delim), "\r\n%s", delim);
  if (dlen <= 0 || cdlen <= 0) return 0;
  HttpdPart *head = NULL;
  HttpdPart *tail = NULL;
  int n_parts = 0;
  /* Every search is bounded by the body's LENGTH (httpd_mp_find), never by a
   * NUL: an uploaded file may hold NUL bytes, and strstr stopped at the first
   * one -- truncating the part or losing every part after it. */
  const char *end = c->body + c->body_len;
  const char *pos = httpd_mp_find(c->body, end, delim, (size_t)dlen);
  if (!pos) return 0;
  pos += dlen;
  while (pos < end && n_parts < 64) {
      /* "--" right after the delimiter closes the body. */
      if (pos + 1 < end && pos[0] == '-' && pos[1] == '-') break;
      /* Transport padding, then the CRLF that ends the delimiter line. */
      while (pos < end && (*pos == ' ' || *pos == '\t')) pos++;
      if (pos + 1 < end && pos[0] == '\r' && pos[1] == '\n') pos += 2;
      else break;
      /* Part headers, up to the blank line.  A header is matched by its
       * whole field name (up to the colon), and its parameters by name, so
       * `name=` is never read out of `filename=` and a field called
       * `Content-Dispositionx` is not Content-Disposition. */
      char *p_name = NULL, *p_filename = NULL, *p_ctype = NULL;
      int headers_ok = 0;
      while (pos < end) {
          const char *eol = httpd_mp_find(pos, end, "\r\n", 2);
          if (!eol) break;
          if (eol == pos) { pos += 2; headers_ok = 1; break; }
          size_t llen = (size_t)(eol - pos);
          const char *colon = (const char *)memchr(pos, ':', llen);
          if (colon) {
              size_t fl = (size_t)(colon - pos);
              while (fl && (pos[fl - 1] == ' ' || pos[fl - 1] == '\t')) fl--;
              const char *vs = colon + 1;
              while (vs < eol && (*vs == ' ' || *vs == '\t')) vs++;
              if (fl == 19 && strncasecmp(pos, "Content-Disposition", 19) == 0) {
                  char *tmp = (char *)malloc(llen + 1);
                  if (tmp && httpd_hdr_param(vs, eol, "name", tmp, (int)llen + 1) >= 0) {
                      free(p_name);   /* a repeated header replaces, not leaks */
                      p_name = tmp;
                  } else {
                      free(tmp);
                  }
                  tmp = (char *)malloc(llen + 1);
                  if (tmp && httpd_hdr_param(vs, eol, "filename", tmp, (int)llen + 1) >= 0) {
                      free(p_filename);
                      p_filename = tmp;
                  } else {
                      free(tmp);
                  }
              } else if (fl == 12 && strncasecmp(pos, "Content-Type", 12) == 0) {
                  size_t vl = (size_t)(eol - vs);
                  free(p_ctype);
                  p_ctype = (char *)malloc(vl + 1);
                  if (p_ctype) { memcpy(p_ctype, vs, vl); p_ctype[vl] = '\0'; }
              }
          }
          pos = eol + 2;
      }
      /* Now `pos` points at the part body: it runs to the next CRLF-prefixed
       * delimiter.  Unterminated headers or body end the walk. */
      const char *bend = headers_ok
          ? httpd_mp_find(pos, end, crlf_delim, (size_t)cdlen) : NULL;
      if (!bend) {
          free(p_name);
          free(p_filename);
          free(p_ctype);
          break;
      }
      size_t blen = (size_t)(bend - pos);
      HttpdPart *part = (HttpdPart *)calloc(1, sizeof(HttpdPart));
      if (!part) {
          free(p_name);
          free(p_filename);
          free(p_ctype);
          break;
      }
      part->name         = p_name;
      part->filename     = p_filename;
      part->content_type = p_ctype;
      part->data         = (char *)malloc(blen + 1);
      if (part->data) {
          if (blen > 0) memcpy(part->data, pos, blen);
          part->data[blen] = '\0';
          part->data_len = (int)blen;
      }
      if (!head) head = part;
      if (tail)  tail->next = part;
      tail = part;
      n_parts++;
      pos = bend + (size_t)cdlen;  /* skip "\r\n--<boundary>" */
  }
  c->req_multipart_parts = head;
  return head ? 1 : 0;
  ```)
;;; httpd-req-file -- look up a multipart part by form field name.
;;;
;;; Triggers a lazy parse of the request body on first call; subsequent
;;; calls reuse the cached part list (freed in the iteration cleanup).
;;;
;;; Returns an opaque part handle (`:ptr<void>`) usable with the
;;; httpd-part-* accessors, or `0` (NULL) when the field is absent / the
;;; body is not multipart / parsing failed.
;;;
;;; Example:
;;;   (let [p (httpd-req-file c "upload")]
;;;     (when (not= 0 p)
;;;       (println (httpd-part-filename p))
;;;       (println (int->cstr (httpd-part-data-len p)))))
;;;
;;; Since: Phase H8 (M7)

(defn httpd-req-file [conn : ptr<void> field : cstr] : ptr<void>
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  if (!conn || !field || !*field) return NULL;
  HttpdConn *c = (HttpdConn *)conn;
  if (!c->req_multipart_parts) {
      /* Trigger lazy parse via the Turmeric entry point.  C-level call
       * works fine: the function name is `httpd_hyreq_hymultipart_hyparse`. */
      (void)httpd_hyreq_hymultipart_hyparse((void *)conn);
  }
  HttpdPart *p = (HttpdPart *)c->req_multipart_parts;
  while (p) {
      if (p->name && strcmp(p->name, field) == 0) return (void *)p;
      p = p->next;
  }
  return NULL;
  ```)
;;; httpd-part-name -- form field name of a part (or "" if missing).

(defn httpd-part-name [part : ptr<void>] : cstr
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  if (!part) return "";
  HttpdPart *p = (HttpdPart *)part;
  return p->name ? p->name : "";
  ```)
;;; httpd-part-filename -- file name attribute (or "" for non-file parts).

(defn httpd-part-filename [part : ptr<void>] : cstr
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  if (!part) return "";
  HttpdPart *p = (HttpdPart *)part;
  return p->filename ? p->filename : "";
  ```)
;;; httpd-part-content-type -- per-part Content-Type (or "" if absent).

(defn httpd-part-content-type [part : ptr<void>] : cstr
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  if (!part) return "";
  HttpdPart *p = (HttpdPart *)part;
  return p->content_type ? p->content_type : "";
  ```)
;;; httpd-part-data -- raw byte buffer (binary-safe, may contain NUL).

(defn httpd-part-data [part : ptr<void>] : ptr<void>
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  if (!part) return NULL;
  HttpdPart *p = (HttpdPart *)part;
  return (void *)p->data;
  ```)
;;; httpd-part-data-len -- byte count of the part's content.

(defn httpd-part-data-len [part : ptr<void>] : int
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  if (!part) return 0;
  HttpdPart *p = (HttpdPart *)part;
  return (int64_t)p->data_len;
  ```)
;; =============================================================================
;; A0 + A1: Asynchronous server (fiber-per-request on a reactor)
;; =============================================================================
;;
;; The blocking server (`httpd-new`/`httpd-new-pool`) ties up a worker
;; thread for the lifetime of each request. The async server runs one
;; reactor thread bound to a single `local-fiber-group`; each accepted
;; connection becomes a fiber that uses non-blocking I/O and parks on
;; the reactor when it would block. A handler can ALSO park explicitly
;; via the `httpd-await-*` primitives -- e.g., on a timer or another
;; fd -- which frees the reactor thread to drive other in-flight
;; fibers (the whole point of going async; see plan motivation).
;;
;; Surface:
;;   (httpd-new-async port handler)    -- create reactor + group + listener
;;   (httpd-run-async h)               -- drive fibers until stopped
;;   (httpd-stop-async h)              -- request a graceful shutdown
;;   (httpd-async-free h)              -- tear down state
;;
;; Inside a handler (running as a fiber):
;;   (httpd-await-readable conn)       -- suspend until conn fd is readable
;;   (httpd-await-writable conn)       -- suspend until conn fd is writable
;;   (httpd-await-timer conn ms)       -- suspend for ms milliseconds
;;
;; The blocking thread-pool path is untouched; async is opt-in.
;;
;; Threading: the resolved OQ3 picks a single reactor + one fiber group.
;; Sharding into a pool of reactor threads is a measured follow-up.
;;; httpd-async-fiber-body -- internal: per-request fiber entry point.
;;;
;;; Runs the non-blocking version of httpd-handle on the accepted fd:
;;; sets O_NONBLOCK, reads up to end-of-headers (parking on EWOULDBLOCK),
;;; reads body, dispatches the handler, writes the response (parking on
;;; EWOULDBLOCK), and loops on keep-alive.  Mirrors httpd-handle.

;;; NOTE: the trailing `user`/`user-data` slot is typed `: int` DELIBERATELY
;;; (an exception to the no-lazy-:int rule): this defn is hand-packed into a
;;; fat box's slot 0 (see the `clos[0] = ...` below / reactor.c park boxes),
;;; and the reactor invokes slot 0 through the fat-entry CARRIER convention
;;; (typedefs in src/async/reactor.c) -- every value parameter is int64_t.  A
;;; `ptr<void>` spelling emits a `void *` C parameter, which -fsanitize=function
;;; flags (and CFI/CET-BTI/WASM reject) at every dispatch.
(defn httpd-async-fiber-body [self : ptr<void> user-data : int] : nil
  ```c
  #include <fcntl.h>
  #include <errno.h>
  (void)self;
  /* HttpdAsync layout (kept in sync with httpd-new-async below). */
  typedef struct {
      int   fd;
      int64_t handler;
      void *fiber_group;
      void *async;
  } HttpdAsyncReqCtx;
  /* A4: HttpdAsync layout (only the in_flight field is read here; the
   * struct's full shape is asserted in httpd-new-async). */
  typedef struct {
      int   listen_fd;
      int64_t handler;
      void *reactor;
      void *fiber_group_;
      int   listen_src_id;
      void *accept_clos;
      int64_t body_closure;
      volatile int stop_flag;
      int   max_in_flight;
      int   in_flight;
  } HttpdAsync;
  if (!user_data) return;
  HttpdAsyncReqCtx *ctx = (HttpdAsyncReqCtx *)(intptr_t)user_data;
  int fd = ctx->fd;
  int64_t handler = ctx->handler;
  void *group = ctx->fiber_group;
  HttpdAsync *async = (HttpdAsync *)ctx->async;
  free(ctx);
  /* Ensure the fd is non-blocking; the listener may have inherited
   * blocking semantics on some platforms. */
  {
      int cflags = fcntl(fd, F_GETFL, 0);
      fcntl(fd, F_SETFL, cflags | O_NONBLOCK);
  }
  int keep_going = 1;
  while (keep_going) {
      HttpdConn _conn;
      HttpdConn *conn = &_conn;
      memset(conn, 0, sizeof(HttpdConn));
      conn->fd = fd;
      conn->handler = handler;
      conn->fiber_group = group;
      /* --- Read until end-of-headers --- */
      size_t buf_cap = 8192;
      size_t buf_max = 262144;
      char  *buf     = (char *)malloc(buf_cap);
      if (!buf) break;
      buf[0] = '\0';
      int total = 0;
      char *hdr_end = NULL;
      while (!hdr_end) {
          if ((size_t)total + 1 >= buf_cap) {
              if (buf_cap >= buf_max) break;
              size_t new_cap = buf_cap * 2;
              if (new_cap > buf_max) new_cap = buf_max;
              char *nb = (char *)realloc(buf, new_cap);
              if (!nb) break;
              buf = nb;
              buf_cap = new_cap;
          }
          ssize_t n = recv(fd, buf + total, buf_cap - 1 - (size_t)total, 0);
          if (n < 0) {
              if (errno == EAGAIN || errno == EWOULDBLOCK) {
                  /* Park until readable, 5 s per wait as the blocking
                   * pool's SO_RCVTIMEO -- it used to wait forever, so a
                   * client that sent half a request held its fiber. */
                  int ev = (int)tur_local_park_fd(group, fd, 1, 5000);
                  if (ev < 0) break;   /* timeout (-2) or driver error */
                  continue;
              }
              break;
          }
          if (n == 0) break;   /* peer closed */
          /* Resume the search: see httpd-handle's read loop. */
          int scan4 = total > 3 ? total - 3 : 0;
          int scan2 = total > 1 ? total - 1 : 0;
          total += (int)n;
          buf[total] = '\0';
          hdr_end = strstr(buf + scan4, "\r\n\r\n");
          if (!hdr_end) hdr_end = strstr(buf + scan2, "\n\n");
      }
      if (!hdr_end) { free(buf); break; }
      /* security-audit-plan M-4: the same head parser as httpd-handle. */
      int64_t content_len = 0;
      int64_t hdrs_total = httpd_hyparse_hyhead((void *)conn, (void *)buf,
                                                (int64_t)total, (void *)&content_len);
      if (hdrs_total < 0) {
          /* One best-effort write: the response is a few dozen bytes and the
           * connection closes either way. */
          char eb[160];
          int64_t el = httpd_hyerror_hyresponse(-hdrs_total, (void *)eb, (int64_t)sizeof eb);
          (void)send(fd, eb, (size_t)el, 0);
          free(buf);
          httpd_hyconn_hyrelease((void *)conn);
          break;
      }
      int is_http_11 = (strstr(conn->version, "1.1") != NULL);
      /* Body (await on EWOULDBLOCK; content_len is capped by parse-head). */
      if (content_len > 0) {
          int64_t body_in_buf = (int64_t)total - hdrs_total;
          if (body_in_buf < 0) body_in_buf = 0;
          if (body_in_buf > content_len) body_in_buf = content_len;
          conn->body = (char *)malloc((size_t)content_len + 1);
          if (!conn->body) { free(buf); httpd_hyconn_hyrelease((void *)conn); break; }
          if (body_in_buf > 0) memcpy(conn->body, buf + hdrs_total, (size_t)body_in_buf);
          int64_t got = body_in_buf;
          while (got < content_len) {
              ssize_t r = recv(fd, conn->body + got, (size_t)(content_len - got), 0);
              if (r < 0) {
                  if (errno == EAGAIN || errno == EWOULDBLOCK) {
                      /* 5 s per wait, as the blocking pool's SO_RCVTIMEO. */
                      int ev = (int)tur_local_park_fd(group, fd, 1, 5000);
                      if (ev < 0) break;   /* timeout (-2) or driver error */
                      continue;
                  }
                  break;
              }
              if (r == 0) break;
              got += (int64_t)r;
          }
          conn->body[got] = '\0';
          conn->body_len = (int)got;
          if (got < content_len) { free(buf); httpd_hyconn_hyrelease((void *)conn); break; }
      }
      free(buf);
      /* Dispatch handler. */
      int64_t *fat = (int64_t *)(intptr_t)conn->handler;
      /* The handler is `(fn [c : ptr<void>] : nil)`, whose slot 0 is
         `void (void *, int64_t)`: an untyped `ptr<void>` parameter is the
         word in a closure slot (fnsan-ptr-void-fn-slot-word).  Spelling it
         any other way makes this an indirect call through a mismatched
         function-pointer type -- UB that -fsanitize=function reports and that
         CFI / CET-BTI / WASM call_indirect turn into a hard failure.  See
         docs/archive/reactor-fd-callback-fn-ptr-type-mismatch.md */
      typedef void (*fn1_t)(void *, int64_t);
      ((fn1_t)(intptr_t)fat[0])((void *)fat, (int64_t)(intptr_t)conn);
      /* Build the response head (shared with httpd-handle). */
      const char *body = conn->resp_body ? conn->resp_body : "";
      int         blen = conn->resp_body ? conn->resp_body_len : 0;
      int64_t hlen64 = 0;
      char *hbuf = (char *)httpd_hyresp_hyhead((void *)conn, (int64_t)is_http_11, (void *)&hlen64);
      if (!hbuf) { httpd_hyconn_hyrelease((void *)conn); break; }
      int hlen = (int)hlen64;
      /* Non-blocking write loop -- park on EWOULDBLOCK, 5 s per wait like
       * the reads.  It used to wait forever, so a client that stopped
       * reading held its fiber and its in-flight slot (WP4, item 2).  A
       * write that does not finish closes the connection. */
      int write_ok = 1;
      {
          int sent = 0;
          while (sent < hlen) {
              ssize_t w = send(fd, hbuf + sent, (size_t)(hlen - sent), 0);
              if (w < 0) {
                  if (errno == EAGAIN || errno == EWOULDBLOCK) {
                      int ev = (int)tur_local_park_fd(group, fd, 2, 5000);  /* WRITE */
                      if (ev < 0) { write_ok = 0; break; }
                      continue;
                  }
                  write_ok = 0;
                  break;
              }
              sent += (int)w;
          }
      }
      if (blen > 0 && write_ok) {
          int sent = 0;
          while (sent < blen) {
              ssize_t w = send(fd, body + sent, (size_t)(blen - sent), 0);
              if (w < 0) {
                  if (errno == EAGAIN || errno == EWOULDBLOCK) {
                      int ev = (int)tur_local_park_fd(group, fd, 2, 5000);
                      if (ev < 0) { write_ok = 0; break; }
                      continue;
                  }
                  write_ok = 0;
                  break;
              }
              sent += (int)w;
          }
      }
      free(hbuf);
      keep_going = conn->client_keep_alive && write_ok;
      /* The shared release also frees the multipart parts and attributes,
       * which this path's own cleanup used to leak. */
      httpd_hyconn_hyrelease((void *)conn);
  }
  close(fd);
  /* A4: release the in-flight slot. */
  if (async) async->in_flight--;
  ```)
;;; httpd-async-accept-cb -- internal: reactor READ callback on the listen fd.
;;;
;;; Drains accept() and spawns a fiber per accepted connection. Honors
;;; the A4 in-flight cap: when ha->in_flight >= ha->max_in_flight,
;;; sends a quick HTTP/1.0 503 and closes instead of spawning.

;;; NOTE: the trailing `user`/`user-data` slot is typed `: int` DELIBERATELY
;;; (an exception to the no-lazy-:int rule): this defn is hand-packed into a
;;; fat box's slot 0 (see the `clos[0] = ...` below / reactor.c park boxes),
;;; and the reactor invokes slot 0 through the fat-entry CARRIER convention
;;; (typedefs in src/async/reactor.c) -- every value parameter is int64_t.  A
;;; `ptr<void>` spelling emits a `void *` C parameter, which -fsanitize=function
;;; flags (and CFI/CET-BTI/WASM reject) at every dispatch.
(defn httpd-async-accept-cb [env : ptr<void> id : int events : int user : int] : nil
  ```c
  (void)id; (void)events; (void)user;
  typedef struct {
      int   listen_fd;
      int64_t handler;
      void *reactor;
      void *fiber_group;
      int   listen_src_id;
      void *accept_clos;
      int64_t body_closure;       /* fat closure handle for httpd-async-fiber-body */
      volatile int stop_flag;
      int   max_in_flight;        /* A4: cap; 0 = unlimited */
      int   in_flight;            /* A4: live request count */
  } HttpdAsync;
  typedef struct {
      int   fd;
      int64_t handler;
      void *fiber_group;
      void *async;                /* HttpdAsync*, for in_flight decrement on exit */
  } HttpdAsyncReqCtx;
  int64_t *fat = (int64_t *)env;
  HttpdAsync *ha = (HttpdAsync *)(intptr_t)fat[1];
  if (!ha || ha->stop_flag) return;
  for (;;) {
      int cfd = accept(ha->listen_fd, NULL, NULL);
      if (cfd < 0) break;
      /* A4: cap check.  When at cap, send 503 + close without spawning. */
      if (ha->max_in_flight > 0 && ha->in_flight >= ha->max_in_flight) {
          const char *resp =
              "HTTP/1.0 503 Service Unavailable\r\n"
              "Content-Length: 19\r\n"
              "Connection: close\r\n"
              "\r\n"
              "server at capacity\n";
          (void)send(cfd, resp, strlen(resp), 0);
          /* Not close(): the request is still unread, and closing over unread
           * data sends RST.  A Windows client that has not yet read the 503
           * discards it on the reset and sees only WSAECONNRESET.  Linger
           * instead -- FIN, drain until the client closes, then close. */
          (void)tur_reactor_linger_close(ha->reactor, cfd, 2000);
          continue;
      }
      HttpdAsyncReqCtx *ctx = (HttpdAsyncReqCtx *)malloc(sizeof(HttpdAsyncReqCtx));
      if (!ctx) { close(cfd); continue; }
      ctx->fd          = cfd;
      ctx->handler     = ha->handler;
      ctx->fiber_group = ha->fiber_group;
      ctx->async       = (void *)ha;
      int rc = (int)tur_local_spawn(ha->fiber_group, ha->body_closure, (void *)ctx);
      if (rc < 0) { free(ctx); close(cfd); continue; }
      /* Every request fiber shares ha->body_closure, which httpd frees itself
       * in teardown; disown it so the fiber group does not multi-/double-free. */
      tur_local_disown_body(ha->fiber_group, (int64_t)rc);
      ha->in_flight++;
  }
  ```)
;;; httpd-new-async -- create an async (fiber-per-request) httpd handle.
;;;
;;; Binds the listener to a single-thread reactor + LocalFiberGroup.
;;; Each accepted connection runs as a fiber that uses non-blocking I/O
;;; and parks on the reactor when it would block; handlers may also
;;; park explicitly via the httpd-await-* primitives.
;;;
;;; Parameters:
;;;   port    -- TCP port to listen on (0 = kernel-assigned)
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;
;;; Returns:
;;;   ptr<void> -- HttpdAsync handle (or NULL on error)
;;;
;;; Lifecycle:
;;;   (let [h (httpd-new-async 0 handler)]
;;;     (httpd-run-async h)         ;; blocks until httpd-stop-async fires
;;;     (httpd-async-free h))
;;;
;;; Since: Phase H8 (A0+A1)

(defn httpd-new-async-with-limit [port : int
                                  ^fat handler : (fn [ptr<void>] nil)
                                  max-in-flight : int]
  #fx{Net}
  : ptr<void>
  ```c
  #include <fcntl.h>
  typedef void (*tur_sig_fn)(int);
  extern tur_sig_fn signal(int, tur_sig_fn);
  signal(13, (tur_sig_fn)(intptr_t)1);  /* SIGPIPE -> SIG_IGN */
  typedef struct {
      int   listen_fd;
      int64_t handler;
      void *reactor;
      void *fiber_group;
      int   listen_src_id;
      void *accept_clos;
      int64_t body_closure;
      volatile int stop_flag;
      int   max_in_flight;        /* A4: cap; 0 = unlimited */
      int   in_flight;            /* A4: live request count */
  } HttpdAsync;
  /* Loopback unless the program opted in to every interface with
   * httpd-set-bind-any! / TUR_HTTPD_BIND_ANY=1, or named one with
   * httpd-set-bind-addr! (security-audit-plan M-4: a server that is reachable
   * from the network should be one somebody asked for).  TUR_BIND_LOOPBACK,
   * which the test suite exports, still forces loopback. */
  int fd = (int)httpd_hylisten_hysocket(port);
  if (fd < 0) { TUR_CLOSURE_DROP(handler); return NULL; }
  HttpdAsync *ha = (HttpdAsync *)calloc(1, sizeof(HttpdAsync));
  if (!ha) { close(fd); TUR_CLOSURE_DROP(handler); return NULL; }
  ha->listen_fd     = fd;
  ha->handler       = handler;
  ha->max_in_flight = (int)max_in_flight;
  ha->reactor       = tur_reactor_new();
  if (!ha->reactor) { close(fd); TUR_CLOSURE_DROP(handler); free(ha); return NULL; }
  ha->fiber_group = tur_local_fiber_group_new(ha->reactor);
  if (!ha->fiber_group) { tur_reactor_free(ha->reactor); close(fd); TUR_CLOSURE_DROP(handler); free(ha); return NULL; }
  /* Synthetic fat closure for the accept callback: { __fn, ha }. */
  int64_t *clos = (int64_t *)malloc(2 * sizeof(int64_t));
  if (!clos) { tur_reactor_free(ha->reactor); close(fd); TUR_CLOSURE_DROP(handler); free(ha); return NULL; }
  clos[0] = (int64_t)(intptr_t)httpd_hyasync_hyaccept_hycb;
  clos[1] = (int64_t)(intptr_t)ha;
  ha->accept_clos = (void *)clos;
  /* Synthetic fat closure for the fiber body. */
  int64_t *body_clos = (int64_t *)malloc(2 * sizeof(int64_t));
  if (!body_clos) { free(clos); tur_reactor_free(ha->reactor); close(fd); TUR_CLOSURE_DROP(handler); free(ha); return NULL; }
  body_clos[0] = (int64_t)(intptr_t)httpd_hyasync_hyfiber_hybody;
  body_clos[1] = 0;
  ha->body_closure = (int64_t)(intptr_t)body_clos;
  ha->listen_src_id = (int)tur_reactor_add_fd(ha->reactor, fd, 1,
      (int64_t)(intptr_t)clos, NULL);
  /* Accept box is cached in ha->accept_clos and freed by httpd; disown it so
   * the reactor (which owns cb boxes by default) does not double-free. */
  tur_reactor_disown_cb(ha->reactor, ha->listen_src_id);
  if (ha->listen_src_id < 0) {
      free(body_clos); free(clos);
      tur_reactor_free(ha->reactor);
      close(fd); TUR_CLOSURE_DROP(handler); free(ha); return NULL;
  }
  return (void *)ha;
  ```)
;;; httpd-new-async -- create an async server capped at 512 in-flight requests.
;;;
;;; Shortcut for `(httpd-new-async-with-limit port handler 512)`: past 512
;;; live request fibers a new connection is answered 503 and closed.  512
;;; sits under the common 1024 open-file soft limit, so a flood is refused
;;; before it exhausts the process's descriptors.  Use the -with-limit
;;; variant to choose another cap (0 = unlimited).
;;;
;;; Since: Phase H8 (A0+A1)

(defn httpd-new-async [port : int ^fat handler : (fn [ptr<void>] nil)]
  #fx{Net}
  : ptr<void>
  (httpd-new-async-with-limit port handler 512))
;;; httpd-run-async -- drive the async server until stopped.
;;;
;;; Blocks the calling thread, running the fiber-per-request loop.
;;; Returns when httpd-stop-async fires (or the reactor exits for any
;;; other reason).
;;;
;;; Since: Phase H8 (A0+A1)

(defn httpd-run-async [h : ptr<void>]
  #fx{Net}
  : nil
  ```c
  typedef struct {
      int   listen_fd;
      int64_t handler;
      void *reactor;
      void *fiber_group;
      int   listen_src_id;
      void *accept_clos;
      int64_t body_closure;
      volatile int stop_flag;
      int   max_in_flight;        /* A4: cap; 0 = unlimited */
      int   in_flight;            /* A4: live request count */
  } HttpdAsync;
  if (!h) return;
  HttpdAsync *ha = (HttpdAsync *)h;
  (void)tur_reactor_run_fibers(ha->fiber_group);
  ```)
;;; httpd-stop-async -- request a graceful shutdown of the async server.
;;;
;;; Sets the stop flag, removes the listener source from the reactor,
;;; and wakes the reactor so httpd-run-async returns.  In-flight fibers
;;; finish naturally when their reads/writes complete.
;;;
;;; Since: Phase H8 (A0+A1)

(defn httpd-stop-async [h : ptr<void>]
  #fx{Net}
  : nil
  ```c
  typedef struct {
      int   listen_fd;
      int64_t handler;
      void *reactor;
      void *fiber_group;
      int   listen_src_id;
      void *accept_clos;
      int64_t body_closure;
      volatile int stop_flag;
      int   max_in_flight;        /* A4: cap; 0 = unlimited */
      int   in_flight;            /* A4: live request count */
  } HttpdAsync;
  if (!h) return;
  HttpdAsync *ha = (HttpdAsync *)h;
  ha->stop_flag = 1;
  if (ha->listen_src_id >= 0) {
      tur_reactor_remove(ha->reactor, ha->listen_src_id);
      ha->listen_src_id = -1;
  }
  /* Close the listener NOW, not at httpd-async-free: the kernel completes
   * TCP handshakes into the backlog whether or not accept() ever runs, so a
   * connection that races the stop would otherwise sit ESTABLISHED with no
   * one ever answering, and the client blocks in recv() forever. Closing
   * the fd resets the pending backlog and refuses late connects instead. */
  if (ha->listen_fd >= 0) { close(ha->listen_fd); ha->listen_fd = -1; }
  tur_reactor_stop(ha->reactor);
  tur_reactor_wake(ha->reactor);
  ```)
;;; httpd-async-free -- tear down an async server handle.
;;;
;;; Free the fiber group, reactor, and synthetic closures.  Call only
;;; after httpd-run-async has returned.
;;;
;;; Since: Phase H8 (A0+A1)

(defn httpd-async-free [h : ptr<void>] : nil
  ```c
  typedef struct {
      int   listen_fd;
      int64_t handler;
      void *reactor;
      void *fiber_group;
      int   listen_src_id;
      void *accept_clos;
      int64_t body_closure;
      volatile int stop_flag;
      int   max_in_flight;        /* A4: cap; 0 = unlimited */
      int   in_flight;            /* A4: live request count */
  } HttpdAsync;
  if (!h) return;
  HttpdAsync *ha = (HttpdAsync *)h;
  if (ha->fiber_group) tur_local_fiber_group_free(ha->fiber_group);
  if (ha->reactor) tur_reactor_free(ha->reactor);
  /* accept_clos and body_closure are hand-rolled synthetic { __fn, ptr } boxes
   * (no codegen drop-glue header), so they are freed with a plain free -- NOT
   * TUR_CLOSURE_DROP, which would read a header 8 bytes before the un-headered
   * allocation. */
  if (ha->accept_clos) free(ha->accept_clos);
  if (ha->body_closure) free((void *)(intptr_t)ha->body_closure);
  /* Free the user handler box (passed ^fat, always a heap fat-closure box;
   * distinct from body_closure). Sole free -- no double free. For a bare handler
   * this reclaims the whole thing; for a compose-middleware onion,
   * TUR_CLOSURE_DROP releases the outermost layer AND (under
   * closure-drop-glue, graduated 2026-07-22) walks the inner captured `next` boxes via the
   * env's drop-glue header, so the whole onion is freed. Flag-off,
   * TUR_CLOSURE_DROP is a plain free of the outer box (the inner boxes leak, as
   * before). */
  if (ha->handler) TUR_CLOSURE_DROP(ha->handler);
  if (ha->listen_fd >= 0) close(ha->listen_fd);
  free(ha);
  ```)
;;; httpd-async-port -- read the bound TCP port on an async server.
;;;
;;; Useful when port=0 was passed to httpd-new-async (kernel-assigned).
;;;
;;; Since: Phase H8 (A0+A1)

(defn httpd-async-port [h : ptr<void>] : int
  ```c
  typedef struct {
      int   listen_fd;
      int64_t handler;
      void *reactor;
      void *fiber_group;
      int   listen_src_id;
      void *accept_clos;
      int64_t body_closure;
      volatile int stop_flag;
      int   max_in_flight;        /* A4: cap; 0 = unlimited */
      int   in_flight;            /* A4: live request count */
  } HttpdAsync;
  if (!h) return 0;
  HttpdAsync *ha = (HttpdAsync *)h;
  struct sockaddr_storage sa;
  socklen_t sl = sizeof(sa);
  if (getsockname(ha->listen_fd, (struct sockaddr *)&sa, &sl) < 0) return 0;
  if (sa.ss_family == AF_INET6)
      return (int64_t)ntohs(((struct sockaddr_in6 *)&sa)->sin6_port);
  return (int64_t)ntohs(((struct sockaddr_in *)&sa)->sin_port);
  ```)
;;; httpd-await-readable -- suspend the current fiber until conn fd is readable.
;;;
;;; Wraps `local-park-fd` for the READ event with no timeout. Must be
;;; called from inside a request fiber spawned by httpd-new-async; in
;;; the blocking thread-pool path it is a no-op (the fiber group is
;;; NULL).
;;;
;;; Since: Phase H8 (A0)

(defn httpd-await-readable [conn : ptr<void>] : nil
  ```c
  if (!conn) return;
  HttpdConn *c = (HttpdConn *)conn;
  if (!c->fiber_group) return;
  (void)tur_local_park_fd(c->fiber_group, c->fd, 1, -1);
  ```)
;;; httpd-await-writable -- suspend until conn fd is writable.

(defn httpd-await-writable [conn : ptr<void>] : nil
  ```c
  if (!conn) return;
  HttpdConn *c = (HttpdConn *)conn;
  if (!c->fiber_group) return;
  (void)tur_local_park_fd(c->fiber_group, c->fd, 2, -1);
  ```)
;;; httpd-await-timer -- suspend the current fiber for ms milliseconds.
;;;
;;; Built on local-park-fd with timeout-only: the reactor still polls
;;; the conn fd (no events of interest); when the timeout elapses the
;;; fiber resumes.  Suitable for per-request deadlines, exponential
;;; back-off, etc.
;;;
;;; Since: Phase H8 (A0)

(defn httpd-await-timer [conn : ptr<void> ms : int] : nil
  ```c
  if (!conn) return;
  HttpdConn *c = (HttpdConn *)conn;
  if (!c->fiber_group) return;
  /* Park on the fd with NO event mask (0): the timer alone wakes us. */
  (void)tur_local_park_fd(c->fiber_group, c->fd, 0, (int64_t)ms);
  ```)
;; =============================================================================
;; H6: Routing DSL
;; =============================================================================
;;
;; Router holds a linked list of (method, pattern, handler) tuples. Patterns
;; are slash-separated segments; a segment starting with ':' captures the
;; corresponding path segment into a named parameter that the handler can
;; read with httpd-param.
;;
;; Example:
;;   (let [r (router-new)]
;;     (router-add r "GET"  "/"            home-h)
;;     (router-add r "GET"  "/users/:id"   show-h)
;;     (router-add r "POST" "/users"       create-h)
;;     (httpd-new 0 (fn [c :ptr<void>] :nil (router-dispatch r c))))
;;
;; Router layout:    { void *routes; }   (head of Route list)
;; Route layout:     { char method[16]; char pattern[1024];
;;                     int64_t handler; void *next; }
;; RouteParam:       { char name[64]; char value[256]; void *next; }
;;; router-new -- create an empty router.
;;;
;;; Returns:
;;;   ptr<void> -- opaque Router handle
;;;
;;; Since: Phase H6


(defn router-new [] : ptr<void>
  ```c
  typedef struct { void *routes; } Router;
  Router *r = (Router *)malloc(sizeof(Router));
  if (!r) return NULL;
  r->routes = NULL;
  return (void *)r;
  ```)
;;; router-add -- register a route with the given method, pattern, and handler.
;;;
;;; The handler closure is called when an incoming request's method matches
;;; and its path matches the pattern. Path segments starting with ':' capture
;;; the corresponding request segment; the value can be read inside the
;;; handler via httpd-param.
;;;
;;; Parameters:
;;;   r       -- router handle
;;;   method  -- HTTP method ("GET", "POST", etc.)
;;;   pattern -- path pattern (e.g. "/users/:id")
;;;   handler -- fat closure: (fn [conn :ptr<void>] :nil)
;;;
;;; Since: Phase H6

(defn router-add [r : ptr<void>
                  method : cstr
                  pattern : cstr
                  ^fat handler : (fn [ptr<void>] nil)] : nil
  ```c
  typedef struct Route Route;
  struct Route {
      char method[16];
      char pattern[1024];
      int64_t handler;
      Route *next;
  };
  typedef struct { Route *routes; } Router;
  Router *router = (Router *)r;
  Route *route = (Route *)malloc(sizeof(Route));
  if (!route) return;
  size_t mlen = strlen(method); if (mlen > 15) mlen = 15;
  memcpy(route->method, method, mlen); route->method[mlen] = '\0';
  size_t plen = strlen(pattern); if (plen > 1023) plen = 1023;
  memcpy(route->pattern, pattern, plen); route->pattern[plen] = '\0';
  route->handler = (int64_t)handler;
  /* Append at tail so registration order is preserved. */
  if (!router->routes) {
      route->next = NULL;
      router->routes = route;
  } else {
      Route *cur = router->routes;
      while (cur->next) cur = cur->next;
      route->next = NULL;
      cur->next = route;
  }
  ```)
;;; router-free -- free a router and all registered routes.
;;;
;;; Parameters:
;;;   r -- router handle
;;;
;;; Since: Phase H6

(defn router-free [r : ptr<void>] : nil
  ```c
  typedef struct Route Route;
  struct Route { char method[16]; char pattern[1024]; int64_t handler; Route *next; };
  typedef struct { Route *routes; } Router;
  Router *router = (Router *)r;
  Route *cur = router->routes;
  while (cur) {
      Route *nx = cur->next;
      /* Each route handler is passed ^fat (heap fat-closure box) and freed
       * nowhere else. TUR_CLOSURE_DROP releases the outer box AND (under
       * closure-drop-glue, graduated 2026-07-22) walks the inner captured `next` boxes via the
       * env's drop-glue header, so a compose-middleware onion is fully freed.
       * Flag-off, TUR_CLOSURE_DROP is a plain free of the outer box (inner layers
       * leak, as before). */
      if (cur->handler) TUR_CLOSURE_DROP(cur->handler);
      free(cur);
      cur = nx;
  }
  free(router);
  ```)
;;; router-dispatch -- match the current request against the router's table.
;;;
;;; On match: attaches captured path params to conn, calls the route's
;;; handler with conn, then frees the params. On no match: sets a 404
;;; response with body "Not Found".
;;;
;;; Parameters:
;;;   r    -- router handle
;;;   conn -- connection handle (the one passed to the httpd handler)
;;;
;;; Since: Phase H6

(defn router-dispatch [r : ptr<void> conn : ptr<void>] : nil
  ```c
  typedef struct Route Route;
  struct Route { char method[16]; char pattern[1024]; int64_t handler; Route *next; };
  typedef struct { Route *routes; } Router;
  typedef struct RouteParam RouteParam;
  struct RouteParam { char name[64]; char value[256]; RouteParam *next; };
  Router *router = (Router *)r;
  HttpdConn *c   = (HttpdConn *)conn;
  for (Route *route = router->routes; route; route = route->next) {
      if (strcmp(route->method, c->method) != 0) continue;
      /* Match path segment by segment. */
      const char *pp = route->pattern;
      const char *pc = c->path;
      RouteParam *params = NULL;
      int matched = 1;
      while (1) {
          while (*pp == '/') pp++;
          while (*pc == '/') pc++;
          if (!*pp && !*pc) break;
          if ((!*pp) != (!*pc)) { matched = 0; break; }
          const char *seg_pp = pp;
          while (*seg_pp && *seg_pp != '/') seg_pp++;
          const char *seg_pc = pc;
          while (*seg_pc && *seg_pc != '/' && *seg_pc != '?') seg_pc++;
          if (*pp == ':') {
              int name_len = (int)(seg_pp - pp - 1);
              int val_len  = (int)(seg_pc - pc);
              if (val_len <= 0) { matched = 0; break; }
              RouteParam *p = (RouteParam *)malloc(sizeof(RouteParam));
              if (!p) { matched = 0; break; }
              if (name_len > 63) name_len = 63;
              if (val_len  > 255) val_len  = 255;
              memcpy(p->name,  pp + 1, (size_t)name_len);  p->name[name_len]  = '\0';
              memcpy(p->value, pc,     (size_t)val_len);   p->value[val_len]  = '\0';
              p->next = params;
              params = p;
          } else {
              int pp_len = (int)(seg_pp - pp);
              int pc_len = (int)(seg_pc - pc);
              if (pp_len != pc_len || memcmp(pp, pc, (size_t)pp_len) != 0) {
                  matched = 0;
                  break;
              }
          }
          pp = seg_pp;
          pc = seg_pc;
      }
      if (matched) {
          c->route_params = (void *)params;
          int64_t *fat = (int64_t *)(intptr_t)route->handler;
          /* `(fn [c : ptr<void>] : nil)`'s slot 0 is
             `void (void *, int64_t)`; see the note in httpd-handle's
             dispatch. */
          typedef void (*fn1_t)(void *, int64_t);
          ((fn1_t)(intptr_t)fat[0])((void *)fat, (int64_t)(intptr_t)c);
          /* Free params after handler returns. */
          RouteParam *cur = params;
          while (cur) { RouteParam *nx = cur->next; free(cur); cur = nx; }
          c->route_params = NULL;
          return;
      }
      /* Free partial params from failed match. */
      RouteParam *cur = params;
      while (cur) { RouteParam *nx = cur->next; free(cur); cur = nx; }
  }
  /* No route matched: 404. */
  c->resp_status = 404;
  const char *nf = "Not Found";
  size_t nflen = strlen(nf);
  c->resp_body = (char *)malloc(nflen + 1);
  if (c->resp_body) {
      memcpy(c->resp_body, nf, nflen + 1);
      c->resp_body_len = (int)nflen;
  }
  ```)
;;; httpd-param -- read a captured route parameter set by router-dispatch.
;;;
;;; Parameters:
;;;   conn -- connection handle passed to the route handler
;;;   name -- parameter name (e.g. "id" for a ":id" pattern segment)
;;;
;;; Returns:
;;;   cstr -- the captured value, or "" if no parameter with that name
;;;
;;; Example:
;;;   ;; pattern "/users/:id" matched against "/users/42"
;;;   (httpd-param conn "id")  ; => "42"
;;;
;;; Since: Phase H6

(defn httpd-param [conn : ptr<void> name : cstr] : cstr
  ```c
  typedef struct RouteParam RouteParam;
  struct RouteParam { char name[64]; char value[256]; RouteParam *next; };
  HttpdConn *c = (HttpdConn *)conn;
  RouteParam *p = (RouteParam *)c->route_params;
  while (p) {
      if (strcmp(p->name, name) == 0) return p->value;
      p = p->next;
  }
  return "";
  ```)
;; =============================================================================
;; H7: Middleware -- composable request/response transformations
;; =============================================================================
;;
;; A "middleware" is a function `(fn [next :int] :int (fn [conn :ptr<void>] :nil
;; ... (httpd-call next conn) ...))`: given a downstream handler closure, it
;; returns a new handler closure that wraps it. Pre-processing runs before
;; (httpd-call next conn); post-processing runs after.
;;
;; Multiple middlewares compose by nesting: `(outer (inner base-handler))`
;; produces a chain where outer's pre-hook runs first and outer's post-hook
;; runs last. The optional `compose-middleware` helper applies a list of
;; middlewares in left-to-right order.
;;
;; Example:
;;   (defn mw-log [next :int] :int
;;     (fn [c :ptr<void>] :nil
;;       (println (str-concat "REQ " (httpd-req-path c)))
;;       (httpd-call next c)))
;;
;;   (let [base (fn [c :ptr<void>] :nil (httpd-resp-body! c "ok"))]
;;     (httpd-new 0 (mw-log base)))
;;; httpd-call -- invoke a Turmeric handler closure on a connection.
;;;
;;; `handler` is an already-erased fat-closure handle (:int) -- typically a
;;; captured `next` threaded through a middleware, or a value produced by
;;; compose-middleware. Handlers entering the server from user code arrive
;;; through a `^fat` parameter (httpd-new, the mw-* factories, mw-basic-auth)
;;; that auto-shims a bare non-capturing fn, so by the time it reaches
;;; httpd-call it already carries a valid { thunk, env } layout.
;;;
;;; Parameters:
;;;   handler -- handler closure value (int)
;;;   conn    -- connection handle from the worker
;;;
;;; Since: Phase H7


(defn httpd-call [handler : int conn : ptr<void>] : nil
  (when (not (= handler 0)) ((:: handler (fn [ptr<void>] nil)) conn)))
;;; defroute -- macro sugar for (router-add router method pattern handler).
;;;
;;; Example:
;;;   (defroute r "GET" "/" (fn [c :ptr<void>] :nil ...))
;;;
;;; Since: Phase H6

(defmacro defroute [router method pattern handler]
  `(router-add ~router ~method ~pattern ~handler))
;; =============================================================================
;; M1: mw-log -- request logging middleware (per docs/archive/history/httpd-middleware-async-plan.md)
;; =============================================================================
;;
;; The reference middleware on top of the H7 convention. Logs one line per
;; request with method, path, status, response byte count, and elapsed wall
;; time in milliseconds (CLOCK_MONOTONIC).
;;
;; Example:
;;   (let [base     (fn [c :ptr<void>] :nil (httpd-resp-body! c "ok"))
;;         composed (mw-log base)]
;;     (httpd-new 0 composed))
;;
;; Output line shape (one per request):
;;   GET /path -> 200 2 0ms
;;; httpd-mw-mono-ms -- monotonic clock helper (milliseconds). Internal.

(defn httpd-mw-mono-ms [] : int
  ```c
  #include <time.h>
  struct timespec __ts;
  clock_gettime(CLOCK_MONOTONIC, &__ts);
  return (int64_t)__ts.tv_sec * 1000LL + (int64_t)__ts.tv_nsec / 1000000LL;
  ```)
;;; httpd-mw-log-emit -- emit one log line for a completed request. Internal.

(defn httpd-mw-log-emit [c : ptr<void> elapsed-ms : int] : nil
  ```c
  HttpdConn *cn = (HttpdConn *)c;
  int status = cn->resp_status ? cn->resp_status : 200;
  /* The method and path are the client's bytes: escape anything outside
   * printable ASCII as \xHH, so a request cannot write control sequences
   * (or a forged second log line) into the log (WP4, item 8). */
  char m[sizeof cn->method * 4], pth[sizeof cn->path * 4];
  const char *src[2] = { cn->method, cn->path };
  char *dst[2] = { m, pth };
  size_t cap[2] = { sizeof m, sizeof pth };
  for (int k = 0; k < 2; k++) {
      size_t o = 0;
      for (const unsigned char *q = (const unsigned char *)src[k]; *q && o + 5 < cap[k]; q++) {
          if (*q >= 0x20 && *q < 0x7f && *q != '\\') dst[k][o++] = (char)*q;
          else o += (size_t)snprintf(dst[k] + o, cap[k] - o, "\\x%02x", *q);
      }
      dst[k][o] = '\0';
  }
  fprintf(stdout, "%s %s -> %d %d %lldms\n",
          m, pth, status, cn->resp_body_len,
          (long long)elapsed_ms);
  fflush(stdout);
  ```)
;;; mw-log -- request logging middleware (stdout).
;;;
;;; Wraps a base handler so every request prints one line to stdout after
;;; the handler returns. The line carries the request method, path, the
;;; response status (defaulting to 200 if unset), the response body length
;;; in bytes, and the elapsed wall time in milliseconds.
;;;
;;; Parameters:
;;;   next -- downstream handler closure (fat-closure :int)
;;;
;;; Returns:
;;;   A wrapped handler closure (:int) with the same calling convention as
;;;   handlers passed to httpd-new / httpd-new-pool.
;;;
;;; Example:
;;;   (let [base     (fn [c :ptr<void>] :nil
;;;                    (httpd-resp-status! c 200)
;;;                    (httpd-resp-body!   c "hi"))
;;;         composed (mw-log base)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M1)

(defn mw-log [^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (let [_n next]
    (fn [c : ptr<void>] : nil
      (let [t0 (httpd-mw-mono-ms)]
        (httpd-call _n c)
        (httpd-mw-log-emit c (- (httpd-mw-mono-ms) t0))))))
;; =============================================================================
;; M8 (core): compose-middleware -- nest multiple middlewares around a base
;; =============================================================================
;;
;; Each middleware is a one-argument fat closure of the H7 shape:
;;   (fn [next :int] :int  <wrapped-closure>)
;;
;; compose-middleware applies them right-to-left so the leftmost middleware
;; in the argument list ends up as the OUTERMOST wrapper -- its pre-hook
;; runs first and its post-hook runs last:
;;
;;   (compose-middleware base mw-log mw-cors mw-auth)
;;   ;; is equivalent to (mw-log (mw-cors (mw-auth base)))
;;
;; Note: each middleware argument is a factory `(fn [next :int] :int ...)`
;; whose returned wrapper naturally captures `next`, so it is already a fat
;; closure. The base handler itself need NOT capture anything: it enters
;; through the factory's `^fat next` parameter (or compose-middleware-of's
;; `^fat base`), which auto-shims a bare non-capturing fn into a fat closure.
;;; compose-middleware -- wrap a base handler with multiple middlewares.
;;;
;;; Parameters:
;;;   base -- base handler closure (:int)
;;;   mws  -- variadic middleware closures (each `(fn [next :int] :int)`),
;;;           applied right-to-left so the leftmost ends up outermost.
;;;
;;; Returns:
;;;   The fully-wrapped handler closure (:int).
;;;
;;; Example:
;;;   (let [composed (compose-middleware base mw-log)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M8 core)
;;; compose-middleware -- nest multiple middlewares around a base handler.
;;;
;;; Macro: `(compose-middleware base mw1 mw2 mw3)` expands to
;;; `(mw1 (mw2 (mw3 base)))`, i.e. each `mw_i` is called as a one-argument
;;; function with the wrapped downstream handler. The leftmost middleware
;;; ends up as the OUTERMOST wrapper -- its pre-hook runs first and its
;;; post-hook runs last.
;;;
;;; Each `mw_i` must be name-callable with one argument: typically a defn
;;; like `mw-log` (shape `(defn mw-log [next :int] ... (fn [c] ...))`), or
;;; a partially applied form like `(mw-cors opts)` that itself returns a
;;; one-arg function. Bare closure VALUES are not directly callable in
;;; Turmeric -- use a defn (or wrap such a value in a defn) before passing
;;; it through compose-middleware.
;;;
;;; Example:
;;;   (let [composed (compose-middleware base mw-log)]
;;;     (httpd-new 0 composed))
;;;
;;;   ;; Multiple middlewares (mw-log is outermost):
;;;   (let [composed (compose-middleware base mw-log mw-cors mw-auth)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (M8 core)


(defmacro compose-middleware [base & mws]
  (if (empty? mws)
    base
    (list (first mws) (list compose-middleware base ~@(rest mws)))))
;;; Handler -- an owned, composed request-handler onion (the result of
;;; `compose-middleware-of` / a folded middleware chain).
;;;
;;; `:affine` (use-at-most-once, move-only) is the key: a bound Handler the owner
;;; neither MOVES (hands to a server via `httpd-handler-carrier`) nor BORROWS
;;; (invokes via `(:: h :int)` / `httpd-call`) is AUTO-DROPPED at scope exit
;;; through its Drop instance -- `TUR_CLOSURE_DROP` walks the captured `next`
;;; boxes down to the base handler, reclaiming the whole onion.  This retires the
;;; explicit `httpd-mw-drop` for the runtime-built-chain case: bind the fold
;;; result as a Handler and the compiler drops it for you.  The carrier is the
;;; same int64 fat-closure handle every httpd handler rides, so a Handler bridges
;;; to `:int` / `(fn [int] int)` by ascription.
;;;
;;; Since: automatic R3a (closure-drop-glue)

(defopaque Handler :int :affine)
;;; httpd-handler-drop -- internal: reclaim a composed Handler onion.
;;;
;;; Routes to `TUR_CLOSURE_DROP`, which recovers the env's drop-glue header and
;;; walks the owning captures (the wrapped downstream handlers) before freeing --
;;; the whole onion down to the base, released exactly once.  Consumes its affine
;;; argument.  This is the Drop instance's method; it is not normally called by
;;; hand (the scope-exit auto-drop calls it).
;;;
;;; Since: automatic R3a (closure-drop-glue)

(defn httpd-handler-drop [h : Handler] : void
  ```c
  int64_t __h = (int64_t)h;
  if (__h) TUR_CLOSURE_DROP(__h);
  ```)
;;; Drop [Handler] -- reclaim the onion when a bound Handler dies unmoved/unborrowed.

(definstance Drop [Handler] (drop [x] : void (httpd-handler-drop x)))
;;; httpd-handler-carrier -- CONSUME a Handler, yielding its raw int64 carrier for
;;; a server constructor (`^fat handler : (fn [ptr<void>] nil)`) or any `:int` handler sink that
;;; TAKES OWNERSHIP.
;;;
;;; Because the parameter is the affine Handler itself, passing a bound Handler
;;; here MOVES it -- which suppresses the scope-exit auto-drop, so the server
;;; (whose `httpd-free` / `httpd-async-free` already `TUR_CLOSURE_DROP`s its
;;; handler) becomes the SOLE owner with no double-free.  Use this at a server
;;; handoff; use `(:: h :int)` (a non-consuming read) only for a BORROW where the
;;; owner keeps the Handler and lets it auto-drop.
;;;
;;; Parameters:
;;;   h -- the composed Handler onion (consumed).
;;;
;;; Returns:
;;;   The raw int64 fat-closure carrier.
;;;
;;; Example:
;;;   (let [composed (compose-middleware-of base mw1 mw2)]
;;;     (httpd-new-pool 0 1 (httpd-handler-carrier composed)))
;;;
;;; Since: automatic R3a (closure-drop-glue)

(defn httpd-handler-carrier [h : Handler] : (fn [ptr<void>] nil)
  ```c
  return (int64_t)h;
  ```)
;;; ClosureChain -- an owned runtime-built middleware chain: a cons list whose
;;; heads are fresh, uniquely-owned factory closures and whose spine cells the
;;; builder owns.  `httpd-mw-fold` only BORROWS it (applies each head once); once
;;; the fold has produced its onion the whole chain -- heads and cells -- is dead.
;;;
;;; `:affine` (same discipline as `Handler`): a bound ClosureChain the builder
;;; neither MOVES nor BORROWS (`(:: chain :int)`) is AUTO-DROPPED at scope exit
;;; via its Drop instance, which walks the spine dropping each head
;;; (`TUR_CLOSURE_DROP`) and freeing each cell.  This is the automatic-R3a
;;; replacement for the explicit `httpd-mw-free-chain`.
;;;
;;; SOUNDNESS: sound iff each head is a DISTINCT, uniquely-owned closure (a fresh
;;; `(make-mw)` per cell) -- the same contract `httpd-mw-free-chain` documents.
;;; Do NOT cons the same closure value into the list twice (double-drop), and do
;;; NOT wrap a chain whose heads are the borrowed `& mws` of `compose-middleware-of`
;;; (those heads belong to the variadic caller; use `httpd-mw-free-spine`, which
;;; frees ONLY the cells).
;;;
;;; Since: automatic R3a (closure-drop-glue)

(defopaque ClosureChain :int :affine)
;;; httpd-chain-drop -- internal: reclaim a ClosureChain (drop each head factory
;;; via TUR_CLOSURE_DROP + free each spine cell).  Consumes its affine argument;
;;; it is the Drop instance's method, normally invoked by the scope-exit auto-drop.
;;;
;;; Since: automatic R3a (closure-drop-glue)

(defn httpd-chain-drop [c : ClosureChain] : void
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)(int64_t)c;
  while (p) {
      __tur_cons_cell *n = (__tur_cons_cell *)(intptr_t)p->tail;
      if (p->head) TUR_CLOSURE_DROP(p->head);
      free(p);
      p = n;
  }
  ```)
;;; Drop [ClosureChain] -- reclaim a runtime-built chain when its builder binding
;;; dies unmoved/unborrowed.

(definstance Drop [ClosureChain] (drop [x] : void (httpd-chain-drop x)))
;;; httpd-mw-apply -- internal: apply one fat-closure middleware to a handler.
;;;
;;; The middleware is a fat closure of shape
;;; (fn [next :int] :ptr<void> ...); this performs a single fat-closure
;;; dispatch -- the same ascription idiom as httpd-call -- and returns the
;;; wrapped handler. It holds no cons-layout knowledge; the list walk lives
;;; in httpd-mw-fold. The caller guards against a null mw.
;;;
;;; The dispatch ascription MUST name the middleware's REAL type,
;;; (fn [int] ptr<void>) -- the emitted call goes through a typed-thunk
;;; typedef derived from this ascription, and the lambda's definition is
;;; emitted from its own declared type.  The old (fn [int] int) spelling
;;; made the two disagree on the return type: works on every SysV/AAPCS ABI
;;; (same return slot), but it is UB that -fsanitize=function reports and
;;; that CFI / CET-BTI / WASM call_indirect turn into a hard failure.  The
;;; wrapped handler then crosses back to the :int carrier via a value
;;; ascription, which is a representation read, not a function-type cast.
;;; See docs/archive/emitter-thunk-type-return-mismatch.md.

(defn httpd-mw-apply [mw : int cur : int] : int
  (:: ((:: mw (fn [int] ptr<void>)) cur) :int))
;;; httpd-mw-fold -- internal: right-fold a cons-list of fat-closure
;;; middlewares over a base handler. Each cell holds a fat closure value of
;;; shape (fn [next :int] :ptr<void> ...). Applied right-to-left so the list
;;; head becomes the outermost wrapper. Null cells are skipped. Unbounded --
;;; the walk recurses over the cons-list abstraction (list-head/list-tail),
;;; so there is no fixed element cap.

(defn httpd-mw-fold [base : int mws : int] : int
  (if (= mws 0)
    base
    (let [inner (httpd-mw-fold base (list-tail mws))
          mw    (list-head mws)]
      (if (= mw 0) inner (httpd-mw-apply mw inner)))))
;;; httpd-mw-free-spine -- internal: free the cons-cell spine of a variadic
;;; middleware rest-list, leaving the head VALUES untouched. `compose-middleware-of`
;;; owns the fresh `& mws` list; `httpd-mw-fold` only walks it (applying each head
;;; once), so once the fold has built the wrapper chain the spine cells are dead
;;; and can be reclaimed. The head factories are borrowed (the caller frees them
;;; at its own scope exit), so this frees ONLY the cells, never the heads.

(defn httpd-mw-free-spine [mws : int] : nil
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)mws;
  while (p) {
      __tur_cons_cell *n = (__tur_cons_cell *)(intptr_t)p->tail;
      free(p);
      p = n;
  }
  ```)
;;; httpd-mw-drop -- SUPERSEDED: reclaim a raw-`:int` composed handler onion.
;;;
;;; Retired in favor of the `Handler` auto-drop (automatic R3a): bind the fold
;;; result as a `Handler` (`(:: (httpd-mw-fold base chain) :Handler)`, or use
;;; `compose-middleware-of`, which returns `Handler`) and the compiler drops the
;;; onion for you at scope exit -- no explicit call, and no risk of forgetting
;;; it.  Kept only for a legacy raw-`:int` onion that was never bound as a
;;; Handler; new code should not use it.
;;;
;;; Releases the outermost wrapper AND walks the captured downstream `next` boxes
;;; via the env's drop-glue header, so the whole onion (down to the base handler)
;;; is freed.
;;;
;;; Parameters:
;;;   handler -- the composed handler closure (:int); 0 is a no-op.
;;;
;;; Returns: nothing.
;;;
;;; Example (legacy -- prefer the Handler auto-drop):
;;;   (let [composed (:: (httpd-mw-fold base chain) :Handler)]
;;;     (httpd-call (:: composed :int) conn))   ; composed auto-drops at scope exit
;;;
;;; Since: R3a; superseded by Handler auto-drop (automatic R3a).

(defn httpd-mw-drop [handler : int] : nil
  ```c
  if (handler) TUR_CLOSURE_DROP(handler);
  ```)
;;; httpd-mw-free-chain -- SUPERSEDED: free a runtime-built middleware cons list
;;; (the INPUT to `httpd-mw-fold`): drop each head factory closure AND free each
;;; spine cell.
;;;
;;; Retired in favor of the `ClosureChain` auto-drop (automatic R3a half 2): bind
;;; the runtime chain as a `ClosureChain` (`(:: (build-chain n (tnil))
;;; :ClosureChain)`) and the compiler walks the spine, dropping each head and
;;; freeing each cell, at scope exit -- no explicit call.  This function's body is
;;; exactly the `Drop [ClosureChain]` method; kept only for a legacy raw-`:int`
;;; chain that was never bound as a ClosureChain.
;;;
;;; Unlike `httpd-mw-free-spine` (which leaves the heads, because the variadic
;;; `compose-middleware-of` caller owns and frees them), a hand-built runtime
;;; chain (e.g. from a `build-chain` loop) is owned entirely by its builder: the
;;; fold only BORROWS each factory (applies it once, discards it), so once the
;;; fold has produced the composed onion the whole list -- factories and cells --
;;; is dead and the builder reclaims it. Sound iff each head is a distinct,
;;; uniquely-owned closure (a fresh `(make-mw)` per cell); do NOT cons the same
;;; closure value into the list twice (that would double-drop it).
;;;
;;; Parameters:
;;;   mws -- the middleware cons list (:int); 0 is a no-op.
;;;
;;; Returns: nothing.
;;;
;;; Example (legacy -- prefer the ClosureChain auto-drop):
;;;   (let [chain    (:: (build-chain 70 (tnil)) :ClosureChain)
;;;         composed (:: (httpd-mw-fold base (:: chain :int)) :Handler)]
;;;     (httpd-call (:: composed :int) conn))  ; composed + chain auto-drop at scope exit
;;;
;;; Since: R3a; superseded by ClosureChain auto-drop (automatic R3a half 2).

(defn httpd-mw-free-chain [mws : int] : nil
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)mws;
  while (p) {
      __tur_cons_cell *n = (__tur_cons_cell *)(intptr_t)p->tail;
      if (p->head) TUR_CLOSURE_DROP(p->head);
      free(p);
      p = n;
  }
  ```)
;;; compose-middleware-of -- runtime variadic form of compose-middleware.
;;;
;;; This is a defn, not a macro. Use when the chain is built at runtime
;;; (e.g. dependent on config, feature flags, or a runtime-chosen subset).
;;; Apply order matches `compose-middleware`: leftmost = outermost.
;;;
;;; Each rest argument must be a *fat closure value* of shape
;;; `(fn [next :int] :ptr<void> ...)` -- i.e. a closure that captures at
;;; least one variable. A bare top-level defn name is NOT a fat closure;
;;; passing one will compile (thanks to the
;;; docs/archive/history/variadic-rest-closure-cast-plan.md fix) but the fat-
;;; closure dispatch dereferences code bytes as the fn pointer and
;;; BUS-faults. Bridge a bare defn through a let-captured `fn` literal:
;;;
;;;   (let [_ 0
;;;         mw-log-val (fn [n :int] :ptr<void> (mw-log n))
;;;         _ 0]
;;;     (compose-middleware-of base mw-log-val ...))
;;;
;;; For statically-known chains the macro form `compose-middleware`
;;; remains the better choice -- it accepts bare defns and catches
;;; non-callable mistakes at elaboration.
;;;
;;; Parameters:
;;;   base -- base handler, a `(fn [ptr<void>] nil)` closure
;;;   mws  -- variadic fat-closure middlewares; type variable A unifies
;;;           to whatever closure type the call site uses.
;;;
;;; Returns:
;;;   The fully-wrapped handler onion as an owned `Handler` -- bind it and the
;;;   compiler auto-drops it at scope exit (no explicit `httpd-mw-drop`), or hand
;;;   it to a server via `httpd-handler-carrier` (which moves it, suppressing the
;;;   auto-drop so the server owns it).
;;;
;;; Since: Phase H8 (M8 core); requires the V1 cast fix in
;;;        docs/archive/history/variadic-rest-closure-cast-plan.md.
;;;        Returns `Handler` since automatic R3a (closure-drop-glue).

(defn compose-middleware-of [A] [^fat base : (fn [ptr<void>] nil)
                                 ^borrow & mws :A] :Handler
  (let [composed (httpd-mw-fold base mws)]
    (httpd-mw-free-spine mws)
    (:: composed :Handler)))
;; =============================================================================
;; MW1: mw-body-size -- Content-Length cap (per docs/archive/httpd-middleware-plan.md)
;; =============================================================================
;;
;; Pre-handler middleware that consults the request's `Content-Length` header
;; and short-circuits with `413 Payload Too Large` when it exceeds the
;; configured ceiling. Requests with no `Content-Length` (e.g. simple GET)
;; or with a value at or below the cap pass through unchanged.
;;
;; The check is header-only, and it runs inside the handler chain -- that is,
;; AFTER the server has already read the body.  The server-wide ceiling that
;; stops a body being read or allocated at all is httpd-set-max-body! (8 MiB
;; by default); mw-body-size is the lower, per-route limit on top of it.
;; Chunked bodies are refused by the server (501) before any middleware runs.
;; Once the response is short-circuited the downstream handler is never
;; invoked.
;;; httpd-mw-content-length -- internal: read Content-Length as int64, or -1.
;;;
;;; Returns -1 when the header is absent or unparseable. A non-negative
;;; return value is the announced body size in bytes.

(defn httpd-mw-content-length [conn : ptr<void>] : int
  ```c
  if (!conn) return -1;
  if (!__TUR_CNAME_httpd-req-header?__((void *)conn, "Content-Length")) return -1;
  const char *v = httpd_hyreq_hyheader((void *)conn, "Content-Length");
  if (!v || !*v) return -1;
  /* Skip leading whitespace; require at least one digit. */
  while (*v == ' ' || *v == '\t') v++;
  if (*v < '0' || *v > '9') return -1;
  int64_t n = 0;
  while (*v >= '0' && *v <= '9') {
      /* Saturate rather than overflow; the server already refused anything
       * above httpd-set-max-body!'s cap before this runs. */
      if (n > (INT64_MAX - 9) / 10) return INT64_MAX;
      n = n * 10 + (int64_t)(*v - '0');
      v++;
  }
  return n;
  ```)
;;; mw-body-size -- reject requests with Content-Length > max-bytes with 413.
;;;
;;; When the request advertises a Content-Length greater than `max-bytes`
;;; this middleware responds with status 413 ("Payload Too Large") and a
;;; short plain-text body, and does NOT invoke `next`. Requests without a
;;; Content-Length header, or with a value at or below the cap, are passed
;;; through unchanged.
;;;
;;; The cap is on the announced size.  It runs after the server has read
;;; the body, so it limits what a handler accepts, not what the server
;;; buffers -- httpd-set-max-body! is the ceiling that stops the read itself.
;;;
;;; Parameters:
;;;   max-bytes -- maximum accepted Content-Length in bytes (>= 0)
;;;   next      -- downstream handler closure (fat-closure :int)
;;;
;;; Returns:
;;;   A wrapped handler closure (:ptr<void>) suitable for httpd-new /
;;;   compose-middleware.
;;;
;;; Example:
;;;   (let [composed (mw-body-size 1048576 base)]  ; 1 MiB cap
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (MW1)

(defn mw-body-size [max-bytes : int ^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (let [_max max-bytes
        _n   next]
    (fn [c : ptr<void>] : nil
      (let [n (httpd-mw-content-length c)]
        (if (> n _max)
          (do
            (httpd-resp-status! c 413)
            (httpd-resp-body! c "Payload Too Large"))
          (httpd-call _n c))))))
;; =============================================================================
;; MW2: Request attributes (per docs/archive/httpd-middleware-plan.md)
;; =============================================================================
;;
;; A small per-request key/value side-channel attached to httpd_conn.
;; Middleware uses it to pass context downstream (e.g. mw-basic-auth
;; publishes the authenticated user name; the handler reads it back via
;; (httpd-req-attr conn "user")). Stored as a singly-linked list of
;; HttpdAttr cells on the conn struct; freed (shallow) after the handler
;; returns, alongside the request/response header lists.
;;; httpd-set-attr! -- attach a key/value pair to the current request.
;;;
;;; Overwrites any previously-set value for the same key (case-sensitive).
;;; The key and value are copied into per-request storage; the original
;;; cstrings can be reused or freed by the caller. The attribute lives
;;; until the handler returns, then is freed alongside the request /
;;; response header lists.
;;;
;;; Parameters:
;;;   conn -- httpd connection pointer
;;;   key  -- attribute name (cstr)
;;;   val  -- attribute value (cstr)
;;;
;;; Example:
;;;   (httpd-set-attr! c "user" "alice")
;;;
;;; Since: Phase H8 (MW2)

(defn httpd-set-attr! [conn : ptr<void> key : cstr val : cstr] : nil
  ```c
  if (!conn || !key) return;
  HttpdConn *c = (HttpdConn *)conn;
  /* Overwrite if the key already exists. */
  HttpdAttr *ap = (HttpdAttr *)c->attr_list;
  while (ap) {
      if (ap->key && strcmp(ap->key, key) == 0) {
          if (ap->value) free(ap->value);
          ap->value = strdup(val ? val : "");
          return;
      }
      ap = ap->next;
  }
  /* Prepend new cell. */
  HttpdAttr *na = (HttpdAttr *)calloc(1, sizeof(HttpdAttr));
  if (!na) return;
  na->key   = strdup(key);
  na->value = strdup(val ? val : "");
  na->next  = (HttpdAttr *)c->attr_list;
  c->attr_list = na;
  ```)
;;; httpd-req-attr -- retrieve a previously set request attribute.
;;;
;;; Returns the empty string ("") if the key has not been set.  The
;;; returned pointer is into per-request storage and is only valid until
;;; the handler returns.
;;;
;;; Parameters:
;;;   conn -- httpd connection pointer
;;;   key  -- attribute name (cstr, case-sensitive)
;;;
;;; Returns:
;;;   The attribute value as a cstr, or "" when absent.
;;;
;;; Example:
;;;   (let [u (httpd-req-attr c "user")] ...)
;;;
;;; Since: Phase H8 (MW2)

(defn httpd-req-attr [conn : ptr<void> key : cstr] : cstr
  ```c
  if (!conn || !key) return "";
  HttpdAttr *ap = (HttpdAttr *)((HttpdConn *)conn)->attr_list;
  while (ap) {
      if (ap->key && strcmp(ap->key, key) == 0) {
          return ap->value ? ap->value : "";
      }
      ap = ap->next;
  }
  return "";
  ```)
;; =============================================================================
;; MW2: httpd-req-remote-ip -- look up the client's IP address.
;; =============================================================================
;;; httpd-req-remote-ip -- return the client's IP address as a cstr.
;;;
;;; Uses getpeername(2) on the connection fd. IPv4 addresses are returned
;;; in dotted-quad form ("203.0.113.4"); IPv6 in colon-hex form. Returns
;;; the empty string ("") on lookup failure. The returned pointer is into
;;; per-request storage and is valid only for the duration of the handler
;;; call.
;;;
;;; Parameters:
;;;   conn -- httpd connection pointer
;;;
;;; Returns:
;;;   The client IP as a cstr, or "" on failure.
;;;
;;; Example:
;;;   (let [ip (httpd-req-remote-ip c)] ...)
;;;
;;; Since: Phase H8 (MW2)

(defn httpd-req-remote-ip [conn : ptr<void>] : cstr
  ```c
  #include <arpa/inet.h>
  #include <sys/socket.h>
  if (!conn) return "";
  HttpdConn *c = (HttpdConn *)conn;
  /* Stash the formatted address on an attr so it lives as long as the
   * request and gets freed in the cleanup path automatically. */
  const char *cached = httpd_hyreq_hyattr((void *)conn, "__remote_ip");
  if (cached && *cached) return cached;
  struct sockaddr_storage ss;
  socklen_t sl = (socklen_t)sizeof(ss);
  if (getpeername(c->fd, (struct sockaddr *)&ss, &sl) != 0) return "";
  char ipbuf[64];
  ipbuf[0] = '\0';
  if (ss.ss_family == AF_INET) {
      struct sockaddr_in *sa = (struct sockaddr_in *)&ss;
      inet_ntop(AF_INET, &sa->sin_addr, ipbuf, sizeof(ipbuf));
  } else if (ss.ss_family == AF_INET6) {
      struct sockaddr_in6 *sa = (struct sockaddr_in6 *)&ss;
      inet_ntop(AF_INET6, &sa->sin6_addr, ipbuf, sizeof(ipbuf));
  }
  if (!ipbuf[0]) return "";
  __TUR_CNAME_httpd-set-attr!__((void *)conn, "__remote_ip", ipbuf);
  return httpd_hyreq_hyattr((void *)conn, "__remote_ip");
  ```)
;; =============================================================================
;; MW2: mw-rate-limit -- sliding-window per-IP rate limiter
;; =============================================================================
;;
;; State: a heap-allocated table of (ip, window_start, count) entries
;; protected by a pthread_mutex. The table is 8-way set-associative: the
;; FNV-1a hash of the client IP picks a set of 8 entries, and the IP string
;; itself is the key, so two IPs whose hashes collide never share a counter.
;; Each mw-rate-limit closure has its OWN table; multiple instances do not
;; share state.
;;
;; Sliding window semantics: each entry remembers when its current window
;; started. A request bumps the count; if (now - window_start) > window_s
;; the window resets first. When count > requests, the request is rejected
;; with 429 and a `Retry-After` header carrying the seconds until the
;; current window ends.
;;
;; A new IP takes an empty entry of its set, else one whose window has
;; already ended (it carries no information), else the entry whose window
;; started longest ago. So the table never fails open: a flood of distinct
;; IPs cannot fill it so that every further IP goes unlimited -- under one,
;; the IPs it evicts merely start a fresh window. Each check touches at most
;; 8 entries.
;;
;; This is a single-process limiter -- it does not coordinate across
;; multiple server instances. Share the table only within one process.
;;; RateLimitOpts -- mw-rate-limit configuration.
;;;
;;; Field conventions:
;;;   requests -- max requests per window (>= 1)
;;;   window-s -- window length in seconds (>= 1)
;;;
;;; Since: Phase H8 (MW2)

(defstruct RateLimitOpts [requests : int window-s : int])
;;; httpd-mw-ratelimit-new -- internal: allocate a fresh RL state struct.

(defn httpd-mw-ratelimit-new [requests : int window-s : int] : int
  ```c
  typedef struct {
      uint32_t ip_hash;          /* FNV-1a of the whole key; 0 = empty */
      int32_t  count;
      int64_t  window_start_s;
      char     ip[48];           /* the key (INET6_ADDRSTRLEN fits) */
  } RLEntry;
  typedef struct {
      pthread_mutex_t mtx;
      RLEntry        *entries;
      int             capacity;  /* n_sets * 8 */
      int             window_s;
      int             max_requests;
  } RLState;
  /* httpd-mw-rate-limit-state-leak: the RLState is captured by the
   * mw-rate-limit closure as a bare int handle, so neither httpd-free nor the
   * closure drop-glue reaches it -- it would leak ~24 KB per limiter for the
   * life of the process.  Track the two heap blocks (the state and its entry
   * table) on a process-global registry and free them from an atexit hook.
   * Freeing at process exit -- not at httpd-free -- is deliberate: two servers
   * can each own a limiter, and an httpd-free of one must not free the other's
   * still-live counter table.  The registry stores bare `void *` so its
   * file-scope typedef/globals/cleanup need no pthread_mutex_t (the __tur_include__
   * block is emitted above the preamble's <pthread.h>); the mutex lives inside
   * the freed RLState block and needs no separate teardown at process exit.
   * Registration runs during single-threaded middleware setup, so the registry
   * list itself needs no lock. */
  /* __tur_include__: #include <stdlib.h> */
  /* __tur_include__: typedef struct __RLReg { void *st; void *entries; struct __RLReg *next; } RLReg; */
  /* __tur_include__: static RLReg *g_rl_registry = 0; */
  /* __tur_include__: static int g_rl_atexit_registered = 0; */
  /* __tur_include__: static void httpd_rl_cleanup_all(void) { RLReg *r = g_rl_registry; while (r) { RLReg *nx = r->next; if (r->entries) free(r->entries); if (r->st) free(r->st); free(r); r = nx; } g_rl_registry = 0; } */
  RLState *st = (RLState *)calloc(1, sizeof(RLState));
  if (!st) return 0;
  st->capacity     = 256 * 8;   /* 256 sets of 8 ways, 128 KiB */
  st->window_s     = window_s > 0 ? (int)window_s : 1;
  st->max_requests = requests > 0 ? (int)requests : 1;
  st->entries      = (RLEntry *)calloc((size_t)st->capacity, sizeof(RLEntry));
  if (!st->entries) { free(st); return 0; }
  pthread_mutex_init(&st->mtx, NULL);
  /* Register the two heap blocks for process-exit cleanup. */
  RLReg *reg = (RLReg *)malloc(sizeof(RLReg));
  if (reg) {
      reg->st      = (void *)st;
      reg->entries = (void *)st->entries;
      reg->next    = g_rl_registry;
      g_rl_registry = reg;
      if (!g_rl_atexit_registered) { atexit(httpd_rl_cleanup_all); g_rl_atexit_registered = 1; }
  }
  return (int64_t)(intptr_t)st;
  ```)
;;; httpd-mw-ratelimit-check -- internal: bump the counter for ip; return
;;; 0 if the request is allowed, or N>0 = the seconds until the window
;;; ends when the request must be rejected.

(defn httpd-mw-ratelimit-check [state : int ip : cstr] : int
  ```c
  #include <time.h>
  typedef struct {
      uint32_t ip_hash;          /* FNV-1a of the whole key; 0 = empty */
      int32_t  count;
      int64_t  window_start_s;
      char     ip[48];           /* the key (INET6_ADDRSTRLEN fits) */
  } RLEntry;
  typedef struct {
      pthread_mutex_t mtx;
      RLEntry        *entries;
      int             capacity;  /* n_sets * 8 */
      int             window_s;
      int             max_requests;
  } RLState;
  if (!state || !ip || !*ip) return 0;
  RLState *st = (RLState *)(intptr_t)state;
  /* FNV-1a 32-bit hash of the IP cstr: it picks the set and is a fast
   * pre-check, but the key is the IP itself (the first 47 bytes of a longer
   * one, whose hash still covers it whole) -- two IPs whose 32-bit hashes
   * collide used to share one counter. */
  uint32_t h = 2166136261u;
  for (const char *p = ip; *p; p++) {
      h ^= (uint8_t)*p;
      h *= 16777619u;
  }
  if (h == 0) h = 1;  /* reserve 0 for "empty slot" */
  const int ways = 8;
  int n_sets = st->capacity / ways;
  RLEntry *set = &st->entries[(size_t)(h % (uint32_t)n_sets) * (size_t)ways];
  struct timespec ts;
  clock_gettime(CLOCK_REALTIME, &ts);
  int64_t now = (int64_t)ts.tv_sec;
  pthread_mutex_lock(&st->mtx);
  RLEntry *hit = NULL, *empty = NULL, *ended = NULL, *oldest = NULL;
  for (int w = 0; w < ways; w++) {
      RLEntry *e = &set[w];
      if (e->ip_hash == 0) { if (!empty) empty = e; continue; }
      if (e->ip_hash == h && strncmp(e->ip, ip, sizeof e->ip - 1) == 0) { hit = e; break; }
      if (now - e->window_start_s >= (int64_t)st->window_s) { if (!ended) ended = e; }
      if (!oldest || e->window_start_s < oldest->window_start_s) oldest = e;
  }
  if (!hit) {
      /* A new IP: an empty entry, else one whose window has ended, else the
       * oldest window in the set.  Never fail open -- a full table used to
       * allow every IP it could not place. */
      RLEntry *e = empty ? empty : ended ? ended : oldest;
      e->ip_hash        = h;
      e->window_start_s = now;
      e->count          = 1;
      strncpy(e->ip, ip, sizeof e->ip - 1);
      e->ip[sizeof e->ip - 1] = '\0';
      pthread_mutex_unlock(&st->mtx);
      return 0;
  }
  /* Existing window for this IP. */
  int64_t age = now - hit->window_start_s;
  if (age >= (int64_t)st->window_s) {
      hit->window_start_s = now;
      hit->count          = 1;
      pthread_mutex_unlock(&st->mtx);
      return 0;
  }
  hit->count++;
  if (hit->count > st->max_requests) {
      int retry = (int)((int64_t)st->window_s - age);
      if (retry < 1) retry = 1;
      pthread_mutex_unlock(&st->mtx);
      return retry;
  }
  pthread_mutex_unlock(&st->mtx);
  return 0;
  ```)
;;; httpd-mw-ratelimit-emit-429 -- internal: write the 429 response.

(defn httpd-mw-ratelimit-emit-429 [conn : ptr<void> retry-s : int] : nil
  ```c
  if (!conn) return;
  __TUR_CNAME_httpd-resp-status!__((void *)conn, 429);
  __TUR_CNAME_httpd-resp-body!__((void *)conn, "Too Many Requests");
  char buf[32];
  snprintf(buf, sizeof(buf), "%lld", (long long)retry_s);
  __TUR_CNAME_httpd-resp-header!__((void *)conn, "Retry-After", buf);
  ```)
;;; mw-rate-limit -- sliding-window IP-based rate limiter middleware.
;;;
;;; Each mw-rate-limit instance allocates its own counter table. When the
;;; same client IP exceeds `requests` requests within `window-s` seconds
;;; the middleware responds with `429 Too Many Requests` plus a
;;; `Retry-After: <seconds>` header without invoking `next`.
;;;
;;; Multiple mw-rate-limit instances get independent counters; share by
;;; reusing the same wrapped closure across compositions.
;;;
;;; Parameters:
;;;   opts -- RateLimitOpts
;;;   next -- downstream handler closure (fat-closure :int)
;;;
;;; Returns:
;;;   A wrapped handler closure (:ptr<void>) suitable for httpd-new /
;;;   compose-middleware.
;;;
;;; Example:
;;;   (let [composed (mw-rate-limit (make-struct RateLimitOpts 60 60) base)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (MW2)

(defn mw-rate-limit [opts : RateLimitOpts ^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (let [_st (httpd-mw-ratelimit-new (.requests opts) (.window-s opts))
        _n  next]
    (fn [c : ptr<void>] : nil
      (let [ip    (httpd-req-remote-ip c)
            retry (httpd-mw-ratelimit-check _st ip)]
        (if (> retry 0) (httpd-mw-ratelimit-emit-429 c retry) (httpd-call _n c))))))
;; =============================================================================
;; MW2: mw-static -- serve files from a root directory.
;; =============================================================================
;;
;; Defers to `next` first; only serves a file when next returned 404. The
;; file path is the request path joined onto root-dir; `..` segments are
;; rejected to prevent traversal out of root-dir. Content-Type comes from
;; the extension (small built-in table). ETag is `"<size>-<mtime>"`; a
;; matching `If-None-Match` produces 304 without resending the body.
;;
;; Files are read fully into memory; this is not suitable for very large
;; files (use a streaming backend for that).
;;; httpd-mw-static-mime -- internal: map an extension to a Content-Type.

(defn httpd-mw-static-mime [path : cstr] : cstr
  ```c
  if (!path) return "application/octet-stream";
  const char *dot = strrchr(path, '.');
  if (!dot || !dot[1]) return "application/octet-stream";
  const char *ext = dot + 1;
  if (strcasecmp(ext, "html") == 0 || strcasecmp(ext, "htm") == 0) return "text/html; charset=utf-8";
  if (strcasecmp(ext, "css") == 0)  return "text/css; charset=utf-8";
  if (strcasecmp(ext, "js")  == 0)  return "application/javascript; charset=utf-8";
  if (strcasecmp(ext, "json")== 0)  return "application/json";
  if (strcasecmp(ext, "txt") == 0)  return "text/plain; charset=utf-8";
  if (strcasecmp(ext, "png") == 0)  return "image/png";
  if (strcasecmp(ext, "jpg") == 0 || strcasecmp(ext, "jpeg") == 0) return "image/jpeg";
  if (strcasecmp(ext, "gif") == 0)  return "image/gif";
  if (strcasecmp(ext, "svg") == 0)  return "image/svg+xml";
  if (strcasecmp(ext, "ico") == 0)  return "image/x-icon";
  if (strcasecmp(ext, "wasm")== 0)  return "application/wasm";
  return "application/octet-stream";
  ```)
;;; httpd-mw-static-try -- internal: attempt to serve `path` from `root`
;;; relative to the request `req-path`. Returns 1 on success (response
;;; written), 0 if the file is not found / forbidden.

(defn httpd-mw-static-try [conn : ptr<void> root : cstr] : int
  ```c
  #include <sys/stat.h>
  #include <fcntl.h>
  #include <unistd.h>
  #include <limits.h>
  #ifndef O_NOFOLLOW
  #define O_NOFOLLOW 0
  #endif
  if (!conn || !root || !*root) return 0;
  HttpdConn *c = (HttpdConn *)conn;
  const char *rp = c->path;
  if (!rp || !*rp) return 0;
  /* security-audit-plan M-4.  The request path is used up to its query
   * string, and refused outright when any segment starts with '.' (".", "..",
   * and dotfiles such as .env or .git/config -- .well-known excepted) or it
   * contains a backslash (a separator on Windows).  The substring check stays
   * as a second line. */
  size_t rpl = strcspn(rp, "?#");
  if (memchr(rp, '\\', rpl)) return 0;
  for (size_t i = 0; i < rpl; i++) {
      if ((i == 0 || rp[i - 1] == '/') && rp[i] == '.') {
          size_t sl = strcspn(rp + i, "/?#");
          if (!(sl == 11 && strncmp(rp + i, ".well-known", 11) == 0)) return 0;
      }
  }
  if (strstr(rp, "..")) return 0;
  /* Build "<root>/<reqpath>" with at most one slash. */
  char full[2048];
  size_t rl = strlen(root);
  if (rl >= sizeof(full) - 2) return 0;
  memcpy(full, root, rl);
  size_t off = rl;
  const char *seg = rp;
  size_t pl = rpl;
  if (off > 0 && full[off-1] == '/' && seg[0] == '/') { seg++; pl--; }
  else if (!(off == 0 || full[off-1] == '/' || seg[0] == '/')) full[off++] = '/';
  if (off + pl + 1 >= sizeof(full)) return 0;
  memcpy(full + off, seg, pl);
  off += pl;
  full[off] = '\0';
  /* Containment: the file, with every symlink resolved, must sit under the
   * root with every symlink resolved.  A symlink inside the root that points
   * outside it used to be served, because stat and open both follow it.
   * The buffers are sized without trusting PATH_MAX to exist: `tur jit`'s C
   * front end supplies its own <limits.h>, which has none, and a bare
   * PATH_MAX sent every program reaching this function to the cc fallback.
   * 4096 is at least PATH_MAX wherever the fallback applies (Linux 4096,
   * macOS 1024). */
  #ifdef PATH_MAX
  #define HTTPD_REALPATH_BUF PATH_MAX
  #else
  #define HTTPD_REALPATH_BUF 4096
  #endif
  char rroot[HTTPD_REALPATH_BUF], rfull[HTTPD_REALPATH_BUF];
  #ifdef _WIN32
  if (!_fullpath(rroot, root, sizeof rroot) || !_fullpath(rfull, full, sizeof rfull)) return 0;
  #else
  if (!realpath(root, rroot) || !realpath(full, rfull)) return 0;
  #endif
  size_t rrl = strlen(rroot);
  while (rrl > 1 && (rroot[rrl - 1] == '/' || rroot[rrl - 1] == '\\')) rroot[--rrl] = '\0';
  if (strncmp(rfull, rroot, rrl) != 0) return 0;
  if (!(rrl == 1 || rfull[rrl] == '/' || rfull[rrl] == '\\')) return 0;
  /* Open the resolved path and stat what was opened, not the name. */
  int ffd = open(rfull, O_RDONLY | O_NOFOLLOW);
  if (ffd < 0) return 0;
  struct stat sb;
  if (fstat(ffd, &sb) != 0 || !S_ISREG(sb.st_mode)) { close(ffd); return 0; }
  /* ETag = "<size>-<mtime>" */
  char etag[64];
  snprintf(etag, sizeof(etag), "\"%llx-%llx\"",
           (unsigned long long)sb.st_size,
           (unsigned long long)sb.st_mtime);
  /* Conditional request: If-None-Match. */
  const char *inm = httpd_hyreq_hyheader((void *)conn, "If-None-Match");
  if (inm && *inm && strcmp(inm, etag) == 0) {
      close(ffd);
      __TUR_CNAME_httpd-resp-status!__((void *)conn, 304);
      __TUR_CNAME_httpd-resp-body!__((void *)conn, "");
      __TUR_CNAME_httpd-resp-header!__((void *)conn, "ETag", etag);
      return 1;
  }
  /* Read the file into a heap buffer. */
  size_t sz = (size_t)sb.st_size;
  char  *buf = (char *)malloc(sz + 1);
  if (!buf) { close(ffd); return 0; }
  size_t got = 0;
  while (got < sz) {
      ssize_t r = read(ffd, buf + got, sz - got);
      if (r <= 0) break;
      got += (size_t)r;
  }
  close(ffd);
  if (got != sz) { free(buf); return 0; }
  buf[got] = '\0';
  /* Hand the buffer to __TUR_CNAME_httpd-resp-body!__ which strdups its arg; free ours. */
  __TUR_CNAME_httpd-resp-status!__((void *)conn, 200);
  /* __TUR_CNAME_httpd-resp-body!__ uses strlen so binary files with embedded NULs are
   * truncated. The mw-static API ships as a "small static files" surface;
   * binary safety is a future enhancement. */
  __TUR_CNAME_httpd-resp-body!__((void *)conn, buf);
  free(buf);
  {
      /* The type comes from the path without its query string. */
      char mp[1024];
      size_t ml = rpl < sizeof mp - 1 ? rpl : sizeof mp - 1;
      memcpy(mp, rp, ml); mp[ml] = '\0';
      __TUR_CNAME_httpd-resp-header!__((void *)conn, "Content-Type", httpd_hymw_hystatic_hymime(mp));
  }
  __TUR_CNAME_httpd-resp-header!__((void *)conn, "ETag", etag);
  return 1;
  ```)
;;; mw-static -- serve files from a root directory when next returns 404.
;;;
;;; Composes after a router: `next` is consulted first; only when `next`
;;; sets the response status to 404 (the default-handler signal that no
;;; route matched) does mw-static attempt to serve a file. The request
;;; path is joined onto `root-dir` and `..` segments are rejected as a
;;; path-traversal guard. The `Content-Type` is inferred from the file
;;; extension; an ETag of `"<size>-<mtime>"` is emitted and honoured
;;; (`If-None-Match` matching returns 304 without resending the body).
;;;
;;; Parameters:
;;;   root-dir -- filesystem path to serve files from
;;;   next     -- downstream handler closure (fat-closure :int)
;;;
;;; Returns:
;;;   A wrapped handler closure (:ptr<void>).
;;;
;;; Example:
;;;   (let [composed (mw-static "./public" router-handler)]
;;;     (httpd-new 0 composed))
;;;
;;; Since: Phase H8 (MW2)
;;; httpd-mw-static-fallback -- internal: when the response status is 404,
;;; try to serve a file from root; otherwise no-op. Always returns nil.


(defn httpd-mw-static-fallback [conn : ptr<void> root : cstr] : nil
  ```c
  if (!conn) return;
  if (httpd_hyresp_hystatus_hyget((void *)conn) != 404) return;
  (void)httpd_hymw_hystatic_hytry((void *)conn, root);
  ```)

(defn mw-static [root-dir : cstr ^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (let [_root root-dir
        _n    next]
    (fn [c : ptr<void>] : nil
      (httpd-call _n c)
      (httpd-mw-static-fallback c _root))))

;; =============================================================================
;; MW3: mw-recover -- turn a downstream panic into a 500 response
;; =============================================================================
;;
;; Runs `next` under `catch-unwind`.  When the downstream handler panics,
;; the unwind is caught at the middleware boundary, the worker thread
;; survives, and the client gets a 500 instead of a dropped connection.
;;
;; The status/body are only written when the handler had not already set a
;; status before it panicked -- a handler that got as far as
;; `(httpd-resp-status! c 201)` and then blew up keeps its own status
;; rather than having it silently rewritten.

;;; httpd-mw-recover-500 -- internal: write a 500 response unless the
;;; handler already set a status before panicking. Always returns nil.

(defn httpd-mw-recover-500 [conn : ptr<void>] : nil
  (when (= 0 (httpd-resp-status-get conn))
    (httpd-resp-status! conn 500)
    (httpd-resp-body! conn "Internal Server Error")))

;;; mw-recover -- catch a downstream panic and respond 500.
;;;
;;; Wraps a base handler so that a `panic` (or any unwind) raised inside
;;; `next` is caught at the middleware boundary.  Without it a panicking
;;; handler unwinds out of the worker and takes the process (or at best
;;; the connection) with it; with it the request gets a 500 and the
;;; server keeps serving.
;;;
;;; Put it OUTERMOST in the middleware chain -- it can only recover
;;; panics raised by handlers it wraps, and an outer middleware's
;;; post-processing still runs on the 500 response.
;;;
;;; Parameters:
;;;   next -- downstream handler closure (fat-closure :int)
;;;
;;; Returns:
;;;   A wrapped handler closure (:ptr<void>).
;;;
;;; Example:
;;;   (let [base     (fn [c :ptr<void>] :nil (panic "boom"))
;;;         composed (compose-middleware base mw-recover)]
;;;     (httpd-new 0 composed))
;;;   ; => client sees "500 Internal Server Error"; the server stays up
;;;
;;; Since: Phase H8 (MW3)

(defn mw-recover [^fat next : (fn [ptr<void>] nil)] : ptr<void>
  (let [_n next]
    (fn [c : ptr<void>] : nil
      (let [r (catch-unwind (fn [] : int (do (httpd-call _n c) 0)))]
        (when (err? r) (httpd-mw-recover-500 c))))))
