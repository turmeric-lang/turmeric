;;; tur/workflow -- persistent workflow helpers built on tur/serial.
;;;
;;; Higher-level API for checkpointed, resumable long-running computations.
;;;
;;; Since: Phase 21
;; stdlib/workflow.tur -- Phase 21: Serializable continuations -- workflow helpers
;;
;; Higher-level API for persistent workflows built on top of serial-reset /
;; serial-shift.  Inspired by Racket's web-server continuation style.
;;
;; NOTE: Full end-to-end serialisation requires serial-shift codegen
;; (Phase 21 compiler work) to be complete.  These helpers provide the
;; surface-level API that programs should target.
;; ---------------------------------------------------------------------------
;; Low-level: bytes <-> file helpers (see also stdlib/serial.tur)
;; ---------------------------------------------------------------------------
;; save-cont! -- serialise a serial-continuation to a bytes value and save it.
;; The continuation value is opaque; programs pass it here after capturing it
;; with serial-shift.
;;
;; (save-cont! k)  -->  bytes
;;   k : ptr<void>   (opaque serial-continuation handle)
;;   returns the serialised bytes (or nil on failure)
;;; save-cont! -- serialise an opaque serial-continuation handle to a bytes value.
;;;
;;; Parameters:
;;;   k -- opaque continuation pointer from serial-shift
;;;
;;; Returns:
;;;   A bytes :ptr<void> on success (a length-prefixed {int64 len; data} buffer
;;;   the caller owns and must free), or nil if k is nil.
;;;
;;; Since: Phase 21
(defn save-cont! [k : ptr<void>] : ptr<void>
  ```c
  /* Phase 21: marshal the captured DK continuation chain to bytes.
   * tur_serial_cont_serialize (emitted by the serial DK runtime prelude
   * whenever the program uses serial-reset) walks the chain k and writes
   * each frame's stable tag + env -- no code addresses -- to a length-prefixed
   * buffer. k is a DK* carried as an opaque ptr<void>. */
  if (!k) return NULL;
  return (void *)(intptr_t)tur_serial_cont_serialize((int64_t)(intptr_t)k);
  ```)
;; resume-cont! -- deserialise a bytes value back to a continuation and resume it.
;;
;; (resume-cont! b v)  -->  int
;;   b : ptr<void>  (serialised bytes from save-cont!)
;;   v : int        (value to resume the continuation with)
;;; resume-cont! -- deserialise a bytes value and resume the encoded continuation with v.
;;;
;;; Parameters:
;;;   b -- serialised bytes from save-cont!
;;;   v -- value to pass to the resumed continuation
;;;
;;; Returns:
;;;   The continuation's return value, after rebuilding the chain from b and
;;;   resuming it with v.  A b that is not a valid continuation buffer for
;;;   this program is a panic (never a resumed garbage chain); use
;;;   bytes->serial-cont from stdlib/serial.tur to get a Result instead.
;;;
;;; Since: Phase 21

(defn resume-cont! [b : ptr<void> v : int] : int
  ```c
  /* Phase 21: rebuild the DK continuation chain from the marshaled bytes b
   * (mapping each frame's tag/name back to its frame fn via the self-registered
   * SkReg table) and resume it on v. */
  if (!b) return 0;
  int64_t __k = tur_serial_cont_deserialize((int64_t)(intptr_t)b);
  int64_t __r = tur_serial_cont_resume(__k, (int64_t)v);
  /* The resume ran a COPY (dk_invoke), and nothing else holds the chain the
   * deserializer just built -- b, not __k, is what a caller resumes again. */
  dk_free((DK *)(intptr_t)__k);
  return __r;
  ```)
;; ---------------------------------------------------------------------------
;; Workflow step helpers
;;
;; A "workflow step" is a point in a computation that may be suspended,
;; persisted, and resumed later -- e.g. waiting for human approval.
;; ---------------------------------------------------------------------------
;; workflow-suspend -- suspend the current workflow step, persisting k to bytes.
;; Returns the serialised bytes.  The caller is responsible for storing them
;; (e.g. writing to a database or file).
;;
;; Usage inside a serial-reset:
;;   (serial-reset
;;     (let [approved? (serial-shift (fn [k] (workflow-suspend k)) false)]
;;       ...))
;;; workflow-suspend -- suspend the current workflow step by serialising continuation k.
;;;
;;; Parameters:
;;;   k -- opaque continuation pointer from serial-shift
;;;
;;; Returns:
;;;   Serialised bytes :ptr<void> from save-cont! (nil if not yet implemented).
;;;
;;; Example:
;;;   (serial-reset
;;;     (let [ok? (serial-shift (fn [k] (workflow-suspend k)) false)]
;;;       ...))
;;;
;;; Since: Phase 21


(defn workflow-suspend [k : ptr<void>] : ptr<void> (save-cont! k))
;; workflow-resume -- resume a previously suspended workflow step.
;; b    : bytes value from workflow-suspend
;; v    : value to pass to the resumed continuation
;;; workflow-resume -- resume a previously suspended workflow step with value v.
;;;
;;; Parameters:
;;;   b -- bytes value produced by workflow-suspend
;;;   v -- value to inject into the resumed continuation
;;;
;;; Returns:
;;;   The continuation's return value (0 when not yet implemented).
;;;
;;; Since: Phase 21

(defn workflow-resume [b : ptr<void> v : int] : int (resume-cont! b v))
