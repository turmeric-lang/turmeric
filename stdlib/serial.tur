;;; tur/serial -- serializable continuations for persistent workflow state.
;;;
;;; Defines the Serializable typeclass with primitive and container instances.
;;;
;;; Since: Phase 21
;; stdlib/serial.tur -- Phase 21: Serializable continuations
;;
;; Defines the Serializable typeclass and primitive/container instances.
;; Implementation uses inline C since the methods operate on raw bytes.
(extern-c malloc [^int size] :ptr<void>)

(extern-c free [^ptr<void> p] :void)

(extern-c memcpy [^ptr<void> dst ^ptr<void> src ^int n] :ptr<void>)

(extern-c memcmp [^ptr<void> a ^ptr<void> b ^int n] :int)

(extern-c strlen [^cstr s] :int)

(extern-c exit [^int code] :void)
;; ---------------------------------------------------------------------------
;; bytes -- a length-prefixed heap buffer: { int64 len; uint8_t data[]; }
;; ---------------------------------------------------------------------------
;; ---- Opaque handle newtype + linearity (stdlib-linearity-affinity-plan, L3) ----
;; Bytes wraps the length-prefixed heap buffer handed out by bytes-alloc /
;; bytes-concat with a nominally distinct type, so the checker rejects passing
;; an unrelated pointer where a bytes value is expected. It is :linear: the
;; buffer is owned and must be released exactly once with bytes-free. Under
;; -Xlinear the checker rejects dropping a Bytes (TUR-E0100) or freeing it twice
;; (TUR-E0101); the read accessors bytes-len / bytes-data declare their handle
;; ^borrow, and bytes-concat borrows both operands (it allocates a fresh buffer
;; rather than consuming its inputs). Bytes lowers to :ptr<void> in the C ABI,
;; so the inline-C bodies are unchanged.
;;
;; The Serializable typeclass below (serialize / deserialize) and the
;; cont-to-file / cont-from-file helpers continue to traffic in raw :ptr<void>
;; marshalled buffers -- they are a separate, return-type-polymorphic surface
;; that is not part of the owned-buffer resource discipline.

(defopaque Bytes :ptr<void> :linear)
;; Allocate a fresh bytes value of `n` bytes (zeroed).
;;; bytes-alloc -- allocate a zeroed length-prefixed byte buffer of n bytes.
;;;
;;; Parameters:
;;;   n -- number of data bytes to allocate (not counting the 8-byte length prefix)
;;;
;;; Returns:
;;;   A :ptr<void> to the new bytes value; free with bytes-free.
;;;
;;; Example:
;;;   (def b (bytes-alloc 16))  ; => 16-byte zeroed buffer
;;;
;;; Since: Phase 21


(defn bytes-alloc [n : int] : Bytes
  ```c
  /* A negative n wrapped `8 + (size_t)n` to a tiny block and the memset
     below ran off it (security audit WP5, M-5). */
  if (n < 0 || n > INT64_MAX - (int64_t)sizeof(int64_t)) {
    fprintf(stderr, "bytes-alloc: length %lld out of range\n", (long long)n);
    exit(1);
  }
  int64_t *buf = malloc(sizeof(int64_t) + (size_t)n);
  if (!buf) { fprintf(stderr, "bytes-alloc: out of memory\n"); exit(1); }
  buf[0] = (int64_t)n;
  memset(buf + 1, 0, (size_t)n);
  return (void *)(intptr_t)buf;
  ```)
;; Return the length of a bytes value.
;;; bytes-len -- return the number of data bytes stored in a bytes value.
;;;
;;; Parameters:
;;;   b -- bytes pointer from bytes-alloc or a serialize call
;;;
;;; Returns:
;;;   The data length as :int (0 for null pointer).
;;;
;;; Since: Phase 21

(defn bytes-len [^borrow b : Bytes] : int
  ```c
  if (!b) return 0;
  return (int64_t)(((int64_t*)b)[0]);
  ```)
;; Return a pointer to the raw data inside a bytes value.
;;; bytes-data -- return a raw pointer to the data region of a bytes value (past the length prefix).
;;;
;;; Parameters:
;;;   b -- bytes pointer from bytes-alloc or a serialize call
;;;
;;; Returns:
;;;   :ptr<void> to the first data byte, or NULL for a null pointer.
;;;
;;; Since: Phase 21

(defn bytes-data [^borrow b : Bytes] : ptr<void>
  ```c
  if (!b) return NULL;
  return (void*)((int64_t*)b + 1);
  ```)
;; Free a bytes value.
;;; bytes-free -- free a bytes value allocated by bytes-alloc or serialize.
;;;
;;; Parameters:
;;;   b -- bytes pointer to free
;;;
;;; Since: Phase 21

(defn bytes-free [b : Bytes] : void
  ```c
  free((void *)(intptr_t)b);
  ```)
;; Concatenate two bytes values into a new one.
;;; bytes-concat -- concatenate two bytes values into a new heap-allocated bytes value.
;;;
;;; Parameters:
;;;   a -- first bytes value (may be null, treated as empty)
;;;   b -- second bytes value (may be null, treated as empty)
;;;
;;; Returns:
;;;   A new bytes value containing all bytes of a followed by all bytes of b.
;;;
;;; Example:
;;;   (bytes-concat ba bb)  ; => new bytes with ba then bb
;;;
;;; Since: Phase 21

(defn bytes-concat [^borrow a : Bytes ^borrow b : Bytes] : Bytes
  ```c
  int64_t la = a ? ((int64_t*)a)[0] : 0;
  int64_t lb = b ? ((int64_t*)b)[0] : 0;
  if (la < 0 || lb < 0 || la > INT64_MAX - (int64_t)sizeof(int64_t) - lb) {
    fprintf(stderr, "bytes-concat: length out of range\n"); exit(1);
  }
  int64_t total = la + lb;
  int64_t *out = malloc(sizeof(int64_t) + (size_t)total);
  if (!out) { fprintf(stderr, "bytes-concat: out of memory\n"); exit(1); }
  out[0] = total;
  uint8_t *dst = (uint8_t*)(out + 1);
  if (la > 0) memcpy(dst, (int64_t*)a + 1, (size_t)la);
  if (lb > 0) memcpy(dst + la, (int64_t*)b + 1, (size_t)lb);
  return (void *)(intptr_t)out;
  ```)
;; ---------------------------------------------------------------------------
;; Serializable typeclass
;;
;; Methods:
;;   (serialize   x)  : bytes  -- marshal x to bytes
;;   (deserialize b)  : x      -- unmarshal (panics on error for now; full
;;                                Result support is deferred until Result is
;;                                a first-class generic type in the compiler)
;; ---------------------------------------------------------------------------
;;; Serializable -- typeclass for types that can be marshalled to/from bytes.
;;;
;;; Methods:
;;;   serialize   [x]           -- marshal x to a length-prefixed bytes value
;;;   deserialize [b :ptr<void>] -- unmarshal from bytes; panics on malformed input
;;;
;;; Since: Phase 21


(defclass Serializable [a]
  (serialize [x] : ptr<void>)
  (deserialize [b : ptr<void>] : a))
;; ---------------------------------------------------------------------------
;; Primitive instances
;; Each instance packs its value as little-endian bytes, prefixed by length.
;; ---------------------------------------------------------------------------
;; int (int64) -- 8 bytes little-endian
;;; Serializable [int] -- serialize/deserialize int64 as 8 little-endian bytes.
;;;
;;; Since: Phase 21


(definstance Serializable [int]
  (serialize [x]
    ```c
    int64_t *buf = malloc(sizeof(int64_t) + 8);
    if (!buf) { fprintf(stderr, "serialize int: oom\n"); exit(1); }
    buf[0] = 8;
    uint8_t *p = (uint8_t*)(buf + 1);
    int64_t v = (int64_t)x;
    p[0] = (uint8_t)(v & 0xff);
    p[1] = (uint8_t)((v >>  8) & 0xff);
    p[2] = (uint8_t)((v >> 16) & 0xff);
    p[3] = (uint8_t)((v >> 24) & 0xff);
    p[4] = (uint8_t)((v >> 32) & 0xff);
    p[5] = (uint8_t)((v >> 40) & 0xff);
    p[6] = (uint8_t)((v >> 48) & 0xff);
    p[7] = (uint8_t)((v >> 56) & 0xff);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 8) {
      fprintf(stderr, "deserialize int: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    uint64_t v = 0;
    for (int i = 0; i < 8; i++) v |= ((uint64_t)p[i]) << (8 * i);
    return (int64_t)v;
    ```))
;; bool -- 1 byte (0 or 1)
;;; Serializable [bool] -- serialize/deserialize bool as a single byte (0 = false, 1 = true).
;;;
;;; Since: Phase 21

(definstance Serializable [bool]
  (serialize [x]
    ```c
    int64_t *buf = malloc(sizeof(int64_t) + 1);
    if (!buf) { fprintf(stderr, "serialize bool: oom\n"); exit(1); }
    buf[0] = 1;
    ((uint8_t*)(buf + 1))[0] = x ? 1 : 0;
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 1) {
      fprintf(stderr, "deserialize bool: short buffer\n"); exit(1);
    }
    return (int64_t)(((uint8_t*)((int64_t*)b + 1))[0] != 0);
    ```))
;; float64 (double) -- 8 bytes IEEE 754 little-endian
;;; Serializable [float] -- serialize/deserialize float64 as 8 bytes IEEE 754 little-endian.
;;;
;;; Since: Phase 21

(definstance Serializable [float]
  (serialize [x]
    ```c
    int64_t *buf = malloc(sizeof(int64_t) + 8);
    if (!buf) { fprintf(stderr, "serialize float: oom\n"); exit(1); }
    buf[0] = 8;
    double dv = *(double*)&x;
    uint64_t bits;
    memcpy(&bits, &dv, 8);
    uint8_t *p = (uint8_t*)(buf + 1);
    p[0] = (uint8_t)(bits & 0xff);
    p[1] = (uint8_t)((bits >>  8) & 0xff);
    p[2] = (uint8_t)((bits >> 16) & 0xff);
    p[3] = (uint8_t)((bits >> 24) & 0xff);
    p[4] = (uint8_t)((bits >> 32) & 0xff);
    p[5] = (uint8_t)((bits >> 40) & 0xff);
    p[6] = (uint8_t)((bits >> 48) & 0xff);
    p[7] = (uint8_t)((bits >> 56) & 0xff);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 8) {
      fprintf(stderr, "deserialize float: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    uint64_t bits =
        (uint64_t)p[0]
      | ((uint64_t)p[1] <<  8)
      | ((uint64_t)p[2] << 16)
      | ((uint64_t)p[3] << 24)
      | ((uint64_t)p[4] << 32)
      | ((uint64_t)p[5] << 40)
      | ((uint64_t)p[6] << 48)
      | ((uint64_t)p[7] << 56);
    double dv;
    memcpy(&dv, &bits, 8);
    /* The instance is emitted with its NATIVE signature (`double f(void*)`),
     * so hand back the double itself.  Returning the bit pattern through an
     * int64 lvalue converted it numerically (7.1 came back as 4.6e18). */
    return dv;
    ```))
;; cstr -- length-prefixed UTF-8 string (4-byte little-endian length + bytes)
;;; Serializable [cstr] -- serialize/deserialize a cstr as a 4-byte LE length prefix followed by UTF-8 bytes.
;;;
;;; Since: Phase 21

(definstance Serializable [cstr]
  (serialize [x]
    ```c
    const char *s = (const char*)x;
    int64_t slen = s ? (int64_t)strlen(s) : 0;
    int64_t total = 4 + slen;          /* 4-byte length prefix */
    int64_t *buf = malloc(sizeof(int64_t) + (size_t)total);
    if (!buf) { fprintf(stderr, "serialize cstr: oom\n"); exit(1); }
    buf[0] = total;
    uint8_t *p = (uint8_t*)(buf + 1);
    p[0] = (uint8_t)(slen & 0xff);
    p[1] = (uint8_t)((slen >>  8) & 0xff);
    p[2] = (uint8_t)((slen >> 16) & 0xff);
    p[3] = (uint8_t)((slen >> 24) & 0xff);
    if (slen > 0) memcpy(p + 4, s, (size_t)slen);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 4) {
      fprintf(stderr, "deserialize cstr: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    int64_t slen =
        (int64_t)p[0]
      | ((int64_t)p[1] <<  8)
      | ((int64_t)p[2] << 16)
      | ((int64_t)p[3] << 24);
    if (((int64_t*)b)[0] < 4 + slen) {
      fprintf(stderr, "deserialize cstr: buffer too short for string\n"); exit(1);
    }
    char *out = malloc((size_t)(slen + 1));
    if (!out) { fprintf(stderr, "deserialize cstr: oom\n"); exit(1); }
    if (slen > 0) memcpy(out, p + 4, (size_t)slen);
    out[slen] = '\0';
    return (const char *)out;
    ```))
;; bytes (ptr<void>) -- prefix with 8-byte length, then raw data
;;; Serializable [ptr<void>] -- serialize/deserialize a bytes value as an 8-byte LE length followed by raw data.
;;;
;;; Since: Phase 21

(definstance Serializable [ptr<void>]
  (serialize [x]
    ```c
    int64_t *inner = (int64_t*)x;
    int64_t dlen = inner ? inner[0] : 0;
    if (dlen < 0 || dlen > INT64_MAX - 16) {
      fprintf(stderr, "serialize bytes: length out of range\n"); exit(1);
    }
    int64_t total = 8 + dlen;
    int64_t *buf = malloc(sizeof(int64_t) + (size_t)total);
    if (!buf) { fprintf(stderr, "serialize bytes: oom\n"); exit(1); }
    buf[0] = total;
    uint8_t *p = (uint8_t*)(buf + 1);
    p[0] = (uint8_t)(dlen & 0xff);
    p[1] = (uint8_t)((dlen >>  8) & 0xff);
    p[2] = (uint8_t)((dlen >> 16) & 0xff);
    p[3] = (uint8_t)((dlen >> 24) & 0xff);
    p[4] = (uint8_t)((dlen >> 32) & 0xff);
    p[5] = (uint8_t)((dlen >> 40) & 0xff);
    p[6] = (uint8_t)((dlen >> 48) & 0xff);
    p[7] = (uint8_t)((dlen >> 56) & 0xff);
    if (dlen > 0) memcpy(p + 8, (uint8_t*)(inner + 1), (size_t)dlen);
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 8) {
      fprintf(stderr, "deserialize bytes: short buffer\n"); exit(1);
    }
    uint8_t *p = (uint8_t*)((int64_t*)b + 1);
    int64_t dlen =
        (int64_t)p[0]
      | ((int64_t)p[1] <<  8)
      | ((int64_t)p[2] << 16)
      | ((int64_t)p[3] << 24)
      | ((int64_t)p[4] << 32)
      | ((int64_t)p[5] << 40)
      | ((int64_t)p[6] << 48)
      | ((int64_t)p[7] << 56);
    /* dlen is 8 bytes off the wire: a negative one passed `< 8 + dlen` and
       the header store below overflowed a 0..7-byte block, and a huge one
       overflowed the addition (security audit WP5, M-5). */
    if (dlen < 0 || dlen > ((int64_t*)b)[0] - 8) {
      fprintf(stderr, "deserialize bytes: buffer too short for payload\n"); exit(1);
    }
    int64_t *out = malloc(sizeof(int64_t) + (size_t)dlen);
    if (!out) { fprintf(stderr, "deserialize bytes: oom\n"); exit(1); }
    out[0] = dlen;
    if (dlen > 0) memcpy(out + 1, p + 8, (size_t)dlen);
    return (void *)out;
    ```))
;; ---------------------------------------------------------------------------
;; Composite instances
;;
;; Carrier-level: a parameterized container's element slots are int64 carriers,
;; so these instances pack/unpack those carriers directly.  This is correct for
;; fixed-width primitive elements (int / bool / float and any int64-carried
;; nominal type).  Like the Eq/Clone container instances, an element that is a
;; cstr or other pointer-to-heap serializes its *address*, not its contents.
;;
;; NOTE: `(deserialize b)` CAN now dispatch on a constrained type variable --
;; `(:: (deserialize b) A)` inside a `(... [(Serializable A)] ...)` body
;; re-resolves to A's instance per monomorphization (see
;; docs/archive/history/return-dispatch-tyvar-silent-misdispatch.md).  The composite
;; bodies below still pack element carriers directly (not via recursive
;; `(:: (deserialize sub) A)`) for the in-process raw-carrier round-trip, so a
;; cstr/heap element still serializes its address; use a concrete
;; (definstance Serializable [YourType] ...) when an element owns heap data and
;; you need cross-process recovery.
;; ---------------------------------------------------------------------------
;;; serial-pair-bytes -- raw [len=16][fst][snd] Pair byte layout from two int64
;;; element carriers.
;;;
;;; Fixed-arity (takes the element carriers as plain ints, not the Pair), so the
;;; `(serialize ...)` instance body that calls it stays pure-Turmeric rather than
;;; inline-C.  That lets the per-instantiation spec machinery (M4c Path A) mint a
;;; typed `serialize_Pair__spec__(Pair__int__int)` and dispatch a by-value Pair
;;; directly -- no `concrete->carrier` bridge spill.  The byte layout is
;;; identical to the prior inline-C body, so `deserialize` is unchanged.
;;;
;;; Parameters:
;;;   fst -- first element's int64 carrier
;;;   snd -- second element's int64 carrier
;;;
;;; Returns:
;;;   A raw :ptr<void> bytes value (see the module note on the raw-buffer surface).
;;;
;;; Since: end-to-end-monomorphization (M4 bucket-D)

(defn serial-pair-bytes [fst : int snd : int] : ptr<void>
  ```c
  int64_t *buf = (int64_t*)malloc(sizeof(int64_t) + 16);
  if (!buf) { fprintf(stderr, "serialize Pair: oom\n"); exit(1); }
  buf[0] = 16;
  buf[1] = fst;
  buf[2] = snd;
  return buf;
  ```)
;;; Serializable [Pair] -- serialize a Pair[A B] as its two int64 element carriers.
;;;
;;; Layout: [int64 len=16][int64 fst][int64 snd].
;;;
;;; Since: cps-transform-plan (value-typed cont env codec)


(definstance Serializable [Pair]
  [(Serializable A) (Serializable B)]
  (serialize [x] (serial-pair-bytes (:: (.fst x) :int) (:: (.snd x) :int)))
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 16) {
      fprintf(stderr, "deserialize Pair: short buffer\n"); exit(1);
    }
    int64_t *d = (int64_t*)b + 1;
    struct { int64_t fst; int64_t snd; } *p = malloc(sizeof(*p));
    if (!p) { fprintf(stderr, "deserialize Pair: oom\n"); exit(1); }
    p->fst = d[0]; p->snd = d[1];
    return (int64_t)(intptr_t)p;
    ```))
;;; Serializable [Option] -- serialize an Option[A] as a presence flag + carrier.
;;;
;;; Layout: [int64 len=16][int64 is-some][int64 value].
;;;
;;; Since: cps-transform-plan (value-typed cont env codec)

(definstance Serializable [Option]
  [(Serializable A)]
  ;; NOTE: serialize stays inline-C (carrier-based) on purpose -- `none` is the
  ;; NULL carrier (0), so a pure-Turmeric body would mint a by-value
  ;; `serialize_Option__spec__(Option__int)` whose dispatch derefs the carrier
  ;; (`*(Option__int *)0`) and segfaults on none.  The inline-C body NULL-checks
  ;; `o` and so handles none safely; it keeps the uniform-carrier ABI (no
  ;; by-value spec, no concrete->carrier bridge -- this instance never crossed).
  (serialize [x]
    ```c
    int64_t *buf = (int64_t*)malloc(sizeof(int64_t) + 16);
    if (!buf) { fprintf(stderr, "serialize Option: oom\n"); exit(1); }
    buf[0] = 16;
    buf[1] = tur_is_some(x) ? 1 : 0;
    buf[2] = tur_is_some(x) ? tur_opt_value(x) : 0;
    return buf;
    ```)
  (deserialize [b]
    ```c
    if (!b || ((int64_t*)b)[0] < 16) {
      fprintf(stderr, "deserialize Option: short buffer\n"); exit(1);
    }
    int64_t *d = (int64_t*)b + 1;
    return d[0] != 0 ? tur_box_some(d[1]) : tur_none();
    ```))
;; ---------------------------------------------------------------------------
;; File I/O helpers (cont-to-file / cont-from-file)
;; These operate on opaque bytes values returned by serial-cont->bytes.
;; ---------------------------------------------------------------------------


(extern-c fopen [^cstr path ^cstr mode] :ptr<void>)

(extern-c fclose [^ptr<void> f] :int)

(extern-c fwrite [^ptr<void> buf ^int size ^int n ^ptr<void> f] :int)

(extern-c fread [^ptr<void> buf ^int size ^int n ^ptr<void> f] :int)

(extern-c fseek [^ptr<void> f ^int off ^int whence] :int)

(extern-c ftell [^ptr<void> f] :int)
;; Write a serialized continuation to a file.
;; Returns 1 on success, 0 on failure.
;;; cont-to-file -- write a serialised continuation bytes value to a file.
;;;
;;; Parameters:
;;;   b    -- bytes value from serial-cont->bytes / save-cont!
;;;   path -- filesystem path to write (overwritten if it exists)
;;;
;;; Returns:
;;;   1 on success, 0 on failure.
;;;
;;; Example:
;;;   (cont-to-file k-bytes "/tmp/checkpoint.bin")  ; => 1
;;;
;;; Since: Phase 21

(defn cont-to-file [b : ptr<void> path : cstr] : int
  ```c
  if (!b) return 0;
  FILE *f = fopen((const char*)path, "wb");
  if (!f) return 0;
  int64_t len = ((int64_t*)b)[0];
  uint8_t *data = (uint8_t*)((int64_t*)b + 1);
  int64_t written = (int64_t)fwrite(&len, 1, 8, f);
  if (written == 8) written += (int64_t)fwrite(data, 1, (size_t)len, f);
  fclose(f);
  return (written == 8 + len) ? 1 : 0;
  ```)
;; Read a serialized continuation from a file.
;; Returns a bytes ptr<void> on success, NULL on failure.
;;; cont-from-file -- read a serialised continuation bytes value from a file.
;;;
;;; Parameters:
;;;   path -- filesystem path previously written by cont-to-file
;;;
;;; Returns:
;;;   A bytes :ptr<void> on success, NULL on any I/O or allocation failure.
;;;
;;; Example:
;;;   (def k-bytes (cont-from-file "/tmp/checkpoint.bin"))
;;;
;;; Since: Phase 21

(defn cont-from-file [path : cstr] : ptr<void>
  ```c
  FILE *f = fopen((const char*)path, "rb");
  if (!f) return NULL;
  int64_t len = 0;
  if ((int64_t)fread(&len, 1, 8, f) != 8 || len < 0) { fclose(f); return NULL; }
  /* The stored length sizes the malloc: hold it to the bytes the file really
   * has after it (security-audit-plan M-1), so a lying prefix is a NULL, not
   * a giant allocation. */
  {
    long here = ftell(f);
    if (here < 0 || fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
    long fend = ftell(f);
    if (fend < here || fseek(f, here, SEEK_SET) != 0 || len > (int64_t)(fend - here)) {
      fclose(f); return NULL;
    }
  }
  int64_t *buf = malloc(sizeof(int64_t) + (size_t)len);
  if (!buf) { fclose(f); return NULL; }
  buf[0] = len;
  if (len > 0 && (int64_t)fread(buf + 1, 1, (size_t)len, f) != len) {
    free(buf); fclose(f); return NULL;
  }
  fclose(f);
  return buf;
  ```)
;; ---------------------------------------------------------------------------
;; Typed continuation surface (serializable-continuations-aspirational-surface).
;;
;; The three names the guides use, over the same runtime save-cont! /
;; resume-cont! wrap: a `serial-cont` is the opaque DK chain the serial-shift
;; receiver is handed, `bytes` is the {int64 len; data} buffer the codec
;; produces, and rebuilding a continuation from bytes is fallible -- so it
;; returns a Result instead of aborting inside tur_serial_cont_deserialize.
;; ---------------------------------------------------------------------------
;;; serial-cont->bytes -- marshal a captured continuation to a bytes value.
;;;
;;; The typed spelling of save-cont!: walks the frame chain k and writes each
;;; frame's stable tag/name plus its environment (int inline, cstr and
;;; Serializable envs by value) to a length-prefixed buffer.  No code address
;;; is written, so the bytes are valid in another process running the SAME
;;; program.
;;;
;;; Parameters:
;;;   k -- the continuation the serial-shift receiver was passed
;;;
;;; Returns:
;;;   A caller-owned bytes :ptr<void> ({int64 len; data}), or NULL if k is nil.
;;;
;;; Example:
;;;   (defn stash [k : serial-cont] : int
;;;     (do (cont-to-file (serial-cont->bytes k) "/tmp/k.bin") 0))
;;;   (serial-reset (+ 10 (serial-shift stash 0)))
;;;
;;; Since: Phase 21 (typed surface 2026-09-02)

(defn serial-cont->bytes [k : serial-cont] : ptr<void>
  ```c
  /* The serial DK runtime (tur_serial_cont_serialize and the SK_* frame
   * vocabulary) is emitted only when the program contains serial-reset /
   * serial-shift.  A program that merely loads this file has no continuation
   * to marshal, so the body compiles to a NULL return there. */
#ifdef SK_TAG_CALL
  if (!k) return NULL;
  return (void *)(intptr_t)tur_serial_cont_serialize((int64_t)(intptr_t)k);
#else
  (void)k;
  return NULL;
#endif
  ```)
;;; bytes->serial-cont -- rebuild a continuation from bytes, or say why not.
;;;
;;; Validates the buffer before touching the runtime: every frame record must
;;; fit, carry a known tag, and -- for a call frame -- name a frame this
;;; program registered, with the env kind that frame was registered with.  A
;;; buffer written by a different program (or a different build whose frame
;;; names moved) is therefore an Err naming the problem rather than an abort
;;; or a resumed garbage chain.  resume-cont! and image/blob-resume! run the
;;; same check and panic instead.
;;;
;;; Validation is integrity, not authenticity: a well-formed buffer from an
;;; untrusted source still rebuilds a continuation of this program's own
;;; frames with the envs it chose.  Authenticate bytes that crossed a trust
;;; boundary before handing them here (the guestbook example keeps them
;;; server-side under an HMAC-signed name).
;;;
;;; Parameters:
;;;   b -- a bytes value from serial-cont->bytes / save-cont! / cont-from-file
;;;
;;; Returns:
;;;   (Ok k) with a resumable serial-cont, or (Err msg) with a static cstr:
;;;   "null bytes", "short buffer", "bad frame count", "truncated frame",
;;;   "frame name too long", "unknown frame (written by a different
;;;   program?)", "truncated env", "bad env kind", "bad frame tag", "env kind
;;;   does not match the frame" -- each prefixed with "bytes->serial-cont: ".
;;;
;;; Example:
;;;   (match (bytes->serial-cont (cont-from-file "/tmp/k.bin"))
;;;     (Ok k)  (serial-resume k 5)
;;;     (Err m) (do (println m) 0))
;;;
;;; Since: Phase 21 (typed surface 2026-09-02)

(defn bytes->serial-cont [b : ptr<void>] : (Result serial-cont cstr)
  ```c
  #ifndef SK_TAG_CALL
  /* No serial syntax in this program: nothing registered a frame, so no
   * buffer can name one (see serial-cont->bytes). */
  (void)b;
  return tur_err_ptr((void *)"bytes->serial-cont: this program captures no continuations");
#else
  /* The checks live in the runtime (tur_serial_cont_check), beside the
   * deserializer that runs them again, so this Result and resume-cont!'s panic
   * can never disagree about what a valid buffer is. */
  switch (tur_serial_cont_check((int64_t)(intptr_t)b)) {
    case 0: break;
    case SK_ERR_NULL:         return tur_err_ptr((void *)"bytes->serial-cont: null bytes");
    case SK_ERR_SHORT:        return tur_err_ptr((void *)"bytes->serial-cont: short buffer");
    case SK_ERR_COUNT:        return tur_err_ptr((void *)"bytes->serial-cont: bad frame count");
    case SK_ERR_TRUNC_FRAME:  return tur_err_ptr((void *)"bytes->serial-cont: truncated frame");
    case SK_ERR_NAME_LONG:    return tur_err_ptr((void *)"bytes->serial-cont: frame name too long");
    case SK_ERR_UNKNOWN:      return tur_err_ptr((void *)"bytes->serial-cont: unknown frame (written by a different program?)");
    case SK_ERR_TRUNC_ENV:    return tur_err_ptr((void *)"bytes->serial-cont: truncated env");
    case SK_ERR_ENV_KIND:     return tur_err_ptr((void *)"bytes->serial-cont: bad env kind");
    case SK_ERR_TAG:          return tur_err_ptr((void *)"bytes->serial-cont: bad frame tag");
    case SK_ERR_ENV_MISMATCH: return tur_err_ptr((void *)"bytes->serial-cont: env kind does not match the frame");
    default:                  return tur_err_ptr((void *)"bytes->serial-cont: invalid continuation bytes");
  }
  return tur_ok_ptr((void *)(intptr_t)tur_serial_cont_deserialize((int64_t)(intptr_t)b));
#endif
  ```)
;;; serial-resume-owned -- resume a rebuilt continuation, then release it.
;;;
;;; A continuation from bytes->serial-cont belongs to the program, and a
;;; resume runs a copy of it, so nothing else ever frees it.  A serial-cont is
;;; consumed by its resume, which leaves no later point to free it at -- so
;;; this resumes and frees in one step.  Only for a continuation that
;;; bytes->serial-cont returned: the one a serial-shift receiver is handed is
;;; the compiler's to free (serial-resume it), and freeing it here would free
;;; it twice.  The strings a cstr-env frame was rebuilt with stay allocated,
;;; since the resumed computation may have returned one of them.
;;;
;;; Parameters:
;;;   k -- a serial-cont from bytes->serial-cont
;;;   v -- the value to fill the hole with
;;;
;;; Returns:
;;;   The resumed computation's result, as serial-resume.
;;;
;;; Example:
;;;   (match (bytes->serial-cont b)
;;;     (Ok k)  (serial-resume-owned k 5)
;;;     (Err m) (do (println m) 0))
;;;
;;; Since: 2026-10-07 (serial-cont-escaped-or-deserialized-chain-leaks)

(defn serial-resume-owned [k : serial-cont v : int] : int
  ```c
#ifdef SK_TAG_CALL
  int64_t r = tur_serial_cont_resume((int64_t)(intptr_t)k, v);
  if (k) dk_free((DK *)(intptr_t)k);
  return r;
#else
  (void)k; (void)v;
  return 0;
#endif
  ```)
;;; serial-cont-free -- release a rebuilt continuation without resuming it.
;;;
;;; For a continuation from bytes->serial-cont that the program decides not to
;;; resume.  Same restriction as serial-resume-owned: never the receiver's k.
;;;
;;; Parameters:
;;;   k -- a serial-cont from bytes->serial-cont
;;;
;;; Example:
;;;   (match (bytes->serial-cont b) (Ok k) (serial-cont-free k) (Err m) nil)
;;;
;;; Since: 2026-10-07 (serial-cont-escaped-or-deserialized-chain-leaks)

(defn serial-cont-free [k : serial-cont] : nil
  ```c
#ifdef SK_TAG_CALL
  if (k) dk_free((DK *)(intptr_t)k);
#else
  (void)k;
#endif
  ```)
;;; serial-bytes-free -- release a buffer from serial-cont->bytes.
;;;
;;; serial-cont->bytes, save-cont! and cont-from-file return a caller-owned
;;; malloc'd buffer as a bare ptr<void> (cont-to-file and bytes->serial-cont
;;; take that form), so bytes-free, which takes the linear Bytes, does not
;;; apply.  Free it with this once it has been written or rebuilt.  NULL is a
;;; no-op.
;;;
;;; Parameters:
;;;   b -- a buffer from serial-cont->bytes / save-cont! / cont-from-file
;;;
;;; Example:
;;;   (let [b (serial-cont->bytes k)]
;;;     (cont-to-file b "/tmp/k.bin")
;;;     (serial-bytes-free b))
;;;
;;; Since: 2026-10-07 (serial-cont-escaped-or-deserialized-chain-leaks)

(defn serial-bytes-free [b : ptr<void>] : nil
  ```c
  free(b);
  ```)
;;; serial-resume -- resume a continuation with a value.
;;;
;;; `(serial-resume k v)` is `(k v)`: the enclosing serial-reset's rest of the
;;; computation runs with v in the hole and its result comes back.  Works on
;;; the continuation the serial-shift receiver was handed and on one rebuilt
;;; by bytes->serial-cont alike.
;;;
;;; Parameters:
;;;   k -- a serial-cont
;;;   v -- the value to fill the hole with
;;;
;;; Returns:
;;;   The resumed computation's result.
;;;
;;; Example:
;;;   (defn sk [k : serial-cont] : int (serial-resume k 5))
;;;   (serial-reset (+ 10 (serial-shift sk 0)))   ; => 15
;;;
;;; Since: Phase 21 (typed surface 2026-09-02)

(defn serial-resume [k : serial-cont v : int] : int (k v))
