;;; tur/option -- typed Option[A]: parameterized optional value.
;;;
;;; First-class parameterized optional value, as a REAL SUM (SR2b of
;;; docs/archive/sum-representation-plan.md): `(None)` or `(Some A)`.
;;; Runtime layout is the tagged monomorph -- { int tag; union { None; Some } }
;;; -- 16 bytes, with no dead arm to zero-fill.  A concrete monomorph flows BY
;;; VALUE with no per-ctor allocation (SR2a, default since 2026-08-27); an
;;; erased generic base still rides the int64 carrier, a heap pointer to the
;;; same layout, and `(none)` IS the null pointer there (SR3 slice A).
;;; Tag values follow declaration order: None = 0, Some = 1.
;;; The inline-C helpers in the codegen preamble (tur_box_some / tur_is_some /
;;; tur_opt_value / tur_some_ptr / tur_none) build and read this exact layout;
;;; keep them in lockstep with this declaration.
;;;
;;; Since: Phase TC1-D; converted to a sum in SR2b.
;;; Option -- parameterized optional value containing either some A or none.
;;;
;;; Since: Phase TC1
(defdata Option :copy [A] (None) (Some A))
;;; some -- wrap a value of type A in a some Option[A].
;;;
;;; Parameters:
;;;   x -- the value to wrap (type A)
;;;
;;; Returns:
;;;   An Option[A] carrying the Some variant.
;;;
;;; Example:
;;;   (some 42)  ; => some(42)
;;;
;;; Since: Phase TC1

(defn ^construct some [A] [x : A] : (Option A) (Some x))
;;; none -- return the none Option[A].
;;;
;;; Returns:
;;;   The None variant.  (SR3 slice A: on the carrier path None IS the null
;;;   carrier -- construction allocates nothing, and every reader treats 0 as
;;;   none.  A tagged None box remains valid on the read side.)
;;;
;;; Example:
;;;   (none)  ; => none
;;;
;;; Since: Phase TC1

(defn ^construct none [A] : (Option A) (None))
;;; some? -- check whether an Option[A] contains a value.
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;
;;; Returns:
;;;   true if o is some, false if o is none.
;;;
;;; Example:
;;;   (some? (some 1))  ; => true
;;;   (some? (none))    ; => false
;;;
;;; Since: Phase TC1

(defn some? [A] [o : (Option A)] : bool (match o (Some _) true (None) false))
;;; none? -- check whether an Option[A] is empty.
;;;
;;; The complement of `some?`. It existed in the compiler's pure-builtin list
;;; (src/compiler/emit_fns.c) with no implementation behind it, which made it
;;; worse than simply absent: the compiled path rejected it as an unknown
;;; function, while the interpreter treated the name as known and answered
;;; `false` for EVERY argument, with no warning -- so
;;; `(none? (none))` was `false` at the REPL. See
;;; docs/archive/quickstart-tutorial-fictional-option-api.md.
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;
;;; Returns:
;;;   true if o is none, false if o is some.
;;;
;;; Example:
;;;   (none? (none))    ; => true
;;;   (none? (some 1))  ; => false
;;;
;;; Since: 2026-08-20

(defn none? [A] [o : (Option A)] : bool (match o (Some _) false (None) true))
;;; unwrap -- extract the value from a typed Option[A].
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;
;;; Returns:
;;;   The contained value of type A; the zero value of A when o is none
;;;   (preserving the pre-sum behaviour, where none's dead value slot held
;;;   `(default-of A)`).
;;;
;;; Example:
;;;   (unwrap (some 7))  ; => 7
;;;
;;; Since: Phase TC1

(defn unwrap [A] [o : (Option A)] :A (match o (Some v) v (None) (default-of A)))
;;; unwrap-or -- extract the value or return a default.
;;;
;;; Parameters:
;;;   o    -- Option[A]
;;;   dflt -- value to return if o is none (type A)
;;;
;;; Returns:
;;;   The contained value, or default if none.
;;;
;;; Example:
;;;   (unwrap-or (none) 99)   ; => 99
;;;   (unwrap-or (some 7) 99) ; => 7
;;;
;;; Since: Phase TC1

(defn unwrap-or [A] [o : (Option A) dflt : A] : A
  (match o (Some v) v (None) dflt))
;;; unwrap-or-carrier -- carrier-ABI shim for the Track A cascade: extract the
;;; value from the int64 carrier Option, or return dflt.  Temporary surface
;;; for producers that still return the carrier Option (e.g. zipper / kleisli);
;;; retired once those producers move to by-value `(Option A)`.  See
;;; docs/archive/history/unwrap-or-byvalue-cascade.md.

(defn unwrap-or-carrier [o : int dflt : int]
  #fx{}
  : int
  ```c
  return tur_is_some(o) ? tur_opt_value(o) : dflt;
  ```)
;;; option-free -- free a heap-allocated Option[A].
;;;
;;; Parameters:
;;;   o -- Option[A] to free (may be none / 0)
;;;
;;; Example:
;;;   (option-free my-opt)
;;;
;;; Since: Phase TC1

(defn option-free [o : int]
  #fx{}
  : void
  ```c
  if (o) free((void*)(intptr_t)o);
  ```)
;;; option-map -- apply a function to the contained value if some.
;;;
;;; Parameters:
;;;   o -- Option[A]
;;;   f -- function A -> B
;;;
;;; Returns:
;;;   Option[B] with f applied if some, or none.
;;;
;;; Example:
;;;   (option-map (some 3) (fn [x] (* x 2)))  ; => some(6)
;;;
;;; Note:
;;;   Mapping over a *literal* `(none)` with an *unannotated* lambda leaves the
;;;   element type under-determined (`(none)` carries no element type) and fails
;;;   to compile -- annotate the lambda or map over a typed Option value. See
;;;   docs/archive/history/option-map-literal-none-unannotated-fn-no-A-inference.md.
;;;
;;; Since: Phase TC1

(defn option-map [A B] [o : (Option A) ^fat f : (fn [A] B)] : (Option B)
  (match o (Some v) (some (f v)) (None) (none)))
;;; option-eq? -- compare two Option[A] values using a comparator.
;;;
;;; Parameters:
;;;   o1     -- first Option[A]
;;;   o2     -- second Option[A]
;;;   cmp-fn -- comparator fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both none, or both some with equal values.
;;;
;;; Example:
;;;   (option-eq? (some 1) (some 1) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defn option-eq? [A] [o1 : (Option A)
                      o2 : (Option A)
                      ^fat cmp-fn : (fn [A A] bool)] : bool
  (match o1
    (Some v1)
    (match o2 (Some v2) (cmp-fn v1 v2) (None) false)
    (None)
    (none? o2)))
;;; Eq [Option] -- equality using the inner type's Eq instance.
;; TC1-17: Phase PTC4 -- constrained Eq instance for Option[A].
;; SR2b: match on the sum instead of reading record fields.
;; The payload binders are ascribed to the class var so the inner `eq?`
;; re-dispatches per ABI specialization: a bare binder is typed by the
;; representative (int) at elaboration, and the spec then pointer-compared
;; String/struct payloads (`(eq? (some "aa") (some "aa"))` said false).
;;
;; sr2-carrier-seam-rotted (3): the ascription is NECESSARY but it is not what
;; MINTS the specialization -- `body_has_dispatch_on_app_tyvar` now recognises a
;; receiver spelled as an ascription to the instance's own constraint var, and
;; walks into `match` at all, which it did not before.  On the by-value default
;; the spec used to exist for an unrelated reason (a nominal payload changes the
;; Option's C signature, so `abi_changes` fires and correct dispatch came along
;; as a side effect).  Do not read this comment as "the ascription is
;; sufficient": where a payload type does NOT change the signature -- the whole
;; carrier path -- it is not.

(definstance Eq [Option]
  [(Eq A)]
  (eq? [x y]
    (match x
      (Some vx)
      (match y (Some vy) (eq? (:: vx A) (:: vy A)) (None) false)
      (None)
      (none? y))))
;; ---------------------------------------------------------------------------
;; HKT typeclass instances (stdlib-hkt-consolidation T1)
;;
;; Option is a single-parameter type constructor of kind (* -> *), so the
;; standard Functor / Applicative / Monad / Alternative instances are all
;; directly expressible. Option owns these instances (it is the home module of
;; the Option type), so they are not orphans. The class stubs are preloaded
;; before this module (see the preload list in src/main.c).
;; ---------------------------------------------------------------------------
;;; Functor [Option] -- map a function over the some payload; none unchanged.
;;;
;;; Example:
;;;   (fmap (some 21) (fn [x] (* x 2)))  ; => some(42)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Functor [Option]
  (fmap [container g] (match container (Some v) (some (g v)) (None) (none))))
;;; Applicative [Option] -- pure wraps in some; ap applies a some function to a
;;; some argument (none when either side is none).
;;;
;;; Example:
;;;   (ap (some f) (some 3))  ; => some(f 3)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Applicative [Option]
  (pure [x] (some x))
  (ap [ff fa]
    (match ff
      (Some f)
      (match fa (Some a) (some (f a)) (None) (none))
      (None)
      (none))))
;;; Monad [Option] -- bind sequences through some; short-circuits on none.
;;;
;;; Example:
;;;   (bind (some 20) (fn [x] (some (+ x 1))))  ; => some(21)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Monad [Option]
  (bind [ma k] (match ma (Some v) (k v) (None) (none))))
;;; Alternative [Option] -- empty is none; alt-or picks the first some.
;;;
;;; Example:
;;;   (alt-or (none) (some 7))  ; => some(7)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Alternative [Option]
  (empty [a] (none))
  (alt-or [x y] (match x (Some _) x (None) y)))
