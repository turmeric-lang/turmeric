;;; tur/typeclass -- built-in typeclasses: Eq, Ord, Show, Num.
;;;
;;; Core typeclass definitions used across the standard library.
;;;
;;; Since: Phase 15
;; Phase 15: Typeclasses
;; Built-in typeclasses: Eq, Ord, Show, Num
;; Show (the class + primitive/collection instances) lives in
;; stdlib/typeclass-show.tur and is loaded at the END of this file, not here:
;; since stage 4 its owned `String` result makes typeclass-show.tur load
;; stdlib/string.tur, which loads this file back.  Deferring the load until
;; Ord/Num/Display/Debug/Error are all defined breaks that cycle -- the
;; reentrant (load "stdlib/typeclass.tur") from string.tur then finds every
;; class it needs.  `(load "stdlib/typeclass.tur")` still ends up providing Show.
;; Display/Debug here are self-contained (no `show` call), so they do not need
;; Show in scope before the trailing load.
;; Ord (the class, its primitive instances, and the max/min generics) lives in
;; stdlib/typeclass-ord.tur, which is AUTO-LOADED -- this file does not
;; redefine it, the same arrangement Eq has with stdlib/typeclass-eq.tur.
;; Loading this file still gives you Ord, because the autoload already did.
;; Show class + primitive Show instances live in stdlib/typeclass-show.tur
;; (loaded at the END of this file -- see the header note).
;;; Num -- numeric types: the four arithmetic operations and negation.
;;;
;;; Parameters:
;;;   a -- the numeric type
;;;
;;; Methods:
;;;   add -- `x` + `y`
;;;   sub -- `x` - `y`
;;;   mul -- `x` * `y`
;;;   div -- `x` / `y`, truncating for the integer instances
;;;   neg -- `x` negated
;;;
;;; Every method is closed over the instance type `a`: each takes and returns
;;; `a`, so a `Num` instance for a non-integer type (Rational, Complex, a user
;;; newtype) types correctly at call sites.
;;;
;;; Example:
;;;   (add 2 3)          ; => 5      (Num [int])
;;;   (add 2.5 0.25)     ; => 2.75   (Num [float])
;;;
;;; Since: Phase 15 (N0: de-:int-ified)
;; Num typeclass - numeric operations
(defclass Num [a]
  (add [x : a y : a] : a)
  (sub [x : a y : a] : a)
  (mul [x : a y : a] : a)
  (div [x : a y : a] : a)
  (neg [x : a] : a))
;; Instance for int
;;; Num [int] -- Num instance for int.

(definstance Num [int]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0 x)))
;; Phase N4: Num instances for new numeric types
;;; Num [int8] -- Num instance for int8.

(definstance Num [int8]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0i8 x)))
;;; Num [int16] -- Num instance for int16.

(definstance Num [int16]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0i16 x)))
;;; Num [int32] -- Num instance for int32.

(definstance Num [int32]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0i32 x)))
;;; Num [uint8] -- Num instance for uint8.

(definstance Num [uint8]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0u8 x)))
;;; Num [uint16] -- Num instance for uint16.

(definstance Num [uint16]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0u16 x)))
;;; Num [uint32] -- Num instance for uint32.

(definstance Num [uint32]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0u32 x)))
;;; Num [uint64] -- Num instance for uint64.

(definstance Num [uint64]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0u64 x)))
;;; Num [float32] -- Num instance for float32.

(definstance Num [float32]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0.0f32 x)))
;;; Num [float] -- Num instance for float (double).

(definstance Num [float]
  (add [x y] (+ x y))
  (sub [x y] (- x y))
  (mul [x y] (* x y))
  (div [x y] (/ x y))
  (neg [x] (- 0.0 x)))
;;; Clone -- values that can be copied into an independently owned value.
;;;
;;; Parameters:
;;;   a -- the type to clone
;;;
;;; Methods:
;;;   clone -- a copy of `x` the caller owns; the identity for a primitive.
;;;
;;; The same class as the auto-loaded stdlib/typeclass-clone.tur declares;
;;; this module adds the primitive instances.
;;;
;;; Example:
;;;   (clone 42)  ; => 42
;;;
;;; Since: Phase B1
;; Phase B1: Clone typeclass - deep copy of a value

(defclass Clone [a] (clone [x : a] : a))
;; Clone instances for primitive types
;;; Clone [int] -- Clone instance for int (trivial copy).

(definstance Clone [int] (clone [x] x))
;;; Clone [bool] -- Clone instance for bool (trivial copy).

(definstance Clone [bool] (clone [x] x))
;;; Clone [cstr] -- Clone instance for cstr (trivial copy).

(definstance Clone [cstr] (clone [x] x))
;; Phase N4: Clone instances for new numeric types (all are trivially copyable)
;;; Clone [int8] -- Clone instance for int8 (trivial copy).

(definstance Clone [int8] (clone [x] x))
;;; Clone [int16] -- Clone instance for int16 (trivial copy).

(definstance Clone [int16] (clone [x] x))
;;; Clone [int32] -- Clone instance for int32 (trivial copy).

(definstance Clone [int32] (clone [x] x))
;;; Clone [uint8] -- Clone instance for uint8 (trivial copy).

(definstance Clone [uint8] (clone [x] x))
;;; Clone [uint16] -- Clone instance for uint16 (trivial copy).

(definstance Clone [uint16] (clone [x] x))
;;; Clone [uint32] -- Clone instance for uint32 (trivial copy).

(definstance Clone [uint32] (clone [x] x))
;;; Clone [uint64] -- Clone instance for uint64 (trivial copy).

(definstance Clone [uint64] (clone [x] x))
;;; Clone [float32] -- Clone instance for float32 (trivial copy).

(definstance Clone [float32] (clone [x] x))
;; SINCE: Phase HKT H3
;; Higher-kinded typeclasses — require kind '* -> *' type constructor parameters.
;;
;; These typeclasses follow the Haskell/PureScript convention.  In Turmeric v1
;; the method signatures use :int as the return type (int64_t in C) so that
;; container values, which are heap pointers, can be returned without a full
;; parameterised type system.  Callers may cast the result to the concrete
;; container pointer type using inline C or ptr<void> helpers.
;;; Functor -- map a function over every element of a container, keeping its shape.
;;;
;;; Parameters:
;;;   ^f -- the type constructor (kind * -> *)
;;;
;;; Methods:
;;;   fmap -- `container` with `g` applied to each element, same shape.
;;;
;;; The same class the auto-loaded stdlib/typeclass-functor.tur declares (a
;;; redeclaration must match it); that page carries the laws and examples.
;;;
;;; Since: Phase HKT H3
;; Functor — map a function over a container without changing its shape.
;;   fmap :: (a -> b) -> f a -> f b
;;   Phase CCL: fn is declared :fn so capturing closures can be passed.


(defclass Functor [^f] (fmap [container : (f a) g : (fn [a] b)] : (f b)))
;;; Applicative -- a Functor that can lift a plain value and apply a wrapped function.
;;;
;;; Parameters:
;;;   ^f -- the type constructor (kind * -> *)
;;;
;;; Methods:
;;;   pure -- `x` in the minimal context (dispatches on the expected return
;;;           type).
;;;   ap   -- apply the function inside `ff` to the value inside `fa`.
;;;
;;; The same class the auto-loaded stdlib/typeclass-applicative.tur declares (a
;;; redeclaration must match it); that page carries the laws and examples.
;;;
;;; Since: Phase HKT H3
;; Applicative — container with a pure constructor and ap combinator.
;;   pure :: a -> f a
;;   ap   :: f (a -> b) -> f a -> f b

(defclass Applicative [^f]
  [(Functor f)]
  (pure [x : a] : (f a))
  (ap [ff : (f (fn [a] b)) fa : (f a)] : (f b)))
;;; Monad -- an Applicative whose next step can depend on the previous result.
;;;
;;; Parameters:
;;;   ^m -- the type constructor (kind * -> *)
;;;
;;; Methods:
;;;   bind -- run `ma` and continue with the computation `k` builds from its
;;;           result (flatMap).
;;;
;;; The same class the auto-loaded stdlib/typeclass-monad.tur declares (a
;;; redeclaration must match it); that page carries the laws and examples.
;;;
;;; Since: Phase HKT H3
;; Monad — sequencing with flatMap/bind.
;;   bind :: m a -> (a -> m b) -> m b
;;   Phase CCL: fn is declared :fn so capturing closures can be passed.

(defclass Monad [^m]
  [(Applicative m)]
  (bind [ma : (m a) k : (fn [a] (m b))] : (m b)))
;;; Foldable -- containers that can be reduced to a single summary value.
;;;
;;; Parameters:
;;;   ^t -- the container's type constructor (kind * -> *)
;;;
;;; Methods:
;;;   foldl -- combine the elements of `ta` first to last: starting from
;;;            `init`, each step calls `fn` with the accumulator and the next
;;;            element.
;;;   foldr -- combine the elements of `ta` last to first: starting from
;;;            `init`, each step calls `fn` with the next element and the
;;;            accumulator.
;;;
;;; The one stdlib instance is rc's (stdlib/rc.tur, which declares the same
;;; class): an rc holds a single value x, so foldl is `(fn init x)` and
;;; foldr is `(fn x init)`.
;;;
;;; Since: Phase HKT H3
;; Foldable — reduce a container to a summary value.
;;   foldl :: b -> (b -> a -> b) -> t a -> b
;;   foldr :: (a -> b -> b) -> b -> t a -> b

(defclass Foldable [^t]
  (foldl [ta : (t a) init : b fn : (fn [b a] b)] : b)
  (foldr [ta : (t a) init : b fn : (fn [a b] b)] : b))
;;; Traversable -- containers you can map over with an effect, collecting the results.
;;;
;;; Parameters:
;;;   ^t -- the container's type constructor (kind * -> *)
;;;
;;; Methods:
;;;   traverse -- apply the effectful `fn` to each element of `ta` and
;;;               return the effect of the whole new container -- e.g. an
;;;               Option of a list that is none if any element gave none.
;;;
;;; The v1 signature is the simplified `traverse [ta fn] :int` (the Haskell
;;; one is `Applicative f => (a -> f b) -> t a -> f (t b)`), and the stdlib
;;; ships no instance yet.
;;;
;;; Superclasses: Functor and Foldable, as in Haskell.
;;;
;;; Since: Phase HKT H3
;; Traversable — map with effects, collecting results.
;;   traverse :: Applicative f => (a -> f b) -> t a -> f (t b)
;;   In v1: simplified to traverse [ta fn] :int

;; Superclasses: Functor and Foldable, as in Haskell.
(defclass Traversable [^t] [(Functor t) (Foldable t)] (traverse [ta fn] : int))
;; SINCE: Phase HKT H7
;; Alternative — typeclass for types with an "empty" value and a way to combine alternatives.
;; Similar to MonadPlus/ApplicativePlus in Haskell.
;;   empty :: f a           (the empty/zero value)
;;   alt-or :: f a -> f a -> f a   (combine two alternatives)
;; In v1: empty [a] :int (a is a type witness for dispatch, ignored by impl) and alt-or [a b] :int
;;; Alternative -- an Applicative with a failure value and a first-success choice.
;;;
;;; Parameters:
;;;   ^f -- the type constructor (kind * -> *)
;;;
;;; Methods:
;;;   empty  -- the failing/empty value; `a` only picks the instance.
;;;   alt-or -- `x` if it succeeded, else `y`.
;;;
;;; The same class the auto-loaded stdlib/typeclass-alternative.tur declares (a
;;; redeclaration must match it); that page carries the laws and examples.
;;;
;;; Since: Phase HKT H7


(defclass Alternative [^f]
  [(Applicative f)]
  (empty [a] : (f a))
  (alt-or [x : (f a) y : (f a)] : (f a)))
;; SINCE: Phase HKT H5
;; Bifunctor — map over both sides of a binary type constructor.
;;   The canonical signature is:
;;     bimap :: (a -> c) -> (b -> d) -> f a b -> f c d
;;   In v1: simplified to bimap [container fn-left fn-right] :int
;;; Bifunctor -- map over both type arguments of a two-parameter type at once.
;;;
;;; Parameters:
;;;   ^^f -- the type constructor (kind * -> * -> *)
;;;
;;; Methods:
;;;   bimap -- `container` with `fn-left` applied on one side and
;;;            `fn-right` on the other.
;;;
;;; The same class the auto-loaded stdlib/typeclass-bifunctor.tur declares (a
;;; redeclaration must match it); that page carries the laws and examples.
;;;
;;; Since: Phase HKT H5


(defclass Bifunctor [^^f]
  (bimap [container : (f a b) fn-left : (fn [a] c) fn-right : (fn [b] d)]
    : (f c d)))
;;; Display -- values with a human-readable text form (Rust's Display).
;;;
;;; Parameters:
;;;   a -- the type to display
;;;
;;; Methods:
;;;   display -- `x` as a :cstr for end-user output.
;;;
;;; Example:
;;;   (display 42)   ; => "42"
;;;
;;; Since: Phase R0
;; Phase R0: Display and Debug typeclasses for formatting
;; Display - human-readable string representation (like Rust's Display)


(defclass Display [a] (display [x] : cstr))
;;; Debug -- values with a diagnostic text form (Rust's Debug).
;;;
;;; Parameters:
;;;   a -- the type to debug-print
;;;
;;; Methods:
;;;   debug -- `x` as a :cstr for diagnostic output; a string comes back
;;;            quoted.
;;;
;;; Example:
;;;   (debug "hi")   ; => "\"hi\""
;;;
;;; Since: Phase R0
;; Debug - debug string representation (like Rust's Debug)

(defclass Debug [a] (debug [x] : cstr))
;;; Error -- values that describe an error.
;;;
;;; Parameters:
;;;   a -- the error type
;;;
;;; Methods:
;;;   error-message -- a :cstr description of the error `x`.
;;;   error-cause   -- the underlying cause of `x` as :ptr<void>, or NULL
;;;                    when there is none.
;;;
;;; Since: Phase R0
;; Phase R0: Error typeclass (extends Show)
;; Error - for types that represent errors

(defclass Error [a] (error-message [x] : cstr) (error-cause [x] : ptr<void>))
;; Instances for primitive types (Display/Debug)
;;; Display [int] -- Display instance for int.

(definstance Display [int]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))
;;; Debug [int] -- Debug instance for int.

(definstance Debug [int]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "int(%lld)", (long long)x);
    return (const char *)buf;
    ```))
;; ---------------------------------------------------------------------------
;; Display / Debug for the remaining primitive types.  Show already carries
;; cstr / bool / the numeric set (stdlib/typeclass-show.tur); Display is the
;; plain user-facing form, so it delegates to `show`.  Debug is the diagnostic
;; form and keeps the `type(value)` tagging the existing Debug [int] / [ptr<void>]
;; instances use (cstr and bool follow the conventional quoted / bare spellings).
;;
;; Without these, `derive-debug` / `derive-display` over a struct with a cstr,
;; bool, or sized-numeric field emit a `.debug` / `.display` call whose element
;; type has no instance, and dispatch silently falls back to the enclosing
;; instance -- a miscompile.  See
;; docs/archive/history/derive-debug-display-missing-primitive-instances.md.
;;; Display [cstr] -- the string itself (delegates to Show [cstr]).

(definstance Display [cstr] (display [x] : cstr x))
;;; Debug [cstr] -- the string in double quotes.

(definstance Debug [cstr]
  (debug [x]
    : cstr
    ```c
    const char *s = (const char *)x;
    size_t n = strlen(s);
    char *buf = (char *)malloc(n + 3);
    buf[0] = '"';
    memcpy(buf + 1, s, n);
    buf[n + 1] = '"';
    buf[n + 2] = '\0';
    return (const char *)buf;
    ```))
;;; Display [bool] -- "true" / "false" (delegates to Show [bool]).

(definstance Display [bool] (display [x] : cstr (if x "true" "false")))
;;; Debug [bool] -- "true" / "false".

(definstance Debug [bool] (debug [x] : cstr (if x "true" "false")))
;;; Display [int8] -- decimal (delegates to Show [int8]).

(definstance Display [int8]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(8);
    snprintf(buf, 8, "%d", (int)x);
    return (const char *)buf;
    ```))
;;; Debug [int8] -- "int8(v)".

(definstance Debug [int8]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(16);
    snprintf(buf, 16, "int8(%d)", (int)x);
    return (const char *)buf;
    ```))
;;; Display [int16] -- decimal (delegates to Show [int16]).

(definstance Display [int16]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(8);
    snprintf(buf, 8, "%d", (int)x);
    return (const char *)buf;
    ```))
;;; Debug [int16] -- "int16(v)".

(definstance Debug [int16]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(16);
    snprintf(buf, 16, "int16(%d)", (int)x);
    return (const char *)buf;
    ```))
;;; Display [int32] -- decimal (delegates to Show [int32]).

(definstance Display [int32]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(16);
    snprintf(buf, 16, "%d", x);
    return (const char *)buf;
    ```))
;;; Debug [int32] -- "int32(v)".

(definstance Debug [int32]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "int32(%d)", (int)x);
    return (const char *)buf;
    ```))
;;; Display [uint8] -- decimal (delegates to Show [uint8]).

(definstance Display [uint8]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(8);
    snprintf(buf, 8, "%u", (unsigned)x);
    return (const char *)buf;
    ```))
;;; Debug [uint8] -- "uint8(v)".

(definstance Debug [uint8]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(16);
    snprintf(buf, 16, "uint8(%u)", (unsigned)x);
    return (const char *)buf;
    ```))
;;; Display [uint16] -- decimal (delegates to Show [uint16]).

(definstance Display [uint16]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(8);
    snprintf(buf, 8, "%u", (unsigned)x);
    return (const char *)buf;
    ```))
;;; Debug [uint16] -- "uint16(v)".

(definstance Debug [uint16]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(16);
    snprintf(buf, 16, "uint16(%u)", (unsigned)x);
    return (const char *)buf;
    ```))
;;; Display [uint32] -- decimal (delegates to Show [uint32]).

(definstance Display [uint32]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(16);
    snprintf(buf, 16, "%u", x);
    return (const char *)buf;
    ```))
;;; Debug [uint32] -- "uint32(v)".

(definstance Debug [uint32]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "uint32(%u)", (unsigned)x);
    return (const char *)buf;
    ```))
;;; Display [uint64] -- decimal (delegates to Show [uint64]).

(definstance Display [uint64]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%llu", (unsigned long long)x);
    return (const char *)buf;
    ```))
;;; Debug [uint64] -- "uint64(v)".

(definstance Debug [uint64]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "uint64(%llu)", (unsigned long long)x);
    return (const char *)buf;
    ```))
;;; Display [float] -- "%g" (delegates to Show [float]).

(definstance Display [float]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "%g", (double)x);
    return (const char *)buf;
    ```))
;;; Debug [float] -- "float(v)".

(definstance Debug [float]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(40);
    snprintf(buf, 40, "float(%g)", (double)x);
    return (const char *)buf;
    ```))
;;; Display [float32] -- "%g" (delegates to Show [float32]).

(definstance Display [float32]
  (display [x]
    : cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "%g", (double)x);
    return (const char *)buf;
    ```))
;;; Debug [float32] -- "float32(v)".

(definstance Debug [float32]
  (debug [x]
    : cstr
    ```c
    char *buf = (char *)malloc(40);
    snprintf(buf, 40, "float32(%g)", (double)x);
    return (const char *)buf;
