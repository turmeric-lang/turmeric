;;; Display [ptr<void>] -- Display instance for result<T,E> represented as ptr<void>.
;; Phase R1: Display, Debug, Error instances for result<T, E>
;; In v1, result is represented as ptr<void>


(definstance Display [ptr<void>]
  (display [x]
    : cstr
    ```c
    struct { int tag; int64_t payload; } *res = (void*)x;
    if (res == NULL) return "err";
    char *buf = (char *)malloc(48);
    if (res->tag == 0) {
        snprintf(buf, 48, "ok(%lld)", (long long)res->payload);
    } else {
        snprintf(buf, 48, "err(%lld)", (long long)res->payload);
    }
    return (const char *)buf;
    ```))
;;; Debug [ptr<void>] -- Debug instance for result<T,E> represented as ptr<void>.

(definstance Debug [ptr<void>]
  (debug [x]
    : cstr
    ```c
    struct { int tag; int64_t payload; } *res = (void*)x;
    if (res == NULL) return "Result::err";
    char *buf = (char *)malloc(64);
    if (res->tag == 0) {
        snprintf(buf, 64, "Result::ok(%lld)", (long long)res->payload);
    } else {
        snprintf(buf, 64, "Result::err(%lld)", (long long)res->payload);
    }
    return (const char *)buf;
    ```))
;; Show [ptr<void>] -- moved to stdlib/typeclass-show.tur alongside the Show
;; class (loaded at the END of this file -- see the header note).
;;; Error [ptr<void>] -- Error instance for result<T,E> represented as ptr<void>.

(definstance Error [ptr<void>]
  (error-message [x]
    : cstr
    ```c
    struct { int tag; int64_t payload; } *res = (void*)x;
    if (res == NULL || res->tag == 0) {
        return "not an error";
    } else {
        /* err_val is an int code in v1, convert to string */
        /* For simplicity, return a placeholder */
        return "error";
    }
    ```)
  (error-cause [x]
    : ptr<void>
    ```c
    /* In v1, result doesn't carry cause information */
    return NULL;
    ```))
;;; From -- conversion of a value of type a into type b.
;;;
;;; Parameters:
;;;   a -- the source type
;;;   b -- the target type
;;;
;;; Methods:
;;;   from -- `x` converted to b, returned as the :int carrier (int64_t
;;;           holds pointers in v1).
;;;
;;; The stdlib declares no From or Into instance; both classes are for user
;;; conversions.
;;;
;;; Since: Phase R0
;; Phase R0: From/Into conversion typeclasses
;; From[A B] - conversion from A to B
;; Note: return type is :int (int64_t holds pointers in v1)

(defclass From [a b] (from [x] : int))
;;; Into -- conversion of a value of type a into type b; the counterpart of From.
;;;
;;; Parameters:
;;;   a -- the source type
;;;   b -- the target type
;;;
;;; Methods:
;;;   into -- `x` converted to b, returned as the :int carrier (int64_t
;;;           holds pointers in v1).
;;;
;;; Since: Phase R0
;; Into[A B] - conversion from A to B (blanket derived from From[A B])

(defclass Into [a b] (into [x] : int))
;;; Hash -- the Hash class and its primitive instances now live in the
;;; auto-loaded stub stdlib/typeclass-hash.tur (Phase GHE0).  They were
;;; removed from this module so that loading typeclass.tur on demand does
;;; not redefine the always-present stub.  Reference `hash` directly; the
;;; class is in scope by default.
;; ---------------------------------------------------------------------------
;; Show (owned String result) -- loaded LAST so that its transitive load of
;; stdlib/string.tur (which loads this file back) finds Ord/Num/Display/Debug/
;; Error already defined.  See the note at the top of this file.

(load "stdlib/typeclass-show.tur")
