;;; markdown/scan -- CommonMark scanners: escapes, references, link pieces, tags and URLs.
;;;
;;; The lexical pieces both parsers share: backslash escapes and character
;;; references (md/-push-unescaped!), the link label, destination and title
;;; scanners, label normalisation, the HTML tag scanners (an HTML block of
;;; type 7, and raw inline HTML), the autolink scanners, and the URL
;;; normalisation a link destination goes through.  The block parser uses
;;; them for link reference definitions; the inline parser
;;; (stdlib/markdown/inline.tur) for links, autolinks and raw HTML.  Every
;;; scanner reads a String between two byte indices and answers with the
;;; index just past what it matched, or -1.
;;;
;;; Since: markdown-library-plan M1
;; The entity table, which loads unicode.tur and string.tur.
(load "stdlib/markdown/entities.tur")
;; ---- Byte classes ------------------------------------------------------------
;; Bytes are ints here: 9 tab, 10 LF, 13 CR, 32 space, 34 ", 35 #, 38 &,
;; 39 ', 40 (, 41 ), 47 /, 58 :, 59 ;, 60 <, 61 =, 62 >, 91 [, 92 \, 93 ],
;; 96 `, 124 |.
;;; md/-byte -- internal: the byte at i of s, or -1 outside it.

(defn md/-byte [s : String i : int] : int
  (if (and (>= i 0) (< i (string/len s))) (string/byte-at s i) -1))
;;; md/-space-tab? -- internal: is b a space or a tab?

(defn md/-space-tab? [b : int] : bool (or (= b 32) (= b 9)))
;;; md/-ws? -- internal: is b ASCII whitespace: space, tab, LF, VT, FF or CR?

(defn md/-ws? [b : int] : bool (or (= b 32) (and (>= b 9) (<= b 13))))
;;; md/-punct? -- internal: is b ASCII punctuation, which a backslash escapes?

(defn md/-punct? [b : int] : bool
  (or (and (>= b 33) (<= b 47))
    (and (>= b 58) (<= b 64))
    (and (>= b 91) (<= b 96))
    (and (>= b 123) (<= b 126))))
;;; md/-digit? -- internal: is b an ASCII digit?

(defn md/-digit? [b : int] : bool (and (>= b 48) (<= b 57)))
;;; md/-alpha? -- internal: is b an ASCII letter?

(defn md/-alpha? [b : int] : bool
  (or (and (>= b 65) (<= b 90)) (and (>= b 97) (<= b 122))))
;;; md/-alnum? -- internal: is b an ASCII letter or digit?

(defn md/-alnum? [b : int] : bool (or (md/-alpha? b) (md/-digit? b)))
;;; md/-hex? -- internal: is b an ASCII hex digit?

(defn md/-hex? [b : int] : bool
  (or (md/-digit? b) (and (>= b 65) (<= b 70)) (and (>= b 97) (<= b 102))))
;;; md/-hex-val -- internal: the value of hex digit b.

(defn md/-hex-val [b : int] : int
  (cond (md/-digit? b) (- b 48) (<= b 70) (- b 55) :else (- b 87)))
;;; md/-lower -- internal: b in ASCII lower case.

(defn md/-lower [b : int] : int (if (and (>= b 65) (<= b 90)) (+ b 32) b))
;;; md/-skip-ws -- internal: the first index at or after i, before end, that is not ASCII whitespace.

(defn md/-skip-ws [s : String i0 : int end : int] : int
  (let [^mut i i0]
    (do
      (while (and (< i end) (md/-ws? (string/byte-at s i))) (set! i (+ i 1)))
      i)))
;;; md/-skip-spaces -- internal: the first index at or after i, before end, that is not a space.

(defn md/-skip-spaces [s : String i0 : int end : int] : int
  (let [^mut i i0]
    (do (while (and (< i end) (= (string/byte-at s i) 32)) (set! i (+ i 1))) i)))
;; ---- Character references ----------------------------------------------------
;; &name; (an HTML5 entity name), &#digits; (1-7) and &#xhex; (1-6).  A
;; reference to 0, a surrogate or a value past U+10FFFF stands for U+FFFD.
;;; md/-run-end -- internal: the end of the run of bytes from i (at most max) that satisfy the class: 0 digits, 1 hex digits, 2 letters and digits.

(defn md/-run-end [s : String i0 : int end : int max : int cls : int] : int
  (let [^mut i  i0
        ^mut go true]
    (do
      (while (and go (< i end) (< (- i i0) max))
        (let [b (string/byte-at s i)]
          (if (cond (= cls 0) (md/-digit? b)
                    (= cls 1) (md/-hex? b)
                    :else     (md/-alnum? b))
            (set! i (+ i 1))
            (set! go false))))
      i)))
;;; md/-num-val -- internal: the value of the digits [i, end) of s in base 10 or 16.

(defn md/-num-val [s : String i0 : int end : int base : int] : int
  (let [^mut i i0
        ^mut v 0]
    (do
      (while (< i end)
        (do
          (set! v (+ (* v base) (md/-hex-val (string/byte-at s i))))
          (set! i (+ i 1))))
      v)))
;;; md/-push-cp! -- internal: append the code point a numeric reference names, U+FFFD for 0.

(defn md/-push-cp! [b : StringBuilder cp : int] : void
  (utf8/push-char! b (int->char (if (= cp 0) 65533 cp))))
;;; md/-push-numeric! -- internal: append the numeric reference whose digits start at i; the index past its ; or -1.

(defn md/-push-numeric! [b : StringBuilder s : String i : int end : int] : int
  (let [x (or (= (md/-byte s i) 120) (= (md/-byte s i) 88))
        d (if x (+ i 1) i)
        e (md/-run-end s d end (if x 6 7) (if x 1 0))]
    (if (and (> e d) (< e end) (= (string/byte-at s e) 59))
      (do (md/-push-cp! b (md/-num-val s d e (if x 16 10))) (+ e 1))
      -1)))
;;; md/-push-named! -- internal: append the named reference whose name starts at i; the index past its ; or -1.

(defn md/-push-named! [b : StringBuilder s : String i : int end : int] : int
  (let [e (md/-run-end s i end 32 2)]
    (if (and (md/-alpha? (md/-byte s i))
          (>= (- e i) 2)
          (< e end)
          (= (string/byte-at s e) 59))
      (let [name (string/substring s i (- e i))
            hit  (markdown/entity-lookup name)]
        (do
          (string/release name)
          (match hit
            (Some t)
            (do (builder/push-string! b t) (string/release t) (+ e 1))
            (None)
            -1)))
      -1)))
;;; md/-push-entity! -- internal: append the character reference at i (an &); the index past it, or -1 when there is none.

(defn md/-push-entity! [b : StringBuilder s : String i : int end : int] : int
  (if (= (md/-byte s (+ i 1)) 35)
    (md/-push-numeric! b s (+ i 2) end)
    (md/-push-named! b s (+ i 1) end)))
;;; md/-entity-into! -- internal: at an & at i, flush [run, i) and append the reference; the index past it, or -1 (nothing appended).

(defn md/-entity-into! [b : StringBuilder
                        s : String
                        run : int
                        i : int
                        end : int] : int
  (let [t (builder/new)
        e (md/-push-entity! t s i end)]
    (if (> e 0)
      (do
        (string/-push-range! b s run i)
        (let [r (builder/finish t)]
          (do (builder/push-string! b r) (string/release r) e)))
      (do (string/release (builder/finish t)) -1))))
;;; md/-escape-at? -- internal: is the byte at j of s a backslash escaping an ASCII punctuation character?

(defn md/-escape-at? [s : String j : int end : int] : bool
  (and (= (string/byte-at s j) 92)
    (< (+ j 1) end)
    (md/-punct? (string/byte-at s (+ j 1)))))
;;; md/-push-unescaped! -- internal: append [i, end) of s with backslash escapes and character references replaced.

(defn md/-push-unescaped! [b : StringBuilder s : String i0 : int end : int] : void
  (let [^mut i   i0
        ^mut run i0]
    (do
      (while (< i end)
        (cond (md/-escape-at? s i end)    (do
                                            (string/-push-range! b s run i)
                                            (set! run (+ i 1))
                                            (set! i (+ i 2)))
              (= (string/byte-at s i) 38) (let [e (md/-entity-into! b
                                                    s
                                                    run
                                                    i
                                                    end)]
                                            (if (> e 0)
                                              (do (set! i e) (set! run e))
                                              (set! i (+ i 1))))
              :else                       (set! i (+ i 1))))
      (string/-push-range! b s run end))))
;;; md/-unescape -- internal: [i, end) of s with escapes and references replaced, as a fresh String.

(defn md/-unescape [s : String i : int end : int] : String
  (let [b (builder/new)]
    (do (md/-push-unescaped! b s i end) (builder/finish b))))
;; ---- Link reference pieces ---------------------------------------------------
;;; md/-scan-label -- internal: the end of the link label whose [ is at i: [ ... ] with at most 999 bytes inside and no unescaped bracket.

(defn md/-scan-label [s : String i : int end : int] : int
  (if (not (= (md/-byte s i) 91))
    -1
    (let [^mut j   (+ i 1)
          ^mut res -2]
      (do
        (while (= res -2)
          (if (or (>= j end) (> (- j i) 1000))
            (set! res -1)
            (let [c (string/byte-at s j)]
              (cond (= c 93) (set! res (+ j 1))
                    (= c 91) (set! res -1)
                    (= c 92) (set! j (+ j 2))
                    :else    (set! j (+ j 1))))))
        (if (and (> res 0) (> (- res i) 1001)) -1 res)))))
;;; md/-spnl -- internal: skip spaces, at most one line ending, and spaces.

(defn md/-spnl [s : String i : int end : int] : int
  (let [j (md/-skip-spaces s i end)]
    (if (and (< j end) (= (string/byte-at s j) 10))
      (md/-skip-spaces s (+ j 1) end)
      j)))
;;; md/-space-eol -- internal: past spaces and the line ending (or the end) after i, or -1 when something else comes first.

(defn md/-space-eol [s : String i : int end : int] : int
  (let [j (md/-skip-spaces s i end)]
    (cond (>= j end) j (= (string/byte-at s j) 10) (+ j 1) :else -1)))
;;; md/-scan-dest-angle -- internal: the end of an <...> destination whose content starts at i.

(defn md/-scan-dest-angle [s : String i : int end : int] : int
  (let [^mut j   i
        ^mut res -2]
    (do
      (while (= res -2)
        (if (>= j end)
          (set! res -1)
          (let [c (string/byte-at s j)]
            (cond (= c 62)               (set! res (+ j 1))
                  (or (= c 60) (= c 10)) (set! res -1)
                  (= c 92)               (if (and (< (+ j 1) end)
                                               (not (= (string/byte-at s
                                                         (+ j 1))
                                                      10)))
                                           (set! j (+ j 2))
                                           (set! res -1))
                  :else                  (set! j (+ j 1))))))
      res)))
;;; md/-scan-dest-plain -- internal: the end of a destination without <>: balanced parentheses, no whitespace.

(defn md/-scan-dest-plain [s : String i : int end : int] : int
  (let [^mut j      i
        ^mut parens 0
        ^mut stop   -1
        ^mut go     true]
    (do
      (while (and go (< j end))
        (let [c (string/byte-at s j)]
          (cond (md/-escape-at? s j end)    (set! j (+ j 2))
                (= c 40)                    (do
                                              (set! j (+ j 1))
                                              (set! parens (+ parens 1)))
                (and (= c 41) (> parens 0)) (do
                                              (set! j (+ j 1))
                                              (set! parens (- parens 1)))
                (or (= c 41) (md/-ws? c))   (do (set! stop c) (set! go false))
                :else                       (set! j (+ j 1)))))
      (cond (and (= j i) (not (= stop 41))) -1 (not (= parens 0)) -1 :else j))))
;;; md/-scan-dest -- internal: the end of the link destination at i, or -1.

(defn md/-scan-dest [s : String i : int end : int] : int
  (if (= (md/-byte s i) 60)
    (md/-scan-dest-angle s (+ i 1) end)
    (md/-scan-dest-plain s i end)))
;;; md/-scan-title -- internal: the end of the link title at i, in "", '' or ().

(defn md/-scan-title [s : String i : int end : int] : int
  (let [open  (md/-byte s i)
        close (if (= open 40) 41 open)]
    (if (not (or (= open 34) (= open 39) (= open 40)))
      -1
      (let [^mut j   (+ i 1)
            ^mut res -2]
        (do
          (while (= res -2)
            (if (>= j end)
              (set! res -1)
              (let [c (string/byte-at s j)]
                (cond (= c close)                (set! res (+ j 1))
                      (= c 92)                   (if (< (+ j 1) end)
                                                   (set! j (+ j 2))
                                                   (set! res -1))
                      (and (= open 40) (= c 40)) (set! res -1)
                      :else                      (set! j (+ j 1))))))
          res)))))
;;; md/-normalize-label -- internal: the label [i, end) of s (brackets included) as references match it: trimmed, inner whitespace collapsed to one space, case-folded.

(defn md/-normalize-label [s : String i : int end : int] : String
  (let [b        (builder/new)
        ^mut j   (md/-skip-ws s (+ i 1) (- end 1))
        ^mut gap false]
    (do
      (while (< j (- end 1))
        (let [c (string/byte-at s j)]
          (if (md/-ws? c)
            (set! gap true)
            (do
              (when gap (builder/push-byte! b 32))
              (set! gap false)
              (builder/push-byte! b c)))
          (set! j (+ j 1))))
      (let [raw    (builder/finish b)
            folded (unicode/fold-case raw)]
        (do (string/release raw) folded)))))
;; ---- HTML tags -----------------------------------------------------------------
;; The open and close tags CommonMark recognises (spec section 6.6): a tag
;; name, then attributes, each a name with an optional unquoted, '' or ""
;; value, then an optional / and the >.
;;; md/-name-start? -- internal: can b start an attribute name?

(defn md/-name-start? [b : int] : bool (or (md/-alpha? b) (= b 95) (= b 58)))
;;; md/-name-byte? -- internal: can b continue an attribute name?

(defn md/-name-byte? [b : int] : bool
  (or (md/-alnum? b) (= b 95) (= b 58) (= b 46) (= b 45)))
;;; md/-tag-name-end -- internal: the end of the tag name at i (a letter, then letters, digits and -), or -1.

(defn md/-tag-name-end [s : String i0 : int end : int] : int
  (if (not (and (< i0 end) (md/-alpha? (string/byte-at s i0))))
    -1
    (let [^mut i (+ i0 1)]
      (do
        (while (and (< i end)
                 (let [b (string/byte-at s i)] (or (md/-alnum? b) (= b 45))))
          (set! i (+ i 1)))
        i))))
;;; md/-attr-name-end -- internal: the end of the attribute name at i.

(defn md/-attr-name-end [s : String i0 : int end : int] : int
  (let [^mut i (+ i0 1)]
    (do
      (while (and (< i end) (md/-name-byte? (string/byte-at s i)))
        (set! i (+ i 1)))
      i)))
;;; md/-unquoted-byte? -- internal: can b be in an unquoted attribute value?

(defn md/-unquoted-byte? [b : int] : bool
  (not (or (<= b 32) (= b 34) (= b 39) (= b 61) (= b 60) (= b 62) (= b 96))))
;;; md/-attr-value-end -- internal: the end of the attribute value at i, or -1.

(defn md/-attr-value-end [s : String i : int end : int] : int
  (let [q (md/-byte s i)]
    (if (or (= q 34) (= q 39))
      (let [^mut j (+ i 1)]
        (do
          (while (and (< j end) (not (= (string/byte-at s j) q)))
            (set! j (+ j 1)))
          (if (< j end) (+ j 1) -1)))
      (let [^mut j i]
        (do
          (while (and (< j end) (md/-unquoted-byte? (string/byte-at s j)))
            (set! j (+ j 1)))
          (if (> j i) j -1))))))
;;; md/-attr-end -- internal: the end of one attribute (whitespace, name, optional value) at i, or -1.

(defn md/-attr-end [s : String i : int end : int] : int
  (let [n (md/-skip-ws s i end)]
    (if (or (= n i) (>= n end) (not (md/-name-start? (string/byte-at s n))))
      -1
      (let [ne (md/-attr-name-end s n end)
            eq (md/-skip-ws s ne end)]
        (if (and (< eq end) (= (string/byte-at s eq) 61))
          (let [v (md/-attr-value-end s (md/-skip-ws s (+ eq 1) end) end)]
            (if (< v 0) ne v))
          ne)))))
;;; md/-open-tag-end -- internal: the end of the open tag whose < is at i, or -1.

(defn md/-open-tag-end [s : String i : int end : int] : int
  (let [t (md/-tag-name-end s (+ i 1) end)]
    (if (< t 0)
      -1
      (let [^mut j t
            ^mut a (md/-attr-end s t end)]
        (do
          (while (> a 0) (do (set! j a) (set! a (md/-attr-end s j end))))
          (let [k  (md/-skip-ws s j end)
                k2 (if (= (md/-byte s k) 47) (+ k 1) k)]
            (if (= (md/-byte s k2) 62) (+ k2 1) -1)))))))
;;; md/-close-tag-end -- internal: the end of the close tag whose < is at i, or -1.

(defn md/-close-tag-end [s : String i : int end : int] : int
  (if (not (= (md/-byte s (+ i 1)) 47))
    -1
    (let [t (md/-tag-name-end s (+ i 2) end)]
      (if (< t 0)
        -1
        (let [k (md/-skip-ws s t end)] (if (= (md/-byte s k) 62) (+ k 1) -1))))))
;;; md/-lower-run -- internal: the letters and digits from i of s, lower-cased, as a fresh String.

(defn md/-lower-run [s : String i0 : int end : int] : String
  (let [b      (builder/new)
        ^mut i i0]
    (do
      (while (and (< i end) (md/-alnum? (string/byte-at s i)))
        (do
          (builder/push-byte! b (md/-lower (string/byte-at s i)))
          (set! i (+ i 1))))
      (builder/finish b))))
;;; md/-word-in? -- internal: is name one of the |-separated words of list?

(defn md/-word-in? [list : cstr name : String] : bool
  (let [hay (string/from-cstr list)
        b   (builder/new)]
    (do
      (builder/push-byte! b 124)
      (builder/push-string! b name)
      (builder/push-byte! b 124)
      (let [needle (builder/finish b)
            hit    (some? (string/index-of hay needle))]
        (do (string/release needle) (string/release hay) hit)))))
;; ---- Raw inline HTML (spec section 6.6) ------------------------------------------
;;; md/-find-from -- internal: the index of the bytes of needle in [i, end) of s, or -1.

(defn md/-find-from [s : String needle : cstr i : int end : int] : int
  (let [n (string/from-cstr needle)
        r (match (string/index-of-from s n i)
            (Some p)
            (if (<= (+ p (string/len n)) end) p -1)
            (None)
            -1)]
    (do (string/release n) r)))
;;; md/-has-cstr-at? -- internal: do the bytes of lit occur in s at i?

(defn md/-has-cstr-at? [s : String lit : cstr i : int] : bool
  (let [n (string/from-cstr lit)
        r (string/starts-with-at? s n i)]
    (do (string/release n) r)))
;;; md/-utf8-next -- internal: the index past the well-formed UTF-8 sequence at i, when it ends by end; else -1.

(defn md/-utf8-next [s : String i : int end : int] : int
  (match (utf8/decode-at s i)
    (Some p)
    (let [n (pair-snd p)]
      (cond (> n end)                                                                                                              -1
            (not (= (char->int (pair-fst p)) 65533))                                                                               n
            (and (= n (+ i 3))
              (= (string/byte-at s i) 239)
              (= (string/byte-at s (+ i 1)) 191)
              (= (string/byte-at s (+ i 2)) 189))                                                                                  n
            :else                                                                                                                  -1))
    (None)
    -1))
;;; md/-ci-cstr-at? -- internal: do the bytes of lit, which is lower case, occur in s at i, ignoring ASCII case?

(defn md/-ci-cstr-at? [s : String lit : cstr i : int] : bool
  (let [n       (string/from-cstr lit)
        k       (string/len n)
        ^mut j  0
        ^mut ok (and (>= i 0) (<= (+ i k) (string/len s)))]
    (do
      (while (and ok (< j k))
        (do
          (when (not (= (md/-lower (string/byte-at s (+ i j)))
                       (string/byte-at n j)))
            (set! ok false))
          (set! j (+ j 1))))
      (string/release n)
      ok)))
;;; md/-comment-end -- internal: the end of the HTML comment whose < is at i: <!-->, <!---> or <!-- ... -->.

(defn md/-comment-end [s : String i : int end : int] : int
  (cond (md/-has-cstr-at? s "<!-->" i)  (+ i 5)
        (md/-has-cstr-at? s "<!--->" i) (+ i 6)
        (md/-has-cstr-at? s "<!--" i)   (let [e (md/-find-from s
                                                  "-->"
                                                  (+ i 4)
                                                  end)]
                                          (if (< e 0) -1 (+ e 3)))
        :else                           -1))
;;; md/-pi-end -- internal: the end of the processing instruction <? ... ?> at i.

(defn md/-pi-end [s : String i : int end : int] : int
  (if (= (md/-byte s (+ i 1)) 63)
    (let [e (md/-find-from s "?>" (+ i 2) end)] (if (< e 0) -1 (+ e 2)))
    -1))
;;; md/-cdata-end -- internal: the end of the CDATA section <![CDATA[ ... ]]> at i.

(defn md/-cdata-end [s : String i : int end : int] : int
  (if (md/-has-cstr-at? s "<![CDATA[" i)
    (let [e (md/-find-from s "]]>" (+ i 9) end)] (if (< e 0) -1 (+ e 3)))
    -1))
;;; md/-decl-end -- internal: the end of the declaration <! and letters and anything but > ... > at i.

(defn md/-decl-end [s : String i : int end : int] : int
  (if (and (= (md/-byte s (+ i 1)) 33) (md/-alpha? (md/-byte s (+ i 2))))
    (let [^mut j (+ i 3)]
      (do
        (while (and (< j end) (md/-alpha? (string/byte-at s j)))
          (set! j (+ j 1)))
        (while (and (< j end) (not (= (string/byte-at s j) 62)))
          (set! j (+ j 1)))
        (if (< j end) (+ j 1) -1)))
    -1))
;;; md/-html-tag-end -- internal: the end of the raw HTML at i (an open or close tag, comment, processing instruction, declaration or CDATA section), or -1.

(defn md/-html-tag-end [s : String i : int end : int] : int
  (let [c1 (md/-byte s (+ i 1))]
    (cond (md/-alpha? c1) (md/-open-tag-end s i end)
          (= c1 47)       (md/-close-tag-end s i end)
          (= c1 63)       (md/-pi-end s i end)
          (= c1 33)       (let [cm (md/-comment-end s i end)]
                            (if (>= cm 0)
                              cm
                              (let [cd (md/-cdata-end s i end)]
                                (if (>= cd 0) cd (md/-decl-end s i end)))))
          :else           -1)))
;; ---- Autolinks (spec section 6.5) -----------------------------------------------
;;; md/-uri-autolink-end -- internal: the end of <scheme:...> at i: a scheme of 2 to 32 letters, digits, + . -, a colon, and no space, control, < or >.

(defn md/-uri-autolink-end [s : String i : int end : int] : int
  (if (not (md/-alpha? (md/-byte s (+ i 1))))
    -1
    (let [^mut j (+ i 2)]
      (do
        (while (and (< j end)
                 (let [c (string/byte-at s j)]
                   (or (md/-alnum? c) (= c 43) (= c 46) (= c 45))))
          (set! j (+ j 1)))
        (if (or (< (- j (+ i 1)) 2)
              (> (- j (+ i 1)) 32)
              (not (= (md/-byte s j) 58)))
          -1
          (let [^mut k (+ j 1)]
            (do
              (while (and (< k end)
                       (let [c (string/byte-at s k)]
                         (not (or (<= c 32) (= c 60) (= c 62)))))
                (set! k (+ k 1)))
              (if (= (md/-byte s k) 62) (+ k 1) -1))))))))
;;; md/-word-in-bytes? -- internal: is c one of the punctuation an email local part allows: . ! # $ % & ' * + / = ? ^ _ ` { | } ~ -

(defn md/-word-in-bytes? [c : int] : bool
  (or (= c 46)
    (= c 33)
    (= c 35)
    (= c 36)
    (= c 37)
    (= c 38)
    (= c 39)
    (= c 42)
    (= c 43)
    (= c 47)
    (= c 61)
    (= c 63)
    (= c 94)
    (= c 95)
    (= c 96)
    (= c 123)
    (= c 124)
    (= c 125)
    (= c 126)
    (= c 45)))
;;; md/-email-local? -- internal: can byte c be in the local part of an email autolink?

(defn md/-email-local? [c : int] : bool
  (or (md/-alnum? c) (and (> c 32) (< c 127) (md/-word-in-bytes? c))))
;;; md/-email-label-end -- internal: the end of one domain label at j (letters, digits and inner hyphens, 1 to 63 bytes), or -1.

(defn md/-email-label-end [s : String j0 : int end : int] : int
  (let [^mut j j0]
    (do
      (while (and (< j end)
               (let [c (string/byte-at s j)] (or (md/-alnum? c) (= c 45))))
        (set! j (+ j 1)))
      (cond (= j j0)                                      -1
            (> (- j j0) 63)                               -1
            (not (md/-alnum? (string/byte-at s j0)))      -1
            (not (md/-alnum? (string/byte-at s (- j 1)))) -1
            :else                                         j))))
;;; md/-email-autolink-end -- internal: the end of <local@domain> at i, or -1.

(defn md/-email-autolink-end [s : String i : int end : int] : int
  (let [^mut j (+ i 1)]
    (do
      (while (and (< j end) (md/-email-local? (string/byte-at s j)))
        (set! j (+ j 1)))
      (if (or (= j (+ i 1)) (not (= (md/-byte s j) 64)))
        -1
        (let [^mut k  (md/-email-label-end s (+ j 1) end)
              ^mut go (>= k 0)]
          (do
            (while (and go (= (md/-byte s k) 46))
              (let [k2 (md/-email-label-end s (+ k 1) end)]
                (if (< k2 0) (set! go false) (set! k k2))))
            (if (and (>= k 0) (= (md/-byte s k) 62)) (+ k 1) -1)))))))
;; ---- URL normalisation ------------------------------------------------------------
;; A destination is percent-encoded as commonmark.js does with mdurl: ASCII
;; letters and digits and ; / ? : @ & = + $ , - _ . ! ~ * ' ( ) # stay, a % that
;; already starts an escape stays, and every other byte becomes %XX.
;;; md/-url-safe? -- internal: does byte c stay as it is in a normalised URL?

(defn md/-url-safe? [c : int] : bool
  (or (md/-alnum? c)
    (= c 59)
    (= c 47)
    (= c 63)
    (= c 58)
    (= c 64)
    (= c 38)
    (= c 61)
    (= c 43)
    (= c 36)
    (= c 44)
    (= c 45)
    (= c 95)
    (= c 46)
    (= c 33)
    (= c 126)
    (= c 42)
    (= c 39)
    (= c 40)
    (= c 41)
    (= c 35)))
;;; md/-hex-digit -- internal: the upper-case hex digit for n (0 to 15).

(defn md/-hex-digit [n : int] : int (if (< n 10) (+ 48 n) (+ 55 n)))
;;; md/-pct-escape-at? -- internal: does a %XX escape start at byte i of s?

(defn md/-pct-escape-at? [s : String i : int n : int] : bool
  (and (= (string/byte-at s i) 37)
    (< (+ i 2) n)
    (md/-hex? (string/byte-at s (+ i 1)))
    (md/-hex? (string/byte-at s (+ i 2)))))
;;; md/-normalize-uri -- internal: s percent-encoded as a link destination, as a fresh String.

(defn md/-normalize-uri [s : String] : String
  (let [b      (builder/new)
        n      (string/len s)
        ^mut i 0]
    (do
      (while (< i n)
        (let [c (string/byte-at s i)]
          (cond (md/-pct-escape-at? s i n) (do
                                             (string/-push-range! b s i (+ i 3))
                                             (set! i (+ i 3)))
                (md/-url-safe? c)          (do
                                             (builder/push-byte! b c)
                                             (set! i (+ i 1)))
                :else                      (do
                                             (builder/push-byte! b 37)
                                             (builder/push-byte! b
                                               (md/-hex-digit (/ c 16)))
                                             (builder/push-byte! b
                                               (md/-hex-digit (mod c 16)))
                                             (set! i (+ i 1))))))
      (builder/finish b))))
;;; md/-dest-string -- internal: the destination [i, end) of s, unescaped and normalised, as a fresh String.

(defn md/-dest-string [s : String i : int end : int] : String
  (let [raw (md/-unescape s i end)
        out (md/-normalize-uri raw)]
    (do (string/release raw) out)))
;; ---- GFM tables (markdown-library-plan M3) -------------------------------------
;; The row and delimiter-row scanners of cmark-gfm's table extension
;; (extensions/ext_scanners.re), over one line [i, end) with no line ending.
;;; md/-byte-in -- internal: byte j of s when it is before end, else -1.

(defn md/-byte-in [s : String j : int end : int] : int
  (if (< j end) (string/byte-at s j) -1))
;;; md/-table-space? -- internal: a table's space character: space, tab, VT or FF.

(defn md/-table-space? [b : int] : bool (or (= b 32) (= b 9) (= b 11) (= b 12)))
;;; md/-skip-table-space -- internal: past the table spaces from i.

(defn md/-skip-table-space [s : String i0 : int end : int] : int
  (let [^mut i i0]
    (do (while (md/-table-space? (md/-byte-in s i end)) (set! i (+ i 1))) i)))
;;; md/-table-marker-end -- internal: past a delimiter-row cell at i (spaces, an optional :, one or more -, an optional :, spaces), or -1.

(defn md/-table-marker-end [s : String i : int end : int] : int
  (let [^mut j (md/-skip-table-space s i end)]
    (do
      (when (= (md/-byte-in s j end) 58) (set! j (+ j 1)))
      (let [d j]
        (do
          (while (= (md/-byte-in s j end) 45) (set! j (+ j 1)))
          (if (= j d)
            -1
            (do
              (when (= (md/-byte-in s j end) 58) (set! j (+ j 1)))
              (md/-skip-table-space s j end))))))))
;;; md/-table-start? -- internal: is [i, end) of s a delimiter row: cells of dashes with optional colons, separated by pipes?

(defn md/-table-start? [s : String i : int end : int] : bool
  (let [p0     (if (= (md/-byte-in s i end) 124) (+ i 1) i)
        ^mut e (md/-table-marker-end s p0 end)
        ^mut r -1]
    (do
      (while (< r 0)
        (cond (< e 0)                       (set! r 0)
              (= (md/-byte-in s e end) 124) (let [p (+ e 1)]
                                              (if (>= (md/-skip-table-space s
                                                        p
                                                        end)
                                                    end)
                                                (set! r 1)
                                                (set! e
                                                  (md/-table-marker-end s p end))))
              :else                         (set! r (if (>= e end) 1 0))))
      (= r 1))))
;;; md/-cell-end -- internal: the end of a table cell's text at i: before the first pipe that no backslash precedes.

(defn md/-cell-end [s : String i : int end : int] : int
  (let [^mut j i]
    (do
      (while (and (< j end)
               (or (not (= (string/byte-at s j) 124))
                 (and (> j i) (= (string/byte-at s (- j 1)) 92))))
        (set! j (+ j 1)))
      j)))
;;; md/-pipe-len -- internal: the length of the pipe and spaces at i, or 0 when there is no pipe.

(defn md/-pipe-len [s : String i : int end : int] : int
  (if (= (md/-byte-in s i end) 124)
    (- (md/-skip-table-space s (+ i 1) end) i)
    0))
;;; md/-cell-text -- internal: a table cell's text [a, b) of s: each backslash-pipe as a pipe, trimmed, as a fresh String.

(defn md/-cell-text [s : String a : int b : int] : String
  (let [out    (builder/new)
        ^mut i a]
    (do
      (while (< i b)
        (do
          (when (not (and (= (string/byte-at s i) 92)
                       (= (md/-byte-in s (+ i 1) b) 124)))
            (builder/push-byte! out (string/byte-at s i)))
          (set! i (+ i 1))))
      (let [raw (builder/finish out)
            t   (string/trim raw)]
        (do (string/release raw) t)))))
;;; md/-new-cells -- internal: an empty Vec of cell texts.

(defn md/-new-cells [] : (Vec String) (vec-new))
;;; md/-row-cells -- internal: the cells of the table row [i, end) of s, each a fresh String, or (none) when it is not a row.

(defn md/-row-cells [s : String i : int end : int] : (Option (Vec String))
  (let [cells       (md/-new-cells)
        ^mut offset (+ i (md/-pipe-len s i end))
        ^mut go     true]
    (do
      (while (and go (< offset end))
        (let [ce (md/-cell-end s offset end)
              pm (md/-pipe-len s ce end)]
          (do
            (when (or (> ce offset) (> pm 0))
              (vec-push! cells (md/-cell-text s offset ce)))
            (set! offset (+ ce pm))
            (when (= pm 0) (set! go false)))))
      (if (or (not (= offset end)) (= (vec-len cells) 0))
        (do (string/release-all cells) (none))
        (some cells)))))
