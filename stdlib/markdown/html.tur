;;; markdown/html -- render a parsed Markdown document as HTML.
;;;
;;; The CommonMark spec's HTML, as commonmark.js writes it: the blocks, then
;;; each paragraph's, heading's and table cell's inline tree.  An image's alt
;;; text is its inlines as plain text, escaped.  GFM tables and task list
;;; items are written as cmark-gfm writes them, and headings get an id when
;;; MdHtmlOpts's heading-ids asks for one.
;;;
;;; Since: markdown-library-plan M1
;; The document types, the block parser and the inline parser.
(load "stdlib/markdown/inline.tur")

;; The heading-id rules.
(load "stdlib/markdown/slug.tur")
;;; MdRawHtml -- what the renderer does with raw HTML in the document.
;;;
;;; MdRawPass writes it through.  MdRawTagFilter, the default, is GitHub's
;;; behaviour: it writes it through but escapes the < that opens one of nine
;;; tags (title, textarea, style, xmp, iframe, noembed, noframes, script,
;;; plaintext).  MdRawEscape writes all raw HTML as text.

(defdata MdRawHtml :copy (MdRawPass) (MdRawTagFilter) (MdRawEscape))
;;; MdSlugMode -- whether markdown/render-html gives each heading an id, and by which rule.
;;;
;;; MdNoIds writes none, as the CommonMark spec and cmark-gfm do.  MdSlugPython
;;; is python-markdown's toc extension and MdSlugGitHub GitHub's
;;; (stdlib/markdown/slug.tur has both rules).

(defdata MdSlugMode :copy (MdNoIds) (MdSlugPython) (MdSlugGitHub))
;;; MdHtmlOpts -- options for markdown/render-html: what to do with raw HTML, and how to give headings ids.

(defstruct MdHtmlOpts :copy [raw-html : MdRawHtml heading-ids : MdSlugMode])
;;; MdRen -- internal: renderer state: whether the output ends with a line feed, the headings' ids, and the next one to write.

(defstruct MdRen [nl : bool ids : (Vec String) next : int])
;; ---- Output ------------------------------------------------------------------------
;;; md/-out! -- internal: append a literal and note whether it ends the line.

(defn md/-out! [^borrow r : rc<MdRen> b : StringBuilder s : cstr] : void
  (do (builder/push-cstr! b s) (set! (.nl r) false)))
;;; md/-cr! -- internal: start a new line unless the output is at one.

(defn md/-cr! [^borrow r : rc<MdRen> b : StringBuilder] : void
  (when (not (.nl r)) (do (builder/push-byte! b 10) (set! (.nl r) true))))
;;; md/-ends-nl? -- internal: does [i, end) of s end with a line feed?

(defn md/-ends-nl? [s : String i : int end : int] : bool
  (and (> end i) (= (string/byte-at s (- end 1)) 10)))
;;; md/-escape-of -- internal: the entity that stands for byte c in HTML text, or "" when c needs none.

(defn md/-escape-of [c : int] : cstr
  (cond (= c 38) "&amp;"
        (= c 60) "&lt;"
        (= c 62) "&gt;"
        (= c 34) "&quot;"
        :else    ""))
;;; md/-push-escaped! -- internal: append [i, end) of s with & < > and " escaped.

(defn md/-push-escaped! [b : StringBuilder s : String i0 : int end : int] : void
  (let [^mut i   i0
        ^mut run i0]
    (do
      (while (< i end)
        (let [c (string/byte-at s i)]
          (do
            (when (or (= c 38) (= c 60) (= c 62) (= c 34))
              (do
                (string/-push-range! b s run i)
                (builder/push-cstr! b (md/-escape-of c))
                (set! run (+ i 1))))
            (set! i (+ i 1)))))
      (string/-push-range! b s run end))))
;;; md/-text! -- internal: append [i, end) of s escaped, tracking the line end.

(defn md/-text! [^borrow r : rc<MdRen>
                 b : StringBuilder
                 s : String
                 i : int
                 end : int] : void
  (when (> end i)
    (do (md/-push-escaped! b s i end) (set! (.nl r) (md/-ends-nl? s i end)))))
;;; md/-raw! -- internal: append [i, end) of s as it is, tracking the line end.

(defn md/-raw! [^borrow r : rc<MdRen>
                b : StringBuilder
                s : String
                i : int
                end : int] : void
  (when (> end i)
    (do (string/-push-range! b s i end) (set! (.nl r) (md/-ends-nl? s i end)))))
;; ---- Raw HTML ------------------------------------------------------------------------
;;; md/-filtered-tag? -- internal: does the < at i of s open (or close) one of the nine tags the tag filter escapes?

(defn md/-filtered-tag? [s : String i : int end : int] : bool
  (let [ns    (if (= (md/-byte s (+ i 1)) 47) (+ i 2) (+ i 1))
        name  (md/-lower-run s ns end)
        after (+ ns (string/len name))
        c     (md/-byte s after)
        hit   (and (md/-word-in? "|title|textarea|style|xmp|iframe|noembed|noframes|script|plaintext|"
                     name)
                (or (md/-ws? c)
                  (= c 62)
                  (and (= c 47) (= (md/-byte s (+ after 1)) 62))))]
    (do (string/release name) hit)))
;;; md/-tag-filtered! -- internal: append [i, end) of s, escaping the < of a filtered tag.

(defn md/-tag-filtered! [^borrow r : rc<MdRen>
                         b : StringBuilder
                         s : String
                         i0 : int
                         end : int] : void
  (let [^mut i   i0
        ^mut run i0]
    (do
      (while (< i end)
        (do
          (when (and (= (string/byte-at s i) 60) (md/-filtered-tag? s i end))
            (do
              (string/-push-range! b s run i)
              (builder/push-cstr! b "&lt;")
              (set! run (+ i 1))))
          (set! i (+ i 1))))
      (string/-push-range! b s run end)
      (when (> end i0) (set! (.nl r) (md/-ends-nl? s i0 end))))))
;;; md/-raw-html! -- internal: append raw HTML [i, end) of s as the options say.

(defn md/-raw-html! [^borrow r : rc<MdRen>
                     b : StringBuilder
                     opts : MdHtmlOpts
                     s : String
                     i : int
                     end : int] : void
  (match (.raw-html opts)
    (MdRawPass)
    (md/-raw! r b s i end)
    (MdRawTagFilter)
    (md/-tag-filtered! r b s i end)
    (MdRawEscape)
    (md/-text! r b s i end)))
;; ---- Inlines ------------------------------------------------------------------------------
;;; md/-pool -- internal: the document's pool String i (borrowed).

(defn md/-pool [d : MdDoc i : int] : String (vec-get (.strs d) i))
;;; md/-pool-escaped! -- internal: append pool String v escaped, or nothing when v is -1.

(defn md/-pool-escaped! [d : MdDoc b : StringBuilder v : int] : void
  (when (>= v 0)
    (let [s (md/-pool d v)] (md/-push-escaped! b s 0 (string/len s)))))
;;; md/-has-pool? -- internal: is v a pool String that is not empty?

(defn md/-has-pool? [d : MdDoc v : int] : bool
  (and (>= v 0) (> (string/len (md/-pool d v)) 0)))
;;; md/-inl-open! -- internal: what comes before inline n's children; all of a leaf.  In alt text (alt) only text is written.

(defn md/-inl-open! [d : MdDoc
                     ^borrow r : rc<MdRen>
                     b : StringBuilder
                     opts : MdHtmlOpts
                     alt : bool
                     n : MdInl] : void
  (match (.kind n)
    (MdIText)
    (md/-text! r b (md/-pool d (.str n)) (.start n) (.end n))
    (MdISoftBreak)
    (do (builder/push-byte! b 10) (set! (.nl r) true))
    (MdIHardBreak)
    (do (when (not alt) (md/-out! r b "<br />")) (md/-cr! r b))
    (MdICode)
    (do
      (when (not alt) (md/-out! r b "<code>"))
      (md/-text! r b (md/-pool d (.str n)) (.start n) (.end n))
      (when (not alt) (md/-out! r b "</code>")))
    (MdIEmph)
    (when (not alt) (md/-out! r b "<em>"))
    (MdIStrong)
    (when (not alt) (md/-out! r b "<strong>"))
    (MdIStrike)
    (when (not alt) (md/-out! r b "<del>"))
    (MdILink)
    (when (not alt)
      (do
        (md/-out! r b "<a href=\"")
        (md/-pool-escaped! d b (.dest n))
        (when (md/-has-pool? d (.title n))
          (do (md/-out! r b "\" title=\"") (md/-pool-escaped! d b (.title n))))
        (md/-out! r b "\">")))
    (MdIImage)
    (when (not alt)
      (do
        (md/-out! r b "<img src=\"")
        (md/-pool-escaped! d b (.dest n))
        (md/-out! r b "\" alt=\"")))
    (MdIHtml)
    (if alt
      (md/-text! r b (md/-pool d (.str n)) (.start n) (.end n))
      (md/-raw-html! r b opts (md/-pool d (.str n)) (.start n) (.end n)))
    (MdIRoot)
    nil))
;;; md/-inl-close! -- internal: what comes after inline n's children.

(defn md/-inl-close! [d : MdDoc
                      ^borrow r : rc<MdRen>
                      b : StringBuilder
                      alt : bool
                      n : MdInl] : void
  (when (not alt)
    (match (.kind n)
      (MdIEmph)
      (md/-out! r b "</em>")
      (MdIStrong)
      (md/-out! r b "</strong>")
      (MdIStrike)
      (md/-out! r b "</del>")
      (MdILink)
      (md/-out! r b "</a>")
      (MdIImage)
      (do
        (when (md/-has-pool? d (.title n))
          (do (md/-out! r b "\" title=\"") (md/-pool-escaped! d b (.title n))))
        (md/-out! r b "\" />"))
      _
      nil)))
;;; md/-render-inl! -- internal: render inline i and everything under it; alt is true inside an image's alt text.

(defn md/-render-inl! [d : MdDoc
                       ^borrow r : rc<MdRen>
                       b : StringBuilder
                       opts : MdHtmlOpts
                       alt : bool
                       i : int] : void
  (let [n     (vec-get (.inls d) i)
        inner (or alt (match (.kind n) (MdIImage) true _ false))]
    (do
      (md/-inl-open! d r b opts alt n)
      (let [^mut c (.first-child n)]
        (while (>= c 0)
          (do
            (md/-render-inl! d r b opts inner c)
            (set! c (.next (vec-get (.inls d) c))))))
      (md/-inl-close! d r b alt n))))
;;; md/-inline! -- internal: a paragraph's or heading's inlines.

(defn md/-inline! [d : MdDoc
                   ^borrow r : rc<MdRen>
                   b : StringBuilder
                   opts : MdHtmlOpts
                   n : MdNode] : void
  (when (>= (.inl n) 0) (md/-render-inl! d r b opts false (.inl n))))
;; ---- Heading ids ---------------------------------------------------------------------------
;;; md/-block-next -- internal: the block after block i in document order: its first child, or the next sibling of it or of its nearest ancestor that has one; -1 at the end.

(defn md/-block-next [d : MdDoc i : int] : int
  (let [fc (.first-child (vec-get (.nodes d) i))]
    (if (>= fc 0)
      fc
      (let [^mut j  i
            ^mut r  -1
            ^mut go true]
        (do
          (while go
            (let [m (vec-get (.nodes d) j)]
              (cond (>= (.next m) 0)  (do (set! r (.next m)) (set! go false))
                    (< (.parent m) 0) (set! go false)
                    :else             (set! j (.parent m)))))
          r)))))
;;; md/-heading-nodes -- internal: the heading blocks, in document order.

(defn md/-heading-nodes [d : MdDoc] : (Vec int)
  (let [out    (md/-new-ints)
        ^mut i 0]
    (do
      (while (>= i 0)
        (do
          (match (.kind (vec-get (.nodes d) i))
            (MdKHeading)
            (vec-push! out i)
            _
            nil)
          (set! i (md/-block-next d i))))
      out)))
;;; md/-heading-html -- internal: heading block i's inlines as the renderer writes them, with opts.

(defn md/-heading-html [d : MdDoc opts : MdHtmlOpts i : int] : String
  (let [r (rc/of (MdRen true (md/-new-strs) 0))
        b (builder/new)]
    (do
      (md/-inline! d r b opts (vec-get (.nodes d) i))
      (vec-free (.ids r))
      (builder/finish b))))
;;; md/-heading-text-of -- internal: heading block i as text (md/-heading-plain of its HTML).

(defn md/-heading-text-of [d : MdDoc opts : MdHtmlOpts i : int collapse : bool] : String
  (let [h (md/-heading-html d opts i)
        t (md/-heading-plain h collapse)]
    (do (string/release h) t)))
;;; md/-heading-ids -- internal: the id opts gives each heading, in document order; empty under MdNoIds.

(defn md/-heading-ids [d : MdDoc opts : MdHtmlOpts] : (Vec String)
  (let [ids    (md/-new-strs)
        counts (md/-new-ints)
        hs     (md/-heading-nodes d)
        ^mut k 0]
    (do
      (match (.heading-ids opts)
        (MdNoIds)
        nil
        (MdSlugPython)
        (while (< k (vec-len hs))
          (let [t (md/-heading-text-of d opts (vec-get hs k) true)]
            (do
              (md/-add-python-id! ids (md/-slug-python t))
              (string/release t)
              (set! k (+ k 1)))))
        (MdSlugGitHub)
        (while (< k (vec-len hs))
          (let [t (md/-heading-text-of d opts (vec-get hs k) false)]
            (do
              (md/-add-github-id! ids counts (md/-slug-github t))
              (string/release t)
              (set! k (+ k 1))))))
      (vec-free counts)
      (vec-free hs)
      ids)))
;; ---- Blocks ------------------------------------------------------------------------------
;;; md/-tight-para? -- internal: is node i a paragraph in an item of a tight list (written without <p>)?

(defn md/-tight-para? [d : MdDoc i : int] : bool
  (let [p (.parent (vec-get (.nodes d) i))
        g (if (>= p 0) (.parent (vec-get (.nodes d) p)) -1)]
    (and (>= g 0)
      (md/-list? (.kind (vec-get (.nodes d) g)))
      (.tight (.list (vec-get (.nodes d) g))))))
;;; md/-text-of -- internal: node n's pool String (borrowed).

(defn md/-text-of [d : MdDoc n : MdNode] : String (vec-get (.strs d) (.text n)))
;;; md/-render-code! -- internal: <pre><code>, with a language class from the info string's first word.

(defn md/-render-code! [d : MdDoc
                        ^borrow r : rc<MdRen>
                        b : StringBuilder
                        n : MdNode] : void
  (do
    (md/-cr! r b)
    (md/-out! r b "<pre><code")
    (when (>= (.info n) 0)
      (let [info   (vec-get (.strs d) (.info n))
            ^mut w 0]
        (do
          (while (and (< w (string/len info))
                   (not (md/-ws? (string/byte-at info w))))
            (set! w (+ w 1)))
          (when (> w 0)
            (do
              (md/-out! r b " class=\"language-")
              (md/-push-escaped! b info 0 w)
              (md/-out! r b "\""))))))
    (md/-out! r b ">")
    (let [s (md/-text-of d n)] (md/-text! r b s 0 (string/len s)))
    (md/-out! r b "</code></pre>")
    (md/-cr! r b)))
;;; md/-render-heading! -- internal: <h1> to <h6>, with the next heading id when there is one and it is not empty.

(defn md/-render-heading! [d : MdDoc
                           ^borrow r : rc<MdRen>
                           b : StringBuilder
                           opts : MdHtmlOpts
                           n : MdNode] : void
  (do
    (md/-cr! r b)
    (md/-out! r b "<h")
    (builder/push-int! b (.level n))
    (when (< (.next r) (vec-len (.ids r)))
      (let [id (vec-get (.ids r) (.next r))]
        (do
          ;; GitHub's rule can give an empty id, which HTML does not allow.
          (when (> (string/len id) 0)
            (do
              (md/-out! r b " id=\"")
              (md/-push-escaped! b id 0 (string/len id))
              (md/-out! r b "\"")))
          (set! (.next r) (+ (.next r) 1)))))
    (md/-out! r b ">")
    (md/-inline! d r b opts n)
    (md/-out! r b "</h")
    (builder/push-int! b (.level n))
    (md/-out! r b ">")
    (md/-cr! r b)))
;;; md/-render-para! -- internal: <p>, left out in a tight list.

(defn md/-render-para! [d : MdDoc
                        ^borrow r : rc<MdRen>
                        b : StringBuilder
                        opts : MdHtmlOpts
                        i : int
                        n : MdNode] : void
  (if (md/-tight-para? d i)
    (md/-inline! d r b opts n)
    (do
      (md/-cr! r b)
      (md/-out! r b "<p>")
      (md/-inline! d r b opts n)
      (md/-out! r b "</p>")
      (md/-cr! r b))))
;;; md/-render-html-block! -- internal: an HTML block, as the raw-HTML option says.

(defn md/-render-html-block! [d : MdDoc
                              ^borrow r : rc<MdRen>
                              b : StringBuilder
                              opts : MdHtmlOpts
                              n : MdNode] : void
  (let [s (md/-text-of d n)]
    (do (md/-cr! r b) (md/-raw-html! r b opts s 0 (string/len s)) (md/-cr! r b))))
;;; md/-open-list! -- internal: <ul>, or <ol> with a start attribute unless it starts at 1.

(defn md/-open-list! [^borrow r : rc<MdRen> b : StringBuilder l : MdListData] : void
  (do
    (md/-cr! r b)
    (cond (not (.ordered l)) (md/-out! r b "<ul>")
          (= (.start l) 1)   (md/-out! r b "<ol>")
          :else              (do
                               (md/-out! r b "<ol start=\"")
                               (builder/push-int! b (.start l))
                               (md/-out! r b "\">")))
    (md/-cr! r b)))
;; ---- GFM tables and task items -----------------------------------------------------------
;;; md/-header-row? -- internal: is node i a table's header row?

(defn md/-header-row? [d : MdDoc i : int] : bool
  (and (match (.kind (vec-get (.nodes d) i)) (MdKTableRow) true _ false)
    (= (.level (vec-get (.nodes d) i)) 1)))
;;; md/-render-row-open! -- internal: <thead> before the header row, <tbody> before the first other row, then <tr>.

(defn md/-render-row-open! [d : MdDoc
                            ^borrow r : rc<MdRen>
                            b : StringBuilder
                            i : int
                            n : MdNode] : void
  (do
    (md/-cr! r b)
    (cond (= (.level n) 1)                                     (do
                                                                 (md/-out! r
                                                                   b
                                                                   "<thead>")
                                                                 (md/-cr! r b))
          (and (>= (.prev n) 0) (md/-header-row? d (.prev n))) (do
                                                                 (md/-out! r
                                                                   b
                                                                   "<tbody>")
                                                                 (md/-cr! r b))
          :else                                                nil)
    (md/-out! r b "<tr>")))
;;; md/-align-attr -- internal: a table cell's align attribute for alignment code a, or "".

(defn md/-align-attr [a : int] : cstr
  (cond (= a 1) " align=\"left\""
        (= a 2) " align=\"center\""
        (= a 3) " align=\"right\""
        :else   ""))
;;; md/-render-cell! -- internal: a <th> (in the header row) or <td> and its inlines.

(defn md/-render-cell! [d : MdDoc
                        ^borrow r : rc<MdRen>
                        b : StringBuilder
                        opts : MdHtmlOpts
                        n : MdNode] : void
  (let [th (md/-header-row? d (.parent n))]
    (do
      (md/-cr! r b)
      (md/-out! r b (if th "<th" "<td"))
      (md/-out! r b (md/-align-attr (.level n)))
      (md/-out! r b ">")
      (md/-inline! d r b opts n)
      (md/-out! r b (if th "</th>" "</td>")))))
;;; md/-render-item-open! -- internal: <li>, and a disabled checkbox for a task item.

(defn md/-render-item-open! [^borrow r : rc<MdRen> b : StringBuilder n : MdNode] : void
  (do
    (md/-out! r b "<li>")
    (cond (= (.level n) 1) (md/-out! r
                             b
                             "<input type=\"checkbox\" disabled=\"\" /> ")
          (= (.level n) 2) (md/-out! r
                             b
                             "<input type=\"checkbox\" checked=\"\" disabled=\"\" /> ")
          :else            nil)))
;;; md/-render-open! -- internal: what comes before node i's children; all of a leaf block.

(defn md/-render-open! [d : MdDoc
                        ^borrow r : rc<MdRen>
                        b : StringBuilder
                        opts : MdHtmlOpts
                        i : int] : void
  (let [n (vec-get (.nodes d) i)]
    (match (.kind n)
      (MdKParagraph)
      (md/-render-para! d r b opts i n)
      (MdKHeading)
      (md/-render-heading! d r b opts n)
      (MdKThematicBreak)
      (do (md/-cr! r b) (md/-out! r b "<hr />") (md/-cr! r b))
      (MdKBlockQuote)
      (do (md/-cr! r b) (md/-out! r b "<blockquote>") (md/-cr! r b))
      (MdKList)
      (md/-open-list! r b (.list n))
      (MdKItem)
      (md/-render-item-open! r b n)
      (MdKCodeBlock)
      (md/-render-code! d r b n)
      (MdKHtmlBlock)
      (md/-render-html-block! d r b opts n)
      (MdKTable)
      (do (md/-cr! r b) (md/-out! r b "<table>"))
      (MdKTableRow)
      (md/-render-row-open! d r b i n)
      (MdKTableCell)
      (md/-render-cell! d r b opts n)
      (MdKDocument)
      nil)))
;;; md/-render-close! -- internal: what comes after node i's children.

(defn md/-render-close! [d : MdDoc
                         ^borrow r : rc<MdRen>
                         b : StringBuilder
                         i : int] : void
  (let [n (vec-get (.nodes d) i)]
    (match (.kind n)
      (MdKBlockQuote)
      (do (md/-cr! r b) (md/-out! r b "</blockquote>") (md/-cr! r b))
      (MdKList)
      (do
        (md/-cr! r b)
        (md/-out! r b (if (.ordered (.list n)) "</ol>" "</ul>"))
        (md/-cr! r b))
      (MdKItem)
      (do (md/-out! r b "</li>") (md/-cr! r b))
      (MdKTableRow)
      (do
        (md/-cr! r b)
        (md/-out! r b "</tr>")
        (when (= (.level n) 1) (do (md/-cr! r b) (md/-out! r b "</thead>"))))
      (MdKTable)
      (do
        (when (and (>= (.first-child n) 0)
                (>= (.next (vec-get (.nodes d) (.first-child n))) 0))
          (do (md/-cr! r b) (md/-out! r b "</tbody>") (md/-cr! r b)))
        (md/-cr! r b)
        (md/-out! r b "</table>")
        (md/-cr! r b))
      _
      nil)))
;;; md/-render! -- internal: render node i and everything under it.

(defn md/-render! [d : MdDoc
                   ^borrow r : rc<MdRen>
                   b : StringBuilder
                   opts : MdHtmlOpts
                   i : int] : void
  (do
    (md/-render-open! d r b opts i)
    (let [^mut c (.first-child (vec-get (.nodes d) i))]
      (while (>= c 0)
        (do (md/-render! d r b opts c) (set! c (.next (vec-get (.nodes d) c))))))
    (md/-render-close! d r b i)))
;;; md/-render-doc -- internal: the HTML of document d.

(defn md/-render-doc [d : MdDoc opts : MdHtmlOpts] : String
  (let [r (rc/of (MdRen true (md/-heading-ids d opts) 0))
        b (builder/new)]
    (do
      (md/-render! d r b opts 0)
      (string/release-all (.ids r))
      (builder/finish b))))
