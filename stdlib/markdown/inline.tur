;;; markdown/inline -- the CommonMark inline parser: a block's text into inlines.
;;;
;;; A port of commonmark.js 0.31.2's inlines.js.  Each paragraph's and
;;; heading's text is scanned once, left to right, into a flat list of
;;; inlines under a root: text runs, code spans, breaks, autolinks, raw HTML,
;;; and a text inline for every run of * or _ and every [ or ![.  The runs go
;;; on a delimiter stack and the brackets on a bracket stack; a ] that closes
;;; a link or image moves what follows its bracket into the new inline, and
;;; the emphasis algorithm then pairs the delimiter runs (spec section 6.2)
;;; into emphasis and strong emphasis.
;;;
;;; Inlines live in the document's inline arena, linked by index.  A text
;;; inline is a byte range of a pool String, usually the block's trimmed
;;; text, so splitting a delimiter run off is moving an end index.
;;;
;;; Since: markdown-library-plan M2
;; The document types and the block parser.
(load "stdlib/markdown/block.tur")
;; ---- Types ---------------------------------------------------------------------
;;; MdDelim -- a run of * or _ on the delimiter stack: its byte, how many are left and were there, its text inline, its neighbours, and whether it can open or close emphasis.

(defstruct ^copy MdDelim
  [cc : int
   count : int
   orig : int
   node : int
   prev : int
   next : int
   can-open : bool
   can-close : bool])
;;; MdBracket -- a [ or ![ on the bracket stack: its text inline, the bracket and delimiter below it, where its [ is, and its state.

(defstruct ^copy MdBracket
  [node : int
   prev : int
   prev-delim : int
   index : int
   image : bool
   active : bool
   after : bool])
;;; MdIP -- the inline parser for one block: the document, the subject's pool index and length, the position, the root inline, the two stacks, and whether strikethrough, extended autolinks and math are on.

(defstruct MdIP
  [doc : MdDoc
   subj : int
   len : int
   pos : int
   root : int
   delims : int
   brackets : int
   dv : (Vec MdDelim)
   bv : (Vec MdBracket)
   tilde : bool
   autolinks : bool
   math : bool])
;;; md/-new-delims -- internal: an empty delimiter Vec.

(defn md/-new-delims [] : (Vec MdDelim) (vec-new))
;;; md/-new-brackets -- internal: an empty bracket Vec.

(defn md/-new-brackets [] : (Vec MdBracket) (vec-new))
;; ---- The inline arena -------------------------------------------------------------
;;; md/-inl-new! -- internal: a fresh detached inline of kind k over [start, end) of pool String str; its index.

(defn md/-inl-new! [v : (Vec MdInl) k : MdIKind str : int start : int end : int] : int
  (let [id (vec-len v)
        n  (MdInl k -1 -1 -1 -1 -1 str start end -1 -1)]
    (do (vec-push! v n) id)))
;;; md/-inl-append! -- internal: make inline c the last child of inline p.

(defn md/-inl-append! [v : (Vec MdInl) p : int c : int] : void
  (let [pn   (vec-get v p)
        last (.last-child pn)]
    (do
      (vec-set! v c (with (vec-get v c) [parent p prev last next -1]))
      (if (< last 0)
        (vec-set! v p (with pn [first-child c last-child c]))
        (do
          (vec-set! v last (with (vec-get v last) [next c]))
          (vec-set! v p (with pn [last-child c])))))))
;;; md/-inl-unlink! -- internal: take inline i out of its parent's children.

(defn md/-inl-unlink! [v : (Vec MdInl) i : int] : void
  (let [n (vec-get v i)
        p (.parent n)]
    (do
      (if (>= (.prev n) 0)
        (vec-set! v (.prev n) (with (vec-get v (.prev n)) [next (.next n)]))
        (when (>= p 0)
          (vec-set! v p (with (vec-get v p) [first-child (.next n)]))))
      (if (>= (.next n) 0)
        (vec-set! v (.next n) (with (vec-get v (.next n)) [prev (.prev n)]))
        (when (>= p 0)
          (vec-set! v p (with (vec-get v p) [last-child (.prev n)]))))
      (vec-set! v i (with (vec-get v i) [parent -1 prev -1 next -1])))))
;;; md/-inl-insert-after! -- internal: put detached inline b just after inline a.

(defn md/-inl-insert-after! [v : (Vec MdInl) a : int b : int] : void
  (let [an (vec-get v a)
        nx (.next an)
        p  (.parent an)]
    (do
      (vec-set! v b (with (vec-get v b) [parent p prev a next nx]))
      (vec-set! v a (with an [next b]))
      (if (>= nx 0)
        (vec-set! v nx (with (vec-get v nx) [prev b]))
        (when (>= p 0) (vec-set! v p (with (vec-get v p) [last-child b])))))))
;;; md/-inl-move-until! -- internal: move the inlines after from, up to (not including) until, or to the end when until is -1, into inline into.

(defn md/-inl-move-until! [v : (Vec MdInl) from : int until : int into : int] : void
  (let [^mut tmp (.next (vec-get v from))]
    (while (and (>= tmp 0) (not (= tmp until)))
      (let [nx (.next (vec-get v tmp))]
        (do (md/-inl-unlink! v tmp) (md/-inl-append! v into tmp) (set! tmp nx))))))
;; ---- The parser's view --------------------------------------------------------------
;;; md/-ip-s -- internal: the subject (borrowed).

(defn md/-ip-s [^borrow ip : rc<MdIP>] : String
  (vec-get (.strs (.doc ip)) (.subj ip)))
;;; md/-ip-c -- internal: the subject's byte at i, or -1 outside it.

(defn md/-ip-c [^borrow ip : rc<MdIP> i : int] : int
  (if (and (>= i 0) (< i (.len ip))) (string/byte-at (md/-ip-s ip) i) -1))
;;; md/-ip-v -- internal: the inline arena.

(defn md/-ip-v [^borrow ip : rc<MdIP>] : (Vec MdInl) (.inls (.doc ip)))
;;; md/-ip-add-str! -- internal: put s in the document's pool; its index.

(defn md/-ip-add-str! [^borrow ip : rc<MdIP> s : String] : int
  (let [strs (.strs (.doc ip))
        i    (vec-len strs)]
    (do (vec-push! strs s) i)))
;;; md/-ip-leaf! -- internal: append an inline of kind k over [start, end) of pool String str to the root; its index.

(defn md/-ip-leaf! [^borrow ip : rc<MdIP>
                    k : MdIKind
                    str : int
                    start : int
                    end : int] : int
  (let [v  (md/-ip-v ip)
        id (md/-inl-new! v k str start end)]
    (do (md/-inl-append! v (.root ip) id) id)))
;;; md/-ip-text! -- internal: append the subject's bytes [start, end) as a text inline; its index.

(defn md/-ip-text! [^borrow ip : rc<MdIP> start : int end : int] : int
  (md/-ip-leaf! ip (MdIText) (.subj ip) start end))
;;; md/-ip-own! -- internal: append an inline of kind k holding all of s, which the pool takes over; its index.

(defn md/-ip-own! [^borrow ip : rc<MdIP> k : MdIKind s : String] : int
  (let [n (string/len s)
        t (md/-ip-add-str! ip s)]
    (md/-ip-leaf! ip k t 0 n)))
;;; md/-ip-advance! -- internal: move the position on by n.

(defn md/-ip-advance! [^borrow ip : rc<MdIP> n : int] : void
  (set! (.pos ip) (+ (.pos ip) n)))
;;; md/-ip-run -- internal: how many of byte c repeat from i in the subject.

(defn md/-ip-run [^borrow ip : rc<MdIP> i : int c : int] : int
  (let [^mut j i]
    (do (while (= (md/-ip-c ip j) c) (set! j (+ j 1))) (- j i))))
;; ---- The delimiter stack ------------------------------------------------------------
;;; md/-dl -- internal: delimiter i.

(defn md/-dl [^borrow ip : rc<MdIP> i : int] : MdDelim (vec-get (.dv ip) i))
;;; md/-dl-put! -- internal: replace delimiter i.

(defn md/-dl-put! [^borrow ip : rc<MdIP> i : int d : MdDelim] : void
  (vec-set! (.dv ip) i d))
;;; md/-remove-delim! -- internal: take delimiter i off the stack.

(defn md/-remove-delim! [^borrow ip : rc<MdIP> i : int] : void
  (let [d (md/-dl ip i)]
    (do
      (when (>= (.prev d) 0)
        (md/-dl-put! ip (.prev d) (with (md/-dl ip (.prev d)) [next (.next d)])))
      (if (< (.next d) 0)
        (set! (.delims ip) (.prev d))
        (md/-dl-put! ip (.next d) (with (md/-dl ip (.next d)) [prev (.prev d)]))))))
;;; md/-remove-delims-between! -- internal: drop the delimiters strictly between bottom and top.

(defn md/-remove-delims-between! [^borrow ip : rc<MdIP> bottom : int top : int] : void
  (when (not (= (.next (md/-dl ip bottom)) top))
    (do
      (md/-dl-put! ip bottom (with (md/-dl ip bottom) [next top]))
      (md/-dl-put! ip top (with (md/-dl ip top) [prev bottom])))))
;;; md/-push-delim! -- internal: push a delimiter run onto the stack.

(defn md/-push-delim! [^borrow ip : rc<MdIP>
                       cc : int
                       n : int
                       node : int
                       can-open : bool
                       can-close : bool] : void
  (let [id  (vec-len (.dv ip))
        top (.delims ip)
        d   (MdDelim cc n n node top -1 can-open can-close)]
    (do
      (vec-push! (.dv ip) d)
      (when (>= top 0) (md/-dl-put! ip top (with (md/-dl ip top) [next id])))
      (set! (.delims ip) id))))
;; ---- Emphasis (spec section 6.2, "process emphasis") -----------------------------------
;;; md/-bottom-index -- internal: which openers-bottom slot a closer uses: by byte, whether it can also open, and its original length mod 3 (a ~ closer, as cmark-gfm keeps it, by its length mod 3 alone).

(defn md/-bottom-index [c : MdDelim] : int
  (if (= (.cc c) 126)
    (+ 14 (mod (.orig c) 3))
    (+ (if (= (.cc c) 95) 2 8) (if (.can-open c) 3 0) (mod (.orig c) 3))))
;;; md/-find-opener -- internal: the nearest opener below closer that can pair with it, stopping at stop1 or stop2, or -1.

(defn md/-find-opener [^borrow ip : rc<MdIP>
                       closer : int
                       stop1 : int
                       stop2 : int] : int
  (let [c        (md/-dl ip closer)
        ^mut o   (.prev c)
        ^mut hit -1]
    (do
      (while (and (< hit 0) (>= o 0) (not (= o stop1)) (not (= o stop2)))
        (let [od  (md/-dl ip o)
              odd (and (or (.can-open c) (.can-close od))
                    (not (= (mod (.orig c) 3) 0))
                    (= (mod (+ (.orig od) (.orig c)) 3) 0))]
          (if (and (= (.cc od) (.cc c)) (.can-open od) (not odd))
            (set! hit o)
            (set! o (.prev od)))))
      hit)))
;;; md/-pair-delims! -- internal: turn the matched opener and closer into emphasis or strong emphasis; the closer to look at next.

(defn md/-pair-delims! [^borrow ip : rc<MdIP> opener : int closer : int] : int
  (let [o    (md/-dl ip opener)
        c    (md/-dl ip closer)
        use  (if (and (>= (.count c) 2) (>= (.count o) 2)) 2 1)
        v    (md/-ip-v ip)
        oi   (.node o)
        ci   (.node c)
        emph (md/-inl-new! v (if (= use 1) (MdIEmph) (MdIStrong)) -1 0 0)]
    (do
      (md/-dl-put! ip opener (with o [count (- (.count o) use)]))
      (md/-dl-put! ip closer (with c [count (- (.count c) use)]))
      (vec-set! v oi (with (vec-get v oi) [end (- (.end (vec-get v oi)) use)]))
      (vec-set! v ci (with (vec-get v ci) [end (- (.end (vec-get v ci)) use)]))
      (md/-inl-move-until! v oi ci emph)
      (md/-inl-insert-after! v oi emph)
      (md/-remove-delims-between! ip opener closer)
      (when (= (.count (md/-dl ip opener)) 0)
        (do (md/-inl-unlink! v oi) (md/-remove-delim! ip opener)))
      (if (= (.count (md/-dl ip closer)) 0)
        (let [nx (.next (md/-dl ip closer))]
          (do (md/-inl-unlink! v ci) (md/-remove-delim! ip closer) nx))
        closer))))
;;; md/-pair-tilde! -- internal: a ~ opener and closer: strikethrough when they are the same length (cmark-gfm's rule), either way taking every delimiter from the closer down to the opener off the stack; the closer to look at next.

(defn md/-pair-tilde! [^borrow ip : rc<MdIP> opener : int closer : int] : int
  (let [o   (md/-dl ip opener)
        c   (md/-dl ip closer)
        res (.next c)
        v   (md/-ip-v ip)
        oi  (.node o)
        ci  (.node c)]
    (do
      (when (= (.count o) (.count c))
        (let [del (md/-inl-new! v (MdIStrike) -1 0 0)]
          (do
            (md/-inl-move-until! v oi ci del)
            (md/-inl-insert-after! v oi del)
            (md/-inl-unlink! v oi)
            (md/-inl-unlink! v ci))))
      (let [^mut dl closer]
        (while (and (>= dl 0) (not (= dl opener)))
          (let [pv (.prev (md/-dl ip dl))]
            (do (md/-remove-delim! ip dl) (set! dl pv)))))
      (md/-remove-delim! ip opener)
      res)))
;;; md/-emph-step! -- internal: handle the closer at closer; the next closer to look at.

(defn md/-emph-step! [^borrow ip : rc<MdIP>
                      bottoms : (Vec int)
                      stack-bottom : int
                      closer : int] : int
  (let [c      (md/-dl ip closer)
        slot   (md/-bottom-index c)
        opener (md/-find-opener ip closer stack-bottom (vec-get bottoms slot))]
    (if (>= opener 0)
      (if (= (.cc c) 126)
        (md/-pair-tilde! ip opener closer)
        (md/-pair-delims! ip opener closer))
      (let [nx (.next c)]
        (do
          (vec-set! bottoms slot (.prev c))
          (when (not (.can-open c)) (md/-remove-delim! ip closer))
          nx)))))
;;; md/-new-bottoms -- internal: the openers-bottom slots, each stack-bottom: fourteen for * and _, three for ~.

(defn md/-new-bottoms [stack-bottom : int] : (Vec int)
  (let [v      (md/-new-ints)
        ^mut i 0]
    (do (while (< i 17) (do (vec-push! v stack-bottom) (set! i (+ i 1)))) v)))
;;; md/-process-emphasis! -- internal: pair the delimiter runs above stack-bottom into emphasis, then drop them all.

(defn md/-process-emphasis! [^borrow ip : rc<MdIP> stack-bottom : int] : void
  (let [bottoms     (md/-new-bottoms stack-bottom)
        ^mut closer (.delims ip)]
    (do
      (while (and (>= closer 0)
               (not (= (.prev (md/-dl ip closer)) stack-bottom)))
        (set! closer (.prev (md/-dl ip closer))))
      (while (>= closer 0)
        (if (.can-close (md/-dl ip closer))
          (set! closer (md/-emph-step! ip bottoms stack-bottom closer))
          (set! closer (.next (md/-dl ip closer)))))
      (while (and (>= (.delims ip) 0) (not (= (.delims ip) stack-bottom)))
        (md/-remove-delim! ip (.delims ip)))
      (vec-free bottoms))))
;; ---- Brackets, links and images (spec sections 6.3 and 6.4) ----------------------------------
;;; md/-bk -- internal: bracket i.

(defn md/-bk [^borrow ip : rc<MdIP> i : int] : MdBracket (vec-get (.bv ip) i))
;;; md/-add-bracket! -- internal: push a [ (or ![) whose text inline is node and whose [ is at index.

(defn md/-add-bracket! [^borrow ip : rc<MdIP>
                        node : int
                        index : int
                        image : bool] : void
  (let [top (.brackets ip)
        id  (vec-len (.bv ip))
        b   (MdBracket node top (.delims ip) index image true false)]
    (do
      (when (>= top 0)
        (vec-set! (.bv ip) top (with (md/-bk ip top) [after true])))
      (vec-push! (.bv ip) b)
      (set! (.brackets ip) id))))
;;; md/-remove-bracket! -- internal: pop the bracket stack.

(defn md/-remove-bracket! [^borrow ip : rc<MdIP>] : void
  (set! (.brackets ip) (.prev (md/-bk ip (.brackets ip)))))
;;; md/-deactivate-links! -- internal: no links in links -- mark every [ still on the stack inactive.

(defn md/-deactivate-links! [^borrow ip : rc<MdIP>] : void
  (let [^mut b (.brackets ip)]
    (while (>= b 0)
      (let [bk (md/-bk ip b)]
        (do
          (when (not (.image bk))
            (vec-set! (.bv ip) b (with bk [active false])))
          (set! b (.prev bk)))))))
;;; md/-find-doc-ref -- internal: the reference of d whose normalised label is label, or -1.

(defn md/-find-doc-ref [d : MdDoc label : String] : int
  (let [refs     (.refs d)
        ^mut i   0
        ^mut hit -1]
    (do
      (while (and (< hit 0) (< i (vec-len refs)))
        (do
          (when (string/eq? (vec-get (.strs d) (.label (vec-get refs i))) label)
            (set! hit i))
          (set! i (+ i 1))))
      hit)))
;;; md/-lookup-ref -- internal: the reference whose label is [a, b) of the subject (brackets included), or -1.

(defn md/-lookup-ref [^borrow ip : rc<MdIP> a : int b : int] : int
  (let [label (md/-normalize-label (md/-ip-s ip) a b)
        r     (if (= (string/len label) 0)
                -1
                (md/-find-doc-ref (.doc ip) label))]
    (do (string/release label) r)))
;;; md/-make-link! -- internal: the link or image for the bracket at top, holding everything after its [.

(defn md/-make-link! [^borrow ip : rc<MdIP> top : int dest : int title : int] : void
  (let [bk   (md/-bk ip top)
        v    (md/-ip-v ip)
        node (md/-inl-new! v (if (.image bk) (MdIImage) (MdILink)) -1 0 0)]
    (do
      (vec-set! v node (with (vec-get v node) [dest dest title title]))
      (md/-inl-move-until! v (.node bk) -1 node)
      (md/-inl-append! v (.root ip) node)
      (md/-process-emphasis! ip (.prev-delim bk))
      (md/-remove-bracket! ip)
      (md/-inl-unlink! v (.node bk))
      (when (not (.image bk)) (md/-deactivate-links! ip)))))
;;; md/-inline-link-end -- internal: the end of an inline link's ( destination title ) at i, or -1; the destination and title bounds go in out.

(defn md/-inline-link-end [^borrow ip : rc<MdIP> i : int out : (Vec int)] : int
  (let [s  (md/-ip-s ip)
        n  (.len ip)
        p  (md/-spnl s (+ i 1) n)
        de (md/-scan-dest s p n)]
    (if (< de 0)
      -1
      (let [q  (md/-spnl s de n)
            te (if (and (> q de) (md/-ws? (md/-byte s (- q 1))))
                 (md/-scan-title s q n)
                 -1)
            r  (if (>= te 0) (md/-spnl s te n) q)]
        (if (= (md/-byte s r) 41)
          (do
            (vec-push! out (md/-dest-inner-start s p))
            (vec-push! out (md/-dest-inner-end s p de))
            (vec-push! out (if (>= te 0) (+ q 1) -1))
            (vec-push! out (if (>= te 0) (- te 1) -1))
            (+ r 1))
          -1)))))
;;; md/-close-inline! -- internal: a ] followed by an inline link's ( ... ); whether it made the link.

(defn md/-close-inline! [^borrow ip : rc<MdIP> top : int] : bool
  (if (not (= (md/-ip-c ip (.pos ip)) 40))
    false
    (let [out (md/-new-ints)
          e   (md/-inline-link-end ip (.pos ip) out)]
      (if (< e 0)
        (do (vec-free out) false)
        (let [s     (md/-ip-s ip)
              dest  (md/-ip-add-str! ip
                      (md/-dest-string s (vec-get out 0) (vec-get out 1)))
              title (if (< (vec-get out 2) 0)
                      -1
                      (md/-ip-add-str! ip
                        (md/-unescape s (vec-get out 2) (vec-get out 3))))]
          (do
            (vec-free out)
            (set! (.pos ip) e)
            (md/-make-link! ip top dest title)
            true))))))
;;; md/-close-ref! -- internal: a ] followed by a full, collapsed or shortcut reference; whether it made the link.

(defn md/-close-ref! [^borrow ip : rc<MdIP> top : int startpos : int] : bool
  (let [bk  (md/-bk ip top)
        le  (md/-scan-label (md/-ip-s ip) (.pos ip) (.len ip))
        n   (if (< le 0) 0 (- le (.pos ip)))
        a   (cond (> n 2) (.pos ip) (not (.after bk)) (.index bk) :else -1)
        b   (cond (> n 2) le (not (.after bk)) startpos :else -1)
        ref (if (< a 0) -1 (md/-lookup-ref ip a b))]
    (if (< ref 0)
      false
      (let [r (vec-get (.refs (.doc ip)) ref)]
        (do
          (when (> n 0) (set! (.pos ip) le))
          (md/-make-link! ip top (.dest r) (.title r))
          true)))))
;;; md/-close-literal! -- internal: append the ] just before startpos as text.

(defn md/-close-literal! [^borrow ip : rc<MdIP> startpos : int] : void
  (do (md/-ip-text! ip (- startpos 1) startpos) nil))
;;; md/-close-link! -- internal: a ] after an active bracket: make the inline link or the reference link it closes; whether it made one.

(defn md/-close-link! [^borrow ip : rc<MdIP> top : int startpos : int] : bool
  (or (md/-close-inline! ip top) (md/-close-ref! ip top startpos)))
;;; md/-parse-close-bracket! -- internal: a ] -- a link or image when a [ before it matches, else a literal ].

(defn md/-parse-close-bracket! [^borrow ip : rc<MdIP>] : void
  (let [startpos (+ (.pos ip) 1)
        top      (.brackets ip)]
    (do
      (set! (.pos ip) startpos)
      (cond (< top 0)                         (md/-close-literal! ip startpos)
            (not (.active (md/-bk ip top)))   (do
                                                (md/-close-literal! ip startpos)
                                                (md/-remove-bracket! ip))
            (md/-close-link! ip top startpos) nil
            :else                             (do
                                                (md/-remove-bracket! ip)
                                                (set! (.pos ip) startpos)
                                                (md/-close-literal! ip startpos))))))
;; ---- The other inline starts -------------------------------------------------------------
;;; md/-strip-final-spaces! -- internal: drop the trailing spaces of text inline i; whether there were two or more (a hard break).

(defn md/-strip-final-spaces! [^borrow ip : rc<MdIP> i : int] : bool
  (let [v (md/-ip-v ip)]
    (if (or (< i 0) (not (match (.kind (vec-get v i)) (MdIText) true _ false)))
      false
      (let [n (vec-get v i)
            s (vec-get (.strs (.doc ip)) (.str n))]
        (if (or (<= (.end n) (.start n))
              (not (= (string/byte-at s (- (.end n) 1)) 32)))
          false
          (let [hard   (and (> (- (.end n) 1) (.start n))
                         (= (string/byte-at s (- (.end n) 2)) 32))
                ^mut e (.end n)]
            (do
              (while (and (> e (.start n)) (= (string/byte-at s (- e 1)) 32))
                (set! e (- e 1)))
              (vec-set! v i (with n [end e]))
              hard)))))))
;;; md/-parse-newline! -- internal: a line ending: a hard break after two spaces, else a soft break; the next line's leading spaces go.

(defn md/-parse-newline! [^borrow ip : rc<MdIP>] : void
  (let [last (.last-child (vec-get (md/-ip-v ip) (.root ip)))
        hard (md/-strip-final-spaces! ip last)]
    (do
      (md/-ip-advance! ip 1)
      (md/-ip-leaf! ip (if hard (MdIHardBreak) (MdISoftBreak)) -1 0 0)
      (while (= (md/-ip-c ip (.pos ip)) 32) (md/-ip-advance! ip 1)))))
;;; md/-parse-backslash! -- internal: a backslash: a hard break before a line ending, an escaped punctuation character, or itself.

(defn md/-parse-backslash! [^borrow ip : rc<MdIP>] : void
  (let [p (+ (.pos ip) 1)
        c (md/-ip-c ip p)]
    (cond (= c 10)       (do
                           (set! (.pos ip) (+ p 1))
                           (md/-ip-leaf! ip (MdIHardBreak) -1 0 0)
                           nil)
          (md/-punct? c) (do
                           (md/-ip-text! ip p (+ p 1))
                           (set! (.pos ip) (+ p 1)))
          :else          (do (md/-ip-text! ip (- p 1) p) (set! (.pos ip) p)))))
;;; md/-closing-ticks -- internal: where a run of exactly n backticks starts at or after i, or -1.

(defn md/-closing-ticks [^borrow ip : rc<MdIP> i0 : int n : int] : int
  (let [^mut i   i0
        ^mut hit -1]
    (do
      (while (and (< hit 0) (< i (.len ip)))
        (if (= (md/-ip-c ip i) 96)
          (let [run (md/-ip-run ip i 96)]
            (if (= run n) (set! hit i) (set! i (+ i run))))
          (set! i (+ i 1))))
      hit)))
;;; md/-code-sp? -- internal: does byte c count as a space in a code span (a space, or a line ending, which becomes one)?

(defn md/-code-sp? [c : int] : bool (or (= c 32) (= c 10)))
;;; md/-code-all-sp? -- internal: is every byte of [a, b) of s a code-span space?

(defn md/-code-all-sp? [s : String a : int b : int] : bool
  (let [^mut i a]
    (do
      (while (and (< i b) (md/-code-sp? (string/byte-at s i))) (set! i (+ i 1)))
      (>= i b))))
;;; md/-code-contents -- internal: a code span's [a, b) of s: line endings as spaces, and one space stripped from each end when both ends have one and it is not all spaces.

(defn md/-code-contents [s : String a : int b : int] : String
  (let [strip  (and (> b a)
                 (not (md/-code-all-sp? s a b))
                 (md/-code-sp? (string/byte-at s a))
                 (md/-code-sp? (string/byte-at s (- b 1))))
        x      (if strip (+ a 1) a)
        y      (if strip (- b 1) b)
        out    (builder/new)
        ^mut i x]
    (do
      (while (< i y)
        (let [c (string/byte-at s i)]
          (do (builder/push-byte! out (if (= c 10) 32 c)) (set! i (+ i 1)))))
      (builder/finish out))))
;;; md/-parse-backticks! -- internal: a run of backticks: a code span when a run of the same length closes it, else literal backticks.

(defn md/-parse-backticks! [^borrow ip : rc<MdIP>] : void
  (let [start (.pos ip)
        n     (md/-ip-run ip start 96)
        after (+ start n)
        close (md/-closing-ticks ip after n)]
    (if (< close 0)
      (do (md/-ip-text! ip start after) (set! (.pos ip) after))
      (do
        (md/-ip-own! ip (MdICode) (md/-code-contents (md/-ip-s ip) after close))
        (set! (.pos ip) (+ close n))))))
;; ---- Math (markdown-library-plan M5) ----------------------------------------------------------
;; With math on, $...$ is an inline formula and $$...$$ a display one.  The
;; rules are the notebook spice's, whose parser this replaces: the opening $
;; has neither whitespace nor a digit after it, so "$5 and $10" stays text
;; (a formula that starts with a digit is written ${2^n}$), and the closing
;; $ has no whitespace before it.  A $$ formula may have spaces inside its
;; delimiters.  Neither crosses a line ending, a backslash pair never closes
;; one, and what is inside is kept as written, TeX's backslashes and all.
;;; md/-math-ws? -- internal: is c a space, a tab or a line ending, or past the subject's end (-1)?

(defn md/-math-ws? [c : int] : bool (or (< c 0) (= c 32) (= c 9) (= c 10)))
;;; md/-math-closes-at? -- internal: does the closing $ (n = 1) or $$ (n = 2) of a formula whose contents start at a sit at j?

(defn md/-math-closes-at? [^borrow ip : rc<MdIP> a : int n : int j : int] : bool
  (and (= (md/-ip-c ip j) 36)
    (if (= n 2)
      (= (md/-ip-c ip (+ j 1)) 36)
      (and (> j a) (not (md/-math-ws? (md/-ip-c ip (- j 1))))))))
;;; md/-math-close -- internal: where the closing $ (n = 1) or $$ (n = 2) of a formula whose contents start at a is, or -1.

(defn md/-math-close [^borrow ip : rc<MdIP> a : int n : int] : int
  (let [^mut j   a
        ^mut hit -1]
    (do
      (while (and (< hit 0) (< j (.len ip)) (not (= (md/-ip-c ip j) 10)))
        (cond (= (md/-ip-c ip j) 92)         (set! j (+ j 2))
              (md/-math-closes-at? ip a n j) (set! hit j)
              :else                          (set! j (+ j 1))))
      hit)))
;;; md/-parse-dollar! -- internal: a $ -- an inline formula, a display one at $$, or (false) neither.

(defn md/-parse-dollar! [^borrow ip : rc<MdIP>] : bool
  (let [start (.pos ip)
        n     (if (= (md/-ip-c ip (+ start 1)) 36) 2 1)
        a     (+ start n)
        c     (md/-ip-c ip a)
        z     (cond (= n 2)                              (md/-math-close ip a n)
                    (or (md/-math-ws? c) (md/-digit? c)) -1
                    :else                                (md/-math-close ip a n))
        s     (md/-ip-s ip)
        ia    (if (and (= n 2) (>= z 0)) (md/-skip-ws s a z) a)
        iz    (if (and (= n 2) (>= z 0)) (md/-trim-end-index s ia z) z)]
    (if (and (>= z 0) (> iz ia))
      (do
        (md/-ip-leaf! ip
          (if (= n 2) (MdIMathDisplay) (MdIMath))
          (.subj ip)
          ia
          iz)
        (set! (.pos ip) (+ z n))
        true)
      false)))
;;; md/-cp-before -- internal: the code point before byte i of s, or a line feed at the start.

(defn md/-cp-before [s : String i : int] : int
  (match (utf8/decode-before s i) (Some p) (char->int (pair-fst p)) (None) 10))
;;; md/-cp-at -- internal: the code point at byte i of s, or a line feed at the end.

(defn md/-cp-at [s : String i : int] : int
  (match (utf8/decode-at s i) (Some p) (char->int (pair-fst p)) (None) 10))
;;; md/-cp-before-skip -- internal: the code point before byte i of s as cmark-gfm reads it with strikethrough on, past any ~ to the left; a line feed at the start, or when a ~ or a broken sequence is all there is.

(defn md/-cp-before-skip [s : String i : int] : int
  (if (<= i 0)
    10
    (let [^mut j (- i 1)]
      (do
        (while (and (> j 0)
                 (let [b (string/byte-at s j)]
                   (or (= b 126) (and (>= b 128) (< b 192)))))
          (set! j (- j 1)))
        (if (or (< (md/-utf8-next s j i) 0) (= (string/byte-at s j) 126))
          10
          (md/-cp-at s j))))))
;;; md/-cp-after-skip -- internal: the code point at byte i of s (which is n bytes long) as cmark-gfm reads it with strikethrough on, past any ~; a line feed at the end or at a broken sequence.

(defn md/-cp-after-skip [s : String i0 : int n : int] : int
  (let [^mut i i0]
    (do
      (while (and (< i n) (= (string/byte-at s i) 126)) (set! i (+ i 1)))
      (if (or (>= i n) (< (md/-utf8-next s i n) 0)) 10 (md/-cp-at s i)))))
;;; md/-parse-delim! -- internal: a run of *, _ or ~: a text inline, and a delimiter when it can open or close (the flanking rules, spec 6.2); with strikethrough on, a ~ next to the run is looked past, as cmark-gfm does.

(defn md/-parse-delim! [^borrow ip : rc<MdIP> cc : int] : void
  (let [start  (.pos ip)
        n      (md/-ip-run ip start cc)
        s      (md/-ip-s ip)
        before (if (.tilde ip)
                 (md/-cp-before-skip s start)
                 (md/-cp-before s start))
        after  (if (.tilde ip)
                 (md/-cp-after-skip s (+ start n) (.len ip))
                 (md/-cp-at s (+ start n)))
        aw     (unicode/space? (int->char after))
        ap     (unicode/punct? (int->char after))
        bw     (unicode/space? (int->char before))
        bp     (unicode/punct? (int->char before))
        left   (and (not aw) (or (not ap) bw bp))
        right  (and (not bw) (or (not bp) aw ap))
        opens  (if (= cc 95) (and left (or (not right) bp)) left)
        closes (if (= cc 95) (and right (or (not left) ap)) right)
        node   (md/-ip-text! ip start (+ start n))]
    (do
      (set! (.pos ip) (+ start n))
      (when (and (or opens closes) (or (not (= cc 126)) (= n 1) (= n 2)))
        (md/-push-delim! ip cc n node opens closes)))))
;;; md/-parse-open-bracket! -- internal: a [, which may open a link.

(defn md/-parse-open-bracket! [^borrow ip : rc<MdIP>] : void
  (let [start (.pos ip)
        node  (md/-ip-text! ip start (+ start 1))]
    (do (set! (.pos ip) (+ start 1)) (md/-add-bracket! ip node start false))))
;;; md/-parse-bang! -- internal: a !, which before a [ may open an image.

(defn md/-parse-bang! [^borrow ip : rc<MdIP>] : void
  (let [start (.pos ip)]
    (if (= (md/-ip-c ip (+ start 1)) 91)
      (let [node (md/-ip-text! ip start (+ start 2))]
        (do
          (set! (.pos ip) (+ start 2))
          (md/-add-bracket! ip node (+ start 1) true)))
      (do (md/-ip-text! ip start (+ start 1)) (set! (.pos ip) (+ start 1))))))
;;; md/-autolink! -- internal: append the autolink [i, e) of the subject, its destination prefixed by pre (mailto: for an email address).

(defn md/-autolink! [^borrow ip : rc<MdIP> i : int e : int pre : cstr] : void
  (let [s    (md/-ip-s ip)
        b    (builder/new)
        v    (md/-ip-v ip)
        node (md/-inl-new! v (MdILink) -1 0 0)
        text (md/-inl-new! v (MdIText) (.subj ip) (+ i 1) (- e 1))]
    (do
      (builder/push-cstr! b pre)
      (string/-push-range! b s (+ i 1) (- e 1))
      (let [raw  (builder/finish b)
            dest (md/-ip-add-str! ip (md/-normalize-uri raw))]
        (do
          (string/release raw)
          (vec-set! v node (with (vec-get v node) [dest dest]))))
      (md/-inl-append! v node text)
      (md/-inl-append! v (.root ip) node)
      (set! (.pos ip) e))))
;;; md/-parse-lt! -- internal: a < -- an email or URI autolink, raw HTML, or (false) none of them.

(defn md/-parse-lt! [^borrow ip : rc<MdIP>] : bool
  (let [s  (md/-ip-s ip)
        i  (.pos ip)
        n  (.len ip)
        em (md/-email-autolink-end s i n)
        ur (if (< em 0) (md/-uri-autolink-end s i n) -1)
        ht (if (and (< em 0) (< ur 0)) (md/-html-tag-end s i n) -1)]
    (cond (>= em 0) (do (md/-autolink! ip i em "mailto:") true)
          (>= ur 0) (do (md/-autolink! ip i ur "") true)
          (>= ht 0) (do
                      (md/-ip-leaf! ip (MdIHtml) (.subj ip) i ht)
                      (set! (.pos ip) ht)
                      true)
          :else     false)))
;;; md/-parse-entity! -- internal: a character reference, appended as its text; whether there was one.

(defn md/-parse-entity! [^borrow ip : rc<MdIP>] : bool
  (let [b (builder/new)
        e (md/-push-entity! b (md/-ip-s ip) (.pos ip) (.len ip))]
    (if (> e 0)
      (do (md/-ip-own! ip (MdIText) (builder/finish b)) (set! (.pos ip) e) true)
      (do (string/release (builder/finish b)) false))))
;; ---- GFM extended autolinks (markdown-library-plan M3) --------------------------------------
;; A port of cmark-gfm's extensions/autolink.c: www. and scheme:// links found
;; while scanning (at a w or a :), and email addresses found in the text
;; afterwards.  The byte rules, quirks included, are cmark-gfm's.
;;; md/-al-alpha? -- internal: an ASCII letter?

(defn md/-al-alpha? [c : int] : bool
  (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))
;;; md/-al-alnum? -- internal: an ASCII letter or digit?

(defn md/-al-alnum? [c : int] : bool
  (or (md/-al-alpha? c) (and (>= c 48) (<= c 57))))
;;; md/-al-space? -- internal: cmark's isspace: space, tab, LF, VT, FF or CR.

(defn md/-al-space? [c : int] : bool (or (= c 32) (and (>= c 9) (<= c 13))))
;;; md/-hostchar? -- internal: is the character at byte i of s (before end) a valid host character: neither Unicode space nor punctuation?

(defn md/-hostchar? [s : String i : int end : int] : bool
  (and (< i end)
    (match (utf8/decode-at s i)
      (Some p)
      (let [c (pair-fst p)]
        (and (not (unicode/space? c)) (not (unicode/punct? c))))
      (None)
      false)))
;;; md/-al-trail? -- internal: is c one of the bytes autolink_delim trims off a link's end: ? ! . , : * _ ~ ' and ".

(defn md/-al-trail? [c : int] : bool
  (or (= c 63)
    (= c 33)
    (= c 46)
    (= c 44)
    (= c 58)
    (= c 42)
    (= c 95)
    (= c 126)
    (= c 39)
    (= c 34)))
;;; md/-al-entity-cut -- internal: the link [a, a+n) of s ends in ;: its length without the &name; it ends in, or with only the ; gone.

(defn md/-al-entity-cut [s : String a : int n : int] : int
  (if (< n 2)
    (- n 1)
    (let [^mut e (- n 2)]
      (do
        (while (and (> e 0) (md/-al-alpha? (string/byte-at s (+ a e))))
          (set! e (- e 1)))
        (if (and (< e (- n 2)) (= (string/byte-at s (+ a e)) 38)) e (- n 1))))))
;;; md/-al-delim -- internal: cmark-gfm's autolink_delim: the link [a, a+n) of s cut at a <, then trimmed of trailing punctuation, an unmatched ) and an entity-like &name;; its new length.

(defn md/-al-delim [s : String a : int n0 : int] : int
  (let [^mut n       n0
        ^mut i       0
        ^mut opening 0
        ^mut closing 0
        ^mut go      true]
    (do
      (while (< i n)
        (let [c (string/byte-at s (+ a i))]
          (cond (= c 60) (do (set! n i) (set! i n))
                (= c 40) (do (set! opening (+ opening 1)) (set! i (+ i 1)))
                (= c 41) (do (set! closing (+ closing 1)) (set! i (+ i 1)))
                :else    (set! i (+ i 1)))))
      (while (and go (> n 0))
        (let [c (string/byte-at s (+ a (- n 1)))]
          (cond (and (= c 41) (<= closing opening)) (set! go false)
                (= c 41)                            (do
                                                      (set! closing
                                                        (- closing 1))
                                                      (set! n (- n 1)))
                (md/-al-trail? c)                   (set! n (- n 1))
                (= c 59)                            (set! n
                                                      (md/-al-entity-cut s a n))
                :else                               (set! go false))))
      n)))
;;; md/-al-domain-stop? -- internal: does a domain end at byte i of s (before end): neither a host character nor a -?

(defn md/-al-domain-stop? [s : String i : int end : int] : bool
  (and (not (= (string/byte-at s i) 45)) (not (md/-hostchar? s i end))))
;;; md/-check-domain -- internal: cmark-gfm's check_domain over [a, a+size) of s: the length of the domain there, or 0 when an underscore sits in its last two labels or (unless allow-short) it has no dot.

(defn md/-check-domain [s : String a : int size : int allow-short : bool] : int
  (let [^mut i   1
        ^mut np  0
        ^mut us1 0
        ^mut us2 0
        ^mut go  true]
    (do
      (while (and go (< i (- size 1)))
        (do
          (when (and (= (string/byte-at s (+ a i)) 92) (< i (- size 2)))
            (set! i (+ i 1)))
          (let [c (string/byte-at s (+ a i))]
            (cond (= c 95)                                   (set! us2
                                                               (+ us2 1))
                  (= c 46)                                   (do
                                                               (set! us1 us2)
                                                               (set! us2 0)
                                                               (set! np
                                                                 (+ np 1)))
                  (md/-al-domain-stop? s (+ a i) (+ a size)) (set! go false)
                  :else                                      nil))
          (when go (set! i (+ i 1)))))
      (cond (and (or (> us1 0) (> us2 0)) (<= np 10)) 0
            allow-short                               i
            (> np 0)                                  i
            :else                                     0))))
;;; md/-al-extend -- internal: from n, past every byte of [a, a+size) of s that is not a space or a <.

(defn md/-al-extend [s : String a : int n0 : int size : int] : int
  (let [^mut n n0]
    (do
      (while (and (< n size)
               (not (md/-al-space? (string/byte-at s (+ a n))))
               (not (= (string/byte-at s (+ a n)) 60)))
        (set! n (+ n 1)))
      n)))
;;; md/-al-node! -- internal: a detached link to dest-raw (normalised) whose text is bytes [a, b) of pool String str; its index.

(defn md/-al-node! [^borrow ip : rc<MdIP>
                    str : int
                    a : int
                    b : int
                    dest-raw : String] : int
  (let [v    (md/-ip-v ip)
        dest (md/-ip-add-str! ip (md/-normalize-uri dest-raw))
        node (md/-inl-new! v (MdILink) -1 0 0)
        text (md/-inl-new! v (MdIText) str a b)]
    (do
      (string/release dest-raw)
      (vec-set! v node (with (vec-get v node) [dest dest]))
      (md/-inl-append! v node text)
      node)))
;;; md/-al-link! -- internal: append a link to dest-raw (normalised) holding the subject's bytes [a, b) as its text.

(defn md/-al-link! [^borrow ip : rc<MdIP> a : int b : int dest-raw : String] : void
  (md/-inl-append! (md/-ip-v ip)
    (.root ip)
    (md/-al-node! ip (.subj ip) a b dest-raw)))
;;; md/-www-match! -- internal: at a w, a www. link: after a space, one of *_~( or the start, with a domain of two or more labels; whether there was one.

(defn md/-www-match! [^borrow ip : rc<MdIP>] : bool
  (let [s    (md/-ip-s ip)
        p    (.pos ip)
        size (- (.len ip) p)
        pc   (md/-ip-c ip (- p 1))]
    (if (or (>= (.brackets ip) 0)
          (and (> p 0)
            (not (or (= pc 42)
                   (= pc 95)
                   (= pc 126)
                   (= pc 40)
                   (md/-al-space? pc))))
          (< size 4)
          (not (md/-has-cstr-at? s "www." p)))
      false
      (let [d (md/-check-domain s p size false)]
        (if (= d 0)
          false
          (let [n (md/-al-delim s p (md/-al-extend s p d size))]
            (if (= n 0)
              false
              (let [raw (builder/new)]
                (do
                  (builder/push-cstr! raw "http://")
                  (string/-push-range! raw s p (+ p n))
                  (md/-al-link! ip p (+ p n) (builder/finish raw))
                  (set! (.pos ip) (+ p n))
                  true)))))))))
;;; md/-unput! -- internal: take n bytes back off the end of the root's trailing text inlines (cmark_node_unput), dropping any left empty.

(defn md/-unput! [^borrow ip : rc<MdIP> n0 : int] : void
  (let [v      (md/-ip-v ip)
        ^mut n n0
        ^mut c (.last-child (vec-get v (.root ip)))]
    (while (and (> n 0)
             (>= c 0)
             (match (.kind (vec-get v c)) (MdIText) true _ false))
      (let [t   (vec-get v c)
            len (- (.end t) (.start t))]
        (do
          (if (<= len n)
            (do (set! n (- n len)) (md/-inl-unlink! v c))
            (do (vec-set! v c (with t [end (- (.end t) n)])) (set! n 0)))
          (set! c (.prev t)))))))
;;; md/-scheme-at? -- internal: does [a, a+len) of s start with the k-byte scheme sch (any case) followed by a host character?

(defn md/-scheme-at? [s : String a : int len : int sch : cstr k : int] : bool
  (and (> len k) (md/-ci-cstr-at? s sch a) (md/-hostchar? s (+ a k) (+ a len))))
;;; md/-safe-scheme? -- internal: does [a, a+len) of s start with http://, https:// or ftp:// (any case) followed by a host character?

(defn md/-safe-scheme? [s : String a : int len : int] : bool
  (or (md/-scheme-at? s a len "http://" 7)
    (md/-scheme-at? s a len "https://" 8)
    (md/-scheme-at? s a len "ftp://" 6)))
;;; md/-url-match! -- internal: at a :, a link whose scheme (http, https or ftp) is the letters just before it, followed by // and a domain; whether there was one.

(defn md/-url-match! [^borrow ip : rc<MdIP>] : bool
  (let [s    (md/-ip-s ip)
        p    (.pos ip)
        size (- (.len ip) p)]
    (if (or (>= (.brackets ip) 0)
          (< size 4)
          (not (= (md/-ip-c ip (+ p 1)) 47))
          (not (= (md/-ip-c ip (+ p 2)) 47)))
      false
      (let [^mut rw 0]
        (do
          (while (and (< rw p) (md/-al-alpha? (md/-ip-c ip (- p rw 1))))
            (set! rw (+ rw 1)))
          (if (not (md/-safe-scheme? s (- p rw) (+ size rw)))
            false
            (let [d (md/-check-domain s (+ p 3) (- size 3) true)]
              (if (= d 0)
                false
                (let [n (md/-al-delim s p (md/-al-extend s p (+ 3 d) size))]
                  (if (= n 0)
                    false
                    (do
                      (md/-unput! ip rw)
                      (md/-al-link! ip
                        (- p rw)
                        (+ p n)
                        (string/substring s (- p rw) (+ n rw)))
                      (set! (.pos ip) (+ p n))
                      true)))))))))))
;; ---- GFM email autolinks: after parsing --------------------------------------------------
;; cmark-gfm finds email addresses in a pass over the finished tree: the text
;; inlines outside links, adjacent ones joined first.  postprocess_text's
;; state is ported as it stands, including what a second @ carries over.
;;; md/-is-text? -- internal: is inline i a text inline?

(defn md/-is-text? [v : (Vec MdInl) i : int] : bool
  (and (>= i 0) (match (.kind (vec-get v i)) (MdIText) true _ false)))
;;; md/-byte-index -- internal: the first index of byte c in [i, end) of s, or -1.

(defn md/-byte-index [s : String c : int i : int end : int] : int
  (let [^mut j i]
    (do
      (while (and (< j end) (not (= (string/byte-at s j) c))) (set! j (+ j 1)))
      (if (< j end) j -1))))
;;; md/-text-has-at? -- internal: does text inline i hold an @?

(defn md/-text-has-at? [^borrow ip : rc<MdIP> i : int] : bool
  (let [n (vec-get (md/-ip-v ip) i)]
    (>= (md/-byte-index (vec-get (.strs (.doc ip)) (.str n))
          64
          (.start n)
          (.end n))
      0)))
;;; md/-consolidate! -- internal: cmark's text consolidation where it can matter: when text inline i and the text inlines straight after it hold an @ between them, join them into one over a fresh pool String.

(defn md/-consolidate! [^borrow ip : rc<MdIP> i : int] : void
  (let [v       (md/-ip-v ip)
        ^mut j  i
        ^mut at false]
    (do
      (while (md/-is-text? v j)
        (do
          (when (md/-text-has-at? ip j) (set! at true))
          (set! j (.next (vec-get v j)))))
      (when (and at (not (= (.next (vec-get v i)) j)))
        (let [b      (builder/new)
              ^mut k i]
          (do
            (while (md/-is-text? v k)
              (let [n  (vec-get v k)
                    nx (.next n)]
                (do
                  (string/-push-range! b
                    (vec-get (.strs (.doc ip)) (.str n))
                    (.start n)
                    (.end n))
                  (when (not (= k i)) (md/-inl-unlink! v k))
                  (set! k nx))))
            (let [s  (builder/finish b)
                  ln (string/len s)
                  t  (md/-ip-add-str! ip s)]
              (vec-set! v i (with (vec-get v i) [str t start 0 end ln])))))))))
;;; md/-al-protocol? -- internal: cmark-gfm's validate_protocol: does the k-byte protocol p end just before the rw bytes rewound from the @ at at, with a non-alphanumeric byte or the start of the scan (mr bytes back) before it?

(defn md/-al-protocol? [s : String p : cstr k : int at : int rw : int mr : int] : bool
  (let [left (- mr rw)
        from (- at rw k)]
    (cond (> k left)                        false
          (not (md/-has-cstr-at? s p from)) false
          (= k left)                        true
          :else                             (not (md/-al-alnum? (string/byte-at s
                                                                  (- from 1)))))))
;;; MdMailScan -- internal: postprocess_text's walk left from an @: how many bytes it took, and whether a mailto: or xmpp: it passed means no mailto: is added (auto false) and a / may follow the domain (xmpp).

(defstruct ^copy MdMailScan [rw : int auto : bool xmpp : bool])
;;; MdMailEnd -- internal: postprocess_text's walk right from an @: the length it took, the dots it has passed, and whether it stopped at another @.

(defstruct ^copy MdMailEnd [le : int np : int at : bool])
;;; MdMailHit -- internal: an email address postprocess_text found -- the bytes [a, b), and whether to add mailto: -- or, when found is false, where to look for the next @.

(defstruct ^copy MdMailHit
  [found : bool a : int b : int auto : bool next : int])
;;; md/-mail-local? -- internal: can byte c come before the @ of an email address: a letter, a digit, or one of . + - _?

(defn md/-mail-local? [c : int] : bool
  (or (md/-al-alnum? c) (= c 46) (= c 43) (= c 45) (= c 95)))
;;; md/-mail-rewind -- internal: postprocess_text's walk left from the @ at at, over at most mr bytes, carrying on from sc's auto and xmpp.

(defn md/-mail-rewind [s : String at : int mr : int sc : MdMailScan] : MdMailScan
  (let [^mut r  (with sc [rw 0])
        ^mut go true]
    (do
      (while (and go (< (.rw r) mr))
        (let [k (.rw r)
              c (string/byte-at s (- at k 1))]
          (cond (md/-mail-local? c)                      (set! r
                                                           (with r [rw (+ k 1)]))
                (not (= c 58))                           (set! go false)
                (md/-al-protocol? s "mailto:" 7 at k mr) (set! r
                                                           (with r
                                                             [rw
                                                              (+ k 1)
                                                              auto
                                                              false]))
                (md/-al-protocol? s "xmpp:" 5 at k mr)   (set! r
                                                           (with r
                                                             [rw
                                                              (+ k 1)
                                                              auto
                                                              false
                                                              xmpp
                                                              true]))
                :else                                    (set! go false))))
      r)))
;;; md/-mail-dot? -- internal: is byte i of s a dot with a letter or digit after it, before end?

(defn md/-mail-dot? [s : String i : int end : int] : bool
  (and (= (string/byte-at s i) 46)
    (< (+ i 1) end)
    (md/-al-alnum? (string/byte-at s (+ i 1)))))
;;; md/-mail-domain -- internal: postprocess_text's walk right from the @ at at, before end, counting dots on from np0; a / is allowed when xmpp.

(defn md/-mail-domain [s : String at : int end : int np0 : int xmpp : bool] : MdMailEnd
  (let [^mut le   1
        ^mut np   np0
        ^mut stop 0]
    (do
      (while (and (= stop 0) (< (+ at le) end))
        (let [c (string/byte-at s (+ at le))]
          (cond (md/-al-alnum? c)               (set! le (+ le 1))
                (= c 64)                        (set! stop 2)
                (md/-mail-dot? s (+ at le) end) (do
                                                  (set! np (+ np 1))
                                                  (set! le (+ le 1)))
                (or (= c 45) (= c 95))          (set! le (+ le 1))
                (and xmpp (= c 47))             (set! le (+ le 1))
                :else                           (set! stop 1))))
      (MdMailEnd le np (= stop 2)))))
;;; md/-mail-check -- internal: the end of postprocess_text for the @ at at, whose walks gave sc and m: the address, or where to look next.

(defn md/-mail-check [s : String at : int m : MdMailEnd sc : MdMailScan] : MdMailHit
  (let [le (.le m)
        ec (string/byte-at s (+ at le -1))]
    (if (or (< le 2)
          (= (.np m) 0)
          (and (not (md/-al-alpha? ec)) (not (= ec 46))))
      (MdMailHit false 0 0 true (+ at le))
      (let [n (md/-al-delim s at le)]
        (if (= n 0)
          (MdMailHit false 0 0 true (+ at 1))
          (MdMailHit true (- at (.rw sc)) (+ at n) (.auto sc) 0))))))
;;; md/-mail-link! -- internal: a detached link for the email address [a, b) of pool String str (whose text is s), with mailto: added when auto; its index.

(defn md/-mail-link! [^borrow ip : rc<MdIP>
                      str : int
                      s : String
                      a : int
                      b : int
                      auto : bool] : int
  (let [raw (builder/new)]
    (do
      (when auto (builder/push-cstr! raw "mailto:"))
      (string/-push-range! raw s a b)
      (md/-al-node! ip str a b (builder/finish raw)))))
;;; md/-mail-find -- internal: postprocess_text from the @ at at0, in text whose scan starts at p0 and ends at end: the email address there, or where to look next.
;;;
;;; A second @ in the domain moves the search to it, keeping what the first
;;; walk left found (a mailto: or xmpp:, and the dots), as cmark-gfm's goto does.

(defn md/-mail-find [s : String p0 : int at0 : int end : int] : MdMailHit
  (let [^mut p   p0
        ^mut at  at0
        ^mut sc  (MdMailScan 0 true false)
        ^mut np  0
        ^mut hit (MdMailHit false 0 0 true (+ at0 1))
        ^mut go  true]
    (do
      (while go
        (do
          (set! sc (md/-mail-rewind s at (- at p) sc))
          (if (= (.rw sc) 0)
            (do (set! hit (with hit [next (+ at 1)])) (set! go false))
            (let [m (md/-mail-domain s at end np (.xmpp sc))]
              (if (.at m)
                (do
                  (set! np (.np m))
                  (set! p (+ at 1))
                  (set! at (+ at (.le m))))
                (do (set! hit (md/-mail-check s at m sc)) (set! go false)))))))
      hit)))
;;; md/-email-text! -- internal: cmark-gfm's postprocess_text on text inline t0: each email address in it becomes a mailto: link (xmpp: and mailto: ones keep their own scheme); the last inline it left in t0's place.

(defn md/-email-text! [^borrow ip : rc<MdIP> t0 : int] : int
  (let [v         (md/-ip-v ip)
        str       (.str (vec-get v t0))
        s         (vec-get (.strs (.doc ip)) str)
        z         (.end (vec-get v t0))
        ^mut t    t0
        ^mut last t0
        ^mut st   (.start (vec-get v t0))
        ^mut p    (.start (vec-get v t0))
        ^mut go   true]
    (do
      (while go
        (let [at (if (< p z) (md/-byte-index s 64 p z) -1)]
          (if (< at 0)
            (set! go false)
            (let [h (md/-mail-find s p at z)]
              (if (not (.found h))
                (set! p (.next h))
                (let [link (md/-mail-link! ip str s (.a h) (.b h) (.auto h))]
                  (do
                    ;; t keeps the text before the address, and a new text
                    ;; inline after the link takes the rest.
                    (md/-inl-insert-after! v t link)
                    (vec-set! v t (with (vec-get v t) [start st end (.a h)]))
                    (when (= st (.a h)) (md/-inl-unlink! v t))
                    (set! last link)
                    (if (< (.b h) z)
                      (let [post (md/-inl-new! v (MdIText) str (.b h) z)]
                        (do
                          (md/-inl-insert-after! v link post)
                          (set! t post)
                          (set! last post)
                          (set! st (.b h))
                          (set! p (.b h))))
                      (set! go false)))))))))
      last)))
;;; md/-inl-leaf? -- internal: is an inline of kind k a leaf, which cmark's iterator enters but never exits?

(defn md/-inl-leaf? [k : MdIKind] : bool
  (match k
    (MdIText)
    true
    (MdISoftBreak)
    true
    (MdIHardBreak)
    true
    (MdICode)
    true
    (MdIHtml)
    true
    (MdIMath)
    true
    (MdIMathDisplay)
    true
    _
    false))
;;; md/-is-link? -- internal: is inline i a link?

(defn md/-is-link? [v : (Vec MdInl) i : int] : bool
  (match (.kind (vec-get v i)) (MdILink) true _ false))
;;; md/-email-pass! -- internal: cmark-gfm's autolink postprocess for one block: an email address in a text inline becomes a link, unless it is inside a link.
;;;
;;; The walk is cmark's iterator, enter and exit events, and "inside a link"
;;; is its one flag: the exit of a link inside a link clears it, so the rest
;;; of the outer link's text is searched too.

(defn md/-email-pass! [^borrow ip : rc<MdIP>] : void
  (let [v            (md/-ip-v ip)
        root         (.root ip)
        ^mut i       (.first-child (vec-get v root))
        ^mut enter   true
        ^mut in-link false]
    (while (>= i 0)
      (do
        (if in-link
          (when (and (not enter) (md/-is-link? v i)) (set! in-link false))
          (when enter
            (cond (md/-is-link? v i) (set! in-link true)
                  (md/-is-text? v i) (do
                                       (md/-consolidate! ip i)
                                       ;; Carry on after what the text became; a
                                       ;; link it ends with is passed over whole.
                                       (set! i (md/-email-text! ip i))
                                       (set! enter false))
                  :else              nil)))
        (if (and enter (not (md/-inl-leaf? (.kind (vec-get v i)))))
          (let [fc (.first-child (vec-get v i))]
            (if (>= fc 0) (set! i fc) (set! enter false)))
          (let [nx (.next (vec-get v i))
                p  (.parent (vec-get v i))]
            (cond (>= nx 0)  (do (set! i nx) (set! enter true))
                  (= p root) (set! i -1)
                  :else      (do (set! i p) (set! enter false)))))))))
;;; md/-special? -- internal: can byte c start something other than plain text?

(defn md/-special? [c : int] : bool
  (or (= c 10)
    (= c 96)
    (= c 91)
    (= c 93)
    (= c 92)
    (= c 33)
    (= c 60)
    (= c 38)
    (= c 42)
    (= c 95)))
;;; md/-ip-special? -- internal: can byte c start something other than plain text, with this block's extensions?

(defn md/-ip-special? [^borrow ip : rc<MdIP> c : int] : bool
  (or (md/-special? c)
    (and (= c 126) (.tilde ip))
    (and (.autolinks ip) (or (= c 58) (= c 119)))
    (and (= c 36) (.math ip))))
;;; md/-parse-string! -- internal: a run of plain text; whether there was one.

(defn md/-parse-string! [^borrow ip : rc<MdIP>] : bool
  (let [start  (.pos ip)
        ^mut j start]
    (do
      (while (and (< j (.len ip)) (not (md/-ip-special? ip (md/-ip-c ip j))))
        (set! j (+ j 1)))
      (if (> j start)
        (do (md/-ip-text! ip start j) (set! (.pos ip) j) true)
        false))))
;;; md/-parse-inline! -- internal: parse the inline at the position.

(defn md/-parse-inline! [^borrow ip : rc<MdIP>] : void
  (let [c       (md/-ip-c ip (.pos ip))
        handled (cond (= c 10)                        (do
                                                        (md/-parse-newline! ip)
                                                        true)
                      (= c 92)                        (do
                                                        (md/-parse-backslash! ip)
                                                        true)
                      (= c 96)                        (do
                                                        (md/-parse-backticks! ip)
                                                        true)
                      (or (= c 42) (= c 95))          (do
                                                        (md/-parse-delim! ip c)
                                                        true)
                      (and (= c 126) (.tilde ip))     (do
                                                        (md/-parse-delim! ip c)
                                                        true)
                      (and (= c 36) (.math ip))       (md/-parse-dollar! ip)
                      (and (= c 58) (.autolinks ip))  (md/-url-match! ip)
                      (and (= c 119) (.autolinks ip)) (md/-www-match! ip)
                      (= c 91)                        (do
                                                        (md/-parse-open-bracket! ip)
                                                        true)
                      (= c 33)                        (do
                                                        (md/-parse-bang! ip)
                                                        true)
                      (= c 93)                        (do
                                                        (md/-parse-close-bracket! ip)
                                                        true)
                      (= c 60)                        (md/-parse-lt! ip)
                      (= c 38)                        (md/-parse-entity! ip)
                      :else                           (md/-parse-string! ip))]
    (when (not handled)
      (do (md/-ip-text! ip (.pos ip) (+ (.pos ip) 1)) (md/-ip-advance! ip 1)))))
;; ---- After parsing ------------------------------------------------------------------------
;;; md/-text-run? -- internal: is inline j a text inline that carries on straight from inline i's bytes?

(defn md/-text-run? [v : (Vec MdInl) i : int j : int] : bool
  (and (>= j 0)
    (match (.kind (vec-get v j)) (MdIText) true _ false)
    (= (.str (vec-get v j)) (.str (vec-get v i)))
    (= (.start (vec-get v j)) (.end (vec-get v i)))))
;;; md/-merge-text! -- internal: join each run of adjacent text inlines over consecutive bytes (an unmatched * between two words, say) into one, for the inlines from first on.

(defn md/-merge-text! [v : (Vec MdInl) first : int] : void
  (let [^mut i first]
    (while (< i (vec-len v))
      (do
        (when (and (>= (.parent (vec-get v i)) 0)
                (match (.kind (vec-get v i)) (MdIText) true _ false))
          (while (md/-text-run? v i (.next (vec-get v i)))
            (let [j (.next (vec-get v i))]
              (do
                (vec-set! v i (with (vec-get v i) [end (.end (vec-get v j))]))
                (md/-inl-unlink! v j)))))
        (set! i (+ i 1))))))
;; ---- Blocks -------------------------------------------------------------------------------
;;; md/-inline-block! -- internal: parse block i's text (trimmed first) into an inline tree under a fresh root.

(defn md/-inline-block! [d : MdDoc i : int] : void
  (let [n    (vec-get (.nodes d) i)
        t    (.text n)
        s0   (vec-get (.strs d) t)
        a    (md/-skip-ws s0 0 (string/len s0))
        z    (md/-trim-end-index s0 a (string/len s0))
        s    (string/substring s0 a (- z a))
        root (md/-inl-new! (.inls d) (MdIRoot) -1 0 0)]
    (do
      (vec-set! (.strs d) t s)
      (string/release s0)
      (vec-set! (.nodes d) i (with n [inl root]))
      (let [ip (rc/of (MdIP d
                        t
                        (string/len s)
                        0
                        root
                        -1
                        -1
                        (md/-new-delims)
                        (md/-new-brackets)
                        (.strikethrough (.opts d))
                        (.autolinks (.opts d))
                        (.math (.opts d))))]
        (do
          (while (< (.pos ip) (.len ip)) (md/-parse-inline! ip))
          (md/-process-emphasis! ip -1)
          (md/-merge-text! (.inls d) root)
          (when (.autolinks ip) (md/-email-pass! ip))
          (vec-free (.dv ip))
          (vec-free (.bv ip)))))))
;;; md/-parse-inlines! -- internal: parse every paragraph and heading still in the tree.

(defn md/-parse-inlines! [d : MdDoc] : void
  (let [^mut i 1]
    (while (< i (vec-len (.nodes d)))
      (let [n (vec-get (.nodes d) i)]
        (do
          (when (and (>= (.text n) 0)
                  (>= (.parent n) 0)
                  (match (.kind n)
                    (MdKParagraph)
                    true
                    (MdKHeading)
                    true
                    (MdKTableCell)
                    true
                    _
                    false))
            (md/-inline-block! d i))
          (set! i (+ i 1)))))))
