;;; tur/mutmap -- MutableMap[K V]: mutable open-addressed hash table.
;;;
;;; Uses linear probing. Unlike tur/map, mutations happen in-place.
;;;
;;; Since: Phase F5
;; Phase F5 (cross-plan-followups): Mutable typed map MutableMap[K V].
;;
;; A mutable, open-addressed hash table with linear probing.  Unlike
;; the persistent Map[K V] backed by HAMT, MutableMap mutates in
;; place: mutmap-set! / mutmap-delete! modify the storage rather
;; than returning a new map.
;;
;; Design notes (F5-1 decision):
;;   - Backing structure: open-addressed hash table with linear probing.
;;     Conventional choice; avoids the persistence overhead of a HAMT
;;     when the persistence is not needed.  Sharing is not the goal --
;;     the API is mutation-focused.
;;   - Load factor: resize at 0.75.  Capacity doubles on resize.
;;   - Tombstones: each slot has a tag (EMPTY / OCCUPIED / DELETED).
;;     get / set! / delete! follow probe chains past DELETED slots.
;;   - Keys and values are int64_t at the C level (matching the
;;     Hash[K] / Eq[K] typeclass dispatch convention -- caller passes
;;     a precomputed hash).
;;
;; K must satisfy Hash[K] and Eq[K] -- callers supply precomputed
;; hashes to insert / lookup / delete, mirroring tmap.tur's API.
;;; MutableMap -- parameterized in-place hash table with key K, value V.
;;;
;;; Since: Phase F5 (cross-plan-followups)
(defstruct MutableMap :heap [K V] (storage :ptr<void>))
;;; mutmap-new -- create a new empty MutableMap[K V] with default
;;; initial capacity (16 slots).
;;;
;;; Returns:
;;;   An empty MutableMap[K V].  K/V are inferred from later use
;;;   (e.g. the first mutmap-set!), like vec-new's element type.
;;;
;;; Example:
;;;   (mutmap-new)  ; => empty MutableMap
;;;
;;; Since: Phase F5

(defn mutmap-new [K V] []
  #fx{}
  : (MutableMap K V)
  ```c
  /* Backing storage layout:
   *   uint64_t cap;        capacity (power of two)
   *   uint64_t len;        live entry count (OCCUPIED slots only)
   *   uint64_t tomb;       tombstone count (DELETED slots)
   *   Slot     slots[cap];
   *
   * Slot layout:
   *   uint8_t  tag;        0=EMPTY, 1=OCCUPIED, 2=DELETED
   *   int64_t  hash;
   *   int64_t  key;
   *   int64_t  value;
   */
  enum { TUR_MM_EMPTY=0, TUR_MM_OCCUPIED=1, TUR_MM_DELETED=2 };
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  size_t init_cap = 16;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)
      malloc(sizeof(*s) + init_cap * sizeof(struct __tur_mm_slot));
  s->cap = init_cap; s->len = 0; s->tomb = 0;
  for (size_t i = 0; i < init_cap; i++) {
      s->slots[i].tag = TUR_MM_EMPTY;
      s->slots[i].hash = 0; s->slots[i].key = 0; s->slots[i].value = 0;
  }
  struct { void *storage; } *m = malloc(sizeof(*m));
  m->storage = s;
  return (__TUR_RET__)(intptr_t)m;
  ```)
;;; mutmap-len -- live entry count (excludes tombstones).
;;;
;;; Parameters:
;;;   m -- MutableMap[K V]
;;;
;;; Returns:
;;;   Number of live (key, value) entries.
;;;
;;; Example:
;;;   (mutmap-len mm)  ; => 0
;;;
;;; Since: Phase F5

(defn mutmap-len [K V] [m : (MutableMap K V)]
  #fx{}
  : int
  ```c
  struct __tur_mm_storage_l { uint64_t cap; uint64_t len; uint64_t tomb; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage_l *s = (struct __tur_mm_storage_l *)mm->storage;
  return (int64_t)s->len;
  ```)
;;; mutmap-set! -- insert or update (key, value).  Mutates m in place.
;;;
;;; Parameters:
;;;   m   -- MutableMap[K V]
;;;   h   -- precomputed hash of key (Hash[K])
;;;   key -- key
;;;   val -- value
;;;
;;; Returns:
;;;   nil.
;;;
;;; Example:
;;;   (mutmap-set! mm 1 1 100)
;;;
;;; Since: Phase F5

(defn mutmap-set! [K V] [m : (MutableMap K V) h : int key : K val : V]
  #fx{}
  : nil
  ```c
  enum { TUR_MM_EMPTY=0, TUR_MM_OCCUPIED=1, TUR_MM_DELETED=2 };
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  /* Resize when load factor (len + tomb) / cap >= 0.75. */
  if ((s->len + s->tomb) * 4 >= s->cap * 3) {
      uint64_t new_cap = s->cap * 2;
      struct __tur_mm_storage *ns = (struct __tur_mm_storage *)
          malloc(sizeof(*ns) + new_cap * sizeof(struct __tur_mm_slot));
      ns->cap = new_cap; ns->len = 0; ns->tomb = 0;
      for (uint64_t i = 0; i < new_cap; i++) {
          ns->slots[i].tag = TUR_MM_EMPTY;
          ns->slots[i].hash = 0; ns->slots[i].key = 0; ns->slots[i].value = 0;
      }
      uint64_t mask = new_cap - 1;
      for (uint64_t i = 0; i < s->cap; i++) {
          if (s->slots[i].tag != TUR_MM_OCCUPIED) continue;
          uint64_t idx = ((uint64_t)s->slots[i].hash) & mask;
          while (ns->slots[idx].tag == TUR_MM_OCCUPIED) idx = (idx + 1) & mask;
          ns->slots[idx] = s->slots[i];
          ns->len++;
      }
      free(s);
      mm->storage = ns;
      s = ns;
  }
  uint64_t mask = s->cap - 1;
  uint64_t idx = ((uint64_t)h) & mask;
  int64_t first_tomb = -1;
  /* region-lock-hardening: slot storage is malloc'd and outlives any region
     bracket; a region-allocated key or value is an escape.  See vec-push!. */
  TUR_REGION_NOTE(key);
  TUR_REGION_NOTE(val);
  for (;;) {
      struct __tur_mm_slot *slot = &s->slots[idx];
      if (slot->tag == TUR_MM_EMPTY) {
          /* Not present: insert at first tombstone if any, else here. */
          if (first_tomb >= 0) {
              struct __tur_mm_slot *ts = &s->slots[first_tomb];
              ts->tag = TUR_MM_OCCUPIED;
              ts->hash = h; ts->key = key; ts->value = val;
              s->tomb--;
              s->len++;
          } else {
              slot->tag = TUR_MM_OCCUPIED;
              slot->hash = h; slot->key = key; slot->value = val;
              s->len++;
          }
          return;
      }
      if (slot->tag == TUR_MM_OCCUPIED && slot->hash == h && slot->key == key) {
          /* Update existing. */
          slot->value = val;
          return;
      }
      if (slot->tag == TUR_MM_DELETED && first_tomb < 0) {
          first_tomb = (int64_t)idx;
      }
      idx = (idx + 1) & mask;
  }
  ```)
;;; mutmap-get -- look up the value bound to key, or 0 if absent.
;;;
;;; Parameters:
;;;   m   -- MutableMap[K V]
;;;   h   -- precomputed hash of key (Hash[K])
;;;   key -- key
;;;
;;; Returns:
;;;   The bound value, or 0 if key is not present.  Callers needing
;;;   to distinguish "absent" from "value = 0" should use
;;;   mutmap-has? first.
;;;
;;; Example:
;;;   (mutmap-get mm 1 1)  ; => 100
;;;
;;; Since: Phase F5

(defn mutmap-get [K V] [m : (MutableMap K V) h : int key : K]
  #fx{}
  : V
  ```c
  enum { TUR_MM_EMPTY=0, TUR_MM_OCCUPIED=1, TUR_MM_DELETED=2 };
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  uint64_t mask = s->cap - 1;
  uint64_t idx = ((uint64_t)h) & mask;
  for (;;) {
      struct __tur_mm_slot *slot = &s->slots[idx];
      if (slot->tag == TUR_MM_EMPTY) return 0;
      if (slot->tag == TUR_MM_OCCUPIED && slot->hash == h && slot->key == key) {
          return slot->value;
      }
      idx = (idx + 1) & mask;
  }
  ```)
;;; mutmap-has? -- check whether key is present.
;;;
;;; Parameters:
;;;   m   -- MutableMap[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key
;;;
;;; Returns:
;;;   true if key is present (value of any kind), false otherwise.
;;;
;;; Example:
;;;   (mutmap-has? mm 1 1)  ; => true
;;;
;;; Since: Phase F5

(defn mutmap-has? [K V] [m : (MutableMap K V) h : int key : K]
  #fx{}
  : bool
  ```c
  enum { TUR_MM_EMPTY=0, TUR_MM_OCCUPIED=1, TUR_MM_DELETED=2 };
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  uint64_t mask = s->cap - 1;
  uint64_t idx = ((uint64_t)h) & mask;
  for (;;) {
      struct __tur_mm_slot *slot = &s->slots[idx];
      if (slot->tag == TUR_MM_EMPTY) return false;
      if (slot->tag == TUR_MM_OCCUPIED && slot->hash == h && slot->key == key) {
          return true;
      }
      idx = (idx + 1) & mask;
  }
  ```)
;;; mutmap-delete! -- remove (key, value) if present.  Mutates m
;;; in place.  Leaves a tombstone so probe chains stay intact.
;;;
;;; Parameters:
;;;   m   -- MutableMap[K V]
;;;   h   -- precomputed hash of key
;;;   key -- key
;;;
;;; Returns:
;;;   true if key was present (and is now removed), false otherwise.
;;;
;;; Example:
;;;   (mutmap-delete! mm 1 1)  ; => true
;;;
;;; Since: Phase F5

(defn mutmap-delete! [K V] [m : (MutableMap K V) h : int key : K]
  #fx{}
  : bool
  ```c
  enum { TUR_MM_EMPTY=0, TUR_MM_OCCUPIED=1, TUR_MM_DELETED=2 };
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  uint64_t mask = s->cap - 1;
  uint64_t idx = ((uint64_t)h) & mask;
  for (;;) {
      struct __tur_mm_slot *slot = &s->slots[idx];
      if (slot->tag == TUR_MM_EMPTY) return false;
      if (slot->tag == TUR_MM_OCCUPIED && slot->hash == h && slot->key == key) {
          slot->tag = TUR_MM_DELETED;
          slot->hash = 0; slot->key = 0; slot->value = 0;
          s->len--;
          s->tomb++;
          return true;
      }
      idx = (idx + 1) & mask;
  }
  ```)
;;; mutmap-cap -- slot-array capacity (number of probe slots, a power of two).
;;;
;;; Parameters:
;;;   m -- MutableMap[K V]
;;;
;;; Returns:
;;;   The backing storage capacity (>= mutmap-len; includes EMPTY and
;;;   DELETED slots).  Used as the iteration bound for mutmap-slot-* walks.
;;;
;;; Example:
;;;   (mutmap-cap mm)  ; => 16
;;;
;;; Since: Phase F5

(defn mutmap-cap [K V] [m : (MutableMap K V)]
  #fx{}
  : int
  ```c
  struct __tur_mm_storage_c { uint64_t cap; uint64_t len; uint64_t tomb; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage_c *s = (struct __tur_mm_storage_c *)mm->storage;
  return (int64_t)s->cap;
  ```)
;;; mutmap-slot-occupied? -- is slot i a live (OCCUPIED) entry?
;;;
;;; Parameters:
;;;   m -- MutableMap[K V]
;;;   i -- slot index in [0, mutmap-cap m)
;;;
;;; Returns:
;;;   true iff slot i holds a live entry (not EMPTY, not a DELETED tombstone).
;;;
;;; Example:
;;;   (mutmap-slot-occupied? mm 0)  ; => true / false
;;;
;;; Since: Phase F5

(defn mutmap-slot-occupied? [K V] [m : (MutableMap K V) i : int]
  #fx{}
  : bool
  ```c
  enum { TUR_MM_OCCUPIED=1 };
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  return s->slots[i].tag == TUR_MM_OCCUPIED;
  ```)
;;; mutmap-slot-hash -- precomputed hash stored in slot i.
;;;
;;; Parameters:
;;;   m -- MutableMap[K V]
;;;   i -- slot index in [0, mutmap-cap m)
;;;
;;; Returns:
;;;   The hash recorded for slot i (meaningful only when the slot is OCCUPIED).
;;;
;;; Example:
;;;   (mutmap-slot-hash mm 0)
;;;
;;; Since: Phase F5

(defn mutmap-slot-hash [K V] [m : (MutableMap K V) i : int]
  #fx{}
  : int
  ```c
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  return (int64_t)s->slots[i].hash;
  ```)
;;; mutmap-slot-key -- key stored in slot i.
;;;
;;; Parameters:
;;;   m -- MutableMap[K V]
;;;   i -- slot index in [0, mutmap-cap m)
;;;
;;; Returns:
;;;   The key in slot i (meaningful only when the slot is OCCUPIED).
;;;
;;; Example:
;;;   (mutmap-slot-key mm 0)
;;;
;;; Since: Phase F5

(defn mutmap-slot-key [K V] [m : (MutableMap K V) i : int]
  #fx{}
  : K
  ```c
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  return (int64_t)s->slots[i].key;
  ```)
;;; mutmap-slot-value -- value stored in slot i.
;;;
;;; Parameters:
;;;   m -- MutableMap[K V]
;;;   i -- slot index in [0, mutmap-cap m)
;;;
;;; Returns:
;;;   The value in slot i (meaningful only when the slot is OCCUPIED).
;;;
;;; Example:
;;;   (mutmap-slot-value mm 0)
;;;
;;; Since: Phase F5

(defn mutmap-slot-value [K V] [m : (MutableMap K V) i : int]
  #fx{}
  : V
  ```c
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  struct __tur_mm_storage *s = (struct __tur_mm_storage *)mm->storage;
  return (int64_t)s->slots[i].value;
  ```)
;;; mutmap-eq-storage? -- structural equality over two raw storage pointers.
;; Internal helper: the fixed-arity inline-C iteration core that the public
;; `mutmap-eq?` wrapper delegates to.  Takes the two `storage` field values
;; directly (ptr<void>), so it is agnostic to K/V and to how the caller held
;; the map -- and its C `for` loop is stack-safe for any size.  The `Eq
;; [MutableMap]` instance does NOT use this path; it walks `mutmap-eq-loop`
;; (pure Turmeric, TCO'd inside the by-value spec) instead, mirroring how
;; `Eq [Vec]` keeps the inline-C `vec-eq?` for direct/abstract use but
;; dispatches through the pure-Turmeric `vec-eq-loop`.

(defn mutmap-eq-storage? [V] [pa : ptr<void>
                              pb : ptr<void>
                              ^borrow ^fat val-cmp : (fn [V V] bool)]
  #fx{}
  : bool
  ```c
  enum { TUR_MM_EMPTY=0, TUR_MM_OCCUPIED=1, TUR_MM_DELETED=2 };
  struct __tur_mm_slot { uint8_t tag; int64_t hash; int64_t key; int64_t value; };
  struct __tur_mm_storage { uint64_t cap; uint64_t len; uint64_t tomb; struct __tur_mm_slot slots[]; };
  struct __tur_mm_storage *sa = (struct __tur_mm_storage *)(intptr_t)pa;
  struct __tur_mm_storage *sb = (struct __tur_mm_storage *)(intptr_t)pb;
  if (sa->len != sb->len) return false;
  for (uint64_t i = 0; i < sa->cap; i++) {
      if (sa->slots[i].tag != TUR_MM_OCCUPIED) continue;
      int64_t h = sa->slots[i].hash;
      int64_t k = sa->slots[i].key;
      int64_t v_a = sa->slots[i].value;
      /* Find the same key in b (via probe). */
      uint64_t mask = sb->cap - 1;
      uint64_t idx = ((uint64_t)h) & mask;
      bool found = false;
      int64_t v_b = 0;
      for (;;) {
          struct __tur_mm_slot *slot = &sb->slots[idx];
          if (slot->tag == TUR_MM_EMPTY) break;
          if (slot->tag == TUR_MM_OCCUPIED && slot->hash == h && slot->key == k) {
              v_b = slot->value;
              found = true;
              break;
          }
          idx = (idx + 1) & mask;
      }
      if (!found) return false;
      /* CRU B-3: val-cmp is a fat closure box; fat-dispatch via slot 0. */
      if (!((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)val_cmp)[0])((void*)(intptr_t)val_cmp, v_a, v_b)) return false;
  }
  return true;
  ```)
;;; mutmap-eq-loop -- pure-Turmeric structural-equality walk (self-tail slot loop).
;;;
;;; Path A specializes this per (K V) at the `Eq [MutableMap]` dispatch site; the
;;; self-tail-recursive spec is turned into a loop by the C compiler's
;;; sibling-call optimization (the same shape as `vec-eq-loop`'s typed spec), so
;;; a large table iterates in constant stack (verified: a 200k-entry `.eq?` runs
;;; in a 512KB stack).  Unlike the inline-C `mutmap-eq-storage?` carrier core
;;; (kept for the public `mutmap-eq?` wrapper / abstract callers), the receivers
;;; flow by their honest `(MutableMap K V)` type and the iteration is expressed
;;; with the `mutmap-slot-*` accessors -- no fat-closure inline-C dispatch.  For
;;; each live slot of m1 the matching key is looked up in m2 (via
;;; mutmap-has?/mutmap-get) and the values compared by val-cmp.
;;;
;;; Parameters:
;;;   m1      -- first MutableMap[K V]
;;;   m2      -- second MutableMap[K V]
;;;   i       -- current slot index (start at 0)
;;;   cap     -- slot bound (mutmap-cap m1)
;;;   val-cmp -- value comparator fn [a :V b :V] :bool
;;;
;;; Returns:
;;;   true iff every live entry of m1[i..cap) is present in m2 with an
;;;   equal value under val-cmp.
;;;
;;; Example:
;;;   (mutmap-eq-loop a b 0 (mutmap-cap a) (fn [x y] (= x y)))
;;;
;;; Since: Phase F5

(defn mutmap-eq-loop [K V] [m1 : (MutableMap K V)
                            m2 : (MutableMap K V)
                            i : int
                            cap : int
                            ^fat val-cmp : (fn [V V] bool)] : bool
  (if (= i cap)
    true
    (if (mutmap-slot-occupied? m1 i)
      (if (mutmap-has? m2 (mutmap-slot-hash m1 i) (mutmap-slot-key m1 i))
        (if (val-cmp (mutmap-slot-value m1 i)
              (mutmap-get m2 (mutmap-slot-hash m1 i) (mutmap-slot-key m1 i)))
          (mutmap-eq-loop m1 m2 (+ i 1) cap val-cmp)
          false)
        false)
      (mutmap-eq-loop m1 m2 (+ i 1) cap val-cmp))))
;;; mutmap-eq? -- structural equality.  Two MutableMap[K V]s are equal iff
;;; they have the same live (key, value) entries (any order) per a supplied
;;; value comparator.  This public wrapper reads each map's K/V-agnostic
;;; `storage` field directly and delegates to the shared inline-C core
;;; (`mutmap-eq-storage?`, a stack-safe C loop) so it is safe for direct /
;;; abstract callers of any size.  The `Eq [MutableMap]` instance instead
;;; dispatches through the pure-Turmeric `mutmap-eq-loop` (TCO'd inside its
;;; by-value spec).
;;;
;;; Parameters:
;;;   m1     -- MutableMap[K V]
;;;   m2     -- MutableMap[K V]
;;;   val-cmp -- comparator fn [a :int b :int] :bool for values
;;;
;;; Returns:
;;;   true iff m1 and m2 have the same set of (key, value) pairs.
;;;
;;; Example:
;;;   (mutmap-eq? ma mb (fn [a b] (= a b)))
;;;
;;; Since: Phase F5

(defn mutmap-eq? [K V W] [m1 : (MutableMap K V)
                          m2 : (MutableMap K V)
                          ^borrow ^fat val-cmp : (fn [W W] bool)]
  #fx{}
  : bool
  (mutmap-eq-storage? (.storage m1) (.storage m2) val-cmp))
;;; mutmap-free -- free the storage and wrapper.
;;;
;;; Parameters:
;;;   m -- MutableMap[K V] to free
;;;
;;; Example:
;;;   (mutmap-free mm)
;;;
;;; Since: Phase F5

(defn mutmap-free [K V] [m : (MutableMap K V)]
  #fx{}
  : void
  ```c
  struct { void *storage; } *mm = (void*)(intptr_t)m;
  if (mm->storage) free(mm->storage);
  free(mm);
  ```)
;;; Eq [MutableMap] -- structural equality using the value type's Eq.
;; Constrained instance: requires Eq[V] for value comparison.  Keys
;; compared by raw int64 equality on the hash + key representation.
;; The cross-plan-followups F3-5 dispatcher synthesises the value
;; comparator at the call site when V is itself a TY_APP.
;;
;; TCO-in-ABI-specs: the instance body is pure Turmeric, mirroring `Eq [Vec]`.
;; Path A specializes `mutmap-eq-loop` to the concrete (K V) and the self-tail-
;; call becomes a goto loop after TCO, so the by-value MutableMap receiver
;; iterates without growing the C stack and without the inline-C fat-closure
;; dispatch of `mutmap-eq-storage?`.  The instance head receiver is bare-
;; `MutableMap`, so each receiver use is ascribed inline to `(MutableMap K V)`
;; (the typed-pointer handle), exactly like `Eq [Vec]`'s `(:: x (Vec A))`.
;; The inline-C `mutmap-eq-storage?` / `mutmap-eq?` pair stays for direct and
;; abstract callers (stack-safe C loop), just as `vec-eq?` stays for Vec.

(definstance Eq [MutableMap]
  [(Eq V)]
  (eq? [x y]
    (and (= (mutmap-len (:: x (MutableMap K V)))
           (mutmap-len (:: y (MutableMap K V))))
      (mutmap-eq-loop (:: x (MutableMap K V))
        (:: y (MutableMap K V))
        0
        (mutmap-cap (:: x (MutableMap K V)))
        (fn [a b] (eq? a b))))))
