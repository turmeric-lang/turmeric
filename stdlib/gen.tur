;;; Since: Phase GF2
;; stdlib/gen.tur -- Generator standard library (GF2)
;; Helpers and macros for consuming and composing generators.
;; Auto-loaded by the compiler alongside stdlib/macros.tur.
;;; gen-some? -- test whether a gen-next result contains a value.
;;;
;;; Parameters:
;;;   p -- void* pointer returned by gen-next
;;;
;;; Returns:
;;;   true if p is non-NULL (a value was yielded), false if the
;;;   generator was exhausted and gen-next returned NULL.
;;;
;;; Example:
;;;   (let [v (gen-next g)]
;;;     (when (gen-some? v) (println (gen-unwrap v))))
;;;
;;; Since: GF2
(defn gen-some? [p : ptr<void>] : bool
  ```c
  return p != NULL;
  ```)
;;; gen-unwrap -- extract the yielded value from a gen-next pointer.
;;;
;;; The compiler treats `gen-unwrap` as a core form: the result is typed at
;;; the generator's element type -- the `T` of its `(Generator T)` (a yielded
;;; 7.25 reads back as a float, a cstr as a cstr, a struct as that struct) --
;;; when the argument is a `(gen-next g)` or a binding that holds one.  This definition is the reader's documented shape and the
;;; interpreter's native fallback; only an opaque pointer of unknown
;;; provenance reads the slot as an int.
;;;
;;; Parameters:
;;;   p -- a non-NULL void* pointer returned by gen-next
;;;
;;; Returns:
;;;   The value that was yielded, at the generator's element type.
;;;
;;; Example:
;;;   (gen-unwrap (gen-next g))  ; => the yielded value
;;;
;;; Since: GF2

(defn gen-unwrap [p : ptr<void>] : int
  ```c
  if (!p) {
    tur_panic("gen-unwrap: the generator is exhausted (test gen-some? before gen-unwrap)");
    return 0;
  }
  return *(int64_t *)p;
  ```)
;;; gen-none -- return a null generator result representing no value.
;;;
;;; Returns:
;;;   NULL as :ptr<void>; test with gen-some? to distinguish from a real value.
;;;
;;; Example:
;;;   (gen-none)  ; => NULL
;;;
;;; Since: GF2

(defn gen-none [] : ptr<void>
  ```c
  return NULL;
  ```)
;; --- Growable int64 array helpers (seq-collect's result) ---
;; Internal layout: int64_t[3] = { len, cap, data_ptr }
;; gen-collect returns a typed (Vec T) instead; these stay for seq-collect,
;; whose elements are carrier words.
;;; gen-arr-new -- allocate an empty int64 array (the seq-collect result).
;;;
;;; Returns:
;;;   Opaque pointer to an empty array (len=0).
;;;
;;; Example:
;;;   (let [a (gen-arr-new)] ...)
;;;
;;; Since: GF2


(defn gen-arr-new [] : int
  ```c
  int64_t *h = (int64_t *)malloc(3 * sizeof(int64_t));
  h[0] = 0; h[1] = 0; h[2] = 0;
  return (int64_t)(intptr_t)h;
  ```)
;;; gen-arr-push! -- append val to the end of a gen-arr array.
;;;
;;; Parameters:
;;;   a   -- array pointer returned by gen-arr-new
;;;   val -- int64_t value to append
;;;
;;; Example:
;;;   (gen-arr-push! my-arr 42)
;;;
;;; Since: GF2

(defn gen-arr-push! [a val] : nil
  ```c
  int64_t *h = (int64_t *)(intptr_t)a;
  if (h[0] >= h[1]) {
    int64_t nc = h[1] ? h[1] * 2 : 4;
    int64_t *nd = (int64_t *)malloc((size_t)nc * sizeof(int64_t));
    if (h[1]) {
      int64_t *od = (int64_t *)(intptr_t)h[2];
      for (int64_t k = 0; k < h[0]; k++) nd[k] = od[k];
      free(od);
    }
    h[1] = nc; h[2] = (int64_t)(intptr_t)nd;
  }
  int64_t *data = (int64_t *)(intptr_t)h[2];
  TUR_REGION_NOTE(val);   /* region-lock-hardening: see vec-push! */
  data[h[0]++] = val;
  ```)
;;; gen-arr-len -- return the number of elements in a gen-arr array.
;;;
;;; Parameters:
;;;   a -- array pointer returned by gen-arr-new
;;;
;;; Returns:
;;;   Number of collected elements.
;;;
;;; Example:
;;;   (gen-arr-len my-arr)  ; => 3
;;;
;;; Since: GF2

(defn gen-arr-len [a] : int
  ```c
  int64_t *h = (int64_t *)(intptr_t)a;
  return h[0];
  ```)
;;; gen-arr-get -- return the element at index i in a gen-arr array.
;;;
;;; Parameters:
;;;   a -- array pointer returned by gen-arr-new
;;;   i -- zero-based index
;;;
;;; Returns:
;;;   The int64_t value stored at position i.
;;;
;;; Example:
;;;   (gen-arr-get my-arr 0)  ; => first element
;;;
;;; Since: GF2

(defn gen-arr-get [a i] : int
  ```c
  int64_t *h = (int64_t *)(intptr_t)a;
  int64_t *data = (int64_t *)(intptr_t)h[2];
  return data[i];
  ```)
;;; gen-collect -- materialise all yielded values into a vector.
;;;
;;; Parameters:
;;;   g -- a generator expression
;;;
;;; Returns:
;;;   A (Vec T) holding every value g yields, in order, typed at the
;;;   generator's element type T (int, float, cstr, a struct, ...).
;;;   Iterate with vec-len and vec-get.
;;;
;;; Example:
;;;   (let [arr (gen-collect (gen [] (yield 1.5) (yield 2.5)))]
;;;     (println (vec-get arr 1)))  ; => 2.5
;;;
;;; Since: GF2

(defmacro gen-collect [g]
  (let [gv  (gensym gv)
        res (gensym res)
        it  (gensym it)]
    (list let
      (vec gv g res (list vec-new))
      (list while
        (list not (list gen-done? gv))
        (list let
          (vec it (list gen-next gv))
          (list when
            (list gen-some? it)
            (list vec-push! res (list gen-unwrap it)))))
      res)))
;;; gen-for-each -- call f with every value yielded by a generator.
;;;
;;; Parameters:
;;;   f -- a one-argument callable applied to each yielded value
;;;   g -- a generator expression
;;;
;;; Example:
;;;   (gen-for-each println my-gen)
;;;
;;; Since: GF2

(defmacro gen-for-each [f g]
  (let [gv (gensym gv)
        it (gensym it)]
    (list let
      (vec gv g)
      (list while
        (list not (list gen-done? gv))
        (list let
          (vec it (list gen-next gv))
          (list when (list gen-some? it) (list f (list gen-unwrap it))))))))
;;; gen-nth -- return the nth (0-indexed) yielded value, or gen-none.
;;;
;;; Parameters:
;;;   n -- zero-based index
;;;   g -- a generator expression
;;;
;;; Returns:
;;;   The raw void* pointer from gen-next at position n, or gen-none (NULL)
;;;   if the generator has fewer than n+1 values.
;;;   Test with gen-some? and extract with gen-unwrap.
;;;
;;; Example:
;;;   (let [v (gen-nth 2 my-gen)]
;;;     (when (gen-some? v) (println (gen-unwrap v))))
;;;
;;; Since: GF2

(defmacro gen-nth [n g]
  (let [gv (gensym gv)
        i  (gensym i)]
    (list let
      (vec gv g ^mut i 0)
      (list while
        (list and (list not (list gen-done? gv)) (list < i n))
        (list gen-next gv)
        (list set! i (list + i 1)))
      (list if (list gen-done? gv) (list gen-none) (list gen-next gv)))))
;;; yield* -- re-yield every value from an inner generator.
;;;
;;; Parameters:
;;;   inner -- a generator expression whose values are to be forwarded
;;;
;;; Example:
;;;   (gen []
;;;     (yield* inner-gen)
;;;     (yield 99))
;;;
;;; Since: GF2

(defmacro yield* [inner]
  (let [gv (gensym gv)
        v  (gensym v)]
    (list let
      (vec gv inner)
      (list while
        (list not (list gen-done? gv))
        (list let
          (vec v (list gen-next gv))
          (list when (list gen-some? v) (list yield (list gen-unwrap v))))))))
