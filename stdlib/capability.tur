;;; tur/capability -- capability-passing vtables for controlled side-effect injection.
;;;
;;; Capability types are structs of C function pointers, passed explicitly to
;;; functions that need a side effect. Each is an opaque handle -- FileSystem,
;;; Logger, Random, Time -- built by a make-* constructor from four (or two)
;;; `c-fn` callbacks and released by the matching *-free.
;;;
;;; The vtable layouts are the ones the stdlib implementations fill:
;;; `Real-FileSystem` (stdlib/io.tur) returns a FileSystem these helpers call,
;;; and `Real-Time` / `Mock-Time` (the `time` module) return the same Time.
;;;
;;; Since: Phase 16
;; Phase 16: Capability passing (v1 effects)
;;
;; Capability types are ordinary structs with function pointer fields.
;; They enable zero-cost dependency injection and mocking.
;;
;; stdlib-capability-vtables-uncompilable: the four structs used to be declared
;; INSIDE their own `*-type` defns, which gives a struct tag block scope -- every
;; other body then named a fresh, incomplete type, and no conforming C compiler
;; accepts `sizeof` or `->` on one. They live here, at file scope, where every
;; body below (and every implementation module that fills them) can see them.
(load "stdlib/time.tur")

```c
/* FileSystem: all callbacks return an error code (0 = success). */
/* The callback types are spelled exactly as the `c-fn` parameter types of
 * make-FileSystem emit them (`ptr<u8>` is `uint8_t *`, `ptr<void>` is `void *`,
 * no `const`): a callback is CALLED through these, and an indirect call
 * through a pointer of another type is undefined (a -fsanitize=function trap,
 * a call_indirect trap on WASM).  stdlib/io.tur's Real-FileSystem fills the
 * same layout and spells its functions the same way. */
typedef struct __tur_cap_fs {
    int (*read_file)(const char* path, unsigned char* buf, int buf_len, int* out_len);
    int (*write_file)(const char* path, unsigned char* data, int data_len);
    int (*delete)(const char* path);
    int (*list)(const char* path, void* entries, int max_entries, int* out_count);
} __tur_cap_fs;

typedef struct __tur_cap_logger {
    void (*debug)(const char* msg);
    void (*info)(const char* msg);
    void (*warn)(const char* msg);
    void (*error)(const char* msg);
} __tur_cap_logger;

/* next_float answers in [0, 10000); divide by 10000.0 for [0.0, 1.0). */
typedef struct __tur_cap_random {
    int (*next_int)(int min, int max);
    int (*next_float)(void);
} __tur_cap_random;

/* now: milliseconds since the epoch.  Same layout as the time module's
 * __tur_time_cap, so a Real-Time / Mock-Time handle is read here directly. */
typedef struct __tur_cap_time {
    int (*now)(void);
    void (*sleep)(int ms);
} __tur_cap_time;
```
;; ============================================================================
;; Capability handle types
;; ============================================================================
;;; FileSystem -- opaque handle to a FileSystem capability vtable.
;;;
;;; Built by make-FileSystem (or stdlib/io.tur's Real-FileSystem); released by
;;; the matching *-free.
;;;
;;; Since: Phase 16
(defopaque FileSystem :ptr<void>)
;;; Logger -- opaque handle to a Logger capability vtable (debug/info/warn/error).
;;;
;;; Since: Phase 16
(defopaque Logger :ptr<void>)
;;; Random -- opaque handle to a Random capability vtable (next-int/next-float).
;;;
;;; Since: Phase 16
(defopaque Random :ptr<void>)
;; ============================================================================
;; FileSystem capability
;; ============================================================================
;;; make-FileSystem -- construct a FileSystem capability from four C callbacks.
;;;
;;; The callbacks are bare C-ABI function pointers with the vtable's own
;;; signatures, so a `defn` spelled with `i32` / `ptr<u8>` / `ptr<i32>`
;;; parameters (or a C function) can be passed directly.
;;;
;;; Parameters:
;;;   read_fn   -- (path buf buf_len out_len) -> error code
;;;   write_fn  -- (path data data_len) -> error code
;;;   delete_fn -- (path) -> error code
;;;   list_fn   -- (path entries max_entries out_count) -> error code
;;;
;;; Returns:
;;;   A heap-allocated FileSystem capability; free with FileSystem-free.
;;;
;;; Example:
;;;   (def fs (make-FileSystem my-read my-write my-delete my-list))
;;;
;;; Since: Phase 16

(defn make-FileSystem [read_fn : (c-fn [cstr ptr<u8> i32 ptr<i32>] i32)
                       write_fn : (c-fn [cstr ptr<u8> i32] i32)
                       delete_fn : (c-fn [cstr] i32)
                       list_fn : (c-fn [cstr ptr<void> i32 ptr<i32>] i32)] : FileSystem
  ```c
  __tur_cap_fs* fs = (__tur_cap_fs*)malloc(sizeof(__tur_cap_fs));
  fs->read_file = (int (*)(const char*, unsigned char*, int, int*))read_fn;
  fs->write_file = (int (*)(const char*, unsigned char*, int))write_fn;
  fs->delete = (int (*)(const char*))delete_fn;
  fs->list = (int (*)(const char*, void*, int, int*))list_fn;
  return (void*)fs;
  ```)
;;; FileSystem-free -- free a FileSystem capability allocated by make-FileSystem.
;;;
;;; Parameters:
;;;   fs -- FileSystem from make-FileSystem
;;;
;;; Example:
;;;   (FileSystem-free fs)
;;;
;;; Since: Phase 16

(defn FileSystem-free [fs : FileSystem] : nil
  ```c
  free(fs);
  ```)
;; ============================================================================
;; Logger capability
;; ============================================================================
;;; make-Logger -- construct a Logger capability from four C callbacks (debug/info/warn/error).
;;;
;;; Parameters:
;;;   debug_fn -- (msg) -> nil
;;;   info_fn  -- (msg) -> nil
;;;   warn_fn  -- (msg) -> nil
;;;   error_fn -- (msg) -> nil
;;;
;;; Returns:
;;;   A heap-allocated Logger capability; free with Logger-free.
;;;
;;; Example:
;;;   (def lg (make-Logger on-debug on-info on-warn on-error))
;;;
;;; Since: Phase 16

(defn make-Logger [debug_fn : (c-fn [cstr] nil)
                   info_fn : (c-fn [cstr] nil)
                   warn_fn : (c-fn [cstr] nil)
                   error_fn : (c-fn [cstr] nil)] : Logger
  ```c
  __tur_cap_logger* logger = (__tur_cap_logger*)malloc(sizeof(__tur_cap_logger));
  logger->debug = (void (*)(const char*))debug_fn;
  logger->info = (void (*)(const char*))info_fn;
  logger->warn = (void (*)(const char*))warn_fn;
  logger->error = (void (*)(const char*))error_fn;
  return (void*)logger;
  ```)
;;; Logger-free -- free a Logger capability allocated by make-Logger.
;;;
;;; Parameters:
;;;   log -- Logger from make-Logger
;;;
;;; Example:
;;;   (Logger-free lg)
;;;
;;; Since: Phase 16

(defn Logger-free [log : Logger] : nil
  ```c
  free(log);
  ```)
;; ============================================================================
;; Random capability
;; ============================================================================
;;; make-Random -- construct a Random capability from two C callbacks.
;;;
;;; Parameters:
;;;   next_int_fn   -- (min max) -> an integer in [min, max]
;;;   next_float_fn -- () -> an integer in [0, 10000) representing a float
;;;
;;; Returns:
;;;   A heap-allocated Random capability; free with Random-free.
;;;
;;; Example:
;;;   (def rng (make-Random my-next-int my-next-float))
;;;
;;; Since: Phase 16

(defn make-Random [next_int_fn : (c-fn [i32 i32] i32)
                   next_float_fn : (c-fn [] i32)] : Random
  ```c
  __tur_cap_random* rng = (__tur_cap_random*)malloc(sizeof(__tur_cap_random));
  rng->next_int = (int (*)(int, int))next_int_fn;
  rng->next_float = (int (*)(void))next_float_fn;
  return (void*)rng;
  ```)
;;; Random-free -- free a Random capability allocated by make-Random.
;;;
;;; Parameters:
;;;   rng -- Random from make-Random
;;;
;;; Example:
;;;   (Random-free rng)
;;;
;;; Since: Phase 16

(defn Random-free [rng : Random] : nil
  ```c
  free(rng);
  ```)
;; ============================================================================
;; Time capability
;; ============================================================================
;;; make-Time -- construct a Time capability from two C callbacks.
;;;
;;; The handle type is the `time` module's Time, so a Real-Time or Mock-Time
;;; handle and one built here are interchangeable.
;;;
;;; Parameters:
;;;   now_fn   -- () -> current time in milliseconds since epoch
;;;   sleep_fn -- (ms) -> nil; sleeps for ms milliseconds
;;;
;;; Returns:
;;;   A heap-allocated Time capability; free with Time-free.
;;;
;;; Example:
;;;   (def clock (make-Time my-now my-sleep))
;;;
;;; Since: Phase 16

(defn make-Time [now_fn : (c-fn [] i32) sleep_fn : (c-fn [i32] nil)] : Time
  ```c
  __tur_cap_time* time = (__tur_cap_time*)malloc(sizeof(__tur_cap_time));
  time->now = (int (*)(void))now_fn;
  time->sleep = (void (*)(int))sleep_fn;
  return (void*)time;
  ```)
;;; Time-free -- free a Time capability allocated by make-Time.
;;;
;;; Parameters:
;;;   t -- Time from make-Time
;;;
;;; Example:
;;;   (Time-free clock)
;;;
;;; Since: Phase 16

(defn Time-free [t : Time] : nil
  ```c
  free(t);
  ```)
;; ============================================================================
;; Convenience macros
;; ============================================================================
;;; with-capability -- bind capabilities and evaluate body with them in scope.
;;;
;;; Takes a `let`-shaped binding vector, like every other `with-*` form.
;;;
;;; Parameters:
;;;   bindings -- a binding vector [name cap-expr ...]
;;;   body     -- forms to evaluate with the bindings in scope
;;;
;;; Example:
;;;   (with-capability [fs (make-FileSystem r w d l)] (fs-delete fs "data.txt"))
;;;
;;; Since: Phase 16


(defmacro with-capability [bindings & body] `(let ~bindings (do ~@body)))
;; default-capability: returns the default implementation for a capability type
;; For now, this just returns NULL - users should provide their own defaults
;;; default-capability -- return the default implementation for a capability type (currently always nil).
;;;
;;; Parameters:
;;;   type_name -- symbolic name of the capability type (unused in v1)
;;;
;;; Since: Phase 16

(defn default-capability [type_name] nil)
;; ============================================================================
;; Helper functions for using capabilities
;; ============================================================================
;;; fs-read -- call read_file on a FileSystem capability.
;;;
;;; Parameters:
;;;   fs      -- FileSystem capability
;;;   path    -- file path to read
;;;   buf     -- output buffer
;;;   buf_len -- size of buf in bytes
;;;
;;; Returns:
;;;   0 on success, non-zero on error (as returned by the underlying read_file fn).
;;;
;;; Example:
;;;   (fs-read fs "data.txt" buf 64)  ; => 0
;;;
;;; Since: Phase 16


(defn fs-read [fs : FileSystem path : cstr buf : ptr<void> buf_len : int] : int
  ```c
  __tur_cap_fs* f = (__tur_cap_fs*)fs;
  int out_len;
  return f->read_file(path, (unsigned char*)buf, (int)buf_len, &out_len);
  ```)
;;; fs-write -- call write_file on a FileSystem capability.
;;;
;;; Parameters:
;;;   fs       -- FileSystem capability
;;;   path     -- file path to write
;;;   data     -- data buffer
;;;   data_len -- number of bytes to write
;;;
;;; Returns:
;;;   0 on success, non-zero on error.
;;;
;;; Example:
;;;   (fs-write fs "data.txt" buf 5)  ; => 0
;;;
;;; Since: Phase 16

(defn fs-write [fs : FileSystem path : cstr data : ptr<void> data_len : int] : int
  ```c
  __tur_cap_fs* f = (__tur_cap_fs*)fs;
  return f->write_file(path, (unsigned char*)data, (int)data_len);
  ```)
;;; fs-delete -- call delete on a FileSystem capability.
;;;
;;; Parameters:
;;;   fs   -- FileSystem capability
;;;   path -- path of the file to delete
;;;
;;; Returns:
;;;   0 on success, non-zero on error.
;;;
;;; Example:
;;;   (fs-delete fs "data.txt")  ; => 0
;;;
;;; Since: Phase 16

(defn fs-delete [fs : FileSystem path : cstr] : int
  ```c
  __tur_cap_fs* f = (__tur_cap_fs*)fs;
  return f->delete(path);
  ```)
;;; fs-list -- call list on a FileSystem capability.
;;;
;;; Parameters:
;;;   fs          -- FileSystem capability
;;;   path        -- directory path to list
;;;   entries     -- output buffer for entry name pointers (char **)
;;;   max_entries -- capacity of entries buffer
;;;
;;; Returns:
;;;   The underlying list fn's error code (0 on success).
;;;
;;; Example:
;;;   (fs-list fs "." entries 16)  ; => 0
;;;
;;; Since: Phase 16

(defn fs-list [fs : FileSystem
               path : cstr
               entries : ptr<void>
               max_entries : int] : int
  ```c
  __tur_cap_fs* f = (__tur_cap_fs*)fs;
  int out_count;
  return f->list(path, (void*)entries, (int)max_entries, &out_count);
  ```)
;;; log-debug -- emit a debug-level log message via a Logger capability.
;;;
;;; Parameters:
;;;   log -- Logger capability
;;;   msg -- message string to log
;;;
;;; Example:
;;;   (log-debug lg "starting")
;;;
;;; Since: Phase 16

(defn log-debug [log : Logger msg : cstr] : nil
  ```c
  ((__tur_cap_logger*)log)->debug(msg);
  ```)
;;; log-info -- emit an info-level log message via a Logger capability.
;;;
;;; Parameters:
;;;   log -- Logger capability
;;;   msg -- message string to log
;;;
;;; Example:
;;;   (log-info lg "ready")
;;;
;;; Since: Phase 16

(defn log-info [log : Logger msg : cstr] : nil
  ```c
  ((__tur_cap_logger*)log)->info(msg);
  ```)
;;; log-warn -- emit a warning-level log message via a Logger capability.
;;;
;;; Parameters:
;;;   log -- Logger capability
;;;   msg -- message string to log
;;;
;;; Example:
;;;   (log-warn lg "disk nearly full")
;;;
;;; Since: Phase 16

(defn log-warn [log : Logger msg : cstr] : nil
  ```c
  ((__tur_cap_logger*)log)->warn(msg);
  ```)
;;; log-error -- emit an error-level log message via a Logger capability.
;;;
;;; Parameters:
;;;   log -- Logger capability
;;;   msg -- message string to log
;;;
;;; Example:
;;;   (log-error lg "write failed")
;;;
;;; Since: Phase 16

(defn log-error [log : Logger msg : cstr] : nil
  ```c
  ((__tur_cap_logger*)log)->error(msg);
  ```)
;;; rng-next-int -- return a random integer in [min, max] from a Random capability.
;;;
;;; Parameters:
;;;   rng -- Random capability
;;;   min -- inclusive lower bound
;;;   max -- inclusive upper bound
;;;
;;; Returns:
;;;   A random integer in [min, max].
;;;
;;; Example:
;;;   (rng-next-int rng 1 6)  ; => 4
;;;
;;; Since: Phase 16

(defn rng-next-int [rng : Random min : int max : int] : int
  ```c
  return ((__tur_cap_random*)rng)->next_int((int)min, (int)max);
  ```)
;;; rng-next-float -- return a random pseudo-float in [0, 10000) from a Random capability.
;;;
;;; Parameters:
;;;   rng -- Random capability
;;;
;;; Returns:
;;;   Integer in [0, 10000); divide by 10000.0 to get a float in [0.0, 1.0).
;;;
;;; Example:
;;;   (rng-next-float rng)  ; => 2500
;;;
;;; Since: Phase 16

(defn rng-next-float [rng : Random] : int
  ```c
  return ((__tur_cap_random*)rng)->next_float();
  ```)
;;; time-now -- return the current time in milliseconds since epoch from a Time capability.
;;;
;;; Parameters:
;;;   t -- Time capability
;;;
;;; Returns:
;;;   Current time as an integer (milliseconds since epoch).
;;;
;;; Example:
;;;   (time-now clock)  ; => 1000
;;;
;;; Since: Phase 16

(defn time-now [t : Time] : int
  ```c
  return ((__tur_cap_time*)t)->now();
  ```)
;;; time-sleep -- sleep for ms milliseconds via a Time capability.
;;;
;;; Parameters:
;;;   t  -- Time capability
;;;   ms -- duration in milliseconds
;;;
;;; Example:
;;;   (time-sleep clock 250)
;;;
;;; Since: Phase 16

(defn time-sleep [t : Time ms : int] : nil
  ```c
  ((__tur_cap_time*)t)->sleep((int)ms);
  ```)
