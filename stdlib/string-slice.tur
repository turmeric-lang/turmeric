;;; tur/string-slice -- StringSlice: a zero-copy, bounds-checked view into a String.
;;;
;;; A `StringSlice` is a `{ parent String; offset; len }` view that RETAINS its
;;; parent String.  Because `String` is immutable and refcounted, the borrowed
;;; byte range stays valid and unchanging for the slice's lifetime -- so this is
;;; genuinely safe zero-copy ranged access, unlike a raw pointer+len view over a
;;; `cstr` whose backing buffer can be freed or mutated underneath it.
;;;
;;; Sub-slicing (`slice/sub`) is O(1): a new view over the same parent. Indexing
;;; (`slice/byte-at`) is bounds-checked (returns -1 out of range). Materialize to
;;; an owned `String` (`slice/to-string`) or a fresh `cstr` (`slice/to-cstr`)
;;; only at the boundary where you need one.
;;;
;;; This supersedes the inert borrowed-view `str` (stdlib/str.tur) for the safe,
;;; owned case: prefer a `String` + `StringSlice` when the view must not outlive
;;; -- or be invalidated by -- its source. `str` remains for zero-ownership
;;; interop over a caller-managed buffer.
;;;
;;; Every op has an interpreter native (src/turi/string_native.c), so
;;; `StringSlice` behaves identically compiled and under --interpret.
;;;
;;; Since: v2 (owned-string-type-plan -- String slices)
(load "stdlib/string.tur")

(load "stdlib/typeclass.tur")

(load "stdlib/typeclass-show.tur")

(load "stdlib/typeclass-hash.tur")
;; ---- Opaque handle newtype -------------------------------------------------

(defopaque StringSlice :ptr<void>)
;; ---- Runtime primitives (src/runtime/tur_string.c) -------------------------

(extern-c tur_string_slice [s :ptr off :int len :int] :ptr)

(extern-c tur_string_slice_cstr [s :cstr off :int len :int] :ptr)

(extern-c tur_slice_retain [sl :ptr] :ptr)

(extern-c tur_slice_release [sl :ptr] :void)

(extern-c tur_slice_len [sl :ptr] :int)

(extern-c tur_slice_empty [sl :ptr] :bool)

(extern-c tur_slice_byte_at [sl :ptr i :int] :int)

(extern-c tur_slice_sub [sl :ptr off :int len :int] :ptr)

(extern-c tur_slice_to_string [sl :ptr] :ptr)

(extern-c tur_slice_to_cstr [sl :ptr] :cstr)

(extern-c tur_slice_eq [a :ptr b :ptr] :bool)

(extern-c tur_slice_cmp [a :ptr b :ptr] :int)

(extern-c tur_slice_hash [sl :ptr] :int)
;; ---- Construction ----------------------------------------------------------
;;; string/slice -- a zero-copy view of String s over bytes [off, off+len).
;;;
;;; The slice retains s, so the range stays valid until the slice is released.
;;; off/len are clamped to s's bounds, so the result is always a valid view.
;;;
;;; Parameters:
;;;   s   -- the parent String (retained by the slice)
;;;   off -- start byte offset (clamped into [0, len s])
;;;   len -- number of bytes (clamped so off+len <= len s)
;;;
;;; Returns:
;;;   A StringSlice viewing the requested range.
;;;
;;; Example:
;;;   (slice/to-cstr (string/slice (string/from-cstr "hello world") 6 5))  ; => "world"
;;;
;;; Since: v2

(defn string/slice [s : String off : int len : int] : StringSlice
  (:: (tur_string_slice (:: s ptr<void>) off len) StringSlice))
;;; string/slice-cstr -- slice a raw cstr safely by copying it into an owned
;;; String the slice solely owns (freed when the slice is released).
;;;
;;; Use this to get safe ranged access to a cstr without worrying about the
;;; cstr's lifetime: the bytes are copied once, and the copy lives exactly as
;;; long as the slice (and its sub-slices).
;;;
;;; Since: v2

(defn string/slice-cstr [s : cstr off : int len : int] : StringSlice
  (:: (tur_string_slice_cstr s off len) StringSlice))
;; ---- Refcount --------------------------------------------------------------
;;; slice/retain -- increment the slice's refcount, returning a second handle.
;;;
;;; Since: v2

(defn slice/retain [sl : StringSlice] : StringSlice
  (:: (tur_slice_retain (:: sl ptr<void>)) StringSlice))
;;; slice/release -- decrement the slice's refcount; at zero, release the parent.
;;;
;;; Since: v2

(defn slice/release [sl : StringSlice] : void
  (tur_slice_release (:: sl ptr<void>)))
;; ---- Queries ---------------------------------------------------------------
;;; slice/len -- byte length of the slice.
;;;
;;; Since: v2

(defn slice/len [sl : StringSlice] : int (tur_slice_len (:: sl ptr<void>)))
;;; slice/empty? -- true iff the slice has length zero.
;;;
;;; Since: v2

(defn slice/empty? [sl : StringSlice] : bool
  (tur_slice_empty (:: sl ptr<void>)))
;;; slice/byte-at -- the byte (0..255) at index i, or -1 if out of range.
;;;
;;; Since: v2

(defn slice/byte-at [sl : StringSlice i : int] : int
  (tur_slice_byte_at (:: sl ptr<void>) i))
;;; slice/byte-is? -- is the byte at index i of the slice the character c?
;;;
;;; string/byte-is? for a slice.  The index is relative to the slice, and so
;;; is the bounds check: a byte of the parent String outside the view is out
;;; of range.  c should be ASCII, as for string/byte-is?.
;;;
;;; Parameters:
;;;   sl -- the slice to look in (borrowed)
;;;   i  -- a byte index into the slice; out of range is not an error
;;;   c  -- the character to compare with
;;;
;;; Returns:
;;;   true iff 0 <= i < (slice/len sl) and the byte at i is c's code.
;;;
;;; Example:
;;;   (slice/byte-is? (string/slice (string/from-cstr "a,b") 1 2) 0 #\,)  ; => true
;;;
;;; Since: markdown-library-plan S1
(defn slice/byte-is? [sl : StringSlice i : int c : Char] : bool
  (= (slice/byte-at sl i) (char->int c)))
;;; slice/char-at -- the byte at index i of the slice as a Char, or (none).
;;;
;;; string/char-at for a slice; the index and the bounds are the slice's.
;;;
;;; Parameters:
;;;   sl -- the slice to look in (borrowed)
;;;   i  -- a byte index into the slice; out of range is not an error
;;;
;;; Returns:
;;;   (some c) holding the byte at i, or (none) when i is out of range.
;;;
;;; Example:
;;;   (slice/char-at (string/slice (string/from-cstr "hi") 1 1) 0)  ; => (some #\i)
;;;
;;; Since: markdown-library-plan S1
(defn slice/char-at [sl : StringSlice i : int] : (Option Char)
  (let [b (slice/byte-at sl i)] (if (< b 0) (none) (some (int->char b)))))
;; ---- Search (markdown-library-plan S2) -------------------------------------
;; The string/ search functions for a slice.  Offsets, bounds and results are
;; the slice's own, not its parent's.  The needle is a String: in a parser the
;; haystack is a slice of the document and the needle is usually a literal.
;; None of these allocates.
;;; slice/-match-at -- internal: do bytes [k, n) of p equal sl's from at+k on?

(defn slice/-match-at [sl : StringSlice p : String at : int k : int n : int] : bool
  (if (>= k n)
    true
    (if (= (slice/byte-at sl (+ at k)) (string/byte-at p k))
      (slice/-match-at sl p at (+ k 1) n)
      false)))
;;; slice/starts-with-at? -- does prefix occur in the slice at byte offset at?
;;;
;;; string/starts-with-at? for a slice.
;;;
;;; Parameters:
;;;   sl     -- the slice to look in (borrowed)
;;;   prefix -- the bytes to look for (borrowed)
;;;   at     -- the byte offset in the slice to test
;;;
;;; Returns:
;;;   true iff the slice's bytes from at on begin with prefix.
;;;
;;; Example:
;;;   (slice/starts-with-at? (string/slice (string/from-cstr "x <!-- y") 2 6) (string/from-cstr "<!--") 0)  ; => true
;;;
;;; Since: markdown-library-plan S2
(defn slice/starts-with-at? [sl : StringSlice prefix : String at : int] : bool
  (let [n (string/len prefix)]
    (and (>= at 0)
      (<= (+ at n) (slice/len sl))
      (slice/-match-at sl prefix at 0 n))))
;;; slice/-index-of-loop -- internal: first match of needle at i..last.

(defn slice/-index-of-loop [sl : StringSlice needle : String i : int last : int] : (Option int)
  (if (> i last)
    (none)
    (if (slice/starts-with-at? sl needle i)
      (some i)
      (slice/-index-of-loop sl needle (+ i 1) last))))
;;; slice/index-of-from -- offset of the first needle at or after start.
;;;
;;; string/index-of-from for a slice.
;;;
;;; Parameters:
;;;   sl     -- the slice to search (borrowed)
;;;   needle -- the bytes to find (borrowed)
;;;   start  -- the first slice offset a match may begin at
;;;
;;; Returns:
;;;   (some i) for the lowest i >= start where needle occurs, else (none).
;;;
;;; Example:
;;;   (slice/index-of-from (string/slice (string/from-cstr "a,b,c") 0 5) (string/from-cstr ",") 2)  ; => (some 3)
;;;
;;; Since: markdown-library-plan S2
(defn slice/index-of-from [sl : StringSlice needle : String start : int] : (Option int)
  (slice/-index-of-loop sl
    needle
    (if (< start 0) 0 start)
    (- (slice/len sl) (string/len needle))))
;;; slice/index-of -- offset of the first occurrence of needle in the slice.
;;;
;;; string/index-of for a slice.
;;;
;;; Parameters:
;;;   sl     -- the slice to search (borrowed)
;;;   needle -- the bytes to find (borrowed)
;;;
;;; Returns:
;;;   (some i) for the lowest i where needle occurs, or (none).
;;;
;;; Example:
;;;   (slice/index-of (string/slice (string/from-cstr "<p>a</p>") 3 5) (string/from-cstr "</"))  ; => (some 1)
;;;
;;; Since: markdown-library-plan S2
(defn slice/index-of [sl : StringSlice needle : String] : (Option int)
  (slice/index-of-from sl needle 0))
;;; slice/-last-index-of-loop -- internal: last match of needle at i down to 0.

(defn slice/-last-index-of-loop [sl : StringSlice needle : String i : int] : (Option int)
  (if (< i 0)
    (none)
    (if (slice/starts-with-at? sl needle i)
      (some i)
      (slice/-last-index-of-loop sl needle (- i 1)))))
;;; slice/last-index-of -- offset of the last occurrence of needle in the slice.
;;;
;;; string/last-index-of for a slice.
;;;
;;; Parameters:
;;;   sl     -- the slice to search (borrowed)
;;;   needle -- the bytes to find (borrowed)
;;;
;;; Returns:
;;;   (some i) for the highest i where needle occurs, or (none).
;;;
;;; Example:
;;;   (slice/last-index-of (string/slice (string/from-cstr "a/b/c/") 0 5) (string/from-cstr "/"))  ; => (some 3)
;;;
;;; Since: markdown-library-plan S2
(defn slice/last-index-of [sl : StringSlice needle : String] : (Option int)
  (slice/-last-index-of-loop sl needle (- (slice/len sl) (string/len needle))))
;;; slice/-index-of-byte-loop -- internal: first i in [i, n) holding byte b.

(defn slice/-index-of-byte-loop [sl : StringSlice b : int i : int n : int] : (Option int)
  (if (>= i n)
    (none)
    (if (= (slice/byte-at sl i) b)
      (some i)
      (slice/-index-of-byte-loop sl b (+ i 1) n))))
;;; slice/index-of-char-from -- offset of the first c at or after start.
;;;
;;; string/index-of-char-from for a slice.
;;;
;;; Parameters:
;;;   sl    -- the slice to search (borrowed)
;;;   c     -- the character to find (ASCII)
;;;   start -- the first slice offset to look at
;;;
;;; Returns:
;;;   (some i) for the lowest i >= start holding c, or (none).
;;;
;;; Example:
;;;   (slice/index-of-char-from (string/slice (string/from-cstr "a]b]") 0 4) #\] 2)  ; => (some 3)
;;;
;;; Since: markdown-library-plan S2
(defn slice/index-of-char-from [sl : StringSlice c : Char start : int] : (Option int)
  (slice/-index-of-byte-loop sl
    (char->int c)
    (if (< start 0) 0 start)
    (slice/len sl)))
;;; slice/index-of-char -- offset of the first c in the slice.
;;;
;;; string/index-of-char for a slice.
;;;
;;; Parameters:
;;;   sl -- the slice to search (borrowed)
;;;   c  -- the character to find (ASCII)
;;;
;;; Returns:
;;;   (some i) for the lowest i holding c, or (none).
;;;
;;; Example:
;;;   (slice/index-of-char (string/slice (string/from-cstr "x [a] y") 2 3) #\])  ; => (some 2)
;;;
;;; Since: markdown-library-plan S2
(defn slice/index-of-char [sl : StringSlice c : Char] : (Option int)
  (slice/index-of-char-from sl c 0))
;;; slice/-span-loop -- internal: first i in [i, n) whose byte fails pred, else n.

(defn slice/-span-loop [sl : StringSlice
                        pred : (fn [Char] bool)
                        i : int
                        n : int] : int
  (if (>= i n)
    n
    (if (pred (int->char (slice/byte-at sl i)))
      (slice/-span-loop sl pred (+ i 1) n)
      i)))
;;; slice/span-while -- the slice index where a run satisfying pred ends.
;;;
;;; string/span-while for a slice: the run stops at the slice's end, not its
;;; parent's.
;;;
;;; Parameters:
;;;   sl    -- the slice to scan (borrowed)
;;;   start -- the slice offset to start at (clamped into [0, (slice/len sl)])
;;;   pred  -- the test each byte must pass to continue the run
;;;
;;; Returns:
;;;   The end of the run: an index in [start, (slice/len sl)].
;;;
;;; Example:
;;;   (slice/span-while (string/slice (string/from-cstr "x  abc") 1 5) 0 space?)  ; => 2
;;;
;;; Since: markdown-library-plan S2
(defn slice/span-while [sl : StringSlice start : int pred : (fn [Char] bool)] : int
  (let [n (slice/len sl)]
    (slice/-span-loop sl pred (if (< start 0) 0 (if (> start n) n start)) n)))
;;; slice/-run-loop -- internal: first i in [i, n) not holding byte b, else n.

(defn slice/-run-loop [sl : StringSlice b : int i : int n : int] : int
  (if (>= i n)
    n
    (if (= (slice/byte-at sl i) b) (slice/-run-loop sl b (+ i 1) n) i)))
;;; slice/run-length -- how many c in a row start at start in the slice.
;;;
;;; string/run-length for a slice: the run stops at the slice's end.
;;;
;;; Parameters:
;;;   sl    -- the slice to scan (borrowed)
;;;   start -- the slice offset the run starts at
;;;   c     -- the character the run is made of (ASCII)
;;;
;;; Returns:
;;;   The run's length in bytes, 0 or more.
;;;
;;; Example:
;;;   (slice/run-length (string/slice (string/from-cstr "````x") 0 3) 0 #\`)  ; => 3
;;;
;;; Since: markdown-library-plan S2
(defn slice/run-length [sl : StringSlice start : int c : Char] : int
  (let [n (slice/len sl)]
    (if (or (< start 0) (>= start n))
      0
      (- (slice/-run-loop sl (char->int c) start n) start))))
;;; slice/compare -- lexicographic byte compare of two slices: -1, 0, or 1.
;;;
;;; Since: v2

(defn slice/compare [a : StringSlice b : StringSlice] : int
  (tur_slice_cmp (:: a ptr<void>) (:: b ptr<void>)))
;;; slice/eq? -- content equality of two slices.
;;;
;;; Since: v2

(defn slice/eq? [a : StringSlice b : StringSlice] : bool
  (tur_slice_eq (:: a ptr<void>) (:: b ptr<void>)))
;;; slice/hash -- content hash over the slice's byte range.
;;;
;;; Since: v2

(defn slice/hash [sl : StringSlice] : int (tur_slice_hash (:: sl ptr<void>)))
;; ---- Sub-slicing (O(1)) ----------------------------------------------------
;;; slice/sub -- a sub-view [off, off+len) RELATIVE to this slice (clamped).
;;;
;;; O(1): the result views the same parent String; no bytes are copied.
;;;
;;; Example:
;;;   (let [w (string/slice (string/from-cstr "hello world") 6 5)]  ; "world"
;;;     (slice/to-cstr (slice/sub w 0 3)))                          ; => "wor"
;;;
;;; Since: v2

(defn slice/sub [sl : StringSlice off : int len : int] : StringSlice
  (:: (tur_slice_sub (:: sl ptr<void>) off len) StringSlice))
;; ---- Materialization -------------------------------------------------------
;;; slice/to-string -- copy the slice's range into a fresh owned String.
;;;
;;; Since: v2

(defn slice/to-string [sl : StringSlice] : String
  (:: (tur_slice_to_string (:: sl ptr<void>)) String))
;;; slice/to-cstr -- copy the slice's range into a fresh NUL-terminated cstr.
;;;
;;; The result is a freshly heap-allocated cstr (the caller frees it, or adopts
;;; it with string/adopt-cstr).  A slice is not NUL-terminated at its end, so
;;; there is deliberately no borrowed cstr view -- this always copies.
;;;
;;; Since: v2

(defn slice/to-cstr [sl : StringSlice] : cstr
  (tur_slice_to_cstr (:: sl ptr<void>)))
;; ---- Typeclass instances ---------------------------------------------------
;;; Eq [StringSlice] -- content equality (no allocation).

(definstance Eq [StringSlice] (eq? [x y] (slice/eq? x y)))
;;; Ord [StringSlice] -- lexicographic byte ordering.

(definstance Ord [StringSlice]
  (lt? [x y] (< (slice/compare x y) 0))
  (lte? [x y] (<= (slice/compare x y) 0))
  (gt? [x y] (> (slice/compare x y) 0))
  (gte? [x y] (>= (slice/compare x y) 0)))
;;; Show [StringSlice] -- the slice content as a fresh owned String.
;;; slice/to-cstr always mallocs, so adopting it is leak-free.

(definstance Show [StringSlice]
  (show [x] : String (string/adopt-cstr (slice/to-cstr x))))
;;; Hash [StringSlice] -- content hash over the byte range.

(definstance Hash [StringSlice] (hash [x] (slice/hash x)))
