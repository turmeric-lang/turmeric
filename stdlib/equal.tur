;;; tur/equal -- type-equality witness (the refined Equal type) for type-safe coercions.
;;;
;;; (Equal a a) has one constructor Refl. Matching on Refl refines type variable a.
;;;
;;; Since: Phase G3
;; Phase G3: Type equality witnesses
; Equal witnesses type equality: (Equal a a) has one constructor Refl, whose
; result annotation equates the two parameters -- the one stdlib type that is
; refined (AdtDef.is_refined).  Matching on Refl refines the type variable a.
(defdata Equal [a b] (Refl : (Equal a a)))
; Symmetry: if a = a then a = a (trivially via Refl)

(defn equal-sym [eq : Equal] : Equal (match eq (Refl) (Refl)))
; Transitivity: if a = a and a = a then a = a (trivially via Refl)

(defn equal-trans [eq1 : Equal eq2 : Equal] : Equal (match eq1 (Refl) eq2))
;;; equal-cong -- congruence: if a = b then (f a) = (f b) for any f : * -> *.
;;;
;;; Parameters:
;;;   eq -- a proof that a = b
;;;
;;; Returns:
;;;   A proof that (f a) = (f b).
;;;
;;; Example:
;;;   (equal-cong Refl)  ; => Refl
;;;
;;; Since: Phase G4 (requires HKT)

(defn equal-cong [^f eq : (Equal a b)] : (Equal (f a) (f b))
  (match eq (Refl) (Refl)))
