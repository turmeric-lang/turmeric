;;; tur/set -- typed Set[A]: persistent set backed by the HAMT.
;;;
;;; A must satisfy Hash[A] and Eq[A]. Elements are stored as HAMT keys.
;;;
;;; Since: Phase TC2-C
;; Phase TC2-C: Typed Set[A]
;; Persistent set backed by the HAMT. A must satisfy Hash[A] and Eq[A].
;; Elements are stored as HAMT keys; values are always 1 (sentinel).
;; Runtime layout: struct { void *hamt; }
;; Elaboration dependencies. Set[A] needs Eq[A]/Hash[A] (the element
;; typeclasses) and the backing HAMT (the hamt/* iterator + comparator ops the
;; Eq[Set] instance walks). The CLI auto-load prelude already loads these before
;; set.tur, so an already-loaded stdlib module is deduped and these forms are
;; no-ops there; declaring them here makes an isolated `(load "stdlib/set.tur")`
;; -- e.g. from a libturi embedder -- self-sufficient instead of tripping on
;; unknown `hamt/*` names and an undefined `Eq`.
;; See docs/archive/history/interp-load-set-map-elaboration-gap.md.
(load "stdlib/typeclass-eq.tur")

(load "stdlib/typeclass-hash.tur")

(load "stdlib/hamt.tur")
;; set-element-api-generalization: Set now content-keys its elements via
;; Hash[A] + MapKey[A] (mirroring Map), so it depends on map.tur for the MapKey
;; class and its primitive instances (mk-box / mk-cmp / mk-owned?).  The CLI
;; auto-load prelude already loads map.tur before set.tur, so this is a dedup
;; no-op there; declaring it makes set self-sufficient under an isolated
;; `(load "stdlib/set.tur")` and under the interpreter preload (whose order has
;; set before map).  No cycle: map.tur does not load set.tur.

(load "stdlib/map.tur")
;;; Set -- parameterized persistent set with element type A.
;;;
;;; Since: Phase TC2

(defstruct Set :heap [A] (hamt :ptr<void>))
;;; set-new -- create a new empty Set[A].
;;;
;;; Returns:
;;;   An empty Set[A].
;;;
;;; Example:
;;;   (set-new)  ; => empty Set
;;;
;;; Since: Phase TC2

(defn set-new [A] []
  #fx{}
  : (Set A)
  ```c
  struct { void *hamt; } *s = malloc(sizeof(*s));
  s->hamt = tur_hamt_new();
  return (__TUR_RET__)(intptr_t)s;
  ```)
;;; ============================================================================
;;; Raw carrier layer (mirrors map-assoc-eq-o et al.).
;;;
;;; These carry the element already boxed into the int64 carrier (a :int, not
;;; :A) plus an explicit comparator (from MapKey[A].mk-cmp) and ownership flag
;;; (from MapKey[A].mk-owned?), delegating to the ownership-aware HAMT ops.
;;; They are the thin C layer the public Hash/MapKey-dispatched set-add /
;;; set-remove / set-member? below delegate to.  The value slot is always the
;;; sentinel (void*)1 (a Set is a Map to unit).  Element content-equality is
;;; resolved by `keyeq` when two elements share a hash, so distinct pointers
;;; with equal content (e.g. two "hi" strings) are one member; the comparator
;;; is stamped on the resulting HAMT root so structural Eq[Set] recovers it.
;;; ============================================================================
;;; set-add-eq-o -- raw insert: explicit hash, boxed carrier element,
;;; comparator and ownership flag.

(defn set-add-eq-o [A] [s (Set A) h :int x :int keyeq owned :int] : (Set A)
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  void *new_hamt = tur_hamt_set_eq_o(set->hamt, (uint64_t)h, (void*)(intptr_t)x,
                                     (void*)1, (void*)(intptr_t)keyeq, (int64_t)owned);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; set-has-eq-o? -- raw membership test: explicit hash, boxed carrier element.

(defn set-has-eq-o? [A] [s (Set A) h :int x :int keyeq owned :int] : bool
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  return tur_hamt_has_eq_o(set->hamt, (uint64_t)h, (void*)(intptr_t)x,
                           (void*)(intptr_t)keyeq, (int64_t)owned);
  ```)
;;; set-del-eq-o -- raw removal: explicit hash, boxed carrier element.

(defn set-del-eq-o [A] [s (Set A) h :int x :int keyeq owned :int] : (Set A)
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  void *new_hamt = tur_hamt_del_eq_o(set->hamt, (uint64_t)h, (void*)(intptr_t)x,
                                     (void*)(intptr_t)keyeq, (int64_t)owned);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; set-add -- add element x to the set; returns a new set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;   h -- precomputed hash of x (from Hash[A] typeclass)
;;;   x -- element to add (type A)
;;;
;;; Returns:
;;;   A new Set[A] containing x.
;;;
;;; Example:
;;;   (set-add my-set (hash 42) 42)  ; => set with 42
;;;
;;; Since: Phase TC2 (element retyped :int -> :A, content-keyed: set-element-api-generalization)
;;
;; A macro (not a defn), mirroring map-assoc: it dispatches MapKey[A] on the
;; concrete element EXPRESSION at the call site (via the let-bound __tur_se__),
;; so a cstr element resolves to MapKey[cstr].  A generic defn would dispatch
;; mk-cmp on an abstract :A parameter, which the tree-walking interpreter
;; grounds to the int carrier -- silently dropping content equality.  The
;; element is let-bound once so a computed element is evaluated exactly once.

;; set-of-element-type-is-not-checked (Set any): the hash is bound BEFORE the
;; element alias.  A caller's `(set-add s (hash e) e)` names `e` in both slots,
;; and an `any` local is moved by the `[__tur_se__ ~x]` alias -- so a `~h`
;; spliced inside that let was a use-after-move (TUR-E0201 "cannot copy unique
;; value") the moment the element type became `any`.  Same shape below.

(defmacro set-add [s h x]
  `(let [__tur_sh__ ~h
         __tur_se__ ~x]
     (set-add-eq-o ~s
       __tur_sh__
       (mk-box __tur_se__)
       (mk-cmp __tur_se__)
       (mk-owned? __tur_se__))))
;;; set-remove -- remove element x from the set; returns a new set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;   h -- precomputed hash of x
;;;   x -- element to remove (type A)
;;;
;;; Returns:
;;;   A new Set[A] without x.
;;;
;;; Example:
;;;   (set-remove my-set (hash 42) 42)  ; => set without 42
;;;
;;; Since: Phase TC2

(defmacro set-remove [s h x]
  `(let [__tur_sh__ ~h
         __tur_se__ ~x]
     (set-del-eq-o ~s
       __tur_sh__
       (mk-box __tur_se__)
       (mk-cmp __tur_se__)
       (mk-owned? __tur_se__))))
;;; set-member? -- check whether element x is in the set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;   h -- precomputed hash of x
;;;   x -- element to test (type A)
;;;
;;; Returns:
;;;   true if x is in the set, false otherwise.
;;;
;;; Example:
;;;   (set-member? my-set (hash 42) 42)  ; => true
;;;
;;; Since: Phase TC2

(defmacro set-member? [s h x]
  `(let [__tur_sh__ ~h
         __tur_se__ ~x]
     (set-has-eq-o? ~s
       __tur_sh__
       (mk-box __tur_se__)
       (mk-cmp __tur_se__)
       (mk-owned? __tur_se__))))
;;; set-count -- return the number of elements in the set.
;;;
;;; Parameters:
;;;   s -- Set[A]
;;;
;;; Returns:
;;;   Integer count of elements.
;;;
;;; Example:
;;;   (set-count my-set)  ; => 3
;;;
;;; Since: Phase TC2

(defn set-count [A] [s (Set A)]
  #fx{}
  : int
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  return tur_hamt_count(set->hamt);
  ```)
;;; set-union -- compute the union of two sets.
;;;
;;; Parameters:
;;;   a -- first Set[A]
;;;   b -- second Set[A]
;;;
;;; Returns:
;;;   A new Set[A] containing all elements from both sets.
;;;
;;; Example:
;;;   (set-union set-a set-b)  ; => union set
;;;
;;; Since: Phase TC2
;; NOTE (set-element-api-generalization): union / intersect / diff thread the
;; source set's stamped element comparator (tur_hamt_keyeq) through the
;; content-aware HAMT ops (tur_hamt_has_dynamic / tur_hamt_set_eq_o), so a set of
;; content-keyed elements (cstr, ...) stays content-keyed under set operations
;; rather than falling back to pointer identity.  A NULL comparator (int/Sym
;; identity sets) makes the _eq_o path behave exactly like the old plain path.
;; owned=0: these re-insert existing element pointers borrowed from the sources
;; (matching how the sources hold them); an owned-key element type (a future
;; owned String) would need the boxes retained here.


(defn set-union [A] [a (Set A) b (Set A)]
  #fx{}
  : (Set A)
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  void *keyeq = tur_hamt_keyeq(sa->hamt);
  if (!keyeq) keyeq = tur_hamt_keyeq(sb->hamt);
  void *result = sa->hamt;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, sb->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      result = tur_hamt_set_eq_o(result, hash_out, key_out, (void*)1,
                                 keyeq, (int64_t)0);
  }
  tur_hamt_iter_free((void*)iter_buf);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = result;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; set-intersect -- compute the intersection of two sets.
;;;
;;; Parameters:
;;;   a -- first Set[A]
;;;   b -- second Set[A]
;;;
;;; Returns:
;;;   A new Set[A] containing only elements present in both a and b.
;;;
;;; Example:
;;;   (set-intersect set-a set-b)  ; => intersection set
;;;
;;; Since: Phase TC2

(defn set-intersect [A] [a (Set A) b (Set A)]
  #fx{}
  : (Set A)
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  void *keyeq = tur_hamt_keyeq(sa->hamt);
  if (!keyeq) keyeq = tur_hamt_keyeq(sb->hamt);
  void *result = tur_hamt_new();
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, sa->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      if (tur_hamt_has_dynamic(sb->hamt, (int64_t)hash_out, key_out, keyeq)) {
          result = tur_hamt_set_eq_o(result, hash_out, key_out, (void*)1,
                                     keyeq, (int64_t)0);
      }
  }
  tur_hamt_iter_free((void*)iter_buf);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = result;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; set-diff -- compute set difference a \ b (elements in a but not b).
;;;
;;; Parameters:
;;;   a -- Set[A] (base set)
;;;   b -- Set[A] (elements to remove)
;;;
;;; Returns:
;;;   A new Set[A] with elements of a that are not in b.
;;;
;;; Example:
;;;   (set-diff set-a set-b)  ; => difference set
;;;
;;; Since: Phase TC2

(defn set-diff [A] [a (Set A) b (Set A)]
  #fx{}
  : (Set A)
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  void *keyeq = tur_hamt_keyeq(sa->hamt);
  if (!keyeq) keyeq = tur_hamt_keyeq(sb->hamt);
  void *result = tur_hamt_new();
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, sa->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      if (!tur_hamt_has_dynamic(sb->hamt, (int64_t)hash_out, key_out, keyeq)) {
          result = tur_hamt_set_eq_o(result, hash_out, key_out, (void*)1,
                                     keyeq, (int64_t)0);
      }
  }
  tur_hamt_iter_free((void*)iter_buf);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = result;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; set-eq? -- compare two sets for equality.
;;;
;;; Parameters:
;;;   a -- first Set[A]
;;;   b -- second Set[A]
;;;
;;; Returns:
;;;   true if both sets contain exactly the same elements.
;;;
;;; Example:
;;;   (set-eq? set-a set-b)  ; => true
;;;
;;; Since: Phase TC2
;; NOTE (Phase 4.1/4.3): carrier-essential -- walks a heterogeneous HAMT via
;; tur_hamt_* with no element type available, so it stays inline-C on the int64
;; carrier and is an allowed Phase 5 bridge crossing.  See
;; docs/archive/phase4-carrier-helper-inventory.md.

(defn set-eq? [a : int b : int]
  #fx{}
  : bool
  ```c
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  if (tur_hamt_count(sa->hamt) != tur_hamt_count(sb->hamt)) return false;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, sa->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      if (!tur_hamt_has(sb->hamt, (int64_t)hash_out, key_out)) {
          tur_hamt_iter_free((void*)iter_buf);
          return false;
      }
  }
  tur_hamt_iter_free((void*)iter_buf);
  return true;
  ```)
;;; set-eq-cmp? -- structural equality with a user-supplied element
;;; comparator.  Use this variant when the element type is not
;;; primitive (e.g. Set[Vec[int]]) because the hash-based set-eq?
;;; compares elements by hash + pointer equality, which is wrong for
;;; structurally-equal-but-distinctly-allocated values.
;;;
;;; Parameters:
;;;   a       -- Set[A]
;;;   b       -- Set[A]
;;;   cmp-fn  -- comparator fn [a :int b :int] :bool applied to element pairs
;;;
;;; Returns:
;;;   true iff both sets have the same count and every element of `a`
;;;   has at least one structurally-equal counterpart in `b` per cmp-fn.
;;;
;;; Since: Phase F3-5 (cross-plan-followups)

(defn set-eq-cmp? [A] [a : int b : int ^borrow ^fat cmp-fn : (fn [A A] bool)]
  #fx{}
  : bool
  ```c
  /* O(n*m) comparison: iterate a's elements, scan b for a structural
   * match per element.  Bigger constant than set-eq?'s hash lookup
   * but correct for arbitrarily-structured element types.  Used by
   * the F3-5 dispatcher synthesis for Set[T] where T is a TY_APP. */
  struct { void *hamt; } *sa = (void*)(intptr_t)a;
  struct { void *hamt; } *sb = (void*)(intptr_t)b;
  if (tur_hamt_count(sa->hamt) != tur_hamt_count(sb->hamt)) return false;
  uint64_t iter_a[32];
  for (int __i = 0; __i < 32; __i++) iter_a[__i] = 0;
  tur_hamt_iter_init((void*)iter_a, sa->hamt);
  uint64_t hash_a;
  void *key_a = NULL, *val_a = NULL;
  while (tur_hamt_iter_next((void*)iter_a, &hash_a, &key_a, &val_a)) {
      bool found = false;
      uint64_t iter_b[32];
      for (int __j = 0; __j < 32; __j++) iter_b[__j] = 0;
      tur_hamt_iter_init((void*)iter_b, sb->hamt);
      uint64_t hash_b;
      void *key_b = NULL, *val_b = NULL;
      while (tur_hamt_iter_next((void*)iter_b, &hash_b, &key_b, &val_b)) {
          if (((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)cmp_fn)[0])(
                (void*)(intptr_t)cmp_fn, (int64_t)(intptr_t)key_a, (int64_t)(intptr_t)key_b)) {
              found = true;
              break;
          }
      }
      tur_hamt_iter_free((void*)iter_b);
      if (!found) {
          tur_hamt_iter_free((void*)iter_a);
          return false;
      }
  }
  tur_hamt_iter_free((void*)iter_a);
  return true;
  ```)
;;; set-free -- free the Set wrapper struct.
;;;
;;; Parameters:
;;;   s -- Set[A] to free
;;;
;;; Example:
;;;   (set-free my-set)
;;;
;;; Since: Phase TC2

(defn set-free [A] [s (Set A)]
  #fx{}
  : void
  ```c
  struct { void *hamt; } *set = (void*)(intptr_t)s;
  /* Deep-free: release the backing HAMT before the wrapper (see map-free).
   * tur_hamt_free is refcount-safe under structural sharing and releases every
   * OWNED element box via the set's stamped key_ops -- so a Set[Point] with
   * mk-owned? = 1 struct elements frees each boxed element exactly once.  Matches
   * the interpreter's native set-free; the compiled body was shallow. */
  if (set->hamt) tur_hamt_free(set->hamt);
  free(set);
  ```)
;;; set-hamt -- internal accessor returning the backing HAMT pointer.

(defn set-hamt [A] [s (Set A)]
  #fx{}
  : ptr<void>
  ```c struct { void *hamt; } *set = (void*)(intptr_t)s; return (__TUR_RET__)(intptr_t)set->hamt; ```)
;;; set-eq-loop -- pure-Turmeric structural-equality walk over s1's HAMT.
;;;
;;; Path A specializes this per A at the `Eq [Set]` dispatch site; the
;;; self-tail-recursive spec lowers to a goto loop (TCO-in-ABI-specs, same
;;; gate as `vec-eq-loop` / `mutmap-eq-loop`), so deep iteration over large
;;; sets runs in constant stack.  For each entry of s1 the matching key is
;;; looked up in s2's hamt via `hamt/has-dynamic?` (threading s1's stamped
;;; key comparator so content-keyed elements stay content-correct).
;;;
;;; Parameters:
;;;   iter    -- hamt/iter-alloc-allocated handle scanning s1
;;;   s2-hamt -- raw HAMT pointer of the second set (from set-hamt)
;;;   keyeq   -- stamped key comparator (from hamt/keyeq on s1's hamt)
;;;
;;; Returns:
;;;   true iff every entry of s1 is present in s2 under keyeq.
;;;
;;; Since: Phase TCO-Eq-MapSet


(defn set-eq-loop [iter : ptr<void> s2-hamt : ptr<void> keyeq : ptr<void>] : bool
  (if (hamt/iter-advance! iter)
    (let [h (hamt/iter-cur-hash iter)
          k (hamt/iter-cur-key iter)]
      (if (hamt/has-dynamic? s2-hamt h k keyeq)
        (set-eq-loop iter s2-hamt keyeq)
        false))
    true))
;;; set-eq-driver -- allocate the iter box, run set-eq-loop, free.
;;;
;;; Since: Phase TCO-Eq-MapSet


(defn set-eq-driver [A] [s1 (Set A) s2 (Set A)] : bool
  (let [iter   (hamt/iter-alloc (set-hamt s1))
        keyeq  (hamt/keyeq (set-hamt s1))
        result (set-eq-loop iter (set-hamt s2) keyeq)]
    (do (hamt/iter-destroy! iter) result)))
;;; Eq [Set] -- membership equality using the HAMT structure.
;; TCO-Eq-MapSet (pure-turmeric Eq [Map] / Eq [Set] follow-up): the instance
;; body now dispatches through the pure-Turmeric `set-eq-loop` (TCO'd inside
;; its by-value spec), mirroring `Eq [Vec]` / `Eq [MutableMap]` / `Eq [Map]`.
;; The inline-C `set-eq?` / `set-eq-cmp?` pair stays for direct callers.
;;; set-eq-full -- length-prefixed structural equality over by-value (Set A).
;;;
;;; Pulled out as a single-receiver helper so the `Eq [Set]` instance reads
;;; x and y exactly once each, mirroring the original single-use instance
;;; shape.  Takes by-value `(Set A)` (Path A), so a concrete `(Set int)`
;;; receiver dispatches via the typed per-A spec
;;; `set_eq_full__spec__bool_Set__int___Set__int__(Set__int *, Set__int *)`
;;; instead of the int64 carrier -- giving `Eq [Set]` a typed `(Set__A *)`
;;; consumer, matching `Eq [Map]` / `Eq [MutableMap]` / `Eq [Vec]`.  An
;;; HKT-headed (abstract-A) receiver still instantiates the int64 carrier
;;; (`set_hyeq_hyfull`), so existing carrier callers are unaffected.


(defn set-eq-full [A] [s1 (Set A) s2 (Set A)] : bool
  (and (= (set-count s1) (set-count s2)) (set-eq-driver s1 s2)))

(definstance Eq [Set]
  [(Eq A)]
  (eq? [x y] (set-eq-full (:: x (Set A)) (:: y (Set A)))))
;;; set-add-elem__ -- internal: typed single-element insert behind set-add1.
;;;
;;; set-of-element-type-is-not-checked: `set-of` used to have no homogeneity
;;; check -- `set-add1` expanded straight to the carrier-typed `set-add-eq-o`,
;;; each element resolving its own Hash/MapKey, so `(set-of 1 "two")` built
;;; and claimed `(Set int)` while holding a cstr.  Routing every insert through
;;; this TYPED helper is the `vec-push!` shape: the element must be the set's
;;; `A`, and a mismatch is a TUR-E0001 at the offending element.  A
;;; heterogeneous set is spelled `(Set any)` -- `Hash[any]`/`MapKey[any]`
;;; satisfy the constraints and each `any` keys by its payload -- which is what
;;; a Saffron `#set{...}` literal widens to.

(defn set-add-elem__ [^Hash A ^MapKey A] [s : (Set A) x : A] : (Set A)
  (set-add-eq-o s (.hash x) (.mk-box x) (.mk-cmp x) (.mk-owned? x)))
;;; set-add1 -- insert one element, computing its hash via Hash[A].
;;;
;;; The convenient single-element add: the element expression is mentioned
;;; exactly once (it becomes the argument of the typed set-add-elem__, which
;;; hashes and boxes it), so the set-of / #set{...} lowering evaluates a
;;; computed element once.  The element must have the set's element type;
;;; content-keyed via Hash[A] + MapKey[A], so (set-of "a" "a") -- two equal
;;; strings -- is one member even at distinct addresses.
;;;
;;; Parameters:
;;;   s -- the set
;;;   x -- the element to insert
;;;
;;; Returns:
;;;   A new set containing x.
;;;
;;; Example:
;;;   (set-add1 (set-new) 42)   ; => Set {42}

(defmacro set-add1 [s x] `(set-add-elem__ ~s ~x))
;;; set-add-each__ -- internal helper for the set-of macro.
;;;
;;; Threads (set-add1 s x) over the elements in xs.  Each element appears
;;; once in the expansion (set-add1 supplies the duplicate hash slot), so a
;;; computed element is evaluated exactly once.  Recursive: each step nests
;;; one more set-add1.  Its parameters and set-of's are ^syntax, for the
;;; reason hamt-assoc-each__ gives (map.tur): an element holding a lambda.

(defmacro set-add-each__ [^syntax s & ^syntax xs]
  (if (empty? xs)
    s
    (list set-add-each__ (list set-add1 s (first xs)) ~@(rest xs))))
;;; set-of -- variadic Set literal.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements of a single type A.  Each element is used
;;;           as its own hash (identity-hash), matching the typed Set[A]
;;;           convention; scalar element types (int, etc.) dedupe by value.
;;;
;;; Returns:
;;;   A fresh Set[A] containing xs; duplicate elements collapse to one.
;;;
;;; Note: this is the lowering target of the #set{...} data literal
;;;   (-Xdata-literals).  Writing #set{1 2 3} is preferred over calling
;;;   set-of directly.
;;;
;;; Example:
;;;   (set-of)        ; => empty Set
;;;   (set-of 1 2 3)  ; => Set {1, 2, 3}
;;;   (set-of 1 1 2)  ; => Set {1, 2}
;;;
;;; Since: DL1 (data-literals-plan)
;;; set-empty-for -- internal: an empty Set[A] whose A is pinned by a sample
;;; element.  Used by the set-of / #set{...} lowering, where the element type is
;;; known from the first literal element but cannot be written as an annotation
;;; by the expanding macro.  The x argument is consumed only for type inference;
;;; the returned set is empty.  Mirrors map-empty-for.  Without this, set-of
;;; seeds from a bare (set-new) whose A is unpinned, so the per-element MapKey
;;; dispatch defaults to the int carrier and content-keyed elements (cstr, ...)
;;; are not deduped.
;;;
;;; Since: set-element-api-generalization


(defn set-empty-for [^Hash A ^MapKey A] [x :A] : (Set A) (set-new))

(defmacro set-of [& ^syntax xs]
  (if (empty? xs)
    (list set-new)
    (list set-add-each__ (list set-empty-for (first xs)) ~@xs)))
