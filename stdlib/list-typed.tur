;;; tur/list-typed -- a phantom-typed (List A) view over the int64 cons-list
;;; carrier.
;;;
;;; (List A) is the "either empty or a chain of Cons cells of A" view that
;;; smart constructors like refined.tur's ne-from? consume: it pins the element
;;; type at the boundary so downstream accessors recover A instead of a bare
;;; tyvar. It lowers to :int (the head cons-cell pointer, or 0 for empty) at
;;; zero runtime cost, sitting alongside the untyped carrier helpers
;;; (list-head, list-tail, ...) in list.tur, which keep working unchanged.
;;;
;;; This module is NOT auto-loaded: `List` is an extremely common user type
;;; name (a plain `(defdata List ...)` in user code must not collide with it),
;;; so it stays opt-in via (load "stdlib/list-typed.tur"). refined.tur loads it
;;; for the NonEmpty smart constructors.
;;;
;;; Since: end-to-end-monomorphization-plan (Phase 1.1)
;; Typed list witness for element-type recovery.  The untyped carrier helpers
;; (tcons / tnil? / list-head / list-tail) come from the auto-loaded list.tur;
;; no explicit load is needed (and loading it here would re-define Cons).
;;; List -- a typed view over the int64 cons-list carrier, carrying a phantom
;;; element type A.
;;;
;;; Lowers to :int (the head cons-cell pointer, or 0 for empty). Construct it
;;; with list-of (variadic) or an explicit (:: ... (List A)) ascription on a
;;; tcons chain whose head type pins A.
;;;
;;; Since: end-to-end-monomorphization-plan (Phase 1.1)
(defopaque List [A] :int)
;;; list-of -- build a (List A) from N values, recovering A from the rest type.
;;;
;;; Parameters:
;;;   & xs -- zero or more elements, all of type A.
;;;
;;; Returns:
;;;   A (List A) over the int64 cons-list carrier the variadic collector builds.
;;;   With zero arguments, the empty list (carrier 0).
;;;
;;; Example:
;;;   (list-empty? (list-of))      ; => true
;;;   (list-empty? (list-of 1 2))  ; => false
;;;
;;; Since: end-to-end-monomorphization-plan (Phase 1.1)

(defn list-of [A] [& xs : A] : (List A) (:: xs (List A)))
;;; list-empty? -- is a (List A) the empty list?
;;;
;;; Parameters:
;;;   xs -- the (List A) to inspect
;;;
;;; Returns:
;;;   true when xs is empty (carrier 0), false otherwise.
;;;
;;; Example:
;;;   (list-empty? (list-of))   ; => true
;;;   (list-empty? (list-of 9)) ; => false
;;;
;;; Since: end-to-end-monomorphization-plan (Phase 1.1)

(defn list-empty? [A] [xs : (List A)] : bool (null? (:: xs :int)))
;;; list->carrier -- recover the raw int64 cons-list carrier from a (List A).
;;;
;;; Parameters:
;;;   xs -- the (List A) to unwrap
;;;
;;; Returns:
;;;   The underlying int64 cons-list pointer (0 for empty), suitable as input
;;;   to the untyped carrier helpers (list-head, list-tail, list-length, ...).
;;;
;;; Example:
;;;   (list-head (list->carrier (list-of 7 8)))  ; => 7
;;;
;;; Since: end-to-end-monomorphization-plan (Phase 1.1)

(defn list->carrier [A] [xs : (List A)] : int (:: xs :int))
;;; list-count -- number of elements in a (List A), correct for aggregate A.
;;;
;;; The element-aware length for the typed list view. `list-length` (the carrier
;;; helper) walks the chain at the fixed `{int64 head; int64 tail}` layout and
;;; segfaults when A is a by-value aggregate; `list-count` recovers the concrete
;;; `(Cons A)` layout and walks it via the typed `tlength`, so a
;;; `(List (Option int))` (and any by-value-aggregate element) measures safely.
;;;
;;; This relies on phantom-opaque element specialization: although `(List A)`
;;; lowers to the int64 carrier, the compiler mints a per-element-type clone of
;;; `list-count` when A is a by-value aggregate, so the inner `(:: ... (Cons A))`
;;; resolves to the concrete cell layout instead of collapsing to the carrier.
;;;
;;; Parameters:
;;;   xs -- the (List A) to measure
;;;
;;; Returns:
;;;   Integer length (0 for the empty list).
;;;
;;; Example:
;;;   (list-count (list-of 1 2 3))  ; => 3
;;;
;;; Since: Phase G4 (carrier<->concrete ABI crossing audit)

(defn list-count [A] [xs : (List A)] : int
  (if (list-empty? xs) 0 (tlength (:: (:: xs :int) (Cons A)))))
;; ---- Building and walking a (List A) (parsec-guide-plan P5) ----------------
;; These ride the int64 cons carrier like the rest of this module, so the
;; element is the word the carrier holds: exact for int, Char, String, a
;; `:heap` struct or any other one-word value -- the element types a parser
;; produces.  String is needed only by list->string.
(load "stdlib/string.tur")
;;; list-nil -- the empty (List A).
;;;
;;; Returns:
;;;   The empty list (carrier 0); its element type comes from the context.
;;;
;;; Example:
;;;   (list-empty? (:: (list-nil) (List int)))  ; => true
;;;
;;; Since: parsec-guide-plan P5

(defn list-nil [A] [] : (List A) (:: 0 (List A)))
;;; list-cons -- prepend x to xs.
;;;
;;; Parameters:
;;;   x  -- the new first element
;;;   xs -- the rest of the list
;;;
;;; Returns:
;;;   A (List A) whose first element is x, followed by xs.
;;;
;;; Example:
;;;   (list-count (list-cons 1 (list-of 2 3)))  ; => 3
;;;
;;; Since: parsec-guide-plan P5

(defn list-cons [A] [x : A xs : (List A)] : (List A)
  (:: (:: (tcons (:: x :int) (list->carrier xs)) :int) (List A)))
;;; list-first -- the first element of a non-empty list.
;;;
;;; Parameters:
;;;   xs -- a non-empty (List A); check with list-empty? first
;;;
;;; Returns:
;;;   The first element.
;;;
;;; Example:
;;;   (list-first (list-of 7 8))  ; => 7
;;;
;;; Since: parsec-guide-plan P5

(defn list-first [A] [xs : (List A)] : A (:: (list-head (list->carrier xs)) A))
;;; list-rest -- everything after the first element of a non-empty list.
;;;
;;; Parameters:
;;;   xs -- a non-empty (List A)
;;;
;;; Returns:
;;;   The (List A) after the first element (empty for a one-element list).
;;;
;;; Example:
;;;   (list-first (list-rest (list-of 7 8)))  ; => 8
;;;
;;; Since: parsec-guide-plan P5

(defn list-rest [A] [xs : (List A)] : (List A)
  (:: (list-tail (list->carrier xs)) (List A)))
;;; list-foldl -- fold a list from the left.
;;;
;;; Parameters:
;;;   xs   -- the list to fold
;;;   init -- the starting accumulator
;;;   f    -- (fn [acc x] acc'), called once per element, first to last
;;;
;;; Returns:
;;;   The final accumulator.
;;;
;;; Example:
;;;   (list-foldl (list-of 1 2 3) 0 (fn [acc : int x : int] : int (+ acc x)))  ; => 6
;;;
;;; Since: parsec-guide-plan P5

(defn list-foldl [A B] [xs : (List A) init : B f : (fn [B A] B)] : B
  (if (list-empty? xs)
    init
    (list-foldl (list-rest xs) (f init (list-first xs)) f)))
;;; list-reverse-onto__ -- internal: prepend xs, reversed, onto acc.

(defn list-reverse-onto__ [A] [xs : (List A) acc : (List A)] : (List A)
  (if (list-empty? xs)
    acc
    (list-reverse-onto__ (list-rest xs) (list-cons (list-first xs) acc))))
;;; list-reverse -- the elements of xs in reverse order.
;;;
;;; Parameters:
;;;   xs -- the list to reverse
;;;
;;; Returns:
;;;   A new (List A), last element first.
;;;
;;; Example:
;;;   (list-first (list-reverse (list-of 1 2 3)))  ; => 3
;;;
;;; Since: parsec-guide-plan P5

(defn list-reverse [A] [xs : (List A)] : (List A)
  (list-reverse-onto__ xs (list-nil)))
;;; list-map-onto__ -- internal: map f over xs, consing results onto acc in reverse.

(defn list-map-onto__ [A B] [xs : (List A) f : (fn [A] B) acc : (List B)] : (List B)
  (if (list-empty? xs)
    (list-reverse acc)
    (list-map-onto__ (list-rest xs) f (list-cons (f (list-first xs)) acc))))
;;; list-map -- apply f to every element.
;;;
;;; Parameters:
;;;   xs -- the list to map over
;;;   f  -- the function applied to each element
;;;
;;; Returns:
;;;   A new (List B) of the results, in the original order.
;;;
;;; Example:
;;;   (list-first (list-map (list-of 1 2) (fn [x : int] : int (* x 10))))  ; => 10
;;;
;;; Since: parsec-guide-plan P5

(defn list-map [A B] [xs : (List A) f : (fn [A] B)] : (List B)
  (list-map-onto__ xs f (list-nil)))
;;; list->string-loop__ -- internal: append each Char of xs to the builder.

(defn list->string-loop__ [xs : (List Char) b : StringBuilder] : String
  (if (list-empty? xs)
    (builder/finish b)
    (do
      (builder/push-char! b (list-first xs))
      (list->string-loop__ (list-rest xs) b))))
;;; list->string -- the characters of a (List Char) as a String.
;;;
;;; The usual last step of a character-level parser: `(many (satisfy alpha?))`
;;; produces a (List Char), and this turns it into the String it spells.
;;;
;;; Parameters:
;;;   xs -- the characters, first to last
;;;
;;; Returns:
;;;   A fresh owned String.
;;;
;;; Example:
;;;   (string/to-cstr (list->string (list-of #\h #\i)))  ; => "hi"
;;;
;;; Since: parsec-guide-plan P5

(defn list->string [xs : (List Char)] : String
  (list->string-loop__ xs (builder/new)))
