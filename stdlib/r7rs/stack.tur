;;; r7rs/stack -- room for deep recursion, and a message when it runs out.
;;;
;;; Each non-tail Scheme call is a C frame, so a compiled program's recursion
;;; depth is its C stack.  SICP 1.2.1's linear recursive process run a
;;; million deep died of SIGSEGV with no output at all
;;; (docs/archive/r7rs-deep-recursion-segfaults-silently.md).  Two things,
;;; both at startup, before main:
;;;
;;;   - Linux: the main thread's stack grows on demand up to RLIMIT_STACK,
;;;     whose usual soft value is 8 MiB.  A program whose soft limit is lower
;;;     than 1 GiB raises it (to the hard limit, if that is lower) and
;;;     re-executes itself once, so the kernel lays out the address space
;;;     for the new limit -- raising it in place leaves the old layout's gap.
;;;     Address space, not memory: pages are touched only as the stack grows.
;;;     Threads keep an 8 MiB default (glibc would otherwise size every
;;;     thread's stack by the new limit).  TUR_STACK_REEXEC=0 turns it off.
;;;   - Linux and macOS: a SIGSEGV that lands just below the faulting
;;;     thread's stack pointer is a stack overflow; a handler on an
;;;     alternate stack says so on stderr, then lets the signal kill the
;;;     program as before (the exit status is unchanged).
;;;
;;; The prelude is compiled in parts, each with a copy of this block; every
;;; step is idempotent across copies (a second constructor finds the limit
;;; raised and the handler installed, and does nothing).
;;;
;;; Not under the JIT (c2mir defines __MIRC__): there the process is `tur`
;;; itself.  The interpreter does not run this block at all.
;;;
;;; Since: r7rs-srfi-18-216-sicp-plan (2.1a reports)
;; The prelude loads this file; nothing else should.
```c
#if !defined(__MIRC__) && (defined(__linux__) || defined(__APPLE__))
#include <signal.h>
#include <sys/resource.h>
#include <ucontext.h>
#if defined(__GLIBC__)
/* glibc declares it only under _GNU_SOURCE, which the unit may not define. */
extern int pthread_setattr_default_np(const pthread_attr_t *);
#endif
static char r7rs_stack_altstack[64 * 1024];
static void r7rs_stack_on_segv(int sig, siginfo_t *si, void *uc_) {
    ucontext_t *uc = (ucontext_t *)uc_;
    uintptr_t sp = 0;
#if defined(__linux__) && defined(__x86_64__)
#ifdef REG_RSP
    sp = (uintptr_t)uc->uc_mcontext.gregs[REG_RSP];
#else
    sp = (uintptr_t)uc->uc_mcontext.gregs[15];   /* REG_RSP, without _GNU_SOURCE */
#endif
#elif defined(__linux__) && defined(__aarch64__)
    sp = (uintptr_t)uc->uc_mcontext.sp;
#elif defined(__APPLE__) && defined(__x86_64__)
    sp = (uintptr_t)uc->uc_mcontext->__ss.__rsp;
#elif defined(__APPLE__) && defined(__aarch64__)
    sp = (uintptr_t)uc->uc_mcontext->__ss.__sp;
#endif
    uintptr_t at = (uintptr_t)si->si_addr;
    /* A frame's first touch past the stack's end: within a few pages of sp,
     * either side (the faulting store may be above the sp the kernel saw). */
    if (sp && at <= sp + 4096 && at + (uintptr_t)256 * 1024 >= sp) {
        static const char msg[] = "\nerror: stack overflow (recursion too deep)\n";
        ssize_t w = write(2, msg, sizeof msg - 1);
        (void)w;
    }
    signal(sig, SIG_DFL);
    raise(sig);
}
__attribute__((constructor, used)) static void r7rs_stack_init(int argc, char **argv, char **envp) {
    (void)argc; (void)envp;
#if defined(__linux__)
    const char *flag = getenv("TUR_STACK_REEXEC");
    if (flag && strcmp(flag, "1") == 0) {
        /* The re-executed run: the limit is in place.  Hide the flag from
         * the program's own children, which should raise theirs too. */
        unsetenv("TUR_STACK_REEXEC");
#if defined(__GLIBC__)
        pthread_attr_t a;
        if (pthread_attr_init(&a) == 0) {
            pthread_attr_setstacksize(&a, (size_t)8 * 1024 * 1024);
            pthread_setattr_default_np(&a);
            pthread_attr_destroy(&a);
        }
#endif
    } else if (!flag && argv && argv[0]) {
        struct rlimit rl;
        const rlim_t want = (rlim_t)1 << 30;
        if (getrlimit(RLIMIT_STACK, &rl) == 0 && rl.rlim_cur != RLIM_INFINITY && rl.rlim_cur < want) {
            rlim_t to = (rl.rlim_max == RLIM_INFINITY || rl.rlim_max >= want) ? want : rl.rlim_max;
            if (to > rl.rlim_cur) {
                struct rlimit nl = { to, rl.rlim_max };
                if (setrlimit(RLIMIT_STACK, &nl) == 0) {
                    setenv("TUR_STACK_REEXEC", "1", 1);
                    execv("/proc/self/exe", argv);
                    /* Could not re-execute: carry on as before. */
                    unsetenv("TUR_STACK_REEXEC");
                    setrlimit(RLIMIT_STACK, &rl);
                }
            }
        }
    }
#endif
    stack_t ss;
    ss.ss_sp = r7rs_stack_altstack;
    ss.ss_size = sizeof r7rs_stack_altstack;
    ss.ss_flags = 0;
    if (sigaltstack(&ss, NULL) != 0) return;
    struct sigaction cur;
    if (sigaction(SIGSEGV, NULL, &cur) != 0 || cur.sa_handler != SIG_DFL) return;
    struct sigaction sa;
    memset(&sa, 0, sizeof sa);
    sa.sa_sigaction = r7rs_stack_on_segv;
    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;
    sigemptyset(&sa.sa_mask);
    sigaction(SIGSEGV, &sa, NULL);
}
#endif
```
