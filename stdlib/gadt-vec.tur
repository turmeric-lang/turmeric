;;; tur/gadt-vec -- GVec: a singly-linked list of ints with a phantom type parameter.
;;;
;;; GVec is a phantom-typed singly-linked list of ints: both constructors
;;; return (GVec int), so the parameter never says anything about the length,
;;; and gvec-head-or takes an explicit default.  A genuinely length-indexed
;;; vector -- VNil : (Vec Zero), VCons : (Vec (Succ n)) over phantom-parameter
;;; opaques -- gets an arm-less head on a scrutinee annotated (Vec (Succ n)),
;;; and a rejected call on (VNil) itself, whose index is known; the recipe is
;;; the "Length-Indexed Vectors" section of docs/guides/gadts-cookbook.md.
;;;
;;; Since: Phase G4
;; Phase G4: GVec (simplified int elements)
;; GVec is a phantom-typed singly-linked list of ints.
;; The type parameter a is unused in constructor field types (phantom), and
;; both constructors pin it to int, so the type is not refined.
;; Renamed from Vec to GVec (KB-023) to avoid shadowing stdlib/vec.tur's Vec struct.
(defdata GVec [a] (GVNil : (GVec int)) (GVCons int (GVec int) : (GVec int)))
;;; gvec-nil -- construct an empty GVec.
;;;
;;; Returns:
;;;   A (GVec int) value representing the empty list.
;;;
;;; Example:
;;;   (gvec-nil)  ; => GVNil
;;;
;;; Since: Phase G4

(defn gvec-nil [] : GVec (GVNil))
;;; gvec-cons -- prepend an integer element to a GVec.
;;;
;;; Parameters:
;;;   x -- the integer element to prepend
;;;   v -- the existing (GVec int) to prepend onto
;;;
;;; Returns:
;;;   A new (GVec int) with x at the front.
;;;
;;; Example:
;;;   (gvec-cons 1 (gvec-nil))  ; => GVCons(1, GVNil)
;;;
;;; Since: Phase G4

(defn gvec-cons [x : int v : GVec] : GVec (GVCons x v))
;;; gvec-len -- compute the length of a GVec.
;;;
;;; Parameters:
;;;   v -- the (GVec int) to measure
;;;
;;; Returns:
;;;   The number of elements in v as an int.
;;;
;;; Example:
;;;   (gvec-len (gvec-cons 1 (gvec-cons 2 (gvec-nil))))  ; => 2
;;;
;;; Since: Phase G4

(defn gvec-len [v : GVec] : int
  (match v (GVNil) 0 (GVCons _ t) (+ 1 (gvec-len t))))
;;; gvec-sum -- sum all elements of a GVec.
;;;
;;; Parameters:
;;;   v -- the (GVec int) to sum
;;;
;;; Returns:
;;;   The integer sum of all elements; 0 for an empty GVec.
;;;
;;; Example:
;;;   (gvec-sum (gvec-cons 1 (gvec-cons 2 (gvec-cons 3 (gvec-nil)))))  ; => 6
;;;
;;; Since: Phase G4

(defn gvec-sum [v : GVec] : int
  (match v (GVNil) 0 (GVCons x t) (+ x (gvec-sum t))))
;;; gvec-head-or -- return the first element or a default if empty.
;;;
;;; Parameters:
;;;   dflt -- the int value to return when v is empty
;;;   v    -- the (GVec int) to inspect
;;;
;;; Returns:
;;;   The head element of v if non-empty, otherwise dflt.
;;;
;;; Example:
;;;   (gvec-head-or 99 (gvec-nil))                      ; => 99
;;;   (gvec-head-or 99 (gvec-cons 5 (gvec-nil)))        ; => 5
;;;
;;; Since: Phase G4

(defn gvec-head-or [dflt : int v : GVec] : int
  (match v (GVNil) dflt (GVCons x _) x))
;;; gvec-tail -- return all elements after the first.
;;;
;;; Parameters:
;;;   v -- the (GVec int) to take the tail of
;;;
;;; Returns:
;;;   The tail (GVec int) of v; GVNil if v is empty.
;;;
;;; Example:
;;;   (gvec-tail (gvec-cons 1 (gvec-cons 2 (gvec-nil))))  ; => GVCons(2, GVNil)
;;;   (gvec-tail (gvec-nil))                                ; => GVNil
;;;
;;; Since: Phase G4

(defn gvec-tail [v : GVec] : GVec (match v (GVNil) (GVNil) (GVCons _ t) t))
;;; __gvec-call-fn1 -- apply a ptr<void> closure to one int argument.
;; Internal helper for gvmap; dispatches through the fat-closure ABI.

(defn __gvec-call-fn1 [^fat f x : int] : int (f x))
;;; gvmap -- apply an int->int function to every element of a GVec.
;;;
;;; Parameters:
;;;   f -- a curried int->int function (e.g. a partial application)
;;;   v -- the (GVec int) to transform
;;;
;;; Returns:
;;;   A new (GVec int) with f applied to each element.
;;;
;;; Example:
;;;   (defn mul [a : int b : int] : int (* a b))
;;;   (gvec-sum (gvmap (mul 2) (gvec-cons 1 (gvec-cons 2 (gvec-nil)))))  ; => 6
;;;
;;; Since: Phase G4

(defn gvmap [f : ptr<void> v] : GVec
  (match v
    (GVNil)
    (GVNil)
    (GVCons x t)
    (GVCons (__gvec-call-fn1 f x) (gvmap f t))))
;;; gvzip-with -- combine two GVecs element-wise using a binary int->int->int function.
;;;
;;; Parameters:
;;;   f  -- a two-argument function (int, int) -> int
;;;   v1 -- the first (GVec int)
;;;   v2 -- the second (GVec int)
;;;
;;; Returns:
;;;   A (GVec int) of combined values; stops at the shorter input.
;;;
;;; Example:
;;;   (defn add [a : int b : int] : int (+ a b))
;;;   (gvec-sum (gvzip-with add
;;;               (gvec-cons 1 (gvec-cons 2 (gvec-nil)))
;;;               (gvec-cons 10 (gvec-cons 20 (gvec-nil)))))  ; => 33
;;;
;;; Since: Phase G4
;; KB-034: f is declared :(fn [int int] :int), not :ptr<void>.  A two-argument
;; call through a raw :ptr<void> value assumes a fat-closure layout and
;; dereferences the pointer as a function-pointer table, which segfaults when a
;; plain non-capturing function (e.g. `add`) is passed.  The typed fn parameter
;; wraps any callee into a tur_poly_fn_t, so `(f x y)` dispatches correctly via
;; fn.fn(fn.env, x, y) for both bare functions and capturing closures.

(defn gvzip-with [f : (fn [int int] int) v1 v2] : GVec
  (match v1
    (GVNil)
    (GVNil)
    (GVCons x t1)
    (match v2
      (GVNil)
      (GVNil)
      (GVCons y t2)
      (GVCons (f x y) (gvzip-with f t1 t2)))))
