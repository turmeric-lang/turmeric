;;; tur/dedent-reader -- the `#dedent{...}` indent-aware multi-line literal.
;;;
;;; `#dedent{...}` reads its body verbatim and expands to
;;; `(cstr-dedent "<body>")`, so a block of text can be indented to match the
;;; surrounding code without that indent ending up in the string:
;;;
;;;   #use-reader-macros "stdlib/dedent-reader.tur"
;;;   (load "stdlib/dedent.tur")
;;;
;;;   (println #dedent{
;;;       Usage: tool [options]
;;;         -h  show help
;;;     })
;;;   ; prints "Usage: tool [options]\n  -h  show help"
;;;
;;; The body is a raw reader body: braces must balance (or be written `\{`
;;; `\}`), and a backslash is consumed, so a literal backslash is `\\`.  The
;;; result is heap-allocated; free it with `cstr-free` if that matters.
;;;
;;; Since: Phase B1
;; reader-macro registration
(reader-macros/define 'dedent :raw-brace '(cstr-dedent $body))
