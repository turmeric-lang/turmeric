;;; tur/taskgroup -- structured concurrency with scoped TaskGroup.
;;;
;;; Spawns tasks and waits for all of them to complete before returning.
;;;
;;; Since: Phase T22
;; stdlib/taskgroup.tur -- Structured concurrency with TaskGroup (Phase T22)
;;
;; TaskGroup provides structured concurrency: a group of tasks that are
;; spawned together and can be cancelled together. When a task fails or
;; the group is explicitly cancelled, all running tasks receive a cancellation
;; signal and are expected to cooperate by checking `fiber-cancelled?` and
;; exiting promptly.
;;
;; API:
;;   task-group-new       []                              -- TaskGroup
;;   task-group-spawn     [group :TaskGroup f :ptr<void>] -- TaskHandle
;;   task-group-join      [group :TaskGroup handle :TaskHandle] -- nil  (Phase TG-002)
;;   task-group-cancel    [group :TaskGroup]            -- nil
;;   fiber-cancelled?     []                             -- bool  (checks current fiber)
;;   task-group-cancelled? [group :TaskGroup]           -- bool  (checks specific group)
;;   task-handle-done?    [handle :TaskHandle]           -- bool  (Phase TG-002)
;;   task-group-done?      [group :TaskGroup]           -- bool
;;   task-group-wait      [group :TaskGroup]           -- nil  (blocks until done)
;;   task-group-free      [group :TaskGroup]           -- nil
;;
;; TaskGroupBlock layout:
;;   { pthread_mutex_t lock;
;;     pthread_cond_t done_cond;
;;     int64_t task_count;
;;     int64_t completed_count;
;;     bool cancelled;
;;     bool done;
;;     int64_t cancel_reason; /* Phase TG-004-2: 0=manual, 1=panic, 2=timeout, 3=error */ }
;;
;; Each spawned task increments task_count. When a task completes (normally
;; or via cancellation), it must call (task-group-task-done group).
;; When all tasks complete, the group is marked done and waiters are notified.
;;
;; Cancellation is cooperative: tasks must periodically check `task-group-cancelled?`
;; or `fiber-cancelled?` and exit if cancelled.
;; ---- Opaque handle newtypes (stdlib-opaque-handle-types-plan, Tier 2) ----
;; TaskGroup is the group handle returned by task-group-new; TaskHandle is the
;; per-task fiber handle returned by task-group-spawn. They are nominally
;; distinct so the checker rejects mixing them up -- e.g. passing a TaskHandle
;; where a TaskGroup is expected, or vice versa in task-group-join. Both lower
;; to :ptr<void> in the C ABI, so the inline-C bodies are unchanged.
;;
;; ---- Linearity (stdlib-linearity-affinity-plan, L2) ----
;; TaskGroup is :linear: it owns a heap-allocated TaskGroupBlock (mutex +
;; condvar) that must be destroyed exactly once with task-group-free. Under
;; -Xlinear the checker rejects dropping a TaskGroup (TUR-E0100) -- e.g.
;; forgetting task-group-free, or forgetting task-group-wait before the group
;; goes out of scope -- and freeing it twice / using it after free (TUR-E0101).
;; All of the group accessors (task-group-spawn / -join / -wait / -cancel* /
;; -done? / -cancelled? / -should-exit? / -task-done / -cancel-reason /
;; -spawn-async) declare their group parameter ^borrow, so a group may be
;; spawned into, waited on, and cancelled any number of times without consuming
;; it; only task-group-free consumes. TaskHandle stays a plain opaque handle:
;; a single group hands out many task handles (one per spawn) that are not
;; individually freed, so it is not linear.
(defopaque ^linear TaskGroup :ptr<void>)

(defopaque TaskHandle :ptr<void>)
;; ---- TaskGroup lifecycle ----
;;; task-group-new -- create a new empty TaskGroup.
;;;
;;; Returns:
;;;   A TaskGroup handle to the TaskGroupBlock.
;;;
;;; Example:
;;;   (let [g (task-group-new)] ...)  ; => TaskGroup
;;;
;;; Since: Phase T22
;; Create a new TaskGroup

(defn task-group-new [] : TaskGroup
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)malloc(sizeof(TaskGroupBlock));
  if (!g) { fprintf(stderr, "task-group-new: oom\n"); abort(); }
  pthread_mutex_init(&g->lock, NULL);
  pthread_cond_init(&g->done_cond, NULL);
  g->task_count = 0;
  g->completed_count = 0;
  g->cancelled = false;
  g->done = false;
  g->cancel_reason = 0;
  return (void *)(intptr_t)g;
  ```)
;;; fiber-cancelled? -- check whether the current fiber has been cancelled.
;;;
;;; Returns:
;;;   true if the thread-local cancelled flag is set; false otherwise.
;;;
;;; Example:
;;;   (if (fiber-cancelled?) ...)  ; => bool
;;;
;;; Since: Phase T22
;; Check if the current fiber has been cancelled
;; This checks a thread-local flag set by the task group

(defn fiber-cancelled? [] : bool
  ```c
  return tur_fiber_cancelled();
  ```)
;;; __fiber_set_cancelled -- set the current fiber's cancelled flag (internal use only).
;;;
;;; Since: Phase T22
;; Set the current fiber's cancelled flag (used internally by task-group-cancel)
;; This is called automatically by task-group-cancel

(defn __fiber_set_cancelled [cancelled : int] : nil
  ```c
  tur_fiber_set_cancelled((bool)cancelled);
  ```)
;;; task-group-cancelled? -- check whether a specific task group has been cancelled.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Returns:
;;;   true if the group's cancelled flag is set; false otherwise.
;;;
;;; Example:
;;;   (if (task-group-cancelled? g) ...)  ; => bool
;;;
;;; Since: Phase T22
;; Check if a specific task group has been cancelled

(defn task-group-cancelled? [^borrow group : TaskGroup] : bool
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  bool c = g->cancelled;
  pthread_mutex_unlock(&g->lock);
  return c;
  ```)
;;; task-group-should-exit? -- return true if the current task should stop, checking both fiber and group cancellation.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Returns:
;;;   true if either the current fiber or the group has been cancelled.
;;;
;;; Example:
;;;   (if (task-group-should-exit? g) ...)  ; => bool
;;;
;;; Since: Phase T22
;; Check if the current task should exit due to cancellation
;; PR-TG-003-2: Combines fiber-level and group-level cancellation checks
;; Returns true if either the current fiber was cancelled or the group was cancelled

(defn task-group-should-exit? [^borrow group : TaskGroup] : bool
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;

  /* Check fiber-level cancellation first (thread-local flag) */
  if (tur_fiber_cancelled()) return true;

  /* Check group-level cancellation */
  pthread_mutex_lock(&g->lock);
  bool should_exit = g->cancelled;
  pthread_mutex_unlock(&g->lock);
  return should_exit;
  ```)
;;; fiber-should-exit? -- check whether the current fiber should exit (without group context).
;;;
;;; Returns:
;;;   true if the thread-local cancelled flag is set.
;;;
;;; Example:
;;;   (if (fiber-should-exit?) ...)  ; => bool
;;;
;;; Since: Phase T22
;; Alternative: check if current fiber should exit (without group context)
;; Returns true if the thread-local cancelled flag is set

(defn fiber-should-exit? [] : bool (fiber-cancelled?))
;;; task-group-done? -- check whether all tasks in the group have completed.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Returns:
;;;   true if all spawned tasks have called task-group-task-done.
;;;
;;; Example:
;;;   (if (task-group-done? g) ...)  ; => bool
;;;
;;; Since: Phase T22
;; Check if all tasks in the group have completed

(defn task-group-done? [^borrow group : TaskGroup] : bool
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  bool d = g->done;
  pthread_mutex_unlock(&g->lock);
  return d;
  ```)
;;; task-group-task-done -- signal that the calling task has completed; must be called by each spawned task.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Example:
;;;   (task-group-task-done g)
;;;
;;; Since: Phase T22
;; Signal that a task has completed. Must be called by each spawned task.

(defn task-group-task-done [^borrow group : TaskGroup] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  if (!g) return;
  pthread_mutex_lock(&g->lock);
  g->completed_count++;
  if (g->completed_count >= g->task_count && g->task_count > 0) {
      g->done = true;
      pthread_cond_broadcast(&g->done_cond);
  }
  pthread_mutex_unlock(&g->lock);
  ```)
;;; task-group-wait -- block until all tasks in the group have completed.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Example:
;;;   (task-group-wait g)
;;;
;;; Since: Phase T22
;; Wait for all tasks in the group to complete

(defn task-group-wait [^borrow group : TaskGroup] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  while (!g->done)
      pthread_cond_wait(&g->done_cond, &g->lock);
  pthread_mutex_unlock(&g->lock);
  ```)
;;; task-group-cancel -- cooperatively cancel all tasks in the group (reason: manual).
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Example:
;;;   (task-group-cancel g)
;;;
;;; Since: Phase T22
;; Cancel all tasks in the group (cooperative)
;; Sets the cancelled flag and marks the group as done
;; Tasks must check `fiber-cancelled?` or `task-group-cancelled?` and exit

(defn task-group-cancel [^borrow group : TaskGroup] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->cancelled = true;
  g->done = true;
  g->cancel_reason = 0;  /* Phase TG-004-2: default to manual cancel (0) */
  pthread_cond_broadcast(&g->done_cond);
  pthread_mutex_unlock(&g->lock);
  /* Also set the thread-local cancelled flag for fibers in this group */
  __fiber_set_cancelled(1);
  ```)
;;; task-group-cancel-with-reason -- cancel all tasks in the group with a specific reason code.
;;;
;;; Parameters:
;;;   group  -- task group handle returned by task-group-new
;;;   reason -- cancel reason: 0=manual, 1=panic, 2=timeout, 3=error
;;;
;;; Example:
;;;   (task-group-cancel-with-reason g 2)
;;;
;;; Since: Phase T22
;; Cancel all tasks in the group with a specific reason
;; Phase TG-004-2: Extended cancel with reason parameter
;;   reason: 0=manual, 1=panic, 2=timeout, 3=error

(defn task-group-cancel-with-reason [^borrow group : TaskGroup reason : int] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->cancelled = true;
  g->done = true;
  g->cancel_reason = reason;
  pthread_cond_broadcast(&g->done_cond);
  pthread_mutex_unlock(&g->lock);
  __fiber_set_cancelled(1);
  ```)
;;; task-group-cancel-panic -- cancel the group with reason 1 (panic).
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Example:
;;;   (task-group-cancel-panic g)
;;;
;;; Since: Phase T22
;; Convenience: cancel with panic reason (1)

(defn task-group-cancel-panic [^borrow group : TaskGroup] : nil
  (task-group-cancel-with-reason group 1))
;;; task-group-cancel-timeout -- cancel the group with reason 2 (timeout).
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Example:
;;;   (task-group-cancel-timeout g)
;;;
;;; Since: Phase T22
;; Convenience: cancel with timeout reason (2)

(defn task-group-cancel-timeout [^borrow group : TaskGroup] : nil
  (task-group-cancel-with-reason group 2))
;;; task-group-cancel-error -- cancel the group with reason 3 (error).
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Example:
;;;   (task-group-cancel-error g)
;;;
;;; Since: Phase T22
;; Convenience: cancel with error reason (3)

(defn task-group-cancel-error [^borrow group : TaskGroup] : nil
  (task-group-cancel-with-reason group 3))
;;; task-group-cancel-reason -- return the reason code why the group was cancelled.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Returns:
;;;   An int reason code: 0=manual, 1=panic, 2=timeout, 3=error.
;;;
;;; Example:
;;;   (task-group-cancel-reason g)  ; => int
;;;
;;; Since: Phase T22
;; Get the reason why the task group was cancelled
;; Phase TG-004-2: Returns the cancel reason code
;;   0 = manual cancel (via task-group-cancel)
;;   1 = panic in a child task
;;   2 = timeout
;;   3 = error/exception in a child task

(defn task-group-cancel-reason [^borrow group : TaskGroup] : int
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
      int64_t cancel_reason;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  int64_t reason = g->cancel_reason;
  pthread_mutex_unlock(&g->lock);
  return reason;
  ```)
;;; task-group-spawn -- spawn a fiber into the task group and return its handle.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;   f     -- zero-argument fiber entry-point function pointer
;;;
;;; Returns:
;;;   A ptr<void> fiber handle that can be passed to task-group-join.
;;;
;;; Example:
;;;   (let [h (task-group-spawn g my-fiber-fn)] ...)  ; => ptr<void>
;;;
;;; Since: Phase T22
;; Spawn a fiber in the task group
;; Returns a fiber handle that can be used with task-group-join (Phase TG-002)

(defn task-group-spawn [^borrow group : TaskGroup f : ptr<void>] : TaskHandle
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  typedef void (*FiberFn)(void);

  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->task_count++;
  pthread_mutex_unlock(&g->lock);

  /* Spawn the fiber via the scheduler */
  void *fiber = tur_fiber_block_new((FiberFn)f, 0);
  if (!fiber) { fprintf(stderr, "task-group-spawn: fiber oom\n"); abort(); }

  /* Set the fiber's task_group so it can notify on completion (Phase TG-002) */
  typedef struct FiberBlock FiberBlock;
  ((FiberBlock *)fiber)->task_group = (void *)g;
  ((FiberBlock *)fiber)->cancelled = g->cancelled;

  return (void *)(intptr_t)fiber;
  ```)
;;; task-group-join -- wait for a specific spawned fiber to complete.
;;;
;;; Parameters:
;;;   group  -- task group handle returned by task-group-new
;;;   handle -- fiber handle returned by task-group-spawn
;;;
;;; Example:
;;;   (task-group-join g h)
;;;
;;; Since: Phase T22
;; Wait for a specific task (fiber handle) to complete
;; Phase TG-002: task-group-join [group handle] — await specific task completion

(defn task-group-join [^borrow group : TaskGroup handle : TaskHandle] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  typedef struct FiberBlock FiberBlock;

  TaskGroupBlock *g = (TaskGroupBlock *)group;
  FiberBlock *f = (FiberBlock *)handle;

  /* If fiber already done, return immediately */
  if (!f) return;
  if (f->done) return;

  /* Check that fiber belongs to this group */
  if (f->task_group != (void *)g) {
      fprintf(stderr, "task-group-join: fiber not from this group\n");
      return;
  }

  /* Wait for the fiber to complete using the group's condition variable */
  /* This is a v1 simplification - in a full implementation each fiber would
   * have its own condition variable. We use the group lock and wake up
   * whenever any task completes, then re-check our specific fiber. */
  pthread_mutex_lock(&g->lock);
  while (!f->done && !g->cancelled) {
      pthread_cond_wait(&g->done_cond, &g->lock);
  }
  pthread_mutex_unlock(&g->lock);
  ```)
;;; task-handle-done? -- non-blocking check whether a specific spawned fiber has completed.
;;;
;;; Parameters:
;;;   handle -- fiber handle returned by task-group-spawn
;;;
;;; Returns:
;;;   true if the fiber is done or the handle is NULL.
;;;
;;; Example:
;;;   (if (task-handle-done? h) ...)  ; => bool
;;;
;;; Since: Phase T22
;; Check if a specific task (fiber handle) has completed
;; Phase TG-002: Helper for non-blocking check

(defn task-handle-done? [handle : TaskHandle] : bool
  ```c
  typedef struct FiberBlock FiberBlock;
  FiberBlock *f = (FiberBlock *)handle;
  return f ? f->done : true;  /* NULL handle is considered "done" */
  ```)
;;; task-group-free -- destroy a task group and release its memory.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;
;;; Example:
;;;   (task-group-free g)
;;;
;;; Since: Phase T22
;; Free the task group

(defn task-group-free [group : TaskGroup] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_destroy(&g->lock);
  pthread_cond_destroy(&g->done_cond);
  free(g);
  ```)
;; ---- TaskGroup::with macro ----
;; TaskGroup::with [group & body] - runs body, waits for all spawned tasks


(defmacro task-group-with [group & body] `(do ~@body (task-group-wait ~group)))
;; ---- TaskGroup::with-timeout macro (Phase T22) ----
;; TaskGroup::with-timeout [group ms & body] - runs body, auto-cancels after ms milliseconds
;; Uses a background thread to sleep and then cancel the group


(defmacro task-group-with-timeout [group ms & body]
  `(let [timeout_thread (spawn-timeout-thread ~group ~ms)]
     (do ~@body (task-group-wait ~group) (join-timeout-thread timeout_thread))))
;;; spawn-timeout-thread-fn -- pthread body for spawn-timeout-thread. INTERNAL.
;;
;; Hoisted from a GCC nested-function definition inside spawn-timeout-thread.
;; Same pattern as future-timeout-thread / threadpool.tur::tp-worker.

(defn spawn-timeout-thread-fn [raw : ptr<void>] : ptr<void>
  ```c
  typedef struct { void *tg; int ms; } TimeoutArg;
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  TimeoutArg *a = (TimeoutArg *)raw;
  struct timespec ts = { .tv_sec = a->ms / 1000, .tv_nsec = (a->ms % 1000) * 1000000L };
  nanosleep(&ts, NULL);
  TaskGroupBlock *g = (TaskGroupBlock *)a->tg;
  pthread_mutex_lock(&g->lock);
  g->cancelled = true;
  g->done = true;
  pthread_cond_broadcast(&g->done_cond);
  pthread_mutex_unlock(&g->lock);
  free(a);
  return NULL;
  ```)
;;; spawn-timeout-thread -- spawn a background thread that cancels the group after ms milliseconds.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;   ms    -- delay in milliseconds before the group is cancelled
;;;
;;; Returns:
;;;   A ptr<void> thread handle (detached; free with join-timeout-thread).
;;;
;;; Since: Phase T22
;; Helper: spawn a timeout thread that cancels the group


(defn spawn-timeout-thread [^borrow group : TaskGroup ms : int] : ptr<void>
  ```c
  pthread_t *t = (pthread_t *)malloc(sizeof(pthread_t));
  if (!t) { fprintf(stderr, "spawn-timeout: oom\n"); abort(); }

  typedef struct { void *tg; int ms; } TimeoutArg;
  TimeoutArg *arg = (TimeoutArg *)malloc(sizeof(TimeoutArg));
  if (!arg) { free(t); fprintf(stderr, "spawn-timeout: arg oom\n"); abort(); }
  arg->tg = (void*)(intptr_t)group;
  arg->ms = (int)ms;

  pthread_create(t, NULL, (void *(*)(void *))spawn_hytimeout_hythread_hyfn, arg);
  pthread_detach(*t);
  return (void *)t;
  ```)
;;; join-timeout-thread -- free the handle of a detached timeout thread.
;;;
;;; Parameters:
;;;   t -- thread handle returned by spawn-timeout-thread
;;;
;;; Example:
;;;   (join-timeout-thread t)
;;;
;;; Since: Phase T22
;; Helper: join the timeout thread (detached, just free handle)

(defn join-timeout-thread [t : ptr<void>] : nil
  ```c
  pthread_t *tid = (pthread_t *)t;
  free(tid);
  ```)
;; ---- Automatic cancellation propagation (Phase TG-004-1) ----
;;
;; When a child task panics, the parent task group is automatically cancelled
;; with reason=1 (panic). This is implemented in the runtime's tur_fiber_shim
;; function which wraps fiber execution with a setjmp/longjmp handler that
;; catches panics and cancels the group.
;;
;; No additional API needed - automatic cancellation propagation is built
;; into fibers that have a task_group set.
;; ---- TaskGroup::with-cancellation macro (Phase TG-003) ----
;;
;; task-group-with-cancellation [group & body] - runs body in a context where
;; cancellation can be checked. The body should periodically call
;; (task-group-cancelled? group) or (fiber-cancelled?) to check if it should
;; exit early.
;;
;; PR-TG-003-3: Implemented with entry-point cancellation check. Checks for
;; cancellation before executing body; if already cancelled, skips body and
;; returns nil. Otherwise runs body and waits for all spawned tasks. Cooperative
;; cancellation within the body requires explicit checks using the provided
;; cancellation check point API (task-group-should-exit? / fiber-should-exit?).


(defmacro task-group-with-cancellation [group & body]
  `(if (task-group-should-exit? ~group)
     nil
     (do ~@body (task-group-wait ~group))))
;; ---- TG-006: Integration with async/await ----
;;
;; Fiber-based async integration: task-group-spawn-async creates a real fiber
;; for the computation, registers it with the task group, and returns a Future.
;; The future is fulfilled when the fiber completes. The caller drives the
;; fiber by awaiting the future (which runs the scheduler until done).
;;; __tg-async-entry -- internal fiber entry point for task-group-spawn-async (internal use only).
;;;
;;; Since: Phase T22
;; Entry point for fibers spawned by task-group-spawn-async.
;; Reads the fn pointer and future from fiber_local, calls fn, fulfills future.


(defn __tg-async-entry [] : nil
  ```c
  typedef struct { int64_t (*fn)(void); void *future; } TgAsyncArg;
  FiberBlock *self = tur_current_fiber;
  if (!self) return;
  TgAsyncArg *a = (TgAsyncArg *)self->fiber_local;
  if (!a) return;
  int64_t result = a->fn();
  tur_future_fulfill((TurFuture *)a->future, result);
  free(a);
  self->fiber_local = NULL;
  ```)
;;; task-group-spawn-async -- spawn an async computation into a task group and return a Future.
;;;
;;; Parameters:
;;;   group -- task group handle returned by task-group-new
;;;   f     -- no-argument function returning int64_t to run as a fiber
;;;
;;; Returns:
;;;   A ptr<void> Future fulfilled with f's return value when the fiber completes.
;;;
;;; Example:
;;;   (let [fut (task-group-spawn-async g my-thunk)] (await fut))  ; => ptr<void>
;;;
;;; Since: Phase T22
;; Spawn an async computation into a task group.
;; Takes a no-argument function that returns int64, spawns it as a fiber in the
;; group, and returns a Future that will be fulfilled with the result.
;; The fiber runs when the scheduler is driven (e.g., by (await future)).
;; TG-006: Fiber-based async integrated with TaskGroup lifecycle.

(defn task-group-spawn-async [^borrow group : TaskGroup f : ptr<void>] : ptr<void>
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t  done_cond;
      int64_t task_count;
      int64_t completed_count;
      bool cancelled;
      bool done;
  } TaskGroupBlock;
  typedef struct { int64_t (*fn)(void); void *future; } TgAsyncArg;

  TaskGroupBlock *g = (TaskGroupBlock *)group;
  pthread_mutex_lock(&g->lock);
  g->task_count++;
  pthread_mutex_unlock(&g->lock);

  if (!tur_scheduler) tur_scheduler = tur_scheduler_new();

  TurFuture *future = tur_future_new();
  TgAsyncArg *arg = (TgAsyncArg *)malloc(sizeof(TgAsyncArg));
  if (!arg) { fprintf(stderr, "task-group-spawn-async: oom\n"); abort(); }
  arg->fn = (int64_t (*)(void))(intptr_t)f;
  arg->future = (void *)future;

  FiberBlock *fiber = tur_fiber_block_new((void(*)(void))_un_untg_hyasync_hyentry, 0);
  if (!fiber) { fprintf(stderr, "task-group-spawn-async: fiber oom\n"); abort(); }
  fiber->fiber_local = (void *)arg;
  fiber->task_group  = (void *)g;
  fiber->cancelled   = g->cancelled;

  tur_scheduler_spawn(tur_scheduler, fiber);
  return (void *)future;
  ```)
;; Macro: Spawn an async block into a task group
;; TG-006: task-group-async [group async-thunk] — spawn async task into group
;; The async-thunk is a no-argument function that returns a value.
;; Returns a future that can be awaited to drive the fiber to completion.

(defmacro task-group-async [group async-thunk]
  `(task-group-spawn-async ~group ~async-thunk))
