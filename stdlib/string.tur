;;; tur/string -- owned, immutable, refcounted String.
;;;
;;; Unlike `cstr` (a borrowed raw `const char*` with no length or ownership) and
;;; `str` (a borrowed pointer+length view), a `String` OWNS its bytes: it is a
;;; refcounted immutable heap payload `{ rc; len; bytes[len+1] }`, NUL-terminated
;;; so a borrowed cstr view is O(1).  Reach for `String` when a string must
;;; outlive its source -- a value returned past its buffer, a stored field, or a
;;; Map/Set key.  As a `MapKey` the map copies and owns the key bytes
;;; (`mk-owned? = 1`), so a `String` key never dangles the way a computed `cstr`
;;; key does.
;;;
;;; `String` is immutable; every transform returns a fresh `String`.  Build one
;;; incrementally with `StringBuilder` so repeated concatenation stays linear.
;;;
;;; Since: v2 (owned-string-type-plan)
;; ---------------------------------------------------------------------------
;; NOTE (show-owned-result-plan stage 4): the typeclass loads that instantiate
;; String against Eq/Ord/Show/Hash/Clone/MapKey moved BELOW the String type +
;; ops (see the load block just above the instance section at the bottom of the
;; file).  Show now returns an owned String, so stdlib/typeclass-show.tur loads
;; THIS file -- the loads must therefore run only after `String` and its ops are
;; defined, or the reentrant (load "stdlib/string.tur") from typeclass-show.tur
;; would see an undefined String in `(defclass Show [a] (show [x] : String))`.
;; ---- Opaque handle newtypes ------------------------------------------------
;; String lowers to :ptr<void> in the C ABI (a pointer to the refcounted
;; payload); the newtype keeps it nominally distinct so the checker rejects
;; passing an unrelated handle where a String is expected.
;; :non-null -- the author's claim that a String handle is never the null
;; pointer (tur_string_from_bytes mallocs unconditionally; no producer returns
;; 0).  This is what makes (Option String) eligible for the option-niche
;; representation; the niche Some ctor enforces it at construction.
(defopaque String :ptr<void> :non-null)

(defopaque StringBuilder :ptr<void> :non-null)
;; ---- Runtime primitives (src/runtime/tur_string.c) -------------------------
;; Declared raw (:ptr / :cstr / :int / :bool); the public ops below wrap them
;; with the String / StringBuilder newtypes.  The interpreter registers a native
;; of the same name for each (src/turi/string_native.c), so these resolve under
;; --interpret exactly as when compiled.

(load "stdlib/string-ffi.tur")
;; ---- Construction / conversion ---------------------------------------------
;;; string/from-cstr -- copy a NUL-terminated C string into a fresh owned String.
;;;
;;; Parameters:
;;;   s -- the source cstr (a literal or borrowed buffer); its bytes are copied
;;;
;;; Returns:
;;;   A new String (refcount 1) owning a private copy of s's bytes.
;;;
;;; Example:
;;;   (string/from-cstr "hello")  ; => String "hello"
;;;
;;; Since: v2

(defn string/from-cstr [s : cstr] : String (:: (tur_string_from_cstr s) String))
;;; string/to-cstr -- borrow the String's NUL-terminated bytes (O(1), no copy).
;;;
;;; The returned cstr points into the String's payload and stays valid only
;;; while the String is retained; do not use it after the String is released.
;;;
;;; Parameters:
;;;   s -- the String to borrow from
;;;
;;; Returns:
;;;   A borrowed cstr view of the same bytes.
;;;
;;; Example:
;;;   (string/to-cstr (string/from-cstr "hi"))  ; => "hi"
;;;
;;; Since: v2

(defn string/to-cstr [s : String] : cstr (tur_string_cstr (:: s ptr<void>)))
;;; string/adopt-cstr -- take ownership of a freshly-allocated cstr as a String.
;;;
;;; Copies the bytes of `s` into a fresh owned String and FREES `s`.  This is the
;;; owned-adoption bridge for the many stdlib functions that return a malloc'd
;;; cstr ("caller frees the result") -- wrap such a call in string/adopt-cstr and
;;; the result is a real owned String, leak-free:
;;;
;;;   (string/adopt-cstr (path/join base seg))   ; owned path String
;;;   (string/adopt-cstr (digest/sha256-hex ...)) ; owned digest String
;;;
;;; WARNING: `s` MUST be a heap buffer the caller owns. Never pass a string
;;; literal or a borrowed cstr (an accessor's return, a struct field) -- freeing
;;; that is undefined behavior. When in doubt, use string/from-cstr (which copies
;;; without freeing).
;;;
;;; Parameters:
;;;   s -- a freshly heap-allocated NUL-terminated cstr; consumed (freed)
;;;
;;; Returns:
;;;   A new owned String holding a copy of s's bytes.
;;;
;;; Since: v2 (string-adoption-stdlib-plan, batch 1)

(defn string/adopt-cstr [s : cstr] : String
  (:: (tur_string_adopt_cstr s) String))
;;; int->string -- format a signed integer as a fresh owned decimal String.
;;;
;;; The owned counterpart of int->str (which returns a caller-frees cstr); builds
;;; the String directly with no cstr intermediate.
;;;
;;; Parameters:
;;;   v -- the integer to render
;;;
;;; Returns:
;;;   A new owned String, e.g. (int->string -7) => String "-7".
;;;
;;; Example:
;;;   (string/to-cstr (int->string 42))  ; => "42"
;;;
;;; Since: v2 (string-adoption-stdlib-plan, batch 1)

(defn int->string [v : int] : String (:: (tur_string_from_int v) String))
;;; string/retain -- increment the refcount, returning a second owning handle.
;;;
;;; Since: v2

(defn string/retain [s : String] : String
  (:: (tur_string_retain (:: s ptr<void>)) String))
;;; string/release -- decrement the refcount; free the payload at zero.
;;;
;;; Since: v2

(defn string/release [s : String] : void (tur_string_release (:: s ptr<void>)))
;; ---- Queries ---------------------------------------------------------------
;;; string/len -- byte length of the String (not counting the NUL).
;;;
;;; Since: v2

(defn string/len [s : String] : int (tur_string_len (:: s ptr<void>)))
;;; string/empty? -- true iff the String has length zero.
;;;
;;; Since: v2

(defn string/empty? [s : String] : bool (tur_string_empty (:: s ptr<void>)))
;;; string/byte-at -- the byte (0..255) at index i, or -1 if out of range.
;;;
;;; Since: v2

(defn string/byte-at [s : String i : int] : int
  (tur_string_byte_at (:: s ptr<void>) i))
;;; string/byte-is? -- is the byte at index i the character c?
;;;
;;; The bounds-checked test a byte scanner needs: false when i is out of
;;; range, so it replaces
;;; `(if (< i (string/len s)) (= (string/byte-at s i) 44) false)` and the
;;; magic number with it.  It compares one byte with c's code, so c should be
;;; ASCII; a character whose code is above 127 is several bytes in UTF-8 and
;;; is not what this finds.
;;;
;;; Parameters:
;;;   s -- the String to look in (borrowed)
;;;   i -- a byte index; out of range is not an error
;;;   c -- the character to compare with
;;;
;;; Returns:
;;;   true iff 0 <= i < (string/len s) and the byte at i is c's code.
;;;
;;; Example:
;;;   (string/byte-is? (string/from-cstr "a,b") 1 #\,)  ; => true
;;;
;;; Since: markdown-library-plan S1
(defn string/byte-is? [s : String i : int c : Char] : bool
  (= (string/byte-at s i) (char->int c)))
;;; string/char-at -- the byte at index i as a Char, or (none) out of range.
;;;
;;; For byte-at-a-time scanning that wants to compare with character
;;; literals: `(match (string/char-at s i) (Some c) (eq? c #\#) (None) false)`.
;;; The Char is the raw byte (0..255); decoding UTF-8 is a separate step.
;;;
;;; Parameters:
;;;   s -- the String to look in (borrowed)
;;;   i -- a byte index; out of range is not an error
;;;
;;; Returns:
;;;   (some c) holding the byte at i, or (none) when i is out of range.
;;;
;;; Example:
;;;   (string/char-at (string/from-cstr "hi") 1)  ; => (some #\i)
;;;
;;; Since: markdown-library-plan S1
(defn string/char-at [s : String i : int] : (Option Char)
  (let [b (string/byte-at s i)] (if (< b 0) (none) (some (int->char b)))))
;;; string/eq? -- content equality (length then byte compare).
;;;
;;; Since: v2

(defn string/eq? [a : String b : String] : bool
  (tur_string_eq (:: a ptr<void>) (:: b ptr<void>)))
;;; string/compare -- lexicographic byte compare: -1, 0, or 1.
;;;
;;; Since: v2

(defn string/compare [a : String b : String] : int
  (tur_string_cmp (:: a ptr<void>) (:: b ptr<void>)))
;;; string/hash -- content hash over the exact byte range (length-aware).
;;;
;;; Since: v2

(defn string/hash [s : String] : int (tur_string_hash (:: s ptr<void>)))
;;; string/starts-with? -- true iff s begins with prefix.
;;;
;;; Since: v2

(defn string/starts-with? [s : String prefix : String] : bool
  (tur_string_starts_with (:: s ptr<void>) (:: prefix ptr<void>)))
;;; string/ends-with? -- true iff s ends with suffix.
;;;
;;; Since: v2

(defn string/ends-with? [s : String suffix : String] : bool
  (tur_string_ends_with (:: s ptr<void>) (:: suffix ptr<void>)))
;;; string/contains? -- true iff needle occurs as a substring of s.
;;;
;;; Since: v2

(defn string/contains? [s : String needle : String] : bool
  (tur_string_contains (:: s ptr<void>) (:: needle ptr<void>)))
;; ---- Search (markdown-library-plan S2) -------------------------------------
;; None of these allocates.  A position that may not exist is an
;; (Option int); a count or an end index that always exists is an int.
;; The loops are self-recursive helpers rather than named lets, because a
;; named let cannot declare a result type and its loop call defaults to int.
;;; string/-match-at -- internal: do bytes [k, n) of p equal s's from at+k on?

(defn string/-match-at [s : String p : String at : int k : int n : int] : bool
  (if (>= k n)
    true
    (if (= (string/byte-at s (+ at k)) (string/byte-at p k))
      (string/-match-at s p at (+ k 1) n)
      false)))
;;; string/starts-with-at? -- does prefix occur in s at byte offset at?
;;;
;;; string/starts-with? at any offset: the test a scanner makes before it
;;; consumes a token.  An offset out of range, or a prefix that would run
;;; past the end of s, gives false, not an error.  The empty prefix occurs
;;; at every offset from 0 to (string/len s).
;;;
;;; Parameters:
;;;   s      -- the String to look in (borrowed)
;;;   prefix -- the bytes to look for (borrowed)
;;;   at     -- the byte offset in s to test
;;;
;;; Returns:
;;;   true iff the bytes of s from at on begin with prefix.
;;;
;;; Example:
;;;   (string/starts-with-at? (string/from-cstr "a --> b") (string/from-cstr "-->") 2)  ; => true
;;;
;;; Since: markdown-library-plan S2
(defn string/starts-with-at? [s : String prefix : String at : int] : bool
  (let [n (string/len prefix)]
    (and (>= at 0)
      (<= (+ at n) (string/len s))
      (string/-match-at s prefix at 0 n))))
;;; string/-index-of-loop -- internal: first match of needle at i..last.

(defn string/-index-of-loop [s : String needle : String i : int last : int] : (Option int)
  (if (> i last)
    (none)
    (if (string/starts-with-at? s needle i)
      (some i)
      (string/-index-of-loop s needle (+ i 1) last))))
;;; string/index-of-from -- byte offset of the first needle at or after start.
;;;
;;; A negative start searches from 0; a start past the end finds nothing.
;;; The empty needle is found at start itself, while start <= (string/len s).
;;;
;;; Parameters:
;;;   s      -- the String to search (borrowed)
;;;   needle -- the bytes to find (borrowed)
;;;   start  -- the first byte offset a match may begin at
;;;
;;; Returns:
;;;   (some i) for the lowest i >= start where needle occurs, else (none).
;;;
;;; Example:
;;;   (string/index-of-from (string/from-cstr "a,b,c") (string/from-cstr ",") 2)  ; => (some 3)
;;;
;;; Since: markdown-library-plan S2
(defn string/index-of-from [s : String needle : String start : int] : (Option int)
  (string/-index-of-loop s
    needle
    (if (< start 0) 0 start)
    (- (string/len s) (string/len needle))))
;;; string/index-of -- byte offset of the first occurrence of needle in s.
;;;
;;; Parameters:
;;;   s      -- the String to search (borrowed)
;;;   needle -- the bytes to find (borrowed)
;;;
;;; Returns:
;;;   (some i) for the lowest i where needle occurs, or (none).  The empty
;;;   needle is found at 0.
;;;
;;; Example:
;;;   (string/index-of (string/from-cstr "key: value") (string/from-cstr ": "))  ; => (some 3)
;;;
;;; Since: markdown-library-plan S2
(defn string/index-of [s : String needle : String] : (Option int)
  (string/index-of-from s needle 0))
;;; string/-last-index-of-loop -- internal: last match of needle at i down to 0.

(defn string/-last-index-of-loop [s : String needle : String i : int] : (Option int)
  (if (< i 0)
    (none)
    (if (string/starts-with-at? s needle i)
      (some i)
      (string/-last-index-of-loop s needle (- i 1)))))
;;; string/last-index-of -- byte offset of the last occurrence of needle in s.
;;;
;;; Parameters:
;;;   s      -- the String to search (borrowed)
;;;   needle -- the bytes to find (borrowed)
;;;
;;; Returns:
;;;   (some i) for the highest i where needle occurs, or (none).  The empty
;;;   needle is found at (string/len s).
;;;
;;; Example:
;;;   (string/last-index-of (string/from-cstr "a/b/c") (string/from-cstr "/"))  ; => (some 3)
;;;
;;; Since: markdown-library-plan S2
(defn string/last-index-of [s : String needle : String] : (Option int)
  (string/-last-index-of-loop s needle (- (string/len s) (string/len needle))))
;;; string/-index-of-byte-loop -- internal: first i in [i, n) holding byte b.

(defn string/-index-of-byte-loop [s : String b : int i : int n : int] : (Option int)
  (if (>= i n)
    (none)
    (if (= (string/byte-at s i) b)
      (some i)
      (string/-index-of-byte-loop s b (+ i 1) n))))
;;; string/index-of-char-from -- byte offset of the first c at or after start.
;;;
;;; Compares single bytes, so c should be ASCII (see string/byte-is?).  A
;;; negative start searches from 0.
;;;
;;; Parameters:
;;;   s     -- the String to search (borrowed)
;;;   c     -- the character to find
;;;   start -- the first byte offset to look at
;;;
;;; Returns:
;;;   (some i) for the lowest i >= start holding c, or (none).
;;;
;;; Example:
;;;   (string/index-of-char-from (string/from-cstr "a]b]") #\] 2)  ; => (some 3)
;;;
;;; Since: markdown-library-plan S2
(defn string/index-of-char-from [s : String c : Char start : int] : (Option int)
  (string/-index-of-byte-loop s
    (char->int c)
    (if (< start 0) 0 start)
    (string/len s)))
;;; string/index-of-char -- byte offset of the first c in s.
;;;
;;; Parameters:
;;;   s -- the String to search (borrowed)
;;;   c -- the character to find (ASCII; see string/byte-is?)
;;;
;;; Returns:
;;;   (some i) for the lowest i holding c, or (none).
;;;
;;; Example:
;;;   (string/index-of-char (string/from-cstr "[link](url)") #\])  ; => (some 5)
;;;
;;; Since: markdown-library-plan S2
(defn string/index-of-char [s : String c : Char] : (Option int)
  (string/index-of-char-from s c 0))
;;; string/-span-loop -- internal: first i in [i, n) whose byte fails pred, else n.

(defn string/-span-loop [s : String pred : (fn [Char] bool) i : int n : int] : int
  (if (>= i n)
    n
    (if (pred (int->char (string/byte-at s i)))
      (string/-span-loop s pred (+ i 1) n)
      i)))
;;; string/span-while -- the index where a run of bytes satisfying pred ends.
;;;
;;; Scans from start while pred holds and returns the first index where it
;;; fails, or (string/len s) when it holds to the end.  The char.tur
;;; predicates plug straight in: indentation width, the end of a name, a run
;;; of digits.  pred sees each byte as a Char, so a multi-byte UTF-8
;;; character is several calls.  start is clamped into [0, (string/len s)].
;;;
;;; Parameters:
;;;   s     -- the String to scan (borrowed)
;;;   start -- the byte offset to start at
;;;   pred  -- the test each byte must pass to continue the run
;;;
;;; Returns:
;;;   The end of the run: an index in [start, (string/len s)].
;;;
;;; Example:
;;;   (string/span-while (string/from-cstr "   - item") 0 space?)  ; => 3
;;;
;;; Since: markdown-library-plan S2
(defn string/span-while [s : String start : int pred : (fn [Char] bool)] : int
  (let [n (string/len s)]
    (string/-span-loop s pred (if (< start 0) 0 (if (> start n) n start)) n)))
;;; string/-run-loop -- internal: first i in [i, n) not holding byte b, else n.

(defn string/-run-loop [s : String b : int i : int n : int] : int
  (if (>= i n)
    n
    (if (= (string/byte-at s i) b) (string/-run-loop s b (+ i 1) n) i)))
;;; string/run-length -- how many c in a row start at start.
;;;
;;; Counts a fence (three or more backticks), an ATX heading's #s, a
;;; thematic break's dashes.  Zero when start is out of range or the byte
;;; there is not c.
;;;
;;; Parameters:
;;;   s     -- the String to scan (borrowed)
;;;   start -- the byte offset the run starts at
;;;   c     -- the character the run is made of (ASCII)
;;;
;;; Returns:
;;;   The run's length in bytes, 0 or more.
;;;
;;; Example:
;;;   (string/run-length (string/from-cstr "## Title") 0 #\#)  ; => 2
;;;
;;; Since: markdown-library-plan S2
(defn string/run-length [s : String start : int c : Char] : int
  (let [n (string/len s)]
    (if (or (< start 0) (>= start n))
      0
      (- (string/-run-loop s (char->int c) start n) start))))
;; ---- Transforms (each returns a fresh immutable String) --------------------
;;; string/concat -- concatenate two Strings into a fresh String.
;;;
;;; Since: v2

(defn string/concat [a : String b : String] : String
  (:: (tur_string_concat (:: a ptr<void>) (:: b ptr<void>)) String))
;;; string/substring -- fresh String of len bytes starting at start (clamped).
;;;
;;; Out-of-range start/len are clamped to the String's bounds rather than
;;; erroring, so a substring past the end yields the empty String.
;;;
;;; Since: v2

(defn string/substring [s : String start : int len : int] : String
  (:: (tur_string_substring (:: s ptr<void>) start len) String))
;;; string/to-upper -- ASCII-uppercased copy.
;;;
;;; Since: v2

(defn string/to-upper [s : String] : String
  (:: (tur_string_to_upper (:: s ptr<void>)) String))
;;; string/to-lower -- ASCII-lowercased copy.
;;;
;;; Since: v2

(defn string/to-lower [s : String] : String
  (:: (tur_string_to_lower (:: s ptr<void>)) String))
;;; string/trim -- copy with ASCII leading/trailing whitespace removed.
;;;
;;; Since: v2

(defn string/trim [s : String] : String
  (:: (tur_string_trim (:: s ptr<void>)) String))
;; ---- StringBuilder ---------------------------------------------------------
;;; builder/new -- a fresh empty StringBuilder (mutable, growable byte buffer).
;;;
;;; Since: v2

(defn builder/new [] : StringBuilder (:: (tur_sb_new) StringBuilder))
;;; builder/push-cstr! -- append a cstr's bytes to the builder.
;;;
;;; Since: v2

(defn builder/push-cstr! [b : StringBuilder s : cstr] : void
  (tur_sb_push_cstr (:: b ptr<void>) s))
;;; builder/push-string! -- append a String's bytes to the builder.
;;;
;;; Since: v2

(defn builder/push-string! [b : StringBuilder s : String] : void
  (tur_sb_push_string (:: b ptr<void>) (:: s ptr<void>)))
;;; builder/push-byte! -- append a single byte (0..255) to the builder.
;;;
;;; Since: v2

(defn builder/push-byte! [b : StringBuilder c : int] : void
  (tur_sb_push_byte (:: b ptr<void>) c))
;;; builder/push-char! -- append one character (a Char, 0..255) to the builder.
;;;
;;; Parameters:
;;;   b -- the builder to append to
;;;   c -- the character to append
;;;
;;; Example:
;;;   (let [b (builder/new)]
;;;     (do (builder/push-char! b #\h)
;;;         (builder/push-char! b #\i)
;;;         (builder/finish b)))  ; => String "hi"
;;;
;;; Since: parsec-guide-plan P1

(defn builder/push-char! [b : StringBuilder c : Char] : void
  (tur_sb_push_byte (:: b ptr<void>) (char->int c)))
;;; builder/push-int! -- append the decimal digits of an int to the builder.
;;;
;;; Writes the digits straight into the builder, with a leading - when v is
;;; negative, so there is no temporary String to release, unlike pushing
;;; (int->string v).
;;;
;;; Parameters:
;;;   b -- the builder to append to
;;;   v -- the number to write
;;;
;;; Example:
;;;   (let [b (builder/new)]
;;;     (do (builder/push-int! b -42)
;;;         (string/to-cstr (builder/finish b))))  ; => "-42"
;;;
;;; Since: markdown-library-plan S5
(defn builder/push-int! [b : StringBuilder v : int] : void
  (tur_sb_push_int (:: b ptr<void>) v))
;;; builder/push-repeat! -- append n copies of the character c to the builder.
;;;
;;; Indentation, a rule of dashes, the padding of a column.  Nothing is
;;; appended when n is 0 or less.  c is one byte, so it should be ASCII.
;;;
;;; Parameters:
;;;   b -- the builder to append to
;;;   c -- the character to repeat
;;;   n -- how many copies
;;;
;;; Example:
;;;   (let [b (builder/new)]
;;;     (do (builder/push-repeat! b #\- 3)
;;;         (string/to-cstr (builder/finish b))))  ; => "---"
;;;
;;; Since: markdown-library-plan S5
(defn builder/push-repeat! [b : StringBuilder c : Char n : int] : void
  (tur_sb_push_repeat (:: b ptr<void>) (char->int c) n))
;;; char->string -- a fresh one-character String holding c.
;;;
;;; Parameters:
;;;   c -- the character (0..255)
;;;
;;; Returns:
;;;   A new owned String of length 1.
;;;
;;; Example:
;;;   (string/to-cstr (char->string #\A))  ; => "A"
;;;
;;; Since: parsec-guide-plan P1

(defn char->string [c : Char] : String
  (let [b (builder/new)] (do (builder/push-char! b c) (builder/finish b))))
;;; builder/len -- number of bytes accumulated so far.
;;;
;;; Since: v2

(defn builder/len [b : StringBuilder] : int (tur_sb_len (:: b ptr<void>)))
;;; builder/finish -- freeze the accumulated bytes into an immutable String.
;;;
;;; Consumes the builder (frees it); do not use the builder afterward.
;;;
;;; Example:
;;;   (let [b (builder/new)]
;;;     (do (builder/push-cstr! b "a")
;;;         (builder/push-cstr! b "b")
;;;         (builder/finish b)))  ; => String "ab"
;;;
;;; Since: v2

(defn builder/finish [b : StringBuilder] : String
  (:: (tur_sb_finish (:: b ptr<void>)) String))
;; ---- Split, join, lines (markdown-library-plan S3) -------------------------
;; Each part split off is a fresh owned String (rc 1) in a fresh Vec; the
;; caller releases them all, and the Vec, with string/release-all.  The
;; zero-copy versions, which hand back StringSlices, are in string-slice.tur.
;;; string/-new-vec -- internal: an empty (Vec String) (a let-bound vec-new is not inferred).

(defn string/-new-vec [] : (Vec String) (vec-new))
;;; string/-copy-range -- internal: push a fresh String of s's bytes [start, end) onto out.

(defn string/-copy-range [out : (Vec String) s : String start : int end : int] : void
  (vec-push! out (string/substring s start (- end start))))
;;; string/-split-loop -- internal: split s on sep from start into out.

(defn string/-split-loop [s : String
                          sep : String
                          out : (Vec String)
                          start : int] : (Vec String)
  (match (string/index-of-from s sep start)
    (Some i)
    (do
      (string/-copy-range out s start i)
      (string/-split-loop s sep out (+ i (string/len sep))))
    (None)
    (do (string/-copy-range out s start (string/len s)) out)))
;;; string/split -- split s at each occurrence of sep.
;;;
;;; The parts between separators, in order, including empty ones: "a,,b,"
;;; split on "," is "a", "", "b", "".  A string with no sep gives one part,
;;; a copy of itself; the empty string gives one empty part.  An empty sep
;;; also gives one part, the whole string, since it would match everywhere.
;;;
;;; Parameters:
;;;   s   -- the String to split (borrowed)
;;;   sep -- the separator (borrowed)
;;;
;;; Returns:
;;;   A fresh (Vec String) of fresh owned parts, at least one.  Free it with
;;;   string/release-all.
;;;
;;; Example:
;;;   (vec-len (string/split (string/from-cstr "a, b, c") (string/from-cstr ", ")))  ; => 3
;;;
;;; Since: markdown-library-plan S3
(defn string/split [s : String sep : String] : (Vec String)
  (if (string/empty? sep)
    (let [out (string/-new-vec)]
      (do (string/-copy-range out s 0 (string/len s)) out))
    (string/-split-loop s sep (string/-new-vec) 0)))
;;; string/-split-char-loop -- internal: split s on byte b from start into out.

(defn string/-split-char-loop [s : String
                               c : Char
                               out : (Vec String)
                               start : int] : (Vec String)
  (match (string/index-of-char-from s c start)
    (Some i)
    (do
      (string/-copy-range out s start i)
      (string/-split-char-loop s c out (+ i 1)))
    (None)
    (do (string/-copy-range out s start (string/len s)) out)))
;;; string/split-char -- split s at each occurrence of the character c.
;;;
;;; string/split with a one-byte separator, so c should be ASCII.  Empty
;;; parts are kept: "|a||" split on #\| is "", "a", "", "".
;;;
;;; Parameters:
;;;   s -- the String to split (borrowed)
;;;   c -- the separator character
;;;
;;; Returns:
;;;   A fresh (Vec String) of fresh owned parts, at least one.  Free it with
;;;   string/release-all.
;;;
;;; Example:
;;;   (vec-len (string/split-char (string/from-cstr "| a | b |") #\|))  ; => 4
;;;
;;; Since: markdown-library-plan S3
(defn string/split-char [s : String c : Char] : (Vec String)
  (string/-split-char-loop s c (string/-new-vec) 0))
;;; string/-lines-loop -- internal: push s's lines from start into out, scanning at i.

(defn string/-lines-loop [s : String
                          out : (Vec String)
                          start : int
                          i : int
                          n : int] : (Vec String)
  (if (>= i n)
    (do (when (< start n) (string/-copy-range out s start n)) out)
    (if (string/byte-is? s i #\newline)
      (do
        (string/-copy-range out s start i)
        (string/-lines-loop s out (+ i 1) (+ i 1) n))
      (if (string/byte-is? s i #\return)
        (let [next (if (string/byte-is? s (+ i 1) #\newline) (+ i 2) (+ i 1))]
          (do
            (string/-copy-range out s start i)
            (string/-lines-loop s out next next n)))
        (string/-lines-loop s out start (+ i 1) n)))))
;;; string/lines -- split s into lines, without their line endings.
;;;
;;; A line ends at LF, CRLF or CR, the three endings CommonMark recognises.
;;; A final line ending does not start another line, so "a\nb\n" is two
;;; lines, "a\n\n" is "a" and "", and the empty string has no lines.
;;;
;;; Parameters:
;;;   s -- the String to split (borrowed)
;;;
;;; Returns:
;;;   A fresh (Vec String) of fresh owned lines, possibly empty.  Free it
;;;   with string/release-all.
;;;
;;; Example:
;;;   (vec-len (string/lines (string/from-cstr "one\r\ntwo\n")))  ; => 2
;;;
;;; Since: markdown-library-plan S3
(defn string/lines [s : String] : (Vec String)
  (string/-lines-loop s (string/-new-vec) 0 0 (string/len s)))
;;; string/-join-loop -- internal: push parts [i, n) onto b, sep between them.

(defn string/-join-loop [parts : (Vec String)
                         sep : String
                         b : StringBuilder
                         i : int
                         n : int] : void
  (when (< i n)
    (do
      (when (> i 0) (builder/push-string! b sep))
      (builder/push-string! b (vec-get parts i))
      (string/-join-loop parts sep b (+ i 1) n))))
;;; string/join -- concatenate parts with sep between each pair.
;;;
;;; Borrows the parts and sep: none is released.  No parts give the empty
;;; String.  The inverse of string/split: joining what split returned with
;;; the same separator gives the original string back.
;;;
;;; Parameters:
;;;   parts -- the Strings to join, in order (borrowed)
;;;   sep   -- the separator to put between them (borrowed)
;;;
;;; Returns:
;;;   A fresh owned String.
;;;
;;; Example:
;;;   (let [v (string/split-char (string/from-cstr "a b c") #\space)]
;;;     (string/to-cstr (string/join v (string/from-cstr "-"))))  ; => "a-b-c"
;;;
;;; Since: markdown-library-plan S3
(defn string/join [parts : (Vec String) sep : String] : String
  (let [b (builder/new)]
    (do (string/-join-loop parts sep b 0 (vec-len parts)) (builder/finish b))))
;;; string/-release-loop -- internal: release v's elements [i, n).

(defn string/-release-loop [v : (Vec String) i : int n : int] : void
  (when (< i n)
    (do (string/release (vec-get v i)) (string/-release-loop v (+ i 1) n))))
;;; string/release-all -- release every String in v, then free v itself.
;;;
;;; The one call that frees what string/split, string/split-char and
;;; string/lines return.  A Vec does not own its elements, so vec-free alone
;;; would leak every String in it.  Do not use v, or any String taken out of
;;; it without string/retain, afterwards.
;;;
;;; Parameters:
;;;   v -- a (Vec String) whose elements this call owns
;;;
;;; Example:
;;;   (string/release-all (string/lines (string/from-cstr "a\nb")))
;;;
;;; Since: markdown-library-plan S3
(defn string/release-all [v : (Vec String)] : void
  (do (string/-release-loop v 0 (vec-len v)) (vec-free v)))
;; ---- Trims and transforms (markdown-library-plan S4) -----------------------
;; Each returns a fresh owned String and borrows its arguments.  Whitespace is
;; the ASCII set string/trim strips (char.tur's space?): space, tab, LF, VT,
;; FF and CR.
;;; string/-trim-end-loop -- internal: the index past the last non-space byte in [lo, i).

(defn string/-trim-end-loop [s : String lo : int i : int] : int
  (if (and (> i lo) (space? (int->char (string/byte-at s (- i 1)))))
    (string/-trim-end-loop s lo (- i 1))
    i))
;;; string/trim-start -- copy with the leading ASCII whitespace removed.
;;;
;;; Parameters:
;;;   s -- the String to trim (borrowed)
;;;
;;; Returns:
;;;   A fresh owned String: s from its first non-whitespace byte on.
;;;
;;; Example:
;;;   (string/to-cstr (string/trim-start (string/from-cstr "  - item ")))  ; => "- item "
;;;
;;; Since: markdown-library-plan S4
(defn string/trim-start [s : String] : String
  (let [i (string/span-while s 0 space?)]
    (string/substring s i (- (string/len s) i))))
;;; string/trim-end -- copy with the trailing ASCII whitespace removed.
;;;
;;; Parameters:
;;;   s -- the String to trim (borrowed)
;;;
;;; Returns:
;;;   A fresh owned String: s up to and including its last non-whitespace
;;;   byte.
;;;
;;; Example:
;;;   (string/to-cstr (string/trim-end (string/from-cstr " # Title \t")))  ; => " # Title"
;;;
;;; Since: markdown-library-plan S4
(defn string/trim-end [s : String] : String
  (string/substring s 0 (string/-trim-end-loop s 0 (string/len s))))
;;; string/-push-range! -- internal: append s's bytes [i, end) to b.

(defn string/-push-range! [b : StringBuilder s : String i : int end : int] : void
  (tur_sb_push_range (:: b ptr<void>) (:: s ptr<void>) i (- end i)))
;;; string/-replace-loop -- internal: copy s from start into b, with to in place of each from.

(defn string/-replace-loop [s : String
                            from : String
                            to : String
                            b : StringBuilder
                            start : int] : void
  (match (string/index-of-from s from start)
    (Some i)
    (do
      (string/-push-range! b s start i)
      (builder/push-string! b to)
      (string/-replace-loop s from to b (+ i (string/len from))))
    (None)
    (string/-push-range! b s start (string/len s))))
;;; string/replace-all -- copy of s with every occurrence of from replaced by to.
;;;
;;; A literal replace: from is matched byte for byte, left to right, and the
;;; scan resumes after each match, so occurrences never overlap and to is
;;; never searched.  An empty from matches nothing, so s comes back as a
;;; copy, the same rule string/split has for an empty separator.  For a
;;; pattern, use re/replace-all.
;;;
;;; Parameters:
;;;   s    -- the String to copy (borrowed)
;;;   from -- the text to replace (borrowed)
;;;   to   -- the text to put in its place (borrowed; may be empty)
;;;
;;; Returns:
;;;   A fresh owned String.
;;;
;;; Example:
;;;   (string/to-cstr (string/replace-all (string/from-cstr "a&b&c")
;;;                                       (string/from-cstr "&")
;;;                                       (string/from-cstr "&amp;")))  ; => "a&amp;b&amp;c"
;;;
;;; Since: markdown-library-plan S4
(defn string/replace-all [s : String from : String to : String] : String
  (let [b (builder/new)]
    (do
      (if (string/empty? from)
        (builder/push-string! b s)
        (string/-replace-loop s from to b 0))
      (builder/finish b))))
;;; string/-repeat-loop -- internal: append s to b n times.

(defn string/-repeat-loop [b : StringBuilder s : String n : int] : void
  (when (> n 0)
    (do (builder/push-string! b s) (string/-repeat-loop b s (- n 1)))))
;;; string/repeat -- s written n times in a row.
;;;
;;; Parameters:
;;;   s -- the String to repeat (borrowed)
;;;   n -- how many copies; 0 or less gives the empty String
;;;
;;; Returns:
;;;   A fresh owned String of (* n (string/len s)) bytes.
;;;
;;; Example:
;;;   (string/to-cstr (string/repeat (string/from-cstr "ab") 3))  ; => "ababab"
;;;
;;; Since: markdown-library-plan S4
(defn string/repeat [s : String n : int] : String
  (let [b (builder/new)] (do (string/-repeat-loop b s n) (builder/finish b))))
;;; string/pad-start -- s with copies of c in front, to make it width bytes.
;;;
;;; Lengths are in bytes, as everywhere in String, so c should be ASCII.  A
;;; String already width bytes or longer comes back as an unchanged copy; it
;;; is never cut.
;;;
;;; Parameters:
;;;   s     -- the String to pad (borrowed)
;;;   width -- the length to pad to
;;;   c     -- the padding character
;;;
;;; Returns:
;;;   A fresh owned String of (max width (string/len s)) bytes.
;;;
;;; Example:
;;;   (string/to-cstr (string/pad-start (int->string 42) 5 #\0))  ; => "00042"
;;;
;;; Since: markdown-library-plan S4
(defn string/pad-start [s : String width : int c : Char] : String
  (let [b (builder/new)]
    (do
      (builder/push-repeat! b c (- width (string/len s)))
      (builder/push-string! b s)
      (builder/finish b))))
;;; string/pad-end -- s with copies of c after it, to make it width bytes.
;;;
;;; string/pad-start, padding on the right: a table cell or a column of
;;; names.  A String already width bytes or longer comes back as a copy.
;;;
;;; Parameters:
;;;   s     -- the String to pad (borrowed)
;;;   width -- the length to pad to
;;;   c     -- the padding character (ASCII)
;;;
;;; Returns:
;;;   A fresh owned String of (max width (string/len s)) bytes.
;;;
;;; Example:
;;;   (string/to-cstr (string/pad-end (string/from-cstr "ab") 4 #\.))  ; => "ab.."
;;;
;;; Since: markdown-library-plan S4
(defn string/pad-end [s : String width : int c : Char] : String
  (let [b (builder/new)]
    (do
      (builder/push-string! b s)
      (builder/push-repeat! b c (- width (string/len s)))
      (builder/finish b))))
;; The digits are folded in counting down, not up, because the most negative
;; int has no positive twin; string/-signed-int flips the sign afterwards.
;;; string/-parse-digits -- internal: s's digits [i, n) folded into acc as a negative int, or (none).

(defn string/-parse-digits [s : String i : int n : int acc : int] : (Option int)
  (if (>= i n)
    (some acc)
    (let [d (char->digit (int->char (string/byte-at s i)))]
      (if (or (< d 0)
            (< acc -922337203685477580)
            (and (= acc -922337203685477580) (> d 8)))
        (none)
        (string/-parse-digits s (+ i 1) n (- (* acc 10) d))))))
;;; string/-signed-int -- internal: the parsed value from the negated digits, or (none).

(defn string/-signed-int [neg : bool digits : (Option int)] : (Option int)
  (match digits
    (Some v)
    (if neg (some v) (if (< v -9223372036854775807) (none) (some (- 0 v))))
    (None)
    (none)))
;;; string/parse-int -- the decimal integer s spells, or (none).
;;;
;;; The whole of s must be the number: an optional + or -, then one or more
;;; digits 0-9, and nothing else -- no spaces, no underscores, no 0x.
;;; Leading zeros are fine.  A number outside the 64-bit int range is
;;; (none), never a wrapped or clamped value.  str->int-checked, by
;;; contrast, takes a cstr, skips leading spaces and clamps on overflow.
;;;
;;; Parameters:
;;;   s -- the String to parse (borrowed)
;;;
;;; Returns:
;;;   (some n) when s is exactly a decimal integer n, else (none).
;;;
;;; Example:
;;;   (string/parse-int (string/from-cstr "-042"))  ; => (some -42)
;;;   (string/parse-int (string/from-cstr "12."))   ; => (none)
;;;
;;; Since: markdown-library-plan S4
(defn string/parse-int [s : String] : (Option int)
  (let [n     (string/len s)
        neg   (string/byte-is? s 0 #\-)
        start (if (or neg (string/byte-is? s 0 #\+)) 1 0)]
    (if (>= start n)
      (none)
      (string/-signed-int neg (string/-parse-digits s start n 0)))))
;; ---- Building from parts (markdown-library-plan S5) -----------------------
;; One push for every kind of part, so a line of output is one builder and no
;; temporaries.  StringSlice's instance is in string-slice.tur.  Floats have
;; no instance until float formatting is settled.
;;; BuilderPush -- types builder/push! can append; builder/-push-into! appends x to b.
;;;
;;; The value comes first because a class method dispatches on its first
;;; argument; builder/push! puts the builder first, like the other pushes.

(defclass BuilderPush [a]
  (builder/-push-into! [x : a b : StringBuilder] : void))
;;; BuilderPush [cstr] -- the bytes up to the NUL.

(definstance BuilderPush [cstr]
  (builder/-push-into! [x b] (builder/push-cstr! b x)))
;;; BuilderPush [String] -- the String's bytes; it is borrowed, not released.

(definstance BuilderPush [String]
  (builder/-push-into! [x b] (builder/push-string! b x)))
;;; BuilderPush [Char] -- the one character.

(definstance BuilderPush [Char]
  (builder/-push-into! [x b] (builder/push-char! b x)))
;;; BuilderPush [int] -- the decimal digits, as builder/push-int!.

(definstance BuilderPush [int]
  (builder/-push-into! [x b] (builder/push-int! b x)))
;;; BuilderPush [bool] -- true or false.

(definstance BuilderPush [bool]
  (builder/-push-into! [x b] (builder/push-cstr! b (if x "true" "false"))))
;;; builder/push! -- append any BuilderPush value to the builder.
;;;
;;; One name for every push: a cstr, String or StringSlice appends its bytes,
;;; a Char its character, an int its decimal digits and a bool true or false.
;;; The value is borrowed, so a String passed in is not released.  string/of
;;; is the usual way to reach this.
;;;
;;; Parameters:
;;;   b -- the builder to append to
;;;   x -- the value to append
;;;
;;; Example:
;;;   (let [b (builder/new)]
;;;     (do (builder/push! b "n=")
;;;         (builder/push! b 42)
;;;         (string/to-cstr (builder/finish b))))  ; => "n=42"
;;;
;;; Since: markdown-library-plan S5
(defn builder/push! [A] [(BuilderPush A)] [b : StringBuilder x : A] : void
  (builder/-push-into! x b))
;;; string/-push-all__ -- internal: (builder/push! b x) for each x, in order.

(defmacro string/-push-all__ [b & ^syntax xs]
  (if (empty? xs)
    `(do)
    `(do (builder/push! ~b ~(first xs)) (string/-push-all__ ~b ~@(rest xs)))))
;;; string/of -- one fresh String made of all its arguments, in order.
;;;
;;; Each argument is any BuilderPush value: a cstr, String, StringSlice,
;;; Char, int or bool.  It expands to one builder, a builder/push! per
;;; argument and builder/finish, so nothing in between is allocated, and the
;;; one String it returns is the only thing to release.  Arguments are
;;; borrowed and evaluated left to right.  A call that returns a fresh String,
;;; such as (int->string n), is borrowed too and would leak; pass n itself.
;;;
;;; Parameters:
;;;   xs -- the parts, zero or more
;;;
;;; Returns:
;;;   A fresh owned String; (string/of) is the empty String.
;;;
;;; Example:
;;;   (string/to-cstr (string/of "x=" 3 #\, "ok=" true))  ; => "x=3,ok=true"
;;;
;;; Since: markdown-library-plan S5
(defmacro string/of [& ^syntax xs]
  (let [b (gensym "sb")]
    `(let [~b (builder/new)]
       (do (string/-push-all__ ~b ~@xs) (builder/finish ~b)))))
;; ---- Typeclass loads (deferred to here so String + its ops exist first) ----
;; typeclass.tur transitively loads stdlib/typeclass-show.tur, whose owned
;; `Show` loads this file back -- reentrant, but harmless now that String and
;; every string/* op above are defined.  Show[String] itself lives in
;; typeclass-show.tur (Show's own module).

(load "stdlib/typeclass-eq.tur")

(load "stdlib/typeclass.tur")

(load "stdlib/typeclass-hash.tur")

(load "stdlib/typeclass-clone.tur")

(load "stdlib/map.tur")
;; ---- Typeclass instances ---------------------------------------------------
;;; Eq [String] -- content equality.

(definstance Eq [String] (eq? [x y] (string/eq? x y)))
;;; Ord [String] -- lexicographic byte ordering.

(definstance Ord [String]
  (lt? [x y] (< (string/compare x y) 0))
  (lte? [x y] (<= (string/compare x y) 0))
  (gt? [x y] (> (string/compare x y) 0))
  (gte? [x y] (>= (string/compare x y) 0)))
;; Show [String] -- lives in stdlib/typeclass-show.tur (Show's own module),
;; O(1) retain; moved there in stage 4 when Show's result became owned String.
;;; Hash [String] -- content hash over the byte range.

(definstance Hash [String] (hash [x] (string/hash x)))
;;; Clone [String] -- O(1) retain (refcount++), returning a second owning handle.

(definstance Clone [String] (clone [x] : int (:: (string/retain x) int)))
;;; Drop [String] -- release one owning handle (refcount--), freeing at zero.
;;;
;;; Paired with Clone [String] (retain), this lets the closure drop-glue treat a
;;; captured String as a shared refcounted owner: retained when captured, released
;;; when the capturing env dies -- so an owned String captured into an escaping
;;; closure (e.g. httpd mw-cors config strings) is reclaimed instead of leaking.
;;;
;;; Since: v2 (Model R)

(definstance Drop [String] (drop [x] : void (string/release x)))
;;; MapKey [String] -- owned key: the map copies the bytes into a boxed key it
;;; owns and frees (mk-owned? = 1), so a String key never dangles.  mk-cmp is the
;;; size-aware content comparator over boxed keys.

(definstance MapKey [String]
  (mk-box [x] : int (:: (tur_string_box_key (:: x ptr<void>)) int))
  (mk-cmp [x] : int (tur_string_key_eq_addr))
  (mk-owned? [x] 1))
;; ---------------------------------------------------------------------------
;; Autolink hint -- consumed by `tur build` / `tur run` (src/main.c).  The
;; __tur_autolink__ comment causes src/runtime/tur_string.c to be compiled
;; alongside the generated code, with -Isrc/runtime so tur_string.h is found.
;;; string/autolink-hint -- internal marker triggering tur_string.c compilation.

(defn string/autolink-hint []
  #fx{Unsafe}
  : int
  ```c
  /* __tur_autolink__: src/runtime/tur_string.c src/runtime/rt_alloc.c -Isrc/runtime */
  return 0;
  ```)
