;;; tur/map -- typed Map[K V]: persistent hash map requiring Hash[K] and MapKey[K].
;;;
;;; Backed by the persistent HAMT from tur/hamt.
;;;
;;; Since: Phase TM0 (typed surface: Phase TMS2)
;; Phase TMS2: Typed Map[K V] surface (typed-map-surface-plan).
;; K must satisfy Hash[K] and MapKey[K]; both are auto-loaded for the primitive
;; key types (int, bool, cstr, float32, float).
;; At runtime, a Map[K V] is a heap-allocated wrapper around a HAMT ptr<void>.
;; Map is declared as a non-transparent :heap struct with a single
;; (hamt :ptr<void>) field, so (Map K V) monomorphizes to a real Map__K__V C
;; struct and lowers to a typed pointer (Map__K__V *) in every pure-Turmeric C
;; signature, mirroring MutableMap.  The type checker tracks K and V and rejects
;; key/value mismatches.  Internal C layout of the carried pointer:
;; struct { void *hamt; } -- identical to the emitted Map__K__V, so the inline-C
;; bodies that cast to that anonymous struct stay byte-compatible.
;; Elaboration dependencies. Map[K V] needs Eq[K]/Hash[K] (the key typeclasses)
;; and the backing HAMT (the hamt/* iterator + comparator ops the Eq[Map]
;; instance walks); MapKey[K] is defined below in this file. The CLI auto-load
;; prelude already loads these before map.tur, so an already-loaded stdlib
;; module is deduped and these forms are no-ops there; declaring them here makes
;; an isolated `(load "stdlib/map.tur")` -- e.g. from a libturi embedder --
;; self-sufficient instead of tripping on unknown `hamt/*` names and an
;; undefined `Eq`. See docs/archive/history/interp-load-set-map-elaboration-gap.md.
(load "stdlib/typeclass-eq.tur")

(load "stdlib/typeclass-hash.tur")

(load "stdlib/hamt.tur")
;;; Map -- parameterized persistent map with key type K and value type V.
;;;
;;; Map[K V] is a non-transparent :heap struct holding a single ptr<void> to
;;; its backing HAMT.  The field is never accessed structurally (every
;;; operation is inline-C or delegates to one); it monomorphizes to a real
;;; Map__K__V so typed consumers receive a (Map__K__V *) by value.
;;;
;;; Since: Phase TM0

(defstruct Map :heap [K V] (hamt :ptr<void>))
;;; map-new -- create a new empty typed map.
;;;
;;; map-new is generic and nullary, so its K/V cannot be inferred from
;;; arguments.  Annotate it at the binding site when the type is otherwise
;;; unconstrained:
;;;
;;;   (let [m (:: (map-new) (Map cstr int))] ...)
;;;
;;; In a function whose declared return type fixes K/V, a bare (map-new) tail
;;; is enough (the return annotation pins K/V) -- see map-empty-for.
;;;
;;; Returns:
;;;   An empty Map[K V].
;;;
;;; Example:
;;;   (:: (map-new) (Map int int))  ; => empty Map[int int]
;;;
;;; Since: Phase TM0

(defn map-new [K V] []
  #fx{}
  : (Map K V)
  ```c
  struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = tur_hamt_new();
  return (__TUR_RET__)(intptr_t)m;
  ```)
;;; map-empty-for -- internal: an empty Map[K V] whose K/V are pinned by a
;;; sample key/value pair.  Used by the hamt-of / #map{...} literal lowering,
;;; where the key/value types are known from the first literal pair but cannot
;;; be written as an annotation by the expanding macro.  The k/v arguments are
;;; consumed only for type inference; the returned map is empty.
;;;
;;; Since: Phase TMS3

(defn map-empty-for [^Hash K ^MapKey K V] [k :K v :V] : (Map K V) (map-new))
;;; map-hamt -- internal accessor for the HAMT backing store.

(defn map-hamt [K V] [m (Map K V)]
  #fx{}
  :ptr<void>
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  return map->hamt;
  ```)
;;; map-wrap -- internal constructor from a HAMT pointer.

(defn map-wrap [K V] [h :ptr<void>]
  #fx{}
  : (Map K V)
  ```c
  struct { void *hamt; } *m = malloc(sizeof(*m));
  m->hamt = (void*)(intptr_t)h;
  return (__TUR_RET__)(intptr_t)m;
  ```)
;;; ============================================================================
;;; Raw runtime bridges (#fx{Unsafe}-style, internal).
;;;
;;; These carry the key already boxed into the int64 carrier (a :int, not :K)
;;; and an explicit comparator/ownership flag.  They are the thin C layer the
;;; public Hash/MapKey-dispatched accessors below delegate to.  The handle is
;;; typed (Map K V) so the public accessors thread K/V through them, but the
;;; carrier key is always :int.
;;; ============================================================================
;;; map-assoc-eq-o -- raw insert/update: explicit hash, boxed carrier key,
;;; comparator and ownership flag.


(defn map-assoc-eq-o [K V] [m (Map K V) h :int key :int val :V keyeq owned :int] : (Map K
                                                                                     V)
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt;
  if (owned & 4) {
    /* rc<T> value.  The incoming reference is already ours -- the carrier
       bridge minted it at the call site (own_carry_for_arg in elab_call.c),
       exactly as it does for vec-push! -- so this stores it without retaining
       again.  The ops must be the EMITTED shims so they bind to THIS program's
       copy of the collector (see the preamble note on __tur_rc_val_retain). */
    new_hamt = tur_hamt_set_eq_vo(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                  (void *)(intptr_t)val, (void *)(intptr_t)keyeq,
                                  (int64_t)owned,
                                  __tur_rc_val_retain, __tur_rc_val_release);
  } else {
    new_hamt = tur_hamt_set_eq_o(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                 (void *)(intptr_t)val, (void *)(intptr_t)keyeq,
                                 (int64_t)owned);
  }
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; map-get-eq-o -- raw lookup: explicit hash, boxed carrier key, comparator.

(defn map-get-eq-o [K V] [m (Map K V) h :int key :int keyeq owned :int] :V
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  return (int64_t)(intptr_t)tur_hamt_get_eq_o(map->hamt, (uint64_t)h,
                                              (void *)(intptr_t)key,
                                              (void *)(intptr_t)keyeq, (int64_t)owned);
  ```)
;;; map-has-eq-o? -- raw existence test: explicit hash, boxed carrier key.

(defn map-has-eq-o? [K V] [m (Map K V) h :int key :int keyeq owned :int] :bool
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  return tur_hamt_has_eq_o(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                           (void *)(intptr_t)keyeq, (int64_t)owned);
  ```)
;;; map-dissoc-eq-o -- raw removal: explicit hash, boxed carrier key, comparator.

(defn map-dissoc-eq-o [K V] [m (Map K V) h :int key :int keyeq owned :int] : (Map K
                                                                               V)
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt = tur_hamt_del_eq_o(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                     (void *)(intptr_t)keyeq, (int64_t)owned);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; ----------------------------------------------------------------------------
;;; Explicit hash + key-equality content API (TCE4).
;;;
;;; Like the -eq-o family but with the key passed RAW (as :K, not a boxed
;;; carrier) and no ownership flag (owned == 0).  These give direct control of
;;; the hash word, which is what a forced-collision test needs (two distinct
;;; keys sharing hash 0 stay distinct under the comparator).  The public
;;; map-assoc/map-get accessors are preferred for ordinary use.
;;; ----------------------------------------------------------------------------
;;; map-assoc-eq -- insert/update with an explicit hash and key-equality fn.
;;;
;;; Parameters:
;;;   m     -- source Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   val   -- value of type V
;;;   keyeq -- a captureless (c-fn [K K] bool) used to compare keys that share a
;;;            hash. Must carry no environment (it is called as a bare C function
;;;            pointer); pass a top-level defn or a captureless lambda, or a
;;;            MapKey carrier comparator like tur-int-carrier-eq? /
;;;            tur-cstr-key-eq?. A capturing closure is rejected at compile time.
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated. Keys that are equal
;;;   under keyeq (not just identical pointers) collapse to one entry.
;;;
;;; Example:
;;;   (map-assoc-eq m (cstr-hash k) k v tur-cstr-key-eq?)
;;;
;;; Since: TCE4


(defn map-assoc-eq [K V] [m (Map K V)
                          h :int
                          key :K
                          val :V
                          keyeq : (c-fn [K K] bool)] : (Map K V)
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt = tur_hamt_set_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                   (void *)(intptr_t)val,
                                   (void *)(intptr_t)keyeq);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; map-get-eq -- look up a key using an explicit hash and key-equality fn.
;;;
;;; Parameters:
;;;   m     -- Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   The value of type V, or 0 (none) if absent.
;;;
;;; Example:
;;;   (map-get-eq m (cstr-hash k) k tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-get-eq [K V] [m (Map K V) h :int key :K keyeq : (c-fn [K K] bool)] :V
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  return (int64_t)(intptr_t)tur_hamt_get_eq(map->hamt, (uint64_t)h,
                                            (void *)(intptr_t)key,
                                            (void *)(intptr_t)keyeq);
  ```)
;;; map-has-eq? -- key-existence test using an explicit hash and equality fn.
;;;
;;; Parameters:
;;;   m     -- Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   true if the key is present under keyeq, false otherwise.
;;;
;;; Example:
;;;   (map-has-eq? m (cstr-hash k) k tur-cstr-key-eq?)  ; => true or false
;;;
;;; Since: TCE4

(defn map-has-eq? [K V] [m (Map K V) h :int key :K keyeq : (c-fn [K K] bool)] :bool
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  return tur_hamt_has_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                         (void *)(intptr_t)keyeq);
  ```)
;;; map-dissoc-eq -- remove a key using an explicit hash and equality fn.
;;;
;;; Parameters:
;;;   m     -- source Map[K V]
;;;   h     -- precomputed content hash of key
;;;   key   -- key of type K
;;;   keyeq -- key comparison fn (see map-assoc-eq)
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (map-dissoc-eq m (cstr-hash k) k tur-cstr-key-eq?)
;;;
;;; Since: TCE4

(defn map-dissoc-eq [K V] [m (Map K V) h :int key :K keyeq : (c-fn [K K] bool)] : (Map K
                                                                                    V)
  ```c
  struct { void *hamt; } *map = (void *)(intptr_t)m;
  void *new_hamt = tur_hamt_del_eq(map->hamt, (uint64_t)h, (void *)(intptr_t)key,
                                   (void *)(intptr_t)keyeq);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; cstr-hash -- xxHash64 of a NUL-terminated string's contents.
;;;
;;; Parameters:
;;;   s -- the string to hash
;;;
;;; Returns:
;;;   The 64-bit content hash, so equal text hashes equally regardless of
;;;   pointer identity.
;;;
;;; Example:
;;;   (cstr-hash "key")  ; => <stable content hash>
;;;
;;; Since: TCE4

(defn cstr-hash [s : cstr] : int
  ```c return (int64_t)tur_hamt_hash_str((const char *)(intptr_t)s); ```)
;;; tur-cstr-key-eq? -- internal: content equality of two string keys.

(defn tur-cstr-key-eq? [a : cstr b : cstr] : bool
  ```c
  const char *p = (const char *)(intptr_t)a;
  const char *q = (const char *)(intptr_t)b;
  while (*p && (*p == *q)) { p++; q++; }
  return *(const unsigned char *)p == *(const unsigned char *)q;
  ```)
;;; ============================================================================
;;; Wide map-key carrier (WKC -- float32-map-key-carrier-plan)
;;;
;;; The runtime *-eq HAMT carries a key as a single int64_t word and calls the
;;; comparator through bool(*)(int64_t,int64_t).  For a one-word key (:int,
;;; :bool, :cstr) the value rides that word losslessly.  A :float32 / :float
;;; key does NOT: binding it to the int64_t carrier numerically converts it
;;; (1.5 -> 1), and a bool(float,float) comparator invoked through the int64_t
;;; ABI reads the wrong registers.  Both bugs predate generic dispatch -- they
;;; are properties of the one-word carrier itself.
;;;
;;; MapKey fixes the carrier per key type, at the only place that knows K
;;; concretely -- a typeclass dispatched on a K-typed argument:
;;;
;;;   mk-box : K -> int64 carrier.  One-word keys: identity.  Float keys:
;;;            a *bit* reinterpret (memcpy of raw bytes via a union), never a
;;;            numeric conversion, so 1.5 survives intact.
;;;   mk-cmp : K -> a carrier-ABI comparator bool(int64,int64) (returned as a
;;;            raw function pointer).  Float comparators reinterpret each
;;;            carrier word back to the float and compare by value, so the
;;;            runtime's int64_t ABI is honored.
;;;
;;; (hash key) still runs on the unboxed K via Hash[K], so the hash word is
;;; unaffected.  The boxed form (mk-box) and the unbox in the comparator
;;; (mk-cmp) are chosen by the same K, so they always agree.  Dispatch is
;;; resolved at compile time and the float reinterprets are inlinable, so a
;;; one-word map keeps today's representation and cost.
;;;
;;; Scope: this covers inline scalar keys (one-word + float32 + float64).
;;; Multi-word struct/ADT keys would need a heap-boxed carrier owned by the
;;; map (a runtime-ownership change); that remains a separate follow-up.
;;; ============================================================================
;;; tur-int-carrier-eq? -- carrier comparator for one-word integral keys.
;;;
;;; Used for :int and :bool keys, whose carrier word IS the value, so plain
;;; integer equality on the two carrier words is the key equality.


(defn tur-int-carrier-eq? [a : int b : int] : bool (= a b))
;;; tur-f32-carrier-eq? -- carrier comparator for :float32 keys.
;;;
;;; Reinterprets each int64 carrier word's low 32 bits back to a float and
;;; compares by value (NaN never matches, as with =).

(defn tur-f32-carrier-eq? [a : int b : int] : bool
  ```c
  union { float f; int64_t i; } ua, ub;
  ua.i = a; ub.i = b;
  return ua.f == ub.f;
  ```)
;;; tur-f64-carrier-eq? -- carrier comparator for :float (float64) keys.
;;;
;;; Reinterprets each int64 carrier word back to a double and compares by value.

(defn tur-f64-carrier-eq? [a : int b : int] : bool
  ```c
  union { double f; int64_t i; } ua, ub;
  ua.i = a; ub.i = b;
  return ua.f == ub.f;
  ```)
;;; MapKey -- per-key-type carrier boxing + a carrier-ABI comparator.
;;;
;;; Parameters:
;;;   a -- the key type
;;;
;;; Since: WKC (float32-map-key-carrier-plan)

(defclass MapKey [a]
  (mk-box [x] : int)
  (mk-cmp [x] : int)
  (mk-owned? [x] : int))
;;; MapKey [int] -- one-word identity carrier; integer-equality comparator.

(definstance MapKey [int]
  (mk-box [x] x)
  (mk-cmp [x]
    : int
    ```c return (int64_t)(intptr_t)__TUR_CNAME_tur-int-carrier-eq?__; ```)
  (mk-owned? [x] 0))
;;; MapKey [bool] -- one-word 0/1 carrier; integer-equality comparator.

(definstance MapKey [bool]
  (mk-box [x] (if x 1 0))
  (mk-cmp [x]
    : int
    ```c return (int64_t)(intptr_t)__TUR_CNAME_tur-int-carrier-eq?__; ```)
  (mk-owned? [x] 0))
;;; MapKey [cstr] -- pointer carrier; content-equality comparator.

(definstance MapKey [cstr]
  (mk-box [x] : int ```c return (int64_t)(intptr_t)x; ```)
  (mk-cmp [x]
    : int
    ```c return (int64_t)(intptr_t)__TUR_CNAME_tur-cstr-key-eq?__; ```)
  (mk-owned? [x] 0))
;;; MapKey [float32] -- bit-reinterpret carrier; float-value comparator.

(definstance MapKey [float32]
  (mk-box [x]
    : int
    ```c union { float f; int64_t i; } u; u.i = 0; u.f = x; return u.i; ```)
  (mk-cmp [x]
    : int
    ```c return (int64_t)(intptr_t)__TUR_CNAME_tur-f32-carrier-eq?__; ```)
  (mk-owned? [x] 0))
;;; MapKey [float] -- bit-reinterpret carrier (float64); double-value comparator.

(definstance MapKey [float]
  (mk-box [x]
    : int
    ```c union { double f; int64_t i; } u; u.f = x; return u.i; ```)
  (mk-cmp [x]
    : int
    ```c return (int64_t)(intptr_t)__TUR_CNAME_tur-f64-carrier-eq?__; ```)
  (mk-owned? [x] 0))
;;; MapKey [any] -- key a map or set by a dynamically-typed value.
;;;
;;; set-of-element-type-is-not-checked / saffron-lang-plan S6: the twin of
;;; `Hash[any]`.  Each `is?` arm narrows `x` to its payload type and delegates
;;; to THAT type's MapKey, so an `any` holding "two" is boxed and compared
;;; exactly as a bare "two" (content-keyed), and an `any` holding 7.1 as a
;;; bare 7.1 (bit-reinterpret, value comparator).  The runtime HAMT keeps a
;;; comparator PER ENTRY, which is what makes mixing them in one set sound:
;;; this is precisely how a heterogeneous `set-of` already behaved before it
;;; had an honest type.  An unrecognised payload keys by its type name, like
;;; its hash.  The Sym arm keeps keyword keys apart (pointer identity, as
;;; MapKey[Sym]); without it every keyword collapsed onto the name "Sym"
;;; (saffron-dynamic-surface-pass H4).  The arms use the `.mk-box` method spelling on purpose: a bare
;;; `mk-box` resolves in the VALUE namespace, where a user `(defn mk-box ...)`
;;; -- a common name for a `Box` constructor helper -- legitimately shadows the
;;; method (TUR-W0039), and this body is elaborated in the user's program.
;;;
;;; Since: saffron-lang-plan S6 (MapKey[any])

;;; saffron-dynamic-surface-pass H4: the Sym instance (MapKey) lives HERE, beside its
;;; class, rather than in sym.tur (which the autoloader reads later), so that
;;; the `any` instance below can name it in its Sym arm.  Non-orphan either
;;; way: the class is defined in this module.
;;; MapKey [Sym] -- interned-symbol pointer carrier.  Symbols are deduplicated,
;;; so pointer identity is content equality; the carrier is the pointer-as-int
;;; and the comparator is plain integer (identity) equality.


(definstance MapKey [Sym]
  (mk-box [x] : int ```c return (int64_t)(intptr_t)x; ```)
  (mk-cmp [x]
    : int
    ```c return (int64_t)(intptr_t)__TUR_CNAME_tur-int-carrier-eq?__; ```)
  (mk-owned? [x] 0))

(definstance MapKey [any]
  (mk-box [x]
    : int
    (if (is? x int)
      (.mk-box x)
      (if (is? x cstr)
        (.mk-box x)
        (if (is? x float)
          (.mk-box x)
          (if (is? x bool)
            (.mk-box x)
            (if (is? x Sym) (.mk-box x) (.mk-box (type-of x))))))))
  (mk-cmp [x]
    : int
    (if (is? x int)
      (.mk-cmp x)
      (if (is? x cstr)
        (.mk-cmp x)
        (if (is? x float)
          (.mk-cmp x)
          (if (is? x bool)
            (.mk-cmp x)
            (if (is? x Sym) (.mk-cmp x) (.mk-cmp (type-of x))))))))
  (mk-owned? [x]
    : int
    (if (is? x int)
      (.mk-owned? x)
      (if (is? x cstr)
        (.mk-owned? x)
        (if (is? x float)
          (.mk-owned? x)
          (if (is? x bool)
            (.mk-owned? x)
            (if (is? x Sym) (.mk-owned? x) (.mk-owned? (type-of x)))))))))
;;; ============================================================================
;;; The typed Map[K V] accessor surface (TMS3).
;;;
;;; One family of accessors -- map-assoc / map-get / map-has? / map-dissoc --
;;; works for ANY scalar key type via (Hash K) + (MapKey K): (hash key) selects
;;; the per-K hash, (mk-box key) boxes the key into the int64 carrier (a bit
;;; reinterpret for float keys, identity for one-word keys, the pointer for
;;; cstr), and (mk-cmp key) supplies a carrier-ABI comparator threaded into the
;;; runtime *-eq HAMT.  For :int keys mk-box is identity and the comparator is
;;; integer =, matching an identity-keyed map; for :cstr keys distinct pointers
;;; with equal text collapse to one entry; for :float32 / :float keys the key
;;; round-trips by value.  Dispatch is resolved at compile time per
;;; monomorphization.
;;;
;;; The handle is typed Map[K V], so the type checker enforces that the key has
;;; type K and the value type V; a key/value-type mismatch is a TUR-E0001.
;;;
;;; The accessors are MACROS, not functions.  This is deliberate: a value of
;;; ANY type V (a :float that must keep its bits, a heap handle like Vec[A] or
;;; another Map, a user struct) must ride the map on the single int64 carrier
;;; word.  A pure-Turmeric generic *function* would ABI-specialize its value
;;; parameter to V's concrete C type (e.g. double, Vec__int) and then clash
;;; with the int64-carrier runtime bridge.  By expanding at the use site, the
;;; value flows straight into the inline-C bridge (which carries it as int64,
;;; bit-reinterpreting floats and pointers correctly), while a typed
;;; key-check (tur-map-kcheck) still enforces that the key has type K against
;;; the map's Map[K V] -- so a wrong-typed key is a TUR-E0001.  Because they
;;; are macros they cannot be passed as first-class function values.
;;; ============================================================================
;;; tur-map-kcheck -- internal: enforce key type K against a Map[K V]; returns m.
;;;
;;; A typed identity on the map that unifies the key's type with the map's key
;;; type K. The accessor macros wrap their map argument in this so a
;;; wrong-typed key is rejected (TUR-E0001) even though the runtime dispatch
;;; goes through the type-erased int64 carrier.


(defn tur-map-kcheck [K V] [m (Map K V) k (& K)] : (Map K V) m)
;;; map-assoc -- insert or update a key/value pair; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K]).
;;;          Inline float keys (:float32 / :float) are bit-reinterpreted into
;;;          the carrier and compared by value; cstr keys are compared by
;;;          content; one-word keys are unchanged.
;;;   val -- value of type V (any type: scalar, float, or a heap handle)
;;;
;;; Returns:
;;;   A new Map[K V] with the entry inserted or updated. Keys equal under
;;;   Eq[K] (not just identical) collapse to one entry.
;;;
;;; Example:
;;;   (map-assoc (:: (map-new) (Map cstr int)) "name" 1)  ; => Map {"name" -> 1}
;;;   (map-assoc (:: (map-new) (Map int int)) 42 100)     ; => Map {42 -> 100}
;;;
;;; Since: Phase TMS3 (macro accessor; was map-assoc-g; GHE3)
;;; tur-wide-byval? -- 1 if V is a multi-word (> 8 byte) by-value struct/ADT that
;;; the compiler heap-BOXES onto the value carrier, else 0.  The compiled backend
;;; folds it to a constant per monomorphization (emit_expr.c), in lockstep with
;;; the value-boxing decision; this pure-Turmeric fallback body returns 0 for the
;;; interpreter (where a value rides as a TuriValue, never a C box) and for any
;;; call the backend does not intercept.  map-assoc threads it as bit 1 of the
;;; `owned` flag so a Map[K Point]-style boxed value is released on map-free.
;;;
;;; Since: multiword-value-box-lifecycle


(defn tur-wide-byval? [V] [x : V] : int 0)
;;; tur-rc-value? -- 1 if V is an rc<T>, else 0.  The refcount-side twin of
;;; tur-wide-byval?: the compiled backend folds it to a constant per
;;; monomorphization (emit_expr.c), and this pure-Turmeric fallback body returns
;;; 0 for the interpreter (where an rc value is not carrier-erased) and for any
;;; call the backend does not intercept.  map-assoc threads it as bit 2 of the
;;; `owned` flag so a Map[K rc<T>] takes a strong reference on insert and
;;; releases it when the entry dies.  Bits 1 and 2 are mutually exclusive -- a
;;; value is either a by-value box or an rc handle, never both.
;;;
;;; Since: collections-cannot-hold-rc-values (map side, step c)


(defn tur-rc-value? [V] [x : V] : int 0)

(defmacro map-assoc [m k v]
  `(let [__tur_mk__ ~k
         __tur_mv__ ~v
         __tur_mw__ (tur-wide-byval? (& __tur_mv__))
         __tur_mr__ (tur-rc-value? (& __tur_mv__))]
     (map-assoc-eq-o (tur-map-kcheck ~m (& __tur_mk__))
       (hash __tur_mk__)
       (mk-box __tur_mk__)
       __tur_mv__
       (mk-cmp __tur_mk__)
       (+ (mk-owned? __tur_mk__) (+ (* 2 __tur_mw__) (* 4 __tur_mr__))))))
;;; map-get -- look up a key; returns the value or 0 (none) if absent.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K])
;;;
;;; Returns:
;;;   The value of type V, or 0 (none) if absent. For a non-int value type read
;;;   the result with an ascription, e.g. (:: (map-get m k) :float). When V is
;;;   `any` a miss is the nil box (falsy under Saffron truthiness), on both
;;;   back ends.
;;;
;;; Example:
;;;   (map-get m "name")  ; => value or 0
;;;
;;; Since: Phase TMS3 (macro accessor; was map-get-g; GHE3)

(defmacro map-get [m k]
  `(let [__tur_mk__ ~k]
     (map-get-eq-o (tur-map-kcheck ~m (& __tur_mk__))
       (hash __tur_mk__)
       (mk-box __tur_mk__)
       (mk-cmp __tur_mk__)
       (mk-owned? __tur_mk__))))
;;; map-has? -- check whether a key exists in the map.
;;;
;;; Parameters:
;;;   m   -- Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K])
;;;
;;; Returns:
;;;   true if the key is present under Eq[K], false otherwise.
;;;
;;; Example:
;;;   (map-has? m "name")  ; => true or false
;;;
;;; Since: Phase TMS3 (macro accessor; was map-has-g?; GHE3)

(defmacro map-has? [m k]
  `(let [__tur_mk__ ~k]
     (map-has-eq-o? (tur-map-kcheck ~m (& __tur_mk__))
       (hash __tur_mk__)
       (mk-box __tur_mk__)
       (mk-cmp __tur_mk__)
       (mk-owned? __tur_mk__))))
;;; map-dissoc -- remove a key from the map; returns a new map.
;;;
;;; Parameters:
;;;   m   -- source Map[K V]
;;;   key -- key of type K (must satisfy Hash[K] and MapKey[K])
;;;
;;; Returns:
;;;   A new Map[K V] with the key removed.
;;;
;;; Example:
;;;   (map-dissoc m "name")  ; => map without "name"
;;;
;;; Since: Phase TMS3 (macro accessor; was map-dissoc-g; GHE3)

(defmacro map-dissoc [m k]
  `(let [__tur_mk__ ~k]
     (map-dissoc-eq-o (tur-map-kcheck ~m (& __tur_mk__))
       (hash __tur_mk__)
       (mk-box __tur_mk__)
       (mk-cmp __tur_mk__)
       (mk-owned? __tur_mk__))))
;;; map-count -- return the number of entries in the map.
;;;
;;; Parameters:
;;;   m -- Map[K V]
;;;
;;; Returns:
;;;   Integer count of key/value pairs.
;;;
;;; Example:
;;;   (map-count my-map)  ; => 3
;;;
;;; Since: Phase TM0

(defn map-count [K V] [m (Map K V)]
  #fx{}
  :int
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  return tur_hamt_count(map->hamt);
  ```)
;;; map-merge -- merge two maps; values from b win on key collision.
;;;
;;; Parameters:
;;;   a -- first Map[K V]
;;;   b -- second Map[K V] (wins on collision)
;;;
;;; Returns:
;;;   A new Map[K V] containing all entries from both maps.
;;;
;;; Example:
;;;   (map-merge map-a map-b)  ; => merged map
;;;
;;; Since: Phase TM0

(defn map-merge [K V] [a (Map K V) b (Map K V)]
  #fx{}
  : (Map K V)
  ```c
  struct { void *hamt; } *ma = (void*)(intptr_t)a;
  struct { void *hamt; } *mb = (void*)(intptr_t)b;
  void *new_hamt = tur_hamt_merge(ma->hamt, mb->hamt);
  struct { void *hamt; } *r = malloc(sizeof(*r));
  r->hamt = new_hamt;
  return (__TUR_RET__)(intptr_t)r;
  ```)
;;; map-free -- free the Map wrapper (does not free HAMT; use map-free-all for that).
;;;
;;; Parameters:
;;;   m -- Map[K V] to free
;;;
;;; Example:
;;;   (map-free my-map)
;;;
;;; Since: Phase TM0

(defn map-free [K V] [m (Map K V)]
  #fx{}
  :void
  ```c
  struct { void *hamt; } *map = (void*)(intptr_t)m;
  /* Deep-free: release the backing HAMT before the wrapper.  tur_hamt_free is
   * refcount-safe under structural sharing (it decrements each node's ref_count
   * and frees only at zero, so nodes shared with a still-live sibling map
   * survive) and releases every OWNED key box via the map's stamped key_ops --
   * so a Map[Point int] with mk-owned? = 1 struct keys frees each boxed key
   * exactly once.  This matches the interpreter's native map-free (set_free_box),
   * which already deep-frees; the compiled body was shallow and leaked the HAMT
   * + owned key boxes.  (A one-word / borrowed-key map stamps no release op, so
   * this stays a plain structural free there.) */
  if (map->hamt) tur_hamt_free(map->hamt);
  free(map);
  ```)
;;; map-eq? -- compare two maps for structural equality using a value comparator.
;;;
;;; Parameters:
;;;   m1      -- first Map[K V]
;;;   m2      -- second Map[K V]
;;;   val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair
;;;
;;; Returns:
;;;   true if both maps have identical keys and all corresponding values satisfy val-cmp.
;;;
;;; Example:
;;;   (map-eq? ma mb (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TM0
;; NOTE (Phase 4.1/4.3): carrier-essential -- walks a heterogeneous HAMT via
;; tur_hamt_* with no element type available, so it stays inline-C on the int64
;; carrier and is an allowed Phase 5 bridge crossing.  See
;; docs/archive/phase4-carrier-helper-inventory.md.

(defn map-eq-raw? [V] [m1 : int m2 : int ^borrow ^fat val-cmp : (fn [V V] bool)]
  #fx{}
  : bool
  ```c
  struct { void *hamt; } *map1 = (void*)(intptr_t)m1;
  struct { void *hamt; } *map2 = (void*)(intptr_t)m2;
  if (tur_hamt_count(map1->hamt) != tur_hamt_count(map2->hamt)) return false;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, map1->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      void *val_in_b = tur_hamt_get(map2->hamt, (int64_t)hash_out, key_out);
      if (!val_in_b) { tur_hamt_iter_free((void*)iter_buf); return false; }
      /* CRU B-3: val-cmp is a fat closure box; fat-dispatch via slot 0. */
      bool vals_eq = ((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)val_cmp)[0])(
          (void*)(intptr_t)val_cmp, (int64_t)(intptr_t)val_out, (int64_t)(intptr_t)val_in_b);
      if (!vals_eq) { tur_hamt_iter_free((void*)iter_buf); return false; }
  }
  tur_hamt_iter_free((void*)iter_buf);
  return true;
  ```)
;;; map-eq? -- typed structural equality over Map[K V] (delegates to map-eq-raw?).
;;;
;;; Parameters:
;;;   m1      -- first Map[K V]
;;;   m2      -- second Map[K V]
;;;   val-cmp -- comparator fn [a :int b :int] :bool applied to each value pair
;;;
;;; Returns:
;;;   true if both maps have identical keys and all corresponding values satisfy val-cmp.
;;;
;;; Since: Phase TM0 (typed surface: TMS3)

(defn map-eq? [K V W] [m1 (Map K V) m2 (Map K V) ^fat val-cmp : (fn [W W] bool)] :bool
  (map-eq-raw? m1 m2 val-cmp))
;;; map-eq-raw-k? -- like map-eq-raw? but compares keys with an explicit
;;; carrier comparator (tur_hamt_get_eq) instead of identity.  Threading the
;;; MapKey[K] comparator here is what makes structural equality content-correct
;;; for :cstr keys (distinct pointers with equal text match).

(defn map-eq-raw-k? [V] [m1 : int
                         m2 : int
                         keyeq
                         ^borrow ^fat val-cmp : (fn [V V] bool)]
  #fx{}
  : bool
  ```c
  struct { void *hamt; } *map1 = (void*)(intptr_t)m1;
  struct { void *hamt; } *map2 = (void*)(intptr_t)m2;
  if (tur_hamt_count(map1->hamt) != tur_hamt_count(map2->hamt)) return false;
  uint64_t iter_buf[32];
  for (int __i = 0; __i < 32; __i++) iter_buf[__i] = 0;
  tur_hamt_iter_init((void*)iter_buf, map1->hamt);
  uint64_t hash_out;
  void *key_out = NULL, *val_out = NULL;
  while (tur_hamt_iter_next((void*)iter_buf, &hash_out, &key_out, &val_out)) {
      void *val_in_b = tur_hamt_get_eq(map2->hamt, (int64_t)hash_out, key_out,
                                       (void *)(intptr_t)keyeq);
      if (!val_in_b) { tur_hamt_iter_free((void*)iter_buf); return false; }
      /* CRU B-3: val-cmp is a fat closure box; fat-dispatch via slot 0.
         keyeq stays a thin MapKey carrier (not a user closure). */
      bool vals_eq = ((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)val_cmp)[0])(
          (void*)(intptr_t)val_cmp, (int64_t)(intptr_t)val_out, (int64_t)(intptr_t)val_in_b);
      if (!vals_eq) { tur_hamt_iter_free((void*)iter_buf); return false; }
  }
  tur_hamt_iter_free((void*)iter_buf);
  return true;
  ```)
;;; map-eq-k? -- structural equality over Map[K V] with an explicit key
;;; comparator (and value comparator).  This is the target of the compiler's
;;; content-keyed .eq? dispatch synthesis: at a concrete call site it threads
;;; the MapKey[K] comparator resolved for the concrete key type -- for :cstr
;;; keys via (mk-cmp (:: 0 K)), for all-:int-field struct keys via
;;; (mk-cmp (make-struct K 0 ...)) -- so keys equal by content but stored under
;;; distinct pointers/boxes compare equal.

(defn map-eq-k? [K V W] [m1 (Map K V)
                         m2 (Map K V)
                         keyeq
                         ^fat val-cmp : (fn [W W] bool)] :bool
  (map-eq-raw-k? m1 m2 keyeq val-cmp))
;;; Eq [Map] -- structural equality using the value type's Eq instance.
;; TM0-6: Phase PTC4 -- constrained Eq instance for Map[K V].
;; Constraints: (Eq K) ensures keys are comparable; (Eq V) uses integer equality.
;; Note: element comparison uses integer equality; correct for all primitive K/V.
;; The instance receives bare-Map (HKT) handles, which carry as int64, so it
;; delegates to the raw :int helper rather than the typed map-eq?.
;;; map-eq-dynamic -- internal: structural equality using each map's stamped
;;; key comparator (GDE3).  val-cmp compares values as int64 carriers.
;;;
;;; The key comparator is read from the first map's runtime stamp (set by
;;; map-assoc / map-dissoc via tur_hamt_set_eq).  For maps built without an
;;; explicit comparator (identity keys) the stamp is NULL and pointer identity
;;; is used -- which is correct for :int keys.


(defn map-eq-dynamic [V] [m1 : int
                          m2 : int
                          ^borrow ^fat val-cmp : (fn [V V] bool)] : bool
  ;; CRU B-3: val-cmp is a fat closure box; threaded as int64 to the runtime,
  ;; which fat-dispatches it (tur_hamt_eq_dynamic reads slot 0).
  ```c return tur_hamt_eq_dynamic(m1, m2, (int64_t)(intptr_t)val_cmp); ```)
;;; map-iter-cur-val-as -- typed read of an iter box's current value.
;;;
;;; The HAMT iter API hands out `ptr<void>` for values; this typed accessor
;;; bridges that pointer back to V at the carrier level (a single inline-C
;;; ascription, no work).  Mirrors `mutmap-slot-value`'s shape so the
;;; pure-Turmeric `map-eq-loop` body can compare V-typed values directly.


(defn map-iter-cur-val-as [V] [iter : ptr<void>]
  #fx{}
  : V
  ```c return (int64_t)(intptr_t)tur_hamt_iter_cur_val((void*)(intptr_t)iter); ```)
;;; map-get-dynamic-as -- typed lookup against m2's hamt, threading m1's
;;; stamped key comparator so content-keyed maps (e.g. cstr keys) stay
;;; content-correct.  Returns V (cast at the carrier level).  The
;;; pure-Turmeric loop calls this *after* hamt/has-dynamic? has confirmed
;;; the key is present, so the result is always a live value.


(defn map-get-dynamic-as [V] [m : ptr<void>
                              hash : int
                              key : ptr<void>
                              keyeq : ptr<void>]
  #fx{}
  : V
  ```c return (int64_t)(intptr_t)tur_hamt_get_dynamic((void*)(intptr_t)m, hash, (void*)(intptr_t)key, (void*)(intptr_t)keyeq); ```)
;;; map-eq-loop -- pure-Turmeric structural-equality walk over m1's HAMT.
;;;
;;; Path A specializes this per (K V) at the `Eq [Map]` dispatch site; the
;;; self-tail-recursive spec lowers to a goto loop (TCO-in-ABI-specs, same
;;; gate as `vec-eq-loop` / `mutmap-eq-loop`), so deep iteration over large
;;; maps runs in constant stack.  For each live (h, k, v) of m1 the matching
;;; key is looked up in m2's hamt (via `hamt/has-dynamic?` /
;;; `map-get-dynamic-as V`, threading m1's stamped key comparator so cstr
;;; and other content-keyed maps stay content-correct) and the values are
;;; compared by val-cmp.
;;;
;;; Parameters:
;;;   iter    -- hamt/iter-alloc-allocated handle scanning m1
;;;   m2-hamt -- raw HAMT pointer of the second map (from map-hamt)
;;;   keyeq   -- stamped key comparator (from hamt/keyeq on m1's hamt)
;;;   val-cmp -- value comparator fn [a :V b :V] :bool
;;;
;;; Returns:
;;;   true iff every entry of m1 is present in m2 under keyeq with an
;;;   equal value under val-cmp.
;;;
;;; Since: Phase TCO-Eq-MapSet


(defn map-eq-loop [K V] [iter : ptr<void>
                         m2-hamt : ptr<void>
                         keyeq : ptr<void>
                         ^fat val-cmp : (fn [V V] bool)] : bool
  (if (hamt/iter-advance! iter)
    (let [h (hamt/iter-cur-hash iter)
          k (hamt/iter-cur-key iter)]
      (if (hamt/has-dynamic? m2-hamt h k keyeq)
        (if (val-cmp (map-iter-cur-val-as iter)
              (map-get-dynamic-as m2-hamt h k keyeq))
          (map-eq-loop iter m2-hamt keyeq val-cmp)
          false)
        false))
    true))
;;; map-eq-driver -- allocate the iter box, run map-eq-loop, free.
;;;
;;; Split out from the `Eq [Map]` instance so the instance body is a single
;;; expression and the (alloc, loop, destroy) sequence is reused.
;;;
;;; Since: Phase TCO-Eq-MapSet


(defn map-eq-driver [K V] [m1 (Map K V)
                           m2 (Map K V)
                           ^fat val-cmp : (fn [V V] bool)] : bool
  (let [iter   (hamt/iter-alloc (map-hamt m1))
        keyeq  (hamt/keyeq (map-hamt m1))
        result (map-eq-loop iter (map-hamt m2) keyeq val-cmp)]
    (do (hamt/iter-destroy! iter) result)))
;; TCO-Eq-MapSet (pure-turmeric Eq [Map] / Eq [Set] follow-up): the instance
;; body now dispatches through the pure-Turmeric `map-eq-loop` (TCO'd inside
;; its by-value spec), mirroring `Eq [Vec]` / `Eq [MutableMap]`.  The Map
;; receiver still carries as int64 at the HKT head, so each receiver use is
;; ascribed inline to `(Map K V)` to recover K/V at the dispatch site.  The
;; inline-C `map-eq-raw?` / `map-eq?` / `map-eq-dynamic` triple stays for
;; direct / abstract-K-V callers (the same compromise vec-eq? made).

(definstance Eq [Map]
  [(Eq K) (Eq V)]
  (eq? [x y]
    (and (= (map-count (:: x (Map K V))) (map-count (:: y (Map K V))))
      (map-eq-driver (:: x (Map K V)) (:: y (Map K V)) (fn [a b] (eq? a b))))))
;;; map-assoc-consuming__ -- internal: assoc, then free the map assoc'd INTO.
;;;
;;; map-literal-leaks-its-intermediate-maps.  A HAMT is persistent, so every
;;; map-assoc mallocs a fresh `{void* hamt}` carrier box and returns it.  In an
;;; N-entry literal that is N+1 boxes of which the author holds only the LAST,
;;; so `#map{:a 1 :b 2 :c 3}` leaked 3 boxes and the generations they retain --
;;; 1080 bytes in 11 allocations -- with map-free called.
;;;
;;; This is safe ONLY where the input map is owned by the expression that
;;; produced it, which is why it lives here and not in map-assoc: the caller of
;;; map-assoc generally holds its argument and must keep it.  hamt-of seeds the
;;; chain with a fresh (map-empty-for ...) and every later input is a previous
;;; step's result, so every generation in the chain is the chain's own.
;;;
;;; Freeing the previous generation does not disturb the new one: tur_hamt_free
;;; is refcount-safe under structural sharing (it decrements each node and frees
;;; only at zero), which is the same guarantee map-free's own body documents.

(defmacro map-assoc-consuming__ [m k v]
  `(let [__tur_mprev__ ~m]
     (let [__tur_mnext__ (map-assoc __tur_mprev__ ~k ~v)]
       (do (map-free __tur_mprev__) __tur_mnext__))))
;;; hamt-assoc-each__ -- internal helper for the hamt-of macro.
;;;
;;; Threads (map-assoc m k v) over the kv-pairs in xs, returning the final
;;; map.  Recursive: each step wraps the accumulator in one more map-assoc,
;;; so the last pair wins on duplicate keys.  Each step also FREES the map it
;;; assoc'd into -- see map-assoc-consuming__ for why that is sound here and
;;; not in map-assoc itself.
;;;
;;; Every parameter of this family (hamt-of, hamt-homog-chain__, this one) is
;;; ^syntax: bound as the raw argument form.  A plain parameter is substituted
;;; into the body before the compile-time evaluation, so `m` (or a spliced
;;; `kvs`) holding an unannotated lambda value was EVALUATED at compile time
;;; and `#map{"add" (fn [a b] (+ a b))}` failed "compile-time macro
;;; evaluation expected a form value".

(defmacro hamt-assoc-each__ [^syntax m & ^syntax kvs]
  (if (empty? kvs)
    m
    (list hamt-assoc-each__
      (list map-assoc-consuming__ m (first kvs) (second kvs))
      ~@(rest (rest kvs)))))
;;; tur-map-homog__ -- internal: compile-time homogeneity check (see vec.tur).
;;;
;;; Both parameters share one type variable, so a call with two
;;; differently-typed arguments is a TUR-E0001 at elaboration. No-op body,
;;; fixed arity (no allocation).

(defn tur-map-homog__ [A] [a :A b :A] :nil ```c (void)a; (void)b; ```)
;;; hamt-homog-chain__ -- internal: enforce homogeneous keys and values.
;;;
;;; kvs is k0 v0 k1 v1 ...  Chains tur-map-homog__ over adjacent keys and
;;; adjacent values so all keys unify to one type and all values to another.

(defmacro hamt-homog-chain__ [& ^syntax kvs]
  (if (empty? kvs)
    0
    (if (empty? (rest (rest kvs)))
      0
      (list do
        (list tur-map-homog__ (first kvs) (first (rest (rest kvs))))
        (list do
          (list tur-map-homog__ (second kvs) (second (rest (rest kvs))))
          (list hamt-homog-chain__ ~@(rest (rest kvs))))))))
;;; hamt-of -- variadic Map literal: alternating key/value arguments.
;;;
;;; Parameters:
;;;   & kvs -- an even number of arguments, alternating key then value.
;;;            Keys may be any Hash/MapKey scalar type K (:int, :cstr, :bool,
;;;            :float32, :float); all keys must unify to a single K and all
;;;            values to a single V, else TUR-E0001 on the offending element.
;;;            String keys are compared by content; int/bool by value; float
;;;            keys round-trip by value.
;;;
;;; Returns:
;;;   A fresh Map[K V] populated with the given entries; later duplicate keys
;;;   win.  map-get returns the value type V, so a non-int value is read with
;;;   an ascription, e.g. (:: (map-get m k) :cstr).
;;;
;;; Note: this is the lowering target of the #map{...} data literal
;;;   (-Xdata-literals).  Writing #map{:a 1 :b 2} is preferred over calling
;;;   hamt-of directly.  A non-empty literal is seeded from a value-pinned
;;;   empty (map-empty-for) so the key/value types flow from the first pair;
;;;   an empty (hamt-of) yields a bare (map-new) that must be annotated by the
;;;   surrounding context.
;;;
;;; Example:
;;;   (hamt-of)              ; => empty Map (annotate at the binding site)
;;;   (hamt-of 1 10 2 20)    ; => Map {1 -> 10, 2 -> 20}
;;;   (hamt-of "a" 1 "b" 2)  ; => Map {"a" -> 1, "b" -> 2}, content-keyed
;;;
;;; Since: DL1 (data-literals-plan); typed surface: TMS3

(defmacro hamt-of [& ^syntax kvs]
  (if (empty? kvs)
    (list map-new)
    (list do
      (list hamt-homog-chain__ ~@kvs)
      (list hamt-assoc-each__
        (list map-empty-for (first kvs) (second kvs))
        ~@kvs))))
