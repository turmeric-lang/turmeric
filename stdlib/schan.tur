;;; tur/schan -- session-typed channel wrappers over a linear opaque handle.
;;;
;;; `SChan<p>` is a thin generic wrapper over a synchronous blocking channel
;;; that carries a protocol phantom `p`.  Each operation advances the phantom:
;;;
;;;   schan-send  : SChan<SSend T R> -> T  -> SChan<R>
;;;   schan-recv  : SChan<SRecv T R>       -> (Pair T SChan<R>)
;;;   schan-close : SChan<SClose>          -> nil
;;;
;;; The phantom is threaded through the result type, so a caller cannot skip a
;;; step or reorder send/recv: doing so is a compile-time type error (TUR-E0001
;;; phantom mismatch).  Combined with the :linear discipline (under -Xlinear),
;;; every protocol step happens exactly once and in order.
;;;
;;; (The plan's ideal `schan-recv : SChan<SRecv T R> -> Pair<T SChan<R>>` is
;;; blocked by a monomorphizer limitation around parametric aggregates whose
;;; element type is a phantom carried inside an opaque -- see schan-recv's
;;; docstring and docs/archive/history/generic-struct-opaque-element-miscompile.md.
;;; recv therefore returns the typed continuation directly and delivers the
;;; received value through a caller-provided cell, which keeps the continuation
;;; protocol fully checked.)
;;;
;;; The wrapper operations carry their channel work directly as inline-C over the
;;; opaque carrier (the phantom is erased at the C ABI), so the typed surface
;;; adds no runtime overhead beyond the underlying channel.  The low-level
;;; `tur/chan` keeps its untyped surface for callers that do not want the
;;; protocol discipline.
;;;
;;; Since: S1
;; stdlib/schan.tur -- session-typed channel wrappers.
(defmodule schan
  (export SChan SSend SRecv SClose schan-new schan-send schan-recv schan-close)
  ;; ---- Protocol phantom tags -----------------------------------------------
  ;; Pure type-level markers; never constructed as values.  The carrier is :int
  ;; only so the opaque has a base type -- the value is irrelevant.
  ;;; SSend -- protocol step: send a value of type T, then continue as R.
  (defopaque SSend [T R] :int)
  ;;; SRecv -- protocol step: receive a value of type T, then continue as R.
  (defopaque SRecv [T R] :int)
  ;;; SClose -- protocol terminus: the channel is closed.
  (defopaque SClose :int)
  ;; ---- The session-typed channel wrapper -----------------------------------
  ;;; SChan -- a linear channel handle carrying a protocol phantom P.
  ;;;
  ;;; Lowers to the underlying :ptr<void> channel in the C ABI; the phantom P is
  ;;; erased at runtime.  :linear so the protocol cannot be replayed: each
  ;;; operation consumes the handle and yields the continuation at the next step.
  ;;;
  ;;; Since: S1
  (defopaque ^linear SChan [P] :ptr<void>)
  ;;; schan-new -- open a session-typed channel running protocol P.
  ;;;
  ;;; Parameters:
  ;;;   cap -- ring-buffer capacity (>= 1)
  ;;;
  ;;; Returns:
  ;;;   A fresh SChan<P>.  The protocol P is fixed by the call site's expected
  ;;;   type (or an ascription).
  ;;;
  ;;; Example:
  ;;;   (:: (schan-new 4) (SChan (SSend int SClose)))  ; => SChan<SSend int SClose>
  ;;;
  ;;; Since: S1
  (defn schan-new [P] [cap : int] : (SChan P)
    ```c
    typedef struct {
        pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
        int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
    } SChanBlock;
    SChanBlock *ch = (SChanBlock *)malloc(sizeof(SChanBlock));
    if (!ch) { fprintf(stderr, "schan-new: out of memory\n"); abort(); }
    /* cap sizes the ring: 0 divided by zero at the first `% cap`, and a
       negative or huge one wrapped `8 * cap` to a tiny block the sends then
       overran (security audit WP5, M-5).  A cap under 1 is 1, as the
       interpreter's twin has always read it. */
    if (cap < 1) cap = 1;
    if ((uint64_t)cap > SIZE_MAX / sizeof(int64_t)) {
      fprintf(stderr, "schan-new: capacity %lld out of range\n", (long long)cap);
      abort();
    }
    ch->buf = (int64_t *)malloc(sizeof(int64_t) * (size_t)cap);
    if (!ch->buf) { free(ch); fprintf(stderr, "schan-new: buf oom\n"); abort(); }
    pthread_mutex_init(&ch->lock, NULL);
    pthread_cond_init(&ch->not_full, NULL);
    pthread_cond_init(&ch->not_empty, NULL);
    ch->head = 0; ch->tail = 0; ch->count = 0; ch->cap = (int64_t)cap;
    return (int64_t)(intptr_t)ch;
    ```)
  ;;; schan-send -- send a T over a channel whose protocol begins with SSend T R.
  ;;;
  ;;; Parameters:
  ;;;   c -- channel at protocol SSend<T R> (consumed)
  ;;;   v -- the value to send
  ;;;
  ;;; Returns:
  ;;;   The same channel, advanced to protocol R.
  ;;;
  ;;; Example:
  ;;;   (let [c2 (schan-send c 42)] ...)  ; c : SChan<SSend int R> => c2 : SChan<R>
  ;;;
  ;;; Since: S1
  (defn schan-send [T R] [c : (SChan (SSend T R)) v : T] : (SChan R)
    ```c
    typedef struct {
        pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
        int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
    } SChanBlock;
    SChanBlock *ch = (SChanBlock *)(intptr_t)c;
    pthread_mutex_lock(&ch->lock);
    while (ch->count == ch->cap)
        pthread_cond_wait(&ch->not_full, &ch->lock);
    ch->buf[ch->tail] = (int64_t)v;
    ch->tail = (ch->tail + 1) % ch->cap;
    ch->count++;
    pthread_cond_signal(&ch->not_empty);
    pthread_mutex_unlock(&ch->lock);
    return (int64_t)(intptr_t)ch;
    ```)
  ;;; schan-recv -- receive a T from a channel whose protocol begins with SRecv T R.
  ;;;
  ;;; Parameters:
  ;;;   c -- channel at protocol SRecv<T R> (consumed)
  ;;;
  ;;; Returns:
  ;;;   A `(Pair T (SChan R))`: the received value and the channel advanced to
  ;;;   protocol R, together. Read them with `pair-fst` / `pair-snd`.
  ;;;
  ;;;   This used to take a caller-allocated cell as an out-parameter and
  ;;;   return only the channel, because a generic function could not return a
  ;;;   parametric aggregate whose element type is a phantom carried inside an
  ;;;   opaque argument -- the type variable was not recoverable, so the result
  ;;;   never specialized and the generic carrier fallback miscompiled. That
  ;;;   defect was fixed 2026-06-05
  ;;;   (docs/archive/history/generic-struct-opaque-element-miscompile.md,
  ;;;   pinned by tests/fixtures/generic-relay-aggregate-result), so the pair
  ;;;   signature the plan always wanted is now what ships. `schan-cell-new` /
  ;;;   `-get` / `-free` existed only to serve the workaround and are gone.
  ;;;
  ;;; Example:
  ;;;   (let [p  (schan-recv c)               ; c : SChan<SRecv int R>
  ;;;         v  (pair-fst p)                 ; : int
  ;;;         c2 (pair-snd p)]                ; : SChan<R>
  ;;;     ...)
  ;;;
  ;;; Since: S1 (pair signature: 2026-08-20)
  ;;; schan-recv-value -- internal: block for the next value, leave the channel.
  ;;;
  ;;; Split out from `schan-recv` so the Pair is built in ordinary Turmeric.
  ;;; Constructing it inside the inline-C body would mean hand-rolling the
  ;;; struct layout; keeping inline-C down to the raw blocking read hands
  ;;; ownership of the aggregate back to the compiler.
  (defn schan-recv-value [T R] [^borrow c : (SChan (SRecv T R))] : T
    ```c
    typedef struct {
        pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
        int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
    } SChanBlock;
    SChanBlock *ch = (SChanBlock *)(intptr_t)c;
    pthread_mutex_lock(&ch->lock);
    while (ch->count == 0)
        pthread_cond_wait(&ch->not_empty, &ch->lock);
    int64_t v = ch->buf[ch->head];
    ch->head = (ch->head + 1) % ch->cap;
    ch->count--;
    pthread_cond_signal(&ch->not_full);
    pthread_mutex_unlock(&ch->lock);
    return v;
    ```)
  ;;; schan-advance-recv -- internal: retag the channel from SRecv T R to R.
  ;;;
  ;;; The same pointer; only the phantom protocol index moves, exactly as
  ;;; `schan-send` does at the end of its own body.
  (defn schan-advance-recv [T R] [c : (SChan (SRecv T R))] : (SChan R)
    ```c
    return (int64_t)(intptr_t)c;
    ```)
  (defn schan-recv [T R] [c : (SChan (SRecv T R))] : (Pair T (SChan R))
    (pair (schan-recv-value c) (schan-advance-recv c)))
  ;;; schan-close -- close a channel whose protocol has reached SClose.
  ;;;
  ;;; Parameters:
  ;;;   c -- channel at protocol SClose (consumed)
  ;;;
  ;;; Returns:
  ;;;   nil.  The underlying channel is freed.
  ;;;
  ;;; Example:
  ;;;   (schan-close c)   ; c : SChan<SClose>
  ;;;
  ;;; Since: S1
  (defn schan-close [c : (SChan SClose)] : nil
    ```c
    typedef struct {
        pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
        int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
    } SChanBlock;
    SChanBlock *ch = (SChanBlock *)(intptr_t)c;
    pthread_mutex_destroy(&ch->lock);
    pthread_cond_destroy(&ch->not_full);
    pthread_cond_destroy(&ch->not_empty);
    free(ch->buf);
    free(ch);
    ```))
