;;; tur/io -- FileSystem capability implementation using libc functions.
;;;
;;; Implements the FileSystem capability typeclass for real I/O.
;;;
;;; Since: Phase 16
;; Phase 16: Real FileSystem implementation
;;
;; Implementation of FileSystem capability using libc functions
(extern-c fopen [^cstr ^cstr] :ptr)

(extern-c fclose [^ptr] :int)

(extern-c fread [^ptr ^int ^int ^ptr] :int)

(extern-c fwrite [^ptr ^int ^int ^ptr] :int)

(extern-c remove [^cstr] :int)
;; opendir/readdir/closedir are NOT extern-c-declared here: the directory
;; helpers below call them from inline-C that #include <dirent.h>, and a
;; hand-rolled `extern int64_t opendir(int64_t)` would conflict with the real
;; libc prototypes once that header is in scope (matches stdlib/fs.tur's style).


(extern-c malloc [^ptr size] :ptr)

(extern-c free [^ptr p] :void)

(extern-c memset [^ptr ^int ^int] :ptr)
;; ---- Opaque handle newtypes (stdlib-opaque-handle-types-plan, I/O sweep) ----
;; DirListing is the NULL-terminated char** array handed out by list-dir and
;; consumed by free-dir-listing; FileSystem is the capability struct from
;; Real-FileSystem, consumed by Real-FileSystem-free. Wrapping each producer's
;; output in a nominally distinct type means the matching free function rejects
;; an unrelated pointer. Both lower to :ptr<void> in the C ABI, so the inline-C
;; bodies are unchanged. (FileHandle, the linear FILE* wrapper below, already
;; handle-types the per-file read/close path.)
;; FileStream is a non-linear handle over a stdio FILE* for the file-size query
;; path: open / size / close without the move-only obligations of FileHandle.
;;
;; FileSystem itself is declared by stdlib/capability.tur, the module whose
;; fs-read / fs-write / fs-delete / fs-list call through it -- a Real-FileSystem
;; is exactly the capability those helpers take
;; (stdlib-capability-vtables-uncompilable).

(load "stdlib/capability.tur")

(load "stdlib/effects.tur")

(defopaque DirListing :ptr<void>)

(defopaque FileStream :ptr<void>)
;;; file-stream-open -- open a file as a non-linear FileStream handle.
;;;
;;; Parameters:
;;;   path -- filesystem path to open (:cstr).
;;;   mode -- fopen mode string, e.g. "rb" or "wb" (:cstr).
;;;
;;; Returns:
;;;   A FileStream wrapping the opened FILE*, or a FileStream wrapping NULL on
;;;   error.  Check with file-stream-ok? before using.
;;;
;;; Example:
;;;   (let [s (file-stream-open "/etc/hostname" "rb")] (file-size s))
;;;
;;; Since: I/O sweep

(defn file-stream-open [path : cstr mode : cstr] : FileStream
  ```c
  return (void *)(intptr_t)fopen(path, mode);
  ```)
;;; file-stream-ok? -- return true if the FileStream wraps a real FILE*.
;;;
;;; Parameters:
;;;   f -- a FileStream.
;;;
;;; Returns:
;;;   true if the underlying FILE* is non-NULL, false on open failure.
;;;
;;; Example:
;;;   (file-stream-ok? (file-stream-open "/etc/hostname" "rb"))  ; => true
;;;
;;; Since: I/O sweep

(defn file-stream-ok? [f : FileStream] : bool
  ```c
  return f != NULL;
  ```)
;;; file-stream-close -- close a FileStream and release the underlying FILE*.
;;;
;;; Parameters:
;;;   f -- a FileStream to close.
;;;
;;; Returns:
;;;   0 on success, non-zero on error (mirrors fclose).
;;;
;;; Example:
;;;   (file-stream-close s)  ; => 0
;;;
;;; Since: I/O sweep

(defn file-stream-close [f : FileStream] : int
  ```c
  if (!f) return -1;
  return fclose((FILE*)f);
  ```)
;;; file-size -- return the byte size of an already-open FileStream.
;;;
;;; Parameters:
;;;   f -- a FileStream (from file-stream-open).
;;;
;;; Returns:
;;;   The file size in bytes as an int.
;;;
;;; Example:
;;;   (file-size my-stream)  ; => 1024
;; Helper function to get file size

(defn file-size [f : FileStream] : int
  ```c
  FILE* file = (FILE*)f;
  long pos = ftell(file);
  fseek(file, 0, SEEK_END);
  long size = ftell(file);
  fseek(file, pos, SEEK_SET);
  return (int)size;
  ```)
;;; Real-FileSystem -- create a FileSystem capability backed by libc.
;;;
;;; Returns:
;;;   A heap-allocated FileSystem struct whose function pointers use
;;;   fopen/fread/fwrite/remove/opendir/readdir for all operations.
;;;   Free with Real-FileSystem-free when done.
;;;
;;; Example:
;;;   (let [fs (Real-FileSystem)] ...)
;;;
;;; Since: Phase 16
;; Real-FileSystem implementation
;; Returns a FileSystem capability struct with libc-based implementations
;; file-scope-c-block: the FileSystem capability is a struct of function
;; pointers, so its libc-backed implementations must be FILE-SCOPE C functions.
;; A vtable returned from Real-FileSystem cannot point at functions nested
;; inside that function's body (a `static` function definition is invalid inside
;; another function, and even a GCC nested function would dangle once the struct
;; outlives the enclosing call). Hoisting them into a top-level c-block keeps the
;; original libc implementations while giving them stable file-scope addresses.

```c
#include <dirent.h>
typedef struct __tur_io_fs {
    int (*read_file)(const char* path, unsigned char* buf, int buf_len, int* out_len);
    int (*write_file)(const char* path, unsigned char* data, int data_len);
    int (*delete)(const char* path);
    int (*list)(const char* path, void* entries, int max_entries, int* out_count);
} __tur_io_fs;

static int __tur_io_fs_read_file(const char* path, unsigned char* buf, int buf_len, int* out_len) {
    FILE* f = fopen(path, "rb");
    if (!f) return -1;
    size_t n = fread(buf, 1, buf_len, f);
    fclose(f);
    *out_len = (int)n;
    return 0;
}

/* Spelled as stdlib/capability.tur's __tur_cap_fs callbacks (see there). */
static int __tur_io_fs_write_file(const char* path, unsigned char* data, int data_len) {
    FILE* f = fopen(path, "wb");
    if (!f) return -1;
    size_t n = fwrite(data, 1, data_len, f);
    fclose(f);
    return (n == (size_t)data_len) ? 0 : -1;
}

static int __tur_io_fs_delete(const char* path) {
    return remove(path);
}

static int __tur_io_fs_list(const char* path, void* entries_v, int max_entries, int* out_count) {
    char** entries = (char**)entries_v;
    DIR* d = opendir(path);
    if (!d) return -1;
    struct dirent* entry;
    int count = 0;
    while ((entry = readdir(d)) && count < max_entries) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) continue;
        if (entries) { entries[count] = strdup(entry->d_name); }
        count++;
    }
    closedir(d);
    *out_count = count;
    return 0;
}
```

(defn Real-FileSystem [] : FileSystem
  ```c
  __tur_io_fs* fs = (__tur_io_fs*)malloc(sizeof(__tur_io_fs));
  fs->read_file  = __tur_io_fs_read_file;
  fs->write_file = __tur_io_fs_write_file;
  fs->delete     = __tur_io_fs_delete;
  fs->list       = __tur_io_fs_list;
  return (void *)(intptr_t)fs;
  ```)
;;; Real-FileSystem-free -- release a FileSystem capability created by Real-FileSystem.
;;;
;;; Parameters:
;;;   fs -- the FileSystem pointer returned by Real-FileSystem.
;;;
;;; Since: Phase 16
;; Free a Real-FileSystem

(defn Real-FileSystem-free [fs : FileSystem] : void
  ```c
  free((void *)(intptr_t)fs);
  ```)
;; ============================================================================
;; Additional I/O helper functions
;; ============================================================================
;;; read-file -- read an entire file into a newly allocated buffer.
;;;
;;; Parameters:
;;;   path -- the filesystem path to open (:cstr).
;;;
;;; Returns:
;;;   A malloc'd buffer containing the file contents with a '\0' terminator,
;;;   or NULL on any error.  The caller is responsible for calling free.
;;;
;;; Example:
;;;   (let [buf (read-file "/etc/hostname")] ...)
;;;
;;; Since: Phase 16
;; Read entire file into a buffer (allocated with malloc)
;; Returns buffer pointer (caller must free) or NULL on error
;; Sets out_len to the number of bytes read


(defn read-file [path : cstr] : ptr<void>
  ```c
  FILE* f = fopen(path, "rb");
  if (!f) return NULL;
  fseek(f, 0, SEEK_END);
  long size = ftell(f);
  /* ftell answers -1 for a pipe, a FIFO or /dev/stdin: `(size_t)-1 + 1`
     was a zero-byte malloc and fread then ran the stream into it
     (security audit WP5, M-5). */
  if (size < 0) { fclose(f); return NULL; }
  fseek(f, 0, SEEK_SET);
  unsigned char* buf = (unsigned char*)malloc((size_t)size + 1);
  if (!buf) { fclose(f); return NULL; }
  size_t n = fread(buf, 1, (size_t)size, f);
  fclose(f);
  if (n != (size_t)size) { free(buf); return NULL; }
  buf[size] = '\0';
  return (void*)buf;
  ```)
;;; write-file -- write a byte buffer to a file, overwriting any existing content.
;;;
;;; Parameters:
;;;   path -- the destination filesystem path (:cstr).
;;;   data -- pointer to the data to write.
;;;   len  -- number of bytes to write.
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (write-file "/tmp/out.bin" buf 256)  ; => 0
;;;
;;; Since: Phase 16
;; Write data to a file
;; Returns 0 on success, non-zero on error

(defn write-file [path : cstr data : ptr<void> len : int] : int
  ```c
  FILE* f = fopen(path, "wb");
  if (!f) return -1;
  size_t n = fwrite(data, 1, len, f);
  fclose(f);
  return (n == (size_t)len) ? 0 : -1;
  ```)
;;; file-exists? -- test whether a file is accessible for reading.
;;;
;;; Parameters:
;;;   path -- the filesystem path to check (:cstr).
;;;
;;; Returns:
;;;   1 if the file can be opened for reading, 0 otherwise.
;;;
;;; Example:
;;;   (file-exists? "/etc/hosts")  ; => 1
;;;
;;; Since: Phase 16
;; Check if file exists

(defn file-exists? [path : cstr] : int
  ```c
  FILE* f = fopen(path, "rb");
  if (f) { fclose(f); return 1; }
  return 0;
  ```)
;;; list-dir -- list all non-hidden entries in a directory.
;;;
;;; Parameters:
;;;   path -- the directory path to list (:cstr).
;;;
;;; Returns:
;;;   A NULL-terminated array of strdup'd entry name strings, or NULL
;;;   on error.  The caller must free each string and then the array itself
;;;   (or use free-dir-listing).
;;;
;;; Example:
;;;   (let [entries (list-dir "/tmp")] ...)
;;;
;;; Since: Phase 16
;; Get current directory listing
;; Returns array of strings (NULL-terminated), caller must free each string and the array

(defn list-dir [path : cstr] : DirListing
  ```c
  #include <dirent.h>
  DIR* d = opendir(path);
  if (!d) return 0;

  /* One pass into a growable array.  This used to count the entries, rewind,
   * and fill an array sized by that count -- with no bound on the fill, so an
   * entry created between the two passes wrote past the allocation.  Listing
   * a busy directory (the fixture suite churning /tmp) aborted with
   * "corrupted size vs. prev_size". */
  size_t cap = 16, i = 0;
  char** entries = (char**)malloc(cap * sizeof(char*));
  if (!entries) { closedir(d); return 0; }

  struct dirent* entry;
  while ((entry = readdir(d))) {
      if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) continue;
      if (i + 1 >= cap) {  /* keep a slot for the NULL terminator */
          char** grown = (char**)realloc(entries, cap * 2 * sizeof(char*));
          if (!grown) break;
          entries = grown;
          cap *= 2;
      }
      entries[i++] = strdup(entry->d_name);
  }
  entries[i] = NULL;
  closedir(d);
  return (void *)(intptr_t)entries;
  ```)
;;; free-dir-listing -- free a directory listing returned by list-dir.
;;;
;;; Parameters:
;;;   entries -- the NULL-terminated string array returned by list-dir.
;;;
;;; Since: Phase 16
;; Free directory listing returned by list-dir

(defn free-dir-listing [entries : DirListing] : void
  ```c
  if (!entries) return;
  char** e = (char**)entries;
  for (int i = 0; e[i]; i++) {
      free(e[i]);
  }
  free(e);
  ```)
;; ============================================================================
;; LT4: FileHandle -- resource-safe file handle (move-only)
;; ============================================================================
;;; FileHandle -- a linear (exactly-once) wrapper around a FILE* pointer.
;;;
;;; Wrapping FILE* in a named struct enforces that file handles are not
;;; accidentally duplicated.  Marking the struct :linear (CK_LINEAR) means
;;; every bound FileHandle must be explicitly consumed (e.g. via file-close);
;;; the compiler emits TUR-E0100 if a linear value is silently dropped.
;;;
;;; Since: LT4


(defstruct FileHandle :linear [ptr : ptr<void>])
;;; file-open -- open a file and return a move-only FileHandle.
;;;
;;; Parameters:
;;;   path -- filesystem path to open (:cstr).
;;;   mode -- fopen mode string, e.g. "rb" or "wb" (:cstr).
;;;
;;; Returns:
;;;   A FileHandle wrapping the opened FILE*, or a FileHandle with a
;;;   NULL ptr on error.  Check with file-handle-ok? before using.
;;;
;;; Example:
;;;   (let [fh (file-open "/etc/hostname" "rb")] ...)
;;;
;;; Since: LT4

(defn file-open [path : cstr mode : cstr] : FileHandle
  ```c
  FileHandle fh;
  fh.ptr = (void*)fopen(path, mode);
  return fh;
  ```)
;;; file-handle-ok? -- return true if the FileHandle is valid (non-NULL).
;;;
;;; Parameters:
;;;   fh -- a FileHandle (by value).
;;;
;;; Returns:
;;;   true if the underlying FILE* is non-NULL, false on open failure.
;;;
;;; Example:
;;;   (file-handle-ok? (file-open "/etc/hostname" "rb"))  ; => true
;;;
;;; Since: LT4

(defn file-handle-ok? [^borrow fh : FileHandle] : bool
  ```c
  return fh.ptr != NULL;
  ```)
;;; file-read -- read up to len bytes from fh into buf.
;;;
;;; Parameters:
;;;   fh  -- an open FileHandle (by value; does not consume the handle).
;;;   buf -- destination buffer as ptr<void>.
;;;   len -- maximum number of bytes to read.
;;;
;;; Returns:
;;;   Number of bytes actually read (int).
;;;
;;; Example:
;;;   (file-read fh buf 1024)  ; => 512
;;;
;;; Since: LT4

(defn file-read [^borrow fh : FileHandle buf : ptr<void> len : int] : int
  ```c
  if (!fh.ptr) return -1;
  return (int)fread(buf, 1, len, (FILE*)fh.ptr);
  ```)
;;; file-close -- close a FileHandle and release the underlying FILE*.
;;;
;;; Parameters:
;;;   fh -- a FileHandle to close (by value; handle is consumed).
;;;
;;; Returns:
;;;   0 on success, non-zero on error (mirrors fclose return value).
;;;
;;; Example:
;;;   (file-close fh)  ; => 0
;;;
;;; Since: LT4

(defn file-close [fh : FileHandle] : int
  ```c
  if (!fh.ptr) return -1;
  return fclose((FILE*)fh.ptr);
  ```)
;; ============================================================================
;; stdlib-os-surface-plan P0.2: write / seek / tell on FileHandle
;; ============================================================================
;;; SeekFrom -- the origin a file-seek offset is measured from.
;;;
;;; SeekStart is the beginning of the file (SEEK_SET), SeekCurrent the current
;;; position (SEEK_CUR), SeekEnd the end of the file (SEEK_END).  A tagged
;;; union rather than an int whence, so a caller cannot pass a stray integer.
;;;
;;; Since: stdlib-os-surface P0
(defdata SeekFrom :copy (SeekStart) (SeekCurrent) (SeekEnd))
;;; seek-from->whence -- the C whence constant for a SeekFrom.
(defn seek-from->whence [w : SeekFrom] : int
  (match w
    (SeekStart) 0
    (SeekCurrent) 1
    (SeekEnd) 2))
;;; file-write -- write len bytes from buf to fh.
;;;
;;; Parameters:
;;;   fh  -- an open FileHandle (borrowed; not consumed).
;;;   buf -- source buffer as ptr<void>.
;;;   len -- number of bytes to write.
;;;
;;; Returns:
;;;   Number of bytes actually written (short on error), or -1 when the
;;;   handle is not open.
;;;
;;; Example:
;;;   (file-write fh buf 13)  ; => 13
;;;
;;; Since: stdlib-os-surface P0
(defn file-write [^borrow fh : FileHandle buf : ptr<void> len : int]
  #fx{FS}
  : int
  ```c
  if (!fh.ptr || len < 0) return -1;
  return (int64_t)fwrite(buf, 1, (size_t)len, (FILE*)fh.ptr);
  ```)
;;; file-write-str -- write a NUL-terminated string to fh (no newline added).
;;;
;;; Parameters:
;;;   fh -- an open FileHandle (borrowed; not consumed).
;;;   s  -- the string to write.
;;;
;;; Returns:
;;;   Number of bytes written, or -1 when the handle is not open.
;;;
;;; Example:
;;;   (file-write-str fh "hello\n")  ; => 6
;;;
;;; Since: stdlib-os-surface P0
(defn file-write-str [^borrow fh : FileHandle s : cstr]
  #fx{FS}
  : int
  ```c
  if (!fh.ptr) return -1;
  return (int64_t)fwrite(s, 1, strlen(s), (FILE*)fh.ptr);
  ```)
;;; file-seek-raw -- fseek(3) with a C whence constant (internal).
(defn file-seek-raw [^borrow fh : FileHandle offset : int whence : int]
  #fx{FS}
  : int
  ```c
  if (!fh.ptr) return -1;
  FILE *f = (FILE*)fh.ptr;
  int w = whence == 1 ? SEEK_CUR : whence == 2 ? SEEK_END : SEEK_SET;
  if (fseek(f, (long)offset, w) != 0) return -1;
  return (int64_t)ftell(f);
  ```)
;;; file-seek -- move fh's position to offset, measured from whence.
;;;
;;; Parameters:
;;;   fh     -- an open FileHandle (borrowed; not consumed).
;;;   offset -- byte offset (may be negative with SeekCurrent / SeekEnd).
;;;   whence -- SeekStart, SeekCurrent or SeekEnd.
;;;
;;; Returns:
;;;   The new absolute position, or -1 on error.
;;;
;;; Example:
;;;   (file-seek fh 0 (SeekEnd))  ; => file size
;;;
;;; Since: stdlib-os-surface P0
(defn file-seek [^borrow fh : FileHandle offset : int whence : SeekFrom]
  #fx{FS}
  : int
  (file-seek-raw fh offset (seek-from->whence whence)))
;;; file-tell -- the current byte position of fh.
;;;
;;; Parameters:
;;;   fh -- an open FileHandle (borrowed; not consumed).
;;;
;;; Returns:
;;;   The position from the start of the file, or -1 on error.
;;;
;;; Example:
;;;   (file-tell fh)  ; => 0
;;;
;;; Since: stdlib-os-surface P0
(defn file-tell [^borrow fh : FileHandle]
  #fx{FS}
  : int
  ```c
  if (!fh.ptr) return -1;
  return (int64_t)ftell((FILE*)fh.ptr);
  ```)
;; ============================================================================
;; stdlib-os-surface-plan P0.1: line-oriented stdin
;; ============================================================================
;;; io/read-line -- read one line from stdin.
;;;
;;; The trailing newline (and a CR before it) is stripped.  The last line of
;;; input counts even without a trailing newline.  Uses getline(3) on POSIX
;;; and an fgets loop on Windows, which has no getline.
;;;
;;; Returns:
;;;   (Some line) -- a fresh heap cstr the caller owns (release with free) --
;;;   or None at end of input.  End of input is not an error.
;;;
;;; Example:
;;;   (match (io/read-line)
;;;     (Some s) (println s)
;;;     (None)   (println "<eof>"))
;;;
;;; Since: stdlib-os-surface P0
(defn io/read-line []
  #fx{IO}
  : (Option cstr)
  ```c
  char *line = NULL;
  size_t len = 0;
#ifdef _WIN32
  size_t cap = 0;
  char chunk[512];
  for (;;) {
    if (!fgets(chunk, (int)sizeof chunk, stdin)) break;
    size_t n = strlen(chunk);
    if (len + n + 1 > cap) {
      size_t ncap = cap ? cap * 2 : 1024;
      while (ncap < len + n + 1) ncap *= 2;
      char *grown = (char *)realloc(line, ncap);
      if (!grown) { free(line); return tur_none(); }
      line = grown; cap = ncap;
    }
    memcpy(line + len, chunk, n + 1);
    len += n;
    if (n > 0 && chunk[n - 1] == '\n') break;
  }
  if (!line) return tur_none();
#else
  size_t cap = 0;
  ssize_t n = getline(&line, &cap, stdin);
  if (n < 0) { free(line); return tur_none(); }
  len = (size_t)n;
#endif
  if (len > 0 && line[len - 1] == '\n') line[--len] = '\0';
  if (len > 0 && line[len - 1] == '\r') line[--len] = '\0';
  return tur_some_ptr(line);
  ```)
;;; io/read-stdin -- read all of stdin into one string.
;;;
;;; Reads until end of input, so it works on a pipe or a terminal as well as
;;; a redirected file.
;;;
;;; Returns:
;;;   (Some text) -- a fresh NUL-terminated heap cstr the caller owns (release
;;;   with free) -- or None on a read error.  Empty input is (Some "").
;;;
;;; Example:
;;;   (match (io/read-stdin) (Some s) (println s) (None) (println "read failed"))
;;;
;;; Since: stdlib-os-surface P0
(defn io/read-stdin []
  #fx{IO}
  : (Option cstr)
  ```c
  size_t cap = 4096, len = 0;
  char *buf = (char *)malloc(cap);
  if (!buf) return tur_none();
  for (;;) {
    if (cap - len < 2) {
      char *grown = (char *)realloc(buf, cap * 2);
      if (!grown) { free(buf); return tur_none(); }
      buf = grown; cap *= 2;
    }
    size_t n = fread(buf + len, 1, cap - len - 1, stdin);
    len += n;
    if (n == 0) break;
  }
  if (ferror(stdin)) { free(buf); return tur_none(); }
  buf[len] = '\0';
  return tur_some_ptr(buf);
  ```)
