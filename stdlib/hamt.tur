;;; tur/hamt -- persistent hash-array-mapped trie (HAMT) map.
;;;
;;; Immutable, structurally-sharing key-value map. All update operations
;;; return a new root; the old root remains valid (snapshot semantics).
;;;
;;; Since: Phase P1
; Phase P1: Persistent HAMT - External C declarations
; NOTE: C functions are prefixed tur_hamt_* to avoid name collision with
; Turmeric wrapper functions (hamt/new mangles to hamt_new in C).
(extern-c tur_hamt_new [] :ptr)

(extern-c tur_hamt_free [m :ptr] :void)

(extern-c tur_hamt_retain [m :ptr] :ptr)

(extern-c tur_hamt_count [m :ptr] :int)

(extern-c tur_hamt_set [m :ptr hash :int key :int val :int] :ptr)

(extern-c tur_hamt_del [m :ptr hash :int key :int] :ptr)

(extern-c tur_hamt_has [m :ptr hash :int key :int] :bool)

(extern-c tur_hamt_get [m :ptr hash :int key :int] :int)
; TCE4: key-equality-aware variants -- eq is an opaque closure handle
; (bool(*)(int64_t,int64_t)) consulted when two keys share a hash.

(extern-c tur_hamt_set_eq [m :ptr hash :int key :int val :int eq :ptr] :ptr)

(extern-c tur_hamt_del_eq [m :ptr hash :int key :int eq :ptr] :ptr)

(extern-c tur_hamt_has_eq [m :ptr hash :int key :int eq :ptr] :bool)

(extern-c tur_hamt_get_eq [m :ptr hash :int key :int eq :ptr] :int)
; Content-keyed cstr convenience entry points: hash by content, compare by
; content on collision.  The P3 ^persistent lowering routes :cstr keys here
; (hash-ptr + identity compare only "worked" via unspecified literal merging).

(extern-c tur_hamt_set_cstr [m :ptr key :cstr val :int] :ptr)

(extern-c tur_hamt_del_cstr [m :ptr key :cstr] :ptr)

(extern-c tur_hamt_has_cstr [m :ptr key :cstr] :bool)

(extern-c tur_hamt_get_cstr [m :ptr key :cstr] :int)
; WKC2/WKC3: boxed-key carrier + ownership-aware operations.  tur_hamt_box_key
; heap-copies `n` key bytes behind a refcount header and returns the payload
; pointer; the *_eq_o variants take an `owned` flag selecting the standard
; boxed-key ownership (so the box is freed exactly once across structural
; sharing) for multi-word struct/ADT keys.

(extern-c tur_hamt_box_key [src :ptr n :int] :ptr)
; Generic size-aware content comparator for two boxed-key payloads (reads each
; length from its box header).  One comparator serves every multi-word by-value
; key type -- a MapKey `mk-cmp` for a struct/ADT key returns its address.

(extern-c tur_hamt_box_key_eq [a :int b :int] :bool)

(extern-c tur_hamt_set_eq_o
  [m :ptr hash :int key :int val :int eq :ptr owned :int]
  :ptr)

(extern-c tur_hamt_del_eq_o [m :ptr hash :int key :int eq :ptr owned :int] :ptr)
; collections-cannot-hold-rc-values (map side, step c): the _vo variants take
; the value retain/release ops explicitly instead of hardcoding the boxed-value
; refcount, so a map can own rc<T> values.  The ops must be EMITTED functions
; (see __tur_rc_val_retain / __tur_rc_val_release in the preamble) -- hamt.c is
; precompiled into the runtime archive and could only ever call the archive's
; rc.c, which is the wrong collector in a build carrying its own replica.
;
; owned bit 2 selects them; bits 0/1 keep their meanings (boxed key / boxed
; wide value).  Bits 1 and 2 are mutually exclusive: a value is either a
; by-value box or an rc handle, never both.


(extern-c tur_hamt_set_eq_vo
  [m
   :ptr
   hash
   :int
   key
   :int
   val
   :int
   eq
   :ptr
   owned
   :int
   val_retain
   :ptr
   val_release
   :ptr]
  :ptr)

(extern-c tur_hamt_del_eq_vo
  [m
   :ptr
   hash
   :int
   key
   :int
   eq
   :ptr
   owned
   :int
   val_retain
   :ptr
   val_release
   :ptr]
  :ptr)

(extern-c tur_hamt_has_eq_o
  [m :ptr hash :int key :int eq :ptr owned :int]
  :bool)

(extern-c tur_hamt_get_eq_o [m :ptr hash :int key :int eq :ptr owned :int] :int)

(extern-c tur_hamt_merge [a :ptr b :ptr] :ptr)

(extern-c tur_hamt_eq_dynamic [a :int b :int val_cmp :int] :bool)

(extern-c tur_hamt_hash_str [str :cstr] :int)

(extern-c tur_hamt_hash_ptr [ptr :ptr] :int)

(extern-c tur_hamt_iter_init [iter :ptr m :ptr] :void)

(extern-c tur_hamt_iter_free [iter :ptr] :void)

(extern-c tur_hamt_iter_next
  [iter :ptr hash-out :ptr key-out :ptr val-out :ptr]
  :bool)
;; ============================================================================
;; Core API - Lifecycle
;; ============================================================================
;;; hamt/new -- create a new empty persistent HAMT.
;;;
;;; Returns:
;;;   Pointer to a freshly allocated, empty HAMT with reference count 1.
;;;
;;; Example:
;;;   (hamt/new)  ; => <hamt ptr>
;;;
;;; Since: Phase P1
;; Create a new empty HAMT


(defn hamt/new [] #fx{} : ptr<void> (tur_hamt_new))
;;; hamt/free -- decrement the reference count of a HAMT; free if it reaches zero.
;;;
;;; Parameters:
;;;   m -- HAMT pointer
;;;
;;; Example:
;;;   (hamt/free my-map)
;;;
;;; Since: Phase P1
;; Free a HAMT (decrement ref count, free if zero)

(defn hamt/free [m : ptr<void>] #fx{} : void (tur_hamt_free m))
;;; hamt/retain -- increment the reference count of a HAMT and return it.
;;;
;;; Parameters:
;;;   m -- HAMT pointer
;;;
;;; Returns:
;;;   The same HAMT pointer m, with its reference count incremented.
;;;
;;; Example:
;;;   (hamt/retain my-map)  ; => my-map
;;;
;;; Since: Phase P1
;; Increment ref count

(defn hamt/retain [m : ptr<void>] #fx{} : ptr<void> (tur_hamt_retain m))
;; ============================================================================
;; Core API - Operations
;; ============================================================================
;;; hamt/set -- insert or update a key/value pair; returns a new HAMT.
;;;
;;; Parameters:
;;;   m   -- source HAMT pointer
;;;   hash -- 64-bit hash of the key (passed as int64_t)
;;;   key -- key pointer
;;;   val -- value pointer
;;;
;;; Returns:
;;;   A new HAMT containing the inserted/updated entry. The original is unchanged.
;;;
;;; Example:
;;;   (hamt/set m (hamt/hash-str "k") k v)  ; => <new hamt ptr>
;;;
;;; Since: Phase P1
;; Insert or update a key/value pair. Returns a new HAMT.
;; hash: 64-bit hash of the key (passed as int = int64_t)


(defn hamt/set [m : ptr<void> hash : int key : int val : int]
  #fx{}
  : ptr<void>
  (tur_hamt_set m hash key val))
;;; hamt/del -- delete a key from the HAMT; returns a new HAMT.
;;;
;;; Parameters:
;;;   m    -- source HAMT pointer
;;;   hash -- 64-bit hash of the key
;;;   key  -- key pointer
;;;
;;; Returns:
;;;   A new HAMT with the key removed. The original is unchanged.
;;;
;;; Example:
;;;   (hamt/del m (hamt/hash-str "k") k)  ; => <new hamt ptr>
;;;
;;; Since: Phase P1
;; Delete a key. Returns a new HAMT.

(defn hamt/del [m : ptr<void> hash : int key : int]
  #fx{}
  : ptr<void>
  (tur_hamt_del m hash key))
;;; hamt/get -- look up a key and return its value, or NULL if absent.
;;;
;;; Parameters:
;;;   m    -- HAMT pointer
;;;   hash -- 64-bit hash of the key
;;;   key  -- key pointer
;;;
;;; Returns:
;;;   The value pointer associated with key, or NULL if not found.
;;;
;;; Example:
;;;   (hamt/get m (hamt/hash-str "k") k)  ; => <value ptr or NULL>
;;;
;;; Since: Phase P1
;; Get the value for a key. Returns NULL if not found.

(defn hamt/get [m : ptr<void> hash : int key : int]
  #fx{}
  : int
  (tur_hamt_get m hash key))
;;; hamt/has? -- check whether a key exists in the HAMT.
;;;
;;; Parameters:
;;;   m    -- HAMT pointer
;;;   hash -- 64-bit hash of the key
;;;   key  -- key pointer
;;;
;;; Returns:
;;;   true if the key is present, false otherwise.
;;;
;;; Example:
;;;   (hamt/has? m (hamt/hash-str "k") k)  ; => true
;;;
;;; Since: Phase P1
;; Check if a key exists in the HAMT.

(defn hamt/has? [m : ptr<void> hash : int key : int]
  #fx{}
  : bool
  (tur_hamt_has m hash key))
;;; hamt/set-cstr -- insert or update a string-keyed entry, compared by content.
;;;
;;; The key is hashed by content (xxHash64 of the bytes) and compared by
;;; content on hash collision, so equal text at distinct addresses is one
;;; key.  The map stores the key pointer (no copy); the caller owns its
;;; lifetime.  Prefer this over hamt/set + hamt/hash-ptr for :cstr keys.
;;;
;;; Parameters:
;;;   m   -- source HAMT pointer
;;;   key -- NUL-terminated string key
;;;   val -- value pointer
;;;
;;; Returns:
;;;   A new HAMT containing the inserted/updated entry. The original is unchanged.
;;;
;;; Example:
;;;   (hamt/set-cstr m "name" v)  ; => <new hamt ptr>
;;;
;;; Since: Phase P3

(defn hamt/set-cstr [m : ptr<void> key : cstr val : int]
  #fx{}
  : ptr<void>
  (tur_hamt_set_cstr m key val))
;;; hamt/del-cstr -- delete a string key, compared by content; returns a new HAMT.
;;;
;;; Parameters:
;;;   m   -- source HAMT pointer
;;;   key -- NUL-terminated string key
;;;
;;; Returns:
;;;   A new HAMT with the key removed. The original is unchanged.
;;;
;;; Example:
;;;   (hamt/del-cstr m "name")  ; => <new hamt ptr>
;;;
;;; Since: Phase P3

(defn hamt/del-cstr [m : ptr<void> key : cstr]
  #fx{}
  : ptr<void>
  (tur_hamt_del_cstr m key))
;;; hamt/get-cstr -- look up a string key by content; NULL if absent.
;;;
;;; Parameters:
;;;   m   -- HAMT pointer
;;;   key -- NUL-terminated string key
;;;
;;; Returns:
;;;   The value pointer associated with key, or NULL if not found.
;;;
;;; Example:
;;;   (hamt/get-cstr m "name")  ; => <value ptr or NULL>
;;;
;;; Since: Phase P3

(defn hamt/get-cstr [m : ptr<void> key : cstr]
  #fx{}
  : int
  (tur_hamt_get_cstr m key))
;;; hamt/has-cstr? -- check whether a string key exists, compared by content.
;;;
;;; Parameters:
;;;   m   -- HAMT pointer
;;;   key -- NUL-terminated string key
;;;
;;; Returns:
;;;   true if the key is present, false otherwise.
;;;
;;; Example:
;;;   (hamt/has-cstr? m "name")  ; => true
;;;
;;; Since: Phase P3

(defn hamt/has-cstr? [m : ptr<void> key : cstr]
  #fx{}
  : bool
  (tur_hamt_has_cstr m key))
;;; hamt/count -- return the number of key/value pairs in the HAMT.
;;;
;;; Parameters:
;;;   m -- HAMT pointer
;;;
;;; Returns:
;;;   Integer count of entries stored in the HAMT.
;;;
;;; Example:
;;;   (hamt/count my-map)  ; => 3
;;;
;;; Since: Phase P1
;; Get the number of key/value pairs in the HAMT.

(defn hamt/count [m : ptr<void>] #fx{} : int (tur_hamt_count m))
;;; hamt/merge -- merge two HAMTs; values from b win on key collision.
;;;
;;; Parameters:
;;;   a -- first HAMT pointer
;;;   b -- second HAMT pointer (wins on collision)
;;;
;;; Returns:
;;;   A new HAMT containing all entries from a and b.
;;;
;;; Example:
;;;   (hamt/merge map-a map-b)  ; => <merged hamt ptr>
;;;
;;; Since: Phase P1
;; Merge two HAMTs. If a key exists in both, the value from b is kept.
;; Returns a new HAMT.

(defn hamt/merge [a : ptr<void> b : ptr<void>]
  #fx{}
  : ptr<void>
  (tur_hamt_merge a b))
;; ============================================================================
;; Hash utilities
;; ============================================================================
;;; hamt/hash-str -- compute an xxHash64 of a NUL-terminated C string.
;;;
;;; Parameters:
;;;   str -- NUL-terminated C string to hash
;;;
;;; Returns:
;;;   64-bit hash value as int64_t.
;;;
;;; Example:
;;;   (hamt/hash-str "hello")  ; => <hash int>
;;;
;;; Since: Phase P1
;; Compute xxHash64 of a string (NUL-terminated).


(defn hamt/hash-str [str : cstr] #fx{} : int (tur_hamt_hash_str str))
;;; hamt/hash-ptr -- hash a pointer value directly (identity hash).
;;;
;;; Parameters:
;;;   ptr -- pointer whose address is used as the hash input
;;;
;;; Returns:
;;;   64-bit hash value derived from the pointer address.
;;;
;;; Example:
;;;   (hamt/hash-ptr my-key)  ; => <hash int>
;;;
;;; Since: Phase P1
;; Hash a pointer value directly.

(defn hamt/hash-ptr [ptr : ptr<void>] #fx{} : int (tur_hamt_hash_ptr ptr))
;; ============================================================================
;; Iteration API
;; ============================================================================
;;; hamt/iter-init -- initialize a stack-allocated iterator over a HAMT.
;;;
;;; Parameters:
;;;   iter -- pre-allocated buffer of at least 64 bytes
;;;   m    -- HAMT pointer to iterate over
;;;
;;; Example:
;;;   (hamt/iter-init iter-buf my-map)
;;;
;;; Since: Phase P1
;; Initialize an iterator (iter must be pre-allocated, at least 64 bytes).


(defn hamt/iter-init [iter : ptr<void> m : ptr<void>]
  #fx{}
  : void
  (tur_hamt_iter_init iter m))
;;; hamt/iter-free -- release any resources held by an iterator.
;;;
;;; Parameters:
;;;   iter -- iterator buffer previously passed to hamt/iter-init
;;;
;;; Example:
;;;   (hamt/iter-free iter-buf)
;;;
;;; Since: Phase P1
;; Free iterator resources.

(defn hamt/iter-free [iter : ptr<void>] #fx{} : void (tur_hamt_iter_free iter))
;;; hamt/iter-next -- advance an iterator and write the next entry into out-pointers.
;;;
;;; Parameters:
;;;   iter     -- iterator buffer
;;;   hash-out -- pointer that receives the key hash
;;;   key-out  -- pointer that receives the key pointer
;;;   val-out  -- pointer that receives the value pointer
;;;
;;; Returns:
;;;   true if a pair was written; false when the iteration is exhausted.
;;;
;;; Example:
;;;   (hamt/iter-next iter hash-out key-out val-out)  ; => true/false
;;;
;;; Since: Phase P1
;; Advance iterator. Returns true if a pair was found.
;; hash-out, key-out, val-out must be pre-allocated pointers.

(defn hamt/iter-next [iter : ptr<void>
                      hash-out : ptr<void>
                      key-out : ptr<void>
                      val-out : ptr<void>]
  #fx{}
  : bool
  (tur_hamt_iter_next iter hash-out key-out val-out))
;; ----------------------------------------------------------------------------
;; Iterator-box wrapper -- heap-allocated (iter + current slots) handle.
;;
;; The Eq[Map] / Eq[Set] instances run their per-entry walk in pure
;; Turmeric (self-tail TCO'd in a typed by-value spec), so they need a
;; handle they can pass through the loop and three scalar accessors for
;; the current (hash, key, val).  These wrap tur_hamt_iter_* under the hood
;; -- the box owns the iter state and the cached current-entry slots.
;; ----------------------------------------------------------------------------

(extern-c tur_hamt_iter_alloc [m :ptr] :ptr)

(extern-c tur_hamt_iter_destroy [box :ptr] :void)

(extern-c tur_hamt_iter_advance [box :ptr] :bool)

(extern-c tur_hamt_iter_cur_hash [box :ptr] :int)

(extern-c tur_hamt_iter_cur_key [box :ptr] :int)

(extern-c tur_hamt_iter_cur_val [box :ptr] :int)

(extern-c tur_hamt_keyeq [m :ptr] :ptr)

(extern-c tur_hamt_get_dynamic [m :ptr hash :int key :int keyeq :ptr] :int)

(extern-c tur_hamt_has_dynamic [m :ptr hash :int key :int keyeq :ptr] :bool)
;;; hamt/iter-alloc -- allocate an iterator box for HAMT m.
;;;
;;; Returns an opaque handle that owns a HamtIter plus cached current
;;; (hash, key, val) slots.  Pair with hamt/iter-destroy! when done.
;;;
;;; Since: Phase TCO-Eq-MapSet


(defn hamt/iter-alloc [m : ptr<void>] #fx{} : ptr<void> (tur_hamt_iter_alloc m))
;;; hamt/iter-destroy! -- free an iterator box.


(defn hamt/iter-destroy! [box : ptr<void>]
  #fx{}
  : void
  (tur_hamt_iter_destroy box))
;;; hamt/iter-advance! -- step to the next entry; returns false on exhaustion.
;;;
;;; The current hash / key / value are exposed via the cur-* accessors.


(defn hamt/iter-advance! [box : ptr<void>]
  #fx{}
  : bool
  (tur_hamt_iter_advance box))
;;; hamt/iter-cur-hash -- current entry's 64-bit hash (only valid after a
;;; successful hamt/iter-advance!).


(defn hamt/iter-cur-hash [box : ptr<void>]
  #fx{}
  : int
  (tur_hamt_iter_cur_hash box))
;;; hamt/iter-cur-key -- current entry's key pointer.


(defn hamt/iter-cur-key [box : ptr<void>]
  #fx{}
  : int
  (tur_hamt_iter_cur_key box))
;;; hamt/iter-cur-val -- current entry's value pointer.


(defn hamt/iter-cur-val [box : ptr<void>]
  #fx{}
  : int
  (tur_hamt_iter_cur_val box))
;;; hamt/keyeq -- read the stamped key comparator off a HAMT (NULL = identity).


(defn hamt/keyeq [m : ptr<void>] #fx{} : ptr<void> (tur_hamt_keyeq m))
;;; hamt/get-dynamic -- lookup using the supplied key comparator when
;;; non-NULL, else identity.  Used by the pure-Turmeric Eq[Map] loop so the
;;; loop body has no conditional around the per-entry lookup.


(defn hamt/get-dynamic [m : ptr<void>
                        hash : int
                        key : int
                        keyeq : ptr<void>]
  #fx{}
  : int
  (tur_hamt_get_dynamic m hash key keyeq))
;;; hamt/has-dynamic? -- presence check matching hamt/get-dynamic's semantics.


(defn hamt/has-dynamic? [m : ptr<void>
                         hash : int
                         key : int
                         keyeq : ptr<void>]
  #fx{}
  : bool
  (tur_hamt_has_dynamic m hash key keyeq))
;; ============================================================================
;; Higher-order operations
;; ============================================================================


(extern-c tur_hamt_map [m :ptr fn :ptr ctx :ptr] :ptr)

(extern-c tur_hamt_filter [m :ptr fn :ptr ctx :ptr] :ptr)

(extern-c tur_hamt_reduce [m :ptr fn :ptr init :int ctx :ptr] :int)

(extern-c tur_hamt_merge_with [a :ptr b :ptr fn :ptr ctx :ptr] :ptr)
;;; hamt/map -- return a new HAMT with each value replaced by fn(val, ctx).
;;;
;;; Parameters:
;;;   m   -- source HAMT pointer
;;;   fn  -- C function pointer (val :int, ctx :ptr) -> :ptr
;;;   ctx -- caller-supplied context passed to fn
;;;
;;; Returns:
;;;   A new HAMT with transformed values.
;;;
;;; Example:
;;;   (hamt/map my-map transform-fn ctx)  ; => <new hamt ptr>
;;;
;;; Since: Phase P1
;; Map: return a new HAMT with each value replaced by fn(val, ctx).

(defn hamt/map [m : ptr<void> fn : ptr<void> ctx : ptr<void>]
  #fx{}
  : ptr<void>
  (tur_hamt_map m fn ctx))
;;; hamt/filter -- return a new HAMT keeping only entries where fn(key, val, ctx) is true.
;;;
;;; Parameters:
;;;   m   -- source HAMT pointer
;;;   fn  -- C predicate pointer (key :int, val :int, ctx :ptr) -> bool
;;;   ctx -- caller-supplied context passed to fn
;;;
;;; Returns:
;;;   A new HAMT containing only the entries that passed the predicate.
;;;
;;; Example:
;;;   (hamt/filter my-map pred-fn ctx)  ; => <filtered hamt ptr>
;;;
;;; Since: Phase P1
;; Filter: return a new HAMT with only entries where fn(key, val, ctx) is true.

(defn hamt/filter [m : ptr<void> fn : ptr<void> ctx : ptr<void>]
  #fx{}
  : ptr<void>
  (tur_hamt_filter m fn ctx))
;;; hamt/reduce -- fold all entries into an accumulator using fn(acc, key, val, ctx).
;;;
;;; Parameters:
;;;   m    -- source HAMT pointer
;;;   fn   -- C function pointer (acc :ptr, key :int, val :int, ctx :ptr) -> :ptr
;;;   init -- initial accumulator pointer
;;;   ctx  -- caller-supplied context passed to fn
;;;
;;; Returns:
;;;   Final accumulator pointer after visiting all entries.
;;;
;;; Example:
;;;   (hamt/reduce my-map fold-fn init-acc ctx)  ; => <result ptr>
;;;
;;; Since: Phase P1
;; Reduce: fold all entries; returns final accumulator (as ptr).

(defn hamt/reduce [m : ptr<void>
                   fn : ptr<void>
                   init : int
                   ctx : ptr<void>]
  #fx{}
  : int
  (tur_hamt_reduce m fn init ctx))
;;; hamt/merge-with -- merge two HAMTs, resolving key conflicts with fn(val_a, val_b, ctx).
;;;
;;; Parameters:
;;;   a   -- first HAMT pointer
;;;   b   -- second HAMT pointer
;;;   fn  -- C function pointer (val_a :ptr, val_b :ptr, ctx :ptr) -> :ptr
;;;   ctx -- caller-supplied context passed to fn
;;;
;;; Returns:
;;;   A new HAMT where colliding keys are resolved by fn instead of last-write-wins.
;;;
;;; Example:
;;;   (hamt/merge-with map-a map-b merge-fn ctx)  ; => <merged hamt ptr>
;;;
;;; Since: Phase P1
;; Merge-with: merge a and b; resolve conflicts with fn(val_a, val_b, ctx).

(defn hamt/merge-with [a : ptr<void>
                       b : ptr<void>
                       fn : ptr<void>
                       ctx : ptr<void>]
  #fx{}
  : ptr<void>
  (tur_hamt_merge_with a b fn ctx))

(extern-c tur_hamt_show [m :ptr] :cstr)
;;; hamt/show -- return a debug string "{k->v, ...}" for the HAMT; caller must free.
;;;
;;; Parameters:
;;;   m -- HAMT pointer
;;;
;;; Returns:
;;;   NUL-terminated C string; the caller is responsible for freeing it.
;;;
;;; Example:
;;;   (hamt/show my-map)  ; => "{...}"
;;;
;;; Since: Phase P1
;; Show: return a string "{k->v, ../..}" -- caller must free.

(defn hamt/show [m : ptr<void>] #fx{} : cstr (tur_hamt_show m))

(extern-c tur_hamt_dump_dot [m :ptr out :ptr] :void)

(extern-c tur_hamt_dump_dot_stderr [m :ptr] :void)
;;; hamt/dump -- write the HAMT structure in DOT format to stderr for debugging.
;;;
;;; Parameters:
;;;   m -- HAMT pointer to dump
;;;
;;; Example:
;;;   (hamt/dump my-map)
;;;
;;; Since: Phase P1
;; Dump the HAMT in DOT format to stderr (for debugging).

(defn hamt/dump [m : ptr<void>] #fx{} : void (tur_hamt_dump_dot_stderr m))
;; ============================================================================
;; Transient mode -- mutable batch-construction
;; ============================================================================


(extern-c tur_hamt_transient [m :ptr] :ptr)

(extern-c tur_hamt_transient_set [t :ptr hash :int key :int val :int] :void)

(extern-c tur_hamt_transient_del [t :ptr hash :int key :int] :void)

(extern-c tur_hamt_persistent [t :ptr] :ptr)
;;; hamt/transient -- fork a mutable transient from an immutable HAMT.
;;;
;;; Parameters:
;;;   m -- immutable HAMT pointer to fork from
;;;
;;; Returns:
;;;   A transient (mutable) view that shares structure with m.
;;;
;;; Example:
;;;   (hamt/transient my-map)  ; => <transient ptr>
;;;
;;; Since: Phase P1
;; Fork a transient from an immutable map.

(defn hamt/transient [m : ptr<void>] #fx{} : ptr<void> (tur_hamt_transient m))
;;; hamt/transient-set! -- mutate a transient by inserting or updating a key in place.
;;;
;;; Parameters:
;;;   t    -- transient HAMT pointer
;;;   hash -- 64-bit hash of the key
;;;   key  -- key pointer
;;;   val  -- value pointer
;;;
;;; Example:
;;;   (hamt/transient-set! t (hamt/hash-str "k") k v)
;;;
;;; Since: Phase P1
;; Mutate a transient: insert/update key (hash, key, val).

(defn hamt/transient-set! [t : ptr<void>
                           hash : int
                           key : int
                           val : int]
  #fx{}
  : void
  (tur_hamt_transient_set t hash key val))
;;; hamt/transient-del! -- mutate a transient by deleting a key in place.
;;;
;;; Parameters:
;;;   t    -- transient HAMT pointer
;;;   hash -- 64-bit hash of the key
;;;   key  -- key pointer
;;;
;;; Example:
;;;   (hamt/transient-del! t (hamt/hash-str "k") k)
;;;
;;; Since: Phase P1
;; Mutate a transient: delete key (hash, key).

(defn hamt/transient-del! [t : ptr<void> hash : int key : int]
  #fx{}
  : void
  (tur_hamt_transient_del t hash key))
;;; hamt/persistent! -- seal a transient into an immutable HAMT.
;;;
;;; Parameters:
;;;   t -- transient HAMT pointer (must not be used after this call)
;;;
;;; Returns:
;;;   A new immutable HAMT containing all mutations applied to the transient.
;;;
;;; Example:
;;;   (hamt/persistent! t)  ; => <immutable hamt ptr>
;;;
;;; Since: Phase P1
;; Seal transient into an immutable map. The transient must not be used after this.

(defn hamt/persistent! [t : ptr<void>]
  #fx{}
  : ptr<void>
  (tur_hamt_persistent t))
;; ============================================================================
;; Autolink hint -- consumed by `tur build`/`tur run` (src/main.c).
;; The __tur_autolink__ comment causes src/runtime/hamt.c to be compiled
;; alongside the generated code and -Isrc/runtime to be added so that hamt.h
;; can be found.
;; ============================================================================
;;; hamt/autolink-hint -- internal marker that triggers hamt.c compilation in tur build/run.


(defn hamt/autolink-hint []
  #fx{Unsafe}
  : int
  ```c
  /* __tur_autolink__: src/runtime/hamt.c src/runtime/rt_alloc.c -Isrc/runtime */
  return 0;
  ```)
