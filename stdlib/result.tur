;;; tur/result -- typed Result[A B]: ok value A or err value B.
;;;
;;; Parameterized result type, as a REAL SUM (SR2b of
;;; docs/archive/sum-representation-plan.md): `(Ok A)` or `(Err B)`.
;;; Runtime layout is the tagged monomorph -- { int tag; union { Ok; Err } } --
;;; 16 bytes (down from the record's 24), one payload slot, no dead arm to
;;; zero-fill, so `err` no longer needs a zero value for A nor `ok` one for B.
;;; A concrete monomorph flows BY VALUE with no per-ctor allocation (SR2a,
;;; default since 2026-08-27); an erased generic base still rides the int64
;;; carrier, a heap pointer to the same layout.  Tag values follow declaration
;;; order: Ok = 0, Err = 1.
;;; The inline-C helpers in the codegen preamble (tur_box_ok / tur_box_err /
;;; tur_is_ok / tur_ok_value / tur_err_value and the _int/_ptr builders) build
;;; and read this exact layout; keep them in lockstep with this declaration.
;;;
;;; Since: Phase TC1-E; converted to a sum in SR2b.
;;; Result -- parameterized result type with ok type A and err type B.
;;;
;;; Since: Phase TC1
(defdata Result :copy [A B] (Ok A) (Err B))
;;; ok -- wrap a success value of type A in a Result[A B].
;;;
;;; Parameters:
;;;   x -- the ok value (type A)
;;;
;;; Returns:
;;;   A Result[A B] carrying the Ok variant. B is a phantom tyvar inferred
;;;   from the call site (or pinned with an ascription such as
;;;   `(:: (ok x) (Result A B))`).
;;;
;;; Example:
;;;   (ok 42)                        ; => Result int B  (B inferred)
;;;   (:: (ok "hi") (Result cstr cstr))
;;;
;;; Since: Phase TC1 (made polymorphic over A/B as Prereq 3, 2026-06-12;
;;;   converted to a sum constructor in SR2b -- the dead err arm, and the
;;;   `(default-of B)` zero it required, are gone).

(defn ^construct ok [A B] [x : A] : (Result A B) (Ok x))
;;; err -- wrap an error value of type B in a Result[A B].
;;;
;;; Parameters:
;;;   e -- the error value (type B)
;;;
;;; Returns:
;;;   A Result[A B] carrying the Err variant. A is a phantom tyvar inferred
;;;   from the call site (or pinned with an ascription such as
;;;   `(:: (err msg) (Result A B))`).
;;;
;;; Example:
;;;   (err 404)                       ; => Result A int   (A inferred)
;;;   (:: (err "missing") (Result int cstr))
;;;
;;; Since: Phase TC1 (made polymorphic as Prereq 3, 2026-06-12; sum
;;;   constructor since SR2b -- no more `(default-of A)` for the dead ok arm).

(defn ^construct err [A B] [e : B] : (Result A B) (Err e))
;;; ok? -- check whether a Result[A B] is ok.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   true if r is ok, false if r is err.
;;;
;;; Example:
;;;   (ok? (ok 1))   ; => true
;;;   (ok? (err 0))  ; => false
;;;
;;; Since: Phase TC1

;;; SR2a graduation: typed `(Result A B)`, not the `:int` carrier stand-in.
;;; `ok-val` / `err-val` / `some?` were already parametric; these two were the
;;; last carrier-typed Result accessors, and once a concrete `(Result A B)`
;;; monomorph flows BY VALUE an `:int` parameter is a straddle the caller has to
;;; spill across rather than a harmless erasure.  A match body specializes per
;;; monomorph and still accepts a carrier value through the generic base.
(defn ok? [A B] [r : (Result A B)] : bool (match r (Ok _) true (Err _) false))
;;; err? -- check whether a Result[A B] is err.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   true if r is err, false if r is ok.
;;;
;;; Example:
;;;   (err? (err 1))  ; => true
;;;
;;; Since: Phase TC1

(defn err? [A B] [r : (Result A B)] : bool (match r (Ok _) false (Err _) true))
;;; ok-val -- extract the ok value from a typed Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   The ok value of type A; the zero value of A when r is err (preserving
;;;   the pre-sum behaviour, where err's dead ok slot held `(default-of A)`).
;;;
;;; Example:
;;;   (let [r (:: (ok 7) (Result int cstr))]
;;;     (ok-val r))  ; => 7
;;;
;;; Since: Phase TC1

(defn ok-val [A B] [r : (Result A B)] :A
  (match r (Ok v) v (Err _) (default-of A)))
;;; err-val -- extract the error value from a typed Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;
;;; Returns:
;;;   The error value of type B; the zero value of B when r is ok.
;;;
;;; Example:
;;;   (let [r (:: (err "boom") (Result int cstr))]
;;;     (err-val r))  ; => "boom"
;;;
;;; Since: Phase TC1

(defn err-val [A B] [r : (Result A B)] :B
  (match r (Ok _) (default-of B) (Err e) e))
;;; result-free -- free a heap-allocated Result[A B].
;;;
;;; Parameters:
;;;   r -- Result[A B] to free
;;;
;;; Example:
;;;   (result-free my-result)
;;;
;;; Since: Phase TC1

(defn result-free [r : int]
  #fx{}
  : void
  ```c
  if (r) free((void*)(intptr_t)r);
  ```)
;;; result-map -- apply a function to the ok value if ok.
;;;
;;; Parameters:
;;;   r -- Result[A B]
;;;   f -- function A -> C
;;;
;;; Returns:
;;;   Result[C B] with f applied to the ok value if ok, or the
;;;   unchanged err otherwise.
;;;
;;; Example:
;;;   (result-map (ok 3) (fn [x] (* x 2)))  ; => ok(6)
;;;   (result-map (err 5) (fn [x] (* x 2))) ; => err(5)
;;;
;;; Since: Phase TC1

(defn result-map [A B E] [r : (Result A E) ^fat f : (fn [A] B)] : (Result B E)
  (match r (Ok v) (ok (f v)) (Err e) (err e)))
;;; result-eq? -- compare two Result[A B] values.
;;;
;;; Parameters:
;;;   r1      -- first Result[A B]
;;;   r2      -- second Result[A B]
;;;   ok-cmp  -- comparator for ok values fn [a :int b :int] :bool
;;;   err-cmp -- comparator for err values fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both ok with equal ok values, or both err with equal err values.
;;;
;;; Example:
;;;   (result-eq? (ok 1) (ok 1) (fn [a b] (= a b)) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defn result-eq? [A E] [r1 : int
                        r2 : int
                        ^borrow ^fat ok-cmp : (fn [A A] bool)
                        ^borrow ^fat err-cmp : (fn [E E] bool)]
  #fx{}
  : bool
  ```c
  /* SR2b: the carrier points at the tagged sum layout (tag 0 = Ok, 1 = Err);
   * both payloads share the union slot after the tag. */
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *a = (void*)(intptr_t)r1;
  struct { int tag; union { int64_t ok_val; int64_t err_val; } as; } *b = (void*)(intptr_t)r2;
  if (!a && !b) return true;
  if (!a || !b) return false;
  if (a->tag != b->tag) return false;
  /* CRU B-3: ok-cmp/err-cmp are fat closure boxes; fat-dispatch via slot 0. */
  if (a->tag == 0)
      return ((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)ok_cmp)[0])((void*)(intptr_t)ok_cmp, a->as.ok_val, b->as.ok_val);
  else
      return ((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)err_cmp)[0])((void*)(intptr_t)err_cmp, a->as.err_val, b->as.err_val);
  ```)
;;; __tur-q-is-err? -- ? operator helper; checks if a Result value is an error.

(defn __tur-q-is-err? [r : ptr<void>]
  #fx{}
  : bool
  ```c
  struct { int tag; int64_t payload; } *res = r;
  return !res || res->tag != 0;
  ```)
;;; __tur-q-ok-val -- ? operator helper; extracts the ok payload from a Result value.

(defn __tur-q-ok-val [r : ptr<void>]
  #fx{}
  : int
  ```c
  struct { int tag; int64_t payload; } *res = r;
  return res ? res->payload : 0;
  ```)
;;; Eq [Result] -- equality using the ok and err types' Eq instances.
;; TC1-22: Phase PTC4 -- constrained Eq instance for Result[A B].
;; SR2b: match on the sum instead of reading record fields.
;; The payload binders are ascribed to the class var so the inner `eq?`
;; re-dispatches per ABI specialization: a bare binder is typed by the
;; representative (int) at elaboration, and the spec then pointer-compared
;; String/struct payloads (`(eq? (some "aa") (some "aa"))` said false).
;;
;; sr2-carrier-seam-rotted (3): the ascription is NECESSARY but it is not what
;; MINTS the specialization -- `body_has_dispatch_on_app_tyvar` now recognises a
;; receiver spelled as an ascription to the instance's own constraint var, and
;; walks into `match` at all, which it did not before.  On the by-value default
;; the spec used to exist for an unrelated reason (a nominal payload changes the
;; Option's C signature, so `abi_changes` fires and correct dispatch came along
;; as a side effect).  Do not read this comment as "the ascription is
;; sufficient": where a payload type does NOT change the signature -- the whole
;; carrier path -- it is not.

(definstance Eq [Result]
  [(Eq A) (Eq B)]
  (eq? [x y]
    (match x
      (Ok vx)
      (match y (Ok vy) (eq? (:: vx A) (:: vy A)) (Err _) false)
      (Err ex)
      (match y (Ok _) false (Err ey) (eq? (:: ex B) (:: ey B))))))
;;; result-bimap -- map fn-left over the err arm and fn-right over the ok arm.
;;;
;;; Follows the Either convention: the err arm is the "left" side and the ok
;;; arm is the "right" side. This is the worker behind the `Bifunctor [Result]`
;;; instance (kept here next to the Result layout it depends on).
;;;
;;; Parameters:
;;;   container -- Result[A B]
;;;   fn-left   -- function applied to the err value (B -> D)
;;;   fn-right  -- function applied to the ok value (A -> C)
;;;
;;; Returns:
;;;   A freshly allocated Result[C D]; the input is not modified.
;;;
;;; Example:
;;;   (result-bimap (ok 5) neg inc)   ; => ok(6)
;;;   (result-bimap (err 5) neg inc)  ; => err(-5)
;;;
;;; Since: stdlib-hkt-consolidation T1

(defn result-bimap [container : int fn-left fn-right]
  #fx{}
  : int
  ```c
  struct { int tag; int64_t payload; } *res = (void*)(intptr_t)container;
  if (!res) return 0;
  if (res->tag == 0)
      return tur_box_ok(((int64_t(*)(int64_t))(intptr_t)fn_right)(res->payload));
  return tur_box_err(((int64_t(*)(int64_t))(intptr_t)fn_left)(res->payload));
  ```)
;; ---------------------------------------------------------------------------
;; HKT typeclass instances (stdlib-hkt-consolidation T1)
;;
;; Result is a binary type constructor of kind (* -> * -> *), so it supports
;; Bifunctor directly. Result owns this instance (home module of the type), so
;; it is not an orphan; the Bifunctor class stub is preloaded before this file.
;;
;; T4 (stdlib-hkt-consolidation): the conventional kind-(* -> *) instances
;; (Functor / Applicative / Monad / MonadError over the ok arm) ARE now
;; expressible via the trailing-parameter instance head `(Result _ B)`, which
;; fixes the err arm B and varies the ok arm. (Result's parameters are
;; [A=ok B=err] with ok FIRST, so leftmost-only application `(Result A)` would
;; fix ok and vary err -- the opposite of the right-biased convention. The `_`
;; hole marks the free parameter, sidestepping that.) See
;; docs/archive/history/result-param-order-blocks-functor-monad.md.
;; ---------------------------------------------------------------------------
;;; Bifunctor [Result] -- map fn-left over err, fn-right over ok.
;;;
;;; Example:
;;;   (bimap (ok 5) neg inc)   ; => ok(6)
;;;   (bimap (err 5) neg inc)  ; => err(-5)
;;;
;;; Since: stdlib-hkt-consolidation T1

(definstance Bifunctor [Result]
  (bimap [container fn-left fn-right]
    (match container (Ok v) (ok (fn-right v)) (Err e) (err (fn-left e)))))
;; ---------------------------------------------------------------------------
;; Ok-biased kind-(* -> *) instances (stdlib-hkt-consolidation T4)
;;
;; The `(Result _ B)` head fixes the err arm B and varies the ok arm, so these
;; are right-biased: every method maps/sequences the ok payload and threads an
;; err through unchanged. Result owns these instances (home module), so they
;; are not orphans; the class stubs are preloaded before this file.
;; ---------------------------------------------------------------------------
;;; Functor [(Result _ B)] -- map a function over the ok payload; err unchanged.
;;;
;;; Example:
;;;   (fmap (:: (ok 21) (Result int int)) (fn [x] (* x 2)))  ; => ok(42)
;;;   (fmap (:: (err 5) (Result int int)) (fn [x] (* x 2)))  ; => err(5)
;;;
;;; Since: stdlib-hkt-consolidation T4

(definstance Functor [(Result _ B)]
  (fmap [container g] (match container (Ok v) (ok (g v)) (Err e) (err e))))
;;; Applicative [(Result _ B)] -- pure is ok; ap applies an ok function to an ok
;;; argument and returns the first err it meets (the function's before the
;;; argument's).
;;;
;;; Example:
;;;   (ap (ok (fn [x] (* x 2))) (ok 21))  ; => ok(42)
;;;   (ap (ok (fn [x] (* x 2))) (err 5))  ; => err(5)
;;;
;;; Since: typeclass-superclasses-plan SC8b

(definstance Applicative [(Result _ B)]
  (pure [x] (ok x))
  (ap [ff fa]
    (match ff
      (Ok f)
      (match fa (Ok a) (ok (f a)) (Err e) (err e))
      (Err e)
      (err e))))
;;; Monad [(Result _ B)] -- bind sequences through ok; short-circuits on err.
;;;
;;; Example:
;;;   (bind (ok 20) (fn [x] (ok (+ x 1))))  ; => ok(21)
;;;
;;; Since: stdlib-hkt-consolidation T4

(definstance Monad [(Result _ B)]
  (bind [ma k] (match ma (Ok v) (k v) (Err e) (err e))))
;;; MonadError [(Result _ B)] -- throw-error builds an err; catch-error runs a
;;; handler on the err payload (ok values pass through unchanged).
;;;
;;; Example:
;;;   (throw-error 404)                              ; => err(404)
;;;   (catch-error (err 5) (fn [e] (ok (* e -1))))   ; => ok(-5)
;;;   (catch-error (ok 7) (fn [e] (ok 0)))           ; => ok(7)
;;;
;;; Since: stdlib-hkt-consolidation T4

(definstance MonadError [(Result _ B)]
  (throw-error [err] ```c return tur_box_err(err); ```)
  (catch-error [ma handler]
    ```c
    struct { int tag; int64_t payload; } *r = (void*)(intptr_t)ma;
    if (!r || r->tag == 0) return ma;
    return handler.fn(handler.env, r->payload);
    ```))
