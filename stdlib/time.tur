;;; tur/time -- Time capability implementation using platform time functions.
;;;
;;; Implements the Time capability typeclass for real clock access, plus
;;; direct helpers (sleep-ms / get-time-ms / get-cpu-time).
;;;
;;; Not auto-loaded -- import the names you need explicitly:
;;;
;;;   (import time :refer [sleep-ms get-time-ms])
;;;
;;; Since: Phase 16
;; Phase 16: Real Time implementation
;;
;; Phase M (time-as-import-module): wrapped in (defmodule time ...) so user
;; code can `(import time :refer [sleep-ms ...])`.  The module name is `time`
;; so it resolves to stdlib/time.tur via the import stdlib-dir fallback.  It is
;; intentionally NOT in main.c's auto-load list -- keeping every program's
;; generated C free of the unused time helpers and its codegen snapshots stable.
(defmodule time
  (export Time
    Real-Time
    Real-Time-free
    HighRes-Time
    HighRes-Time-free
    Mock-Time
    Mock-Time-free
    mock-time-set
    mock-time-get
    get-time-ms
    now-ms
    monotonic-ns
    sleep-ms
    get-cpu-time
    DateTime
    utc-parts
    local-parts
    datetime->ms
    format-iso8601
    parse-iso8601)
  ;; File-scope C helpers for the Time-capability constructors below.  The
  ;; now/sleep implementations MUST live at file scope: a Time struct stores
  ;; their addresses and outlives the constructor call, so they cannot be
  ;; nested functions (a nested function's address dangles once its enclosing
  ;; frame returns).  The inline-C constructors just malloc a struct and point
  ;; its slots at these.  libc time()/clock()/nanosleep() come from the
  ;; <time.h>/<unistd.h> preamble includes.
  ;;
  ;; Each slot takes the capability itself as `self`, so an implementation
  ;; reads its own state from it: a Mock-Time's clock lives in its own struct.
  ;; `now` is 64-bit -- epoch milliseconds are about 1.8e12, past INT32_MAX
  ;; (time-capability-now-is-32-bit).  stdlib/capability.tur's __tur_cap_time
  ;; has the same layout.
  ```c
  typedef struct __tur_time_cap {
      int64_t (*now)(void *self);
      void (*sleep)(void *self, int ms);
  } __tur_time_cap;
  typedef struct __tur_mock_cap {
      int64_t (*now)(void *self);
      void (*sleep)(void *self, int ms);
      int64_t current_time;
  } __tur_mock_cap;

  /* Wall-clock milliseconds since the Unix epoch, at real millisecond
   * resolution: now-ms and Real-Time's `now` both read it. */
  static int64_t __tur_wall_clock_ms(void) {
  #ifdef _WIN32
      FILETIME ft;
      GetSystemTimePreciseAsFileTime(&ft);
      uint64_t t = ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
      /* 100ns ticks since 1601-01-01 -> ms since 1970-01-01 */
      return (int64_t)((t - 116444736000000000ULL) / 10000ULL);
  #else
      struct timespec ts;
      if (clock_gettime(CLOCK_REALTIME, &ts) != 0) return (int64_t)time(NULL) * 1000;
      return (int64_t)ts.tv_sec * 1000 + (int64_t)(ts.tv_nsec / 1000000);
  #endif
  }

  /* CPU milliseconds used by the process.  Widened before the multiply: a
   * 32-bit clock_t (Windows) overflows `now * 1000` after 36 minutes. */
  static int64_t __tur_cpu_clock_ms(void) {
      return (int64_t)clock() * 1000 / CLOCKS_PER_SEC;
  }

  static void __tur_sleep_ms(int ms) {
      if (ms <= 0) return;
      struct timespec req = {.tv_sec = ms / 1000, .tv_nsec = (long)(ms % 1000) * 1000000};
      struct timespec rem;
      while (nanosleep(&req, &rem) == -1) { req = rem; }
  }

  static int64_t __tur_real_time_now(void *self) { (void)self; return __tur_wall_clock_ms(); }
  static void __tur_real_time_sleep(void *self, int ms) { (void)self; __tur_sleep_ms(ms); }

  static int64_t __tur_hires_time_now(void *self) { (void)self; return __tur_cpu_clock_ms(); }
  static void __tur_hires_time_sleep(void *self, int ms) { (void)self; __tur_sleep_ms(ms); }

  /* Mock clock: each handle keeps its own time, which only sleep and
   * mock-time-set move. */
  static int64_t __tur_mock_time_now(void *self) {
      return ((__tur_mock_cap *)self)->current_time;
  }
  static void __tur_mock_time_sleep(void *self, int ms) {
      ((__tur_mock_cap *)self)->current_time += ms;
  }

  /* ---- Civil dates (stdlib-os-surface P3.2) ----
   * Proleptic Gregorian calendar, no time-zone database: UTC is pure
   * arithmetic, local time comes from localtime_r.  The two conversions are
   * Howard Hinnant's days_from_civil / civil_from_days, exact over the whole
   * int64 range a DateTime can describe. */
  static int64_t __tur_floor_div(int64_t a, int64_t b) {
      int64_t q = a / b;
      if ((a % b != 0) && ((a < 0) != (b < 0))) q--;
      return q;
  }
  /* Days since 1970-01-01 of year-month-day (month 1-12). */
  static int64_t __tur_days_from_civil(int64_t y, int64_t m, int64_t d) {
      y -= m <= 2;
      int64_t era = (y >= 0 ? y : y - 399) / 400;
      int64_t yoe = y - era * 400;
      int64_t doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
      int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
      return era * 146097 + doe - 719468;
  }
  static void __tur_civil_from_days(int64_t z, int64_t *y, int64_t *m, int64_t *d) {
      z += 719468;
      int64_t era = (z >= 0 ? z : z - 146096) / 146097;
      int64_t doe = z - era * 146097;
      int64_t yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
      int64_t doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
      int64_t mp = (5 * doy + 2) / 153;
      *d = doy - (153 * mp + 2) / 5 + 1;
      *m = mp < 10 ? mp + 3 : mp - 9;
      *y = yoe + era * 400 + (*m <= 2);
  }
  /* The UTC fields of epoch milliseconds ms:
   * out = { year month day hour minute second millis }. */
  static void __tur_utc_fields(int64_t ms, int64_t out[7]) {
      int64_t days = __tur_floor_div(ms, 86400000LL);
      int64_t rem = ms - days * 86400000LL;
      __tur_civil_from_days(days, &out[0], &out[1], &out[2]);
      out[3] = rem / 3600000LL;
      out[4] = rem / 60000LL % 60;
      out[5] = rem / 1000LL % 60;
      out[6] = rem % 1000LL;
  }
  static int __tur_is_leap(int64_t y) {
      return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
  }
  static int64_t __tur_days_in_month(int64_t y, int64_t m) {
      static const int dim[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
      return (m == 2 && __tur_is_leap(y)) ? 29 : dim[m - 1];
  }
  /* Parse between lo and hi decimal digits at *pp into *out; advance *pp.
   * Answers the digit count, 0 when there were fewer than lo. */
  static int __tur_parse_digits(const char **pp, int lo, int hi, int64_t *out) {
      const char *p = *pp;
      int64_t v = 0;
      int n = 0;
      while (n < hi && *p >= '0' && *p <= '9') { v = v * 10 + (*p - '0'); p++; n++; }
      if (n < lo) return 0;
      *pp = p;
      *out = v;
      return n;
  }
  ```
  ;;; Time -- opaque handle to a Time capability struct (now/sleep closures).
  ;;;
  ;;; Created by Real-Time / HighRes-Time / Mock-Time; released by the matching
  ;;; *-free helper.
  ;;;
  ;;; Since: Phase 16
  (defopaque Time :ptr<void>)
  ;;; Real-Time -- create a wall-clock Time capability.
  ;;;
  ;;; Returns:
  ;;;   A heap-allocated Time struct with:
  ;;;     now   -- returns milliseconds since the Unix epoch, read the way
  ;;;              now-ms reads it (CLOCK_REALTIME; millisecond precision).
  ;;;     sleep -- sleeps for the requested number of milliseconds via nanosleep,
  ;;;              retrying on EINTR.
  ;;;   Free with Real-Time-free when done.
  ;;;
  ;;; Example:
  ;;;   (let [t (Real-Time)] ...)
  ;;;
  ;;; Since: Phase 16
  ;; Real-Time implementation -- CLOCK_REALTIME and nanosleep()
  (defn Real-Time [] : Time
    ```c
    __tur_time_cap *cap = (__tur_time_cap *)malloc(sizeof(*cap));
    cap->now = __tur_real_time_now;
    cap->sleep = __tur_real_time_sleep;
    return (void *)(intptr_t)cap;
    ```)
  ;;; Real-Time-free -- release a Time capability created by Real-Time.
  ;;;
  ;;; Parameters:
  ;;;   t -- the Time pointer returned by Real-Time.
  ;;;
  ;;; Since: Phase 16
  ;; Free a Real-Time
  (defn Real-Time-free [t : Time] : void
    ```c
    free((void*)(intptr_t)t);
    ```)
  ;; ============================================================================
  ;; High-resolution Time implementation
  ;; ============================================================================
  ;;; HighRes-Time -- create a CPU-clock Time capability backed by clock().
  ;;;
  ;;; Returns:
  ;;;   A heap-allocated Time struct with:
  ;;;     now   -- returns CPU time in milliseconds (based on CLOCKS_PER_SEC).
  ;;;     sleep -- sleeps for the requested number of milliseconds via nanosleep.
  ;;;   Note: now measures CPU time, not wall-clock time.
  ;;;   Free with HighRes-Time-free when done.
  ;;;
  ;;; Example:
  ;;;   (let [t (HighRes-Time)] ...)
  ;;;
  ;;; Since: Phase 16
  ;; HighRes-Time implementation -- uses clock() for higher precision.
  ;; Note: clock() measures CPU time, not wall-clock time.
  (defn HighRes-Time [] : Time
    ```c
    __tur_time_cap *cap = (__tur_time_cap *)malloc(sizeof(*cap));
    cap->now = __tur_hires_time_now;
    cap->sleep = __tur_hires_time_sleep;
    return (void *)(intptr_t)cap;
    ```)
  ;;; HighRes-Time-free -- release a Time capability created by HighRes-Time.
  ;;;
  ;;; Parameters:
  ;;;   t -- the Time pointer returned by HighRes-Time.
  ;;;
  ;;; Since: Phase 16
  ;; Free a HighRes-Time
  (defn HighRes-Time-free [t : Time] : void
    ```c
    free((void*)(intptr_t)t);
    ```)
  ;; ============================================================================
  ;; Mock Time implementation (for testing)
  ;; ============================================================================
  ;;; Mock-Time -- create a controllable Time capability for testing.
  ;;;
  ;;; Returns:
  ;;;   A heap-allocated Time struct backed by an internal integer counter
  ;;;   (initially 0 ms).  now returns the current counter value; sleep
  ;;;   advances the counter by the requested amount without blocking.
  ;;;   Use mock-time-set and mock-time-get to inspect and manipulate time.
  ;;;   Each Mock-Time keeps its own clock, so several can be live at once.
  ;;;   Free with Mock-Time-free when done.
  ;;;
  ;;; Example:
  ;;;   (let [t (Mock-Time)] (mock-time-set t 5000) ...)
  ;;;
  ;;; Since: Phase 16
  ;; Mock-Time implementation -- time advances only via sleep / mock-time-set.
  (defn Mock-Time [] : Time
    ```c
    __tur_mock_cap *cap = (__tur_mock_cap *)malloc(sizeof(*cap));
    cap->now = __tur_mock_time_now;
    cap->sleep = __tur_mock_time_sleep;
    cap->current_time = 0;
    return (void *)(intptr_t)cap;
    ```)
  ;;; Mock-Time-free -- release a Time capability created by Mock-Time.
  ;;;
  ;;; Parameters:
  ;;;   t -- the Time pointer returned by Mock-Time.
  ;;;
  ;;; Since: Phase 16
  ;; Free a Mock-Time
  (defn Mock-Time-free [t : Time] : void
    ```c
    free((void*)(intptr_t)t);
    ```)
  ;;; mock-time-set -- set the current time on a Mock-Time instance.
  ;;;
  ;;; Parameters:
  ;;;   t        -- the Mock-Time pointer.
  ;;;   new_time -- the new time value in milliseconds.
  ;;;
  ;;; Example:
  ;;;   (mock-time-set t 10000)  ; set mock clock to 10 seconds
  ;;;
  ;;; Since: Phase 16
  ;; Set mock time to a specific value (in milliseconds)
  (defn mock-time-set [t : Time new_time : int] : void
    ```c
    __tur_mock_cap *cap = (__tur_mock_cap *)(intptr_t)t;
    cap->current_time = new_time;
    ```)
  ;;; mock-time-get -- read the current time from a Mock-Time instance.
  ;;;
  ;;; Parameters:
  ;;;   t -- the Mock-Time pointer.
  ;;;
  ;;; Returns:
  ;;;   The current mock time in milliseconds as an int.
  ;;;
  ;;; Example:
  ;;;   (mock-time-get t)  ; => 10000
  ;;;
  ;;; Since: Phase 16
  ;; Get current mock time
  (defn mock-time-get [t : Time] : int
    ```c
    __tur_mock_cap *cap = (__tur_mock_cap *)(intptr_t)t;
    return cap->current_time;
    ```)
  ;; ============================================================================
  ;; Helper functions for direct time operations
  ;; ============================================================================
  ;;; now-ms -- the current wall-clock time in milliseconds since the Unix epoch.
  ;;;
  ;;; Reads CLOCK_REALTIME (GetSystemTimePreciseAsFileTime on Windows), so the
  ;;; value has real millisecond resolution.  Wall-clock time can jump (NTP,
  ;;; a user changing the clock); measure durations with monotonic-ns.
  ;;; Spelled time/now-ms under a plain (import time).
  ;;;
  ;;; Returns:
  ;;;   Milliseconds since 1970-01-01T00:00:00Z as an int.
  ;;;
  ;;; Example:
  ;;;   (time/now-ms)  ; => 1791158400123
  ;;;
  ;;; Since: stdlib-os-surface P0
  (defn now-ms []
    #fx{IO}
    : int
    ```c
    return __tur_wall_clock_ms();
    ```)
  ;;; monotonic-ns -- a monotonic clock reading in nanoseconds, for durations.
  ;;;
  ;;; Never goes backwards and is unaffected by wall-clock changes.  The
  ;;; origin is arbitrary (typically boot), so only the difference between two
  ;;; readings is meaningful.  CLOCK_MONOTONIC on POSIX, QueryPerformanceCounter
  ;;; on Windows.  Spelled time/monotonic-ns under a plain (import time).
  ;;;
  ;;; Returns:
  ;;;   Nanoseconds since an unspecified fixed origin, as an int.
  ;;;
  ;;; Example:
  ;;;   (let [t0 (time/monotonic-ns)] (work) (- (time/monotonic-ns) t0))
  ;;;
  ;;; Since: stdlib-os-surface P0
  (defn monotonic-ns []
    #fx{IO}
    : int
    ```c
    #ifdef _WIN32
    LARGE_INTEGER freq, now;
    QueryPerformanceFrequency(&freq);
    QueryPerformanceCounter(&now);
    return (int64_t)((now.QuadPart / freq.QuadPart) * 1000000000LL
                     + (now.QuadPart % freq.QuadPart) * 1000000000LL / freq.QuadPart);
#else
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec;
#endif
    ```)
  ;;; get-time-ms -- return the current wall-clock time in milliseconds since epoch.
  ;;;
  ;;; The historical spelling of now-ms, with the same real millisecond
  ;;; resolution (it used to be time(NULL) * 1000 -- one-second steps behind a
  ;;; millisecond name).
  ;;;
  ;;; Returns:
  ;;;   Milliseconds since the Unix epoch as an int.
  ;;;
  ;;; Example:
  ;;;   (get-time-ms)  ; => 1747123456789
  ;;;
  ;;; Since: Phase 16
  (defn get-time-ms [] : int (now-ms))
  ;;; sleep-ms -- suspend execution for a given number of milliseconds.
  ;;;
  ;;; Parameters:
  ;;;   ms -- number of milliseconds to sleep (no-op if <= 0).
  ;;;
  ;;; Example:
  ;;;   (sleep-ms 250)  ; sleep for a quarter second
  ;;;
  ;;; Since: Phase 16
  ;; Sleep for specified milliseconds
  (defn sleep-ms [ms : int] : void
    ```c
    if (ms <= 0) return;
    struct timespec req = {.tv_sec = ms / 1000, .tv_nsec = (long)(ms % 1000) * 1000000};
    struct timespec rem;
    while (nanosleep(&req, &rem) == -1) { req = rem; }
    ```)
  ;;; get-cpu-time -- return the current process CPU time in milliseconds.
  ;;;
  ;;; Returns:
  ;;;   clock() * 1000 / CLOCKS_PER_SEC -- CPU milliseconds consumed by
  ;;;   the current process.
  ;;;
  ;;; Example:
  ;;;   (get-cpu-time)  ; => 42  (42 ms of CPU time used so far)
  ;;;
  ;;; Since: Phase 16
  ;; Get CPU time in milliseconds
  (defn get-cpu-time [] : int
    ```c
    return __tur_cpu_clock_ms();
    ```)
  ;; ============================================================================
  ;; stdlib-os-surface-plan P3.2: calendar dates
  ;; ============================================================================
  ;;; DateTime -- a calendar date and time of day, with its UTC offset.
  ;;;
  ;;; Fields:
  ;;;   year   -- the full year, e.g. 2026 (proleptic Gregorian; may be <= 0)
  ;;;   month  -- 1-12
  ;;;   day    -- 1-31
  ;;;   hour   -- 0-23
  ;;;   minute -- 0-59
  ;;;   second -- 0-59 (60 only when parsed from a leap-second timestamp)
  ;;;   millis -- 0-999
  ;;;   offset -- minutes east of UTC that the other fields are expressed in:
  ;;;             0 from utc-parts, the zone's offset from local-parts
  ;;;             (e.g. 120 for UTC+2, -300 for UTC-5)
  ;;;
  ;;; A plain :copy value: build one with (DateTime y mo d h mi s ms offset),
  ;;; read a field with (.year dt).  datetime->ms turns it back into an
  ;;; instant.
  ;;;
  ;;; Since: stdlib-os-surface P3
  (defstruct DateTime
    :copy
    [year : int
     month : int
     day : int
     hour : int
     minute : int
     second : int
     millis : int
     offset : int])
  ;;; utc-parts -- the UTC calendar fields of an instant.
  ;;;
  ;;; Pure arithmetic: no time-zone lookup.  Spelled time/utc-parts under a
  ;;; plain (import time).
  ;;;
  ;;; Parameters:
  ;;;   ms -- milliseconds since the Unix epoch, as now-ms answers them
  ;;;         (negative for instants before 1970)
  ;;;
  ;;; Returns:
  ;;;   A DateTime with offset 0.
  ;;;
  ;;; Example:
  ;;;   (.year (time/utc-parts 0))  ; => 1970
  ;;;
  ;;; Since: stdlib-os-surface P3
  (defn utc-parts [ms : int] : DateTime
    ```c
    int64_t f[7];
    __tur_utc_fields(ms, f);
    DateTime dt;
    dt.year = f[0]; dt.month = f[1]; dt.day = f[2];
    dt.hour = f[3]; dt.minute = f[4]; dt.second = f[5]; dt.millis = f[6];
    dt.offset = 0;
    return dt;
    ```)
  ;;; local-parts -- the local-time calendar fields of an instant.
  ;;;
  ;;; Uses the process's time zone (TZ, else the system's; re-read on every
  ;;; call) through localtime_r -- localtime_s on Windows -- including
  ;;; daylight saving in force at that instant.  When the platform cannot convert the instant
  ;;; (Windows refuses times before 1970) the answer is utc-parts's.
  ;;; Spelled time/local-parts under a plain (import time).
  ;;;
  ;;; Parameters:
  ;;;   ms -- milliseconds since the Unix epoch
  ;;;
  ;;; Returns:
  ;;;   A DateTime whose offset is the zone's offset from UTC at ms, in
  ;;;   minutes east (so datetime->ms gives ms back).
  ;;;
  ;;; Example:
  ;;;   (.offset (time/local-parts (time/now-ms)))  ; => 120 in UTC+2
  ;;;
  ;;; Since: stdlib-os-surface P3
  (defn local-parts [ms : int]
    #fx{IO}
    : DateTime
    ```c
    int64_t f[7];
    int64_t secs = __tur_floor_div(ms, 1000);
    time_t t = (time_t)secs;
    struct tm tm;
    DateTime dt;
    /* tzset first: localtime_r need not re-read TZ, so without it a zone set
     * at run time (env/set "TZ" ...) would be ignored after the first call. */
  #ifdef _WIN32
    _tzset();
    int ok = localtime_s(&tm, &t) == 0;
  #else
    tzset();
    int ok = localtime_r(&t, &tm) != NULL;
  #endif
    if (!ok) {
      __tur_utc_fields(ms, f);
      dt.year = f[0]; dt.month = f[1]; dt.day = f[2];
      dt.hour = f[3]; dt.minute = f[4]; dt.second = f[5]; dt.millis = f[6];
      dt.offset = 0;
      return dt;
    }
    dt.year = (int64_t)tm.tm_year + 1900;
    dt.month = tm.tm_mon + 1;
    dt.day = tm.tm_mday;
    dt.hour = tm.tm_hour;
    dt.minute = tm.tm_min;
    dt.second = tm.tm_sec;
    dt.millis = ms - secs * 1000;
    /* The offset without tm_gmtoff (absent on Windows): the local fields read
     * as if they were UTC, minus the instant itself. */
    int64_t as_utc = __tur_days_from_civil(dt.year, dt.month, dt.day) * 86400
                     + dt.hour * 3600 + dt.minute * 60 + dt.second;
    dt.offset = __tur_floor_div(as_utc - secs, 60);
    return dt;
    ```)
  ;;; days-from-civil -- days since 1970-01-01 of a calendar date (internal).
  (defn days-from-civil [y : int m : int d : int] : int
    ```c
    return __tur_days_from_civil(y, m, d);
    ```)
  ;;; datetime->ms -- the instant a DateTime names, in epoch milliseconds.
  ;;;
  ;;; The inverse of utc-parts and local-parts: the fields are read in the
  ;;; DateTime's own offset.  Out-of-range fields are not rejected; they
  ;;; carry (minute 90 is an hour and a half).  Spelled time/datetime->ms
  ;;; under a plain (import time).
  ;;;
  ;;; Parameters:
  ;;;   dt -- the DateTime
  ;;;
  ;;; Returns:
  ;;;   Milliseconds since the Unix epoch.
  ;;;
  ;;; Example:
  ;;;   (time/datetime->ms (DateTime 1970 1 2 0 0 0 0 0))  ; => 86400000
  ;;;
  ;;; Since: stdlib-os-surface P3
  (defn datetime->ms [dt : DateTime] : int
    (+ (* (days-from-civil (.year dt) (.month dt) (.day dt)) 86400000)
      (* (.hour dt) 3600000)
      (* (- (.minute dt) (.offset dt)) 60000)
      (* (.second dt) 1000)
      (.millis dt)))
  ;;; format-iso8601 -- an ISO 8601 / RFC 3339 timestamp for a DateTime.
  ;;;
  ;;; YYYY-MM-DDTHH:MM:SS, then .mmm when millis is not 0, then Z for offset 0
  ;;; or +HH:MM / -HH:MM.  A year outside 0-9999 is written in the expanded
  ;;; form, signed and at least six digits (+010000-01-01T...).
  ;;; parse-iso8601 reads every string this writes.
  ;;;
  ;;; Parameters:
  ;;;   dt -- the DateTime
  ;;;
  ;;; Returns:
  ;;;   A fresh heap cstr the caller owns (release with free).
  ;;;
  ;;; Example:
  ;;;   (time/format-iso8601 (time/utc-parts 1500))  ; => "1970-01-01T00:00:01.500Z"
  ;;;
  ;;; Since: stdlib-os-surface P3
  (defn format-iso8601 [dt : DateTime] : cstr
    ```c
    char *out = (char *)malloc(80);
    if (!out) return NULL;
    int n;
    if (dt.year >= 0 && dt.year <= 9999)
      n = snprintf(out, 80, "%04lld", (long long)dt.year);
    else
      n = snprintf(out, 80, "%+07lld", (long long)dt.year);
    n += snprintf(out + n, 80 - n, "-%02lld-%02lldT%02lld:%02lld:%02lld",
                  (long long)dt.month, (long long)dt.day, (long long)dt.hour,
                  (long long)dt.minute, (long long)dt.second);
    if (dt.millis != 0) n += snprintf(out + n, 80 - n, ".%03lld", (long long)dt.millis);
    if (dt.offset == 0) {
      snprintf(out + n, 80 - n, "Z");
    } else {
      long long off = dt.offset < 0 ? -(long long)dt.offset : (long long)dt.offset;
      snprintf(out + n, 80 - n, "%c%02lld:%02lld", dt.offset < 0 ? '-' : '+', off / 60, off % 60);
    }
    return out;
    ```)
  ;;; parse-iso8601-raw -- the parse, with month 0 for a rejected string (internal).
  (defn parse-iso8601-raw [s : cstr] : DateTime
    ```c
    DateTime dt;
    memset(&dt, 0, sizeof dt);
    DateTime bad = dt;                 /* month 0: rejected */
    const char *p = s;
    if (!p) return bad;
    int64_t v, sign = 1;
    /* year: four digits, or a sign and four or more (the expanded form) */
    if (*p == '+' || *p == '-') {
      sign = *p == '-' ? -1 : 1;
      p++;
      if (!__tur_parse_digits(&p, 4, 12, &v)) return bad;
    } else if (!__tur_parse_digits(&p, 4, 4, &v)) {
      return bad;
    }
    dt.year = sign * v;
    if (*p++ != '-' || !__tur_parse_digits(&p, 2, 2, &dt.month)) return bad;
    if (*p++ != '-' || !__tur_parse_digits(&p, 2, 2, &dt.day)) return bad;
    if (dt.month < 1 || dt.month > 12) return bad;
    if (dt.day < 1 || dt.day > __tur_days_in_month(dt.year, dt.month)) return bad;
    if (*p == '\0') return dt;        /* a date alone: midnight UTC */
    if (*p != 'T' && *p != 't' && *p != ' ') return bad;
    p++;
    if (!__tur_parse_digits(&p, 2, 2, &dt.hour)) return bad;
    if (*p++ != ':' || !__tur_parse_digits(&p, 2, 2, &dt.minute)) return bad;
    if (*p == ':') {
      p++;
      if (!__tur_parse_digits(&p, 2, 2, &dt.second)) return bad;
      if (*p == '.' || *p == ',') {
        p++;
        int64_t frac;
        int nd = __tur_parse_digits(&p, 1, 3, &frac);
        if (!nd) return bad;
        while (nd < 3) { frac *= 10; nd++; }
        dt.millis = frac;
        while (*p >= '0' && *p <= '9') p++;   /* finer than a millisecond: dropped */
      }
    }
    if (dt.hour > 23 || dt.minute > 59 || dt.second > 60) return bad;
    if (*p == 'Z' || *p == 'z') {
      p++;
    } else if (*p == '+' || *p == '-') {
      int64_t osign = *p == '-' ? -1 : 1, oh, om = 0;
      p++;
      if (!__tur_parse_digits(&p, 2, 2, &oh)) return bad;
      if (*p == ':') p++;
      if (*p >= '0' && *p <= '9' && !__tur_parse_digits(&p, 2, 2, &om)) return bad;
      if (oh > 23 || om > 59) return bad;
      dt.offset = osign * (oh * 60 + om);
    }
    if (*p != '\0') return bad;
    return dt;
    ```)
  ;;; parse-iso8601 -- read an ISO 8601 / RFC 3339 timestamp.
  ;;;
  ;;; Accepts YYYY-MM-DD (midnight UTC), or that followed by T (or t, or a
  ;;; space) and HH:MM, optional :SS, optional .fraction (or ,fraction;
  ;;; digits past milliseconds are dropped), then an optional zone: Z, +HH:MM,
  ;;; +HHMM or +HH (a missing zone is read as UTC).  The year may be the
  ;;; signed expanded form format-iso8601 writes.  Every field is range
  ;;; checked, including the day against its month.
  ;;;
  ;;; Parameters:
  ;;;   s -- the timestamp text
  ;;;
  ;;; Returns:
  ;;;   (Some dt) with the offset the text gave, or None when s is not a
  ;;;   valid timestamp.
  ;;;
  ;;; Example:
  ;;;   (time/parse-iso8601 "2026-10-21T09:30:00+02:00")  ; => (Some dt) with hour 9, offset 120
  ;;;
  ;;; Since: stdlib-os-surface P3
  (defn parse-iso8601 [s : cstr] : (Option DateTime)
    (let [dt (parse-iso8601-raw s)] (if (= (.month dt) 0) (None) (Some dt)))))
