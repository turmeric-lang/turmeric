  r.l1 = (double)a.l3;
  return r;
  #endif
  ```)
;;; Num [F32x4] -- lanewise arithmetic, so {a + b} works.

(definstance Num [F32x4]
  (add [x y] (f32x4-add x y))
  (sub [x y] (f32x4-sub x y))
  (mul [x y] (f32x4-mul x y))
  (div [x y] (f32x4-div x y))
  (neg [x] (f32x4-neg x)))
;;; i64x2-splat -- every lane x.
;;;
;;; Parameters:
;;;   x -- the value
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-splat 7)
;;;
;;; Since: S1

(defn i64x2-splat [x : int]
  #fx{}
  : I64x2
  ```c
  tur_adt_I64x2 r;
  r.l0 = x;
  r.l1 = x;
  return r;
  ```)
;;; i64x2-lane -- lane k of v (0 is the lowest; out of range panics).
;;;
;;; Parameters:
;;;   v -- the vector
;;;   k -- the lane, 0 to 1
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (i64x2-lane (i64x2-splat 7) 0)   ; => 7
;;;
;;; Since: S1

(defn i64x2-lane [v : I64x2 k : int]
  #fx{}
  : int
  ```c
  if (k < 0 || k >= 2) {
    tur_panic("i64x2-lane: lane out of range");
    return 0;
  }
  union { tur_adt_I64x2 s; int64_t a[2]; } u = {v};
  return u.a[k];
  ```)
;;; i64x2-load -- lanes from arr[i] .. arr[i + 1] (out of bounds panics, once).
;;;
;;; The array's element type is the vector's lane type.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (let [a (i64vec-new 8 7)] (i64x2-load a 0))
;;;
;;; Since: S1

(defn i64x2-load [^borrow arr : I64Vec i : int]
  #fx{}
  #reads arr
  : I64x2
  ```c
  static const int64_t tsz[2] = {0};
  struct { int64_t len; int64_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  const int64_t *d = tsz;
  if (i < 0 || i > h->len - 2)
    tur_panic("i64x2-load: index out of bounds");
  else
    d = h->data + i;
  tur_adt_I64x2 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  #endif
  return r;
  ```)
;;; i64x2-store! -- write v's lanes to arr[i] .. arr[i + 1] (out of bounds panics, once).
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element
;;;   v -- the vector
;;;
;;; Example:
;;;   (i64x2-store! a 0 (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-store! [^borrow arr : I64Vec i : int v : I64x2]
  #fx{}
  #writes arr
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  if (i < 0 || i > h->len - 2) {
    tur_panic("i64x2-store!: index out of bounds");
    return;
  }
  int64_t *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  #endif
  ```)
;;; i64x2-load-unchecked -- lanes from arr[i] .. arr[i + 1], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: for a loop that has checked its bounds once.  It can
;;; not panic, so a call to it carries no panic check and no call site:
;;; in a tight loop the checked `-load` costs up to 3x (clang).  The
;;; interpreter checks the index anyway.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 2 <= len
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (unsafe (i64x2-load-unchecked a 0))
;;;
;;; Since: S1

(defn i64x2-load-unchecked [^borrow arr : I64Vec i : int]
  #fx{Unsafe}
  #reads arr
  : I64x2
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  const int64_t *d = h->data + i;
  tur_adt_I64x2 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  #endif
  return r;
  ```)
;;; i64x2-store-unchecked! -- write v's lanes to arr[i] .. arr[i + 1], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`, as `-load-unchecked`.  Stores numbers: no
;;; TUR_REGION_NOTE.
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 2 <= len
;;;   v -- the vector
;;;
;;; Example:
;;;   (unsafe (i64x2-store-unchecked! a 0 (i64x2-splat 3)))
;;;
;;; Since: S1

(defn i64x2-store-unchecked! [^borrow arr : I64Vec i : int v : I64x2]
  #fx{Unsafe}
  #writes arr
  : nil
  ```c
  struct { int64_t len; int64_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  int64_t *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  #endif
  ```)
;;; i64x2-add -- lanewise a + b.
;;;
;;; Integer lanes wrap.  Floats: one IEEE add per lane, as the scalar `+`.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-add (i64x2-splat 7) (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-add [a : I64x2 b : I64x2]
  #fx{}
  : I64x2
  ```c
  #if !defined(__MIRC__)
  typedef uint64_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I64x2 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v + ub.v;
  return ur.s;
  #else
  tur_adt_I64x2 r;
  r.l0 = (int64_t)((uint64_t)a.l0 + (uint64_t)b.l0);
  r.l1 = (int64_t)((uint64_t)a.l1 + (uint64_t)b.l1);
  return r;
  #endif
  ```)
;;; i64x2-sub -- lanewise a - b.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-sub (i64x2-splat 7) (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-sub [a : I64x2 b : I64x2]
  #fx{}
  : I64x2
  ```c
  #if !defined(__MIRC__)
  typedef uint64_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I64x2 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v - ub.v;
  return ur.s;
  #else
  tur_adt_I64x2 r;
  r.l0 = (int64_t)((uint64_t)a.l0 - (uint64_t)b.l0);
  r.l1 = (int64_t)((uint64_t)a.l1 - (uint64_t)b.l1);
  return r;
  #endif
  ```)
;;; i64x2-mul -- lanewise a * b.
;;;
;;; Integer lanes wrap: a U8x16 product is taken modulo 256, lane by lane --
;;; widen first (u8x16-widen-lo / -hi) for the full product.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-mul (i64x2-splat 7) (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-mul [a : I64x2 b : I64x2]
  #fx{}
  : I64x2
  ```c
  #if !defined(__MIRC__)
  typedef uint64_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I64x2 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v * ub.v;
  return ur.s;
  #else
  tur_adt_I64x2 r;
  r.l0 = (int64_t)((uint64_t)a.l0 * (uint64_t)b.l0);
  r.l1 = (int64_t)((uint64_t)a.l1 * (uint64_t)b.l1);
  return r;
  #endif
  ```)
;;; i64x2-div -- lanewise a / b.
;;;
;;; An integer lane divided by zero panics; MIN / -1 wraps to MIN.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-div (i64x2-splat 7) (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-div [a : I64x2 b : I64x2]
  #fx{}
  : I64x2
  ```c
  tur_adt_I64x2 r;
  if (b.l0 == 0) {
    tur_panic("i64x2-div: division by zero");
    return a;
  }
  r.l0 = b.l0 == -1 ? (int64_t)(0 - (uint64_t)a.l0) : a.l0 / b.l0;
  if (b.l1 == 0) {
    tur_panic("i64x2-div: division by zero");
    return a;
  }
  r.l1 = b.l1 == -1 ? (int64_t)(0 - (uint64_t)a.l1) : a.l1 / b.l1;
  return r;
  ```)
;;; i64x2-neg -- lanewise -a.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-neg (i64x2-splat 7))
;;;
;;; Since: S1

(defn i64x2-neg [a : I64x2]
  #fx{}
  : I64x2
  ```c
  #if !defined(__MIRC__)
  typedef uint64_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I64x2 s; tsu v; } ua = {a}, ur;
  ur.v = -ua.v;
  return ur.s;
  #else
  tur_adt_I64x2 r;
  r.l0 = (int64_t)(0 - (uint64_t)a.l0);
  r.l1 = (int64_t)(0 - (uint64_t)a.l1);
  return r;
  #endif
  ```)
;;; i64x2-min -- lanewise minimum: lane k is b[k] < a[k] ? b[k] : a[k].
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-min (i64x2-splat 7) (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-min [a : I64x2 b : I64x2]
  #fx{}
  : I64x2
  ```c
  tur_adt_I64x2 r;
  r.l0 = b.l0 < a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 < a.l1 ? b.l1 : a.l1;
  return r;
  ```)
;;; i64x2-max -- lanewise maximum: lane k is b[k] > a[k] ? b[k] : a[k].
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-max (i64x2-splat 7) (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-max [a : I64x2 b : I64x2]
  #fx{}
  : I64x2
  ```c
  tur_adt_I64x2 r;
  r.l0 = b.l0 > a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 > a.l1 ? b.l1 : a.l1;
  return r;
  ```)
;;; i64x2-hsum -- the sum of the lanes.
;;;
;;; Floats add in one fixed tree -- (0 + 1) for two lanes, ((0 + 1) + (2 + 3))
;;; for four -- the same on every engine.  Integer lanes are widened to int and
;;; the sum wraps modulo 2^64.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (i64x2-hsum (i64x2-splat 3))
;;;
;;; Since: S1

(defn i64x2-hsum [a : I64x2]
  #fx{}
  : int
  ```c
  return (int64_t)((uint64_t)(int64_t)a.l0 + (uint64_t)(int64_t)a.l1);
  ```)
;;; i64x2-eq -- lanewise a == b: -1 where it holds, 0 where not.
;;;
;;; Floats compare as IEEE: a NaN lane is unequal to everything and never less
;;; or greater.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A M64x2.
;;;
;;; Example:
;;;   (i64x2-eq (i64x2-splat 3) (i64x2-splat 7))
;;;
;;; Since: S1

(defn i64x2-eq [a : I64x2 b : I64x2]
  #fx{}
  : M64x2
  ```c
  #if !defined(__MIRC__)
  typedef int64_t tsv __attribute__((vector_size(16)));
  typedef int64_t tsm __attribute__((vector_size(16)));
  union { tur_adt_I64x2 s; tsv v; } ua = {a}, ub = {b};
  union { tur_adt_M64x2 s; tsm v; } ur;
  ur.v = (tsm)(ua.v == ub.v);
  return ur.s;
  #else
  tur_adt_M64x2 r;
  r.l0 = a.l0 == b.l0 ? -1 : 0;
  r.l1 = a.l1 == b.l1 ? -1 : 0;
  return r;
  #endif
  ```)
;;; i64x2-lt -- lanewise a < b: -1 where it holds, 0 where not.
