  #fx{Unsafe}
  #reads arr
  : F64x2
  ```c
  struct { int64_t len; double *data; void *raw; } *h = (void*)(intptr_t)arr;
  const double *d = h->data + i;
  tur_adt_F64x2 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  #endif
  return r;
  ```)
;;; f64x2-store-unchecked! -- write v's lanes to arr[i] .. arr[i + 1], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`, as `-load-unchecked`.  Stores numbers: no
;;; TUR_REGION_NOTE.
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 2 <= len
;;;   v -- the vector
;;;
;;; Example:
;;;   (unsafe (f64x2-store-unchecked! a 0 (f64x2-splat 3.25)))
;;;
;;; Since: S1

(defn f64x2-store-unchecked! [^borrow arr : F64Vec i : int v : F64x2]
  #fx{Unsafe}
  #writes arr
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *h = (void*)(intptr_t)arr;
  double *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  #endif
  ```)
;;; f64x2-add -- lanewise a + b.
;;;
;;; Integer lanes wrap.  Floats: one IEEE add per lane, as the scalar `+`.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-add (f64x2-splat 7.1) (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-add [a : F64x2 b : F64x2]
  #fx{}
  : F64x2
  ```c
  #if !defined(__MIRC__)
  typedef double tsv __attribute__((vector_size(16)));
  union { tur_adt_F64x2 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v + ub.v;
  return ur.s;
  #else
  tur_adt_F64x2 r;
  r.l0 = a.l0 + b.l0;
  r.l1 = a.l1 + b.l1;
  return r;
  #endif
  ```)
;;; f64x2-sub -- lanewise a - b.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-sub (f64x2-splat 7.1) (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-sub [a : F64x2 b : F64x2]
  #fx{}
  : F64x2
  ```c
  #if !defined(__MIRC__)
  typedef double tsv __attribute__((vector_size(16)));
  union { tur_adt_F64x2 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v - ub.v;
  return ur.s;
  #else
  tur_adt_F64x2 r;
  r.l0 = a.l0 - b.l0;
  r.l1 = a.l1 - b.l1;
  return r;
  #endif
  ```)
;;; f64x2-mul -- lanewise a * b.
;;;
;;; Integer lanes wrap: a U8x16 product is taken modulo 256, lane by lane --
;;; widen first (u8x16-widen-lo / -hi) for the full product.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-mul (f64x2-splat 7.1) (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-mul [a : F64x2 b : F64x2]
  #fx{}
  : F64x2
  ```c
  #if !defined(__MIRC__)
  typedef double tsv __attribute__((vector_size(16)));
  union { tur_adt_F64x2 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v * ub.v;
  return ur.s;
  #else
  tur_adt_F64x2 r;
  r.l0 = a.l0 * b.l0;
  r.l1 = a.l1 * b.l1;
  return r;
  #endif
  ```)
;;; f64x2-div -- lanewise a / b.
;;;
;;; An integer lane divided by zero panics; MIN / -1 wraps to MIN.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-div (f64x2-splat 7.1) (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-div [a : F64x2 b : F64x2]
  #fx{}
  : F64x2
  ```c
  #if !defined(__MIRC__)
  typedef double tsv __attribute__((vector_size(16)));
  union { tur_adt_F64x2 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v / ub.v;
  return ur.s;
  #else
  tur_adt_F64x2 r;
  r.l0 = a.l0 / b.l0;
  r.l1 = a.l1 / b.l1;
  return r;
  #endif
  ```)
;;; f64x2-neg -- lanewise -a.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-neg (f64x2-splat 7.1))
;;;
;;; Since: S1

(defn f64x2-neg [a : F64x2]
  #fx{}
  : F64x2
  ```c
  #if !defined(__MIRC__)
  typedef double tsv __attribute__((vector_size(16)));
  union { tur_adt_F64x2 s; tsv v; } ua = {a}, ur;
  ur.v = -ua.v;
  return ur.s;
  #else
  tur_adt_F64x2 r;
  r.l0 = -a.l0;
  r.l1 = -a.l1;
  return r;
  #endif
  ```)
;;; f64x2-min -- lanewise minimum: lane k is b[k] < a[k] ? b[k] : a[k].
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-min (f64x2-splat 7.1) (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-min [a : F64x2 b : F64x2]
  #fx{}
  : F64x2
  ```c
  tur_adt_F64x2 r;
  r.l0 = b.l0 < a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 < a.l1 ? b.l1 : a.l1;
  return r;
  ```)
;;; f64x2-max -- lanewise maximum: lane k is b[k] > a[k] ? b[k] : a[k].
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-max (f64x2-splat 7.1) (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-max [a : F64x2 b : F64x2]
  #fx{}
  : F64x2
  ```c
  tur_adt_F64x2 r;
  r.l0 = b.l0 > a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 > a.l1 ? b.l1 : a.l1;
  return r;
  ```)
;;; f64x2-sqrt -- lanewise square root.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-sqrt (f64x2-splat 7.1))
;;;
;;; Since: S1

(defn f64x2-sqrt [a : F64x2]
  #fx{}
  : F64x2
  ```c
  /* __tur_include__: #include <math.h> */
  #if !defined(__MIRC__)
  tur_adt_F64x2 r;
  r.l0 = __builtin_sqrt(a.l0);
  r.l1 = __builtin_sqrt(a.l1);
  return r;
  #else
  tur_adt_F64x2 r;
  r.l0 = sqrt(a.l0);
  r.l1 = sqrt(a.l1);
  return r;
  #endif
  ```)
;;; f64x2-abs -- lanewise absolute value.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-abs (f64x2-splat -1.5))
;;;
;;; Since: S1

(defn f64x2-abs [a : F64x2]
  #fx{}
  : F64x2
  ```c
  /* __tur_include__: #include <math.h> */
  #if !defined(__MIRC__)
  tur_adt_F64x2 r;
  r.l0 = __builtin_fabs(a.l0);
  r.l1 = __builtin_fabs(a.l1);
  return r;
  #else
  tur_adt_F64x2 r;
  r.l0 = fabs(a.l0);
  r.l1 = fabs(a.l1);
  return r;
  #endif
  ```)
;;; f64x2-hsum -- the sum of the lanes.
;;;
;;; Floats add in one fixed tree -- (0 + 1) for two lanes, ((0 + 1) + (2 + 3))
;;; for four -- the same on every engine.  Integer lanes are widened to int and
;;; the sum wraps modulo 2^64.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (f64x2-hsum (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-hsum [a : F64x2]
  #fx{}
  : float
  ```c
  return a.l0 + a.l1;
  ```)
;;; f64x2-eq -- lanewise a == b: -1 where it holds, 0 where not.
;;;
;;; Floats compare as IEEE: a NaN lane is unequal to everything and never less
;;; or greater.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A M64x2.
;;;
;;; Example:
;;;   (f64x2-eq (f64x2-splat 3.25) (f64x2-splat 7.1))
;;;
;;; Since: S1

(defn f64x2-eq [a : F64x2 b : F64x2]
  #fx{}
  : M64x2
  ```c
  #if !defined(__MIRC__)
  typedef double tsv __attribute__((vector_size(16)));
  typedef int64_t tsm __attribute__((vector_size(16)));
  union { tur_adt_F64x2 s; tsv v; } ua = {a}, ub = {b};
  union { tur_adt_M64x2 s; tsm v; } ur;
  ur.v = (tsm)(ua.v == ub.v);
  return ur.s;
  #else
  tur_adt_M64x2 r;
  r.l0 = a.l0 == b.l0 ? -1 : 0;
  r.l1 = a.l1 == b.l1 ? -1 : 0;
  return r;
  #endif
  ```)
