;;; f64x2-select -- lane k is a[k] where m's lane k is set (nonzero), else b[k].
;;;
;;; Branch-free: both a and b are computed.  Lanewise min of a and b is
;;; `(P-select (P-lt a b) a b)`, as `P-min` is.
;;;
;;; Parameters:
;;;   m -- the mask, from a comparison
;;;   a -- the lanes taken where m is set
;;;   b -- the lanes taken where it is not
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-select (f64x2-lt (f64x2-splat 3.25) (f64x2-splat 7.1)) (f64x2-splat 3.25) (f64x2-splat 7.1))
;;;
;;; Since: S1

(defn f64x2-select [m : M64x2 a : F64x2 b : F64x2]
  #fx{}
  : F64x2
  ```c
  #if !defined(__MIRC__)
  typedef int64_t tsm __attribute__((vector_size(16)));
  union { tur_adt_M64x2 s; tsm v; } um = {m};
  union { tur_adt_F64x2 s; tsm v; } ua = {a}, ub = {b}, ur;
  tsm mm = (tsm)(um.v != 0);
  ur.v = (ua.v & mm) | (ub.v & ~mm);
  return ur.s;
  #else
  tur_adt_F64x2 r;
  r.l0 = m.l0 ? a.l0 : b.l0;
  r.l1 = m.l1 ? a.l1 : b.l1;
  return r;
  #endif
  ```)
;;; f64x2-shuffle -- lane k is v's lane idx[k] mod 2.
;;;
;;; Constant indices compile to one shuffle instruction (gcc and clang); an
;;; index outside 0 to 1 wraps, so there is no out-of-range case.
;;;
;;; Parameters:
;;;   v -- the vector
;;;   idx -- which lane of v each result lane takes
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-shuffle (f64x2-splat 7.1) (I64x2 1 0))   ; lanes reversed
;;;
;;; Since: S1

(defn f64x2-shuffle [v : F64x2 idx : I64x2]
  #fx{}
  : F64x2
  ```c
  union { tur_adt_F64x2 s; double a[2]; } u = {v};
  tur_adt_F64x2 r;
  r.l0 = u.a[idx.l0 & 1];
  r.l1 = u.a[idx.l1 & 1];
  return r;
  ```)
;;; f64x2-narrow -- lo's lanes then hi's, each rounded to float32.
;;;
;;; Rounds to nearest; a lane beyond float32's range becomes an infinity.
;;;
;;; Parameters:
;;;   lo -- lanes 0-1 of the result
;;;   hi -- lanes 2-3
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f64x2-narrow (f64x2-splat 7.1) (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-narrow [lo : F64x2 hi : F64x2]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef double tsd __attribute__((vector_size(16)));
  typedef float tsh __attribute__((vector_size(8)));
  typedef float tsf __attribute__((vector_size(16)));
  union { tur_adt_F64x2 s; tsd v; } ul = {lo}, uh = {hi};
  union { tur_adt_F32x4 s; tsf v; } ur;
  tsh nl = __builtin_convertvector(ul.v, tsh), nh = __builtin_convertvector(uh.v, tsh);
  ur.v = __builtin_shufflevector(nl, nh, 0, 1, 2, 3);
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = (float)lo.l0;
  r.l1 = (float)lo.l1;
  r.l2 = (float)hi.l0;
  r.l3 = (float)hi.l1;
  return r;
  #endif
  ```)
;;; Num [F64x2] -- lanewise arithmetic, so {a + b} works.

(definstance Num [F64x2]
  (add [x y] (f64x2-add x y))
  (sub [x y] (f64x2-sub x y))
  (mul [x y] (f64x2-mul x y))
  (div [x y] (f64x2-div x y))
  (neg [x] (f64x2-neg x)))
;;; f32x4-splat -- every lane x.
;;;
;;; Parameters:
;;;   x -- the value
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-splat (as float32 7.1))
;;;
;;; Since: S1

(defn f32x4-splat [x : float32]
  #fx{}
  : F32x4
  ```c
  tur_adt_F32x4 r;
  r.l0 = x;
  r.l1 = x;
  r.l2 = x;
  r.l3 = x;
  return r;
  ```)
;;; f32x4-lane -- lane k of v (0 is the lowest; out of range panics).
;;;
;;; Parameters:
;;;   v -- the vector
;;;   k -- the lane, 0 to 3
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (f32x4-lane (f32x4-splat (as float32 7.1)) 0)   ; => (as float32 7.1)
;;;
;;; Since: S1

(defn f32x4-lane [v : F32x4 k : int]
  #fx{}
  : float32
  ```c
  if (k < 0 || k >= 4) {
    tur_panic("f32x4-lane: lane out of range");
    return 0;
  }
  union { tur_adt_F32x4 s; float a[4]; } u = {v};
  return u.a[k];
  ```)
;;; f32x4-load -- lanes from arr[i] .. arr[i + 3] (out of bounds panics, once).
;;;
;;; The array's element type is the vector's lane type.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (let [a (f32vec-new 8 (as float32 7.1))] (f32x4-load a 0))
;;;
;;; Since: S1

(defn f32x4-load [^borrow arr : F32Vec i : int]
  #fx{}
  #reads arr
  : F32x4
  ```c
  static const float tsz[4] = {0};
  struct { int64_t len; float *data; void *raw; } *h = (void*)(intptr_t)arr;
  const float *d = tsz;
  if (i < 0 || i > h->len - 4)
    tur_panic("f32x4-load: index out of bounds");
  else
    d = h->data + i;
  tur_adt_F32x4 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  #endif
  return r;
  ```)
;;; f32x4-store! -- write v's lanes to arr[i] .. arr[i + 3] (out of bounds panics, once).
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element
;;;   v -- the vector
;;;
;;; Example:
;;;   (f32x4-store! a 0 (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-store! [^borrow arr : F32Vec i : int v : F32x4]
  #fx{}
  #writes arr
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *h = (void*)(intptr_t)arr;
  if (i < 0 || i > h->len - 4) {
    tur_panic("f32x4-store!: index out of bounds");
    return;
  }
  float *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  d[2] = v.l2;
  d[3] = v.l3;
  #endif
  ```)
;;; f32x4-load-unchecked -- lanes from arr[i] .. arr[i + 3], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: for a loop that has checked its bounds once.  It can
;;; not panic, so a call to it carries no panic check and no call site:
;;; in a tight loop the checked `-load` costs up to 3x (clang).  The
;;; interpreter checks the index anyway.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 4 <= len
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (unsafe (f32x4-load-unchecked a 0))
;;;
;;; Since: S1

(defn f32x4-load-unchecked [^borrow arr : F32Vec i : int]
  #fx{Unsafe}
  #reads arr
  : F32x4
  ```c
  struct { int64_t len; float *data; void *raw; } *h = (void*)(intptr_t)arr;
  const float *d = h->data + i;
  tur_adt_F32x4 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  #endif
  return r;
  ```)
;;; f32x4-store-unchecked! -- write v's lanes to arr[i] .. arr[i + 3], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`, as `-load-unchecked`.  Stores numbers: no
;;; TUR_REGION_NOTE.
