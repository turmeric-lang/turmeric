;;; i64x2-select -- lane k is a[k] where m's lane k is set (nonzero), else b[k].
;;;
;;; Branch-free: both a and b are computed.  Lanewise min of a and b is
;;; `(P-select (P-lt a b) a b)`, as `P-min` is.
;;;
;;; Parameters:
;;;   m -- the mask, from a comparison
;;;   a -- the lanes taken where m is set
;;;   b -- the lanes taken where it is not
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-select (i64x2-lt (i64x2-splat 3) (i64x2-splat 7)) (i64x2-splat 3) (i64x2-splat 7))
;;;
;;; Since: S1

(defn i64x2-select [m : M64x2 a : I64x2 b : I64x2]
  #fx{}
  : I64x2
  ```c
  #if !defined(__MIRC__)
  typedef int64_t tsm __attribute__((vector_size(16)));
  union { tur_adt_M64x2 s; tsm v; } um = {m};
  union { tur_adt_I64x2 s; tsm v; } ua = {a}, ub = {b}, ur;
  tsm mm = (tsm)(um.v != 0);
  ur.v = (ua.v & mm) | (ub.v & ~mm);
  return ur.s;
  #else
  tur_adt_I64x2 r;
  r.l0 = m.l0 ? a.l0 : b.l0;
  r.l1 = m.l1 ? a.l1 : b.l1;
  return r;
  #endif
  ```)
;;; i64x2-shuffle -- lane k is v's lane idx[k] mod 2.
;;;
;;; Constant indices compile to one shuffle instruction (gcc and clang); an
;;; index outside 0 to 1 wraps, so there is no out-of-range case.
;;;
;;; Parameters:
;;;   v -- the vector
;;;   idx -- which lane of v each result lane takes
;;;
;;; Returns:
;;;   A I64x2.
;;;
;;; Example:
;;;   (i64x2-shuffle (i64x2-splat 7) (I64x2 1 0))   ; lanes reversed
;;;
;;; Since: S1

(defn i64x2-shuffle [v : I64x2 idx : I64x2]
  #fx{}
  : I64x2
  ```c
  union { tur_adt_I64x2 s; int64_t a[2]; } u = {v};
  tur_adt_I64x2 r;
  r.l0 = u.a[idx.l0 & 1];
  r.l1 = u.a[idx.l1 & 1];
  return r;
  ```)
;;; Num [I64x2] -- lanewise arithmetic, so {a + b} works.

(definstance Num [I64x2]
  (add [x y] (i64x2-add x y))
  (sub [x y] (i64x2-sub x y))
  (mul [x y] (i64x2-mul x y))
  (div [x y] (i64x2-div x y))
  (neg [x] (i64x2-neg x)))
;;; i32x4-splat -- every lane x.
;;;
;;; Parameters:
;;;   x -- the value
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-splat (as int32 7))
;;;
;;; Since: S1

(defn i32x4-splat [x : int32]
  #fx{}
  : I32x4
  ```c
  tur_adt_I32x4 r;
  r.l0 = x;
  r.l1 = x;
  r.l2 = x;
  r.l3 = x;
  return r;
  ```)
;;; i32x4-lane -- lane k of v (0 is the lowest; out of range panics).
;;;
;;; Parameters:
;;;   v -- the vector
;;;   k -- the lane, 0 to 3
;;;
;;; Returns:
;;;   A int32.
;;;
;;; Example:
;;;   (i32x4-lane (i32x4-splat (as int32 7)) 0)   ; => (as int32 7)
;;;
;;; Since: S1

(defn i32x4-lane [v : I32x4 k : int]
  #fx{}
  : int32
  ```c
  if (k < 0 || k >= 4) {
    tur_panic("i32x4-lane: lane out of range");
    return 0;
  }
  union { tur_adt_I32x4 s; int32_t a[4]; } u = {v};
  return u.a[k];
  ```)
;;; i32x4-load -- lanes from arr[i] .. arr[i + 3] (out of bounds panics, once).
;;;
;;; The array's element type is the vector's lane type.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (let [a (i32vec-new 8 (as int32 7))] (i32x4-load a 0))
;;;
;;; Since: S1

(defn i32x4-load [^borrow arr : I32Vec i : int]
  #fx{}
  #reads arr
  : I32x4
  ```c
  static const int32_t tsz[4] = {0};
  struct { int64_t len; int32_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  const int32_t *d = tsz;
  if (i < 0 || i > h->len - 4)
    tur_panic("i32x4-load: index out of bounds");
  else
    d = h->data + i;
  tur_adt_I32x4 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  #endif
  return r;
  ```)
;;; i32x4-store! -- write v's lanes to arr[i] .. arr[i + 3] (out of bounds panics, once).
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element
;;;   v -- the vector
;;;
;;; Example:
;;;   (i32x4-store! a 0 (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-store! [^borrow arr : I32Vec i : int v : I32x4]
  #fx{}
  #writes arr
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  if (i < 0 || i > h->len - 4) {
    tur_panic("i32x4-store!: index out of bounds");
    return;
  }
  int32_t *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  d[2] = v.l2;
  d[3] = v.l3;
  #endif
  ```)
;;; i32x4-load-unchecked -- lanes from arr[i] .. arr[i + 3], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: for a loop that has checked its bounds once.  It can
;;; not panic, so a call to it carries no panic check and no call site:
;;; in a tight loop the checked `-load` costs up to 3x (clang).  The
;;; interpreter checks the index anyway.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 4 <= len
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (unsafe (i32x4-load-unchecked a 0))
;;;
;;; Since: S1

(defn i32x4-load-unchecked [^borrow arr : I32Vec i : int]
  #fx{Unsafe}
  #reads arr
  : I32x4
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  const int32_t *d = h->data + i;
  tur_adt_I32x4 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  #endif
  return r;
  ```)
;;; i32x4-store-unchecked! -- write v's lanes to arr[i] .. arr[i + 3], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`, as `-load-unchecked`.  Stores numbers: no
;;; TUR_REGION_NOTE.
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 4 <= len
;;;   v -- the vector
;;;
;;; Example:
;;;   (unsafe (i32x4-store-unchecked! a 0 (i32x4-splat (as int32 3))))
;;;
;;; Since: S1

(defn i32x4-store-unchecked! [^borrow arr : I32Vec i : int v : I32x4]
  #fx{Unsafe}
  #writes arr
  : nil
  ```c
  struct { int64_t len; int32_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  int32_t *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  d[2] = v.l2;
  d[3] = v.l3;
  #endif
  ```)
;;; i32x4-add -- lanewise a + b.
;;;
;;; Integer lanes wrap.  Floats: one IEEE add per lane, as the scalar `+`.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-add (i32x4-splat (as int32 7)) (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-add [a : I32x4 b : I32x4]
  #fx{}
  : I32x4
  ```c
  #if !defined(__MIRC__)
  typedef uint32_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I32x4 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v + ub.v;
  return ur.s;
  #else
  tur_adt_I32x4 r;
  r.l0 = (int32_t)((uint32_t)a.l0 + (uint32_t)b.l0);
  r.l1 = (int32_t)((uint32_t)a.l1 + (uint32_t)b.l1);
  r.l2 = (int32_t)((uint32_t)a.l2 + (uint32_t)b.l2);
  r.l3 = (int32_t)((uint32_t)a.l3 + (uint32_t)b.l3);
  return r;
  #endif
  ```)
;;; i32x4-sub -- lanewise a - b.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-sub (i32x4-splat (as int32 7)) (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-sub [a : I32x4 b : I32x4]
  #fx{}
  : I32x4
  ```c
  #if !defined(__MIRC__)
  typedef uint32_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I32x4 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v - ub.v;
  return ur.s;
  #else
  tur_adt_I32x4 r;
  r.l0 = (int32_t)((uint32_t)a.l0 - (uint32_t)b.l0);
  r.l1 = (int32_t)((uint32_t)a.l1 - (uint32_t)b.l1);
  r.l2 = (int32_t)((uint32_t)a.l2 - (uint32_t)b.l2);
  r.l3 = (int32_t)((uint32_t)a.l3 - (uint32_t)b.l3);
  return r;
  #endif
  ```)
;;; i32x4-mul -- lanewise a * b.
;;;
;;; Integer lanes wrap: a U8x16 product is taken modulo 256, lane by lane --
;;; widen first (u8x16-widen-lo / -hi) for the full product.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-mul (i32x4-splat (as int32 7)) (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-mul [a : I32x4 b : I32x4]
  #fx{}
  : I32x4
  ```c
  #if !defined(__MIRC__)
  typedef uint32_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I32x4 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v * ub.v;
  return ur.s;
  #else
  tur_adt_I32x4 r;
  r.l0 = (int32_t)((uint32_t)a.l0 * (uint32_t)b.l0);
  r.l1 = (int32_t)((uint32_t)a.l1 * (uint32_t)b.l1);
  r.l2 = (int32_t)((uint32_t)a.l2 * (uint32_t)b.l2);
  r.l3 = (int32_t)((uint32_t)a.l3 * (uint32_t)b.l3);
  return r;
  #endif
  ```)
;;; i32x4-div -- lanewise a / b.
;;;
;;; An integer lane divided by zero panics; MIN / -1 wraps to MIN.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-div (i32x4-splat (as int32 7)) (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-div [a : I32x4 b : I32x4]
  #fx{}
  : I32x4
  ```c
  tur_adt_I32x4 r;
  if (b.l0 == 0) {
    tur_panic("i32x4-div: division by zero");
    return a;
  }
  r.l0 = b.l0 == -1 ? (int32_t)(0 - (uint32_t)a.l0) : a.l0 / b.l0;
  if (b.l1 == 0) {
    tur_panic("i32x4-div: division by zero");
    return a;
  }
  r.l1 = b.l1 == -1 ? (int32_t)(0 - (uint32_t)a.l1) : a.l1 / b.l1;
  if (b.l2 == 0) {
    tur_panic("i32x4-div: division by zero");
    return a;
  }
  r.l2 = b.l2 == -1 ? (int32_t)(0 - (uint32_t)a.l2) : a.l2 / b.l2;
  if (b.l3 == 0) {
    tur_panic("i32x4-div: division by zero");
    return a;
  }
  r.l3 = b.l3 == -1 ? (int32_t)(0 - (uint32_t)a.l3) : a.l3 / b.l3;
  return r;
  ```)
;;; i32x4-neg -- lanewise -a.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-neg (i32x4-splat (as int32 7)))
;;;
;;; Since: S1

(defn i32x4-neg [a : I32x4]
  #fx{}
  : I32x4
  ```c
  #if !defined(__MIRC__)
  typedef uint32_t tsu __attribute__((vector_size(16)));
  union { tur_adt_I32x4 s; tsu v; } ua = {a}, ur;
  ur.v = -ua.v;
  return ur.s;
  #else
  tur_adt_I32x4 r;
  r.l0 = (int32_t)(0 - (uint32_t)a.l0);
  r.l1 = (int32_t)(0 - (uint32_t)a.l1);
  r.l2 = (int32_t)(0 - (uint32_t)a.l2);
  r.l3 = (int32_t)(0 - (uint32_t)a.l3);
  return r;
  #endif
  ```)
;;; i32x4-min -- lanewise minimum: lane k is b[k] < a[k] ? b[k] : a[k].
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-min (i32x4-splat (as int32 7)) (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-min [a : I32x4 b : I32x4]
  #fx{}
  : I32x4
  ```c
  tur_adt_I32x4 r;
  r.l0 = b.l0 < a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 < a.l1 ? b.l1 : a.l1;
  r.l2 = b.l2 < a.l2 ? b.l2 : a.l2;
  r.l3 = b.l3 < a.l3 ? b.l3 : a.l3;
  return r;
  ```)
;;; i32x4-max -- lanewise maximum: lane k is b[k] > a[k] ? b[k] : a[k].
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-max (i32x4-splat (as int32 7)) (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-max [a : I32x4 b : I32x4]
  #fx{}
  : I32x4
  ```c
  tur_adt_I32x4 r;
  r.l0 = b.l0 > a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 > a.l1 ? b.l1 : a.l1;
  r.l2 = b.l2 > a.l2 ? b.l2 : a.l2;
  r.l3 = b.l3 > a.l3 ? b.l3 : a.l3;
  return r;
  ```)
;;; i32x4-hsum -- the sum of the lanes.
;;;
;;; Floats add in one fixed tree -- (0 + 1) for two lanes, ((0 + 1) + (2 + 3))
;;; for four -- the same on every engine.  Integer lanes are widened to int and
;;; the sum wraps modulo 2^64.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (i32x4-hsum (i32x4-splat (as int32 3)))
;;;
;;; Since: S1

(defn i32x4-hsum [a : I32x4]
  #fx{}
  : int
  ```c
  return (int64_t)((uint64_t)(int64_t)a.l0 + (uint64_t)(int64_t)a.l1 + (uint64_t)(int64_t)a.l2 + (uint64_t)(int64_t)a.l3);
  ```)
;;; i32x4-eq -- lanewise a == b: -1 where it holds, 0 where not.
;;;
;;; Floats compare as IEEE: a NaN lane is unequal to everything and never less
;;; or greater.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A M32x4.
;;;
;;; Example:
;;;   (i32x4-eq (i32x4-splat (as int32 3)) (i32x4-splat (as int32 7)))
;;;
;;; Since: S1

(defn i32x4-eq [a : I32x4 b : I32x4]
  #fx{}
  : M32x4
  ```c
  #if !defined(__MIRC__)
  typedef int32_t tsv __attribute__((vector_size(16)));
  typedef int32_t tsm __attribute__((vector_size(16)));
  union { tur_adt_I32x4 s; tsv v; } ua = {a}, ub = {b};
  union { tur_adt_M32x4 s; tsm v; } ur;
  ur.v = (tsm)(ua.v == ub.v);
  return ur.s;
  #else
  tur_adt_M32x4 r;
  r.l0 = a.l0 == b.l0 ? -1 : 0;
  r.l1 = a.l1 == b.l1 ? -1 : 0;
  r.l2 = a.l2 == b.l2 ? -1 : 0;
  r.l3 = a.l3 == b.l3 ? -1 : 0;
  return r;
  #endif
  ```)
