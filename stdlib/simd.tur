;;; u8x16-div -- lanewise a / b.
;;;
;;; An integer lane divided by zero panics; MIN / -1 wraps to MIN.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-div (u8x16-splat (as uint8 7)) (u8x16-splat (as uint8 3)))
;;;
;;; Since: S1

(defn u8x16-div [a : U8x16 b : U8x16]
  #fx{}
  : U8x16
  ```c
  tur_adt_U8x16 r;
  if (b.l0 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l0 = a.l0 / b.l0;
  if (b.l1 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l1 = a.l1 / b.l1;
  if (b.l2 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l2 = a.l2 / b.l2;
  if (b.l3 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l3 = a.l3 / b.l3;
  if (b.l4 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l4 = a.l4 / b.l4;
  if (b.l5 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l5 = a.l5 / b.l5;
  if (b.l6 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l6 = a.l6 / b.l6;
  if (b.l7 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l7 = a.l7 / b.l7;
  if (b.l8 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l8 = a.l8 / b.l8;
  if (b.l9 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l9 = a.l9 / b.l9;
  if (b.l10 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l10 = a.l10 / b.l10;
  if (b.l11 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l11 = a.l11 / b.l11;
  if (b.l12 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l12 = a.l12 / b.l12;
  if (b.l13 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l13 = a.l13 / b.l13;
  if (b.l14 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l14 = a.l14 / b.l14;
  if (b.l15 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l15 = a.l15 / b.l15;
  return r;
  ```)
