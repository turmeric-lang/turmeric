  r.l0 = b.l0 > a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 > a.l1 ? b.l1 : a.l1;
  r.l2 = b.l2 > a.l2 ? b.l2 : a.l2;
  r.l3 = b.l3 > a.l3 ? b.l3 : a.l3;
  return r;
  ```)
;;; f32x4-sqrt -- lanewise square root.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-sqrt (f32x4-splat (as float32 7.1)))
;;;
;;; Since: S1

(defn f32x4-sqrt [a : F32x4]
  #fx{}
  : F32x4
  ```c
  /* __tur_include__: #include <math.h> */
  #if !defined(__MIRC__)
  tur_adt_F32x4 r;
  r.l0 = __builtin_sqrtf(a.l0);
  r.l1 = __builtin_sqrtf(a.l1);
  r.l2 = __builtin_sqrtf(a.l2);
  r.l3 = __builtin_sqrtf(a.l3);
  return r;
  #else
  tur_adt_F32x4 r;
  r.l0 = sqrtf(a.l0);
  r.l1 = sqrtf(a.l1);
  r.l2 = sqrtf(a.l2);
  r.l3 = sqrtf(a.l3);
  return r;
  #endif
  ```)
;;; f32x4-abs -- lanewise absolute value.
;;;
;;; Parameters:
