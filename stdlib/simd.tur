;;; f32x4-select -- lane k is a[k] where m's lane k is set (nonzero), else b[k].
;;;
;;; Branch-free: both a and b are computed.  Lanewise min of a and b is
;;; `(P-select (P-lt a b) a b)`, as `P-min` is.
;;;
;;; Parameters:
;;;   m -- the mask, from a comparison
;;;   a -- the lanes taken where m is set
;;;   b -- the lanes taken where it is not
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-select (f32x4-lt (f32x4-splat (as float32 3.25)) (f32x4-splat (as float32 7.1))) (f32x4-splat (as float32 3.25)) (f32x4-splat (as float32 7.1)))
;;;
;;; Since: S1

(defn f32x4-select [m : M32x4 a : F32x4 b : F32x4]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef int32_t tsm __attribute__((vector_size(16)));
  union { tur_adt_M32x4 s; tsm v; } um = {m};
  union { tur_adt_F32x4 s; tsm v; } ua = {a}, ub = {b}, ur;
  tsm mm = (tsm)(um.v != 0);
  ur.v = (ua.v & mm) | (ub.v & ~mm);
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = m.l0 ? a.l0 : b.l0;
  r.l1 = m.l1 ? a.l1 : b.l1;
  r.l2 = m.l2 ? a.l2 : b.l2;
  r.l3 = m.l3 ? a.l3 : b.l3;
  return r;
  #endif
  ```)
;;; f32x4-shuffle -- lane k is v's lane idx[k] mod 4.
;;;
;;; Constant indices compile to one shuffle instruction (gcc and clang); an
;;; index outside 0 to 3 wraps, so there is no out-of-range case.
;;;
;;; Parameters:
;;;   v -- the vector
;;;   idx -- which lane of v each result lane takes
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-shuffle (f32x4-splat (as float32 7.1)) (I32x4 (as int32 3) (as int32 2) (as int32 1) (as int32 0)))   ; lanes reversed
;;;
;;; Since: S1

(defn f32x4-shuffle [v : F32x4 idx : I32x4]
  #fx{}
  : F32x4
  ```c
  union { tur_adt_F32x4 s; float a[4]; } u = {v};
  tur_adt_F32x4 r;
  r.l0 = u.a[idx.l0 & 3];
  r.l1 = u.a[idx.l1 & 3];
  r.l2 = u.a[idx.l2 & 3];
  r.l3 = u.a[idx.l3 & 3];
  return r;
  ```)
;;; f32x4->i32x4 -- each lane truncated toward zero to int32, saturating.
;;;
;;; Every lane is defined: NaN gives 0, a lane at or above 2^31 gives
;;; 2147483647, one below -2^31 gives -2147483648.  (A C cast is undefined
;;; there, and cvttps2dq alone gives -2147483648 for all three.)
;;;
;;; Parameters:
;;;   a -- the vector
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (f32x4->i32x4 (f32x4-splat (as float32 7.1)))   ; => lanes of 7
;;;
;;; Since: S1

(defn f32x4->i32x4 [a : F32x4]
  #fx{}
  : I32x4
  ```c
  #if !defined(__MIRC__)
  typedef float tsf __attribute__((vector_size(16)));
  typedef int32_t tsi __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsf v; } ua = {a};
  union { tur_adt_I32x4 s; tsi v; } ur;
  tsf x = ua.v;
  tsi big = (tsi)(x >= 2147483648.0f), small = (tsi)(x < -2147483648.0f);
  tsi bad = (tsi)(x != x) | big | small;
  union { tsf f; tsi i; } c = {x};
  c.i &= ~bad;
  tsi r = __builtin_convertvector(c.f, tsi);
  ur.v = (r & ~bad) | (big & 2147483647) | (small & (-2147483647 - 1));
  return ur.s;
  #else
  tur_adt_I32x4 r;
  r.l0 = a.l0 != a.l0 ? 0 : a.l0 >= 2147483648.0f ? 2147483647 : a.l0 < -2147483648.0f ? (-2147483647 - 1) : (int32_t)a.l0;
  r.l1 = a.l1 != a.l1 ? 0 : a.l1 >= 2147483648.0f ? 2147483647 : a.l1 < -2147483648.0f ? (-2147483647 - 1) : (int32_t)a.l1;
  r.l2 = a.l2 != a.l2 ? 0 : a.l2 >= 2147483648.0f ? 2147483647 : a.l2 < -2147483648.0f ? (-2147483647 - 1) : (int32_t)a.l2;
  r.l3 = a.l3 != a.l3 ? 0 : a.l3 >= 2147483648.0f ? 2147483647 : a.l3 < -2147483648.0f ? (-2147483647 - 1) : (int32_t)a.l3;
  return r;
  #endif
  ```)
;;; f32x4-widen-lo -- lanes 0 and 1 converted to float (exact).
;;;
;;; Parameters:
;;;   a -- the vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f32x4-widen-lo (f32x4-splat (as float32 7.1)))
;;;
;;; Since: S1

(defn f32x4-widen-lo [a : F32x4]
  #fx{}
  : F64x2
  ```c
  #if !defined(__MIRC__)
  typedef float tsf __attribute__((vector_size(16)));
  typedef float tsh __attribute__((vector_size(8)));
  typedef double tsd __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsf v; } ua = {a};
  union { tur_adt_F64x2 s; tsd v; } ur;
  tsh h = __builtin_shufflevector(ua.v, ua.v, 0, 1);
  ur.v = __builtin_convertvector(h, tsd);
  return ur.s;
  #else
  tur_adt_F64x2 r;
  r.l0 = (double)a.l0;
  r.l1 = (double)a.l1;
  return r;
  #endif
  ```)
;;; f32x4-widen-hi -- lanes 2 and 3 converted to float (exact).
;;;
;;; Parameters:
;;;   a -- the vector
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f32x4-widen-hi (f32x4-splat (as float32 7.1)))
;;;
;;; Since: S1

(defn f32x4-widen-hi [a : F32x4]
  #fx{}
  : F64x2
