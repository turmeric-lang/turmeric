;;; u16x8-select -- lane k is a[k] where m's lane k is set (nonzero), else b[k].
;;;
;;; Branch-free: both a and b are computed.  Lanewise min of a and b is
;;; `(P-select (P-lt a b) a b)`, as `P-min` is.
;;;
;;; Parameters:
;;;   m -- the mask, from a comparison
;;;   a -- the lanes taken where m is set
;;;   b -- the lanes taken where it is not
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u16x8-select (u16x8-lt (u16x8-splat (as uint16 3)) (u16x8-splat (as uint16 7))) (u16x8-splat (as uint16 3)) (u16x8-splat (as uint16 7)))
;;;
;;; Since: S1

(defn u16x8-select [m : M16x8 a : U16x8 b : U16x8]
  #fx{}
  : U16x8
  ```c
  #if !defined(__MIRC__)
  typedef int16_t tsm __attribute__((vector_size(16)));
  union { tur_adt_M16x8 s; tsm v; } um = {m};
  union { tur_adt_U16x8 s; tsm v; } ua = {a}, ub = {b}, ur;
  tsm mm = (tsm)(um.v != 0);
  ur.v = (ua.v & mm) | (ub.v & ~mm);
  return ur.s;
  #else
  tur_adt_U16x8 r;
  r.l0 = m.l0 ? a.l0 : b.l0;
  r.l1 = m.l1 ? a.l1 : b.l1;
  r.l2 = m.l2 ? a.l2 : b.l2;
  r.l3 = m.l3 ? a.l3 : b.l3;
  r.l4 = m.l4 ? a.l4 : b.l4;
  r.l5 = m.l5 ? a.l5 : b.l5;
  r.l6 = m.l6 ? a.l6 : b.l6;
  r.l7 = m.l7 ? a.l7 : b.l7;
  return r;
  #endif
  ```)
;;; u16x8-shuffle -- lane k is v's lane idx[k] mod 8.
;;;
;;; Constant indices compile to one shuffle instruction (gcc and clang); an
;;; index outside 0 to 7 wraps, so there is no out-of-range case.
;;;
;;; Parameters:
;;;   v -- the vector
;;;   idx -- which lane of v each result lane takes
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u16x8-shuffle (u16x8-splat (as uint16 7)) (U16x8 (as uint16 7) (as uint16 6) (as uint16 5) (as uint16 4) (as uint16 3) (as uint16 2) (as uint16 1) (as uint16 0)))   ; lanes reversed
;;;
;;; Since: S1

(defn u16x8-shuffle [v : U16x8 idx : U16x8]
  #fx{}
  : U16x8
  ```c
  union { tur_adt_U16x8 s; uint16_t a[8]; } u = {v};
  tur_adt_U16x8 r;
  r.l0 = u.a[idx.l0 & 7];
  r.l1 = u.a[idx.l1 & 7];
  r.l2 = u.a[idx.l2 & 7];
  r.l3 = u.a[idx.l3 & 7];
  r.l4 = u.a[idx.l4 & 7];
  r.l5 = u.a[idx.l5 & 7];
  r.l6 = u.a[idx.l6 & 7];
  r.l7 = u.a[idx.l7 & 7];
  return r;
  ```)
;;; Num [U16x8] -- lanewise arithmetic, so {a + b} works.

(definstance Num [U16x8]
  (add [x y] (u16x8-add x y))
  (sub [x y] (u16x8-sub x y))
  (mul [x y] (u16x8-mul x y))
  (div [x y] (u16x8-div x y))
  (neg [x] (u16x8-neg x)))
;;; u8x16-splat -- every lane x.
;;;
;;; Parameters:
;;;   x -- the value
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-splat (as uint8 7))
;;;
;;; Since: S1

(defn u8x16-splat [x : uint8]
  #fx{}
  : U8x16
  ```c
  tur_adt_U8x16 r;
  r.l0 = x;
  r.l1 = x;
  r.l2 = x;
  r.l3 = x;
  r.l4 = x;
  r.l5 = x;
  r.l6 = x;
  r.l7 = x;
  r.l8 = x;
  r.l9 = x;
  r.l10 = x;
  r.l11 = x;
  r.l12 = x;
  r.l13 = x;
  r.l14 = x;
  r.l15 = x;
  return r;
  ```)
;;; u8x16-lane -- lane k of v (0 is the lowest; out of range panics).
;;;
;;; Parameters:
;;;   v -- the vector
;;;   k -- the lane, 0 to 15
;;;
;;; Returns:
;;;   A uint8.
;;;
;;; Example:
;;;   (u8x16-lane (u8x16-splat (as uint8 7)) 0)   ; => (as uint8 7)
;;;
;;; Since: S1

(defn u8x16-lane [v : U8x16 k : int]
  #fx{}
  : uint8
  ```c
  if (k < 0 || k >= 16) {
    tur_panic("u8x16-lane: lane out of range");
    return 0;
  }
  union { tur_adt_U8x16 s; uint8_t a[16]; } u = {v};
  return u.a[k];
  ```)
;;; u8x16-load -- lanes from arr[i] .. arr[i + 15] (out of bounds panics, once).
;;;
;;; The array's element type is the vector's lane type.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (let [a (u8vec-new 8 (as uint8 7))] (u8x16-load a 0))
;;;
;;; Since: S1

(defn u8x16-load [^borrow arr : U8Vec i : int]
  #fx{}
  #reads arr
  : U8x16
  ```c
  static const uint8_t tsz[16] = {0};
  struct { int64_t len; uint8_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  const uint8_t *d = tsz;
  if (i < 0 || i > h->len - 16)
    tur_panic("u8x16-load: index out of bounds");
  else
    d = h->data + i;
  tur_adt_U8x16 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  r.l4 = d[4];
  r.l5 = d[5];
  r.l6 = d[6];
  r.l7 = d[7];
  r.l8 = d[8];
  r.l9 = d[9];
  r.l10 = d[10];
  r.l11 = d[11];
  r.l12 = d[12];
  r.l13 = d[13];
  r.l14 = d[14];
  r.l15 = d[15];
  #endif
  return r;
  ```)
;;; u8x16-store! -- write v's lanes to arr[i] .. arr[i + 15] (out of bounds panics, once).
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element
;;;   v -- the vector
;;;
;;; Example:
;;;   (u8x16-store! a 0 (u8x16-splat (as uint8 3)))
;;;
;;; Since: S1

(defn u8x16-store! [^borrow arr : U8Vec i : int v : U8x16]
  #fx{}
  #writes arr
  : nil
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  if (i < 0 || i > h->len - 16) {
    tur_panic("u8x16-store!: index out of bounds");
    return;
  }
  uint8_t *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  d[2] = v.l2;
  d[3] = v.l3;
  d[4] = v.l4;
  d[5] = v.l5;
  d[6] = v.l6;
  d[7] = v.l7;
  d[8] = v.l8;
  d[9] = v.l9;
  d[10] = v.l10;
  d[11] = v.l11;
  d[12] = v.l12;
  d[13] = v.l13;
  d[14] = v.l14;
  d[15] = v.l15;
  #endif
  ```)
;;; u8x16-load-unchecked -- lanes from arr[i] .. arr[i + 15], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: for a loop that has checked its bounds once.  It can
;;; not panic, so a call to it carries no panic check and no call site:
;;; in a tight loop the checked `-load` costs up to 3x (clang).  The
;;; interpreter checks the index anyway.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 16 <= len
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (unsafe (u8x16-load-unchecked a 0))
;;;
;;; Since: S1

(defn u8x16-load-unchecked [^borrow arr : U8Vec i : int]
  #fx{Unsafe}
  #reads arr
  : U8x16
  ```c
  struct { int64_t len; uint8_t *data; void *raw; } *h = (void*)(intptr_t)arr;
  const uint8_t *d = h->data + i;
  tur_adt_U8x16 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  r.l4 = d[4];
  r.l5 = d[5];
  r.l6 = d[6];
  r.l7 = d[7];
  r.l8 = d[8];
  r.l9 = d[9];
  r.l10 = d[10];
  r.l11 = d[11];
  r.l12 = d[12];
  r.l13 = d[13];
  r.l14 = d[14];
  r.l15 = d[15];
  #endif
  return r;
  ```)
;;; u8x16-store-unchecked! -- write v's lanes to arr[i] .. arr[i + 15], NOT bounds-checked.
