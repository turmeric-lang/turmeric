;;; u8x16-mul -- lanewise a * b.
;;;
;;; Integer lanes wrap: a U8x16 product is taken modulo 256, lane by lane --
;;; widen first (u8x16-widen-lo / -hi) for the full product.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-mul (u8x16-splat (as uint8 7)) (u8x16-splat (as uint8 3)))
;;;
;;; Since: S1

(defn u8x16-mul [a : U8x16 b : U8x16]
  #fx{}
  : U8x16
  ```c
  #if !defined(__MIRC__)
  typedef uint8_t tsu __attribute__((vector_size(16)));
  union { tur_adt_U8x16 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v * ub.v;
  return ur.s;
  #else
  tur_adt_U8x16 r;
  r.l0 = (uint8_t)((uint32_t)a.l0 * (uint32_t)b.l0);
  r.l1 = (uint8_t)((uint32_t)a.l1 * (uint32_t)b.l1);
  r.l2 = (uint8_t)((uint32_t)a.l2 * (uint32_t)b.l2);
  r.l3 = (uint8_t)((uint32_t)a.l3 * (uint32_t)b.l3);
  r.l4 = (uint8_t)((uint32_t)a.l4 * (uint32_t)b.l4);
  r.l5 = (uint8_t)((uint32_t)a.l5 * (uint32_t)b.l5);
  r.l6 = (uint8_t)((uint32_t)a.l6 * (uint32_t)b.l6);
  r.l7 = (uint8_t)((uint32_t)a.l7 * (uint32_t)b.l7);
  r.l8 = (uint8_t)((uint32_t)a.l8 * (uint32_t)b.l8);
  r.l9 = (uint8_t)((uint32_t)a.l9 * (uint32_t)b.l9);
  r.l10 = (uint8_t)((uint32_t)a.l10 * (uint32_t)b.l10);
  r.l11 = (uint8_t)((uint32_t)a.l11 * (uint32_t)b.l11);
  r.l12 = (uint8_t)((uint32_t)a.l12 * (uint32_t)b.l12);
  r.l13 = (uint8_t)((uint32_t)a.l13 * (uint32_t)b.l13);
  r.l14 = (uint8_t)((uint32_t)a.l14 * (uint32_t)b.l14);
  r.l15 = (uint8_t)((uint32_t)a.l15 * (uint32_t)b.l15);
  return r;
  #endif
  ```)
;;; u8x16-div -- lanewise a / b.
;;;
;;; An integer lane divided by zero panics; MIN / -1 wraps to MIN.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-div (u8x16-splat (as uint8 7)) (u8x16-splat (as uint8 3)))
;;;
;;; Since: S1

(defn u8x16-div [a : U8x16 b : U8x16]
  #fx{}
  : U8x16
  ```c
  tur_adt_U8x16 r;
  if (b.l0 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l0 = a.l0 / b.l0;
  if (b.l1 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l1 = a.l1 / b.l1;
  if (b.l2 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l2 = a.l2 / b.l2;
  if (b.l3 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l3 = a.l3 / b.l3;
  if (b.l4 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l4 = a.l4 / b.l4;
  if (b.l5 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l5 = a.l5 / b.l5;
  if (b.l6 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l6 = a.l6 / b.l6;
  if (b.l7 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l7 = a.l7 / b.l7;
  if (b.l8 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l8 = a.l8 / b.l8;
  if (b.l9 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l9 = a.l9 / b.l9;
  if (b.l10 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l10 = a.l10 / b.l10;
  if (b.l11 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l11 = a.l11 / b.l11;
  if (b.l12 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l12 = a.l12 / b.l12;
  if (b.l13 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l13 = a.l13 / b.l13;
  if (b.l14 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l14 = a.l14 / b.l14;
  if (b.l15 == 0) {
    tur_panic("u8x16-div: division by zero");
    return a;
  }
  r.l15 = a.l15 / b.l15;
  return r;
  ```)
;;; u8x16-neg -- lanewise -a.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-neg (u8x16-splat (as uint8 7)))
;;;
;;; Since: S1

(defn u8x16-neg [a : U8x16]
  #fx{}
