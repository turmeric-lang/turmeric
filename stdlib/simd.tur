;;; u8x16-select -- lane k is a[k] where m's lane k is set (nonzero), else b[k].
;;;
;;; Branch-free: both a and b are computed.  Lanewise min of a and b is
;;; `(P-select (P-lt a b) a b)`, as `P-min` is.
;;;
;;; Parameters:
;;;   m -- the mask, from a comparison
;;;   a -- the lanes taken where m is set
;;;   b -- the lanes taken where it is not
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-select (u8x16-lt (u8x16-splat (as uint8 3)) (u8x16-splat (as uint8 7))) (u8x16-splat (as uint8 3)) (u8x16-splat (as uint8 7)))
;;;
;;; Since: S1

(defn u8x16-select [m : M8x16 a : U8x16 b : U8x16]
  #fx{}
  : U8x16
  ```c
  #if !defined(__MIRC__)
  typedef int8_t tsm __attribute__((vector_size(16)));
  union { tur_adt_M8x16 s; tsm v; } um = {m};
  union { tur_adt_U8x16 s; tsm v; } ua = {a}, ub = {b}, ur;
  tsm mm = (tsm)(um.v != 0);
  ur.v = (ua.v & mm) | (ub.v & ~mm);
  return ur.s;
  #else
  tur_adt_U8x16 r;
  r.l0 = m.l0 ? a.l0 : b.l0;
  r.l1 = m.l1 ? a.l1 : b.l1;
  r.l2 = m.l2 ? a.l2 : b.l2;
  r.l3 = m.l3 ? a.l3 : b.l3;
  r.l4 = m.l4 ? a.l4 : b.l4;
  r.l5 = m.l5 ? a.l5 : b.l5;
  r.l6 = m.l6 ? a.l6 : b.l6;
  r.l7 = m.l7 ? a.l7 : b.l7;
  r.l8 = m.l8 ? a.l8 : b.l8;
  r.l9 = m.l9 ? a.l9 : b.l9;
  r.l10 = m.l10 ? a.l10 : b.l10;
  r.l11 = m.l11 ? a.l11 : b.l11;
  r.l12 = m.l12 ? a.l12 : b.l12;
  r.l13 = m.l13 ? a.l13 : b.l13;
  r.l14 = m.l14 ? a.l14 : b.l14;
  r.l15 = m.l15 ? a.l15 : b.l15;
  return r;
  #endif
  ```)
;;; u8x16-shuffle -- lane k is v's lane idx[k] mod 16.
;;;
;;; Constant indices compile to one shuffle instruction (gcc and clang); an
;;; index outside 0 to 15 wraps, so there is no out-of-range case.
;;;
;;; Parameters:
;;;   v -- the vector
;;;   idx -- which lane of v each result lane takes
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-shuffle (u8x16-splat (as uint8 7)) (U8x16 (as uint8 15) (as uint8 14) (as uint8 13) (as uint8 12) (as uint8 11) (as uint8 10) (as uint8 9) (as uint8 8) (as uint8 7) (as uint8 6) (as uint8 5) (as uint8 4) (as uint8 3) (as uint8 2) (as uint8 1) (as uint8 0)))   ; lanes reversed
;;;
;;; Since: S1

(defn u8x16-shuffle [v : U8x16 idx : U8x16]
  #fx{}
  : U8x16
  ```c
  union { tur_adt_U8x16 s; uint8_t a[16]; } u = {v};
  tur_adt_U8x16 r;
  r.l0 = u.a[idx.l0 & 15];
  r.l1 = u.a[idx.l1 & 15];
  r.l2 = u.a[idx.l2 & 15];
  r.l3 = u.a[idx.l3 & 15];
  r.l4 = u.a[idx.l4 & 15];
  r.l5 = u.a[idx.l5 & 15];
  r.l6 = u.a[idx.l6 & 15];
  r.l7 = u.a[idx.l7 & 15];
  r.l8 = u.a[idx.l8 & 15];
  r.l9 = u.a[idx.l9 & 15];
  r.l10 = u.a[idx.l10 & 15];
  r.l11 = u.a[idx.l11 & 15];
  r.l12 = u.a[idx.l12 & 15];
  r.l13 = u.a[idx.l13 & 15];
  r.l14 = u.a[idx.l14 & 15];
  r.l15 = u.a[idx.l15 & 15];
  return r;
  ```)
;;; Num [U8x16] -- lanewise arithmetic, so {a + b} works.

(definstance Num [U8x16]
  (add [x y] (u8x16-add x y))
  (sub [x y] (u8x16-sub x y))
  (mul [x y] (u8x16-mul x y))
  (div [x y] (u8x16-div x y))
  (neg [x] (u8x16-neg x)))
