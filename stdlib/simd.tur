;;; u8x16-hsum -- the sum of the lanes.
;;;
;;; Floats add in one fixed tree -- (0 + 1) for two lanes, ((0 + 1) + (2 + 3))
;;; for four -- the same on every engine.  Integer lanes are widened to int and
;;; the sum wraps modulo 2^64.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A int.
;;;
;;; Example:
;;;   (u8x16-hsum (u8x16-splat (as uint8 3)))
;;;
;;; Since: S1

(defn u8x16-hsum [a : U8x16]
  #fx{}
  : int
  ```c
  return (int64_t)((uint64_t)(int64_t)a.l0 + (uint64_t)(int64_t)a.l1 + (uint64_t)(int64_t)a.l2 + (uint64_t)(int64_t)a.l3 + (uint64_t)(int64_t)a.l4 + (uint64_t)(int64_t)a.l5 + (uint64_t)(int64_t)a.l6 + (uint64_t)(int64_t)a.l7 + (uint64_t)(int64_t)a.l8 + (uint64_t)(int64_t)a.l9 + (uint64_t)(int64_t)a.l10 + (uint64_t)(int64_t)a.l11 + (uint64_t)(int64_t)a.l12 + (uint64_t)(int64_t)a.l13 + (uint64_t)(int64_t)a.l14 + (uint64_t)(int64_t)a.l15);
  ```)
;;; u8x16-widen-lo -- lanes 0-7 widened to sixteen bits.
;;;
;;; Parameters:
;;;   a -- a byte vector
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u8x16-widen-lo (u8x16-splat (as uint8 255)))
;;;
;;; Since: S1

(defn u8x16-widen-lo [a : U8x16]
  #fx{}
  : U16x8
  ```c
  #if !defined(__MIRC__)
  typedef uint8_t tsb __attribute__((vector_size(16)));
  typedef uint8_t tsh __attribute__((vector_size(8)));
  typedef uint16_t tsw __attribute__((vector_size(16)));
  union { tur_adt_U8x16 s; tsb v; } ua = {a};
  union { tur_adt_U16x8 s; tsw v; } ur;
  tsh h = __builtin_shufflevector(ua.v, ua.v, 0, 1, 2, 3, 4, 5, 6, 7);
  ur.v = __builtin_convertvector(h, tsw);
  return ur.s;
  #else
  tur_adt_U16x8 r;
  r.l0 = a.l0;
  r.l1 = a.l1;
  r.l2 = a.l2;
  r.l3 = a.l3;
  r.l4 = a.l4;
  r.l5 = a.l5;
  r.l6 = a.l6;
  r.l7 = a.l7;
  return r;
  #endif
  ```)
