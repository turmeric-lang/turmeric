  const uint8_t *d = h->data + i;
  tur_adt_U8x16 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  r.l4 = d[4];
  r.l5 = d[5];
  r.l6 = d[6];
  r.l7 = d[7];
  r.l8 = d[8];
  r.l9 = d[9];
  r.l10 = d[10];
  r.l11 = d[11];
  r.l12 = d[12];
  r.l13 = d[13];
  r.l14 = d[14];
  r.l15 = d[15];
  #endif
  return r;
  ```)
