;;; tur/simd -- 16-byte vector types and their lanewise operations.
;;;
;;; GENERATED by tools/gen-simd.py -- edit the template there, not this file.
;;;
;;; Phase S1 of docs/upcoming/simd-and-vectorization-plan.md, behind
;;; `--enable=simd`: loading this file without it is an error.
;;;
;;; | Type  | Lanes | Lane     | Loads from |
;;; |-------|-------|----------|------------|
;;; | F64x2 | 2     | `float`  | F64Vec     |
;;; | F32x4 | 4     | `float32`| F32Vec     |
;;; | I64x2 | 2     | `int`    | I64Vec     |
;;; | I32x4 | 4     | `int32`  | I32Vec     |
;;; | U16x8 | 8     | `uint16` | (widen a U8x16) |
;;; | U8x16 | 16    | `uint8`  | U8Vec      |
;;;
;;; Each type is a `^copy` struct with one field per lane (`l0`, `l1`, ...),
;;; so a vector is an ordinary value: a local, a parameter, a result, a struct
;;; field.  `(F64x2 7.1 3.25)` builds one, `(.l1 v)` reads a lane.  Every
;;; type has `P-splat`, `P-lane`, `P-add`, `P-sub`, `P-mul`, `P-div`, `P-neg`,
;;; `P-min`, `P-max` and `P-hsum`, and a `Num` instance, so `{a + b}` is the
;;; lanewise sum; the floats add `P-sqrt` and `P-abs`; all but U16x8 load from
;;; and store to their typed numeric array (`P-load`, `P-store!`, one bounds
;;; check per call); `u8x16-widen-lo` / `-hi`, `u16x8-narrow` and `u16x8-shr`
;;; move bytes through sixteen-bit lanes, where a product fits.
;;;
;;; Compiled with gcc or clang, an operation is one vector instruction (a
;;; GNU vector extension over the struct's bytes); under `tur jit` the same
;;; operation is a loop over the lanes.  Both compute each lane exactly as
;;; the scalar operator would -- integer lanes wrap, float operations are
;;; never fused -- so every engine gives the same bits.  The types are
;;; 16 bytes on purpose: a 32-byte vector lives in memory on gcc without AVX
;;; (the plan's S0 findings).
;;;
;;; Keep a vector out of generic code: a 16-byte value crossing a generic
;;; boundary is boxed on the heap, as every wide struct is, which costs more
;;; than the vector saves.
;;;
;;; Since: S1 (simd-and-vectorization-plan)
(load "stdlib/typeclass.tur")

(load "stdlib/numvec.tur")
;; ===== F64x2 =====
;;; F64x2 -- a 16-byte vector of 2 float lanes.
;;;
;;; Lanes `l0` .. `l1`; `(F64x2 7.1 7.1)` builds one.
;;;
;;; Since: S1
(defstruct ^copy F64x2 [l0 : float l1 : float])
;; ===== F32x4 =====
;;; F32x4 -- a 16-byte vector of 4 float32 lanes.
;;;
;;; Lanes `l0` .. `l3`; `(F32x4 (as float32 7.1) (as float32 7.1) (as float32 7.1) (as float32 7.1))` builds one.
;;;
;;; Since: S1
(defstruct ^copy F32x4 [l0 : float32 l1 : float32 l2 : float32 l3 : float32])
;; ===== I64x2 =====
;;; I64x2 -- a 16-byte vector of 2 int lanes.
;;;
;;; Lanes `l0` .. `l1`; `(I64x2 7 7)` builds one.
;;;
;;; Since: S1
(defstruct ^copy I64x2 [l0 : int l1 : int])
;; ===== I32x4 =====
;;; I32x4 -- a 16-byte vector of 4 int32 lanes.
;;;
;;; Lanes `l0` .. `l3`; `(I32x4 (as int32 7) (as int32 7) (as int32 7) (as int32 7))` builds one.
;;;
;;; Since: S1
(defstruct ^copy I32x4 [l0 : int32 l1 : int32 l2 : int32 l3 : int32])
;; ===== U16x8 =====
;;; U16x8 -- a 16-byte vector of 8 uint16 lanes.
;;;
;;; Lanes `l0` .. `l7`; `(U16x8 (as uint16 7) (as uint16 7) (as uint16 7) (as uint16 7) (as uint16 7) (as uint16 7) (as uint16 7) (as uint16 7))` builds one.
;;;
;;; Since: S1
(defstruct ^copy U16x8
  [l0 : uint16
   l1 : uint16
   l2 : uint16
   l3 : uint16
   l4 : uint16
   l5 : uint16
   l6 : uint16
   l7 : uint16])
;; ===== U8x16 =====
;;; U8x16 -- a 16-byte vector of 16 uint8 lanes.
;;;
;;; Lanes `l0` .. `l15`; `(U8x16 (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7) (as uint8 7))` builds one.
;;;
;;; Since: S1
(defstruct ^copy U8x16
  [l0 : uint8
   l1 : uint8
   l2 : uint8
   l3 : uint8
   l4 : uint8
   l5 : uint8
   l6 : uint8
   l7 : uint8
   l8 : uint8
   l9 : uint8
   l10 : uint8
   l11 : uint8
   l12 : uint8
   l13 : uint8
   l14 : uint8
   l15 : uint8])
;;; f64x2-splat -- every lane x.
;;;
;;; Parameters:
;;;   x -- the value
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (f64x2-splat 7.1)
;;;
;;; Since: S1

(defn f64x2-splat [x : float]
  #fx{}
  : F64x2
  ```c
  tur_adt_F64x2 r;
  r.l0 = x;
  r.l1 = x;
  return r;
  ```)
;;; f64x2-lane -- lane k of v (0 is the lowest; out of range panics).
;;;
;;; Parameters:
;;;   v -- the vector
;;;   k -- the lane, 0 to 1
;;;
;;; Returns:
;;;   A float.
;;;
;;; Example:
;;;   (f64x2-lane (f64x2-splat 7.1) 0)   ; => 7.1
;;;
;;; Since: S1

(defn f64x2-lane [v : F64x2 k : int]
  #fx{}
  : float
  ```c
  if (k < 0 || k >= 2) {
    tur_panic("f64x2-lane: lane out of range");
    return 0;
  }
  union { tur_adt_F64x2 s; double a[2]; } u = {v};
  return u.a[k];
  ```)
;;; f64x2-load -- lanes from arr[i] .. arr[i + 1] (out of bounds panics, once).
;;;
;;; The array's element type is the vector's lane type.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element
;;;
;;; Returns:
;;;   A F64x2.
;;;
;;; Example:
;;;   (let [a (f64vec-new 8 7.1)] (f64x2-load a 0))
;;;
;;; Since: S1

(defn f64x2-load [^borrow arr : F64Vec i : int]
  #fx{}
  #reads arr
  : F64x2
  ```c
  static const double tsz[2] = {0};
  struct { int64_t len; double *data; void *raw; } *h = (void*)(intptr_t)arr;
  const double *d = tsz;
  if (i < 0 || i > h->len - 2)
    tur_panic("f64x2-load: index out of bounds");
  else
    d = h->data + i;
  tur_adt_F64x2 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  #endif
  return r;
  ```)
;;; f64x2-store! -- write v's lanes to arr[i] .. arr[i + 1] (out of bounds panics, once).
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element
;;;   v -- the vector
;;;
;;; Example:
;;;   (f64x2-store! a 0 (f64x2-splat 3.25))
;;;
;;; Since: S1

(defn f64x2-store! [^borrow arr : F64Vec i : int v : F64x2]
  #fx{}
  #writes arr
  : nil
  ```c
  struct { int64_t len; double *data; void *raw; } *h = (void*)(intptr_t)arr;
  if (i < 0 || i > h->len - 2) {
    tur_panic("f64x2-store!: index out of bounds");
    return;
  }
  double *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  #endif
  ```)
