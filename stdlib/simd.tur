;;; Example:
;;;   (f32x4-splat (as float32 7.1))
;;;
;;; Since: S1

(defn f32x4-splat [x : float32]
  #fx{}
  : F32x4
  ```c
  tur_adt_F32x4 r;
  r.l0 = x;
  r.l1 = x;
  r.l2 = x;
  r.l3 = x;
  return r;
  ```)
;;; f32x4-lane -- lane k of v (0 is the lowest; out of range panics).
;;;
;;; Parameters:
;;;   v -- the vector
;;;   k -- the lane, 0 to 3
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (f32x4-lane (f32x4-splat (as float32 7.1)) 0)   ; => (as float32 7.1)
;;;
;;; Since: S1

(defn f32x4-lane [v : F32x4 k : int]
  #fx{}
  : float32
  ```c
  if (k < 0 || k >= 4) {
    tur_panic("f32x4-lane: lane out of range");
    return 0;
  }
  union { tur_adt_F32x4 s; float a[4]; } u = {v};
  return u.a[k];
  ```)
;;; f32x4-load -- lanes from arr[i] .. arr[i + 3] (out of bounds panics, once).
;;;
;;; The array's element type is the vector's lane type.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (let [a (f32vec-new 8 (as float32 7.1))] (f32x4-load a 0))
;;;
;;; Since: S1

(defn f32x4-load [^borrow arr : F32Vec i : int]
  #fx{}
  #reads arr
  : F32x4
  ```c
  static const float tsz[4] = {0};
  struct { int64_t len; float *data; void *raw; } *h = (void*)(intptr_t)arr;
  const float *d = tsz;
  if (i < 0 || i > h->len - 4)
    tur_panic("f32x4-load: index out of bounds");
  else
    d = h->data + i;
  tur_adt_F32x4 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  #endif
  return r;
  ```)
;;; f32x4-store! -- write v's lanes to arr[i] .. arr[i + 3] (out of bounds panics, once).
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element
;;;   v -- the vector
;;;
;;; Example:
;;;   (f32x4-store! a 0 (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-store! [^borrow arr : F32Vec i : int v : F32x4]
  #fx{}
  #writes arr
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *h = (void*)(intptr_t)arr;
  if (i < 0 || i > h->len - 4) {
    tur_panic("f32x4-store!: index out of bounds");
    return;
  }
  float *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  d[2] = v.l2;
  d[3] = v.l3;
  #endif
  ```)
;;; f32x4-load-unchecked -- lanes from arr[i] .. arr[i + 3], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`: for a loop that has checked its bounds once.  It can
;;; not panic, so a call to it carries no panic check and no call site:
;;; in a tight loop the checked `-load` costs up to 3x (clang).  The
;;; interpreter checks the index anyway.
;;;
;;; Parameters:
;;;   arr -- the array (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 4 <= len
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (unsafe (f32x4-load-unchecked a 0))
;;;
;;; Since: S1

(defn f32x4-load-unchecked [^borrow arr : F32Vec i : int]
  #fx{Unsafe}
  #reads arr
  : F32x4
  ```c
  struct { int64_t len; float *data; void *raw; } *h = (void*)(intptr_t)arr;
  const float *d = h->data + i;
  tur_adt_F32x4 r;
  #if !defined(__MIRC__)
  __builtin_memcpy(&r, d, sizeof r);
  #else
  r.l0 = d[0];
  r.l1 = d[1];
  r.l2 = d[2];
  r.l3 = d[3];
  #endif
  return r;
  ```)
;;; f32x4-store-unchecked! -- write v's lanes to arr[i] .. arr[i + 3], NOT bounds-checked.
;;;
;;; `#fx{Unsafe}`, as `-load-unchecked`.  Stores numbers: no
;;; TUR_REGION_NOTE.
;;;
;;; Parameters:
;;;   arr -- the array written (borrowed)
;;;   i -- the first element; the caller proves 0 <= i and i + 4 <= len
;;;   v -- the vector
;;;
;;; Example:
;;;   (unsafe (f32x4-store-unchecked! a 0 (f32x4-splat (as float32 3.25))))
;;;
;;; Since: S1

(defn f32x4-store-unchecked! [^borrow arr : F32Vec i : int v : F32x4]
  #fx{Unsafe}
  #writes arr
  : nil
  ```c
  struct { int64_t len; float *data; void *raw; } *h = (void*)(intptr_t)arr;
  float *d = h->data + i;
  #if !defined(__MIRC__)
  __builtin_memcpy(d, &v, sizeof v);
  #else
  d[0] = v.l0;
  d[1] = v.l1;
  d[2] = v.l2;
  d[3] = v.l3;
  #endif
  ```)
;;; f32x4-add -- lanewise a + b.
;;;
;;; Integer lanes wrap.  Floats: one IEEE add per lane, as the scalar `+`.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-add (f32x4-splat (as float32 7.1)) (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-add [a : F32x4 b : F32x4]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef float tsv __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v + ub.v;
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = a.l0 + b.l0;
  r.l1 = a.l1 + b.l1;
  r.l2 = a.l2 + b.l2;
  r.l3 = a.l3 + b.l3;
  return r;
  #endif
  ```)
;;; f32x4-sub -- lanewise a - b.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-sub (f32x4-splat (as float32 7.1)) (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-sub [a : F32x4 b : F32x4]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef float tsv __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v - ub.v;
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = a.l0 - b.l0;
  r.l1 = a.l1 - b.l1;
  r.l2 = a.l2 - b.l2;
  r.l3 = a.l3 - b.l3;
  return r;
  #endif
  ```)
;;; f32x4-mul -- lanewise a * b.
;;;
;;; Integer lanes wrap: a U8x16 product is taken modulo 256, lane by lane --
;;; widen first (u8x16-widen-lo / -hi) for the full product.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-mul (f32x4-splat (as float32 7.1)) (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-mul [a : F32x4 b : F32x4]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef float tsv __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v * ub.v;
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = a.l0 * b.l0;
  r.l1 = a.l1 * b.l1;
  r.l2 = a.l2 * b.l2;
  r.l3 = a.l3 * b.l3;
  return r;
  #endif
  ```)
;;; f32x4-div -- lanewise a / b.
;;;
;;; An integer lane divided by zero panics; MIN / -1 wraps to MIN.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-div (f32x4-splat (as float32 7.1)) (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-div [a : F32x4 b : F32x4]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef float tsv __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsv v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v / ub.v;
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = a.l0 / b.l0;
  r.l1 = a.l1 / b.l1;
  r.l2 = a.l2 / b.l2;
  r.l3 = a.l3 / b.l3;
  return r;
  #endif
  ```)
;;; f32x4-neg -- lanewise -a.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-neg (f32x4-splat (as float32 7.1)))
;;;
;;; Since: S1

(defn f32x4-neg [a : F32x4]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef float tsv __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsv v; } ua = {a}, ur;
  ur.v = -ua.v;
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = -a.l0;
  r.l1 = -a.l1;
  r.l2 = -a.l2;
  r.l3 = -a.l3;
  return r;
  #endif
  ```)
;;; f32x4-min -- lanewise minimum: lane k is b[k] < a[k] ? b[k] : a[k].
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (f32x4-min (f32x4-splat (as float32 7.1)) (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-min [a : F32x4 b : F32x4]
  #fx{}
  : F32x4
  ```c
  tur_adt_F32x4 r;
  r.l0 = b.l0 < a.l0 ? b.l0 : a.l0;
  r.l1 = b.l1 < a.l1 ? b.l1 : a.l1;
  r.l2 = b.l2 < a.l2 ? b.l2 : a.l2;
  r.l3 = b.l3 < a.l3 ? b.l3 : a.l3;
  return r;
  ```)
;;; f32x4-max -- lanewise maximum: lane k is b[k] > a[k] ? b[k] : a[k].
;;;
;;; Parameters:
