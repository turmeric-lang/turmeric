  r.l0 = (uint8_t)(0 - (uint32_t)a.l0);
  r.l1 = (uint8_t)(0 - (uint32_t)a.l1);
  r.l2 = (uint8_t)(0 - (uint32_t)a.l2);
  r.l3 = (uint8_t)(0 - (uint32_t)a.l3);
  r.l4 = (uint8_t)(0 - (uint32_t)a.l4);
  r.l5 = (uint8_t)(0 - (uint32_t)a.l5);
  r.l6 = (uint8_t)(0 - (uint32_t)a.l6);
  r.l7 = (uint8_t)(0 - (uint32_t)a.l7);
  r.l8 = (uint8_t)(0 - (uint32_t)a.l8);
  r.l9 = (uint8_t)(0 - (uint32_t)a.l9);
  r.l10 = (uint8_t)(0 - (uint32_t)a.l10);
  r.l11 = (uint8_t)(0 - (uint32_t)a.l11);
  r.l12 = (uint8_t)(0 - (uint32_t)a.l12);
