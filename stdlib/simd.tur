;;; f32x4-hsum -- the sum of the lanes.
;;;
;;; Floats add in one fixed tree -- (0 + 1) for two lanes, ((0 + 1) + (2 + 3))
;;; for four -- the same on every engine.  Integer lanes are widened to int and
;;; the sum wraps modulo 2^64.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A float32.
;;;
;;; Example:
;;;   (f32x4-hsum (f32x4-splat (as float32 3.25)))
;;;
;;; Since: S1

(defn f32x4-hsum [a : F32x4]
  #fx{}
  : float32
  ```c
  return (a.l0 + a.l1) + (a.l2 + a.l3);
  ```)
;;; f32x4-eq -- lanewise a == b: -1 where it holds, 0 where not.
;;;
;;; Floats compare as IEEE: a NaN lane is unequal to everything and never less
;;; or greater.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A M32x4.
;;;
;;; Example:
;;;   (f32x4-eq (f32x4-splat (as float32 3.25)) (f32x4-splat (as float32 7.1)))
;;;
;;; Since: S1

(defn f32x4-eq [a : F32x4 b : F32x4]
  #fx{}
  : M32x4
  ```c
  #if !defined(__MIRC__)
  typedef float tsv __attribute__((vector_size(16)));
  typedef int32_t tsm __attribute__((vector_size(16)));
  union { tur_adt_F32x4 s; tsv v; } ua = {a}, ub = {b};
  union { tur_adt_M32x4 s; tsm v; } ur;
  ur.v = (tsm)(ua.v == ub.v);
  return ur.s;
  #else
  tur_adt_M32x4 r;
  r.l0 = a.l0 == b.l0 ? -1 : 0;
  r.l1 = a.l1 == b.l1 ? -1 : 0;
  r.l2 = a.l2 == b.l2 ? -1 : 0;
  r.l3 = a.l3 == b.l3 ? -1 : 0;
  return r;
  #endif
  ```)
