;;; i32x4-select -- lane k is a[k] where m's lane k is set (nonzero), else b[k].
;;;
;;; Branch-free: both a and b are computed.  Lanewise min of a and b is
;;; `(P-select (P-lt a b) a b)`, as `P-min` is.
;;;
;;; Parameters:
;;;   m -- the mask, from a comparison
;;;   a -- the lanes taken where m is set
;;;   b -- the lanes taken where it is not
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-select (i32x4-lt (i32x4-splat (as int32 3)) (i32x4-splat (as int32 7))) (i32x4-splat (as int32 3)) (i32x4-splat (as int32 7)))
;;;
;;; Since: S1

(defn i32x4-select [m : M32x4 a : I32x4 b : I32x4]
  #fx{}
  : I32x4
  ```c
  #if !defined(__MIRC__)
  typedef int32_t tsm __attribute__((vector_size(16)));
  union { tur_adt_M32x4 s; tsm v; } um = {m};
  union { tur_adt_I32x4 s; tsm v; } ua = {a}, ub = {b}, ur;
  tsm mm = (tsm)(um.v != 0);
  ur.v = (ua.v & mm) | (ub.v & ~mm);
  return ur.s;
  #else
  tur_adt_I32x4 r;
  r.l0 = m.l0 ? a.l0 : b.l0;
  r.l1 = m.l1 ? a.l1 : b.l1;
  r.l2 = m.l2 ? a.l2 : b.l2;
  r.l3 = m.l3 ? a.l3 : b.l3;
  return r;
  #endif
  ```)
;;; i32x4-shuffle -- lane k is v's lane idx[k] mod 4.
;;;
;;; Constant indices compile to one shuffle instruction (gcc and clang); an
;;; index outside 0 to 3 wraps, so there is no out-of-range case.
;;;
;;; Parameters:
;;;   v -- the vector
;;;   idx -- which lane of v each result lane takes
;;;
;;; Returns:
;;;   A I32x4.
;;;
;;; Example:
;;;   (i32x4-shuffle (i32x4-splat (as int32 7)) (I32x4 (as int32 3) (as int32 2) (as int32 1) (as int32 0)))   ; lanes reversed
;;;
;;; Since: S1

(defn i32x4-shuffle [v : I32x4 idx : I32x4]
  #fx{}
  : I32x4
  ```c
  union { tur_adt_I32x4 s; int32_t a[4]; } u = {v};
  tur_adt_I32x4 r;
  r.l0 = u.a[idx.l0 & 3];
  r.l1 = u.a[idx.l1 & 3];
  r.l2 = u.a[idx.l2 & 3];
  r.l3 = u.a[idx.l3 & 3];
  return r;
  ```)
;;; i32x4->f32x4 -- each lane converted to float32, rounding to nearest (cvtdq2ps).
;;;
;;; Parameters:
;;;   a -- the vector
;;;
;;; Returns:
;;;   A F32x4.
;;;
;;; Example:
;;;   (i32x4->f32x4 (i32x4-splat (as int32 7)))
;;;
;;; Since: S1

(defn i32x4->f32x4 [a : I32x4]
  #fx{}
  : F32x4
  ```c
  #if !defined(__MIRC__)
  typedef int32_t tsi __attribute__((vector_size(16)));
  typedef float tsf __attribute__((vector_size(16)));
  union { tur_adt_I32x4 s; tsi v; } ua = {a};
  union { tur_adt_F32x4 s; tsf v; } ur;
  ur.v = __builtin_convertvector(ua.v, tsf);
  return ur.s;
  #else
  tur_adt_F32x4 r;
  r.l0 = (float)a.l0;
  r.l1 = (float)a.l1;
  r.l2 = (float)a.l2;
  r.l3 = (float)a.l3;
  return r;
  #endif
  ```)
;;; Num [I32x4] -- lanewise arithmetic, so {a + b} works.

(definstance Num [I32x4]
  (add [x y] (i32x4-add x y))
  (sub [x y] (i32x4-sub x y))
  (mul [x y] (i32x4-mul x y))
  (div [x y] (i32x4-div x y))
  (neg [x] (i32x4-neg x)))
;;; u16x8-splat -- every lane x.
;;;
;;; Parameters:
;;;   x -- the value
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u16x8-splat (as uint16 7))
;;;
;;; Since: S1

(defn u16x8-splat [x : uint16]
  #fx{}
  : U16x8
  ```c
  tur_adt_U16x8 r;
  r.l0 = x;
  r.l1 = x;
  r.l2 = x;
  r.l3 = x;
  r.l4 = x;
  r.l5 = x;
  r.l6 = x;
  r.l7 = x;
  return r;
  ```)
;;; u16x8-lane -- lane k of v (0 is the lowest; out of range panics).
;;;
;;; Parameters:
;;;   v -- the vector
;;;   k -- the lane, 0 to 7
;;;
;;; Returns:
;;;   A uint16.
;;;
;;; Example:
;;;   (u16x8-lane (u16x8-splat (as uint16 7)) 0)   ; => (as uint16 7)
;;;
;;; Since: S1

(defn u16x8-lane [v : U16x8 k : int]
  #fx{}
  : uint16
  ```c
  if (k < 0 || k >= 8) {
    tur_panic("u16x8-lane: lane out of range");
    return 0;
  }
  union { tur_adt_U16x8 s; uint16_t a[8]; } u = {v};
  return u.a[k];
  ```)
;;; u16x8-add -- lanewise a + b.
;;;
;;; Integer lanes wrap.  Floats: one IEEE add per lane, as the scalar `+`.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u16x8-add (u16x8-splat (as uint16 7)) (u16x8-splat (as uint16 3)))
;;;
;;; Since: S1

(defn u16x8-add [a : U16x8 b : U16x8]
  #fx{}
  : U16x8
  ```c
  #if !defined(__MIRC__)
  typedef uint16_t tsu __attribute__((vector_size(16)));
  union { tur_adt_U16x8 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v + ub.v;
  return ur.s;
  #else
  tur_adt_U16x8 r;
  r.l0 = (uint16_t)((uint32_t)a.l0 + (uint32_t)b.l0);
  r.l1 = (uint16_t)((uint32_t)a.l1 + (uint32_t)b.l1);
  r.l2 = (uint16_t)((uint32_t)a.l2 + (uint32_t)b.l2);
  r.l3 = (uint16_t)((uint32_t)a.l3 + (uint32_t)b.l3);
  r.l4 = (uint16_t)((uint32_t)a.l4 + (uint32_t)b.l4);
  r.l5 = (uint16_t)((uint32_t)a.l5 + (uint32_t)b.l5);
  r.l6 = (uint16_t)((uint32_t)a.l6 + (uint32_t)b.l6);
  r.l7 = (uint16_t)((uint32_t)a.l7 + (uint32_t)b.l7);
  return r;
  #endif
  ```)
