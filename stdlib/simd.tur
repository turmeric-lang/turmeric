;;; u8x16-add -- lanewise a + b.
;;;
;;; Integer lanes wrap.  Floats: one IEEE add per lane, as the scalar `+`.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A U8x16.
;;;
;;; Example:
;;;   (u8x16-add (u8x16-splat (as uint8 7)) (u8x16-splat (as uint8 3)))
;;;
;;; Since: S1

(defn u8x16-add [a : U8x16 b : U8x16]
  #fx{}
  : U8x16
  ```c
  #if !defined(__MIRC__)
  typedef uint8_t tsu __attribute__((vector_size(16)));
  union { tur_adt_U8x16 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v + ub.v;
  return ur.s;
  #else
  tur_adt_U8x16 r;
  r.l0 = (uint8_t)((uint32_t)a.l0 + (uint32_t)b.l0);
  r.l1 = (uint8_t)((uint32_t)a.l1 + (uint32_t)b.l1);
  r.l2 = (uint8_t)((uint32_t)a.l2 + (uint32_t)b.l2);
  r.l3 = (uint8_t)((uint32_t)a.l3 + (uint32_t)b.l3);
  r.l4 = (uint8_t)((uint32_t)a.l4 + (uint32_t)b.l4);
  r.l5 = (uint8_t)((uint32_t)a.l5 + (uint32_t)b.l5);
  r.l6 = (uint8_t)((uint32_t)a.l6 + (uint32_t)b.l6);
  r.l7 = (uint8_t)((uint32_t)a.l7 + (uint32_t)b.l7);
  r.l8 = (uint8_t)((uint32_t)a.l8 + (uint32_t)b.l8);
  r.l9 = (uint8_t)((uint32_t)a.l9 + (uint32_t)b.l9);
  r.l10 = (uint8_t)((uint32_t)a.l10 + (uint32_t)b.l10);
  r.l11 = (uint8_t)((uint32_t)a.l11 + (uint32_t)b.l11);
  r.l12 = (uint8_t)((uint32_t)a.l12 + (uint32_t)b.l12);
  r.l13 = (uint8_t)((uint32_t)a.l13 + (uint32_t)b.l13);
  r.l14 = (uint8_t)((uint32_t)a.l14 + (uint32_t)b.l14);
  r.l15 = (uint8_t)((uint32_t)a.l15 + (uint32_t)b.l15);
  return r;
  #endif
  ```)
