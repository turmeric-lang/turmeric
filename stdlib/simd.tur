  #if !defined(__MIRC__)
  typedef uint16_t tsu __attribute__((vector_size(16)));
  union { tur_adt_U16x8 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v - ub.v;
  return ur.s;
  #else
  tur_adt_U16x8 r;
  r.l0 = (uint16_t)((uint32_t)a.l0 - (uint32_t)b.l0);
  r.l1 = (uint16_t)((uint32_t)a.l1 - (uint32_t)b.l1);
  r.l2 = (uint16_t)((uint32_t)a.l2 - (uint32_t)b.l2);
  r.l3 = (uint16_t)((uint32_t)a.l3 - (uint32_t)b.l3);
  r.l4 = (uint16_t)((uint32_t)a.l4 - (uint32_t)b.l4);
  r.l5 = (uint16_t)((uint32_t)a.l5 - (uint32_t)b.l5);
  r.l6 = (uint16_t)((uint32_t)a.l6 - (uint32_t)b.l6);
  r.l7 = (uint16_t)((uint32_t)a.l7 - (uint32_t)b.l7);
  return r;
  #endif
  ```)
;;; u16x8-mul -- lanewise a * b.
;;;
;;; Integer lanes wrap: a U8x16 product is taken modulo 256, lane by lane --
;;; widen first (u8x16-widen-lo / -hi) for the full product.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u16x8-mul (u16x8-splat (as uint16 7)) (u16x8-splat (as uint16 3)))
;;;
;;; Since: S1

(defn u16x8-mul [a : U16x8 b : U16x8]
  #fx{}
  : U16x8
  ```c
  #if !defined(__MIRC__)
  typedef uint16_t tsu __attribute__((vector_size(16)));
  union { tur_adt_U16x8 s; tsu v; } ua = {a}, ub = {b}, ur;
  ur.v = ua.v * ub.v;
  return ur.s;
  #else
  tur_adt_U16x8 r;
  r.l0 = (uint16_t)((uint32_t)a.l0 * (uint32_t)b.l0);
  r.l1 = (uint16_t)((uint32_t)a.l1 * (uint32_t)b.l1);
  r.l2 = (uint16_t)((uint32_t)a.l2 * (uint32_t)b.l2);
  r.l3 = (uint16_t)((uint32_t)a.l3 * (uint32_t)b.l3);
  r.l4 = (uint16_t)((uint32_t)a.l4 * (uint32_t)b.l4);
  r.l5 = (uint16_t)((uint32_t)a.l5 * (uint32_t)b.l5);
  r.l6 = (uint16_t)((uint32_t)a.l6 * (uint32_t)b.l6);
  r.l7 = (uint16_t)((uint32_t)a.l7 * (uint32_t)b.l7);
  return r;
  #endif
  ```)
;;; u16x8-div -- lanewise a / b.
;;;
;;; An integer lane divided by zero panics; MIN / -1 wraps to MIN.
;;;
;;; Parameters:
;;;   a -- a vector
;;;   b -- a vector
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u16x8-div (u16x8-splat (as uint16 7)) (u16x8-splat (as uint16 3)))
;;;
;;; Since: S1

(defn u16x8-div [a : U16x8 b : U16x8]
  #fx{}
  : U16x8
  ```c
  tur_adt_U16x8 r;
  if (b.l0 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l0 = a.l0 / b.l0;
  if (b.l1 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l1 = a.l1 / b.l1;
  if (b.l2 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l2 = a.l2 / b.l2;
  if (b.l3 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l3 = a.l3 / b.l3;
  if (b.l4 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l4 = a.l4 / b.l4;
  if (b.l5 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l5 = a.l5 / b.l5;
  if (b.l6 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l6 = a.l6 / b.l6;
  if (b.l7 == 0) {
    tur_panic("u16x8-div: division by zero");
    return a;
  }
  r.l7 = a.l7 / b.l7;
  return r;
  ```)
;;; u16x8-neg -- lanewise -a.
;;;
;;; Integer lanes wrap.
;;;
;;; Parameters:
;;;   a -- a vector
;;;
;;; Returns:
;;;   A U16x8.
;;;
;;; Example:
;;;   (u16x8-neg (u16x8-splat (as uint16 7)))
;;;
;;; Since: S1

(defn u16x8-neg [a : U16x8]
  #fx{}
  : U16x8
  ```c
  #if !defined(__MIRC__)
  typedef uint16_t tsu __attribute__((vector_size(16)));
  union { tur_adt_U16x8 s; tsu v; } ua = {a}, ur;
  ur.v = -ua.v;
  return ur.s;
  #else
  tur_adt_U16x8 r;
  r.l0 = (uint16_t)(0 - (uint32_t)a.l0);
  r.l1 = (uint16_t)(0 - (uint32_t)a.l1);
  r.l2 = (uint16_t)(0 - (uint32_t)a.l2);
  r.l3 = (uint16_t)(0 - (uint32_t)a.l3);
  r.l4 = (uint16_t)(0 - (uint32_t)a.l4);
  r.l5 = (uint16_t)(0 - (uint32_t)a.l5);
  r.l6 = (uint16_t)(0 - (uint32_t)a.l6);
  r.l7 = (uint16_t)(0 - (uint32_t)a.l7);
  return r;
  #endif
  ```)
;;; u16x8-min -- lanewise minimum: lane k is b[k] < a[k] ? b[k] : a[k].
