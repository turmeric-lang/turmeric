;;; tur/term -- terminal utilities: size, tty detection, raw mode, ANSI colors.
;;;
;;; Uses sys/ioctl.h for window size and termios.h for raw/cooked mode switching.
;;;
;;; Since: Phase B1
;; stdlib/term.tur -- terminal utilities: size, tty detection, raw mode, ANSI colors.
;;
;; Uses sys/ioctl.h for window size, termios.h for raw/cooked mode switching,
;; and unistd.h for isatty(3).  ANSI helpers respect the NO_COLOR env var.
(load "stdlib/fd.tur")
;;; term/width -- return the terminal column width.
;;;
;;; Returns:
;;;   Number of columns, or 80 as a fallback if ioctl fails.
;;;
;;; Example:
;;;   (term/width)  ; => 80
;;;
;;; Since: Phase B2
(defn term/width [] : int
  ```c
  #include <sys/ioctl.h>
  /* Windows has no ioctl/TIOCGWINSZ; the console size comes from
   * GetConsoleScreenBufferInfo.  srWindow is the visible window rather than the
   * (usually taller) screen buffer, which is what "terminal width" means here.
   * No #include is needed for it -- windows.h is already at file scope in a
   * Windows build.  Both branches keep the same 80-column fallback. */
#ifdef _WIN32
  CONSOLE_SCREEN_BUFFER_INFO csbi;
  if (GetConsoleScreenBufferInfo(GetStdHandle(STD_OUTPUT_HANDLE), &csbi)) {
    int cols = (int)(csbi.srWindow.Right - csbi.srWindow.Left) + 1;
    if (cols > 0) return (int64_t)cols;
  }
  return 80;
#else
  struct winsize ws;
  if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0) return (int64_t)ws.ws_col;
  return 80;
#endif
  ```)
;;; term/height -- return the terminal row height.
;;;
;;; Returns:
;;;   Number of rows, or 24 as a fallback if ioctl fails.
;;;
;;; Example:
;;;   (term/height)  ; => 24
;;;
;;; Since: Phase B2

(defn term/height [] : int
  ```c
  #include <sys/ioctl.h>
  /* See term/width for why this branches rather than calling ioctl. */
#ifdef _WIN32
  CONSOLE_SCREEN_BUFFER_INFO csbi;
  if (GetConsoleScreenBufferInfo(GetStdHandle(STD_OUTPUT_HANDLE), &csbi)) {
    int rows = (int)(csbi.srWindow.Bottom - csbi.srWindow.Top) + 1;
    if (rows > 0) return (int64_t)rows;
  }
  return 24;
#else
  struct winsize ws;
  if (ioctl(1, TIOCGWINSZ, &ws) == 0 && ws.ws_row > 0) return (int64_t)ws.ws_row;
  return 24;
#endif
  ```)
;;; term/is-tty? -- test whether a file descriptor refers to a terminal.
;;;
;;; Parameters:
;;;   fd -- file descriptor (0=stdin, 1=stdout, 2=stderr)
;;;
;;; Returns:
;;;   true if fd is connected to a terminal.
;;;
;;; Example:
;;;   (term/is-tty? 1)  ; => true when stdout is a tty
;;;
;;; Since: Phase B2

(defn term/is-tty? [fd : int] : bool
  ```c
  #include <unistd.h>
  return isatty((int)fd) != 0;
  ```)
;;; term/is-tty-fd? -- test whether a file descriptor is a terminal.
;;;
;;; term/is-tty? over the Fd handle the I/O modules hand out (socket-fd,
;;; fs/tmpfile-fd, async-socket-*), so any descriptor can be asked without
;;; unwrapping it.
;;;
;;; Parameters:
;;;   fd -- an Fd, e.g. (int->fd 1) for stdout
;;;
;;; Returns:
;;;   true if fd is connected to a terminal.
;;;
;;; Example:
;;;   (term/is-tty-fd? (int->fd 2))  ; => true when stderr is a tty
;;;
;;; Since: stdlib-os-surface P3
(defn term/is-tty-fd? [fd : Fd] : bool
  ```c
  #include <unistd.h>
  return isatty((int)fd) != 0;
  ```)
;;; term/set-mode -- switch a terminal between raw and cooked mode.
;;;
;;; The single owner of the saved terminal state.  term/set-raw and
;;; term/set-cooked are thin wrappers over this, and they must be, because a
;;; `static` inside an inline-C body is local to the one C function that body
;;; lowers to: two bodies each declaring `saved_termios` get two distinct
;;; objects, and the restore then reads a zeroed one rather than what was
;;; saved.  Keeping both directions in a single body is what makes them share
;;; the same object.
;;;
;;; Parameters:
;;;   fd  -- file descriptor of the terminal
;;;   raw -- true to enter raw mode, false to restore the saved state
;;;
;;; Returns:
;;;   0 on success, -1 on error.  Restoring with nothing saved is an error.
;;;
;;; Example:
;;;   (term/set-mode 0 true)   ; => 0  ; doctest: fd 0 must be a tty (-1 otherwise)
;;;
;;; Since: Phase B2

(defn term/set-mode [fd : int raw : bool] : int
  ```c
  #include <termios.h>
  #include <unistd.h>
  #include <io.h>  /* tur:optional -- Windows only; POSIX takes the termios branch below */
  /* Windows has no termios.  The console analogue is GetConsoleMode /
   * SetConsoleMode on the underlying HANDLE: clearing ENABLE_LINE_INPUT stops
   * the line-discipline buffering, ENABLE_ECHO_INPUT stops the echo, and
   * ENABLE_PROCESSED_INPUT stops Ctrl-C being swallowed as a signal -- together
   * the three that cfmakeraw() turns off.  GetConsoleMode fails on a redirected
   * handle, which is the same "not a terminal" answer the POSIX branch's
   * tcgetpgrp guard produces, so both return -1 there.
   *
   * `have_saved` makes entering raw mode idempotent: a second entry must not
   * overwrite the saved state with the raw state it just installed, or the
   * restore would put the terminal back into raw. */
#ifdef _WIN32
  static DWORD saved_console_mode;
  static int have_saved = 0;
  HANDLE h = (HANDLE)_get_osfhandle((int)fd);
  if (h == INVALID_HANDLE_VALUE) return -1;
  DWORD mode;
  if (!GetConsoleMode(h, &mode)) return -1;
  if (raw) {
    DWORD raw_mode = (have_saved ? saved_console_mode : mode) &
                     (DWORD)~(ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT |
                              ENABLE_PROCESSED_INPUT);
    if (!SetConsoleMode(h, raw_mode)) return -1;
    if (!have_saved) { saved_console_mode = mode; have_saved = 1; }
    return 0;
  }
  if (!have_saved) return -1;
  if (!SetConsoleMode(h, saved_console_mode)) return -1;
  have_saved = 0;
  return 0;
#else
  static struct termios saved_termios;
  static int have_saved = 0;
  // Guard against SIGTTOU: if this process is not the foreground process
  // group on the terminal (e.g. running under xargs/subshell workers in the
  // doctest harness), skip terminal state modification to avoid a kernel
  // stop signal that manifests as a silent, infinite hang.
  pid_t fg = tcgetpgrp((int)fd);
  if (fg == -1 || fg != getpgrp()) return -1;
  if (raw) {
    struct termios cur, raw_t;
    if (tcgetattr((int)fd, &cur) != 0) return -1;
    raw_t = have_saved ? saved_termios : cur;
    cfmakeraw(&raw_t);
    if (tcsetattr((int)fd, TCSAFLUSH, &raw_t) != 0) return -1;
    if (!have_saved) { saved_termios = cur; have_saved = 1; }
    return 0;
  }
  if (!have_saved) return -1;
  if (tcsetattr((int)fd, TCSAFLUSH, &saved_termios) != 0) return -1;
  have_saved = 0;
  return 0;
#endif
  ```)
;;; term/set-raw -- put a terminal into raw mode (no line buffering or echo).
;;;
;;; Saves the original termios so term/set-cooked can restore it.
;;; The saved state is stored in a static variable; only one fd is
;;; tracked at a time.  Entering raw mode twice is idempotent -- the second
;;; call does not overwrite the saved state.
;;;
;;; Parameters:
;;;   fd -- file descriptor of the terminal
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (term/set-raw 0)  ; => 0  ; doctest: fd 0 must be a tty (-1 otherwise)
;;;
;;; Since: Phase B2

(defn term/set-raw [fd : int] : int (term/set-mode fd true))
;;; term/set-cooked -- restore a terminal to cooked (canonical) mode.
;;;
;;; Restores the termios state that was saved by the last term/set-raw call.
;;; With nothing saved -- no preceding term/set-raw, or a second call after
;;; the state has already been restored -- this is an error rather than a
;;; write of some default mode.
;;;
;;; Parameters:
;;;   fd -- file descriptor of the terminal
;;;
;;; Returns:
;;;   0 on success, -1 on error.
;;;
;;; Example:
;;;   (term/set-cooked 0)  ; => 0  ; doctest: fd 0 must be a tty (-1 otherwise)
;;;
;;; Since: Phase B2

(defn term/set-cooked [fd : int] : int (term/set-mode fd false))
;; -- ANSI color helpers -------------------------------------------------------
;; Each helper wraps s in the appropriate ANSI escape sequence when stdout is
;; a tty and NO_COLOR is not set; otherwise returns a plain copy of s.
;; All returned strings are heap-allocated; the caller must free them.
;;; term/bold -- wrap a string in ANSI bold codes.
;;;
;;; Parameters:
;;;   s -- NUL-terminated cstr
;;;
;;; Returns:
;;;   Heap-allocated cstr with ANSI bold, or a plain copy if not a tty or
;;;   NO_COLOR is set.  The caller must free.
;;;
;;; Example:
;;;   (term/bold "hello")  ; => "\x1b[1mhello\x1b[0m"  ; doctest: stdout must be a tty (plain copy otherwise)
;;;
;;; Since: Phase B2


(defn term/bold [s : cstr] : cstr
  ```c
  if (!isatty(1) || getenv("NO_COLOR")) return strdup(s);
  size_t slen = strlen(s);
  char *out = malloc(slen + 12);
  snprintf(out, slen + 12, "\x1b[1m%s\x1b[0m", s);
  return out;
  ```)
;;; term/dim -- wrap a string in ANSI dim codes.
;;;
;;; Parameters:
;;;   s -- NUL-terminated cstr
;;;
;;; Returns:
;;;   Heap-allocated cstr with ANSI dim, or a plain copy.  Caller must free.
;;;
;;; Example:
;;;   (term/dim "note")  ; => "\x1b[2mnote\x1b[0m"  ; doctest: stdout must be a tty (plain copy otherwise)
;;;
;;; Since: Phase B2

(defn term/dim [s : cstr] : cstr
  ```c
  if (!isatty(1) || getenv("NO_COLOR")) return strdup(s);
  size_t slen = strlen(s);
  char *out = malloc(slen + 12);
  snprintf(out, slen + 12, "\x1b[2m%s\x1b[0m", s);
  return out;
  ```)
;;; term/red -- wrap a string in ANSI red foreground codes.
;;;
;;; Parameters:
;;;   s -- NUL-terminated cstr
;;;
;;; Returns:
;;;   Heap-allocated cstr with ANSI red, or a plain copy.  Caller must free.
;;;
;;; Example:
;;;   (term/red "error")  ; => "\x1b[31merror\x1b[0m"  ; doctest: stdout must be a tty (plain copy otherwise)
;;;
;;; Since: Phase B2

(defn term/red [s : cstr] : cstr
  ```c
  if (!isatty(1) || getenv("NO_COLOR")) return strdup(s);
  size_t slen = strlen(s);
  char *out = malloc(slen + 14);
  snprintf(out, slen + 14, "\x1b[31m%s\x1b[0m", s);
  return out;
  ```)
