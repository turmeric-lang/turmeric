;;; tur/chan -- synchronous and async buffered channels for inter-fiber communication.
;;;
;;; Both channel types share the same underlying ring-buffer struct.
;;;
;;; Since: Phase T19-C
;; stdlib/chan.tur -- Synchronous and async buffered channels (Phase T19-C/D)
;;
;; Both channel types share the same underlying ring-buffer struct.
;; Chan:      blocking send/recv only.
;; AsyncChan: blocking send/recv plus non-blocking try variants.
;;
;; Channel struct layout (ChanBlock):
;;   { pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
;;     int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap; }
;;
;; Chan API (synchronous, blocking):
;;   chan-new    [cap :int]                    -- ptr<void>
;;   chan-send   [ch :ptr<void> val :int]      -- nil   (blocks when full)
;;   chan-recv   [ch :ptr<void>]               -- int   (blocks when empty)
;;   chan-free   [ch :ptr<void>]               -- nil
;;
;; AsyncChan API (buffered, non-blocking variants):
;;   async-chan-new       [cap :int]                    -- ptr<void>
;;   async-chan-send      [ch :ptr<void> val :int]      -- nil   (blocks when full)
;;   async-chan-recv      [ch :ptr<void>]               -- int   (blocks when empty)
;;   async-chan-try-send  [ch :ptr<void> val :int]      -- bool  (false = full)
;;   async-chan-try-recv  [ch :ptr<void>]               -- int   (INT64_MIN = empty)
;;   async-chan-count     [ch :ptr<void>]               -- int   (current item count)
;;   async-chan-free      [ch :ptr<void>]               -- nil
;; ---- Opaque handle newtypes (stdlib-opaque-handle-types-plan, Tier 1) ----
;; Chan and AsyncChan share the same underlying ChanBlock representation, but
;; are nominally distinct so the type checker rejects passing a synchronous
;; Chan where an AsyncChan is expected (and vice versa). Both lower to the
;; underlying :ptr<void> in the C ABI, so the inline-C bodies are unchanged.
;;
;; ---- Linearity (stdlib-linearity-affinity-plan, L1) ----
;; Chan and AsyncChan are :linear: each owns a heap-allocated ChanBlock (and its
;; pthread mutex/condvars and ring buffer) that must be destroyed exactly once
;; with chan-free / async-chan-free. Under -Xlinear the checker rejects dropping
;; a channel (TUR-E0100) or freeing it twice / using it after free (TUR-E0101).
;; The multi-use accessors -- chan-send / chan-recv and the async send/recv/try/
;; count variants -- declare their handle parameter ^borrow, so sending and
;; receiving repeatedly reads the handle without consuming it; only the *-free
;; operation consumes. See docs/archive/history/stdlib-linear-handle-borrows.md.
(defopaque ^linear Chan [A] :ptr<void>)

(defopaque ^linear AsyncChan [A] :ptr<void>)
;; ---- Chan (synchronous blocking) ----
;;; chan-new -- allocate a new synchronous blocking channel with the given capacity.
;;;
;;; Parameters:
;;;   cap -- ring-buffer capacity (number of int64_t slots)
;;;
;;; Returns:
;;;   A Chan handle to the ChanBlock.
;;;
;;; Example:
;;;   (let [ch (chan-new 8)] ...)  ; => Chan
;;;
;;; Since: Phase T19-C

(defn chan-new [A] [cap : int] : (Chan A)
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t  not_full;
      pthread_cond_t  not_empty;
      int64_t        *buf;
      int64_t         head;
      int64_t         tail;
      int64_t         count;
      int64_t         cap;
      void           *recv_waiters; /* TurSelectWaiter* -- SEL0 */
      void           *send_waiters; /* TurSelectWaiter* -- SEL0 */
  } ChanBlock;
  ChanBlock *ch = (ChanBlock *)malloc(sizeof(ChanBlock));
  if (!ch) { fprintf(stderr, "chan-new: out of memory\n"); abort(); }
  /* cap sizes the ring: 0 divided by zero at the first `% cap`, and a
     negative or huge one wrapped `8 * cap` to a tiny block the sends then
     overran (security audit WP5, M-5).  A cap under 1 is 1, as the
     interpreter's twin has always read it. */
  if (cap < 1) cap = 1;
  if ((uint64_t)cap > SIZE_MAX / sizeof(int64_t)) {
    fprintf(stderr, "chan-new: capacity %lld out of range\n", (long long)cap);
    abort();
  }
  ch->buf = (int64_t *)malloc(sizeof(int64_t) * (size_t)cap);
  if (!ch->buf) { free(ch); fprintf(stderr, "chan-new: buf oom\n"); abort(); }
  pthread_mutex_init(&ch->lock, NULL);
  pthread_cond_init(&ch->not_full, NULL);
  pthread_cond_init(&ch->not_empty, NULL);
  ch->head = 0; ch->tail = 0; ch->count = 0; ch->cap = (int64_t)cap;
  ch->recv_waiters = NULL; ch->send_waiters = NULL;
  return (int64_t)(intptr_t)ch;
  ```)
;;; chan-send -- send a value into a synchronous channel, blocking when full.
;;;
;;; Parameters:
;;;   ch  -- channel handle returned by chan-new
;;;   val -- int64_t value to enqueue
;;;
;;; Example:
;;;   (chan-send ch 42)
;;;
;;; Since: Phase T19-C

(defn chan-send [A] [^borrow ch : (Chan A) val : A] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_lock(&c->lock);
  while (c->count == c->cap) {
      if (tur_thread_cancel_requested()) {
          pthread_mutex_unlock(&c->lock);
          tur_thread_do_cancel();
      }
      struct timespec __ts;
      clock_gettime(CLOCK_REALTIME, &__ts);
      long __ns = __ts.tv_nsec + 5000000L;
      __ts.tv_sec += __ns / 1000000000L; __ts.tv_nsec = __ns % 1000000000L;
      pthread_cond_timedwait(&c->not_full, &c->lock, &__ts);
  }
  /* region-lock-hardening (stdlib-int-stand-in-audit S2): the ring buffer is
     malloc'd and outlives any region bracket this send runs inside, so a
     region-allocated payload is an escape the result walk cannot see. chan.tur
     carried no note at all before this change. */
  TUR_REGION_NOTE(val);
  c->buf[c->tail] = (int64_t)val;
  c->tail = (c->tail + 1) % c->cap;
  c->count++;
  pthread_cond_signal(&c->not_empty);
  tur_waiter_signal_one(c->recv_waiters);
  pthread_mutex_unlock(&c->lock);
  ```)
;;; chan-recv -- receive a value from a synchronous channel, blocking when empty.
;;;
;;; Parameters:
;;;   ch -- channel handle returned by chan-new
;;;
;;; Returns:
;;;   The next int64_t value dequeued from the channel.
;;;
;;; Example:
;;;   (let [v (chan-recv ch)] ...)  ; => int
;;;
;;; Since: Phase T19-C

(defn chan-recv [A] [^borrow ch : (Chan A)] : A
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_lock(&c->lock);
  while (c->count == 0) {
      if (tur_thread_cancel_requested()) {
          pthread_mutex_unlock(&c->lock);
          tur_thread_do_cancel();
      }
      struct timespec __ts;
      clock_gettime(CLOCK_REALTIME, &__ts);
      long __ns = __ts.tv_nsec + 5000000L;
      __ts.tv_sec += __ns / 1000000000L; __ts.tv_nsec = __ns % 1000000000L;
      pthread_cond_timedwait(&c->not_empty, &c->lock, &__ts);
  }
  int64_t v = c->buf[c->head];
  c->head = (c->head + 1) % c->cap;
  c->count--;
  pthread_cond_signal(&c->not_full);
  tur_waiter_signal_one(c->send_waiters);
  pthread_mutex_unlock(&c->lock);
  return v;
  ```)
;;; chan-free -- destroy a synchronous channel and release all associated memory.
;;;
;;; Parameters:
;;;   ch -- channel handle returned by chan-new
;;;
;;; Example:
;;;   (chan-free ch)
;;;
;;; Since: Phase T19-C

(defn chan-free [A] [ch : (Chan A)] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_destroy(&c->lock);
  pthread_cond_destroy(&c->not_full);
  pthread_cond_destroy(&c->not_empty);
  free(c->buf);
  free(c);
  ```)
;; ---- AsyncChan (buffered with try variants) ----
;; Same underlying struct as Chan; same constructor logic.
;;; async-chan-new -- allocate a new async buffered channel with the given capacity.
;;;
;;; Parameters:
;;;   cap -- ring-buffer capacity (number of int64_t slots)
;;;
;;; Returns:
;;;   An AsyncChan handle to the ChanBlock.
;;;
;;; Example:
;;;   (let [ch (async-chan-new 16)] ...)  ; => AsyncChan
;;;
;;; Since: Phase T19-D


(defn async-chan-new [A] [cap : int] : (AsyncChan A)
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t  not_full;
      pthread_cond_t  not_empty;
      int64_t        *buf;
      int64_t         head;
      int64_t         tail;
      int64_t         count;
      int64_t         cap;
      void           *recv_waiters;
      void           *send_waiters;
  } ChanBlock;
  ChanBlock *ch = (ChanBlock *)malloc(sizeof(ChanBlock));
  if (!ch) { fprintf(stderr, "async-chan-new: out of memory\n"); abort(); }
  /* cap sizes the ring: 0 divided by zero at the first `% cap`, and a
     negative or huge one wrapped `8 * cap` to a tiny block the sends then
     overran (security audit WP5, M-5).  A cap under 1 is 1, as the
     interpreter's twin has always read it. */
  if (cap < 1) cap = 1;
  if ((uint64_t)cap > SIZE_MAX / sizeof(int64_t)) {
    fprintf(stderr, "async-chan-new: capacity %lld out of range\n", (long long)cap);
    abort();
  }
  ch->buf = (int64_t *)malloc(sizeof(int64_t) * (size_t)cap);
  if (!ch->buf) { free(ch); fprintf(stderr, "async-chan-new: buf oom\n"); abort(); }
  pthread_mutex_init(&ch->lock, NULL);
  pthread_cond_init(&ch->not_full, NULL);
  pthread_cond_init(&ch->not_empty, NULL);
  ch->head = 0; ch->tail = 0; ch->count = 0; ch->cap = (int64_t)cap;
  ch->recv_waiters = NULL; ch->send_waiters = NULL;
  return (int64_t)(intptr_t)ch;
  ```)
;;; async-chan-send -- send a value into an async channel, blocking when full.
;;;
;;; Parameters:
;;;   ch  -- channel handle returned by async-chan-new
;;;   val -- int64_t value to enqueue
;;;
;;; Example:
;;;   (async-chan-send ch 99)
;;;
;;; Since: Phase T19-D

(defn async-chan-send [A] [^borrow ch : (AsyncChan A) val : A] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_lock(&c->lock);
  while (c->count == c->cap) {
      if (tur_thread_cancel_requested()) {
          pthread_mutex_unlock(&c->lock);
          tur_thread_do_cancel();
      }
      struct timespec __ts;
      clock_gettime(CLOCK_REALTIME, &__ts);
      long __ns = __ts.tv_nsec + 5000000L;
      __ts.tv_sec += __ns / 1000000000L; __ts.tv_nsec = __ns % 1000000000L;
      pthread_cond_timedwait(&c->not_full, &c->lock, &__ts);
  }
  /* region-lock-hardening (stdlib-int-stand-in-audit S2): the ring buffer is
     malloc'd and outlives any region bracket this send runs inside, so a
     region-allocated payload is an escape the result walk cannot see. chan.tur
     carried no note at all before this change. */
  TUR_REGION_NOTE(val);
  c->buf[c->tail] = (int64_t)val;
  c->tail = (c->tail + 1) % c->cap;
  c->count++;
  pthread_cond_signal(&c->not_empty);
  tur_waiter_signal_one(c->recv_waiters);
  pthread_mutex_unlock(&c->lock);
  ```)
;;; async-chan-recv -- receive a value from an async channel, blocking when empty.
;;;
;;; Parameters:
;;;   ch -- channel handle returned by async-chan-new
;;;
;;; Returns:
;;;   The next int64_t value dequeued from the channel.
;;;
;;; Example:
;;;   (let [v (async-chan-recv ch)] ...)  ; => int
;;;
;;; Since: Phase T19-D

(defn async-chan-recv [A] [^borrow ch : (AsyncChan A)] : A
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_lock(&c->lock);
  while (c->count == 0) {
      if (tur_thread_cancel_requested()) {
          pthread_mutex_unlock(&c->lock);
          tur_thread_do_cancel();
      }
      struct timespec __ts;
      clock_gettime(CLOCK_REALTIME, &__ts);
      long __ns = __ts.tv_nsec + 5000000L;
      __ts.tv_sec += __ns / 1000000000L; __ts.tv_nsec = __ns % 1000000000L;
      pthread_cond_timedwait(&c->not_empty, &c->lock, &__ts);
  }
  int64_t v = c->buf[c->head];
  c->head = (c->head + 1) % c->cap;
  c->count--;
  pthread_cond_signal(&c->not_full);
  tur_waiter_signal_one(c->send_waiters);
  pthread_mutex_unlock(&c->lock);
  return v;
  ```)
;;; async-chan-try-send -- attempt to send a value without blocking.
;;;
;;; Parameters:
;;;   ch  -- channel handle returned by async-chan-new
;;;   val -- int64_t value to enqueue
;;;
;;; Returns:
;;;   true if the value was enqueued; false if the channel was full.
;;;
;;; Example:
;;;   (if (async-chan-try-send ch 7) ...)  ; => bool
;;;
;;; Since: Phase T19-D

(defn async-chan-try-send [A] [^borrow ch : (AsyncChan A) val : A] : bool
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_lock(&c->lock);
  if (c->count == c->cap) {
      pthread_mutex_unlock(&c->lock);
      return 0; /* full */
  }
  /* region-lock-hardening (stdlib-int-stand-in-audit S2): the ring buffer is
     malloc'd and outlives any region bracket this send runs inside, so a
     region-allocated payload is an escape the result walk cannot see. chan.tur
     carried no note at all before this change. */
  TUR_REGION_NOTE(val);
  c->buf[c->tail] = (int64_t)val;
  c->tail = (c->tail + 1) % c->cap;
  c->count++;
  pthread_cond_signal(&c->not_empty);
  tur_waiter_signal_one(c->recv_waiters);
  pthread_mutex_unlock(&c->lock);
  return 1; /* sent */
  ```)
;; async-chan-try-recv: returns INT64_MIN when the channel is empty.
;; Callers should compare the result with INT64_MIN to detect "no item".
;;; async-chan-try-recv -- attempt to receive a value without blocking.
;;;
;;; Parameters:
;;;   ch -- channel handle returned by async-chan-new
;;;
;;; Returns:
;;;   The dequeued int64_t value, or INT64_MIN if the channel was empty.
;;;
;;; Example:
;;;   (let [v (async-chan-try-recv ch)] ...)  ; => int (INT64_MIN = empty)
;;;
;;; Since: Phase T19-D

(defn async-chan-try-recv [A] [^borrow ch : (AsyncChan A)] : A
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_lock(&c->lock);
  if (c->count == 0) {
      pthread_mutex_unlock(&c->lock);
      return INT64_MIN; /* empty sentinel */
  }
  int64_t v = c->buf[c->head];
  c->head = (c->head + 1) % c->cap;
  c->count--;
  pthread_cond_signal(&c->not_full);
  tur_waiter_signal_one(c->send_waiters);
  pthread_mutex_unlock(&c->lock);
  return v;
  ```)
;;; async-chan-count -- return the number of items currently in an async channel.
;;;
;;; Parameters:
;;;   ch -- channel handle returned by async-chan-new
;;;
;;; Returns:
;;;   The current item count as an int.
;;;
;;; Example:
;;;   (async-chan-count ch)  ; => int
;;;
;;; Since: Phase T19-D

(defn async-chan-count [A] [^borrow ch : (AsyncChan A)] : int
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_lock(&c->lock);
  int64_t n = c->count;
  pthread_mutex_unlock(&c->lock);
  return n;
  ```)
;;; async-chan-free -- destroy an async channel and release all associated memory.
;;;
;;; Parameters:
;;;   ch -- channel handle returned by async-chan-new
;;;
;;; Example:
;;;   (async-chan-free ch)
;;;
;;; Since: Phase T19-D

(defn async-chan-free [A] [ch : (AsyncChan A)] : nil
  ```c
  typedef struct {
      pthread_mutex_t lock; pthread_cond_t not_full; pthread_cond_t not_empty;
      int64_t *buf; int64_t head; int64_t tail; int64_t count; int64_t cap;
      void *recv_waiters; void *send_waiters;
  } ChanBlock;
  ChanBlock *c = (ChanBlock *)(intptr_t)ch;
  pthread_mutex_destroy(&c->lock);
  pthread_cond_destroy(&c->not_full);
  pthread_cond_destroy(&c->not_empty);
  free(c->buf);
  free(c);
  ```)
