;;; tur/arrow -- arrow combinators over the (->) function arrow, in two surfaces.
;;;
;;; Bare functions (the simple path): arr, >>>, arrow-first,
;;; arrow-second, par-comp, arrow-split, arrow-const, and arrow-dup as plain
;;; functions -- use these when you do not need polymorphism over the arrow
;;; constructor.
;;;
;;; Typeclass dispatch (parametric over any Arrow): the Haskell-style Arrow /
;;; ArrowZero / ArrowPlus / ArrowChoice / ArrowLoop / ArrowApply hierarchy with
;;; its (->) instances, declared lower in this file. Use these when you want
;;; code resolved through the instance dictionary. The two surfaces share the
;;; method names arr / >>>: a bare call dispatches to the matching instance when
;;; the receiver's type selects one, and falls back to the bare combinator
;;; otherwise (see docs/archive/history/typeclass-methods-share-value-namespace-with-defns.md).
;;;
;;; Feedback (ArrowLoop): arrow-loop-lazy, arrow-loop-fix, and arrow-loop-delay
;;; close the d output of an arrow back onto its d input, each at a different
;;; time -- see the "ArrowLoop feedback cells" section below, and
;;; docs/guides/arrows-guide.md ("ArrowLoop -- feedback").
;;;
;;; The typeclass layer was scaled back in
;;; docs/archive/history/stdlib-arrow-scaleback-plan.md and reintroduced -- then merged
;;; back into this single module -- per
;;; docs/archive/history/stdlib-arrow-typeclass-reintroduction-plan.md.
;;;
;;; Since: Phase CA0
;; =============================================================================
;; Closure dispatch convention
;; =============================================================================
;; Arrow combinators normalize their function arguments to fat closures via
;; ^fat parameters: a captureless function (a bare C pointer) is auto-shimmed
;; into a fat box at the call site, and a capturing closure is already a fat
;; box.  Every helper then dispatches uniformly through the fat protocol
;; (TUR_APPLY1, which reads the thunk from slot 0 and passes the box as the
;; environment), or by calling the closure directly in Turmeric (a :ptr<void>
;; direct call already fat-dispatches).  This replaces the former
;; __arrow_call1/__arrow_call2 thin int64 casts, which segfaulted on capturing
;; closures.  See docs/archive/history/closure-representation-unification-plan.md.
;;; arr -- lift a function to an arrow (identity for function arrows).
;;;
;;; Parameters:
;;;   f -- the function to lift
;;;
;;; Returns:
;;;   The function itself.
;;;
;;; Example:
;;;   (arr (fn [x] (+ x 1)))  ; => identity for functions
(defn arr [^fat f] f)
;;; >>> -- compose two function arrows sequentially (register-class-correct).
;;;
;;; Polymorphic over the element type: the type parameters A, B, C are bound
;;; at each call site from the declared types of f and g, so a float pipeline
;;; emits a double-returning inner body dispatched through
;;; tur_thunk_double_double_t (register-class-correct), and an int pipeline
;;; uses the standard int64 thunk ABI.
;;;
;;; Parameters:
;;;   f -- first arrow (A -> B)
;;;   g -- second arrow (B -> C)
;;;
;;; Returns:
;;;   A closure (fn [A] C) that applies f then g.  Typed as a function, not
;;;   ptr<void>, so the result can be called directly at its element types.
;;;
;;; Example:
;;;   ((>>> (fn [x : float] : float (+ x 1.0))
;;;         (fn [x : float] : float (* x 2.0))) 3.0)  ; => 8.0
;;;
;;; Since: Phase CA1

(defn >>> [A B C] [^fat f : (fn [A] #fx{} B) ^fat g : (fn [B] #fx{} C)] : (fn [A]
                                                                            #fx{}
                                                                            C)
  (let [fv f
        gv g]
    (fn [x : A] : C (gv (fv x)))))
;; The arrow-pair helpers operate on heap two-slot pairs.  They use a local
;; layout-compatible struct `P { int64_t e1; int64_t e2; }` rather than
;; tuple.tur's `Tuple2` typedef so this module stays self-contained: a
;; `tur build <dir>` of a module that (load ...)s arrow.tur runs no whole-program
;; stdlib auto-load, so an external `Tuple2` would be undefined in the per-module
;; .c.  `P` is byte-for-byte the erased `Tuple2` layout (both {int64_t e1; e2;}),
;; so values produced by tuple.tur's `(tuple2 ...)` flow through these helpers
;; and vice versa.  This mirrors the self-contained `__ac_pair_*` helpers in the
;; Arrow [(->)] instance below.  See
;; docs/archive/history/load-not-expanded-in-imported-or-project-modules.md.
;;; __arrow_pair_first -- inline-C: apply fv to e1 of a heap pair *p,
;;; return a new heap pair.  Used by arrow-first.

(defn __arrow_pair_first [fv p] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *src = (P *)(intptr_t)p;
  P *r   = (P *)malloc(sizeof(P));
  r->e1 = TUR_APPLY1(fv, src->e1);
  r->e2 = src->e2;
  return (int64_t)(intptr_t)r;
  ```)
;;; __arrow_pair_second -- inline-C: apply fv to e2 of a heap pair *p,
;;; return a new heap pair.  Used by arrow-second.

(defn __arrow_pair_second [fv p] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *src = (P *)(intptr_t)p;
  P *r   = (P *)malloc(sizeof(P));
  r->e1 = src->e1;
  r->e2 = TUR_APPLY1(fv, src->e2);
  return (int64_t)(intptr_t)r;
  ```)
;;; __arrow_pair_par -- inline-C: apply fv to e1 and gv to e2 of *p.

(defn __arrow_pair_par [fv gv p] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *src = (P *)(intptr_t)p;
  P *r   = (P *)malloc(sizeof(P));
  r->e1 = TUR_APPLY1(fv, src->e1);
  r->e2 = TUR_APPLY1(gv, src->e2);
  return (int64_t)(intptr_t)r;
  ```)
;;; __arrow_pair_split -- inline-C: produce a heap pair from (fv x, gv x).

(defn __arrow_pair_split [fv gv x] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *r = (P *)malloc(sizeof(P));
  r->e1 = TUR_APPLY1(fv, x);
  r->e2 = TUR_APPLY1(gv, x);
  return (int64_t)(intptr_t)r;
  ```)
;;; __arrow_pair_dup -- inline-C: produce a heap pair with both fields = x.

(defn __arrow_pair_dup [x] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *r = (P *)malloc(sizeof(P));
  r->e1 = x;
  r->e2 = x;
  return (int64_t)(intptr_t)r;
  ```)
;;; arrow-first -- apply a function to the first component of a Tuple2.
;;;
;;; Parameters:
;;;   f -- function to apply
;;;
;;; Returns:
;;;   A function on Tuple2 that applies f to the first field.
;;;
;;; Example:
;;;   ((arrow-first (fn [x] (+ x 1))) <heap Tuple2 (5, 10)>)  ; => Tuple2(6, 10)

(defn arrow-first [^fat f] (let [fv f] (fn [p] (__arrow_pair_first fv p))))
;;; arrow-second -- apply a function to the second component of a Tuple2.
;;;
;;; Parameters:
;;;   f -- function to apply
;;;
;;; Returns:
;;;   A function on Tuple2 that applies f to the second field.
;;;
;;; Example:
;;;   ((arrow-second (fn [x] (+ x 1))) <heap Tuple2 (5, 10)>)  ; => Tuple2(5, 11)

(defn arrow-second [^fat f] (let [fv f] (fn [p] (__arrow_pair_second fv p))))
;;; par-comp -- parallel composition of two functions on Tuple2 types.
;;;
;;; Parameters:
;;;   f -- function a -> b
;;;   g -- function c -> d
;;;
;;; Returns:
;;;   A function on Tuple2 a c -> Tuple2 b d:
;;;   (par-comp f g)(tuple2 x y) = tuple2(f x, g y).
;;;
;;; Example:
;;;   ((par-comp inc double) (tuple2 1 2))  ; => Tuple2(2, 4)

(defn par-comp [a b c d ^fat f ^fat g]
  (let [fv f
        gv g]
    (fn [p] (__arrow_pair_par fv gv p))))
;;; arrow-split -- duplicate input and apply two functions, returning a Tuple2.
;;;
;;; Parameters:
;;;   f -- function a -> b
;;;   g -- function a -> c
;;;
;;; Returns:
;;;   A function a -> Tuple2 b c: (arrow-split f g)(x) = tuple2(f x, g x).
;;;
;;; Example:
;;;   ((arrow-split inc double) 3)  ; => Tuple2(4, 6)

(defn arrow-split [a b c ^fat f ^fat g]
  (let [fv f
        gv g]
    (fn [x] (__arrow_pair_split fv gv x))))
;; No bare <<< (reverse composition) free defn: write (>>> f g) with the
;; arguments in the order you want them applied. Reverse composition is
;; available through the typeclass surface instead -- the Arrow [(->)] instance
;; below provides <<< (operator mangling now keeps >>> and <<< distinct).
;;; arrow-const -- arrow that ignores its input and always returns v.
;;;
;;; Parameters:
;;;   v -- the constant value to return
;;;
;;; Returns:
;;;   An arrow (any -> v).
;;;
;;; Example:
;;;   ((arrow-const 42) 999)  ; => 42
;;;
;;; Since: Phase B2


(defn arrow-const [v] (let [cv v] (fn [_] cv)))
;;; arrow-dup -- arrow that duplicates its input into a Tuple2.
;;;
;;; Parameters:
;;;   x -- the value to duplicate
;;;
;;; Returns:
;;;   A Tuple2 of x with itself: Tuple2(x, x).
;;;
;;; Example:
;;;   (tuple2-1st (arrow-dup 7))  ; => 7
;;;
;;; Since: Phase B2

(defn arrow-dup [x] : int (__arrow_pair_dup x))
;; =============================================================================
;; Typeclass dispatch surface
;; =============================================================================
;; The Haskell-style Arrow hierarchy over the (->) function arrow. Where the
;; bare layer above exposes arr, >>>, arrow-first, ... as plain functions, the
;; classes below let code be written parametric over any Arrow instance and
;; resolved through the instance dictionary. The shared names arr / >>> coexist
;; with the bare defns: a bare call dispatches to the matching instance when the
;; receiver's type selects one, else falls back to the bare combinator.
;;
;; The <<< / >>> pair relies on operator-name mangling: each sigil method
;; encodes to a distinct C identifier (>>> -> _gt_gt_gt, <<< -> _lt_lt_lt,
;; +++ -> _pl_pl_pl, ||| -> _ba_ba_ba) instead of colliding on ___.
;;
;; Product representation: first/second/arrow-loop/app thread a heap-allocated
;; pair of two int64 slots (the shape the bare layer uses); see the __ac_pair_*
;; helpers. This is T3 Option A (reuse heap pairs); a zero-allocation product is
;; a future optimisation.
;; ---------------------------------------------------------------------------

(load "stdlib/either.tur")
;;; __ac_pair_first -- inline-C: apply fv to slot 0 of a heap pair, copy slot 1.

(defn __ac_pair_first [fv p] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *s = (P *)(intptr_t)p;
  P *r = (P *)malloc(sizeof(P));
  r->e1 = TUR_APPLY1(fv, s->e1);
  r->e2 = s->e2;
  return (int64_t)(intptr_t)r; ```)
;;; __ac_pair_second -- inline-C: copy slot 0 of a heap pair, apply fv to slot 1.

(defn __ac_pair_second [fv p] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *s = (P *)(intptr_t)p;
  P *r = (P *)malloc(sizeof(P));
  r->e1 = s->e1;
  r->e2 = TUR_APPLY1(fv, s->e2);
  return (int64_t)(intptr_t)r; ```)
;; =============================================================================
;; ArrowLoop feedback cells
;; =============================================================================
;; The fed-back `d` component is handed to the looped arrow as a LoopCell: a
;; two-word heap cell `{ int64_t filled; int64_t value; }`.  The cell is the
;; strict-language stand-in for Haskell's lazy knot.  Turmeric evaluates the
;; looped arrow eagerly, so `d` cannot simply BE the value that same run is
;; about to produce -- but indirecting through a cell splits the two events
;; apart, so a read that happens LATER sees a value written EARLIER:
;;
;;   arrow-loop        the cell starts empty and is filled with the arrow's d
;;                     output once the run returns.  Forcing it during the run
;;                     is the black hole (a `<<loop>>` panic); forcing it
;;                     through a handle the arrow parked in its own c output is
;;                     true lazy feedback -- the c value observes the d that
;;                     the very same run produced.
;;   arrow-loop-fix    the cell starts filled with a seed and is re-filled once
;;                     per iteration until d stops moving: the strict fixpoint,
;;                     for a looped arrow that must read d immediately.
;;   arrow-loop-delay  the cell starts filled with a seed and carries the
;;                     PREVIOUS call's d forward: a unit delay in the feedback
;;                     path.  Always total, and the shape signal-processing and
;;                     state-machine arrows actually want.
;;
;; All three put the same thing in slot 1 of the input pair, so one looped
;; arrow works unchanged under any of them.  A Turmeric-level arrow reads the
;; slot with loop-cell-of + loop-cell-force; an inline-C arrow redeclares the
;; layout locally, exactly as the pair helpers redeclare P:
;;
;;   typedef struct { int64_t filled; int64_t value; } LC;
;;
;; See docs/guides/arrows-guide.md ("ArrowLoop -- feedback").
;; ---------------------------------------------------------------------------
;;; LoopCell -- the fed-back `d` slot of an ArrowLoop, as a handle.
;;;
;;; Carrier is :int (the erased two-slot pair carrier the arrow layer runs on),
;;; but the newtype keeps an arbitrary integer out of loop-cell-force: only a
;;; cell minted by one of the arrow-loop combinators is accepted.
;;;
;;; Since: arrowloop-lazy-feedback

(defopaque LoopCell :int)
;;; loop-cell-of -- read slot 1 of an ArrowLoop input pair as a LoopCell.
;;;
;;; The arrow layer erases every slot to the int64 carrier, so a looped arrow
;;; written in Turmeric receives the feedback cell as a plain int.  This is the
;;; one sanctioned way back to the handle type.
;;;
;;; Parameters:
;;;   slot -- the erased slot-1 value handed to the looped arrow
;;;
;;; Returns:
;;;   The same handle, typed as a LoopCell.
;;;
;;; Example:
;;;   (loop-cell-force (loop-cell-of d))  ; => the fed-back value
;;;
;;; Since: arrowloop-lazy-feedback

(defn loop-cell-of [slot : int] : LoopCell ```c return slot; ```)
;;; loop-cell-ready? -- has the fed-back value been written yet?
;;;
;;; False exactly inside an arrow-loop run, before the looped arrow has
;;; returned its d output.  arrow-loop-fix and arrow-loop-delay seed the cell
;;; up front, so it reads true there from the first call.
;;;
;;; Parameters:
;;;   c -- the feedback cell
;;;
;;; Returns:
;;;   true when loop-cell-force would succeed, false when it would black-hole.
;;;
;;; Example:
;;;   (if (loop-cell-ready? c) (loop-cell-force c) 0)
;;;
;;; Since: arrowloop-lazy-feedback

(defn loop-cell-ready? [c : LoopCell] : bool
  ```c
  typedef struct { int64_t filled; int64_t value; } LC;
  LC *cell = (LC *)(intptr_t)c;
  return cell && cell->filled ? true : false; ```)
;;; loop-cell-force -- read the fed-back value out of a feedback cell.
;;;
;;; Panics with `<<loop>>` when the value is not there yet -- that is the black
;;; hole, and it is a genuine error in the looped arrow (it demanded its own
;;; output).  Guard with loop-cell-ready? when a miss is expected.
;;;
;;; Parameters:
;;;   c -- the feedback cell
;;;
;;; Returns:
;;;   The fed-back d value, in the erased arrow carrier.
;;;
;;; Example:
;;;   (let [lp (arrow-loop step)]
;;;     (loop-cell-force (loop-cell-of (lp 7))))
;;;
;;; Since: arrowloop-lazy-feedback

(defn loop-cell-force [c : LoopCell] : int
  ```c
  typedef struct { int64_t filled; int64_t value; } LC;
  LC *cell = (LC *)(intptr_t)c;
  if (!cell) {
    tur_panic("loop-cell-force: null feedback cell");
    return 0;
  }
  if (!cell->filled) {
    tur_panic("<<loop>>: ArrowLoop feedback forced before the looped arrow produced it");
    return 0;
  }
  return cell->value; ```)
;;; __ac_cell_new -- inline-C: allocate a feedback cell, filled or empty.

(defn __ac_cell_new [filled : int value : int] : LoopCell
  ```c
  typedef struct { int64_t filled; int64_t value; } LC;
  LC *cell = (LC *)malloc(sizeof(LC));
  cell->filled = filled;
  cell->value  = value;
  return (int64_t)(intptr_t)cell; ```)
;;; __ac_loop_step -- inline-C: the lazy (knot-tying) ArrowLoop step.  Allocate
;;; an EMPTY feedback cell, run the looped arrow fv on the pair (b, cell), fill
;;; the cell with the arrow's d output, and project its c output.  A read of
;;; the cell that happens after the run -- through a handle fv parked in c --
;;; therefore sees the d this very run produced.  See arrow-loop.

(defn __ac_loop_step [fv b] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  typedef struct { int64_t filled; int64_t value; } LC;
  LC *cell = (LC *)malloc(sizeof(LC));
  cell->filled = 0;
  cell->value  = 0;
  P *in = (P *)malloc(sizeof(P));
  in->e1 = b;
  in->e2 = (int64_t)(intptr_t)cell;
  int64_t rp = TUR_APPLY1(fv, (int64_t)(intptr_t)in);
  P *r = (P *)(intptr_t)rp;
  /* Tie the knot: the d output becomes the fed-back value, visible to every
   * deferred read of the cell from here on. */
  cell->value  = r->e2;
  cell->filled = 1;
  return r->e1; ```)
;;; __ac_loop_fix_step -- inline-C: the strict fixpoint ArrowLoop step.  Seed a
;;; filled feedback cell with d0, then re-run fv on (b, cell) -- refilling the
;;; cell from each d output -- until d stops moving or the fuel runs out.
;;; Returns the c output of the last iteration.

(defn __ac_loop_fix_step [fv b d0 : int fuel : int] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  typedef struct { int64_t filled; int64_t value; } LC;
  LC *cell = (LC *)malloc(sizeof(LC));
  cell->filled = 1;
  cell->value  = d0;
  int64_t c = 0;
  int64_t budget = fuel < 1 ? 1 : fuel;   /* always run at least once */
  for (int64_t i = 0; i < budget; i++) {
    P *in = (P *)malloc(sizeof(P));
    in->e1 = b;
    in->e2 = (int64_t)(intptr_t)cell;
    int64_t rp = TUR_APPLY1(fv, (int64_t)(intptr_t)in);
    P *r = (P *)(intptr_t)rp;
    c = r->e1;
    if (r->e2 == cell->value) break;   /* reached the fixpoint */
    cell->value = r->e2;
  }
  return c; ```)
;;; __ac_loop_delay_step -- inline-C: one step of the unit-delay ArrowLoop.  The
;;; caller owns the cell across calls, so slot 1 carries the PREVIOUS call's d
;;; output (the seed on the first call); the fresh d output replaces it.

(defn __ac_loop_delay_step [fv cell : LoopCell b] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  typedef struct { int64_t filled; int64_t value; } LC;
  LC *lc = (LC *)(intptr_t)cell;
  P *in = (P *)malloc(sizeof(P));
  in->e1 = b;
  in->e2 = (int64_t)(intptr_t)lc;
  int64_t rp = TUR_APPLY1(fv, (int64_t)(intptr_t)in);
  P *r = (P *)(intptr_t)rp;
  lc->value  = r->e2;
  lc->filled = 1;
  return r->e1; ```)
;;; __ac_app -- inline-C: ArrowApply for (->).  The input pair carries an arrow
;;; in slot 0 and its argument in slot 1; apply the arrow to the argument.

(defn __ac_app [p] : int
  ```c
  typedef struct { int64_t e1; int64_t e2; } P;
  P *s = (P *)(intptr_t)p;
  return TUR_APPLY1(s->e1, s->e2); ```)
;;; Category [arr] -- the base of the arrow hierarchy: an identity arrow and
;;; sequential composition.
;;;
;;; Methods:
;;;   ident -- the identity arrow (nullary; the result is the arrow itself).
;;;            Resolved by return-type / unique-instance dispatch (there is no
;;;            argument to dispatch on); see
;;;            docs/archive/history/return-type-dispatch-nullary-arrow-methods-plan.md.
;;;   comp  -- left-to-right composition: run f, then g (comp f g == g . f over
;;;            (->)).  Distinct method name from Arrow's >>> so the two surfaces
;;;            coexist without an operator-mangling collision.
;;;
;;; A second instance (e.g. Kleisli, stdlib/kleisli.tur) makes a bare `(ident)`
;;; with no expected type ambiguous -- the Mechanism-B uniqueness gate then
;;; fires the existing ambiguity error, resolvable by ascription
;;; (`(:: (ident) :Kleisli)`).
;;;
;;; Since: Phase CA2

(defclass Category [arr] (ident [] : arr) (comp [f g] : arr))
;;; Arrow [a] -- lift functions into arrows and wire them together.
;;;
;;; Methods:
;;;   arr    -- lift a plain function (b -> c) into an arrow a b c.
;;;   >>>    -- left-to-right composition: run the left arrow, then the right.
;;;   <<<    -- right-to-left composition (flipped >>>).
;;;
;;; `>>>` and `<<<` spell their arrows -- `(a b c)` is the arrow from b to c,
;;; `(fn [b] c)` at the `(->)` head -- so a call with concrete functions
;;; specializes the instance at their element types, and the composed closure
;;; is called at exactly those types.
;;;   first  -- act on the first component of a pair, passing the second through.
;;;   second -- act on the second component of a pair, passing the first through.
;;;
;;; Superclass: Category, so an `[^Arrow A]` body may also use `ident`/`comp`.
;;;
;;; Since: Phase CA1

(defclass Arrow [a]
  [(Category a)]
  (arr [f] : a)
  (>>> [f : (a b c) g : (a c d)] : (a b d))
  (<<< [f : (a c d) g : (a b c)] : (a b d))
  (first [f] : a)
  (second [f] : a))
;;; ArrowZero [a] -- an arrow with a distinguished empty/zero arrow.
;;;
;;; Methods:
;;;   zero-arrow -- the arrow with no behaviour (nullary; result is the arrow).
;;;
;;; The function arrow (->) is deliberately NOT made an instance: a total
;;; function b -> c with no input requires choosing an inhabitant of c, which
;;; (->) cannot do generically.  The class is declared so other arrow
;;; constructors (e.g. a future Kleisli) can instantiate it.
;;;
;;; Superclass: Category -- not Arrow, as Haskell has it.  stdlib/kleisli.tur's
;;; Kleisli is a Category with an honest zero arrow and deliberately no Arrow
;;; instance, and the zero-arrow laws (`zero >>> f = zero`) need only
;;; composition.
;;;
;;; Since: Phase CA1

(defclass ArrowZero [a] [(Category a)] (zero-arrow [] : a))
;;; ArrowPlus [a] -- an ArrowZero whose arrows form a monoid under choice.
;;;
;;; Methods:
;;;   plus-arrow -- combine two arrows (the monoid append).
;;;
;;; Like ArrowZero, (->) is not instantiated here; the class exists for arrow
;;; constructors that carry a sensible alternative/merge.
;;;
;;; Superclass: ArrowZero.
;;;
;;; Since: Phase CA1

(defclass ArrowPlus [a] [(ArrowZero a)] (plus-arrow [f g] : a))
;;; ArrowChoice [a] -- route an arrow over one arm of a sum (Either).
;;;
;;; Methods:
;;;   left  -- apply the arrow to a Left payload, pass Right through unchanged.
;;;   right -- apply the arrow to a Right payload, pass Left through unchanged.
;;;   +++   -- run the left arrow on Left, the right arrow on Right (fan over sum).
;;;   |||   -- run either arrow and collapse both arms to a common result.
;;;
;;; Requires the Either sum type (stdlib/either.tur).
;;;
;;; Superclass: Arrow.
;;;
;;; Since: Phase CA1

(defclass ArrowChoice [a]
  [(Arrow a)]
  (left [f] : a)
  (right [f] : a)
  (+++ [f g] : a)
  (||| [f g] : a))
;;; ArrowLoop [a] -- feed part of an arrow's output back as input.
;;;
;;; Methods:
;;;   arrow-loop -- given an arrow a (b, d) (c, d), produce an arrow a b c by
;;;                 feeding the d output back as the d input.
;;;
;;; Turmeric is strict, so the fed-back d is handed to the looped arrow as a
;;; LoopCell rather than as a bare value: the (->) instance runs the arrow on
;;; (b, empty-cell) and fills the cell with the d output afterwards.  An arrow
;;; that ignores d behaves exactly as before; an arrow that parks the cell in
;;; its c output and forces it later gets true lazy feedback; an arrow that
;;; forces the cell mid-run hits the black hole (a `<<loop>>` panic) instead of
;;; silently reading a sentinel.
;;;
;;; For a looped arrow that must read d *immediately*, use the bare
;;; arrow-loop-fix (iterate to a fixpoint) or arrow-loop-delay (a unit delay in
;;; the feedback path) below.
;;;
;;; Superclass: Arrow.
;;;
;;; Since: Phase CA1 (lazy feedback: arrowloop-lazy-feedback)

(defclass ArrowLoop [a] [(Arrow a)] (arrow-loop [f] : a))
;;; ArrowApply [a] -- apply an arrow that is itself a value flowing through.
;;;
;;; Methods:
;;;   app -- the arrow a (a b c, b) c that applies its first component (an
;;;          arrow) to its second (nullary; result is the arrow).
;;;
;;; Superclass: Arrow.
;;;
;;; Since: Phase CA1

(defclass ArrowApply [a] [(Arrow a)] (app [] : a))
;;; Arrow [(->)] -- the function arrow: arr is the identity (a plain function
;;; is already an arrow), >>> / <<< are composition, first / second act on a
;;; heap pair.

(definstance Arrow [(->)]
  (arr [f] f)
  (>>> [f g] (fn [x : b] : d (g (f x))))
  (<<< [f g] (fn [x : b] : d (f (g x))))
  (first [f] (fn [p] (__ac_pair_first f p)))
  (second [f] (fn [p] (__ac_pair_second f p))))
;;; ArrowChoice [(->)] -- map an arrow over one arm of an Either, passing the
;;; other arm through; +++ fans two arrows over the two arms, ||| collapses them.

(definstance ArrowChoice [(->)]
  (left [f] (fn [e] (match e (Left b) (Left (f b)) (Right d) (Right d))))
  (right [f] (fn [e] (match e (Left b) (Left b) (Right d) (Right (f d)))))
  (+++ [f g] (fn [e] (match e (Left b) (Left (f b)) (Right d) (Right (g d)))))
  (||| [f g] (fn [e] (match e (Left b) (f b) (Right d) (g d)))))
;;; ArrowLoop [(->)] -- lazy (knot-tying) feedback: run the arrow on
;;; (b, empty-cell), fill the cell with the d output, project the c output.

(definstance ArrowLoop [(->)] (arrow-loop [f] (fn [b] (__ac_loop_step f b))))
;;; arrow-loop-lazy -- the bare-surface twin of the ArrowLoop [(->)] instance.
;;;
;;; Feeds the d output back through a LoopCell that is filled only once the
;;; looped arrow returns.  Reads of the cell that the arrow defers -- by parking
;;; the handle in its own c output -- observe the d that this same run produced;
;;; a read made during the run is the `<<loop>>` black hole.
;;;
;;; Parameters:
;;;   f -- the looped arrow, a (b, LoopCell) -> (c, d) over the heap-pair layout
;;;
;;; Returns:
;;;   A ptr<void> closure b -> c.
;;;
;;; Example:
;;;   ;; f parks the cell in c, so forcing c after the loop yields d = b * 10.
;;;   (let [lp (arrow-loop-lazy park-cell-step)]
;;;     (loop-cell-force (loop-cell-of (lp 7))))  ; => 70
;;;
;;; Since: arrowloop-lazy-feedback

(defn arrow-loop-lazy [^fat f] : ptr<void>
  (let [fv f] (fn [b : int] : int (__ac_loop_step fv b))))
;;; arrow-loop-fix -- feedback by iteration to a fixpoint.
;;;
;;; For a looped arrow that reads d *strictly*: the cell is seeded with d0 and
;;; the arrow is re-run, each time seeing the previous run's d, until d stops
;;; changing or fuel iterations have elapsed.  The result is the c output of the
;;; last iteration.  Non-convergence is not an error here -- it simply spends
;;; the fuel and returns the last c -- so a diverging arrow costs a bounded
;;; amount of work rather than hanging.
;;;
;;; Parameters:
;;;   f    -- the looped arrow, a (b, LoopCell) -> (c, d)
;;;   d0   -- the seed for the fed-back component
;;;   fuel -- maximum iterations; anything below 1 runs exactly one pass
;;;
;;; Returns:
;;;   A ptr<void> closure b -> c.
;;;
;;; Example:
;;;   ;; newton-step: d' = (d + b/d)/2, c = d  -- integer sqrt by fixpoint.
;;;   ((arrow-loop-fix newton-step 1 32) 144)  ; => 12
;;;
;;; Since: arrowloop-lazy-feedback

(defn arrow-loop-fix [^fat f d0 : int fuel : int] : ptr<void>
  (let [fv f
        s  d0
        n  fuel]
    (fn [b : int] : int (__ac_loop_fix_step fv b s n))))
;;; arrow-loop-delay -- feedback through a unit delay (step-indexed).
;;;
;;; The fed-back component persists across calls: call n sees the d that call
;;; n-1 produced, and the first call sees d0.  This is the always-total member
;;; of the family -- there is no black hole and no iteration -- and it is the
;;; feedback shape signal-processing and state-machine arrows want, where the
;;; loop is closed over time rather than within a single step.
;;;
;;; The returned arrow is stateful: it owns one cell, so each call advances the
;;; same feedback line.  Call arrow-loop-delay again for an independent line.
;;;
;;; Parameters:
;;;   f  -- the looped arrow, a (b, LoopCell) -> (c, d)
;;;   d0 -- the value the first call sees fed back
;;;
;;; Returns:
;;;   A ptr<void> closure b -> c, carrying its own feedback state.
;;;
;;; Example:
;;;   ;; sum-step: d' = d + b, c = d + b  -- a running total.
;;;   (let [acc (arrow-loop-delay sum-step 0)]
;;;     (acc 1) (acc 2) (acc 3))  ; => 1, 3, 6
;;;
;;; Since: arrowloop-lazy-feedback

(defn arrow-loop-delay [^fat f d0 : int] : ptr<void>
  (let [fv   f
        cell (__ac_cell_new 1 d0)]
    (fn [b : int] : int (__ac_loop_delay_step fv cell b))))
;;; ArrowApply [(->)] -- the apply arrow: run the arrow in slot 0 on slot 1.

(definstance ArrowApply [(->)] (app [] (fn [p] (__ac_app p))))
;;; Category [(->)] -- the function arrow: `ident` is the plain identity
;;; function, `comp` is forward composition.  The eta-expanded `(fn [x] x)`
;;; (rather than a bare `identity` reference) is required so the dispatched
;;; nullary call keeps a concrete result type -- see
;;; docs/archive/history/instance-method-returning-untyped-param-loses-result-type.md.

(definstance Category [(->)]
  (ident [] (fn [x] x))
  (comp [f g] (fn [x] (g (f x)))))
