;;; tur/typeclass-ord -- the Ord typeclass, its primitive instances, and max/min.
;;;
;;; Auto-loaded, for the same reason stdlib/typeclass-eq.tur is: `max` and
;;; `min` have to be reachable from a bare `defmodule` body in project mode
;;; without importing anything.
;;;
;;; They used to be MACROS in stdlib/macros.tur, which is auto-loaded -- so
;;; deleting them there (lattice-vocabulary-plan L1, in favor of Ord-dispatched
;;; generics) silently took `min`/`max` out of the prelude, because the
;;; replacements landed in the NON-auto-loaded monolith stdlib/typeclass.tur.
;;; `tests/run-build-project.sh`'s `build-project-prelude-minmax` caught it.
;;; Splitting Ord out the way Eq is split restores the reach without bringing
;;; back the macros.
;;;
;;; The full stdlib/typeclass.tur (Num, Clone, Show, ...) still loads on demand
;;; and does NOT redefine any of this -- it complements these stubs, exactly as
;;; it does for Eq.
;;;
;;; Since: lattice-vocabulary-plan L1

;;; Ord -- values with a total order.
;;;
;;; Parameters:
;;;   a -- the type to order
;;;
;;; Methods:
;;;   lt?  -- `x` sorts strictly before `y`
;;;   lte? -- `x` sorts before `y` or is equal to it
;;;   gt?  -- `x` sorts strictly after `y`
;;;   gte? -- `x` sorts after `y` or is equal to it
;;;
;;; Every instance implements all four; they must agree with each other and
;;; with `eq?`.  `max` / `min` are ordinary constrained generics over Ord
;;; (defined below), not methods -- so an instance implements nothing extra to
;;; get them.
;;;
;;; Laws:
;;;   (lte? x x)                                  = true
;;;   (lte? x y) and (lte? y x) imply (eq? x y)
;;;   (lte? x y) and (lte? y z) imply (lte? x z)
;;;   (lte? x y) or (lte? y x)                    = true
;;;   (lt? x y)                                   = (gt? y x)
;;;
;;; Example:
;;;   (lt? 2 3)       ; => true
;;;   (max 2.5 7.1)   ; => 7.1
;;;   (min "a" "b")   ; => "a"
;;;
;;; Superclass: Eq.  A `[^Ord A]` constraint also licenses `eq?`, and every
;;; `Ord` instance needs an `Eq` instance for the same type (TUR-E0393
;;; otherwise).
;;;
;;; Since: Phase 15 (max/min: lattice-vocabulary-plan L1)
;; Ord typeclass - ordering.  typeclass-eq.tur is auto-loaded first, so the
;; superclass is always in scope here.
(defclass Ord [a]
  [(Eq a)]
  (lt? [x y] : bool)
  (lte? [x y] : bool)
  (gt? [x y] : bool)
  (gte? [x y] : bool))
;; Instances for primitive types
;;; Ord [int] -- Ord instance for int.

(definstance Ord [int]
  (lt? [x y] (< x y))
  (lte? [x y] (<= x y))
  (gt? [x y] (> x y))
  (gte? [x y] (>= x y)))
;;; Ord [float] -- Ord instance for float.
;;
;; lattice-vocabulary-plan L1: `float32` had an instance and `float` did not, so
;; `(gte? 2.5 7.1)` was "no instance of typeclass 'Ord' for type 'float'" while
;; the retired `max` macro handled floats fine via the builtin.  Removing the
;; macro without this would have been a straight loss.
(definstance Ord [float]
  (lt? [x y] (< x y))
  (lte? [x y] (<= x y))
  (gt? [x y] (> x y))
  (gte? [x y] (>= x y)))
;;; cstr-compare__ -- internal: strcmp for Ord [cstr].
;;
;; stdlib/cstr.tur has `cstr-eq?` but no ordering, and typeclass.tur does not
;; load it (doing so would add an edge to the Show/string load cycle documented
;; at the top of this file), so the primitive lives here.
(defn cstr-compare__ [a : cstr b : cstr] : int
  ```c
  return (int64_t)strcmp(a, b);
  ```)
;;; Ord [cstr] -- lexicographic Ord instance for cstr.
;;
;; `String` and `StringSlice` had instances; the bare `cstr` did not, so
;; `(gte? "a" "b")` had no instance at all.
(definstance Ord [cstr]
  (lt? [x y] (< (cstr-compare__ x y) 0))
  (lte? [x y] (<= (cstr-compare__ x y) 0))
  (gt? [x y] (> (cstr-compare__ x y) 0))
  (gte? [x y] (>= (cstr-compare__ x y) 0)))
;;; max -- the greater of two Ord values.
;;;
;;; Parameters:
;;;   x -- first value
;;;   y -- second value
;;;
;;; Returns:
;;;   x when (gte? x y), else y.
;;;
;;; Example:
;;;   (max 2.5 7.1)                              ; => 7.1
;;;   (defn hi [^Ord A] [a : A b : A] : A (max a b))
;;;
;;; Since: lattice-vocabulary-plan L1
;;
;; A constrained generic DEFN, deliberately not a class method with a default
;; body.  Three reasons, in order of weight:
;;
;;  1. (Historical, fixed 2026-09-16.)  A default method whose declared types
;;     mention the class variable used to be miscompiled: elab_definstance
;;     spliced the class's method FORM into the instance, annotations and all,
;;     and the `: a` on its parameters and result was elaborated literally --
;;     `Ord [float]`'s copy emitted as `int64_t __inst_Ord_max_float(int64_t,
;;     int64_t)` and `(max 2.5 7.1)` through a generic answered 2.  A spliced
;;     default now inherits the class signature under the instance
;;     substitution like a bare-parameter method.  See
;;     docs/archive/default-method-spliced-at-carrier-type.md.  Reasons 2 and
;;     3 still decide the spelling.
;;  2. Omitting the annotations is not an option either: with the class variable
;;     appearing only in the return, every call site becomes "cannot infer type
;;     for return-directed method 'max'".
;;  3. As a defn it costs a user-written `Ord` instance nothing -- a class
;;     method, defaulted or not, is one more thing every instance must satisfy.
;;
;; Retired the `max`/`min` MACROS in stdlib/macros.tur, which expanded to the
;; builtin `>=` / `<=` and so worked for concrete int and float and nowhere
;; else -- not cstr, not a user Ord type, and not inside a constrained generic,
;; which is the case that earns a `max` (a pointwise maximum over an abstract
;; element type).  Macro expansion precedes dispatch, so the two spellings
;; could not coexist.
(defn max [^Ord A] [x : A y : A] : A (if (gte? x y) x y))
;;; min -- the lesser of two Ord values.
;;;
;;; Parameters:
;;;   x -- first value
;;;   y -- second value
;;;
;;; Returns:
;;;   y when (gte? x y), else x.
;;;
;;; Example:
;;;   (min "alpha" "beta")   ; => "alpha"
;;;
;;; Since: lattice-vocabulary-plan L1
(defn min [^Ord A] [x : A y : A] : A (if (gte? x y) y x))
;; Phase N4: Ord instances for new numeric types
;;; Ord [int8] -- Ord instance for int8.

(definstance Ord [int8]
  (lt? [x y] (< x y))
  (lte? [x y] (<= x y))
  (gt? [x y] (> x y))
  (gte? [x y] (>= x y)))
