;;; tur/timer -- Timer API backed by a min-heap timer wheel.
;;;
;;; Schedule callbacks at a future time; integrates with the cooperative scheduler.
;;;
;;; Since: Phase T24
;; stdlib/timer.tur -- Timer API for Turmeric (Phase T24)
;;
;; Provides high-level timer operations backed by the min-heap timer wheel
;; emitted in the runtime preamble.
;;
;; API:
;;   timer-set    [ms callback arg]  -> TimerId
;;   timer-cancel [id]               -> nil
;;   timer-sleep  [ms]               -> nil  (parks fiber, requires scheduler)
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 2) ----
;; TimerId wraps the timer-wheel handle (an :int) with a nominally distinct type
;; so the checker rejects passing an arbitrary integer to timer-cancel -- only a
;; value produced by timer-set is accepted. It lowers to :int in the C ABI, so
;; the inline-C bodies are unchanged.
(defopaque TimerId :int)
;;; timer-set -- schedule a one-shot callback after a delay.
;;;
;;; Parameters:
;;;   ms       -- delay in milliseconds before the callback fires (:int).
;;;   callback -- a :ptr<void> to the function to invoke; signature void(*)(void*).
;;;   arg      -- opaque :ptr<void> passed to callback when it fires.
;;;
;;; Returns:
;;;   A TimerId that can be passed to timer-cancel to abort the timer
;;;   before it fires.
;;;
;;; Example:
;;;   (timer-set 500 my-cb my-arg)  ; => TimerId  (fires in 500 ms)
;;;
;;; Since: Phase T24
;; Schedule a callback to fire after ms milliseconds.
;; Returns a TimerId that can be passed to timer-cancel.

(defn timer-set [ms : int callback : ptr<void> arg : ptr<void>] : TimerId
  ```c
  if (!tur_global_timers) tur_global_timers = tur_timer_wheel_new();
  int64_t deadline = tur_monotonic_ns() + (int64_t)ms * 1000000LL;
  return tur_timer_wheel_insert(tur_global_timers, deadline,
      (void(*)(void*))callback, arg);
  ```)
;;; timer-cancel -- cancel a previously scheduled timer.
;;;
;;; Parameters:
;;;   id -- the timer ID returned by timer-set.
;;;
;;; Example:
;;;   (timer-cancel 3)  ; cancel timer with ID 3
;;;
;;; Since: Phase T24
;; Cancel a previously scheduled timer by ID.
;; If the timer has already fired, this is a no-op.

(defn timer-cancel [id : TimerId] : nil
  ```c
  if (tur_global_timers) tur_timer_wheel_cancel(tur_global_timers, id);
  ```)
;;; timer-sleep -- park the current fiber for a given number of milliseconds.
;;;
;;; Parameters:
;;;   ms -- number of milliseconds to sleep (:int); no-op if <= 0.
;;;
;;; Example:
;;;   (timer-sleep 1000)  ; pause the current fiber for 1 second
;;;
;;; Since: Phase T24
;; Sleep the current fiber for ms milliseconds using the timer wheel.
;; Requires that a scheduler is active and the caller is running in a fiber.
;; For a version that falls back to nanosleep, use async-sleep from fiber.tur.

(defn timer-sleep [ms : int] : nil
  ```c
  if (ms <= 0) return;
  FiberBlock *me = tur_current_fiber;
  if (!me || !tur_scheduler) {
    fprintf(stderr, "timer-sleep: must be called from a fiber under a scheduler\n");
    abort();
  }
  if (!tur_global_timers) tur_global_timers = tur_timer_wheel_new();
  int64_t deadline = tur_monotonic_ns() + (int64_t)ms * 1000000LL;
  tur_timer_wheel_insert(tur_global_timers, deadline,
      tur_scheduler_unpark_cb, me);
  me->parked = 1;
  tur_fiber_block_yield(0);
  ```)
