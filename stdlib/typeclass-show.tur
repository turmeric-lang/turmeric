;;; tur/typeclass-show -- the Show typeclass (owned String result) and its
;;; primitive + typed-collection instances.
;;;
;;; Show renders a value as an OWNED `String` (refcount 1): `(show x)` returns a
;;; fresh String the caller `string/release`s, so a generic caller has a single
;;; uniformly-safe ownership policy (release) -- no leak, no borrow/malloc
;;; guessing.  This is the owned surface the show-owned-result-plan builds; the
;;; earlier `cstr`-returning Show was retired at stage 4.
;;;
;;; Because it returns `String`, Show sits ABOVE stdlib/string.tur in the load
;;; graph and loads it here.  It is pulled in by stdlib/typeclass.tur (so
;;; `(load "stdlib/typeclass.tur")` still provides Show + the collection
;;; instances) and preloaded by the REPL (src/turi/preload.c).
;;;
;;; Since: v2 (show-owned-result-plan, stage 4)
(load "stdlib/string.tur")
;;; Show -- typeclass for an owned-String representation.
;;;
;;; Parameters:
;;;   a -- the type to render
;;;
;;; Returns:
;;;   A fresh owned String (refcount 1); the caller string/releases it.
;;;
;;; Since: Phase 15 (owned since stage 4)

(defclass Show [a] (show [x] : String))
;; ---------------------------------------------------------------------------
;; Primitive instances.  Each builds the owned String directly (no cstr
;; intermediate to leak): int via int->string, the other numerics via an
;; inline-C snprintf into a stack buffer handed to tur_string_from_cstr (one
;; copy, leak-free), cstr/bool by copying the literal, String by O(1) retain.
;; ---------------------------------------------------------------------------
;;; Show [int] -- owned decimal String.

(definstance Show [int] (show [x] : String (int->string x)))
;;; Show [cstr] -- copy the borrowed cstr into a fresh owned String.

(definstance Show [cstr] (show [x] : String (string/from-cstr x)))
;;; Show [bool] -- owned "true" / "false" String.

(definstance Show [bool]
  (show [x] : String (string/from-cstr (if x "true" "false"))))
;;; Show [int8] -- owned decimal String.

(definstance Show [int8]
  (show [x]
    : String
    ```c
    char buf[8]; snprintf(buf, 8, "%d", (int)x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [int16] -- owned decimal String.

(definstance Show [int16]
  (show [x]
    : String
    ```c
    char buf[8]; snprintf(buf, 8, "%d", (int)x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [int32] -- owned decimal String.

(definstance Show [int32]
  (show [x]
    : String
    ```c
    char buf[16]; snprintf(buf, 16, "%d", x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [uint8] -- owned decimal String.

(definstance Show [uint8]
  (show [x]
    : String
    ```c
    char buf[8]; snprintf(buf, 8, "%u", (unsigned)x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [uint16] -- owned decimal String.

(definstance Show [uint16]
  (show [x]
    : String
    ```c
    char buf[8]; snprintf(buf, 8, "%u", (unsigned)x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [uint32] -- owned decimal String.

(definstance Show [uint32]
  (show [x]
    : String
    ```c
    char buf[16]; snprintf(buf, 16, "%u", x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [uint64] -- owned decimal String.

(definstance Show [uint64]
  (show [x]
    : String
    ```c
    char buf[24]; snprintf(buf, 24, "%llu", (unsigned long long)x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [float] -- owned String rendering of a double.

(definstance Show [float]
  (show [x]
    : String
    ```c
    char buf[32]; snprintf(buf, 32, "%g", (double)x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [float32] -- owned String rendering of a float32.

(definstance Show [float32]
  (show [x]
    : String
    ```c
    char buf[32]; snprintf(buf, 32, "%g", (double)x);
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;;; Show [String] -- O(1) retain (refcount++), a second owning handle.

(definstance Show [String] (show [x] : String (string/retain x)))
;; ---------------------------------------------------------------------------
;; Mixed borrow/malloc instance: the result<T,E> carrier.  Build the owned
;; String directly from a stack buffer (the null case is a borrowed literal, the
;; ok/err cases format an int -- one copy handles both, leak-free).
;; ---------------------------------------------------------------------------
;;; Show [ptr<void>] -- render a result<T,E> carrier as an owned String.

(definstance Show [ptr<void>]
  (show [x]
    : String
    ```c
    struct { int tag; int64_t payload; } *res = (void*)x;
    if (res == NULL) { return (void *)(intptr_t)tur_string_from_cstr("err"); }
    char buf[48];
    if (res->tag == 0) {
        snprintf(buf, 48, "ok(%lld)", (long long)res->payload);
    } else {
        snprintf(buf, 48, "err(%lld)", (long long)res->payload);
    }
    return (void *)(intptr_t)tur_string_from_cstr(buf);
    ```))
;; ---------------------------------------------------------------------------
;; Typed collections (Vec / Set / Map).
;;
;; Built with a StringBuilder over each element's own Show, releasing every
;; intermediate element String as it is pushed -- fully leak-clean.  The
;; `s : (Set A)` / `m : (Map K V)` witness parameters pin the element types so
;; monomorphization grounds the element Show dispatch (the phantom-type
;; rationale from the historic cstr collection loops still applies).
;;
;; They live in Show's own module so the orphan rule (TUR-E0013) is satisfied
;; without touching vec.tur / set.tur / map.tur.  Vec/Set/Map and the HAMT
;; iterator ops are always auto-loaded, so they are in scope here.
;; ---------------------------------------------------------------------------
;;; vec-show-loop -- push "e0 e1 ..." element reprs into the builder.

(defn vec-show-loop [^Show A] [v : (Vec A) i : int len : int b : StringBuilder] : StringBuilder
  (if (= i len)
    b
    (do
      (when (> i 0) (builder/push-cstr! b " "))
      (let [es (show (:: (vec-get v i) A))]
        (do (builder/push-string! b es) (string/release es)))
      (vec-show-loop v (+ i 1) len b))))
;;; Show [Vec] -- render a Vec[A] as an owned "[a b c]" String.
;;;
;;; Example:
;;;   (show (vec-of 1 2 3))  ; => String "[1 2 3]"

(definstance Show [Vec]
  [(Show A)]
  (show [x]
    (let [xx (:: x (Vec A))
          b  (builder/new)]
      (do
        (builder/push-cstr! b "[")
        (vec-show-loop xx 0 (vec-len xx) b)
        (builder/push-cstr! b "]")
        (builder/finish b)))))
;;; set-show-loop -- push the space-separated element reprs into b.

(defn set-show-loop [^Show A] [s : (Set A)
                               iter : ptr<void>
                               first : bool
                               b : StringBuilder] : StringBuilder
  (if (hamt/iter-advance! iter)
    (do
      (when (not first) (builder/push-cstr! b " "))
      (let [es (show (:: (hamt/iter-cur-key iter) A))]
        (do (builder/push-string! b es) (string/release es)))
      (set-show-loop s iter false b))
    b))
;;; Show [Set] -- render a Set[A] as an owned "#set{a b c}" String.
;;;
;;; Example:
;;;   (show (set-of 1 2 3))  ; => String "#set{1 2 3}"

(definstance Show [Set]
  [(Show A)]
  (show [x]
    (let [ss   (:: x (Set A))
          b    (builder/new)
          iter (hamt/iter-alloc (set-hamt ss))]
      (do
        (builder/push-cstr! b "#set{")
        (set-show-loop ss iter true b)
        (hamt/iter-destroy! iter)
        (builder/push-cstr! b "}")
        (builder/finish b)))))
;;; map-show-loop -- push the space-separated "k v" reprs into b.

(defn map-show-loop [^Show K ^Show V] [m : (Map K V)
                                       iter : ptr<void>
                                       first : bool
                                       b : StringBuilder] : StringBuilder
  (if (hamt/iter-advance! iter)
    (do
      (when (not first) (builder/push-cstr! b " "))
      (let [ks (show (:: (hamt/iter-cur-key iter) K))
            vs (show (:: (map-iter-cur-val-as iter) V))]
        (do
          (builder/push-string! b ks)
          (string/release ks)
          (builder/push-cstr! b " ")
          (builder/push-string! b vs)
          (string/release vs)))
      (map-show-loop m iter false b))
    b))
;;; Show [Map] -- render a Map[K V] as an owned "#map{k1 v1 k2 v2}" String.
;;;
;;; Example:
;;;   (show (hamt-of 1 10 2 20))  ; => String "#map{1 10 2 20}"

(definstance Show [Map]
  [(Show K) (Show V)]
  (show [x]
    (let [mm   (:: x (Map K V))
          b    (builder/new)
          iter (hamt/iter-alloc (map-hamt mm))]
      (do
        (builder/push-cstr! b "#map{")
        (map-show-loop mm iter true b)
        (hamt/iter-destroy! iter)
        (builder/push-cstr! b "}")
        (builder/finish b)))))
;; ---------------------------------------------------------------------------
;; Show [Sym] -- interned runtime symbols (:Sym).
;;
;; A keyword literal (`:a`) is an interned :Sym, so a Sym-keyed collection --
;; `#map{:a 1}`, `#set{:x :y}` -- renders each key through Show[Sym].  Without
;; this instance the map/set show loop had no Show for the key type and the
;; interpreter fell through to the raw carrier integer (`#map{32696212 1}`
;; instead of `#map{:a 1}`); see docs/archive/map-show-keyword-key-raw-int.md.
;;
;; The instance lives here (Show's own module) rather than in sym.tur because
;; the Show class is defined here and sym.tur loads before it -- an instance in
;; sym.tur could not name Show.  sym.tur is loaded below for `sym->str`; the
;; body is ordinary Turmeric (no inline-C) so the tree-walking interpreter --
;; which is the reported path -- can execute it via the sym->str native.
;; ---------------------------------------------------------------------------
(load "stdlib/sym.tur")
;;; Show [Sym] -- render an interned symbol as an owned ":name" String.
;;;
;;; Example:
;;;   (show :hello)  ; => String ":hello"

(definstance Show [Sym]
  (show [x]
    : String
    (let [b (builder/new)]
      (do
        (builder/push-cstr! b ":")
        (builder/push-cstr! b (sym->str x))
        (builder/finish b)))))
;; ---------------------------------------------------------------------------
;; Convenience wrappers + a compatibility alias.
;; ---------------------------------------------------------------------------
;; show-string-fputs writes to stdout, so it declares #fx{IO}, the same row
;; as the `println` builtin (effect-row-honesty-plan W4).  It used to say
;; #fx{FS}, which nothing in scope declared, so it resolved to #fx{} -- the tag
;; never did anything, and stdout is not FS.
;;; show-string-fputs -- internal: write a cstr to stdout with no newline.

(defn show-string-fputs [s : cstr]
  #fx{IO}
  : void
  ```c
  fputs((const char *)s, stdout);
  ```)
;;; print-show -- render x via Show and print it (no trailing newline).
;;;
;;; Shows x to an owned String, prints its bytes, and releases the String.
;;;
;;; Example:
;;;   (print-show 42)  ; prints: 42
;;;
;;; Since: v2 (show-owned-result-plan)

(defn print-show [^Show a] [x : a] : void
  (let [s (show x)]
    (do (show-string-fputs (string/to-cstr s)) (string/release s))))
;;; show-line -- render x via Show and print it with a trailing newline.
;;;
;;; Shows x to an owned String, prints its bytes plus a newline, releases it.
;;;
;;; Example:
;;;   (show-line 42)  ; prints: 42\n
;;;
;;; Since: v2 (show-owned-result-plan)

(defn show-line [^Show a] [x : a] : void
  (let [s (show x)] (do (println (string/to-cstr s)) (string/release s))))
