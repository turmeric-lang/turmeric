;;; tur/fs -- extended file-system operations (stat, readdir, fnmatch, walk).
;;;
;;; Higher-level wrappers around sys/stat.h, dirent.h, and fnmatch.h.
;;;
;;; Since: Phase B1
;; stdlib/fs.tur -- extended file system operations.
;;
;; Higher-level wrappers around sys/stat.h, dirent.h, fnmatch.h, and
;; standard libc file functions.  These complement the low-level I/O
;; primitives in io.tur.
;; ---- Opaque handle newtypes (stdlib-opaque-handle-types-plan, I/O sweep) ----
;; StatInfo and TmpFile wrap the opaque :int pointers handed out by fs/stat and
;; fs/tmpfile so the checker rejects passing one where the other (or any bare
;; integer) is expected -- e.g. handing a TmpFile to fs/stat-size. Both lower to
;; :int in the C ABI, so the inline-C bodies are unchanged. fs/tmpfile-fd hands
;; back the open descriptor as the shared Fd handle (from tur/fd).
;;
;; ---- Linearity (stdlib-linearity-affinity-plan, L2) ----
;; TmpFile is declared :linear: a temp file owns an open fd and an on-disk
;; entry, so it must be released exactly once with fs/tmpfile-free. Under
;; -Xlinear the checker rejects dropping a TmpFile (TUR-E0100) or freeing it
;; twice (TUR-E0101). The discipline is purely a type-checker concern; the
;; :int C ABI and inline-C bodies are unchanged. The non-consuming accessors
;; fs/tmpfile-path / fs/tmpfile-fd declare their handle parameter ^borrow, so
;; they read the handle without discharging the single-consumption obligation;
;; a later fs/tmpfile-free is still the one legal consumption. Borrowing an
;; already-freed handle is a TUR-E0101. See the (now resolved) report at
;; docs/archive/history/stdlib-linear-handle-borrows.md.
(load "stdlib/fd.tur")

(load "stdlib/effects.tur")

(load "stdlib/io-error.tur")
;; stdlib-os-surface-plan P1: every fallible fs/* operation returns
;; (Result T IoError) -- IoError from stdlib/io-error.tur carries the errno.
;; Operations with no useful success value answer (Result nil IoError).
;; stdlib-effect-rows: fs/* operations that touch the file system carry the
;; #{FS} capability tag.  Pure accessors over an already-fetched StatInfo or
;; TmpFile handle (fs/stat-size, fs/tmpfile-path, ...) stay untagged.

(defopaque StatInfo :int)

(defopaque TmpFile :int :linear)
;;; fs/stat -- return file metadata for a path.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   (Ok info) -- a StatInfo over a { size mtime mode } triple; inspect it
;;;   with fs/stat-size, fs/stat-mtime, fs/stat-mode and release it with
;;;   fs/stat-free -- or (Err e) when the path is inaccessible.
;;;
;;; Example:
;;;   (match (fs/stat "/etc/hosts")
;;;     (Ok s)  (do (println (fs/stat-size s)) (fs/stat-free s))
;;;     (Err e) (println (io-error/message e)))
;;;
;;; Since: Phase B2

(defn fs/stat [path : cstr]
  #fx{FS}
  : (Result StatInfo IoError)
  ```c
  #include <sys/stat.h>
  #include <errno.h>
  struct stat st;
  if (stat(path, &st) != 0) return tur_err_int(errno);
  int64_t *info = malloc(3 * sizeof(int64_t));
  if (!info) return tur_err_int(ENOMEM);
  info[0] = (int64_t)st.st_size;
  info[1] = (int64_t)st.st_mtime;
  info[2] = (int64_t)st.st_mode;
  return tur_ok_ptr(info);
  ```)
;;; fs/stat-free -- free the stat result returned by fs/stat.
;;;
;;; Parameters:
;;;   s -- a StatInfo from a successful fs/stat
;;;
;;; Example:
;;;   (fs/stat-free s)
;;;
;;; Since: Phase B2

(defn fs/stat-free [s : StatInfo] : void
  ```c
  if (s) free((void*)(intptr_t)s);
  ```)
;;; fs/stat-size -- extract file size from a stat result.
;;;
;;; Parameters:
;;;   s -- stat pointer from fs/stat
;;;
;;; Returns:
;;;   File size in bytes as :int.
;;;
;;; Example:
;;;   (fs/stat-size info)  ; => 221
;;;
;;; Since: Phase B2

(defn fs/stat-size [s : StatInfo] : int
  ```c
  return ((int64_t*)(intptr_t)s)[0];
  ```)
;;; fs/stat-mtime -- extract modification time from a stat result.
;;;
;;; Parameters:
;;;   s -- stat pointer from fs/stat
;;;
;;; Returns:
;;;   Modification time as a Unix timestamp (:int).
;;;
;;; Example:
;;;   (fs/stat-mtime info)  ; => 1747123456
;;;
;;; Since: Phase B2

(defn fs/stat-mtime [s : StatInfo] : int
  ```c
  return ((int64_t*)(intptr_t)s)[1];
  ```)
;;; fs/stat-mode -- extract file mode bits from a stat result.
;;;
;;; Parameters:
;;;   s -- stat pointer from fs/stat
;;;
;;; Returns:
;;;   File mode bits as :int (same as st_mode from stat(2)).
;;;
;;; Example:
;;;   (fs/stat-mode info)  ; => 33188
;;;
;;; Since: Phase B2

(defn fs/stat-mode [s : StatInfo] : int
  ```c
  return ((int64_t*)(intptr_t)s)[2];
  ```)
;;; fs/exists? -- test whether a path exists.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   true if stat(2) succeeds on the path, false otherwise.
;;;
;;; Example:
;;;   (fs/exists? "/etc/hosts")  ; => true
;;;
;;; Since: Phase B2

(defn fs/exists? [path : cstr]
  #fx{FS}
  : bool
  ```c
  #include <sys/stat.h>
  struct stat st;
  return stat(path, &st) == 0;
  ```)
;;; fs/file? -- test whether a path is a regular file.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   true if path is a regular file.
;;;
;;; Example:
;;;   (fs/file? "/etc/hosts")  ; => true
;;;
;;; Since: Phase B2

(defn fs/file? [path : cstr]
  #fx{FS}
  : bool
  ```c
  #include <sys/stat.h>
  struct stat st;
  if (stat(path, &st) != 0) return false;
  return S_ISREG(st.st_mode);
  ```)
;;; fs/dir? -- test whether a path is a directory.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   true if path is a directory.
;;;
;;; Example:
;;;   (fs/dir? "/tmp")  ; => true
;;;
;;; Since: Phase B2

(defn fs/dir? [path : cstr]
  #fx{FS}
  : bool
  ```c
  #include <sys/stat.h>
  struct stat st;
  if (stat(path, &st) != 0) return false;
  return S_ISDIR(st.st_mode);
  ```)
;;; fs/mkdir -- create a directory with mode 0755.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   (Ok nil) on success, or (Err e) carrying the errno.
;;;
;;; Example:
;;;   (fs/mkdir "/tmp/mydir")  ; => (Ok nil)
;;;
;;; Since: Phase B2

(defn fs/mkdir [path : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <sys/stat.h>
  #include <errno.h>
  #include <direct.h>  /* tur:optional -- Windows only; POSIX takes the mkdir() branch below */
  /* MinGW's mkdir takes one argument (the legacy MSVC signature); Windows has
   * no POSIX permission bits, so the 0755 is dropped rather than translated.
   *
   * direct.h is included at the TOP of the body, outside the #ifdef, on purpose.
   * Only leading bare directives are hoisted to file scope
   * (tur_hoist_top_includes_scan); one left inside the #ifdef stays in the
   * function body, where it is block-scoped AND -- because of the header's own
   * include guard -- expands to nothing in the SECOND function that needs it,
   * leaving an implicit declaration of _mkdir. Hoisting it bare is safe on
   * POSIX: tur_emit_hoisted_include wraps angle includes in
   * `#if __has_include(<...>)`, so a platform without direct.h just skips it. */
#ifdef _WIN32
  int rc = _mkdir(path);
#else
  int rc = mkdir(path, 0755);
#endif
  return rc == 0 ? tur_ok_int(0) : tur_err_int(errno);
  ```)
;;; fs/mkdirp -- create a directory and all missing parent directories.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   (Ok nil) on success (including when the directory already exists), or
;;;   (Err e) for the first mkdir that failed for any other reason.
;;;
;;; Example:
;;;   (fs/mkdirp "/tmp/a/b/c")  ; => (Ok nil)
;;;
;;; Since: Phase B2

(defn fs/mkdirp [path : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <sys/stat.h>
  #include <errno.h>
  #include <direct.h>  /* tur:optional -- Windows only; POSIX takes the mkdir() branch below */
  /* One-arg mkdir on MinGW (see fs/mkdir).  A body-local macro keeps both call
   * sites below identical across platforms.  direct.h sits outside the #ifdef
   * for the hoisting reason documented on fs/mkdir -- this is the very function
   * that broke when it was inside. */
#ifdef _WIN32
  #define __tur_mkdir(p) _mkdir(p)
#else
  #define __tur_mkdir(p) mkdir((p), 0755)
#endif
  char *p = strdup(path);
  if (!p) return tur_err_int(ENOMEM);
  int err = 0;
  for (char *s = p + 1; *s; s++) {
    if (*s == '/') {
      *s = '\0';
      if (__tur_mkdir(p) != 0 && errno != EEXIST) { err = errno; break; }
      *s = '/';
    }
  }
  if (err == 0 && __tur_mkdir(p) != 0 && errno != EEXIST) err = errno;
  free(p);
  #undef __tur_mkdir
  return err == 0 ? tur_ok_int(0) : tur_err_int(err);
  ```)
;;; fs/rmdir -- remove an empty directory.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   (Ok nil) on success, or (Err e) carrying the errno.
;;;
;;; Example:
;;;   (fs/rmdir "/tmp/mydir")  ; => (Ok nil)
;;;
;;; Since: Phase B2

(defn fs/rmdir [path : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <errno.h>
  return rmdir(path) == 0 ? tur_ok_int(0) : tur_err_int(errno);
  ```)
;;; fs/rm -- remove a regular file.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   (Ok nil) on success, or (Err e) carrying the errno.
;;;
;;; Example:
;;;   (fs/rm "/tmp/tmpfile.txt")  ; => (Ok nil)
;;;
;;; Since: Phase B2

(defn fs/rm [path : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <errno.h>
  return unlink(path) == 0 ? tur_ok_int(0) : tur_err_int(errno);
  ```)
;;; fs/rename -- rename or move a file.
;;;
;;; Parameters:
;;;   src -- source path cstr
;;;   dst -- destination path cstr
;;;
;;; Returns:
;;;   (Ok nil) on success, or (Err e) carrying the errno.
;;;
;;; Example:
;;;   (fs/rename "/tmp/a.txt" "/tmp/b.txt")  ; => (Ok nil)
;;;
;;; Since: Phase B2

(defn fs/rename [src : cstr dst : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <errno.h>
  return rename(src, dst) == 0 ? tur_ok_int(0) : tur_err_int(errno);
  ```)
;;; fs/copy -- copy a file from src to dst using a read/write loop.
;;;
;;; Parameters:
;;;   src -- source path cstr
;;;   dst -- destination path cstr
;;;
;;; Returns:
;;;   (Ok nil) on success, or (Err e) carrying the errno.
;;;
;;; Example:
;;;   (fs/copy "/etc/hosts" "/tmp/hosts.bak")  ; => (Ok nil)
;;;
;;; Since: Phase B2

(defn fs/copy [src : cstr dst : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <errno.h>
  FILE *in = fopen(src, "rb");
  if (!in) return tur_err_int(errno);
  FILE *out = fopen(dst, "wb");
  if (!out) { int e = errno; fclose(in); return tur_err_int(e); }
  char buf[8192];
  size_t n;
  int err = 0;
  while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {
    if (fwrite(buf, 1, n, out) != n) { err = errno ? errno : EIO; break; }
  }
  if (!err && ferror(in)) err = errno ? errno : EIO;
  fclose(in);
  if (fclose(out) != 0 && !err) err = errno ? errno : EIO;
  return err ? tur_err_int(err) : tur_ok_int(0);
  ```)
;;; fs/glob -- list directory entries matching a fnmatch(3) pattern.
;;;
;;; Parameters:
;;;   dir     -- directory to search (e.g., "/tmp")
;;;   pattern -- fnmatch pattern applied to entry names (e.g., "*.txt")
;;;
;;; Returns:
;;;   (Ok paths) -- a (Vec cstr) of fresh heap-allocated full paths, in
;;;   directory order; release it with fs/paths-free -- or (Err e) when the
;;;   directory cannot be opened.
;;;
;;; Example:
;;;   (match (fs/glob "/tmp" "*.txt")
;;;     (Ok v)  (do (println (vec-len v)) (fs/paths-free v))
;;;     (Err e) (println (io-error/message e)))
;;;
;;; Since: Phase B2

(defn fs/glob [dir : cstr pattern : cstr]
  #fx{FS}
  : (Result (Vec cstr) IoError)
  ```c
  #include <dirent.h>
  #include <errno.h>
  /* fnmatch(3) is POSIX and absent on MinGW.  Windows' PathMatchSpecA does the
   * same wildcard job ('*' and '?'), takes (name, pattern) instead of
   * (pattern, name), and returns TRUE on a match instead of 0.  Links shlwapi
   * (added to the Windows link line in src/main.c alongside ws2_32). */
#ifdef _WIN32
  #include <shlwapi.h>
#else
  #include <fnmatch.h>
#endif
  DIR *d = opendir(dir);
  if (!d) return tur_err_int(errno);
  /* The (Vec cstr) header layout every Vec producer shares (stdlib/vec.tur). */
  struct __tur_vec { int64_t *data; int64_t len; int64_t cap; };
  struct __tur_vec *v = (struct __tur_vec *)malloc(sizeof *v);
  if (!v) { closedir(d); return tur_err_int(ENOMEM); }
  v->data = NULL; v->len = 0; v->cap = 0;
  struct dirent *ent;
  size_t dlen = strlen(dir);
  while ((ent = readdir(d))) {
    if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
#ifdef _WIN32
    if (!PathMatchSpecA(ent->d_name, pattern)) continue;
#else
    if (fnmatch(pattern, ent->d_name, 0) != 0) continue;
#endif
    int sep = (dlen > 0 && dir[dlen - 1] != '/') ? 1 : 0;
    size_t nlen = strlen(ent->d_name);
    char *full = malloc(dlen + sep + nlen + 1);
    memcpy(full, dir, dlen);
    if (sep) full[dlen] = '/';
    memcpy(full + dlen + sep, ent->d_name, nlen + 1);
    if (v->len == v->cap) {
      int64_t ncap = v->cap ? v->cap * 2 : 8;
      int64_t *grown = (int64_t *)realloc(v->data, (size_t)ncap * sizeof(int64_t));
      if (!grown) { free(full); break; }
      v->data = grown; v->cap = ncap;
    }
    v->data[v->len++] = (int64_t)(intptr_t)full;
  }
  closedir(d);
  return tur_ok_ptr(v);
  ```)
;;; fs/paths-free -- free a (Vec cstr) of owned strings and the Vec itself.
;;;
;;; Releases what fs/glob, fs/walk and fs/read-lines hand back (and env/all):
;;; every element string, then the vector.  Do not use it on a Vec whose
;;; strings you did not get from one of those.
;;;
;;; Parameters:
;;;   v -- a (Vec cstr) whose element strings are heap-owned
;;;
;;; Example:
;;;   (fs/paths-free paths)
;;;
;;; Since: stdlib-os-surface P1
(defn fs/paths-free [v : (Vec cstr)] : void
  ```c
  struct __tur_vec { int64_t *data; int64_t len; int64_t cap; };
  struct __tur_vec *h = (struct __tur_vec *)(intptr_t)v;
  if (!h) return;
  for (int64_t i = 0; i < h->len; i++) free((void *)(intptr_t)h->data[i]);
  free(h->data);
  free(h);
  ```)
;;; fs/glob-free -- deprecated name for fs/paths-free.
;;;
;;; Parameters:
;;;   v -- the (Vec cstr) returned by fs/glob
;;;
;;; Example:
;;;   (fs/glob-free paths)
;;;
;;; Since: Phase B2
(defn ^deprecated "use fs/paths-free" fs/glob-free [v : (Vec cstr)] : void
  (fs/paths-free v))
;;; fs/tmpfile -- create a unique temporary file in the system temp directory.
;;;
;;; Returns:
;;;   A linear TmpFile handle wrapping a pair { path-cstr, fd }.
;;;   The path is heap-allocated; the fd is the open descriptor.
;;;   Release exactly once with fs/tmpfile-free.  Returns 0 on failure.
;;;   The directory is resolved at run time: TMPDIR (else /tmp) on POSIX,
;;;   GetTempPath on Windows -- never a hardcoded "/tmp", which a native
;;;   Windows binary would resolve against the current drive root.
;;;   Under -Xlinear the checker requires the handle be consumed exactly once
;;;   (dropping it is TUR-E0100; freeing it twice is TUR-E0101).
;;;
;;; Example:
;;;   (let [t (fs/tmpfile)] (fs/tmpfile-free t))
;;;
;;; Since: Phase B2

(defn fs/tmpfile []
  #fx{FS}
  : TmpFile
  ```c
  #include <sys/stat.h>
  #include <io.h>     /* tur:optional -- Windows only (_open, _mktemp_s) */
  #include <fcntl.h>
  /* The temp DIRECTORY is resolved at run time, never spelled as a literal.
   *
   * This used to be strdup("/tmp/tur_XXXXXX") + mkstemp.  A compiled turmeric
   * program is a NATIVE Windows binary, not an MSYS one, so its CRT does not
   * resolve "/tmp" the way the MSYS shell does (%LOCALAPPDATA%\Temp) -- it
   * resolves it against the CURRENT DRIVE ROOT, i.e. C:\tmp or D:\tmp, which
   * need not exist.  When it does not, every fs/tmpfile call returned 0 and the
   * caller saw an I/O failure with nothing naming a missing directory.
   *
   * That shipped green for a long time because developer machines accumulate a
   * C:\tmp; it only surfaced when CI ran the suite on a fresh runner whose
   * workspace is on D:.  See
   * docs/reported/windows-hardcoded-tmp-resolves-to-drive-root.md. */
#ifdef _WIN32
  /* GetTempPathA is the documented source of a directory that EXISTS: it tries
   * TMP, then TEMP, then USERPROFILE, then the Windows directory, and always
   * returns a path ending in a separator. */
  char dir[MAX_PATH + 1];
  DWORD dn = GetTempPathA((DWORD)sizeof dir, dir);
  if (dn == 0 || dn > MAX_PATH) return 0;
  size_t need = (size_t)dn + sizeof("tur_XXXXXX");
  char *tmpl = (char *)malloc(need);
  if (!tmpl) return 0;
  memcpy(tmpl, dir, (size_t)dn);
  memcpy(tmpl + dn, "tur_XXXXXX", sizeof("tur_XXXXXX"));
  /* _mktemp_s only picks a free NAME; it does not create the file, so two
   * racing processes can be handed the same one.  _O_EXCL is what closes that:
   * the create fails rather than clobbering an existing file, which is the
   * guarantee mkstemp gives on the other branch. */
  if (_mktemp_s(tmpl, need) != 0) { free(tmpl); return 0; }
  int fd = _open(tmpl, _O_RDWR | _O_CREAT | _O_EXCL | _O_BINARY,
                 _S_IREAD | _S_IWRITE);
  if (fd < 0) { free(tmpl); return 0; }
#else
  /* POSIX: honour TMPDIR when set (containers and CI often point it at a
   * writable scratch), else the conventional /tmp -- which on a real POSIX
   * system does exist. */
  const char *dir = getenv("TMPDIR");
  if (!dir || !*dir) dir = "/tmp";
  size_t dl = strlen(dir);
  int slash = (dl > 0 && dir[dl - 1] != '/') ? 1 : 0;
  size_t need = dl + (size_t)slash + sizeof("tur_XXXXXX");
  char *tmpl = (char *)malloc(need);
  if (!tmpl) return 0;
  memcpy(tmpl, dir, dl);
  if (slash) tmpl[dl] = '/';
  memcpy(tmpl + dl + slash, "tur_XXXXXX", sizeof("tur_XXXXXX"));
  int fd = mkstemp(tmpl);
  if (fd < 0) { free(tmpl); return 0; }
#endif
  int64_t *pair = malloc(2 * sizeof(int64_t));
  pair[0] = (int64_t)(intptr_t)tmpl;
  pair[1] = (int64_t)fd;
  return (int64_t)(intptr_t)pair;
  ```)
;;; fs/tmpfile-path -- extract the path from an fs/tmpfile pair.
;;;
;;; Parameters:
;;;   t -- tmpfile pair from fs/tmpfile
;;;
;;; Returns:
;;;   The path cstr (owned by the pair; do not free separately).
;;;
;;; Example:
;;;   (fs/tmpfile-path my-tmp)  ; => "/tmp/tur_aB3xYz"
;;;
;;; Since: Phase B2

(defn fs/tmpfile-path [^borrow t : TmpFile] : cstr
  ```c
  return (const char*)(intptr_t)((int64_t*)(intptr_t)t)[0];
  ```)
;;; fs/tmpfile-fd -- extract the file descriptor from an fs/tmpfile pair.
;;;
;;; Parameters:
;;;   t -- tmpfile pair from fs/tmpfile
;;;
;;; Returns:
;;;   The open file descriptor as :int.
;;;
;;; Example:
;;;   (fs/tmpfile-fd my-tmp)  ; => 5
;;;
;;; Since: Phase B2

(defn fs/tmpfile-fd [^borrow t : TmpFile] : Fd
  ```c
  return ((int64_t*)(intptr_t)t)[1];
  ```)
;;; fs/tmpfile-free -- close the fd and free the tmpfile pair.
;;;
;;; Parameters:
;;;   t -- tmpfile pair from fs/tmpfile (may be 0)
;;;
;;; Example:
;;;   (fs/tmpfile-free my-tmp)
;;;
;;; Since: Phase B2

(defn fs/tmpfile-free [t : TmpFile]
  #fx{FS}
  : void
  ```c
  #include <unistd.h>
  if (!t) return;
  int64_t *pair = (int64_t*)(intptr_t)t;
  close((int)pair[1]);
  free((void*)(intptr_t)pair[0]);
  free(pair);
  ```)
;;; fs/read-text -- read an entire file into a NUL-terminated heap buffer.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   (Ok text) -- a fresh heap-allocated NUL-terminated cstr of the file
;;;   contents, which the caller owns (release with free) -- or (Err e).
;;;
;;; Example:
;;;   (match (fs/read-text "/etc/hostname")
;;;     (Ok s)  (println s)
;;;     (Err e) (println (io-error/message e)))
;;;
;;; Since: Phase B2

(defn fs/read-text [path : cstr]
  #fx{FS}
  : (Result cstr IoError)
  ```c
  #include <errno.h>
  FILE *f = fopen(path, "rb");
  if (!f) return tur_err_int(errno);
  size_t cap, len = 0;
  char *buf;
  long size = -1;
  if (fseek(f, 0, SEEK_END) == 0) size = ftell(f);
  /* ftell answers -1 for a pipe, a FIFO or /dev/stdin, which used to make a
     zero-byte malloc that fread then overran (security audit WP5, M-5).
     Those now take the growing-buffer path below instead of failing. */
  if (size >= 0) { fseek(f, 0, SEEK_SET); cap = (size_t)size + 1; }
  else cap = 4096;
  buf = (char *)malloc(cap);
  if (!buf) { fclose(f); return tur_err_int(ENOMEM); }
  for (;;) {
    if (cap - len < 2) {
      char *grown = (char *)realloc(buf, cap * 2);
      if (!grown) { free(buf); fclose(f); return tur_err_int(ENOMEM); }
      buf = grown; cap *= 2;
    }
    size_t n = fread(buf + len, 1, cap - len - 1, f);
    len += n;
    if (n == 0) break;
  }
  if (ferror(f)) { int e = errno ? errno : EIO; free(buf); fclose(f); return tur_err_int(e); }
  fclose(f);
  buf[len] = '\0';
  return tur_ok_ptr(buf);
  ```)
;;; fs/write-text -- write a NUL-terminated string to a file.
;;;
;;; Parameters:
;;;   path    -- NUL-terminated destination path cstr
;;;   content -- NUL-terminated string to write
;;;
;;; Returns:
;;;   (Ok nil) on success, or (Err e) carrying the errno.
;;;
;;; Example:
;;;   (fs/write-text "/tmp/out.txt" "hello\n")  ; => (Ok nil)
;;;
;;; Since: Phase B2

(defn fs/write-text [path : cstr content : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <errno.h>
  FILE *f = fopen(path, "wb");
  if (!f) return tur_err_int(errno);
  size_t len = strlen(content);
  size_t n = fwrite(content, 1, len, f);
  int e = (n == len) ? 0 : (errno ? errno : EIO);
  if (fclose(f) != 0 && !e) e = errno ? errno : EIO;
  return e ? tur_err_int(e) : tur_ok_int(0);
  ```)
;;; fs/append-text -- append a NUL-terminated string to a file.
;;;
;;; Creates the file when it does not exist; never truncates it.
;;;
;;; Parameters:
;;;   path    -- NUL-terminated destination path cstr
;;;   content -- NUL-terminated string to append
;;;
;;; Returns:
;;;   (Ok nil) on success, or (Err e) carrying the errno.
;;;
;;; Example:
;;;   (fs/append-text "/tmp/log.txt" "one more line\n")  ; => (Ok nil)
;;;
;;; Since: stdlib-os-surface P0
(defn fs/append-text [path : cstr content : cstr]
  #fx{FS}
  : (Result nil IoError)
  ```c
  #include <errno.h>
  FILE *f = fopen(path, "ab");
  if (!f) return tur_err_int(errno);
  size_t len = strlen(content);
  size_t n = fwrite(content, 1, len, f);
  int e = (n == len) ? 0 : (errno ? errno : EIO);
  if (fclose(f) != 0 && !e) e = errno ? errno : EIO;
  return e ? tur_err_int(e) : tur_ok_int(0);
  ```)
;; ============================================================================
;; stdlib-os-surface-plan P2: streaming and traversal
;; ============================================================================
;;; fs/read-lines -- read a whole file as a vector of lines.
;;;
;;; Each line has its newline (and a CR before it) stripped.  A final line
;;; without a trailing newline counts; a trailing newline does not add an
;;; empty last line.  For files too large to hold at once, open a FileHandle
;;; and call file-read-line in a loop.
;;;
;;; Parameters:
;;;   path -- NUL-terminated path cstr
;;;
;;; Returns:
;;;   (Ok lines) -- a (Vec cstr) of fresh heap strings; release it with
;;;   fs/paths-free -- or (Err e).
;;;
;;; Example:
;;;   (match (fs/read-lines "/etc/hosts")
;;;     (Ok v)  (do (println (vec-len v)) (fs/paths-free v))
;;;     (Err e) (println (io-error/message e)))
;;;
;;; Since: stdlib-os-surface P2
(defn fs/read-lines [path : cstr]
  #fx{FS}
  : (Result (Vec cstr) IoError)
  ```c
  #include <errno.h>
  FILE *f = fopen(path, "rb");
  if (!f) return tur_err_int(errno);
  struct __tur_vec { int64_t *data; int64_t len; int64_t cap; };
  struct __tur_vec *v = (struct __tur_vec *)malloc(sizeof *v);
  if (!v) { fclose(f); return tur_err_int(ENOMEM); }
  v->data = NULL; v->len = 0; v->cap = 0;
  size_t lcap = 256, llen = 0;
  char *line = (char *)malloc(lcap);
  int err = line ? 0 : ENOMEM;
  int c = 0, any = 0;
  while (!err) {
    c = fgetc(f);
    if (c == EOF || c == '\n') {
      if (c == EOF && !any) break;
      if (llen > 0 && line[llen - 1] == '\r') llen--;
      char *s = (char *)malloc(llen + 1);
      if (!s) { err = ENOMEM; break; }
      memcpy(s, line, llen);
      s[llen] = '\0';
      if (v->len == v->cap) {
        int64_t ncap = v->cap ? v->cap * 2 : 16;
        int64_t *grown = (int64_t *)realloc(v->data, (size_t)ncap * sizeof(int64_t));
        if (!grown) { free(s); err = ENOMEM; break; }
        v->data = grown; v->cap = ncap;
      }
      v->data[v->len++] = (int64_t)(intptr_t)s;
      llen = 0; any = 0;
      if (c == EOF) break;
      continue;
    }
    any = 1;
    if (llen + 1 >= lcap) {
      char *grown = (char *)realloc(line, lcap * 2);
      if (!grown) { err = ENOMEM; break; }
      line = grown; lcap *= 2;
    }
    line[llen++] = (char)c;
  }
  if (!err && ferror(f)) err = errno ? errno : EIO;
  free(line);
  fclose(f);
  if (err) {
    for (int64_t i = 0; i < v->len; i++) free((void *)(intptr_t)v->data[i]);
    free(v->data);
    free(v);
    return tur_err_int(err);
  }
  return tur_ok_ptr(v);
  ```)
;;; fs/read-dir -- the names in a directory, sorted.
;;;
;;; Lists every entry except "." and "..", sorted by byte order so the result
;;; is stable across runs and platforms.  Names only -- join them onto dir
;;; with fs/path-join for a usable path.
;;;
;;; Parameters:
;;;   dir -- the directory to list
;;;
;;; Returns:
;;;   (Ok names) -- a (Vec cstr) of fresh heap strings; release it with
;;;   fs/paths-free -- or (Err e) when the directory cannot be opened.
;;;
;;; Example:
;;;   (match (fs/read-dir "/tmp")
;;;     (Ok v)  (do (println (vec-len v)) (fs/paths-free v))
;;;     (Err e) (println (io-error/message e)))
;;;
;;; Since: stdlib-os-surface P2
(defn fs/read-dir [dir : cstr]
  #fx{FS}
  : (Result (Vec cstr) IoError)
  ```c
  #include <dirent.h>
  #include <errno.h>
  #include <stdlib.h>
  DIR *d = opendir(dir);
  if (!d) return tur_err_int(errno);
  struct __tur_vec { int64_t *data; int64_t len; int64_t cap; };
  struct __tur_vec *v = (struct __tur_vec *)malloc(sizeof *v);
  if (!v) { closedir(d); return tur_err_int(ENOMEM); }
  v->data = NULL; v->len = 0; v->cap = 0;
  int err = 0;
  struct dirent *ent;
  errno = 0;
  while ((ent = readdir(d))) {
    if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
    if (v->len == v->cap) {
      int64_t ncap = v->cap ? v->cap * 2 : 16;
      int64_t *grown = (int64_t *)realloc(v->data, (size_t)ncap * sizeof(int64_t));
      if (!grown) { err = ENOMEM; break; }
      v->data = grown; v->cap = ncap;
    }
    char *name = strdup(ent->d_name);
    if (!name) { err = ENOMEM; break; }
    v->data[v->len++] = (int64_t)(intptr_t)name;
  }
  closedir(d);
  if (err) {
    for (int64_t i = 0; i < v->len; i++) free((void *)(intptr_t)v->data[i]);
    free(v->data);
    free(v);
    return tur_err_int(err);
  }
  /* insertion sort by strcmp: directory listings are small, and this keeps the
   * body free of a file-scope qsort comparator */
  for (int64_t i = 1; i < v->len; i++) {
    int64_t key = v->data[i];
    int64_t j = i - 1;
    while (j >= 0 && strcmp((const char *)(intptr_t)v->data[j], (const char *)(intptr_t)key) > 0) {
      v->data[j + 1] = v->data[j];
      j--;
    }
    v->data[j + 1] = key;
  }
  return tur_ok_ptr(v);
  ```)
;;; fs/path-join -- join a directory and a name with one separator.
;;;
;;; Parameters:
;;;   dir  -- the directory part (a trailing '/' is not doubled)
;;;   name -- the entry name
;;;
;;; Returns:
;;;   A fresh heap cstr "dir/name" the caller owns (release with free).
;;;
;;; Example:
;;;   (fs/path-join "/tmp" "a.txt")  ; => "/tmp/a.txt"
;;;
;;; Since: stdlib-os-surface P2
(defn fs/path-join [dir : cstr name : cstr] : cstr
  ```c
  size_t dl = strlen(dir), nl = strlen(name);
  int sep = (dl > 0 && dir[dl - 1] != '/') ? 1 : 0;
  char *out = (char *)malloc(dl + (size_t)sep + nl + 1);
  if (!out) return NULL;
  memcpy(out, dir, dl);
  if (sep) out[dl] = '/';
  memcpy(out + dl + sep, name, nl + 1);
  return out;
  ```)
;;; fs/free-cstr -- free a heap cstr (internal).
(defn fs/free-cstr [s : cstr] : void
  ```c
  free((void *)s);
  ```)
;;; fs/dup-cstr -- a fresh heap copy of a cstr (internal).
(defn fs/dup-cstr [s : cstr] : cstr
  ```c
  return strdup(s);
  ```)
;;; fs/walk-dir? -- is path a directory the walk descends into (internal).
;;
;; lstat(2) on POSIX, so a symlink to a directory is reported as a leaf and the
;; walk never follows it (no cycles).  Windows has no lstat; there stat is used
;; and symlinked directories are followed.
(defn fs/walk-dir? [path : cstr] #fx{FS} : bool
  ```c
  #include <sys/stat.h>
  struct stat st;
#ifdef _WIN32
  if (stat(path, &st) != 0) return false;
#else
  if (lstat(path, &st) != 0) return false;
#endif
  return S_ISDIR(st.st_mode);
  ```)
;;; fs/walk-names -- visit names[i..] of dir, recursing into directories (internal).
(defn fs/walk-names [dir : cstr names : (Vec cstr) i : int f : (fn [cstr bool] nil)]
  #fx{FS}
  : (Result nil IoError)
  (if (>= i (vec-len names))
    (io-error/ok-unit)
    (let [full   (fs/path-join dir (vec-get names i))
          is-dir (fs/walk-dir? full)]
      (f full is-dir)
      ;; Self-recursion only: a forward reference to a function returning
      ;; (Result nil IoError) trips TUR-E0012 (see
      ;; docs/reported/ok-nil-unconstructible-in-turmeric.md).
      (let [r (if is-dir
                (match (fs/read-dir full)
                  (Ok sub) (let [rr (fs/walk-names full sub 0 f)]
                             (fs/paths-free sub)
                             rr)
                  (Err e) (Err e))
                (io-error/ok-unit))]
        (fs/free-cstr full)
        (match r
          (Ok _) (fs/walk-names dir names (+ i 1) f)
          (Err e) (Err e))))))
;;; fs/walk-fn -- call f on every path under root, depth first.
;;;
;;; Visits entries in fs/read-dir order (sorted), calling (f path is-dir?)
;;; for each before descending into it, so nothing is materialized beyond one
;;; directory's names at a time.  root itself is not visited.  Symlinks are
;;; not followed on POSIX (no cycles).  The path handed to f is freed when f
;;; returns -- copy it to keep it.
;;;
;;; Parameters:
;;;   root -- the directory to walk
;;;   f    -- (fn [path is-dir] nil), called once per entry
;;;
;;; Returns:
;;;   (Ok nil) once the whole tree was visited, or (Err e) for the first
;;;   directory that could not be read (the walk stops there).
;;;
;;; Example:
;;;   (fs/walk-fn "/tmp/proj" (fn [p : cstr d : bool] : nil (println p)))
;;;
;;; Since: stdlib-os-surface P2
(defn fs/walk-fn [root : cstr f : (fn [cstr bool] nil)]
  #fx{FS}
  : (Result nil IoError)
  (match (fs/read-dir root)
    (Ok names) (let [r (fs/walk-names root names 0 f)]
                 (fs/paths-free names)
                 r)
    (Err e) (Err e)))
;;; fs/walk -- every path under root, depth first, as a vector.
;;;
;;; The convenience form of fs/walk-fn: the same order (sorted per
;;; directory, each directory before its contents), root itself excluded,
;;; symlinks not followed on POSIX.
;;;
;;; Parameters:
;;;   root -- the directory to walk
;;;
;;; Returns:
;;;   (Ok paths) -- a (Vec cstr) of fresh heap paths, each starting with
;;;   root; release it with fs/paths-free -- or (Err e) for the first
;;;   directory that could not be read.
;;;
;;; Example:
;;;   (match (fs/walk "/tmp/proj")
;;;     (Ok v)  (do (println (vec-len v)) (fs/paths-free v))
;;;     (Err e) (println (io-error/message e)))
;;;
;;; Since: stdlib-os-surface P2
(defn fs/walk [root : cstr]
  #fx{FS}
  : (Result (Vec cstr) IoError)
  (let [out (vec-new)]
    (match (fs/walk-fn root (fn [p : cstr d : bool] : nil (vec-push! out (fs/dup-cstr p))))
      (Ok _) (Ok out)
      (Err e) (do (fs/paths-free out) (Err e)))))
