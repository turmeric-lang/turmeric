;;; tur/concurrent -- stub concurrency types for linear resource tracking.
;;;
;;; Defines MutexGuard as a move-only struct wrapping a pthread_mutex_t pointer.
;;;
;;; Since: Phase LT4
;; LT4: concurrent.tur -- stub concurrency types for linear resource tracking.
;;
;; Defines MutexGuard as a move-only struct wrapping a pthread_mutex_t pointer.
;; Future versions will upgrade MutexGuard to lref<MutexGuard> once the LT4
;; annotation pass over all three resource types is complete.
;; ============================================================================
;; LT4: MutexGuard -- move-only RAII wrapper for a held mutex lock
;; ============================================================================
;;; MutexGuard -- a linear (exactly-once) RAII wrapper for a held mutex lock.
;;;
;;; Holding a MutexGuard means the mutex is currently locked by this thread.
;;; Marking the struct :linear (CK_LINEAR) prevents both silent copies (which
;;; would create a phantom lock holder) and silent drops (which would leak the
;;; lock).  Every MutexGuard must be explicitly consumed via mutex-guard-unlock.
;;;
;;; Since: LT4
(defstruct ^linear MutexGuard [mutex : ptr<void>])
;;; mutex-guard-lock -- lock a mutex and return a MutexGuard RAII token.
;;;
;;; Parameters:
;;;   mutex -- a ptr<void> pointing to a pthread_mutex_t.
;;;
;;; Returns:
;;;   A MutexGuard holding the locked mutex.
;;;
;;; Example:
;;;   (let [guard (mutex-guard-lock my-mutex)] ...)
;;;
;;; Since: LT4

(defn mutex-guard-lock [mutex] : MutexGuard
  ```c
  pthread_mutex_lock((pthread_mutex_t*)mutex);
  MutexGuard g;
  g.mutex = mutex;
  return g;
  ```)
;;; mutex-guard-unlock -- release the mutex held by a MutexGuard.
;;;
;;; Parameters:
;;;   guard -- a MutexGuard (by value; guard is consumed).
;;;
;;; Returns:
;;;   0 on success, error code from pthread_mutex_unlock otherwise.
;;;
;;; Example:
;;;   (mutex-guard-unlock guard)  ; => 0
;;;
;;; Since: LT4

(defn mutex-guard-unlock [guard : MutexGuard] : int
  ```c
  if (!guard.mutex) return -1;
  return pthread_mutex_unlock((pthread_mutex_t*)guard.mutex);
  ```)
;;; mutex-guard-valid? -- return true if the MutexGuard holds a non-NULL mutex.
;;;
;;; Parameters:
;;;   guard -- a MutexGuard value.
;;;
;;; Returns:
;;;   true if the underlying mutex pointer is non-NULL.
;;;
;;; Example:
;;;   (mutex-guard-valid? guard)  ; => true
;;;
;;; Since: LT4

(defn mutex-guard-valid? [guard : MutexGuard] : bool
  ```c
  return guard.mutex != NULL;
  ```)
