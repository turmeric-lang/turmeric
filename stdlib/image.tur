;;; tur/image -- application image dumps via serializable continuations.
;;;
;;; A warm-start facility in the style of Lisp `save-lisp-and-die`, Smalltalk
;;; image saves, and Emacs `pdumper`: capture a post-init continuation with
;;; Phase 21's `serial-shift`, write it to disk framed by a self-validating
;;; 72-byte header, and on a later run restore it instead of paying init again.
;;;
;;; The on-disk format is a `TurImageHeader` (see src/runtime/image.h --
;;; magic/version/build-stamp/payload-len/crc) followed by the TSER payload
;;; bytes produced by Phase 21's serial codegen. The build stamp (a SHA-256 of
;;; the running executable) pins an image to the binary that wrote it: a
;;; foreign or stale image is rejected cleanly (a 0 return), never resumed as
;;; garbage.
;;;
;;; SECURITY: loading an image is equivalent to `eval` -- it resumes captured
;;; code. Treat image files as trusted executables; never load one from an
;;; untrusted source. See docs/guides/image-dumps-guide.md.
;;;
;;; Since: Phase AI (application-image-dumps-plan)
;; stdlib/image.tur -- depends on the Phase 21 serial primitives
;; (tur_serial_cont_serialize / _deserialize / _resume, emitted as a C prelude
;; whenever a program uses serial-reset). Self-contained otherwise: the
;; SHA-256 and the 72-byte header codec are inline-C.  The one stdlib
;; dependency is serial.tur: `defimage-global` (AI3) marshals a declared global
;; through its Serializable instance.
;;
;; The header layout mirrors src/runtime/image.h byte-for-byte; the C unit test
;; (tests/image_unit.c) pins the canonical implementation and the two must stay
;; in lockstep.
(load "stdlib/serial.tur")
;; ---------------------------------------------------------------------------
;; Build stamp (AI4): SHA-256 of the running executable.
;;
;; This pins an image to the exact binary that wrote it. The plan's AI4.1
;; describes a linker-section stamp computed via a two-pass build; hashing the
;; running executable at load time delivers the same *safety* contract
;; (same binary -> same stamp; a different binary -> a different file -> a
;; different stamp -> clean rejection) without any platform-specific linker
;; magic. It does not guarantee byte-for-byte reproducibility across two builds
;; of the same source (a nicety, not a safety property). See the guide.
;; ---------------------------------------------------------------------------
;;; image/build-stamp -- SHA-256 (32 bytes) of the running executable.
;;;
;;; Returns:
;;;   A malloc'd 32-byte buffer (caller frees with image/free-stamp) as an int
;;;   pointer, or 0 if the executable image could not be read.
;;;
;;; Since: Phase AI
(defn image/build-stamp [] : int
  ```c
  #include <stdint.h>
  #include <windows.h>  /* tur:optional -- Windows only */
  #include <mach-o/dyld.h>  /* tur:optional -- macOS only */
  /* The two platform headers above are emitted as bare LEADING includes so the
   * codegen top-include hoister lifts them to file scope (each wrapped in
   * __has_include, so a platform that lacks one skips it).  They MUST NOT move
   * back inside the #ifdef blocks below: <mach-o/dyld.h> (macOS) and
   * <windows.h> (Windows) transitively define static-inline functions, and a
   * function-scope #include of either is a hard "function definition is not
   * allowed here" (codegen-image-dyld-include-emitted-mid-function).
   *
   * Read the running executable.  The path to "myself" is platform-specific:
   * Linux exposes /proc/self/exe, macOS has _NSGetExecutablePath, and Windows
   * has GetModuleFileNameA.  Without this, the build-stamp is 0 on Windows, so
   * with-image-cache-after-init never writes an image and warm-start silently
   * degrades to cold-start every time. */
#ifdef _WIN32
  char __exe_path[MAX_PATH];
  DWORD __plen = GetModuleFileNameA(NULL, __exe_path, (DWORD)sizeof(__exe_path));
  FILE *exe = (__plen > 0 && __plen < sizeof(__exe_path)) ? fopen(__exe_path, "rb") : NULL;
#elif defined(__APPLE__)
  char __exe_path[4096];
  uint32_t __plen = (uint32_t)sizeof(__exe_path);
  FILE *exe = (_NSGetExecutablePath(__exe_path, &__plen) == 0) ? fopen(__exe_path, "rb") : NULL;
#else
  FILE *exe = fopen("/proc/self/exe", "rb");
#endif
  if (!exe) return 0;
  if (fseek(exe, 0, SEEK_END) != 0) { fclose(exe); return 0; }
  long sz = ftell(exe);
  if (sz <= 0) { fclose(exe); return 0; }
  rewind(exe);
  size_t n = (size_t)sz;
  /* Build a pre-padded SHA-256 message so the compression loop -- inlined
   * below to avoid a nested helper function -- runs uniformly over whole
   * 64-byte blocks. */
  size_t total = (((n + 8) / 64) + 1) * 64;
  uint8_t *P = (uint8_t *)calloc(total, 1);
  if (!P) { fclose(exe); return 0; }
  size_t got = fread(P, 1, n, exe);
  fclose(exe);
  if (got != n) { free(P); return 0; }
  P[n] = 0x80;
  uint64_t bits = (uint64_t)n * 8;
  for (int j = 0; j < 8; j++) P[total - 1 - j] = (uint8_t)(bits >> (8 * j));
  static const uint32_t K[64] = {
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
  };
  uint32_t st[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
  for (size_t off = 0; off < total; off += 64) {
    const uint8_t *blk = P + off;
    uint32_t w[64];
    for (int i=0;i<16;i++) w[i]=((uint32_t)blk[i*4]<<24)|((uint32_t)blk[i*4+1]<<16)|((uint32_t)blk[i*4+2]<<8)|(uint32_t)blk[i*4+3];
    for (int i=16;i<64;i++) {
      uint32_t s0=((w[i-15]>>7)|(w[i-15]<<25))^((w[i-15]>>18)|(w[i-15]<<14))^(w[i-15]>>3);
      uint32_t s1=((w[i-2]>>17)|(w[i-2]<<15))^((w[i-2]>>19)|(w[i-2]<<13))^(w[i-2]>>10);
      w[i]=w[i-16]+s0+w[i-7]+s1;
    }
    uint32_t a=st[0],b=st[1],c=st[2],d=st[3],e=st[4],f=st[5],g=st[6],h=st[7];
    for (int i=0;i<64;i++) {
      uint32_t S1=((e>>6)|(e<<26))^((e>>11)|(e<<21))^((e>>25)|(e<<7));
      uint32_t ch=(e&f)^(~e&g);
      uint32_t t1=h+S1+ch+K[i]+w[i];
      uint32_t S0=((a>>2)|(a<<30))^((a>>13)|(a<<19))^((a>>22)|(a<<10));
      uint32_t mj=(a&b)^(a&c)^(b&c);
      uint32_t t2=S0+mj;
      h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;
    }
    st[0]+=a;st[1]+=b;st[2]+=c;st[3]+=d;st[4]+=e;st[5]+=f;st[6]+=g;st[7]+=h;
  }
  free(P);
  uint8_t *out = (uint8_t *)malloc(32);
  if (!out) return 0;
  for (int j=0;j<8;j++) { out[j*4]=(st[j]>>24)&0xff; out[j*4+1]=(st[j]>>16)&0xff; out[j*4+2]=(st[j]>>8)&0xff; out[j*4+3]=st[j]&0xff; }
  return (int64_t)(intptr_t)out;
  ```)
;;; image/free-stamp -- free a build stamp returned by image/build-stamp.

(defn image/free-stamp [p : int] : void
  ```c
  if (p) free((void *)(intptr_t)p);
  ```)
;;; image/exists? -- 1 if a readable file exists at path, else 0.

(defn image/exists? [path : cstr] : int
  ```c
  FILE *f = fopen(path, "rb");
  if (!f) return 0;
  fclose(f);
  return 1;
  ```)
;; ---------------------------------------------------------------------------
;; Resource-reacquisition hooks (AI5).
;;
;; OS-handle-backed values (files, sockets, GPU contexts) cannot ride in an
;; image -- they are STAG_PTR opaque and `TUR-E0018` rejects them at the
;; serial-shift site. The application re-acquires them with *reload hooks*,
;; and flushes/releases transient state before a save with *finalize hooks*.
;;
;; The registry lives in a single function's static storage so it is wholly
;; self-contained (no file-scope C global, which the single-file backend
;; cannot link). Hooks are plain `(fn [] int)` values stored as int64 fat
;; handles and invoked via TUR_APPLY0.
;;
;; Because a compiled program runs only `main` (top-level forms do not
;; execute), hooks cannot self-register at load time the way the plan's
;; `(defimage-reload-hook name ...)` sketch implies. Instead, *define* a hook
;; with a top-level `defn` (or the `defimage-reload-hook` sugar) and *install*
;; it with `image/register-reload-hook!` at the very top of `main` -- a point
;; that runs on BOTH cold and warm starts. This matters: a warm start skips
;; `init`, so anything registered inside `init` would be missing on exactly the
;; run that needs the reacquisition. Register before the with-image-cache call.
;; ---------------------------------------------------------------------------
;;; image/hook-registry -- backing store for reload/finalize hooks (internal).
;;;
;;; op 0: register a reload hook (arg = fat handle); returns the new count.
;;; op 1: run all reload hooks in registration order; returns the last result.
;;; op 2: register a finalize hook (arg = fat handle); returns the new count.
;;; op 3: run all finalize hooks in registration order; returns the last result.


(defn image/hook-registry [op : int arg : int] : int
  ```c
  static int64_t reloads[64]; static int rn = 0;
  static int64_t finals[64];  static int fn_ = 0;
  switch (op) {
    case 0: if (rn < 64) reloads[rn++] = arg; return rn;
    case 1: { int64_t last = 0; for (int i = 0; i < rn; i++) last = TUR_APPLY0(reloads[i]); return last; }
    case 2: if (fn_ < 64) finals[fn_++] = arg; return fn_;
    case 3: { int64_t last = 0; for (int i = 0; i < fn_; i++) last = TUR_APPLY0(finals[i]); return last; }
    default: return -1;
  }
  ```)
;;; image/register-reload-hook! -- install a hook run on warm start before resume.
;;;
;;; The hook is invoked after a valid image is selected and before the captured
;;; continuation resumes user code, in registration order. Use it to re-open
;;; files, re-bind sockets, or otherwise re-acquire OS handles that could not be
;;; serialised. Register at the top of `main`, before the with-image-cache call,
;;; so it is present on warm starts (which skip `init`).
;;;
;;; Parameters:
;;;   f -- a zero-arg hook (fn [] int); the return value is ignored
;;;
;;; Returns:
;;;   The number of reload hooks registered so far.
;;;
;;; Since: Phase AI (AI5.1)

(defn image/register-reload-hook! [^fat f : (fn [] int)] : int
  (image/hook-registry 0 f))
;;; image/run-reload-hooks -- invoke every registered reload hook in order.
;;;
;;; Returns the last hook's result (0 if none are registered). Called for you by
;;; the with-image-cache combinators on the warm path; call it directly only if
;;; you drive load-image! yourself.
;;;
;;; Since: Phase AI (AI5.1)

(defn image/run-reload-hooks [] : int (image/hook-registry 1 0))
;;; image/register-finalize-hook! -- install a hook run just before a save.
;;;
;;; The hook is invoked immediately before the image bytes are written, in
;;; registration order. Use it to flush buffers or release transient state that
;;; should not be captured. Register alongside the reload hooks at the top of
;;; `main`.
;;;
;;; Parameters:
;;;   f -- a zero-arg hook (fn [] int); the return value is ignored
;;;
;;; Returns:
;;;   The number of finalize hooks registered so far.
;;;
;;; Since: Phase AI (AI5.3)

(defn image/register-finalize-hook! [^fat f : (fn [] int)] : int
  (image/hook-registry 2 f))
;;; image/run-finalize-hooks -- invoke every registered finalize hook in order.
;;;
;;; Returns the last hook's result (0 if none are registered). Called for you by
;;; the with-image-cache combinators and save-image! just before writing bytes.
;;;
;;; Since: Phase AI (AI5.3)

(defn image/run-finalize-hooks [] : int (image/hook-registry 3 0))
;;; defimage-reload-hook -- define a named reload hook function.
;;;
;;; Sugar for `(defn name [] : int body)`: it pins the `[] : int` hook signature
;;; and gives the hook a stable top-level name (required -- the hook is invoked
;;; by name, never as an anonymous closure). It does NOT auto-register: install
;;; the hook with `(image/register-reload-hook! name)` at the top of `main`.
;;;
;;; Example:
;;;   (defimage-reload-hook reopen-log
;;;     (do (reopen-the-log!) 0))
;;;   ;; ... in main, before with-image-cache-after-init:
;;;   (image/register-reload-hook! reopen-log)
;;;
;;; Since: Phase AI (AI5.1)

(defmacro defimage-reload-hook [name & body] `(defn ~name [] : int (do ~@body)))
;;; defimage-finalize-hook -- define a named finalize hook function.
;;;
;;; Sugar for `(defn name [] : int body)`, the save-side companion of
;;; defimage-reload-hook. Install with `(image/register-finalize-hook! name)`.
;;;
;;; Since: Phase AI (AI5.3)

(defmacro defimage-finalize-hook [name & body]
  `(defn ~name [] : int (do ~@body)))
;; ---------------------------------------------------------------------------
;; Image globals (AI3).
;;
;; The image is the captured CONTINUATION, so a top-level `def ^mut` that the
;; captured frames do not close over is not in it: a global written during
;; cold-start init is silently back at its initial value after a warm start.
;; `defimage-global` declares a global that IS in the image.  The declaration
;; leaves three named defns behind -- a serializer and a deserializer (the
;; global's Serializable instance, monomorphically) and a tracker that
;; registers the pair by name -- and, like the hooks above, the tracker must be
;; called at the top of `main` (on both cold and warm starts) because compiled
;; top-level forms do not execute: `(image/track-globals! a b c)`.
;;
;; On save the registry is snapshotted into a second TSER section written after
;; the continuation bytes (the header's globals_offset locates it); on load it
;; is restored BEFORE the continuation resumes, so the resumed code reads the
;; post-init values.  Both sections ride inside payload_len.
;;
;; Section layout: [int64 n] then per global [int64 name_len][name]
;; [int64 bytes_len][bytes], where bytes is the Serializable payload.  A record
;; whose name is not registered in the loading process is skipped; a registered
;; global absent from the image keeps its current value.
;; ---------------------------------------------------------------------------
;;; image/global-registry -- backing store for image globals (internal).
;;;
;;; op 0: register (or replace by name) the ser/deser pair; returns the count.
;;; op 1: snapshot every registered global; returns a fresh bytes value
;;;       ({len; data}, caller frees with image/free-bytes) or NULL if none.
;;; op 2: restore globals from the bytes value in `bytes`; returns the number
;;;       of globals restored.
;;; op 3: the registered count.

(defn image/global-registry [op : int
                             name : cstr
                             ser : int
                             deser : int
                             bytes : ptr<void>] : int
  ```c
  static char *names[64]; static int64_t sers[64]; static int64_t desers[64]; static int gn = 0;
  switch (op) {
    case 0: {
      int i; for (i = 0; i < gn; i++) if (strcmp(names[i], name) == 0) break;
      if (i == gn) { if (gn >= 64) return -1; names[gn] = strdup(name); gn++; }
      sers[i] = ser; desers[i] = deser; return gn;
    }
    case 1: {
      if (gn == 0) return 0;
      int64_t **bufs = (int64_t **)malloc(sizeof(int64_t *) * (size_t)gn);
      if (!bufs) return 0;
      int64_t total = 8;
      for (int i = 0; i < gn; i++) {
        /* `ser` is `(fn [] ptr<void>)`: call slot 0 at that type, not the
         * int64 one TUR_APPLY0 spells (an indirect call through the wrong
         * function type; a call_indirect trap on WASM). */
        bufs[i] = (int64_t *)TUR_APPLY0_T(void *, sers[i]);
        int64_t bl = bufs[i] ? bufs[i][0] : 0;
        total += 8 + (int64_t)strlen(names[i]) + 8 + bl;
      }
      int64_t *out = (int64_t *)malloc((size_t)(8 + total));
      if (!out) { for (int i = 0; i < gn; i++) free(bufs[i]); free(bufs); return 0; }
      out[0] = total;
      uint8_t *c = (uint8_t *)(out + 1);
      int64_t n = gn; memcpy(c, &n, 8); c += 8;
      for (int i = 0; i < gn; i++) {
        int64_t nl = (int64_t)strlen(names[i]);
        memcpy(c, &nl, 8); c += 8;
        memcpy(c, names[i], (size_t)nl); c += nl;
        int64_t bl = bufs[i] ? bufs[i][0] : 0;
        memcpy(c, &bl, 8); c += 8;
        if (bl) { memcpy(c, bufs[i] + 1, (size_t)bl); c += bl; }
        free(bufs[i]);
      }
      free(bufs);
      return (int64_t)(intptr_t)out;
    }
    case 2: {
      const int64_t *in = (const int64_t *)bytes;
      if (!in || in[0] < 8) return 0;
      const uint8_t *c = (const uint8_t *)(in + 1), *end = c + in[0];
      int64_t n; memcpy(&n, c, 8); c += 8;
      int64_t restored = 0;
      for (int64_t k = 0; k < n; k++) {
        int64_t nl, bl;
        if (end - c < 8) break;
        memcpy(&nl, c, 8); c += 8;
        if (nl < 0 || end - c < nl) break;
        const char *nm = (const char *)c; c += nl;
        if (end - c < 8) break;
        memcpy(&bl, c, 8); c += 8;
        if (bl < 0 || end - c < bl) break;
        for (int i = 0; i < gn; i++) {
          if ((int64_t)strlen(names[i]) != nl || memcmp(names[i], nm, (size_t)nl) != 0) continue;
          int64_t *bb = (int64_t *)malloc((size_t)(8 + bl));
          if (!bb) return restored;
          bb[0] = bl;
          if (bl) memcpy(bb + 1, c, (size_t)bl);
          (void)TUR_APPLY1_T(int64_t, int64_t, desers[i], bb);
          free(bb);
          restored++;
          break;
        }
        c += bl;
      }
      return restored;
    }
    case 3: return gn;
    default: return -1;
  }
  ```)
;;; image/free-bytes -- free a bytes value returned by image/snapshot-globals.

(defn image/free-bytes [b : ptr<void>] : void
  ```c
  if (b) free(b);
  ```)
;;; image/bytes-null? -- true when a bytes/blob value is NULL.

(defn image/bytes-null? [b : ptr<void>] : bool
  ```c
  return b == NULL;
  ```)
;;; image/register-global! -- register a global's ser/deser pair by name.
;;;
;;; The low-level registration behind `defimage-global`; call it directly only
;;; when you hand-roll the pair.  A second registration under the same name
;;; replaces the first, so tracking at the top of `main` is idempotent.
;;;
;;; Parameters:
;;;   name  -- the global's name, the key the image section is matched on
;;;   ser   -- (fn [] ptr<void>): the global's current value as Serializable bytes
;;;   deser -- (fn [ptr<void>] int): overwrite the global from Serializable bytes
;;;
;;; Returns:
;;;   The number of globals registered so far.
;;;
;;; Since: Phase AI (AI3.2)

(defn image/register-global! [name : cstr
                              ^fat ser : (fn [] ptr<void>)
                              ^fat deser : (fn [ptr<void>] int)] : int
  (image/global-registry 0 name ser deser (image/null-bytes)))
;;; image/null-bytes -- the NULL bytes value (internal).

(defn image/null-bytes [] : ptr<void>
  ```c
  return NULL;
  ```)
;;; image/global-count -- how many image globals are registered.
;;;
;;; Since: Phase AI (AI3.2)

(defn image/global-count [] : int
  (image/global-registry 3 "" 0 0 (image/null-bytes)))
;;; image/snapshot-globals -- serialise every registered global into one bytes value.
;;;
;;; Returns a fresh {len; data} bytes value holding the globals section, or NULL
;;; when no global is registered.  Free it with image/free-bytes.  Called for
;;; you by save-image! and the with-image-cache combinators.
;;;
;;; Since: Phase AI (AI3.3)

(defn image/snapshot-globals [] : ptr<void>
  (image/bytes-of (image/global-registry 1 "" 0 0 (image/null-bytes))))
;;; image/bytes-of -- reinterpret an int carrier as a bytes value (internal).

(defn image/bytes-of [p : int] : ptr<void>
  ```c
  return (void *)(intptr_t)p;
  ```)
;;; image/restore-globals! -- overwrite registered globals from a globals section.
;;;
;;; Parameters:
;;;   bytes -- a globals section as written by image/snapshot-globals (NULL is a no-op)
;;;
;;; Returns:
;;;   The number of globals restored.
;;;
;;; Since: Phase AI (AI3.3)

(defn image/restore-globals! [bytes : ptr<void>] : int
  (image/global-registry 2 "" 0 0 bytes))
;;; defimage-global -- declare a mutable global that rides in the image.
;;;
;;; `(defimage-global name :T initial)` is `(def ^mut name :T initial)` plus
;;; the machinery that puts the global in the image: it also defines
;;; `name/image-ser` and `name/image-deser` (the global's Serializable
;;; instance, monomorphically -- T must have one) and `name/image-track!`,
;;; which registers the pair.  Because compiled top-level forms do not run,
;;; the tracker is NOT called for you: put `(image/track-globals! name ...)`
;;; at the top of `main`, before the with-image-cache call, so the global is
;;; registered on both the cold start that writes the image and the warm
;;; start that restores it.
;;;
;;; Example:
;;;   (defimage-global counter :int 0)
;;;   (defn do-init [] : int (do (set! counter 42) 0))
;;;   (defn main [] : int
;;;     (do (image/track-globals! counter)
;;;         (with-image-cache-after-init "app.img" do-init do-loop)))
;;;   ;; a warm start sees counter = 42, not 0
;;;
;;; Since: Phase AI (AI3.2)

(defmacro defimage-global [name ty init]
  (let [ser   (str->sym (str-append (symbol-name name) "/image-ser"))
        deser (str->sym (str-append (symbol-name name) "/image-deser"))
        track (str->sym (str-append (symbol-name name) "/image-track!"))]
    `(do
       (def ^mut ~name ~ty ~init)
       (defn ~ser [] : ptr<void> (serialize ~name))
       (defn ~deser [b : ptr<void>] : int
         (do (set! ~name (:: (deserialize b) ~ty)) 0))
       (defn ~track [] : int
         (image/register-global! ~(symbol-name name) ~ser ~deser)))))
;;; image/track-globals! -- register the named image globals (call at the top of main).
;;;
;;; `(image/track-globals! a b c)` expands to the `a/image-track!` ... calls
;;; that `defimage-global` defined.  Idempotent; evaluates to 0.
;;;
;;; Since: Phase AI (AI3.2)

(defmacro image/track-globals! [& names]
  (if (empty? names)
    0
    `(do
       (~(str->sym (str-append (symbol-name (first names)) "/image-track!")))
       (image/track-globals! ~@(rest names)))))
;; ---------------------------------------------------------------------------
;; File I/O at the continuation boundary. All pointer juggling lives in C so
;; the Turmeric surface stays in plain ints/handles. The 4-line CRC-32 loop is
;; inlined at each site (no nested helper function, which the compiled backend
;; rejects as an invalid storage class).
;; ---------------------------------------------------------------------------
;;; image/crc32- -- chainable CRC-32 (zlib convention) over n bytes at p (internal).

(defn image/crc32- [crc : int p : ptr<void> n : int] : int
  ```c
  const uint8_t *b = (const uint8_t *)p;
  uint32_t c = ~(uint32_t)crc;
  for (int64_t i = 0; i < n; i++) {
    c ^= b[i];
    for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(c & 1)));
  }
  return (int64_t)(uint32_t)~c;
  ```)
;;; image/write-image-file! -- frame continuation k (+ globals) and write to path.
;;;
;;; The C half of image/save-cont-to-file!: marshals k via the Phase 21 serial
;;; codec, writes the 72-byte header carrying `stamp`, the continuation bytes,
;;; and -- when `globals` is non-NULL -- the AI3 globals section
;;; ([int64 len][bytes]) that the header's globals_offset (byte 56) locates.
;;; payload_len covers both sections.  The header's flags word
;;; carries TUR_IMAGE_FLAG_PAYLOAD_CRC and a u32 CRC-32 of the payload trails
;;; it (outside payload_len).
;;;
;;; Parameters:
;;;   path    -- destination path
;;;   k       -- the serial-continuation handle from serial-shift
;;;   stamp   -- 32-byte build stamp pointer (image/build-stamp), or 0 to zero-fill
;;;   globals -- a globals section from image/snapshot-globals, or NULL for none
;;;
;;; Returns:
;;;   1 on success, 0 on failure (nil k, unwritable path, short write).
;;;
;;; Since: Phase AI (AI3.3)

(defn image/write-image-file! [path : cstr
                               k : ptr<void>
                               stamp : int
                               globals : ptr<void>] : int
  ```c
  #include <stdint.h>
  #include <time.h>
  if (!k) return 0;
  uint8_t *bb = (uint8_t *)(intptr_t)tur_serial_cont_serialize((int64_t)(intptr_t)k);
  if (!bb) return 0;
  int64_t plen; memcpy(&plen, bb, 8);
  const uint8_t *payload = bb + 8;
  if (plen < 0) { free(bb); return 0; }
  const int64_t *gsec = (const int64_t *)globals;
  int64_t glen = gsec ? gsec[0] : 0;
  if (glen < 0) { free(bb); return 0; }
  uint64_t goff = gsec ? (uint64_t)(72 + plen) : 0u;
  uint64_t total = (uint64_t)plen + (gsec ? 8u + (uint64_t)glen : 0u);
  FILE *f = fopen(path, "wb");
  if (!f) { free(bb); return 0; }
  uint8_t hdr[72]; memset(hdr, 0, 72);
  uint32_t magic=0x54555249u, ver=1u;
  /* flags bit 0 (TUR_IMAGE_FLAG_PAYLOAD_CRC): a u32 CRC-32 of the payload
   * follows it, so a flipped byte in an env is caught, not resumed. */
  uint32_t flags=1u;
  memcpy(hdr+0,&magic,4); memcpy(hdr+4,&ver,4);
  if (stamp) memcpy(hdr+8,(const void*)(intptr_t)stamp,32);
  memcpy(hdr+40,&total,8);
  struct timespec ts; uint64_t cns=0;
  if (clock_gettime(CLOCK_REALTIME,&ts)==0) cns=(uint64_t)ts.tv_sec*1000000000ull+(uint64_t)ts.tv_nsec;
  memcpy(hdr+48,&cns,8);
  memcpy(hdr+56,&goff,8);
  memcpy(hdr+64,&flags,4);
  { uint32_t crc=0xFFFFFFFFu; for (int i=0;i<68;i++){ crc^=hdr[i]; for(int b=0;b<8;b++) crc=(crc>>1)^(0xEDB88320u&(uint32_t)(-(int32_t)(crc&1))); } crc=~crc; memcpy(hdr+68,&crc,4); }
  int ok = (fwrite(hdr,1,72,f)==72);
  if (ok && plen>0) ok = (fwrite(payload,1,(size_t)plen,f)==(size_t)plen);
  int64_t pcrc = image_slcrc32_hy(0, (void *)payload, plen);
  if (ok && gsec) {
    ok = (fwrite(&glen,1,8,f)==8);
    if (ok && glen>0) ok = (fwrite(gsec+1,1,(size_t)glen,f)==(size_t)glen);
    pcrc = image_slcrc32_hy(pcrc, (void *)&glen, 8);
    pcrc = image_slcrc32_hy(pcrc, (void *)(gsec+1), glen);
  }
  if (ok) { uint32_t pc = (uint32_t)pcrc; ok = (fwrite(&pc,1,4,f)==4); }
  fclose(f);
  free(bb);
  return ok ? 1 : 0;
  ```)
;;; image/save-cont-to-file! -- serialise continuation k and write it to path.
;;;
;;; Marshals k via the Phase 21 serial codec, frames the resulting payload with
;;; a 72-byte header carrying `stamp`, appends the registered image globals as
;;; a second section (AI3), and writes it to `path`.
;;;
;;; Parameters:
;;;   path  -- destination path
;;;   k     -- the serial-continuation handle from serial-shift
;;;   stamp -- 32-byte build stamp pointer (image/build-stamp), or 0 to zero-fill
;;;
;;; Returns:
;;;   1 on success, 0 on failure (nil k, unwritable path, short write).
;;;
;;; Since: Phase AI

(defn image/save-cont-to-file! [path : cstr k : ptr<void> stamp : int] : int
  (let [g  (image/snapshot-globals)
        ok (image/write-image-file! path k stamp g)]
    (do (image/free-bytes g) ok)))
;;; image/read-image-file -- read + validate an image into a blob (internal).
;;;
;;; Validates magic / version / flags / header CRC and, when `stamp` is
;;; non-zero, the build stamp; holds payload_len to the file's real size;
;;; checks the payload CRC when the header says one follows; and checks the
;;; continuation bytes against this program's frame registry.  Returns a
;;; malloc'd blob laid out as [int64 cont_len][cont bytes]
;;; [int64 globals_len][globals bytes] (globals_len is 0 for an image with no
;;; globals section), or NULL on any validation / I-O failure.  The blob's head
;;; is exactly the buffer tur_serial_cont_deserialize consumes.
;;;
;;; Since: Phase AI (AI3.3)

(defn image/read-image-file [path : cstr stamp : int] : ptr<void>
  ```c
  #include <stdint.h>
  FILE *f = fopen(path, "rb");
  if (!f) return NULL;
  uint8_t hdr[72];
  if (fread(hdr,1,72,f)!=72) { fclose(f); return NULL; }
  uint32_t magic; memcpy(&magic,hdr+0,4);
  if (magic != 0x54555249u) { fclose(f); return NULL; }
  uint32_t stored_crc; memcpy(&stored_crc,hdr+68,4);
  uint32_t crc=0xFFFFFFFFu; for (int i=0;i<68;i++){ crc^=hdr[i]; for(int b=0;b<8;b++) crc=(crc>>1)^(0xEDB88320u&(uint32_t)(-(int32_t)(crc&1))); } crc=~crc;
  if (stored_crc != crc) { fclose(f); return NULL; }
  uint32_t ver; memcpy(&ver,hdr+4,4);
  if (ver != 1u) { fclose(f); return NULL; }
  uint32_t flags; memcpy(&flags,hdr+64,4);
  if (flags & ~1u) { fclose(f); return NULL; }       /* unknown flag bits */
  if (stamp && memcmp(hdr+8,(const void*)(intptr_t)stamp,32)!=0) { fclose(f); return NULL; }
  int64_t plen; { uint64_t pl; memcpy(&pl,hdr+40,8); plen=(int64_t)pl; }
  int64_t goff; { uint64_t go; memcpy(&go,hdr+56,8); goff=(int64_t)go; }
  /* security-audit-plan M-1: payload_len is the file's own word, and it sizes
   * the malloc below.  Hold it to the bytes actually present, so a header
   * that claims 2^62 bytes is a rejected image rather than a giant
   * allocation. */
  int64_t avail;
  {
    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
    long fend = ftell(f);
    if (fend < 72 || fseek(f, 72, SEEK_SET) != 0) { fclose(f); return NULL; }
    avail = (int64_t)fend - 72 - ((flags & 1u) ? 4 : 0);
  }
  if (plen < 0 || plen > avail) { fclose(f); return NULL; }
  /* The continuation section is everything before globals_offset (or the
   * whole payload when there is no globals section). */
  int64_t clen = plen;
  if (goff) {
    if (goff < 72 || goff - 72 > plen) { fclose(f); return NULL; }
    clen = goff - 72;
  }
  int64_t grest = plen - clen;   /* [int64 glen][bytes] on disk, or 0 */
  uint8_t *buf = (uint8_t *)malloc((size_t)(8 + clen + (grest ? grest : 8)));
  if (!buf) { fclose(f); return NULL; }
  memcpy(buf, &clen, 8);
  if (clen>0 && fread(buf+8,1,(size_t)clen,f)!=(size_t)clen) { free(buf); fclose(f); return NULL; }
  if (grest) {
    if (grest < 8 || fread(buf+8+clen,1,(size_t)grest,f)!=(size_t)grest) { free(buf); fclose(f); return NULL; }
    int64_t glen; memcpy(&glen, buf+8+clen, 8);
    if (glen < 0 || glen != grest - 8) { free(buf); fclose(f); return NULL; }
  } else {
    int64_t zero = 0; memcpy(buf+8+clen, &zero, 8);
  }
  if (flags & 1u) {
    /* The payload sits contiguously at buf+8 (continuation, then the globals
     * section when there is one), exactly as it did on disk. */
    uint32_t want;
    if (fread(&want,1,4,f) != 4 ||
        (uint32_t)image_slcrc32_hy(0, (void *)(buf + 8), plen) != want) {
      free(buf); fclose(f); return NULL;
    }
  }
  fclose(f);
#ifdef SK_TAG_CALL
  /* The continuation must also rebuild: checked here so that a damaged or
   * foreign continuation is an image that does not load (a cold start), not a
   * panic inside image/blob-resume!. */
  if (tur_serial_cont_check((int64_t)(intptr_t)buf) != 0) { free(buf); return NULL; }
#endif
  return (void *)buf;
  ```)
;;; image/loadable? -- 1 if path is a valid image for `stamp`.
;;;
;;; Runs every check image/load-resume-file! runs -- magic, version, header
;;; flags and CRC, the build stamp (which must equal `stamp`, the running
;;; binary's), the payload's length against the file and its CRC, and the
;;; continuation bytes against this program's frame registry -- so a 1 here
;;; means the load will resume rather than fail.  A missing, corrupt, foreign
;;; or truncated image returns 0.  Callers use it to decide whether to resume
;;; an image, so that a resumed value of 0 is never confused with a load
;;; failure.
;;;
;;; Since: Phase AI

(defn image/loadable? [path : cstr stamp : int] : int
  (if (= stamp 0)
    0
    (let [blob (image/read-image-file path stamp)]
      (if (image/bytes-null? blob) 0 (do (image/free-bytes blob) 1)))))

;;; image/blob-globals -- the globals section inside a read blob (internal).
;;;
;;; Returns a bytes view ({len; data}) into the blob, or NULL when the image
;;; carried no globals.  The view borrows the blob; do not free it.

(defn image/blob-globals [blob : ptr<void>] : ptr<void>
  ```c
  if (!blob) return NULL;
  int64_t clen; memcpy(&clen, blob, 8);
  int64_t *g = (int64_t *)((uint8_t *)blob + 8 + clen);
  return g[0] > 0 ? (void *)g : NULL;
  ```)
;;; image/blob-resume! -- deserialise the blob's continuation and resume it on v.
;;;
;;; Consumes (frees) the blob.  Returns the resumed continuation's value.

(defn image/blob-resume! [blob : ptr<void> v : int] : int
  ```c
  if (!blob) return 0;
  int64_t kk = tur_serial_cont_deserialize((int64_t)(intptr_t)blob);
  int64_t r = tur_serial_cont_resume(kk, (int64_t)v);
  free(blob);
  return (int64_t)r;
  ```)
;;; image/load-resume-file! -- read + validate an image and resume it on v.
;;;
;;; Validates magic / version / CRC. When `stamp` is non-zero, also requires
;;; the header build-stamp to equal it (build-stamp safety, AI4); pass 0 to
;;; skip the stamp check (the --unsafe-image-skip-build-check escape hatch).
;;; Registered image globals (AI3) are restored from the image's globals
;;; section BEFORE the continuation resumes.
;;;
;;; Parameters:
;;;   path  -- source path
;;;   stamp -- 32-byte build-stamp pointer to enforce, or 0 to skip the check
;;;   v     -- the value to resume the captured continuation with
;;;
;;; Returns:
;;;   The resumed continuation's value on success (control transfers into the
;;;   captured tail), or 0 on any validation/I-O failure (no resume occurs).
;;;
;;; Since: Phase AI

(defn image/load-resume-file! [path : cstr stamp : int v : int] : int
  (let [blob (image/read-image-file path stamp)]
    (if (image/bytes-null? blob)
      0
      (do
        (image/restore-globals! (image/blob-globals blob))
        (image/blob-resume! blob v)))))
;; ---------------------------------------------------------------------------
;; High-level API (AI2).
;; ---------------------------------------------------------------------------
;;; save-image! -- capture the current continuation and write it to path.
;;;
;;; Captures at the serial-shift site: the continuation is the rest of the
;;; enclosing serial-reset after this call. Returns 1 on a successful write.
;;; On its own the captured continuation is the empty (identity) tail; the
;;; useful capture happens via with-image-cache-after-init, which places the
;;; capture between an init phase and a long-running loop.
;;;
;;; Since: Phase AI


(defn save-image! [path : cstr] : int
  (serial-reset (serial-shift (fn [k : ptr<void>] : int
                                (let [_     (image/run-finalize-hooks)
                                      stamp (image/build-stamp)
                                      ok    (image/save-cont-to-file! path
                                              k
                                              stamp)]
                                  (do (image/free-stamp stamp) ok)))
                  0)))
;;; load-image! -- read an image and resume the continuation it holds.
;;;
;;; Validates magic/version/crc and the build stamp against the running
;;; binary. On a clean image, control transfers into the resumed continuation.
;;; On any validation failure returns 0 (no resume).
;;;
;;; Note: a return of 0 is ambiguous -- it is also what a resumed continuation
;;; that evaluates to 0 returns. When the cold/warm decision matters, gate on
;;; image/loadable? first (as with-image-cache-after-init does) rather than on
;;; this value.
;;;
;;; Since: Phase AI

(defn load-image! [path : cstr] : int
  (let [stamp (image/build-stamp)
        _     (image/run-reload-hooks)
        r     (image/load-resume-file! path stamp 0)]
    (do (image/free-stamp stamp) r)))
;;; with-image-cache-after-init -- the primary warm-start combinator (AIQ1).
;;;
;;; On a cold start (no valid image): runs init, captures the continuation
;;; that runs loop, writes it to path, then runs loop. On a warm start (valid
;;; image present): skips init, restores the captured continuation, and jumps
;;; straight into loop.
;;;
;;; Parameters:
;;;   path -- image cache path
;;;   init -- a fn [] run only on cold start (expensive setup)
;;;   loop -- a fn [] run on both paths (the steady-state work)
;;;
;;; This is a macro, not a function: `init` and `loop` are spliced as call
;;; targets so the captured continuation tail `(loop)` is a call to a *named*
;;; top-level function. The serial-shift collector reconstructs frames by
;;; stable name, so the tail cannot be a heap closure -- it must be a named
;;; (serializable) continuation. Pass top-level `defn` names for init and loop.
;;;
;;; For a *cross-process* warm start to resume correctly, loop must reduce to a
;;; serializable continuation (named frames, int/cstr/Serializable envs) -- the
;;; same constraint Serializable continuations impose on serial-shift.
;;;
;;; Since: Phase AI

(defmacro with-image-cache-after-init [path init loop]
  `(let [stamp (image/build-stamp)
         ok    (image/loadable? ~path stamp)]
     (if (= ok 1)
       ;; warm: re-acquire resources, then resume the pre-checked image.
       (let [_    (image/run-reload-hooks)
             warm (image/load-resume-file! ~path stamp 0)]
         (do (image/free-stamp stamp) warm))
       (do
         (image/free-stamp stamp)
         (serial-reset (~init)
           (serial-shift (fn [k : ptr<void>] : int
                           (let [_ (image/run-finalize-hooks)
                                 s (image/build-stamp)]
                             (do
                               (image/save-cont-to-file! ~path k s)
                               (image/free-stamp s)
                               ;; cold-start: resume the captured tail once to run loop.
                               (image/load-resume-file! ~path 0 0))))
             0)
           (~loop))))))
;;; with-image-cache -- single-body warm-start wrapper.
;;;
;;; If a valid image exists, restore it; otherwise run body, then capture an
;;; image after body returns. Prefer with-image-cache-after-init unless body
;;; ends in a long-running loop you want to dump between iterations.
;;;
;;; Since: Phase AI

(defn with-image-cache [path : cstr ^fat body : (fn [] int)] : int
  (let [stamp (image/build-stamp)
        ok    (image/loadable? path stamp)]
    (if (= ok 1)
      (let [_    (image/run-reload-hooks)
            warm (image/load-resume-file! path stamp 0)]
        (do (image/free-stamp stamp) warm))
      (do (image/free-stamp stamp) (body) (save-image! path) 0))))
