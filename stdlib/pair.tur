;;; tur/pair -- typed Pair[A B]: parameterized two-element tuple.
;;;
;;; Generic two-element tuple with typed first and second elements.
;;; Runtime layout specializes fst/snd for concrete A/B.
;;;
;;; Since: Phase TC1-F
;; Phase TC1-F: Typed Pair[A B]
;; Generic two-element tuple with typed first and second elements.
;; Runtime layout specializes fst/snd for concrete A/B.
;;; TurMutCell -- internal: the shared heap cell of a `^mut` a lambda captures.
;;;
;;; A compiled closure copies each variable it captures into its env, so a
;;; `set!` in one closure (or in the enclosing scope) was invisible to every
;;; other copy. The elaborator gives such a variable one of these cells and
;;; rewrites its reads and writes to the field, so every env shares the cell
;;; (compiled-closure-copies-a-captured-mut). Not for direct use.
;;;
;;; Since: v0.56
(defstruct TurMutCell :heap [A] (v A))
;;; Pair -- parameterized two-element tuple with element types A and B.
;;;
;;; Since: Phase TC1
(defstruct Pair [A B] (fst A) (snd B))
;;; pair -- construct a Pair[A B].
;;;
;;; Parameters:
;;;   a -- first element (type A)
;;;   b -- second element (type B)
;;;
;;; Returns:
;;;   A Pair[A B] value.
;;;
;;; Example:
;;;   (pair 1 2)  ; => (1, 2)
;;;
;;; Since: Phase TC1

(defn pair [A B] [a :A b :B] : (Pair A B) (make-struct Pair :fst a :snd b))
;;; pair-fst -- return the first element of a Pair[A B].
;;;
;;; Parameters:
;;;   p -- Pair[A B]
;;;
;;; Returns:
;;;   The first element of type A.
;;;
;;; Example:
;;;   (pair-fst (pair 10 20))  ; => 10
;;;
;;; Since: Phase TC1

(defn pair-fst [A B] [p : (Pair A B)] :A (.fst p))
;;; pair-snd -- return the second element of a Pair[A B].
;;;
;;; Parameters:
;;;   p -- Pair[A B]
;;;
;;; Returns:
;;;   The second element of type B.
;;;
;;; Example:
;;;   (pair-snd (pair 10 20))  ; => 20
;;;
;;; Since: Phase TC1

(defn pair-snd [A B] [p : (Pair A B)] :B (.snd p))
;;; pair-free -- compatibility no-op for Pair[A B] values.
;;;
;;; Parameters:
;;;   p -- Pair[A B]
;;;
;;; Example:
;;;   (pair-free my-pair)
;;;
;;; Since: Phase TC1

(defn pair-free [A B] [p : (Pair A B)]
  #fx{}
  :void
  ```c
  (void)p;
  ```)
;;; pair-eq? -- compare two Pair[A B] values element-wise.
;;;
;;; Parameters:
;;;   p1      -- first Pair[A B]
;;;   p2      -- second Pair[A B]
;;;   fst-cmp -- comparator for first element fn [a :int b :int] :bool
;;;   snd-cmp -- comparator for second element fn [a :int b :int] :bool
;;;
;;; Returns:
;;;   true if both first and second elements are equal under their comparators.
;;;
;;; Example:
;;;   (pair-eq? (pair 1 2) (pair 1 2) (fn [a b] (= a b)) (fn [a b] (= a b)))  ; => true
;;;
;;; Since: Phase TC1

(defmacro pair-eq? [p1 p2 fst-cmp snd-cmp]
  `(if (~fst-cmp (.fst ~p1) (.fst ~p2)) (~snd-cmp (.snd ~p1) (.snd ~p2)) false))
;;; pair-eq-carrier? -- legacy carrier-ABI helper used inside Pair's Eq instance.

(defn pair-eq-carrier? [A B] [p1 : int
                              p2 : int
                              ^borrow ^fat fst-cmp : (fn [A A] bool)
                              ^borrow ^fat snd-cmp : (fn [B B] bool)]
  #fx{}
  : bool
  ```c
  struct { int64_t fst; int64_t snd; } *a = (void*)(intptr_t)p1;
  struct { int64_t fst; int64_t snd; } *b = (void*)(intptr_t)p2;
  if (!a && !b) return true;
  if (!a || !b) return false;
  /* CRU B-3: fst-cmp/snd-cmp are fat closure boxes; fat-dispatch via slot 0. */
  bool fst_eq = ((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)fst_cmp)[0])((void*)(intptr_t)fst_cmp, a->fst, b->fst);
  bool snd_eq = ((int64_t(*)(void*, int64_t, int64_t))(intptr_t)((int64_t*)(intptr_t)snd_cmp)[0])((void*)(intptr_t)snd_cmp, a->snd, b->snd);
  return fst_eq && snd_eq;
  ```)
;;; Eq [Pair] -- element-wise equality using each component's Eq instance.
;; TC1-25: Phase PTC4 -- constrained Eq instance for Pair[A B].
;; Note: element comparison uses integer equality; correct for all primitive A/B.
;; M4c-pre: rewrite to consult by-value fields directly via Eq A / Eq B,
;; mirroring the Eq Tuple2 change.  See
;; docs/archive/m4c-stdlib-carrier-helpers-block-dispatch-rewrite.md.

(definstance Eq [Pair]
  [(Eq A) (Eq B)]
  (eq? [x y] (and (eq? (.fst x) (.fst y)) (eq? (.snd x) (.snd y)))))
