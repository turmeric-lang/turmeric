;;; tur/str -- UTF-8 string view (pointer + length).
;;;
;;; Borrowed string view type. Does not own its memory; the underlying
;;; buffer must outlive the str handle.
;;;
;;; Since: Phase B1
;; Str type for Turmeric
;; UTF-8 string as a borrowed view (pointer + length)
;;; str-from-cstr -- create a str view from a NUL-terminated C string.
;;;
;;; Parameters:
;;;   cstr -- NUL-terminated C string pointer
;;;
;;; Returns:
;;;   Pointer to a newly allocated str struct (p + len). Does not copy the
;;;   underlying string data; the caller retains ownership of the original buffer.
;;;
;;; Example:
;;;   (str-from-cstr "hello")  ; => <str ptr>
;; Create a str from a C string (NUL-terminated)
(defn str-from-cstr [cstr] : ptr<void>
  ```c
  const char *s = (const char*)cstr;
  size_t len = strlen(s);
  struct { const char *p; size_t len; } *str = malloc(sizeof(*str));
  str->p = s;
  str->len = len;
  return str;
  ```)
;;; str-len -- return the length of a str in bytes.
;;;
;;; Parameters:
;;;   s -- str pointer returned by str-from-cstr
;;;
;;; Returns:
;;;   Length of the string in bytes (not characters).
;;;
;;; Example:
;;;   (str-len (str-from-cstr "hello"))  ; => 5
;; Get string length in bytes

(defn str-len [s] : int
  ```c
  struct { const char *p; size_t len; } *str = (void*)s;
  return (int)str->len;
  ```)
;;; str-eq? -- check whether two str values have identical byte contents.
;;;
;;; Parameters:
;;;   s1 -- first str pointer
;;;   s2 -- second str pointer
;;;
;;; Returns:
;;;   true if both strings have the same length and identical bytes.
;;;
;;; Example:
;;;   (str-eq? (str-from-cstr "hi") (str-from-cstr "hi"))  ; => true
;;;
;;; Since: Phase E1
;; Check if two strings are equal

(defn str-eq? [s1 s2] : bool
  ```c
  struct { const char *p; size_t len; } *a = (void*)s1;
  struct { const char *p; size_t len; } *b = (void*)s2;
  if (a == NULL || b == NULL) return a == b;
  if (a->len != b->len) return false;
  return memcmp(a->p, b->p, a->len) == 0;
  ```)
;;; str-free -- free the str struct (does not free the underlying string data).
;;;
;;; Parameters:
;;;   s -- str pointer to free
;;;
;;; Example:
;;;   (str-free my-str)
;; Free the str struct (does NOT free the underlying string data)

(defn str-free [s] : int
  ```c
  free((void *)(intptr_t)s);
  return 0;
  ```)
;; str-concat + int->str live in the dependency-free leaf stdlib/str-build.tur
;; so range-bound.tur can pull the same builders without also loading str.tur's
;; Eq [str] instance (which perturbs unrelated instance resolution). load dedups
;; by file, so consumers loading both str.tur and str-build.tur are fine.

(load "stdlib/str-build.tur")
;;; Eq [str] -- eq? delegates to str-eq? for byte-level string equality.
;; Phase E1: Eq instance for str -- wires eq? to str-eq?

(definstance Eq [str] (eq? [x y] (str-eq? x y)))
;;; str->int -- parse a NUL-terminated :cstr to int64 (decimal).
;;;
;;; Parameters:
;;;   s -- :cstr string to parse
;;;
;;; Returns:
;;;   Parsed integer value, or 0 if s is NULL or non-numeric.
;;;
;;; Example:
;;;   (str->int "42")  ; => 42
;;;
;;; Since: Phase B1

(defn str->int [s : cstr] : int
  ```c
  return s ? (int64_t)atoll((const char *)(intptr_t)s) : 0;
  ```)
;;; cstr->parse-int -- parse a raw int (cstr pointer stored as int64) to int64.
;;;
;;; Parameters:
;;;   s -- raw :int holding a char* pointer
;;;
;;; Returns:
;;;   Parsed integer value, or 0 if pointer is NULL.
;;;
;;; Example:
;;;   (cstr->parse-int some-int-ptr)  ; => parsed int
;;;
;;; Since: Phase B1

(defn cstr->parse-int [s : int] : int
  ```c
  const char *cs = (const char *)(intptr_t)s;
  return cs ? (int64_t)atoll(cs) : 0;
  ```)
;; Sum-types plan T9: Either-based migration of a lossy "value or error" site.
;; `str->int` / `cstr->parse-int` above both fold every failure -- a NULL
;; pointer, an empty string, or trailing non-numeric garbage -- into the
;; sentinel `0`, which is indistinguishable from a legitimately-parsed 0.
;; `str->int-checked` keeps the error detail by returning a real binary sum:
;; `(Right n)` on a fully-consumed parse, or `(Left code)` describing why the
;; parse failed.  Callers `match` on it instead of guessing about 0.
;;
;; Requires the Either sum type; str.tur is not auto-loaded, so pulling in
;; stdlib/either.tur here only affects programs that explicitly load str.tur.

(load "stdlib/either.tur")
;;; str->int-checked -- parse a cstr to an int, reporting failure via Either.
;;;
;;; Unlike str->int / cstr->parse-int (which return the sentinel 0 on any
;;; failure), this distinguishes success from each failure mode by carrying an
;;; error code in the Left arm.
;;;
;;; Parameters:
;;;   s -- the source string (cstr; a NULL/empty string is a Left)
;;;
;;; Returns:
;;;   (Right n)  -- s parsed cleanly to the integer n (whole string consumed).
;;;   (Left 0)   -- s was NULL or empty.
;;;   (Left 1)   -- s was non-empty but not a valid base-10 integer, or had
;;;                 trailing non-numeric characters.
;;;
;;; Example:
;;;   (from-right -1 (str->int-checked "42"))  ; => 42
;;;   (left? (str->int-checked "12x"))         ; => true  (trailing garbage)
;;;   (left? (str->int-checked ""))            ; => true  (empty)
;;;
;;; Since: Phase sum-types-either

(defn str->int-checked [s : cstr] : (Either int int)
  ```c
  const char *cs = (const char *)(intptr_t)s;
  if (!cs || *cs == '\0') return ctor_Left((int64_t)0);
  char *end = (char *)0;
  long long v = strtoll(cs, &end, 10);
  if (end == cs || *end != '\0') return ctor_Left((int64_t)1);
  return ctor_Right((int64_t)v);
  ```)
