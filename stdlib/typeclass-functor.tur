;;; tur/typeclass-functor -- minimal Functor typeclass stub for typed-collection definstances.
;;;
;;; Auto-loaded so list, vec, and other typed-collection modules
;;; can declare (definstance Functor [...] ...) without importing typeclass.tur.
;;;
;;; Since: Phase TS5
;; Phase TS5: Minimal Functor class stub for typed-collection definstances.
;; Auto-loaded so that list.tur can declare (definstance Functor [Cons] ...)
;; without requiring the user to import stdlib/typeclass.tur.
;; The full typeclass.tur (with all typeclasses) is still available on demand
;; via (load "stdlib/typeclass.tur").
;;; Functor -- map a function over every element of a container, keeping its shape.
;;;
;;; Parameters:
;;;   ^f -- the container's type constructor (kind * -> *): Option, Cons,
;;;         (Result _ B), Parser, ...
;;;
;;; Methods:
;;;   fmap -- a container of the same shape as `container` with `g` applied to
;;;           each element.  `g` is a `:fn` carrier (tur_poly_fn_t), so a
;;;           capturing closure can be passed directly.
;;;
;;; Laws:
;;;   (fmap c (fn [x] x))      = c
;;;   (fmap (fmap c g) h)      = (fmap c (fn [x] (h (g x))))
;;;
;;; Example:
;;;   (unwrap-or (fmap (some 20) (fn [x : int] : int (+ x 1))) 0)   ; => 21
;;;
;;; Since: Phase CCL
(defclass Functor [^f] (fmap [container : (f a) g : (fn [a] b)] : (f b)))
