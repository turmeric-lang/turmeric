;;; tur/range-bound -- Bound: typed range endpoints (R3).
;;;
;;; range.tur encodes a range endpoint's kind as a sentinel int -- the
;;; `inclusive : int` argument to range-bound-new (1 = inclusive, 0 =
;;; exclusive) plus the null pointer (0) standing for "unbounded". That is a
;;; classic stringly-typed sum. This module replaces it with a real algebraic
;;; type, `Bound`:
;;;
;;;   Inclusive v  -- the endpoint v is part of the interval
;;;   Exclusive v  -- the endpoint v is the open boundary
;;;   Unbounded    -- no endpoint on this side
;;;
;;; As of range-gadt-typeclass-migration-plan B1 `Bound` IS range.tur's
;;; internal endpoint representation (defined in range.tur, re-exported here),
;;; so this module is now a thin convenience layer. The historical
;;; compatibility shims (bound->range-bound and range-bound->bound) survive one
;;; release as near-identity functions for source compatibility; new code can
;;; use the constructors and predicates directly.
;;;
;;; Bound is declared `:copy`, so its endpoints are plain value types that can
;;; be read repeatedly (a shared range bound is destructured by many
;;; predicates); see docs/archive/history/defgadt-copy-and-shared-bounds.md.
;;; It was a `defgadt` whose every constructor returned `(Bound int)`; it is
;;; an ordinary `defdata` with no type parameter now, and goes by value
;;; (adt-gadt-unification-plan slice 3).
;;;
;;; Since: stdlib-refinement-collections-plan (R3)
(load "stdlib/range.tur")
;; str-concat + int->str back the pure-Turmeric range-fmt / bound-fmt formatters
;; below (interp-string-natives-and-range-show-plan Phase 1), replacing the old
;; inline-C snprintf bodies so `range->str` / `bound->str` run under --interpret.
;; str-build.tur is a dependency-free leaf (no Eq/Show instances), so this does
;; not perturb Eq [Bound] resolution the way loading all of str.tur would.

(load "stdlib/str-build.tur")
;;; bound-inclusive -- construct an inclusive endpoint at v.
;;;
;;; Parameters:
;;;   v -- the endpoint value (part of the interval)
;;;
;;; Returns:
;;;   A Bound tagged Inclusive.
;;;
;;; Example:
;;;   (range-contains? (bound-range (bound-inclusive 1) (bound-unbounded)) 1)  ; => true
;;;
;;; Since: R3

(defn bound-inclusive [v : int] : Bound (Inclusive v))
;;; bound-exclusive -- construct an exclusive endpoint at v.
;;;
;;; Parameters:
;;;   v -- the open boundary value (not part of the interval)
;;;
;;; Returns:
;;;   A Bound tagged Exclusive.
;;;
;;; Example:
;;;   (range-contains? (bound-range (bound-inclusive 1) (bound-exclusive 5)) 5)  ; => false
;;;
;;; Since: R3

(defn bound-exclusive [v : int] : Bound (Exclusive v))
;;; bound-unbounded -- construct an unbounded (open-ended) endpoint.
;;;
;;; Returns:
;;;   A Bound tagged Unbounded.
;;;
;;; Example:
;;;   (range-contains? (bound-range (bound-unbounded) (bound-unbounded)) 999)  ; => true
;;;
;;; Since: R3

(defn bound-unbounded [] : Bound (Unbounded))
;;; bound->range-bound -- deprecated compatibility shim (now near-identity).
;;;
;;; Before range-gadt-typeclass-migration-plan B1 this lowered a Bound to
;;; range.tur's pointer representation. Now that range.tur's internal endpoint
;;; representation IS Bound, it is the identity. Retained one release
;;; for source compatibility; prefer passing the Bound directly to range-new.
;;;
;;; Parameters:
;;;   b -- the Bound
;;;
;;; Returns:
;;;   The same Bound, accepted by range-new and every range.tur predicate.
;;;
;;; Example:
;;;   (range-bound-inclusive? (bound->range-bound (bound-inclusive 3)))  ; => true
;;;
;;; Since: R3

(defn bound->range-bound [b : Bound] : Bound b)
;;; range-bound->bound -- deprecated compatibility shim (now near-identity).
;;;
;;; Before range-gadt-typeclass-migration-plan B1 this lifted range.tur's
;;; pointer representation into Bound. Now that range.tur's endpoints
;;; ARE Bound values, it is the identity. Retained one release for source
;;; compatibility; prefer using range-lower / range-upper directly.
;;;
;;; Parameters:
;;;   b -- a Bound
;;;
;;; Returns:
;;;   The same Bound.
;;;
;;; Example:
;;;   (bound-value (range-bound->bound (range-lower (closed-range 2 8))))  ; => 2
;;;
;;; Since: R3

(defn range-bound->bound [b : Bound] : Bound b)
;;; bound-value -- extract the endpoint value from a bounded endpoint.
;;;
;;; Parameters:
;;;   b -- a Bound; Unbounded yields 0
;;;
;;; Returns:
;;;   The endpoint value for Inclusive / Exclusive, or 0 for Unbounded.
;;;
;;; Example:
;;;   (bound-value (bound-exclusive 7))  ; => 7
;;;
;;; Since: R3

(defn bound-value [b : Bound] : int
  (match b (Inclusive v) v (Exclusive v) v (Unbounded) 0))
;;; bound-inclusive? -- true when an endpoint is inclusive.
;;;
;;; Parameters:
;;;   b -- a Bound
;;;
;;; Returns:
;;;   true for Inclusive, false for Exclusive or Unbounded.
;;;
;;; Example:
;;;   (bound-inclusive? (bound-inclusive 1))  ; => true
;;;
;;; Since: R3

(defn bound-inclusive? [b : Bound] : bool
  (match b (Inclusive _) true (Exclusive _) false (Unbounded) false))
;; bound-unbounded? is provided by range.tur (it is range.tur's internal
;; Unbounded test as of range-gadt-typeclass-migration-plan B1); no redefinition
;; here.
;;; bound-range -- build a Range from two Bound endpoints.
;;;
;;; The Bound-typed analogue of range.tur's positional constructors
;;; (closed-range, open-range, ...): pick any Inclusive / Exclusive /
;;; Unbounded combination for each side.
;;;
;;; Parameters:
;;;   lo -- the lower Bound
;;;   hi -- the upper Bound
;;;
;;; Returns:
;;;   A Range, usable with every range.tur predicate.
;;;
;;; Example:
;;;   (range-contains? (bound-range (bound-inclusive 1) (bound-exclusive 5)) 4)  ; => true
;;;
;;; Since: R3

(defn bound-range [lo : Bound hi : Bound] : Range
  (range-new (bound->range-bound lo) (bound->range-bound hi)))
;;; range-lower-bound -- the lower endpoint of a Range as a Bound.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Returns:
;;;   The lower endpoint as a Bound.
;;;
;;; Example:
;;;   (bound-inclusive? (range-lower-bound (closed-range 1 5)))  ; => true
;;;
;;; Since: R3

(defn range-lower-bound [r : Range] : Bound
  (range-bound->bound (range-lower r)))
;;; range-upper-bound -- the upper endpoint of a Range as a Bound.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Returns:
;;;   The upper endpoint as a Bound.
;;;
;;; Example:
;;;   (bound-unbounded? (range-upper-bound (at-least-range 3)))  ; => true
;;;
;;; Since: R3

(defn range-upper-bound [r : Range] : Bound
  (range-bound->bound (range-upper r)))
;; -------------------------------------------------------------------
;; Rendering (range-gadt-typeclass-migration-plan B2)
;; -------------------------------------------------------------------
;; `Show [Bound]` and `Ord [Bound]` now live in range.tur alongside `Eq [Bound]`
;; (the orphan rule puts them in Bound's own module). The earlier blocker -- the
;; non-idempotent `load` of stdlib/typeclass.tur colliding with the auto-loaded
;; partial typeclass stubs -- is fixed (definstance is now idempotent; see
;; docs/archive/history/load-not-idempotent-typeclass.md), so range.tur loads
;; typeclass.tur to bring Show/Ord into scope. `(show b)` renders a lone
;; endpoint exactly like `bound->str` below.
;;
;; The full-interval `range->str` / `range-fmt` helpers below are
;; self-contained functions.  (`Range` is a nominal record now, so a `Show
;; [Range]` instance is expressible; none is declared yet.)
;; range-fmt -- inline-C formatter for a range's decomposed endpoints.
;; kind: 0 = unbounded, 1 = inclusive, 2 = exclusive.

(defn range-fmt [lo-kind : int lo-val : int hi-kind : int hi-val : int] : cstr
  (let [lo (cond (= lo-kind 0) "(-inf"
                 (= lo-kind 1) (str-concat "[" (int->str lo-val))
                 :else         (str-concat "(" (int->str lo-val)))
        hi (cond (= hi-kind 0) "+inf)"
                 (= hi-kind 1) (str-concat (int->str hi-val) "]")
                 :else         (str-concat (int->str hi-val) ")"))]
    (str-concat lo (str-concat ", " hi))))
;; bound-kind -- 0 for Unbounded, 1 for Inclusive, 2 for Exclusive.

(defn bound-kind [b : Bound] : int
  (match b (Inclusive _) 1 (Exclusive _) 2 (Unbounded) 0))
;;; range->str -- render a Range in interval notation.
;;;
;;; Renders the endpoints with bracket/paren according to inclusivity, e.g.
;;; "[1, 5)" for a closed-open range or "(-inf, 5]" for an at-most range.
;;;
;;; Parameters:
;;;   r -- a Range
;;;
;;; Returns:
;;;   A freshly allocated :cstr interval string.
;;;
;;; Example:
;;;   (range->str (closed-open-range 1 5))  ; => "[1, 5)"
;;;   (range->str (at-most-range 5))        ; => "(-inf, 5]"
;;;
;;; Since: range-gadt-typeclass-migration-plan B2

(defn range->str [r : Range] : cstr
  (let [lo (range-lower r)
        hi (range-upper r)]
    (range-fmt (bound-kind lo)
      (range-bound-value lo)
      (bound-kind hi)
      (range-bound-value hi))))
;;; bound->str -- render a single Bound endpoint.
;;;
;;; Renders "[v" for Inclusive, "(v" for Exclusive, or "unbounded".  A lone
;;; endpoint has no side, so the inclusive/exclusive bracket is the lower-side
;;; form; use range->str for a full interval.
;;;
;;; Parameters:
;;;   b -- a Bound
;;;
;;; Returns:
;;;   A freshly allocated :cstr.
;;;
;;; Example:
;;;   (bound->str (bound-inclusive 3))  ; => "[3"
;;;   (bound->str (bound-unbounded))    ; => "unbounded"
;;;
;;; Since: range-gadt-typeclass-migration-plan B2

(defn bound->str [b : Bound] : cstr
  (match b
    (Inclusive v)
    (bound-fmt 1 v)
    (Exclusive v)
    (bound-fmt 2 v)
    (Unbounded)
    "unbounded"))
;; bound-fmt -- inline-C formatter for a single inclusive/exclusive endpoint.

(defn bound-fmt [kind : int v : int] : cstr
  (if (= kind 1) (str-concat "[" (int->str v)) (str-concat "(" (int->str v))))
