;;; tur/session -- standard session-type protocol patterns for typed channels.
;;;
;;; Reusable protocol templates built on the core session primitives.
;;;
;;; Since: Phase B1
;; stdlib/session.tur -- Standard session-type protocol patterns.
;;
;; Provides reusable protocol templates built on the core session primitives
;; (make-session, send, recv, choose-left, choose-right, offer, close).
;;
;; Three patterns are provided:
;;   echo    -- recursive echo server / client helpers
;;   rpc     -- generic single-shot request/response
;;   pubsub  -- publish-subscribe subscriber loop
;;
;; Since: SS4
;; ---------------------------------------------------------------------------
;; peer spawn -- one way to run the other end of a session on both backends
;;
;; A session op blocks until its peer arrives.  Compiled, the runtime blocks
;; an OS thread on a condvar, and compiled `async` runs its fiber on the very
;; thread that would have to run the peer -- so `(async (fn [] (recv ch)))`
;; deadlocks the binary (compiled-async-fiber-deadlocks-on-a-session-op).
;; Under `tur --interpret` the rendezvous is cooperative, so `async` is fine.
;;
;; session-spawn / session-join hide that split: compiled, they are a pthread
;; over the emitted tur_session_thread_wrapper; under the interpreter the
;; same names are native overrides that spawn a scheduler fiber and await
;; it.  One source runs on both paths, and no program has to hand-roll a
;; `(defn spawn [f : ptr<void>] : ptr<void>)` over pthread_create.
;; ---------------------------------------------------------------------------
;;; SessionPeer -- handle to a running session peer (see session-spawn).
;;;
;;; Compiled: a heap pthread_t.  Interpreted: the peer fiber's future.
;;; Consumed exactly once, by session-join.
;;;
;;; Since: turi-session-expansion S2
(defopaque SessionPeer :ptr<void>)
;;; session-spawn -- run `f` as the peer of a session, on a thread or a fiber.
;;;
;;; Parameters:
;;;   f -- a zero-argument thunk that drives one endpoint to `close`
;;;
;;; Returns:
;;;   A SessionPeer to hand to session-join once this side has finished its
;;;   own half of the protocol.
;;;
;;; Example:
;;;   (let [[s r] (make-session (Send int Close))]
;;;     (let [t (session-spawn (fn [] (let [[n r] (recv r)] (println n) (close r))))]
;;;       (let [s (send s 42)] (close s) (session-join t))))   ; => prints 42
;;;
;;; Since: turi-session-expansion S2
(defn session-spawn [^fat f : (fn [] nil)] : SessionPeer
  ```c
  pthread_t *tid = (pthread_t *)malloc(sizeof(pthread_t));
  if (!tid) { fprintf(stderr, "session-spawn: out of memory\n"); abort(); }
  int rc = pthread_create(tid, NULL, tur_session_thread_wrapper, (void *)(intptr_t)f);
  if (rc != 0) {
      free(tid);
      fprintf(stderr, "session-spawn: pthread_create failed (%d)\n", rc);
      abort();
  }
  return (void *)tid;
  ```)
;;; session-join -- wait for a session peer started by session-spawn.
;;;
;;; Parameters:
;;;   t -- the SessionPeer returned by session-spawn; consumed by this call
;;;
;;; Returns:
;;;   nil, once the peer thunk has returned.
;;;
;;; Example:
;;;   (session-join t)
;;;
;;; Since: turi-session-expansion S2
(defn session-join [t : SessionPeer] : nil
  ```c
  pthread_join(*(pthread_t *)t, NULL);
  free(t);
  ```)
;; ---------------------------------------------------------------------------
;; echo -- trivial echo protocol
;;
;; EchoServerProto = Rec self (Branch (Recv int (Send int self)) Close)
;; EchoClientProto = Rec self (Choose (Send int (Recv int self)) Close)
;;
;; The server repeatedly offers: if Left arrives it recvs an int, sends it
;; back, and recurses; if Right arrives it closes the channel.
;; The client uses choose-left to send one int and recv the echo, or
;; choose-right to end the conversation.
;; ---------------------------------------------------------------------------
;;; echo-server-loop -- serve the echo protocol until the client closes.
;;;
;;; Parameters:
;;;   ch -- server-side channel with protocol
;;;         Session[Rec self (Branch (Recv int (Send int self)) Close)]
;;;
;;; Returns:
;;;   nil -- the function returns after the client sends Close
;;;
;;; Example:
;;;   (session-spawn (fn [] (echo-server-loop server-end)))
;;;
;;; Since: SS4
(defn echo-server-loop [^linear ch : (Session (Rec self
                                                (Branch (Recv int
                                                          (Send int self))
                                                  Close)))] : nil
  (match (offer ch)
    (Left ch)
    (let [[n ch] (recv ch)
          ch     (send ch n)]
      (echo-server-loop ch))
    (Right ch)
    (close ch)))
;;; echo-client-call -- send one integer, hand the echo to `handler`, return the channel.
;;;
;;; Parameters:
;;;   ch      -- client-side channel with protocol
;;;              Session[Rec self (Choose (Send int (Recv int self)) Close)]
;;;   val     -- integer to send and have echoed back
;;;   handler -- called with the echoed integer
;;;
;;; Returns:
;;;   The channel, back at the recursive EchoClientProto so more calls can be
;;;   made -- or `(close (choose-right ch))` to end the conversation.
;;;
;;; Example:
;;;   (let [ch (echo-client-call ch 42 (fn [r] (println r)))]   ; prints 42
;;;     (close (choose-right ch)))
;;;
;;; Since: SS4
;; The echoed value reaches the caller through `handler` rather than as a
;; returned pair: `(recv ch)` yields the internal session recv-pair
;; (TY_SESSION_RECV_PAIR), which has no surface type spelling and which the C
;; emitter cannot return from a function -- the previous inferred-pair shape
;; emitted `/*recv-pair*/;` and failed to compile any program that loaded
;; this module (KB-029, docs/archive/history/known-bugs-followups-plan.md).
;; A handler plus the threaded channel is the same shape pubsub-recv-loop
;; uses and composes with choose-right afterwards.
(defn echo-client-call [^linear ch : (Session (Rec self
                                                (Choose (Send int
                                                          (Recv int self))
                                                  Close)))
                        val : int
                        handler : (-> int nil)] : (Session (Rec self
                                                             (Choose (Send int
                                                                       (Recv int
                                                                         self))
                                                               Close)))
  (let [ch     (choose-left ch)
        ch     (send ch val)
        [r ch] (recv ch)]
    (handler r)
    ch))
;; ---------------------------------------------------------------------------
;; rpc -- generic single-shot request/response
;;
;; RPC protocol (client view): Send req (Recv resp Close)
;; The client sends a request, receives a response, and closes.
;; ---------------------------------------------------------------------------
;;; rpc-call -- perform a single RPC: send request, receive response, close.
;;;
;;; Parameters:
;;;   ch  -- client channel with protocol Session[Send int (Recv int Close)]
;;;   req -- integer request value to send to the server
;;;
;;; Returns:
;;;   The integer response received from the server.  The channel is fully
;;;   consumed (closed) by this call.
;;;
;;; Example:
;;;   (let [resp (rpc-call ch 21)]
;;;     (println resp))   ; => 42 (if server doubles the value)
;;;
;;; Since: SS4


(defn rpc-call [^linear ch : (Session (Send int (Recv int Close))) req : int] : int
  (let [ch        (send ch req)
        [resp ch] (recv ch)]
    (close ch)
    resp))
;; ---------------------------------------------------------------------------
;; pubsub -- publish-subscribe protocol template
;;
;; Subscriber protocol: Recv msg (Rec self (Branch (Recv msg self) Close))
;;
;; The subscriber receives an initial message then enters a loop: offer the
;; channel; if Left (another message is coming) recv and recurse; if Right
;; the topic has closed, close the channel and stop.
;; ---------------------------------------------------------------------------
;;; pubsub-recv-loop -- receive messages from a topic until it closes.
;;;
;;; Parameters:
;;;   ch      -- subscriber channel with protocol
;;;              Session[Recv int (Rec self (Branch (Recv int self) Close))]
;;;   handler -- function called with each received integer message
;;;
;;; Returns:
;;;   nil -- returns after the topic sends the Close branch
;;;
;;; Example:
;;;   (pubsub-recv-loop sub-ch (fn [msg] (println msg)))
;;;
;;; Since: SS4


(defn pubsub-recv-loop [^linear ch : (Session (Recv int
                                                (Rec self
                                                  (Branch (Recv int self) Close))))
                        handler : (-> int nil)] : nil
  (let [[msg ch] (recv ch)] (handler msg) (pubsub-recv-loop-inner ch handler)))
;;; pubsub-recv-loop-inner -- inner recursive loop after initial recv.

(defn pubsub-recv-loop-inner [^linear ch : (Session (Rec self
                                                      (Branch (Recv int self)
                                                        Close)))
                              handler : (-> int nil)] : nil
  (match (offer ch)
    (Left ch)
    (let [[msg ch] (recv ch)] (handler msg) (pubsub-recv-loop-inner ch handler))
    (Right ch)
    (close ch)))
;; ---------------------------------------------------------------------------
;; Multi-party session patterns (SS8)
;;
;; Multi-party sessions require -Xsessions and a protocol declared with
;; (defprotocol Name [Role1 Role2 ...] interactions...).
;;
;; Key operations:
;;   (make-protocol P)       -- allocate one Role endpoint per declared role;
;;                              destructure with (let [[r1 r2] (make-protocol P)])
;;   (send-to ch R val)      -- send val to role R on channel ch; returns advanced ch
;;   (recv-from ch R)        -- receive from role R; destructure with [v ch]
;;   (close ch)              -- close the role endpoint (must be at end of protocol)
;;
;; Example -- two-role ping:
;;
;;   (defprotocol Ping [A B]
;;     (-> A B int)
;;     (-> B A int))
;;
;;   (defn role-a [^linear ch :(Role Ping A)] :nil
;;     (let [ch (send-to ch B 42)]
;;       (let [[v ch] (recv-from ch B)]
;;         (println v)
;;         (close ch))))
;;
;;   (defn main [] :int
;;     (let [[ra rb] (make-protocol Ping)]
;;       (let [t (spawn (fn [] (role-b rb)))]
;;         (role-a ra)
;;         (join t)))
;;     0)
;;
;; Three-role example (requires N>=3 protocol):
;;
;;   (defprotocol Pipeline [A B C]
;;     (-> A B int)
;;     (-> B C int))
;;
;;   (let [[ra rb rc] (make-protocol Pipeline)] ...)
;; ---------------------------------------------------------------------------
