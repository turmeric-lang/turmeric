;;; tur/ref -- heap-allocated mutable reference cell with independent ownership.
;;;
;;; ref-new allocates; ref-get reads; ref-set writes; ref-free releases.
;;;
;;; Since: Phase B1
;; Ref (Reference) type for Turmeric
;; Heap-allocated container with independent ownership
;; Phase B1: Clone trait infrastructure
;;; Ref -- heap-allocated single-value container with independent ownership.
;;;
;;; Since: Phase B1
(defstruct Ref [value : int])
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, tail) ----
;; RefHandle wraps the heap pointer (an :int) handed out by ref-new so the
;; checker rejects passing an arbitrary integer to ref-get / ref-free -- only a
;; handle minted by ref-new is accepted. It lowers to :int in the C ABI, so the
;; inline-C bodies are unchanged. (This is distinct from the Ref struct above
;; and its Clone instance, which deep-copy a by-value Ref; the Clone typeclass
;; fixes clone's return type at :int, so that path keeps the raw int.)
;;
;; stdlib-int-stand-in-audit S2: the handle also carries a PHANTOM element type
;; A, so the cell's payload is typed at the signature while the storage stays
;; int64-carried -- the `Vec` shape (`(defstruct ^heap Vec [A] ...)` with
;; `val :A` over an int64 buffer), and the same shape `(defopaque List [A] :int)`
;; already uses. The payload was `:int`, so a `float` could not be stored at all
;; and a by-value aggregate type-checked and then failed in cc.

(defopaque RefHandle [A] :int)
;; Create a new Ref from a value (takes ownership of the pointer)
;; The caller is responsible for ensuring the value is heap-allocated
;; if it needs to outlive the Ref.
;;; ref-new -- allocate a new Ref cell on the heap containing value.
;;;
;;; Parameters:
;;;   value -- the value to store inside the Ref; its type pins A
;;;
;;; Returns:
;;;   A (RefHandle A) -- an opaque :int pointer cast -- to the new Ref cell.
;;;
;;; Ownership:
;;;   A single-word A (int / float / cstr / opaque / :heap pointer) is stored
;;;   directly. A MULTI-WORD by-value A rides its slot as a heap box pointer
;;;   the cell then owns; ref-free is shallow and does not free it, so read it
;;;   back with ref-get before freeing the cell if you need to keep it.
;;;
;;; Example:
;;;   (def r (ref-new 42))    ; => (RefHandle int)
;;;   (def f (ref-new 7.25))  ; => (RefHandle float)
;;;
;;; Since: Phase B1

(defn ref-new [A] [value : A] : (RefHandle A)
  ```c
  struct { int64_t value; } *ref = malloc(sizeof(struct { int64_t value; }));
  /* region-lock-hardening: the cell is malloc'd and outlives any region
     bracket this call runs inside, so a region-allocated payload is an escape
     the result walk cannot see. Note it, exactly as vec-push! does. */
  TUR_REGION_NOTE(value);
  ref->value = (int64_t)value;
  return (int64_t)(intptr_t)ref;
  ```)
;; Get the contained value from a Ref
;;; ref-get -- read the value stored in a Ref cell.
;;;
;;; Parameters:
;;;   r -- (RefHandle A) returned by ref-new
;;;
;;; Returns:
;;;   The stored value, at type A.
;;;
;;;   Declaring `: A` here is safe for the same reason it is on vec-get: an
;;;   inline-C body is NOT return-specialized, so the emitted base still hands
;;;   back the raw int64 word and only the checker learns A. (A body that WERE
;;;   return-specialized would mint a `double` base for A=float whose carrier
;;;   read numerically converts the bits instead of reinterpreting them -- that
;;;   is what vec.tur's header warns about, and it is a warning about
;;;   specialized bodies, not about the declaration.)
;;;
;;; Example:
;;;   (ref-get (ref-new 99))    ; => 99
;;;   (ref-get (ref-new 7.25))  ; => 7.25, no ascription needed
;;;
;;; Since: Phase B1

(defn ref-get [A] [r : (RefHandle A)] : A
  ```c
  struct { int64_t value; } *ref = (void *)(intptr_t)r;
  if (!ref) {
    fprintf(stderr, "ref-get: null ref\n");
    exit(1);
  }
  return ref->value;
  ```)
;; Free a Ref (does NOT free the contained value - shallow free)
;;; ref-free -- free the Ref cell (shallow; does not free the contained value).
;;;
;;; Parameters:
;;;   r -- (RefHandle A) returned by ref-new
;;;
;;; Since: Phase B1

(defn ref-free [A] [r : (RefHandle A)] : void
  ```c
  free((void*)(intptr_t)r);
  ```)
;; Phase B1: Clone instance for Ref
;; Requires the Clone typeclass to already be in scope (from stdlib/typeclass.tur).
;; Deep clone: allocates a new Ref struct on the heap with a copy of the contained
;; int64_t value (independent ownership).
;; x has type Ref (struct value) inside the generated C method.
;;; Clone [Ref] -- deep-clone a Ref struct: allocates a new Ref with an independent copy of the value.
;;;
;;; Since: Phase B1

(definstance Clone [Ref]
  (clone [x]
    : int
    ```c
    struct { int64_t value; } *dst = malloc(sizeof(Ref));
    dst->value = x.value;
    return (int64_t)(intptr_t)dst;
    ```))
