;;; tur/future -- Future<T> and Promise<T> for asynchronous results.
;;;
;;; A Promise is written once by the producer; the Future is read by the consumer.
;;;
;;; Since: Phase T20-C
;; stdlib/future.tur -- Future<T> and Promise<T> (Phase T20-C)
;;
;; Promise/Future pair for asynchronous computation results.
;;
;; A Promise is the producer end: it can fulfill (set value) or fail (set exception).
;; A Future is the consumer end: it can query completion or block waiting for a result.
;;
;; Both share a common heap-allocated cell containing:
;;   - mutex + condvar for synchronization
;;   - optional value (int64_t)
;;   - optional exception/error code (int64_t)
;;   - bool indicating whether the result is set
;;
;; Shared cell layout (FutureCell):
;;   pthread_mutex_t   lock
;;   pthread_cond_t    ready
;;   int64_t            value
;;   int64_t            exn
;;   bool              is_set    (true = value/exn is valid)
;;   bool              is_ok     (true = ok/fulfilled, false = err/failed)
;;
;; API:
;;   promise-new            []                         -> Promise  (write end; call promise-pair / future-of-cell for the Future)
;;   promise-pair           [cell :Promise]           -> (Promise Future)
;;   promise-fulfill        [p :Promise v :int]       -> nil       (sets value, wakes waiters)
;;   promise-fail           [p :Promise e :int]       -> nil       (sets exn, wakes waiters)
;;   promise-free           [p :Promise]              -> nil
;;
;;   future-get             [f :Future]               -> ptr<void>  (blocks; returns Result<T>)
;;   future-done?           [f :Future]               -> bool      (non-blocking check)
;;   future-free            [f :Future]               -> nil
;; ---- Opaque handle newtypes (stdlib-opaque-handle-types-plan, Tier 1) ----
;; Promise is the write end (producer); Future is the read end (consumer). Both
;; are views over the same shared FutureCell, but are nominally distinct so the
;; checker rejects passing a Future where a Promise is expected (and vice versa)
;; -- e.g. calling promise-fulfill on a read-end Future. Both lower to the
;; underlying :ptr<void> in the C ABI, so the inline-C bodies are unchanged.
;; A freshly allocated cell is handed out as a Promise (the producer fulfills
;; it); derive the consumer's Future view with future-of-cell / promise-pair.
;;
;; ---- Linearity (stdlib-linearity-affinity-plan, L1 + the aliasing fix) ----
;; Promise is :linear and Future is :affine. The shared FutureCell now carries a
;; reference count (see the `refcount` field below), which untangles the
;; Promise/Future aliasing that previously blocked promoting the read end (see
;; docs/archive/history/stdlib-future-linearity-aliasing.md, RESOLVED):
;;
;;   * promise-new mints a cell with refcount = 1, handed out as a Promise.
;;   * future-handle BORROWS a Promise (^borrow) and mints an additional Future
;;     over the same cell, bumping refcount to 2. This is the both-ends split:
;;     the producer keeps the Promise, the consumer gets the Future.
;;   * promise-fulfill / promise-fail consume the Promise (so settling twice is a
;;     TUR-E0101) and drop its reference; future-free / promise-free /
;;     future-cell-free consume their handle and drop its reference. Whichever
;;     drop takes the count to 0 tears the cell down -- so the two aliases can no
;;     longer double-free it, and a forgotten Promise is a TUR-E0100.
;;   * future-of-cell is the ownership *transfer* (consume a Promise, hand back a
;;     Future over the same cell, refcount unchanged) for the read-only case.
;;
;; Future is :affine rather than :linear: an uncollected future may be dropped
;; (no TUR-E0100), matching its "fire and forget / optional cancel" role, but it
;; still cannot be used after future-free (TUR-E0101). The read accessors
;; future-get / future-done? / future-cancelled? / future-cancel are ^borrow, so
;; a future can be polled and cancelled freely; only future-free consumes. The
;; refcount decrement uses the __atomic builtins, so a Promise fulfilled on one
;; thread and a Future freed on another tear the cell down race-free.
(defopaque Promise :ptr<void> :linear)

(defopaque Future :ptr<void> :affine)
;; ---- Shared FutureCell type and helpers ----
;; Allocate a new FutureCell (shared by Promise and Future)
;;; future-cell-new -- allocate and initialise a shared FutureCell (mutex, condvar, unset).
;;;
;;; Returns:
;;;   A Promise (write-end view of the new FutureCell); free with future-cell-free.
;;;
;;; Since: Phase T20-C

(defn future-cell-new [] : Promise
  ```c
  typedef struct {
      pthread_mutex_t lock;
      pthread_cond_t  ready;
      int64_t value;
      int64_t exn;
      bool is_set;
      bool is_ok; int64_t refcount;
  } FutureCell;
  FutureCell *cell = (FutureCell *)malloc(sizeof(FutureCell));
  if (!cell) { fprintf(stderr, "future-cell-new: out of memory\n"); abort(); }
  pthread_mutex_init(&cell->lock, NULL);
  pthread_cond_init(&cell->ready, NULL);
  cell->refcount = 1;
  cell->is_set = false;
  cell->is_ok = false;
  cell->value = 0;
  cell->exn = 0;
  return (void *)(intptr_t)cell;
  ```)
;; Free a FutureCell
;;; future-cell-free -- destroy the mutex/condvar and free a FutureCell.
;;;
;;; Parameters:
;;;   cell -- FutureCell pointer from future-cell-new
;;;
;;; Since: Phase T20-C

(defn future-cell-free [cell : Promise] : nil
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)cell;
  if (__atomic_sub_fetch(&fc->refcount, 1, __ATOMIC_ACQ_REL) == 0) {
    pthread_mutex_destroy(&fc->lock);
    pthread_cond_destroy(&fc->ready);
    free(fc);
  }
  ```)
;; ---- Promise API ----
;; Create a new Promise+Future pair.
;; Returns a FutureCell* that can be used as both Promise and Future.
;; Use promise-pair to get separate Promise and Future handles,
;; or just use the same cell pointer for both (they're the same underlying object).
;;; promise-new -- allocate a new unsettled Promise/Future shared cell.
;;;
;;; Returns:
;;;   A Promise (write end); derive the read-end Future with future-of-cell.
;;;
;;; Example:
;;;   (def p (promise-new))
;;;   (promise-fulfill p 42)
;;;
;;; Since: Phase T20-C


(defn promise-new [] : Promise (future-cell-new))
;; Given a cell, return the Promise handle (same pointer as cell).
;; This is a convenience for API symmetry.
;;; promise-of-cell -- return the Promise handle for a FutureCell (identity; for API symmetry).
;;;
;;; Parameters:
;;;   cell -- FutureCell pointer from promise-new
;;;
;;; Since: Phase T20-C

(defn promise-of-cell [cell : Promise] : Promise cell)
;; Given a cell, return the Future handle (same pointer as cell).
;;; future-of-cell -- return the Future handle for a FutureCell (identity; for API symmetry).
;;;
;;; Parameters:
;;;   cell -- FutureCell pointer from promise-new
;;;
;;; Since: Phase T20-C

(defn future-of-cell [cell : Promise] : Future
  (:: (:: cell :ptr<void>) :Future))
;; Mint an additional Future over a Promise's cell, keeping the Promise.
;;; future-handle -- borrow a Promise and derive a Future over the same cell.
;;;
;;; Unlike future-of-cell (which *transfers* ownership, consuming the Promise),
;;; future-handle borrows the Promise (^borrow) and bumps the shared cell's
;;; reference count, so the producer keeps the Promise to settle while the
;;; consumer holds the returned Future to read and free. The cell is torn down
;;; only when both references are dropped (by promise-fulfill/-fail/-free on the
;;; Promise side and future-free on the Future side).
;;;
;;; Parameters:
;;;   p -- Promise from promise-new (borrowed, not consumed)
;;;
;;; Returns:
;;;   A Future over the same cell; free exactly once with future-free.
;;;
;;; Example:
;;;   (let [p (promise-new)]
;;;     (let [f (future-handle p)]
;;;       (promise-fulfill p 42)      ; consumes p, settles
;;;       (future-get f)              ; read via f
;;;       (future-free f)))           ; consumes f, frees the cell
;;;
;;; Since: stdlib-linearity-affinity (Future aliasing fix)

(defn future-handle [^borrow p : Promise] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)p;
  __atomic_add_fetch(&fc->refcount, 1, __ATOMIC_ACQ_REL);
  return (void *)(intptr_t)fc;
  ```)
;; Return a (Promise Future) pair from a cell.
;; Both elements are the same pointer but conceptually distinct types.
;;; promise-pair -- expand to a (Promise Future) pair list from a single shared cell.
;;;
;;; Parameters:
;;;   cell -- FutureCell pointer from promise-new
;;;
;;; Since: Phase T20-C

(defmacro promise-pair [cell]
  (list (promise-of-cell cell) (future-of-cell cell)))
;; Fulfill a promise with a value.
;; Wakes all threads waiting on the associated future.
;;; promise-fulfill -- settle a promise with a successful value; wakes all future waiters.
;;;
;;; Parameters:
;;;   p -- Promise (FutureCell) pointer
;;;   v -- fulfillment value
;;;
;;; Since: Phase T20-C

(defn promise-fulfill [p : Promise v : int] : nil
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)p;
  pthread_mutex_lock(&fc->lock);
  if (fc->is_set) {
      pthread_mutex_unlock(&fc->lock);
      fprintf(stderr, "promise-fulfill: promise already settled\n");
      abort();
  }
  /* region-lock-hardening (stdlib-int-stand-in-audit follow-up): the
     FutureCell is malloc'd and outlives any region bracket this call runs
     inside, so a region-allocated payload word is an escape the result walk
     cannot see -- the walk sees an opaque Promise/Future handle, never the
     node inside the cell.  The parameter arrives ERASED (`:int`), so the
     emitter's body-entry note for a typed node param does not fire and the
     note has to be written here.  Same shape as chan-send in stdlib/chan.tur.
     */
  TUR_REGION_NOTE(v);
  fc->value = (int64_t)v;
  fc->is_set = true;
  fc->is_ok = true;
  pthread_cond_broadcast(&fc->ready);
  pthread_mutex_unlock(&fc->lock);
  /* consume the Promise's reference; tear down if it was the last */
  if (__atomic_sub_fetch(&fc->refcount, 1, __ATOMIC_ACQ_REL) == 0) {
    pthread_mutex_destroy(&fc->lock);
    pthread_cond_destroy(&fc->ready);
    free(fc);
  }
  ```)
;; Fail a promise with an exception/error code.
;; Wakes all threads waiting on the associated future.
;;; promise-fail -- settle a promise with an error code; wakes all future waiters.
;;;
;;; Parameters:
;;;   p -- Promise (FutureCell) pointer
;;;   e -- error/exception code
;;;
;;; Since: Phase T20-C

(defn promise-fail [p : Promise e : int] : nil
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)p;
  pthread_mutex_lock(&fc->lock);
  if (fc->is_set) {
      pthread_mutex_unlock(&fc->lock);
      fprintf(stderr, "promise-fail: promise already settled\n");
      abort();
  }
  /* region-lock-hardening (stdlib-int-stand-in-audit follow-up): the
     FutureCell is malloc'd and outlives any region bracket this call runs
     inside, so a region-allocated payload word is an escape the result walk
     cannot see -- the walk sees an opaque Promise/Future handle, never the
     node inside the cell.  The parameter arrives ERASED (`:int`), so the
     emitter's body-entry note for a typed node param does not fire and the
     note has to be written here.  Same shape as chan-send in stdlib/chan.tur.
     */
  TUR_REGION_NOTE(e);
  fc->exn = (int64_t)e;
  fc->is_set = true;
  fc->is_ok = false;
  pthread_cond_broadcast(&fc->ready);
  pthread_mutex_unlock(&fc->lock);
  /* consume the Promise's reference; tear down if it was the last */
  if (__atomic_sub_fetch(&fc->refcount, 1, __ATOMIC_ACQ_REL) == 0) {
    pthread_mutex_destroy(&fc->lock);
    pthread_cond_destroy(&fc->ready);
    free(fc);
  }
  ```)
;; Free a promise (and its associated future - they share the same cell).
;;; promise-free -- free a promise and its shared FutureCell.
;;;
;;; Parameters:
;;;   p -- Promise pointer from promise-new
;;;
;;; Since: Phase T20-C

(defn promise-free [p : Promise] : nil (future-cell-free p))
;; ---- Future API ----
;; Check if a future is done (non-blocking).
;;; future-done? -- non-blocking check: return true if the future has been settled.
;;;
;;; Parameters:
;;;   f -- Future (FutureCell) pointer
;;;
;;; Returns:
;;;   true if settled (fulfilled or failed), false otherwise.
;;;
;;; Since: Phase T20-C


(defn future-done? [^borrow f : Future] : bool
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  pthread_mutex_lock(&fc->lock);
  bool done = fc->is_set;
  pthread_mutex_unlock(&fc->lock);
  return done;
  ```)
;; Block until the future is ready, then return a Result<T>.
;; Returns a ptr<void> that is a Result* (use ok?/err?/ok-val/err-val to inspect).
;;; future-get -- block until the future is settled; return a heap-allocated Result struct.
;;;
;;; Parameters:
;;;   f -- Future (FutureCell) pointer
;;;
;;; Returns:
;;;   A :ptr<void> to a Result in the canonical tagged layout (tag 0 = Ok).
;;;
;;; Example:
;;;   (def result (future-get f))
;;;
;;; Since: Phase T20-C

(defn future-get [^borrow f : Future] : ptr<void>
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  pthread_mutex_lock(&fc->lock);
  while (!fc->is_set)
      pthread_cond_wait(&fc->ready, &fc->lock);

  /* Build a Result to return (the canonical tagged layout: tag 0 = Ok). */
  int64_t result = fc->is_ok ? tur_box_ok(fc->value) : tur_box_err(fc->exn);
  pthread_mutex_unlock(&fc->lock);
  return (void *)(intptr_t)result;
  ```)
;; Free a future (and its associated promise - they share the same cell).
;;; future-free -- free a future and its shared FutureCell.
;;;
;;; Parameters:
;;;   f -- Future pointer from promise-new / future-of-cell
;;;
;;; Since: Phase T20-C

(defn future-free [f : Future] : nil
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  if (__atomic_sub_fetch(&fc->refcount, 1, __ATOMIC_ACQ_REL) == 0) {
    pthread_mutex_destroy(&fc->lock);
    pthread_cond_destroy(&fc->ready);
    free(fc);
  }
  ```)
;; ---- AW-002: Pre-settled futures ----
;; Create a pre-fulfilled future with the given value.
;;; future-of -- create a pre-fulfilled future holding value v.
;;;
;;; Parameters:
;;;   v -- value the future should carry
;;;
;;; Returns:
;;;   A Future already settled as ok with value v.
;;;
;;; Example:
;;;   (def f (future-of 42))  ; immediately done
;;;
;;; Since: Phase T20-C


(defn future-of [v : int] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *cell = (FutureCell *)malloc(sizeof(FutureCell));
  if (!cell) { fprintf(stderr, "future-of: oom\n"); abort(); }
  pthread_mutex_init(&cell->lock, NULL);
  pthread_cond_init(&cell->ready, NULL);
  cell->refcount = 1;
  /* region-lock-hardening (stdlib-int-stand-in-audit follow-up): the
     FutureCell is malloc'd and outlives any region bracket this call runs
     inside, so a region-allocated payload word is an escape the result walk
     cannot see -- the walk sees an opaque Promise/Future handle, never the
     node inside the cell.  The parameter arrives ERASED (`:int`), so the
     emitter's body-entry note for a typed node param does not fire and the
     note has to be written here.  Same shape as chan-send in stdlib/chan.tur.
     */
  TUR_REGION_NOTE(v);
  cell->value = (int64_t)v;
  cell->exn = 0;
  cell->is_set = true;
  cell->is_ok = true;
  return (void *)(intptr_t)cell;
  ```)
;; Create a pre-rejected future with the given error code.
;;; future-error-of -- create a pre-rejected future with error code e.
;;;
;;; Parameters:
;;;   e -- error/exception code
;;;
;;; Returns:
;;;   A Future already settled as failed with exn = e.
;;;
;;; Since: Phase T20-C

(defn future-error-of [e : int] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *cell = (FutureCell *)malloc(sizeof(FutureCell));
  if (!cell) { fprintf(stderr, "future-error-of: oom\n"); abort(); }
  pthread_mutex_init(&cell->lock, NULL);
  pthread_cond_init(&cell->ready, NULL);
  cell->refcount = 1;
  cell->value = 0;
  /* region-lock-hardening (stdlib-int-stand-in-audit follow-up): the
     FutureCell is malloc'd and outlives any region bracket this call runs
     inside, so a region-allocated payload word is an escape the result walk
     cannot see -- the walk sees an opaque Promise/Future handle, never the
     node inside the cell.  The parameter arrives ERASED (`:int`), so the
     emitter's body-entry note for a typed node param does not fire and the
     note has to be written here.  Same shape as chan-send in stdlib/chan.tur.
     */
  TUR_REGION_NOTE(e);
  cell->exn = (int64_t)e;
  cell->is_set = true;
  cell->is_ok = false;
  return (void *)(intptr_t)cell;
  ```)
;; Cancel a future: if not yet settled, settle it with error code -2 (cancelled sentinel).
;; If already settled, this is a no-op.
;;; future-cancel -- cancel a future if not yet settled; sets error code -2 (TUR_FUTURE_CANCELLED).
;;;
;;; Parameters:
;;;   f -- Future (FutureCell) pointer
;;;
;;; Since: Phase T20-C

(defn future-cancel [^borrow f : Future] : nil
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  pthread_mutex_lock(&fc->lock);
  if (!fc->is_set) {
      fc->exn = (int64_t)-2; /* TUR_FUTURE_CANCELLED */
      fc->is_set = true;
      fc->is_ok = false;
      pthread_cond_broadcast(&fc->ready);
  }
  pthread_mutex_unlock(&fc->lock);
  ```)
;; Check if a future was cancelled (error code == -2).
;;; future-cancelled? -- return true if the future was cancelled (exn == -2).
;;;
;;; Parameters:
;;;   f -- Future (FutureCell) pointer
;;;
;;; Returns:
;;;   true if the future was settled via future-cancel, false otherwise.
;;;
;;; Since: Phase T20-C

(defn future-cancelled? [^borrow f : Future] : bool
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  pthread_mutex_lock(&fc->lock);
  bool cancelled = fc->is_set && !fc->is_ok && fc->exn == (int64_t)-2;
  pthread_mutex_unlock(&fc->lock);
  return cancelled;
  ```)
;; ---- AW-006: Future combinators ----
;; Map a function over a fulfilled future value.
;; fn is a ptr<void> treated as int64_t(*)(int64_t).
;; If the future is rejected, propagates the error.
;; Returns a new pre-settled future.
;;; future-map -- map fn over a fulfilled future value; propagate rejection unchanged.
;;;
;;; Parameters:
;;;   f  -- source Future pointer
;;;   fn -- a `(fn [int] int)` closure applied to the fulfilled value
;;;
;;; Returns:
;;;   A new pre-settled Future with fn(value) on success, or the original error on failure.
;;;
;;; Since: Phase T20-C


(defn future-map [^borrow f : Future ^fat fn : (fn [int] int)] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  pthread_mutex_lock(&fc->lock);
  while (!fc->is_set) pthread_cond_wait(&fc->ready, &fc->lock);
  bool ok = fc->is_ok;
  int64_t val = fc->value;
  int64_t exn = fc->exn;
  pthread_mutex_unlock(&fc->lock);
  FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
  if (!out) { fprintf(stderr, "future-map: oom\n"); abort(); }
  pthread_mutex_init(&out->lock, NULL);
  pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
  out->is_set = true;
  if (ok) {
      /* fn is a fat closure box: slot 0 = thunk R(*)(void*env, int64_t). */
      out->value = ((int64_t (*)(void *, int64_t))(intptr_t)
                       ((int64_t *)(intptr_t)fn)[0])((void *)(intptr_t)fn, val);
      out->exn   = 0;
      out->is_ok = true;
  } else {
      out->value = 0;
      out->exn   = exn;
      out->is_ok = false;
  }
  return (void *)(intptr_t)out;
  ```)
;; Flat-map: fn receives the fulfilled value and must return a new future (ptr<void>).
;; If the source future is rejected, propagates the error without calling fn.
;;; future-then -- flat-map fn over a future; fn must return a new Future ptr<void>.
;;;
;;; Parameters:
;;;   f  -- source Future pointer
;;;   fn -- a `(fn [int] Future)` closure producing the next Future
;;;
;;; Returns:
;;;   The Future returned by fn, or a pre-rejected Future if f was rejected.
;;;
;;; Since: Phase T20-C

(defn future-then [^borrow f : Future ^fat fn : (fn [int] Future)] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  pthread_mutex_lock(&fc->lock);
  while (!fc->is_set) pthread_cond_wait(&fc->ready, &fc->lock);
  bool ok = fc->is_ok;
  int64_t val = fc->value;
  int64_t exn = fc->exn;
  pthread_mutex_unlock(&fc->lock);
  if (!ok) {
      FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
      if (!out) { fprintf(stderr, "future-then: oom\n"); abort(); }
      pthread_mutex_init(&out->lock, NULL);
      pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
      out->value = 0; out->exn = exn; out->is_set = true; out->is_ok = false;
      return (void *)(intptr_t)out;
  }
  /* Call fn(val) which returns a new FutureCell ptr<void>.
     fn is a fat closure box: slot 0 = thunk R(*)(void*env, int64_t), and R
     is `void *` -- a Future -- so call it at that type: through `int64_t`
     it is an indirect call through the wrong function type (a
     -fsanitize=function trap, a call_indirect trap on WASM). */
  return ((void * (*)(void *, int64_t))(intptr_t)
              ((int64_t *)(intptr_t)fn)[0])((void *)(intptr_t)fn, val);
  ```)
;; ---- AW-007: Multi-combinators ----
;; Race two futures: return a new future that resolves to whichever settles first.
;; The result is a pre-settled future with the winner's value or error.
;;; future-race -- race two futures; return a new future settled by whichever finishes first.
;;;
;;; Parameters:
;;;   fa -- first Future pointer
;;;   fb -- second Future pointer
;;;
;;; Returns:
;;;   A new pre-settled Future carrying the winner's value or error.
;;;
;;; Since: Phase T20-C


(defn future-race [^borrow fa : Future ^borrow fb : Future] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *a = (FutureCell *)fa;
  FutureCell *b = (FutureCell *)fb;
  /* Poll in a spin loop until one settles; lock ordering to avoid deadlock */
  for (;;) {
      pthread_mutex_lock(&a->lock);
      if (a->is_set) {
          bool ok = a->is_ok; int64_t val = a->value; int64_t exn = a->exn;
          pthread_mutex_unlock(&a->lock);
          FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
          if (!out) { fprintf(stderr, "future-race: oom\n"); abort(); }
          pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
          out->is_set = true; out->is_ok = ok; out->value = val; out->exn = exn;
          return (void *)(intptr_t)out;
      }
      pthread_mutex_unlock(&a->lock);
      pthread_mutex_lock(&b->lock);
      if (b->is_set) {
          bool ok = b->is_ok; int64_t val = b->value; int64_t exn = b->exn;
          pthread_mutex_unlock(&b->lock);
          FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
          if (!out) { fprintf(stderr, "future-race: oom\n"); abort(); }
          pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
          out->is_set = true; out->is_ok = ok; out->value = val; out->exn = exn;
          return (void *)(intptr_t)out;
      }
      pthread_mutex_unlock(&b->lock);
      /* Brief yield to avoid 100% CPU spin */
      struct timespec ts = {0, 100000}; nanosleep(&ts, NULL);
  }
  ```)
;; Await both futures; return a new future that:
;;   - is fulfilled with the value of fa if both are ok (value from fa)
;;   - is rejected with the first encountered error
;; Returns a pre-settled future.
;;; future-all2 -- await both futures; settle ok with fa's value only if both succeed.
;;;
;;; Parameters:
;;;   fa -- first Future pointer
;;;   fb -- second Future pointer
;;;
;;; Returns:
;;;   A new pre-settled Future: ok with fa's value if both ok, else the first error.
;;;
;;; Since: Phase T20-C

(defn future-all2 [^borrow fa : Future ^borrow fb : Future] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *a = (FutureCell *)fa;
  FutureCell *b = (FutureCell *)fb;
  pthread_mutex_lock(&a->lock);
  while (!a->is_set) pthread_cond_wait(&a->ready, &a->lock);
  bool ok_a = a->is_ok; int64_t val_a = a->value; int64_t exn_a = a->exn;
  pthread_mutex_unlock(&a->lock);
  pthread_mutex_lock(&b->lock);
  while (!b->is_set) pthread_cond_wait(&b->ready, &b->lock);
  bool ok_b = b->is_ok; int64_t exn_b = b->exn;
  pthread_mutex_unlock(&b->lock);
  FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
  if (!out) { fprintf(stderr, "future-all2: oom\n"); abort(); }
  pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
  out->is_set = true;
  if (!ok_a) { out->is_ok = false; out->value = 0; out->exn = exn_a; }
  else if (!ok_b) { out->is_ok = false; out->value = 0; out->exn = exn_b; }
  else { out->is_ok = true; out->value = val_a; out->exn = 0; }
  return (void *)(intptr_t)out;
  ```)
;; Return the first future to be *fulfilled* (ignoring rejections until all reject).
;; With exactly two futures: if fa fulfills, return fa's value.
;; If fa rejects but fb fulfills, return fb's value.
;; If both reject, return fb's rejection.
;;; future-any2 -- return a future settled by the first fulfilled future; both rejecting yields fb's error.
;;;
;;; Parameters:
;;;   fa -- first Future pointer
;;;   fb -- second Future pointer
;;;
;;; Returns:
;;;   A new pre-settled Future with fa's value if fa ok, else fb's outcome.
;;;
;;; Since: Phase T20-C

(defn future-any2 [^borrow fa : Future ^borrow fb : Future] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *a = (FutureCell *)fa;
  FutureCell *b = (FutureCell *)fb;
  pthread_mutex_lock(&a->lock);
  while (!a->is_set) pthread_cond_wait(&a->ready, &a->lock);
  bool ok_a = a->is_ok; int64_t val_a = a->value; int64_t exn_a = a->exn; (void)exn_a;
  pthread_mutex_unlock(&a->lock);
  if (ok_a) {
      FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
      if (!out) { fprintf(stderr, "future-any2: oom\n"); abort(); }
      pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
      out->is_set = true; out->is_ok = true; out->value = val_a; out->exn = 0;
      return (void *)(intptr_t)out;
  }
  /* fa rejected, try fb */
  pthread_mutex_lock(&b->lock);
  while (!b->is_set) pthread_cond_wait(&b->ready, &b->lock);
  bool ok_b = b->is_ok; int64_t val_b = b->value; int64_t exn_b = b->exn;
  pthread_mutex_unlock(&b->lock);
  FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
  if (!out) { fprintf(stderr, "future-any2: oom\n"); abort(); }
  pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
  out->is_set = true;
  out->is_ok = ok_b; out->value = val_b; out->exn = exn_b;
  return (void *)(intptr_t)out;
  ```)
;; ---- AW-006: Future combinators ----
;; Join two futures: await both and return a tuple (pair) of their values.
;; Returns a FutureCell* with a Tuple2* (from stdlib/tuple.tur) as the value.
;; If either future rejects, the result is rejected with that error.
;;; future-join -- await both futures and produce a new future holding a Tuple2 of their values.
;;;
;;; Parameters:
;;;   fa -- first Future pointer
;;;   fb -- second Future pointer
;;;
;;; Returns:
;;;   A new pre-settled Future whose ok value is a pointer to Tuple2 { e1, e2 };
;;;   rejected with the first error if either future fails.
;;;
;;; Since: Phase T20-C


(defn future-join [^borrow fa : Future ^borrow fb : Future] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *a = (FutureCell *)fa;
  FutureCell *b = (FutureCell *)fb;
  pthread_mutex_lock(&a->lock);
  while (!a->is_set) pthread_cond_wait(&a->ready, &a->lock);
  bool ok_a = a->is_ok; int64_t val_a = a->value; int64_t exn_a = a->exn;
  pthread_mutex_unlock(&a->lock);
  pthread_mutex_lock(&b->lock);
  while (!b->is_set) pthread_cond_wait(&b->ready, &b->lock);
  bool ok_b = b->is_ok; int64_t val_b = b->value; int64_t exn_b = b->exn;
  pthread_mutex_unlock(&b->lock);
  FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
  if (!out) { fprintf(stderr, "future-join: oom\n"); abort(); }
  pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
  out->is_set = true;
  if (!ok_a) { out->is_ok = false; out->value = 0; out->exn = exn_a; }
  else if (!ok_b) { out->is_ok = false; out->value = 0; out->exn = exn_b; }
  else {
      Tuple2 *tup = (Tuple2 *)malloc(sizeof(Tuple2));
      if (!tup) { free(out); fprintf(stderr, "future-join: oom\n"); abort(); }
      tup->e1 = val_a; tup->e2 = val_b;
      out->is_ok = true; out->value = (int64_t)(intptr_t)tup; out->exn = 0;
  }
  return (void *)(intptr_t)out;
  ```)
;; Accessors for the tuple returned by future-join
;;; tuple-first -- read the first element of a Tuple2 returned by future-join.
;;;
;;; Parameters:
;;;   tup -- Tuple2 pointer from the ok value of a future-join result
;;;
;;; Returns:
;;;   The int64 first element.
;;;
;;; Since: Phase T20-C

(defn tuple-first [tup : ptr<void>] : int
  ```c
  return ((Tuple2 *)tup)->e1;
  ```)
;;; tuple-second -- read the second element of a Tuple2 returned by future-join.
;;;
;;; Parameters:
;;;   tup -- Tuple2 pointer from the ok value of a future-join result
;;;
;;; Returns:
;;;   The int64 second element.
;;;
;;; Since: Phase T20-C

(defn tuple-second [tup : ptr<void>] : int
  ```c
  return ((Tuple2 *)tup)->e2;
  ```)
;; Free a tuple allocated by future-join
;;; tuple-free -- free a Tuple2 allocated by future-join.
;;;
;;; Parameters:
;;;   tup -- Tuple2 pointer to free
;;;
;;; Since: Phase T20-C

(defn tuple-free [tup : ptr<void>] : nil
  ```c
  free(tup);
  ```)
;; ---- Convenience: Create and return a (Promise, Future) pair in one step ----
;;; promise-new-pair -- allocate a new unsettled Promise/Future shared cell (alias for promise-new).
;;;
;;; Since: Phase T20-C


(defn promise-new-pair [] : Promise (promise-new))
;; ---- AW-007: Variadic multi-combinators ---
;; Race an array of futures. Returns a new future that resolves to the first settled future.
;; Takes a ptr<void> to an array of FutureCell* and a count.
;;; future-race-n -- race an array of n futures; return a new future settled by the first to finish.
;;;
;;; Parameters:
;;;   futures -- pointer to an array of FutureCell* (ptr<void>[n])
;;;   n       -- number of futures in the array
;;;
;;; Returns:
;;;   A new pre-settled Future with the first settled future's outcome.
;;;
;;; Since: Phase T20-C


(defn future-race-n [futures : ptr<void> n : int] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell **arr = (FutureCell **)futures;
  for (int i = 0; i < (int)n; i++) {
      pthread_mutex_lock(&arr[i]->lock);
      if (arr[i]->is_set) {
          bool ok = arr[i]->is_ok; int64_t val = arr[i]->value; int64_t exn = arr[i]->exn;
          pthread_mutex_unlock(&arr[i]->lock);
          for (int j = 0; j < i; j++) pthread_mutex_unlock(&arr[j]->lock);
          for (int j = i + 1; j < (int)n; j++) pthread_mutex_unlock(&arr[j]->lock);
          FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
          if (!out) { fprintf(stderr, "future-race-n: oom\n"); abort(); }
          pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
          out->is_set = true; out->is_ok = ok; out->value = val; out->exn = exn;
          return (void *)(intptr_t)out;
      }
      pthread_mutex_unlock(&arr[i]->lock);
  }
  for (;;) {
      for (int i = 0; i < (int)n; i++) {
          pthread_mutex_lock(&arr[i]->lock);
          if (arr[i]->is_set) {
              bool ok = arr[i]->is_ok; int64_t val = arr[i]->value; int64_t exn = arr[i]->exn;
              pthread_mutex_unlock(&arr[i]->lock);
              for (int j = 0; j < (int)n; j++) {
                  if (j != i) pthread_mutex_unlock(&arr[j]->lock);
              }
              FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
              if (!out) { fprintf(stderr, "future-race-n: oom\n"); abort(); }
              pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
              out->is_set = true; out->is_ok = ok; out->value = val; out->exn = exn;
              return (void *)(intptr_t)out;
          }
      }
      struct timespec ts = {0, 100000}; nanosleep(&ts, NULL);
  }
  ```)
;; All of an array of futures.
;;; future-all-n -- await all n futures; settle ok (value 0) only if every future succeeds.
;;;
;;; Parameters:
;;;   futures -- pointer to an array of FutureCell* (ptr<void>[n])
;;;   n       -- number of futures in the array
;;;
;;; Returns:
;;;   A new pre-settled Future: ok with value 0 if all ok, else the first encountered error.
;;;
;;; Since: Phase T20-C

(defn future-all-n [futures : ptr<void> n : int] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell **arr = (FutureCell **)futures;
  bool all_ok = true;
  int64_t first_exn = 0;
  for (int i = 0; i < (int)n; i++) {
      pthread_mutex_lock(&arr[i]->lock);
      while (!arr[i]->is_set) pthread_cond_wait(&arr[i]->ready, &arr[i]->lock);
      if (!arr[i]->is_ok) {
          if (all_ok) { all_ok = false; first_exn = arr[i]->exn; }
      }
      pthread_mutex_unlock(&arr[i]->lock);
  }
  FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
  if (!out) { fprintf(stderr, "future-all-n: oom\n"); abort(); }
  pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
  out->is_set = true;
  if (!all_ok) { out->is_ok = false; out->value = 0; out->exn = first_exn; }
  else { out->is_ok = true; out->value = 0; out->exn = 0; }
  return (void *)(intptr_t)out;
  ```)
;; Any of an array of futures.
;;; future-any-n -- return a future settled by the first successfully fulfilled future in the array.
;;;
;;; Parameters:
;;;   futures -- pointer to an array of FutureCell* (ptr<void>[n])
;;;   n       -- number of futures in the array
;;;
;;; Returns:
;;;   A new pre-settled Future: ok with the first fulfilled value, or failed if all reject.
;;;
;;; Since: Phase T20-C

(defn future-any-n [futures : ptr<void> n : int] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell **arr = (FutureCell **)futures;
  for (int i = 0; i < (int)n; i++) {
      pthread_mutex_lock(&arr[i]->lock);
      while (!arr[i]->is_set) pthread_cond_wait(&arr[i]->ready, &arr[i]->lock);
      if (arr[i]->is_ok) {
          int64_t val = arr[i]->value;
          for (int j = i + 1; j < (int)n; j++) pthread_mutex_unlock(&arr[j]->lock);
          pthread_mutex_unlock(&arr[i]->lock);
          FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
          if (!out) { fprintf(stderr, "future-any-n: oom\n"); abort(); }
          pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
          out->is_set = true; out->is_ok = true; out->value = val; out->exn = 0;
          return (void *)(intptr_t)out;
      }
      pthread_mutex_unlock(&arr[i]->lock);
  }
  FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
  if (!out) { fprintf(stderr, "future-any-n: oom\n"); abort(); }
  pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
  out->is_set = true; out->is_ok = false; out->value = 0; out->exn = 0;
  return (void *)(intptr_t)out;
  ```)
;; ---- AW-008: Future timeout ---
;; Hoisted thread-fn helpers for future-timeout / future-with-timeout.
;; Originally these were nested function definitions inside the parent
;; defn's inline-C block (a GCC extension); clang rejects nested
;; functions, so each is a top-level defn now, in the same shape as
;; stdlib/threadpool.tur:tp-worker. The pthread_create site casts the
;; mangled C name to (void *(*)(void *)).
;;; future-timeout-thread -- pthread body for future-timeout. INTERNAL.

(defn future-timeout-thread [raw : ptr<void>] : ptr<void>
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  typedef struct { FutureCell *fc; int ms; } TimeoutArg;
  TimeoutArg *a = (TimeoutArg *)raw;
  if (a->ms > 0) {
      struct timespec ts; ts.tv_sec = a->ms / 1000; ts.tv_nsec = (a->ms % 1000) * 1000000L;
      nanosleep(&ts, NULL);
  }
  pthread_mutex_lock(&a->fc->lock);
  if (!a->fc->is_set) { a->fc->is_set = true; pthread_cond_broadcast(&a->fc->ready); }
  pthread_mutex_unlock(&a->fc->lock);
  free(a); return NULL;
  ```)
;;; future-with-timeout-tfn -- pthread body for the timeout half of future-with-timeout. INTERNAL.

(defn future-with-timeout-tfn [raw : ptr<void>] : ptr<void>
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  typedef struct { FutureCell *out; FutureCell *src; int ms; } TA;
  TA *a = (TA *)raw;
  if (a->ms > 0) {
      struct timespec ts; ts.tv_sec = a->ms / 1000; ts.tv_nsec = (a->ms % 1000) * 1000000L;
      nanosleep(&ts, NULL);
  }
  pthread_mutex_lock(&a->out->lock);
  if (!a->out->is_set) { a->out->is_set = true; a->out->is_ok = false; a->out->exn = -1; pthread_cond_broadcast(&a->out->ready); }
  pthread_mutex_unlock(&a->out->lock);
  free(a); return NULL;
  ```)
;;; future-with-timeout-wfn -- pthread body for the wait half of future-with-timeout. INTERNAL.

(defn future-with-timeout-wfn [raw : ptr<void>] : ptr<void>
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  typedef struct { FutureCell *out; FutureCell *src; } WA;
  WA *a = (WA *)raw;
  pthread_mutex_lock(&a->src->lock);
  while (!a->src->is_set) pthread_cond_wait(&a->src->ready, &a->src->lock);
  bool ok = a->src->is_ok; int64_t val = a->src->value; int64_t exn = a->src->exn;
  pthread_mutex_unlock(&a->src->lock);
  pthread_mutex_lock(&a->out->lock);
  if (!a->out->is_set) { a->out->is_set = true; a->out->is_ok = ok; a->out->value = val; a->out->exn = exn; pthread_cond_broadcast(&a->out->ready); }
  pthread_mutex_unlock(&a->out->lock);
  free(a); return NULL;
  ```)
;; Create a future that times out after ms milliseconds with error -1.
;;; future-timeout -- create a future that settles with error -1 after ms milliseconds.
;;;
;;; Parameters:
;;;   ms -- timeout duration in milliseconds
;;;
;;; Returns:
;;;   A Future that will be settled (is_ok = false, exn = -1) after ms ms.
;;;
;;; Example:
;;;   (def t (future-timeout 5000))  ; rejects after 5 seconds
;;;
;;; Since: Phase T20-C


(defn future-timeout [ms : int] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)malloc(sizeof(FutureCell));
  if (!fc) { fprintf(stderr, "future-timeout: oom\n"); abort(); }
  pthread_mutex_init(&fc->lock, NULL);
  pthread_cond_init(&fc->ready, NULL);
  fc->refcount = 1;
  fc->is_set = false;
  fc->is_ok = false;
  fc->value = 0;
  fc->exn = -1;
  typedef struct { FutureCell *fc; int ms; } TimeoutArg;
  TimeoutArg *arg = (TimeoutArg *)malloc(sizeof(TimeoutArg));
  if (!arg) { free(fc); fprintf(stderr, "future-timeout: arg oom\n"); abort(); }
  arg->fc = fc; arg->ms = ms;
  pthread_t tid; pthread_attr_t attr;
  pthread_attr_init(&attr); pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
  pthread_create(&tid, &attr, (void *(*)(void *))future_hytimeout_hythread, arg);
  pthread_attr_destroy(&attr);
  return (void *)(intptr_t)fc;
  ```)
;; Race a future against a timeout.
;;; future-with-timeout -- race a future against a timeout of ms milliseconds.
;;;
;;; Parameters:
;;;   f  -- source Future pointer
;;;   ms -- timeout in milliseconds; on expiry the result is rejected with exn = -1
;;;
;;; Returns:
;;;   A new Future settled with f's outcome if f finishes first, otherwise rejected with -1.
;;;
;;; Since: Phase T20-C

(defn future-with-timeout [^borrow f : Future ms : int] : Future
  ```c
  typedef struct { pthread_mutex_t lock; pthread_cond_t ready; int64_t value; int64_t exn; bool is_set; bool is_ok; int64_t refcount; } FutureCell;
  FutureCell *fc = (FutureCell *)f;
  FutureCell *out = (FutureCell *)malloc(sizeof(FutureCell));
  if (!out) { fprintf(stderr, "future-with-timeout: oom\n"); abort(); }
  pthread_mutex_init(&out->lock, NULL); pthread_cond_init(&out->ready, NULL);
  out->refcount = 1;
  out->is_set = false;
  typedef struct { FutureCell *out; FutureCell *src; int ms; } TA;
  TA *arg = (TA *)malloc(sizeof(TA));
  if (!arg) { free(out); fprintf(stderr, "future-with-timeout: arg oom\n"); abort(); }
  arg->out = out; arg->src = fc; arg->ms = ms;
  pthread_t tid; pthread_attr_t attr;
  pthread_attr_init(&attr); pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
  pthread_create(&tid, &attr, (void *(*)(void *))future_hywith_hytimeout_hytfn, arg); pthread_attr_destroy(&attr);
  pthread_mutex_lock(&fc->lock);
  if (fc->is_set) {
      pthread_mutex_unlock(&fc->lock);
      pthread_mutex_lock(&out->lock);
      if (!out->is_set) { out->is_set = true; out->is_ok = fc->is_ok; out->value = fc->value; out->exn = fc->exn; pthread_cond_broadcast(&out->ready); }
      pthread_mutex_unlock(&out->lock);
  } else {
      pthread_mutex_unlock(&fc->lock);
      typedef struct { FutureCell *out; FutureCell *src; } WA;
      WA *warg = (WA *)malloc(sizeof(WA));
      if (!warg) { free(out); free(arg); fprintf(stderr, "future-with-timeout: warg oom\n"); abort(); }
      warg->out = out; warg->src = fc;
      pthread_t tid2; pthread_attr_t attr2; pthread_attr_init(&attr2); pthread_attr_setdetachstate(&attr2, PTHREAD_CREATE_DETACHED);
      pthread_create(&tid2, &attr2, (void *(*)(void *))future_hywith_hytimeout_hywfn, warg); pthread_attr_destroy(&attr2);
  }
  return (void *)(intptr_t)out;
  ```)
