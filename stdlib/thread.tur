;;; tur/thread -- POSIX thread spawn, join, and detach wrappers.
;;;
;;; Thin wrappers around pthread_create, pthread_join, and pthread_detach.
;;;
;;; Since: Phase T19-C
;; stdlib/thread.tur -- POSIX thread spawn/join/detach (Phase T19-C)
;;
;; Wraps pthread_create / pthread_join / pthread_detach.
;; A thread handle is a ThreadHandle (a :ptr<void> pointing to a heap-allocated
;; TurThreadHandle). The handle is consumed (freed) by thread-join or
;; thread-detach.
;;
;; ---- Opaque handle newtype (stdlib-opaque-handle-types-plan, Tier 3) ----
;; ThreadHandle wraps the underlying :ptr<void> with a nominally distinct type
;; so the checker rejects passing an unrelated handle to thread-join /
;; thread-detach / cancel-thread. It lowers to :ptr<void> in the C ABI, so the
;; inline-C bodies are unchanged.
(defopaque ThreadHandle :ptr<void>)
;;
;; TC0-TC2: Cooperative cancellation API:
;;   cancel-thread    [t :ThreadHandle] -- request cancellation of t
;;   cancelled?       []               -- true if the calling thread has been cancelled
;;   yield-point      []               -- macro: panic if cancelled (cooperative cancel point)
;;   with-cancel-guard [cleanup body]  -- run body; on cancel, run cleanup and return nil
;;
;; API:
;;   thread-spawn-fn  [fn-ptr :ptr<void> arg :ptr<void>]  -- ThreadHandle
;;   thread-join      [t :ThreadHandle]                    -- nil
;;   thread-detach    [t :ThreadHandle]                    -- nil
;;   thread-id        []                                   -- int
;;
;; Note: (thread-spawn (fn [] ...)) is the elaborator-level Send-safety gate
;; (Phase T19-B).  thread-spawn-fn is the runtime entry point for calling
;; pthread_create with an explicit function pointer.
;;; thread-spawn-fn -- spawn a new OS thread calling fn-ptr with arg.
;;;
;;; Parameters:
;;;   fn-ptr -- C function pointer of type void *(*)(void *).
;;;             Must carry no environment -- captures are forbidden. The
;;;             pthread_create boundary stores fn-ptr as a raw C function
;;;             pointer; a captured value would be silently dropped.
;;;             Wrap state into arg, or use the higher-level (thread-spawn
;;;             (fn [] ...)) form which boxes the closure for you.
;;;   arg    -- opaque argument forwarded to fn-ptr
;;;
;;; Returns:
;;;   A ThreadHandle that must be passed to thread-join or thread-detach.
;;;
;;; Example:
;;;   (let [t (thread-spawn-fn my-fn arg)] (thread-join t))  ; => ThreadHandle
;;;
;;; Since: Phase T19-C

(defn thread-spawn-fn [fn-ptr : ptr<void> arg : ptr<void>]
  #fx{Unsafe}
  : ThreadHandle
  ```c
  TurThreadState *state = (TurThreadState *)malloc(sizeof(TurThreadState));
  if (!state) { fprintf(stderr, "thread-spawn-fn: out of memory\n"); abort(); }
  pthread_mutex_init(&state->cancel_mutex, NULL);
  pthread_cond_init(&state->cancel_cond, NULL);
  state->cancel_requested = 0;
  TurThreadSpawnArg *spawn_arg = (TurThreadSpawnArg *)malloc(sizeof(TurThreadSpawnArg));
  if (!spawn_arg) { free(state); fprintf(stderr, "thread-spawn-fn: out of memory\n"); abort(); }
  spawn_arg->user_fn  = (void *(*)(void *))fn_ptr;
  spawn_arg->user_arg = (void *)arg;
  spawn_arg->state    = state;
  TurThreadHandle *h = (TurThreadHandle *)malloc(sizeof(TurThreadHandle));
  if (!h) { free(spawn_arg); free(state); fprintf(stderr, "thread-spawn-fn: out of memory\n"); abort(); }
  h->state = state;
  int rc = pthread_create(&h->tid, NULL, tur_thread_trampoline, spawn_arg);
  if (rc != 0) {
      free(h); free(spawn_arg); free(state);
      fprintf(stderr, "thread-spawn-fn: pthread_create failed (%d)\n", rc);
      abort();
  }
  return (void *)(intptr_t)h;
  ```)
;;; thread-join -- wait for a thread to finish and free its handle.
;;;
;;; Parameters:
;;;   t -- thread handle returned by thread-spawn-fn
;;;
;;; Example:
;;;   (thread-join t)
;;;
;;; Since: Phase T19-C

(defn thread-join [t : ThreadHandle]
  #fx{Unsafe}
  : nil
  ```c
  TurThreadHandle *h = (TurThreadHandle *)t;
  pthread_join(h->tid, NULL);
  pthread_mutex_destroy(&h->state->cancel_mutex);
  pthread_cond_destroy(&h->state->cancel_cond);
  free(h->state);
  free(h);
  ```)
;;; thread-detach -- detach a thread (it cleans up itself on exit) and free the handle.
;;;
;;; Parameters:
;;;   t -- thread handle returned by thread-spawn-fn
;;;
;;; Example:
;;;   (thread-detach t)
;;;
;;; Since: Phase T19-C

(defn thread-detach [t : ThreadHandle]
  #fx{Unsafe}
  : nil
  ```c
  TurThreadHandle *h = (TurThreadHandle *)t;
  pthread_detach(h->tid);
  /* state ownership: the thread still holds tur_current_thread_state pointing to
   * state; free only the handle struct. state is freed when the thread exits or
   * leaked (detached threads are fire-and-forget). */
  free(h);
  ```)
;;; thread-id -- return an integer identifier for the calling OS thread.
;;;
;;; Returns:
;;;   The current thread's pthread_t value cast to int64_t.
;;;
;;; Example:
;;;   (thread-id)  ; => int
;;;
;;; Since: Phase T19-C

(defn thread-id []
  #fx{Unsafe}
  : int
  ```c
  return (int64_t)(uintptr_t)pthread_self();
  ```)
;; ---- TC0-TC2: Cooperative thread cancellation ----
;;; cancel-thread -- request cooperative cancellation of a thread handle.
;;;
;;; Parameters:
;;;   t -- a thread handle returned by thread-spawn-fn
;;;
;;; Returns:
;;;   :void
;;;
;;; Example:
;;;   (let [t (thread-spawn-fn my-fn arg)]
;;;     (cancel-thread t)
;;;     (thread-join t))
;;;
;;; Since: Phase TC0


(defn cancel-thread [t : ThreadHandle]
  #fx{Unsafe}
  : void
  ```c
  TurThreadHandle *h = (TurThreadHandle *)t;
  __atomic_store_n(&h->state->cancel_requested, 1, __ATOMIC_RELEASE);
  pthread_mutex_lock(&h->state->cancel_mutex);
  pthread_cond_broadcast(&h->state->cancel_cond);
  pthread_mutex_unlock(&h->state->cancel_mutex);
  ```)
;;; cancelled? -- return true if the current thread has been cancelled.
;;;
;;; Returns:
;;;   bool -- true if a cancellation has been requested for this thread
;;;
;;; Example:
;;;   (when (cancelled?) (cleanup-and-return))
;;;
;;; Since: Phase TC0

(defn cancelled? []
  #fx{Unsafe}
  : bool
  ```c
  return tur_thread_cancel_requested() != 0;
  ```)
;;; with-cancel-guard -- run a body closure; on cancellation, run cleanup and return nil.
;;;
;;; When the body or any blocking operation inside it (chan-recv, chan-send, select)
;;; is cancelled, the cleanup closure runs before control returns.
;;; Without a guard, cancellation inside a blocking op panics immediately.
;;;
;;; Parameters:
;;;   cleanup -- zero-argument closure: (fn [] ...) to run on cancellation
;;;   body    -- zero-argument closure: (fn [] ...) to run normally
;;;
;;; Returns:
;;;   :nil (always; body result is discarded)
;;;
;;; Example:
;;;   (with-cancel-guard
;;;     (fn [] (release resource))
;;;     (fn []
;;;       (let [v (chan-recv ch)]
;;;         (process v))))
;;;
;;; Since: Phase TC1

(defn with-cancel-guard [^fat cleanup : (fn [] nil) ^fat body : (fn [] nil)]
  #fx{Unsafe}
  : nil
  ```c
  /* Save previous cancel jmpbuf state (supports nested guards) */
  int prev_valid = tur_cancel_jmpbuf_valid;
  /* The preamble's portable buffer and setjmp: on Windows `tur_jmp_buf` is
   * `void *[30]` driven by tur_sjlj_set, not the CRT `jmp_buf`, so a raw
   * `setjmp`/`jmp_buf` here does not compile on MinGW (and the sizes the
   * save/restore copies would differ). */
  tur_jmp_buf prev_buf;
  if (prev_valid) memcpy(&prev_buf, &tur_cancel_jmpbuf, sizeof(tur_jmp_buf));
  tur_cancel_jmpbuf_valid = 1;
  /* Fat-closure calling convention: slot 0 is the thunk, called with the
   * box.  A `(fn [] nil)` thunk is `void (*)(void *)` -- the exact type, not
   * a word-taking one (stdlib-int-stand-in-audit: these were `ptr<void>`
   * and called as `int64_t (*)(void *, int64_t)` with a stray 0, a
   * -fsanitize=function trap). */
  void *body_clos    = (void *)(intptr_t)body;
  void *cleanup_clos = (void *)(intptr_t)cleanup;
  void (*body_thunk)(void *)    = (void (*)(void *))(intptr_t)((int64_t *)body_clos)[0];
  void (*cleanup_thunk)(void *) = (void (*)(void *))(intptr_t)((int64_t *)cleanup_clos)[0];
  if (TUR_SETJMP(tur_cancel_jmpbuf) == 0) {
      body_thunk(body_clos);
      tur_cancel_jmpbuf_valid = prev_valid;
      if (prev_valid) memcpy(&tur_cancel_jmpbuf, &prev_buf, sizeof(tur_jmp_buf));
  } else {
      tur_cancel_jmpbuf_valid = prev_valid;
      if (prev_valid) memcpy(&tur_cancel_jmpbuf, &prev_buf, sizeof(tur_jmp_buf));
      cleanup_thunk(cleanup_clos);
  }
  ```)
;;; __yield-point-impl -- internal: check cancel and exit if cancelled.

(defn __yield-point-impl []
  #fx{Unsafe}
  : void
  ```c
  if (tur_thread_cancel_requested()) {
      tur_thread_do_cancel();
  }
  ```)
;;; yield-point -- check for a pending cancellation and exit if one is set.
;;;
;;; Call this inside any CPU-bound loop that must respond to cancel-thread.
;;; Blocking operations (chan-recv, chan-send, select) check automatically;
;;; pure computation loops must call yield-point explicitly.
;;;
;;; Returns:
;;;   :void (never returns if the thread has been cancelled)
;;;
;;; Example:
;;;   (defn crunch [n] :int
;;;     (let [i 0]
;;;       (while (< i n)
;;;         (yield-point)
;;;         (do-work i)
;;;         (set! i (+ i 1)))))
;;;
;;; Since: Phase TC2

(defmacro yield-point [] (list '__yield-point-impl))
