;; EAVT Database -- indexed implementation
;;
;; Adds a hash-bucketed EAVT index on top of the minimal database.
;; The index maps (entity, attr) pairs to the log positions of the
;; matching datums, enabling O(1) average-case lookup instead of
;; a full linear scan.
;;
;; Typed Turmeric throughout, so all three engines run it:
;;
;;   ./build/tur run examples/datalog/indexed.tur
;;   ./build/tur jit examples/datalog/indexed.tur
;;   ./build/tur --interpret examples/datalog/indexed.tur

(load "stdlib/cstr.tur")   ;; cstr-eq?: string equality by contents

;; ============================================================
;; Value ADT
;; ============================================================

(defdata ^copy Value
  (LongVal :int)
  (StrVal :cstr)
  (EntityVal :int))

;; ============================================================
;; Datum
;; ============================================================

(defstruct ^copy Datum
  [entity : int
   attr   : cstr
   value  : Value
   tx     : int])

;; ============================================================
;; Database
;; ============================================================

(defalias Db (Vec Datum))

(defn db-new [] : Db
  (vec-new))

(defn db-count [db : Db] : int
  (vec-len db))

(defn db-ref [db : Db i : int] : Datum
  (vec-get db i))

(defn db-assert! [db : Db entity : int attr : cstr value : Value] : int
  (let [tx (+ (db-count db) 1)]
    (vec-push! db (Datum entity attr value tx))
    tx))

;; ============================================================
;; Value printer
;; ============================================================

(defn print-value [v : Value] : nil
  (match v
    (LongVal n)   (println n)
    (StrVal s)    (println s)
    (EntityVal e) (println e)))

;; ============================================================
;; EAVT index
;;
;; A fixed table of 64 buckets.  Each bucket is a Vec of entries,
;; and each entry records one datum's (entity, attr) key and where
;; the datum sits in the log.
;;
;; The key's attribute is an attr-id, a small integer the index
;; hands out per distinct attribute name: names are compared by
;; contents once, when they are interned, and the buckets compare
;; integers from then on.
;; ============================================================

(defstruct ^copy IdxEntry
  [entity : int    ;; the datum's entity
   attr   : int    ;; the datum's attr-id
   pos    : int])  ;; the datum's index in the log

(defstruct ^copy EavtIdx
  [names   : (Vec cstr)              ;; attr-id -> attribute name
   buckets : (Vec (Vec IdxEntry))])  ;; 64 buckets of entries

(def eavt-nbuckets 64)

;; Allocate an empty index: no names, 64 empty buckets
(defn eavt-idx-new [] : EavtIdx
  (let [buckets (:: (vec-new) (Vec (Vec IdxEntry)))
        ^mut i  0]
    (while (< i eavt-nbuckets)
      (vec-push! buckets (:: (vec-new) (Vec IdxEntry)))
      (set! i (+ i 1)))
    (EavtIdx (:: (vec-new) (Vec cstr)) buckets)))

;; attr-find -- the attr-id of an attribute name, if the index has seen it
(defn attr-find [idx : EavtIdx attr : cstr] : (Option int)
  (let [^mut i     0
        ^mut found (:: (none) (Option int))]
    (while (< i (vec-len (.names idx)))
      (when (cstr-eq? (vec-get (.names idx) i) attr)
        (set! found (some i)))
      (set! i (+ i 1)))
    found))

;; attr-intern -- the attr-id of an attribute name, adding it if new
(defn attr-intern [idx : EavtIdx attr : cstr] : int
  (match (attr-find idx attr)
    (Some id) id
    (None)    (do (vec-push! (.names idx) attr)
                  (- (vec-len (.names idx)) 1))))

;; The bucket an (entity, attr-id) key lives in
(defn eavt-bucket [idx : EavtIdx entity : int attr : int] : (Vec IdxEntry)
  (vec-get (.buckets idx) (mod (+ (* entity 31) attr) eavt-nbuckets)))

;; Insert a datum's log position into the index under (entity, attr)
(defn eavt-idx-insert! [idx : EavtIdx entity : int attr : cstr pos : int] : nil
  (let [id (attr-intern idx attr)]
    (vec-push! (eavt-bucket idx entity id) (IdxEntry entity id pos))
    nil))

;; Lookup the log positions of every datum indexed under (entity, attr).
;; Returns a fresh Vec, empty when the attribute was never indexed.
(defn eavt-idx-lookup [idx : EavtIdx entity : int attr : cstr] : (Vec int)
  (let [result (:: (vec-new) (Vec int))]
    (match (attr-find idx attr)
      (Some id)
        (let [bucket (eavt-bucket idx entity id)
              ^mut i 0]
          (while (< i (vec-len bucket))
            (let [e (vec-get bucket i)]
              (when (and (= (.entity e) entity) (= (.attr e) id))
                (vec-push! result (.pos e))))
            (set! i (+ i 1))))
      (None) nil)
    result))

;; Free every bucket, the bucket table and the name table
(defn eavt-idx-free [idx : EavtIdx] : nil
  (let [^mut i 0]
    (while (< i (vec-len (.buckets idx)))
      (vec-free (vec-get (.buckets idx) i))
      (set! i (+ i 1))))
  (vec-free (.buckets idx))
  (vec-free (.names idx))
  nil)

;; ============================================================
;; Indexed database (idb)
;;
;; The log and its index, kept in step: every assert goes to both.
;; ============================================================

(defstruct ^copy Idb
  [db  : Db
   idx : EavtIdx])

;; Create an indexed database
(defn idb-new [] : Idb
  (Idb (db-new) (eavt-idx-new)))

;; Assert a fact into the indexed database
(defn idb-assert! [idb : Idb entity : int attr : cstr value : Value] : int
  (let [tx (db-assert! (.db idb) entity attr value)]
    ;; The datum is the last entry in the log
    (eavt-idx-insert! (.idx idb) entity attr (- (db-count (.db idb)) 1))
    tx))

;; Query by entity and attribute using the EAVT index (fast path).
;; Returns a fresh Vec of the matching datums.
(defn idb-q-ea [idb : Idb entity : int attr : cstr] : (Vec Datum)
  (let [positions (eavt-idx-lookup (.idx idb) entity attr)
        result    (:: (vec-new) (Vec Datum))
        ^mut i    0]
    (while (< i (vec-len positions))
      (vec-push! result (db-ref (.db idb) (vec-get positions i)))
      (set! i (+ i 1)))
    (vec-free positions)
    result))

(defn idb-free [idb : Idb] : nil
  (eavt-idx-free (.idx idb))
  (vec-free (.db idb))
  nil)

;; ============================================================
;; Demo
;; ============================================================

;; Print the value of every datum in a query result, then free it
(defn print-values! [ds : (Vec Datum)] : nil
  (let [^mut i 0]
    (while (< i (vec-len ds))
      (print-value (.value (vec-get ds i)))
      (set! i (+ i 1))))
  (vec-free ds)
  nil)

(defn demo [] : nil
  (let [idb (idb-new)]

    ;; Build some data
    (idb-assert! idb 1 ":user/name"  (StrVal "Alice"))
    (idb-assert! idb 1 ":user/age"   (LongVal 30))
    (idb-assert! idb 1 ":user/email" (StrVal "alice@example.com"))

    (idb-assert! idb 2 ":user/name"  (StrVal "Bob"))
    (idb-assert! idb 2 ":user/age"   (LongVal 25))
    (idb-assert! idb 2 ":user/email" (StrVal "bob@example.com"))

    (idb-assert! idb 3 ":user/name"  (StrVal "Carol"))
    (idb-assert! idb 3 ":user/age"   (LongVal 28))

    ;; Indexed lookup: find Alice's name (entity=1, attr=:user/name)
    (println "-- idb-q-ea entity=1 :user/name --")
    (print-values! (idb-q-ea idb 1 ":user/name"))

    ;; Indexed lookup: find Bob's age
    (println "-- idb-q-ea entity=2 :user/age --")
    (print-values! (idb-q-ea idb 2 ":user/age"))

    ;; Indexed lookup for entity that has no such attribute
    (println "-- idb-q-ea entity=3 :user/email (should be empty) --")
    (let [results (idb-q-ea idb 3 ":user/email")]
      (println (vec-len results))
      (vec-free results))

    (idb-free idb)
    nil))

(defn main [] : int
  (demo)
  0)
