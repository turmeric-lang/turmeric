;; EAVT Database -- minimal implementation
;;
;; An immutable, append-only fact database with Entity-Attribute-Value-Transaction
;; semantics, inspired by Datomic's data model.
;;
;; Concepts:
;;   Entity      -- a unique integer ID for an "object"
;;   Attribute   -- a string name like ":user/name"
;;   Value       -- a typed payload (long, string, entity ref, ...)
;;   Transaction -- a monotonic counter stamped on each assert
;;
;; Everything here is typed Turmeric -- a `Value` sum, a `Datum` struct, a
;; `(Vec Datum)` log -- so all three engines run it:
;;
;;   ./build/tur run examples/datalog/minimal.tur
;;   ./build/tur jit examples/datalog/minimal.tur
;;   ./build/tur --interpret examples/datalog/minimal.tur

(load "stdlib/cstr.tur")   ;; cstr-eq?: string equality by contents

;; ============================================================
;; Value ADT -- typed payload stored in each fact
;; ============================================================

;; `:copy` because a fact is immutable: a Value is read, compared and printed,
;; never consumed, so every use may copy it.
(defdata ^copy Value
  (LongVal :int)      ;; 64-bit integer
  (StrVal :cstr)      ;; string
  (EntityVal :int))   ;; reference to another entity

;; ============================================================
;; Datum -- a single immutable EAV-T fact
;; ============================================================

(defstruct ^copy Datum
  [entity : int     ;; the object the fact is about
   attr   : cstr    ;; the property, e.g. ":user/name"
   value  : Value   ;; the payload
   tx     : int])   ;; the transaction that asserted it

;; ============================================================
;; Database -- the append-only log of datums, oldest first
;; ============================================================

(defalias Db (Vec Datum))

(defn db-new [] : Db
  (vec-new))

;; Number of facts in the database
(defn db-count [db : Db] : int
  (vec-len db))

;; Get datum at index i
(defn db-ref [db : Db i : int] : Datum
  (vec-get db i))

;; Assert a new fact: append it, stamped with the next transaction number.
;; Every assert appends exactly one datum, so the tx is the datum's 1-based
;; position in the log. Returns the tx.
(defn db-assert! [db : Db entity : int attr : cstr value : Value] : int
  (let [tx (+ (db-count db) 1)]
    (vec-push! db (Datum entity attr value tx))
    tx))

;; ============================================================
;; Query -- filter datums with a predicate closure
;; Returns a fresh (Vec Datum) of the matches, in log order
;; ============================================================

(defn db-q [db : Db pred : (fn [Datum] bool)] : (Vec Datum)
  (let [result (:: (vec-new) (Vec Datum))
        ^mut i 0]
    (while (< i (db-count db))
      (let [d (db-ref db i)]
        (when (pred d)
          (vec-push! result d)))
      (set! i (+ i 1)))
    result))

;; ============================================================
;; Value printer
;; ============================================================

(defn print-value [v : Value] : nil
  (match v
    (LongVal n)   (println n)
    (StrVal s)    (println s)
    (EntityVal e) (println e)))

;; Print the value of every datum in a query result
(defn print-values [ds : (Vec Datum)] : nil
  (let [^mut i 0]
    (while (< i (vec-len ds))
      (print-value (.value (vec-get ds i)))
      (set! i (+ i 1)))))

;; ============================================================
;; Query combinators -- build predicate closures
;; ============================================================

;; Match datums by entity ID
(defn q-entity [e : int] : (fn [Datum] bool)
  (fn [d : Datum] : bool (= (.entity d) e)))

;; Match datums by attribute name (compared by contents, never by address)
(defn q-attr [a : cstr] : (fn [Datum] bool)
  (fn [d : Datum] : bool (cstr-eq? (.attr d) a)))

;; Match datums by entity AND attribute
(defn q-ea [e : int a : cstr] : (fn [Datum] bool)
  (fn [d : Datum] : bool
    (and (= (.entity d) e)
         (cstr-eq? (.attr d) a))))

;; Logical AND of two predicates
(defn q-and [p : (fn [Datum] bool) q : (fn [Datum] bool)] : (fn [Datum] bool)
  (fn [d : Datum] : bool (and (p d) (q d))))

;; Logical OR of two predicates
(defn q-or [p : (fn [Datum] bool) q : (fn [Datum] bool)] : (fn [Datum] bool)
  (fn [d : Datum] : bool (or (p d) (q d))))

;; Logical NOT of a predicate
(defn q-not [p : (fn [Datum] bool)] : (fn [Datum] bool)
  (fn [d : Datum] : bool (not (p d))))

;; ============================================================
;; Demo
;; ============================================================

(defn demo [] : nil
  (let [db (db-new)]

    ;; --- Alice: entity 1 ---
    (db-assert! db 1 ":user/name"  (StrVal "Alice"))
    (db-assert! db 1 ":user/email" (StrVal "alice@example.com"))
    (db-assert! db 1 ":user/age"   (LongVal 30))

    ;; --- Bob: entity 2 ---
    (db-assert! db 2 ":user/name"  (StrVal "Bob"))
    (db-assert! db 2 ":user/email" (StrVal "bob@example.com"))
    (db-assert! db 2 ":user/age"   (LongVal 25))

    ;; Query: all user names.  A query result is a fresh Vec the caller owns
    ;; and frees; the datums in it are copies, so freeing it leaves the
    ;; database alone.
    (println "-- All user names --")
    (let [names (db-q db (q-attr ":user/name"))]
      (print-values names)
      (vec-free names))

    ;; Query: facts about entity 1 (Alice)
    (println "-- Alice's facts --")
    (let [alice (db-q db (q-entity 1))
          ^mut i 0]
      (while (< i (vec-len alice))
        (let [d (vec-get alice i)]
          (println (.attr d))
          (print-value (.value d)))
        (set! i (+ i 1)))
      (vec-free alice))

    ;; Query: ages of every user but entity 2
    (println "-- Users with age NOT 25 --")
    (let [ages (db-q db (q-and (q-attr ":user/age")
                               (q-not (q-entity 2))))]
      (print-values ages)
      (vec-free ages))

    (vec-free db)
    nil))

(defn main [] : int
  (demo)
  0)
