;; EAVT Database -- extended query API
;;
;; Builds on the minimal implementation to add:
;;   - Value equality comparison
;;   - Attribute+value queries (q-av)
;;   - Temporal as-of queries (db-as-of)
;;   - Pull API (get all facts for an entity)
;;   - History (in tx order)
;;   - Retraction (encoding as :db/retract facts)
;;
;; Typed Turmeric throughout, so all three engines run it:
;;
;;   ./build/tur run examples/datalog/query.tur
;;   ./build/tur jit examples/datalog/query.tur
;;   ./build/tur --interpret examples/datalog/query.tur

(load "stdlib/cstr.tur")   ;; cstr-eq?: string equality by contents

;; ============================================================
;; Value ADT
;; ============================================================

(defdata Value :copy
  (LongVal :int)
  (StrVal :cstr)
  (EntityVal :int))

;; ============================================================
;; Datum
;; ============================================================

(defstruct Datum :copy
  [entity : int
   attr   : cstr
   value  : Value
   tx     : int])

;; ============================================================
;; Database
;; ============================================================

(defalias Db (Vec Datum))

(defn db-new [] : Db
  (vec-new))

(defn db-count [db : Db] : int
  (vec-len db))

(defn db-ref [db : Db i : int] : Datum
  (vec-get db i))

(defn db-assert! [db : Db entity : int attr : cstr value : Value] : int
  (let [tx (+ (db-count db) 1)]
    (vec-push! db (Datum entity attr value tx))
    tx))

;; ============================================================
;; Value printer
;; ============================================================

(defn print-value [v : Value] : nil
  (match v
    (LongVal n)   (println n)
    (StrVal s)    (println s)
    (EntityVal e) (println e)))

;; ============================================================
;; Base query combinators
;; ============================================================

(defn db-q [db : Db pred : (fn [Datum] bool)] : (Vec Datum)
  (let [result (:: (vec-new) (Vec Datum))
        ^mut i 0]
    (while (< i (db-count db))
      (let [d (db-ref db i)]
        (when (pred d)
          (vec-push! result d)))
      (set! i (+ i 1)))
    result))

(defn q-entity [e : int] : (fn [Datum] bool)
  (fn [d : Datum] : bool (= (.entity d) e)))

(defn q-attr [a : cstr] : (fn [Datum] bool)
  (fn [d : Datum] : bool (cstr-eq? (.attr d) a)))

(defn q-ea [e : int a : cstr] : (fn [Datum] bool)
  (fn [d : Datum] : bool
    (and (= (.entity d) e)
         (cstr-eq? (.attr d) a))))

(defn q-and [p : (fn [Datum] bool) q : (fn [Datum] bool)] : (fn [Datum] bool)
  (fn [d : Datum] : bool (and (p d) (q d))))

(defn q-or [p : (fn [Datum] bool) q : (fn [Datum] bool)] : (fn [Datum] bool)
  (fn [d : Datum] : bool (or (p d) (q d))))

(defn q-not [p : (fn [Datum] bool)] : (fn [Datum] bool)
  (fn [d : Datum] : bool (not (p d))))

;; ============================================================
;; Value equality
;; ============================================================

;; Two Values are equal when they are the same variant with equal payloads.
;; Strings compare by contents.
(defn value-eq? [a : Value b : Value] : bool
  (match a
    (LongVal x)   (match b (LongVal y)   (= x y)        _ false)
    (StrVal x)    (match b (StrVal y)    (cstr-eq? x y) _ false)
    (EntityVal x) (match b (EntityVal y) (= x y)        _ false)))

;; ============================================================
;; Extended query combinators
;; ============================================================

;; q-av -- query datums by attribute name and value
(defn q-av [a : cstr v : Value] : (fn [Datum] bool)
  (fn [d : Datum] : bool
    (and (cstr-eq? (.attr d) a)
         (value-eq? (.value d) v))))

;; db-as-of -- every datum asserted at or before as-of-tx
(defn db-as-of [db : Db as-of-tx : int] : (Vec Datum)
  (db-q db (fn [d : Datum] : bool (<= (.tx d) as-of-tx))))

;; pull -- every datum about entity e
(defn pull [db : Db e : int] : (Vec Datum)
  (db-q db (q-entity e)))

;; history -- every datum for entity/attr, oldest first.  The log is
;; append-only and a datum's tx is its position in it, so a query already
;; returns datums in ascending tx order: no sort needed.
(defn history [db : Db entity : int attr : cstr] : (Vec Datum)
  (db-q db (q-ea entity attr)))

;; ============================================================
;; Retraction
;; ============================================================

;; db-retract! -- record a retraction fact for entity/attr.
;; Retraction is represented as a :db/retract fact whose value
;; is the attribute name being retracted (as a StrVal).
(defn db-retract! [db : Db entity : int attr : cstr] : int
  (db-assert! db entity ":db/retract" (StrVal attr)))

;; retracted? -- true if entity/attr has a :db/retract at or before as-of-tx
(defn retracted? [db : Db entity : int attr : cstr as-of-tx : int] : bool
  (let [^mut i 0
        ^mut found false]
    (while (< i (db-count db))
      (let [d (db-ref db i)]
        (when (and (= (.entity d) entity)
                   (cstr-eq? (.attr d) ":db/retract")
                   (<= (.tx d) as-of-tx)
                   (value-eq? (.value d) (StrVal attr)))
          (set! found true)))
      (set! i (+ i 1)))
    found))

;; ============================================================
;; Demo
;; ============================================================

(defn demo [] : nil
  (let [db (db-new)]

    ;; --- Alice: entity 1 ---
    (db-assert! db 1 ":user/name"  (StrVal "Alice"))
    (db-assert! db 1 ":user/email" (StrVal "alice@example.com"))
    (let [tx-age-1 (db-assert! db 1 ":user/age" (LongVal 30))]

      ;; --- Bob: entity 2 ---
      (db-assert! db 2 ":user/name"  (StrVal "Bob"))
      (db-assert! db 2 ":user/email" (StrVal "bob@example.com"))
      (db-assert! db 2 ":user/age"   (LongVal 25))

      ;; Later, Alice has a birthday -- assert new age
      (db-assert! db 1 ":user/age" (LongVal 31))

      ;; -- pull: all facts for Alice --
      (println "-- pull: all Alice facts --")
      (let [alice-facts (pull db 1)
            ^mut i 0]
        (while (< i (vec-len alice-facts))
          (let [d (vec-get alice-facts i)]
            (println (.attr d))
            (print-value (.value d)))
          (set! i (+ i 1)))
        (vec-free alice-facts))

      ;; -- as-of: snapshot before the birthday update --
      (println "-- as-of tx-age-1: Alice's age before birthday --")
      (let [snap (db-as-of db tx-age-1)
            ^mut i 0]
        (while (< i (vec-len snap))
          (let [d (vec-get snap i)]
            (when (and (= (.entity d) 1)
                       (cstr-eq? (.attr d) ":user/age"))
              (print-value (.value d))))
          (set! i (+ i 1)))
        (vec-free snap))

      ;; -- history: all tx for Alice's age --
      (println "-- history: Alice :user/age across all tx --")
      (let [hist (history db 1 ":user/age")
            ^mut i 0]
        (while (< i (vec-len hist))
          (let [d (vec-get hist i)]
            (println (.tx d))
            (print-value (.value d)))
          (set! i (+ i 1)))
        (vec-free hist))

      ;; -- retraction: remove Bob's email --
      (db-retract! db 2 ":user/email")
      (let [current-tx (db-count db)]
        (println "-- retracted? Bob :user/email --")
        (println (retracted? db 2 ":user/email" current-tx)))

      ;; -- q-av: find user with age = 31 --
      (println "-- q-av: entity with :user/age = 31 --")
      (let [results (db-q db (q-av ":user/age" (LongVal 31)))
            ^mut i 0]
        (while (< i (vec-len results))
          (println (.entity (vec-get results i)))
          (set! i (+ i 1)))
        (vec-free results))

      (vec-free db)
      nil)))

(defn main [] : int
  (demo)
  0)
