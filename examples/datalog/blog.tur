;; EAVT Database -- blog system example
;;
;; Demonstrates a realistic EAVT use case: a blog with users, posts,
;; and comments. Shows how to model relationships as EntityVal references,
;; query across entities, and print human-readable output.
;;
;; Typed Turmeric throughout, so all three engines run it:
;;
;;   ./build/tur run examples/datalog/blog.tur
;;   ./build/tur jit examples/datalog/blog.tur
;;   ./build/tur --interpret examples/datalog/blog.tur

(load "stdlib/cstr.tur")   ;; cstr-eq?: string equality by contents

;; ============================================================
;; Value ADT
;; ============================================================

(defdata Value :copy
  (LongVal :int)
  (StrVal :cstr)
  (EntityVal :int))

;; ============================================================
;; Datum
;; ============================================================

(defstruct Datum :copy
  [entity : int
   attr   : cstr
   value  : Value
   tx     : int])

;; ============================================================
;; Database
;; ============================================================

(defalias Db (Vec Datum))

(defn db-new [] : Db
  (vec-new))

(defn db-count [db : Db] : int
  (vec-len db))

(defn db-ref [db : Db i : int] : Datum
  (vec-get db i))

(defn db-assert! [db : Db entity : int attr : cstr value : Value] : int
  (let [tx (+ (db-count db) 1)]
    (vec-push! db (Datum entity attr value tx))
    tx))

;; ============================================================
;; Query
;; ============================================================

(defn db-q [db : Db pred : (fn [Datum] bool)] : (Vec Datum)
  (let [result (:: (vec-new) (Vec Datum))
        ^mut i 0]
    (while (< i (db-count db))
      (let [d (db-ref db i)]
        (when (pred d)
          (vec-push! result d)))
      (set! i (+ i 1)))
    result))

;; A datum whose attribute is `attr` and whose value refers to entity `e`
(defn q-ref [attr : cstr e : int] : (fn [Datum] bool)
  (fn [d : Datum] : bool
    (and (cstr-eq? (.attr d) attr)
         (match (.value d)
           (EntityVal x) (= x e)
           _             false))))

;; ============================================================
;; Attribute name constants
;; ============================================================

(def user/name   ":user/name")
(def user/email  ":user/email")
(def post/title  ":post/title")
(def post/body   ":post/body")
(def post/author ":post/author")
(def comment/body   ":comment/body")
(def comment/post   ":comment/post")
(def comment/author ":comment/author")

;; ============================================================
;; Blog data helpers
;; ============================================================

;; create-user -- assert name and email for a user entity
(defn create-user [db : Db entity : int name : cstr email : cstr] : nil
  (db-assert! db entity user/name  (StrVal name))
  (db-assert! db entity user/email (StrVal email))
  nil)

;; create-post -- assert title, body, and author for a post entity
(defn create-post [db : Db entity : int title : cstr body : cstr author-id : int] : nil
  (db-assert! db entity post/title  (StrVal title))
  (db-assert! db entity post/body   (StrVal body))
  (db-assert! db entity post/author (EntityVal author-id))
  nil)

;; create-comment -- assert body, post ref, and author for a comment entity
(defn create-comment [db : Db entity : int body : cstr post-id : int author-id : int] : nil
  (db-assert! db entity comment/body   (StrVal body))
  (db-assert! db entity comment/post   (EntityVal post-id))
  (db-assert! db entity comment/author (EntityVal author-id))
  nil)

;; ============================================================
;; Lookup helpers
;; ============================================================

;; get-attr-from -- the value of the first datum at or after log index i
;; for entity+attr, if there is one
(defn get-attr-from [db : Db entity : int attr : cstr i : int] : (Option Value)
  (if (>= i (db-count db))
    (none)
    (let [d (db-ref db i)]
      (if (and (= (.entity d) entity) (cstr-eq? (.attr d) attr))
        (some (.value d))
        (get-attr-from db entity attr (+ i 1))))))

;; get-attr -- the value of the first datum for entity+attr, if any
(defn get-attr [db : Db entity : int attr : cstr] : (Option Value)
  (get-attr-from db entity attr 0))

;; str-attr -- the string value of entity's attr, or "?" when it has none
(defn str-attr [db : Db entity : int attr : cstr] : cstr
  (match (get-attr db entity attr)
    (Some (StrVal s)) s
    _                 "?"))

;; ref-attr -- the entity entity's attr refers to, if it refers to one
(defn ref-attr [db : Db entity : int attr : cstr] : (Option int)
  (match (get-attr db entity attr)
    (Some (EntityVal e)) (some e)
    _                    (none)))

;; name-of -- the user/name of the entity entity's attr refers to
(defn name-of [db : Db entity : int attr : cstr] : cstr
  (match (ref-attr db entity attr)
    (Some user) (str-attr db user user/name)
    (None)      "?"))

;; get-posts-by-user -- the :post/author datums that refer to a given user
(defn get-posts-by-user [db : Db user-entity : int] : (Vec Datum)
  (db-q db (q-ref post/author user-entity)))

;; get-comments-on-post -- the :comment/post datums that refer to a given post
(defn get-comments-on-post [db : Db post-entity : int] : (Vec Datum)
  (db-q db (q-ref comment/post post-entity)))

;; ============================================================
;; Pretty-printing
;; ============================================================

;; print-user -- print user name and email
(defn print-user [db : Db entity : int] : nil
  (println (str-attr db entity user/name))
  (println (str-attr db entity user/email)))

;; print-blog-post -- print a post with its author and comments
(defn print-blog-post [db : Db post-entity : int] : nil
  (println "  Title:")
  (println (str-attr db post-entity post/title))
  (println "  Author:")
  (println (name-of db post-entity post/author))
  (println "  Body:")
  (println (str-attr db post-entity post/body))

  ;; Print each comment: its author's name, then its body
  (println "  Comments:")
  (let [comments (get-comments-on-post db post-entity)
        ^mut ci 0]
    (while (< ci (vec-len comments))
      (let [comment-entity (.entity (vec-get comments ci))]
        (println (name-of db comment-entity comment/author))
        (println (str-attr db comment-entity comment/body)))
      (set! ci (+ ci 1)))
    (vec-free comments))
  nil)

;; ============================================================
;; Demo
;; ============================================================

(defn demo [] : nil
  (let [db (db-new)]

    ;; Users: entity 1 = Alice, entity 2 = Bob
    (create-user db 1 "Alice" "alice@example.com")
    (create-user db 2 "Bob"   "bob@example.com")

    ;; Posts: entity 101 by Alice, entity 102 by Bob
    (create-post db 101 "Hello World" "My first post!" 1)
    (create-post db 102 "Turmeric Tips" "Use defdata for ADTs." 2)

    ;; Comments: entity 201 (Bob on post 101), entity 202 (Alice on post 101)
    (create-comment db 201 "Nice post!" 101 2)
    (create-comment db 202 "Thanks!" 101 1)

    ;; --- Print all posts with details ---
    (println "=== Blog Posts ===")

    (println "--- Post 101 ---")
    (print-blog-post db 101)

    (println "--- Post 102 ---")
    (print-blog-post db 102)

    ;; --- Get posts by Alice ---
    (println "=== Alice's Posts ===")
    (let [alice-post-datums (get-posts-by-user db 1)
          ^mut i 0]
      (while (< i (vec-len alice-post-datums))
        (println (.entity (vec-get alice-post-datums i)))
        (set! i (+ i 1)))
      (vec-free alice-post-datums))

    ;; --- Get comments on post 101 ---
    (println "=== Comments on Post 101 ===")
    (let [post-comments (get-comments-on-post db 101)
          ^mut i 0]
      (while (< i (vec-len post-comments))
        (println (str-attr db (.entity (vec-get post-comments i)) comment/body))
        (set! i (+ i 1)))
      (vec-free post-comments))

    (vec-free db)
    nil))

(defn main [] : int
  (demo)
  0)
