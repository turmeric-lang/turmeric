;; EAVT Database -- Datalog-style query layer
;;
;; Implements a minimal pattern-matching query engine inspired by Datalog.
;; Queries are expressed as sequences of Pattern clauses; each clause
;; narrows a set of "bindings" (variable -> value maps).
;;
;; Key concepts:
;;   Term     -- a query component: Var (bind), Lit (literal), Wild (skip)
;;   Pattern  -- a clause over (entity-term, attr-term, value-term)
;;   Binding  -- an assoc-list mapping variable names to Values
;;   datalog  -- run a list of clauses, return all surviving bindings
;;
;; Typed Turmeric throughout, so all three engines run it:
;;
;;   ./build/tur run examples/datalog/datalog.tur
;;   ./build/tur jit examples/datalog/datalog.tur
;;   ./build/tur --interpret examples/datalog/datalog.tur

(load "stdlib/cstr.tur")   ;; cstr-eq?: string equality by contents

;; ============================================================
;; Value ADT
;; ============================================================

(defdata Value :copy
  (LongVal :int)
  (StrVal :cstr)
  (EntityVal :int))

;; ============================================================
;; Datum
;; ============================================================

(defstruct Datum :copy
  [entity : int
   attr   : cstr
   value  : Value
   tx     : int])

;; ============================================================
;; Database
;; ============================================================

(defalias Db (Vec Datum))

(defn db-new [] : Db
  (vec-new))

(defn db-count [db : Db] : int
  (vec-len db))

(defn db-ref [db : Db i : int] : Datum
  (vec-get db i))

(defn db-assert! [db : Db entity : int attr : cstr value : Value] : int
  (let [tx (+ (db-count db) 1)]
    (vec-push! db (Datum entity attr value tx))
    tx))

;; ============================================================
;; Values
;; ============================================================

(defn value-eq? [a : Value b : Value] : bool
  (match a
    (LongVal x)   (match b (LongVal y)   (= x y)        _ false)
    (StrVal x)    (match b (StrVal y)    (cstr-eq? x y) _ false)
    (EntityVal x) (match b (EntityVal y) (= x y)        _ false)))

;; ============================================================
;; Term ADT
;;
;; A Term represents one component of a pattern clause:
;;   Var  -- a variable name; will be bound if free
;;   Lit  -- a literal Value to match against
;;   Wild -- matches anything; binds nothing
;; ============================================================

(defdata Term :copy
  (Var :cstr)
  (Lit :Value)
  (Wild))

;; ============================================================
;; Binding -- an assoc list of (variable name, value) pairs
;;
;; Extending a binding conses a new pair onto it, so the bindings a
;; query forks from one parent share that parent as their tail.  That
;; sharing is why Binding is `:copy` -- a tail has many owners -- and
;; why its cells are never freed one by one: no single owner could.
;; For a long-running query loop, wrap each query in `with-region`,
;; which reclaims them in one step.
;; ============================================================

(defdata Binding :copy
  (Empty)
  (Bound :cstr :Value :Binding))

;; bind-get -- the value var is bound to in binding, if it is bound
(defn bind-get [binding : Binding var : cstr] : (Option Value)
  (match binding
    (Empty)                (none)
    (Bound name val rest)  (if (cstr-eq? name var)
                             (some val)
                             (bind-get rest var))))

;; ============================================================
;; Term matching and extension
;; ============================================================

;; term-matches? -- check whether a term is consistent with a datum component.
;; If the term is a Var that is already bound, the bound value must equal val.
;; Unbound Vars and Wild always match.
(defn term-matches? [term : Term val : Value binding : Binding] : bool
  (match term
    (Wild)     true
    (Lit v)    (value-eq? v val)
    (Var name) (match (bind-get binding name)
                 (Some existing) (value-eq? existing val)
                 (None)          true)))

;; term-extend -- if term is an unbound Var, add (var -> val) to binding.
;; Returns the updated binding (or the same binding if nothing was added).
(defn term-extend [term : Term val : Value binding : Binding] : Binding
  (match term
    (Wild)     binding
    (Lit _)    binding
    (Var name) (match (bind-get binding name)
                 (Some _) binding
                 (None)   (Bound name val binding))))

;; ============================================================
;; Pattern clause: (entity-term, attr-term, value-term)
;; ============================================================

(defstruct Pattern :copy
  [e : Term
   a : Term
   v : Term])

;; ============================================================
;; match-one-datum
;;
;; Try to extend binding by unifying a datum with a pattern.
;; Returns the extended binding on success, or None.
;; ============================================================

(defn match-one-datum [datum : Datum pat : Pattern binding : Binding] : (Option Binding)
  ;; Wrap entity and attr as Values for uniform handling
  (let [e-val (EntityVal (.entity datum))
        a-val (StrVal (.attr datum))
        v-val (.value datum)]
    (if (and (term-matches? (.e pat) e-val binding)
             (term-matches? (.a pat) a-val binding)
             (term-matches? (.v pat) v-val binding))
      (some (term-extend (.v pat) v-val
              (term-extend (.a pat) a-val
                (term-extend (.e pat) e-val binding))))
      (none))))

;; ============================================================
;; match-pattern
;;
;; Expand a set of bindings by matching each datum against pat.
;; For each (binding, datum) pair where unification succeeds,
;; the extended binding is added to the result set.
;; ============================================================

(defn match-pattern [db : Db pat : Pattern bindings : (Vec Binding)] : (Vec Binding)
  (let [result (:: (vec-new) (Vec Binding))
        ^mut bi 0]
    (while (< bi (vec-len bindings))
      (let [b (vec-get bindings bi)
            ^mut di 0]
        (while (< di (db-count db))
          (match (match-one-datum (db-ref db di) pat b)
            (Some b2) (vec-push! result b2)
            (None)    nil)
          (set! di (+ di 1))))
      (set! bi (+ bi 1)))
    result))

;; ============================================================
;; datalog -- run all clauses, return final bindings
;;
;; Starts with one empty binding, then refines it through each clause.
;; Each step's binding set is freed once the next one is built.
;; ============================================================

(defn datalog [db : Db clauses : (Vec Pattern)] : (Vec Binding)
  (let [initial (:: (vec-new) (Vec Binding))]
    (vec-push! initial (Empty))
    (let [^mut bindings initial
          ^mut ci 0]
      (while (< ci (vec-len clauses))
        (let [next (match-pattern db (vec-get clauses ci) bindings)]
          (vec-free bindings)
          (set! bindings next))
        (set! ci (+ ci 1)))
      bindings)))

;; ============================================================
;; Demo output helper
;; ============================================================

;; print-str-var -- print the string var-name is bound to in each binding
(defn print-str-var [results : (Vec Binding) var-name : cstr] : nil
  (let [^mut i 0]
    (while (< i (vec-len results))
      (match (bind-get (vec-get results i) var-name)
        (Some v) (match v
                   (StrVal s) (println s)
                   _          nil)
        (None)   nil)
      (set! i (+ i 1)))))

;; ============================================================
;; Demo
;; ============================================================

(defn demo [] : nil
  (let [db (db-new)]

    ;; --- Build a small user/post database ---
    ;; Users
    (db-assert! db 1 ":user/name" (StrVal "Alice"))
    (db-assert! db 2 ":user/name" (StrVal "Bob"))

    ;; Posts (entity=3 by Alice, entity=4 by Bob)
    (db-assert! db 3 ":post/title"  (StrVal "Hello from Alice"))
    (db-assert! db 3 ":post/author" (EntityVal 1))

    (db-assert! db 4 ":post/title"  (StrVal "Bob's Guide"))
    (db-assert! db 4 ":post/author" (EntityVal 2))

    ;; --- Query 1: find all user names ---
    ;; Pattern: [?e :user/name ?name]
    (println "-- All user names --")
    (let [clauses1 (vec-of (Pattern (Var "?e")
                                    (Lit (StrVal ":user/name"))
                                    (Var "?name")))
          results1 (datalog db clauses1)]
      (print-str-var results1 "?name")
      (vec-free results1)
      (vec-free clauses1))

    ;; --- Query 2: find posts by Alice (two-clause join) ---
    ;; Clause 1: [?alice :user/name "Alice"]  -- bind ?alice to Alice's entity
    ;; Clause 2: [?post :post/author ?alice]  -- find posts where author = ?alice
    ;; Clause 3: [?post :post/title ?title]   -- pull the title
    (println "-- Posts by Alice (Datalog join) --")
    (let [clauses2 (vec-of (Pattern (Var "?alice")
                                    (Lit (StrVal ":user/name"))
                                    (Lit (StrVal "Alice")))
                           (Pattern (Var "?post")
                                    (Lit (StrVal ":post/author"))
                                    (Var "?alice"))
                           (Pattern (Var "?post")
                                    (Lit (StrVal ":post/title"))
                                    (Var "?title")))
          results2 (datalog db clauses2)]
      (print-str-var results2 "?title")
      (vec-free results2)
      (vec-free clauses2))

    (vec-free db)
    nil))

(defn main [] : int
  (demo)
  0)
