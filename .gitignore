*.dSYM/
*.o
*.d

# Generated C/H output from `tur build` / `tur emit-c`.
# Negative patterns keep genuine hand-written sources tracked.
*.c
*.h
!src/**/*.c
!src/**/*.h
!tests/**/*.c
!tests/**/*.h
!examples/**/*.c
!examples/**/*.h
!docs/**/*.c
!docs/**/*.h
!tools/**/*.c
!tools/**/*.h
# benchmarks/ carries hand-written C harnesses too.  Without these two lines the
# blanket *.c above silently swallows them: benchmarks/adt-alloc/ceiling.c was
# lost exactly that way in 00052f16 -- the commit that published its numbers
# landed with only the README, and nobody could re-run the measurement until it
# was reconstructed.  The four older harnesses under benchmarks/ survive only
# because someone force-added them past this rule.
!benchmarks/*.c
!benchmarks/**/*.c
!benchmarks/*.h
!benchmarks/**/*.h
# The vendored MIR sources the JIT engine compiles (tools/update-mir.sh,
# external/mir/VENDORED.md).  Without these the blanket *.c / *.h above would
# swallow the whole copy, and a fresh clone would fail to configure with the
# default TUR_JIT=ON.  tools/update-mir.sh fails if any file it copies is
# still ignored.
!external/mir/**/*.c
!external/mir/**/*.h

# Python bytecode
__pycache__/
*.pyc

tests/out/
tests/fixtures/**/actual.*
# Generated test/benchmark artifacts written in-place by the harnesses
# (run-cli.sh writes actual.* next to its fixtures; run-bench.sh compiles
# benchmarks into tests/benchmarks/output/).
tests/cli/**/actual.*
tests/benchmarks/output/
# Build caches/artifacts left when a dedicated runner builds a fixture
# in-place (e.g. run-build-shared.sh). `tur` also auto-writes a .gitignore
# with .tur-abi-cache/ inside built dirs; ignore both so test runs stay clean.
.tur-abi-cache/
tests/fixtures/**/.gitignore
tests/.stamp-cache/
tests/.stamp-cache-doctest/
tests/.stamp-cache-turi/
tests/.stamp-cache-jit/
tests/doctest-generated/
/tmp/tur-build/
# Stray binaries from ad-hoc builds in the repo ROOT.  Anchored with a leading
# slash: unanchored, each of these matches a path component of that name at ANY
# depth, so `hello` silently ignored the whole tests/fixtures/hello/ directory
# and its input.tur could never be committed -- which is how that fixture came
# to have a tracked expected.stdout and nothing to produce it.  See
# docs/archive/fixture-dirs-with-loose-tur-files-pass-without-running.md.
/tur
/hello
/debug_iter
/hamt-bench-insert
/input
/hash_map
/primes
/sort

# Test/build output files
actual_test.stderr
build_stderr.txt

# Generated docs HTML (source markdown stays in docs/guides/ and stdlib/)
docs/html/
docs/api/

# Web
web/node_modules/
# Without the slash too: the trailing-slash form matches directories
# only, so a `node_modules` SYMLINK (handy for running the web tests
# from a worktree) sails past it and lands in a commit.
web/node_modules
web/dist/
web/test-results/
web/.vite/
web/.wrangler/

# WASM build outputs. `tur_wasm` copies these out of build-wasm/ into
# web/public/ (src/CMakeLists.txt), where vite picks them up as static assets.
# They are build products, not source: tracking them forced a second
# "regenerate web artifacts" commit after every deploy and left each release
# tag carrying the *previous* release's binary. Run `just wasm` (or
# `tur run wasm`) to produce them; `just web` / `just deploy-web` do it for you.
web/public/turmeric.js
web/public/turmeric.wasm

# Doc-name index behind the web REPL's doc panel, emitted by `just docs`
# (tools/gendocs.py --emit-json). Same story as the wasm pair above: tracking
# it meant every release tag either carried a stale index -- v0.32.3 nearly
# shipped without a single `rat/*` or `complex/*` entry -- or dirtied the tree
# mid-deploy. It also merges spice entries from the *optional* sibling
# ../turmeric-spices/ checkout, so a contributor who has that clone and one
# who does not could never agree on its contents. Note this is unlike
# stdlib/docstrings.tur, gendocs' other emitted output, which stays tracked
# because it is a real source module the compiler imports.
web/public/doc-names.json

# The docs pack (OD1): chrome-free guide/API/spice fragments plus index.json,
# emitted by `just docs` from the same generators that build docs/html/. Try
# Turmeric renders it in its in-app docs pane and its service worker precaches
# it wholesale for offline use. Gitignored for the same reasons as
# doc-names.json above: it is a build output, it is large, and its spices
# section depends on the optional sibling ../turmeric-spices/ checkout.
web/public/docs-pack/

# Release docs bundle from `just docs-tarball` (OD4).
turmeric-docs-*.tar.gz

# Local Playwright config override (e.g. pointing launchOptions.executablePath
# at a sandbox's prebuilt Chromium when `npx playwright install` is not an
# option). Developer-local; the committed playwright.config.js is the contract.
web/pw.local.config.js

# Playwright MCP browser session artifacts
.playwright-mcp/

# clangd LSP index (machine-specific, regenerated automatically)
.cache/

