tests/fixtures/*/turi.stdout
tests/fixtures/*/turi.stderr
tests/fixtures/*/jit.stdout
tests/fixtures/*/jit.stderr
# Nested fixtures (errors/<name>, typed/<name>, typed-slots/<name>, ...).
tests/fixtures/*/*/turi.stdout
tests/fixtures/*/*/turi.stderr
tests/fixtures/*/*/jit.stdout
tests/fixtures/*/*/jit.stderr

# REPL-compiled spice shared libraries and their symbol manifests.
*.so
*.so.manifest

# Claude Code agent worktrees (transient, harness-managed)
.claude/worktrees/

# Claude Code per-machine state. Untracked deliberately (security audit C-8):
# settings.local.json carries a machine's own absolute paths and its
# pre-approved command allowlist, which should not be inherited by anyone who
# clones this repo; memory/ is per-session notes, not project documentation.
.claude/settings.local.json
.claude/projects/

# Maintainer scratchpad, not project documentation.
TEMP.md


# J3 benchmark triangle artifacts (run-triangle.sh output dir).
benchmarks/output/
build-mirpin/
build-lazyrel/
build-jitrel/
build-i4/

# CTest output captured at the repo root.  jit-ctest.log -- 86 KB of raw ctest
# output from a local macOS build tree -- was committed by accident in
# 0ee40e7a ("ci: publish the JIT corpus counts on a passing run"), which meant
# to publish the counts, not the log.  The pattern keeps the next one out.
/*-ctest.log
/ctest.log

# CTest's own scratch directory, created by a bare `ctest` at the repo root
# (everything here runs `ctest --test-dir build`, which writes build/Testing/
# instead).  Testing/Temporary/{LastTest.log,CTestCostData.txt} were committed
# by accident in #728 -- both stubs from a run that executed no tests.
/Testing/
build-clang/
