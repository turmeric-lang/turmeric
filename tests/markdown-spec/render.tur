;; tests/markdown-spec/render.tur -- tur/markdown's HTML for every
;; document in a bundle, for tests/markdown-spec/diff.py to compare with
;; commonmark.js's (oracle/render.js).
;;
;; Usage: render --in=BUNDLE
;;
;; BUNDLE holds the documents, each followed by one byte 0x1E (record
;; separator).  The output is each document's HTML followed by 0x1E, then a
;; line feed.  Plain CommonMark: no extensions, and raw HTML passed through.
(load "stdlib/markdown.tur")

(load "stdlib/fs-string.tur")

(load "stdlib/args.tur")

(defn render-all [src : String] : String
  (let [sep    (string/from-cstr "\x1e")
        docs   (string/split src sep)
        out    (builder/new)
        ^mut i 0]
    (do
      ;; The bundle ends with a separator, so the last piece is empty.
      (while (< i (- (vec-len docs) 1))
        (let [d (markdown/parse (vec-get docs i) (markdown/commonmark-opts))
              h (markdown/render-html d (MdHtmlOpts (MdRawPass)))]
          (do
            (builder/push-string! out h)
            (builder/push-byte! out 30)
            (string/release h)
            (markdown/doc-free d)
            (set! i (+ i 1)))))
      (string/release-all docs)
      (string/release sep)
      (builder/finish out))))

(defn render-file [path : cstr] : int
  (match (fs/read-string path)
    (Ok src)
    (let [html (render-all src)]
      (do
        (println (string/to-cstr html))
        (string/release html)
        (string/release src)
        0))
    (Err e)
    (do (println "render: cannot read the bundle") 2)))

(defn main [] : int
  (let [spec (args/spec-option (args/spec-new) "--in" "string" (none))
        res  (args/parse spec *args*)
        rc   (if (args/error? res)
               (do (println (args/error-msg res)) 2)
               (render-file (args/get-str res "in")))]
    (do (args/result-free res) (args/spec-free spec) rc)))
