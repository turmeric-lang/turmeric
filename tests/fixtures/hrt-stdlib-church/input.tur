; Phase HRT5: Church-numeral-inspired apply-n pattern.
; (church-apply f n x) applies the polymorphic function f to x exactly n times.
; This demonstrates rank-2 poly fn parameters in recursive functions, enabled by
; the HRT5 fix to forward-declare bindings with correct arity before body elaboration.
(defn church-apply [f (forall [a] (-> a a)) n : int x : int] : int
  (if (<= n 0)
    x
    (church-apply f (- n 1) (f x))))

(defn inc [x : int] : int (+ x 1))
(defn double-it [x : int] : int (* x 2))

; The functions passed to the rank-2 parameters below are not generic, so
; each is ascribed to the parameter's forall type -- the trusted opt-out of
; rank2-argument-genericity, which asserts what the checker cannot see.
(defn main [] : int
  ; apply inc 3 times to 0: 0+3 = 3
  (println (church-apply (:: inc (forall [a] (-> a a))) 3 0))
  ; apply double-it 4 times to 1: 1*2^4 = 16
  (println (church-apply (:: double-it (forall [a] (-> a a))) 4 1))
  0)
