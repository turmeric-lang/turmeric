;; reflected-measures RF2: a `^reflect` function whose match is over LITERALS
;; with no trailing `_` or variable arm.  The reflection walk once had to demand
;; that arm itself (TUR-E0384, "coverage gate") because the elaborator did not
;; check a literal match; since control-forms-gaps item 5 it does, and refuses
;; the program first.  The sibling positive reflect-literal-default adds the `_`
;; arm and passes.
(defn ^reflect code [n : int] : int
  (match n
    1 10
    2 20))

(defn main [] : int (println (code 1)) 0)
