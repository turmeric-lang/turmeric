; Phase EXG6-2: opening a `:linear` existential twice is a use-after-
; consume; the second open's EX_VAR lookup must trip LT1's
; TUR_E0101 diagnostic under -Xlinear.
(defclass Show [a]
  (show [x] : cstr))

(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(defn main [] : int
  (let [e (pack 7 (exists ^linear [a] [(Show a)] a))]
    (open e [_ v] (println (.show v)))
    (open e [_ v] (println (.show v))))
  0)
