; Phase SZ1: Size arithmetic type checking -- type error on wrong argument kind.
; Passing a plain integer where a Size is expected is a compile-time error.
; This demonstrates that size operations are well-typed: Add only accepts Size.

(defdata Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defn size-eval [s : Size] : int
  (match s
    (Static n)   n
    (Add s1 s2)  (+ (size-eval s1) (size-eval s2))
    (Mul s1 s2)  (* (size-eval s1) (size-eval s2))))

(defn size-add [s1 : Size s2 : Size] : Size (Add s1 s2))

(defn main [] : int
  ; Passing plain ints instead of Size values -- compile-time type error.
  (println (size-eval (size-add 3 4)))
  0)
