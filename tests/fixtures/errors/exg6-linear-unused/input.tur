; Phase EXG6-2: a `:linear` existential binding that is never opened
; is a dropped linear value -- LT1 must reject it under -Xlinear.
(defclass Show [a]
  (show [x] : cstr))

(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(defn main [] : int
  (let [e (pack 7 (exists ^linear [a] [(Show a)] a))]
    (println "never opened"))
  0)
