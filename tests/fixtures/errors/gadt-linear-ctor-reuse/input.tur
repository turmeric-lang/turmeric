; adt-gadt-unification slice 2: `:linear` on a type with annotated constructors
; is enforced -- a second use of the token is TUR-E0101.
(defdata Tok [a] :linear
  (ITok int : (Tok int)))

(defn spend [t : (Tok int)] : int
  (match t (ITok n) n))

(defn main [] : int
  (let [t (ITok 5)]
    (println (spend t))
    (println (spend t)))
  0)
