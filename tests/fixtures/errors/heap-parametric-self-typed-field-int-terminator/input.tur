;; self-typed-heap-parametric-field-unsupported (1): a bare `0` is not a
;; `(Node A)`.  The diagnostic used to print `expected int, got int` -- the
;; erased carrier spelling of the field's `:heap` app on one side and a real
;; int on the other.  It now names the field's full type.  The typed
;; terminator is `(:: 0 (Node int))`.
(defstruct ^heap Node [A] (val A) (next (Node A)))
(defn main [] : int
  (let [n (make-struct Node 8 0)]
    (println (.val n)))
  0)
