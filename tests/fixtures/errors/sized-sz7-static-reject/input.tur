; Phase SZ7: static size checking -- reject unequal constant sizes.
;
; size-assert-eq! on two statically-known, unequal sizes is a compile-time
; error (TUR-E0260), not a runtime panic. No runtime check is emitted.

(defdata Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defn size-static [n : int] : Size (Static n))
(defn size-add [s1 : Size s2 : Size] : Size (Add s1 s2))

(defn size-eval [s : Size] : int
  (match s
    (Static n)  n
    (Add a b)   (+ (size-eval a) (size-eval b))
    (Mul a b)   (* (size-eval a) (size-eval b))))

(defn size-assert-eq! [s1 : Size s2 : Size] : nil
  (require-msg! (= (size-eval s1) (size-eval s2))
    "sized type mismatch: sizes are not equal"))

(defn main [] : int
  ; ERROR: 4 and 5 are statically known and unequal -> TUR-E0260
  (size-assert-eq! (size-static 4) (size-static 5))
  0)
