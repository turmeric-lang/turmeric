; Sum-types plan T8.4: a non-exhaustive match on Either is a hard error by
; default (the design keeps exhaustiveness as an error; ^non-exhaustive is the
; explicit opt-out -- see sum-either-nonexhaustive-opt-out).
(defdata Either :copy [L R]
  (Left L)
  (Right R))

(defn only-right [e : int] : int
  (match e
    (Right r) r))

(defn main [] : int
  (println (only-right (Right 1)))
  0)
