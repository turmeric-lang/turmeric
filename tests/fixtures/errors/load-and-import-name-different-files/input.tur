;; defmodule-file-loaded-and-imported-defined-twice: a load defines module
;; lib/m from one file and the import of lib/m resolves to another.  One
;; program cannot hold two modules of one name, so the import is refused
;; where it is written instead of reaching cc as a redefinition.
(load "tests/fixtures/errors/load-and-import-name-different-files/vendor/m.tur")
(defmodule prog
  (import lib/m :refer [twice])
  (defn main [] : int
    (println (twice 21))
    0))
