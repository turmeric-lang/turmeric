;; caret-type-attributes-plan P4: `(exists :linear ...)` is no longer accepted
;; (TUR-E0717); write `(exists ^linear ...)` (see caret-exists-linear).
(defclass Show [a]
  (show [x] : cstr))

(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(defn main [] : int
  (let [e (pack 7 (exists :linear [a] [(Show a)] a))]
    (open e [_ v]
      (println (.show v))))
  0)
