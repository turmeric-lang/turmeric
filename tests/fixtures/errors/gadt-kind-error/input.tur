; Phase G1/HKT: Test that using a kind-* -> * type constructor as a bare
; symbol in a GADT constructor return-type argument slot emits TUR-E0012.
;
; Twin has one type parameter so its kind is * -> *.
; Bad has zero type parameters so its sole argument slot expects kind *.
; Passing Twin (kind * -> *) in that slot is a kind mismatch.
; (Not `Pair`: that names the auto-loaded stdlib struct, and redefining a
; stdlib type is its own error.)

(defdata Twin [a]
  (MkTwin a : (Twin a)))

(defdata Bad []
  (MkBad : (Bad Twin)))

(defn main [] : int 0)
