;; structdef-retirement slice 4: a `:linear` defstruct now lowers to a record ADT,
;; but its exactly-once (CK_LINEAR) discipline must be preserved -- using the value
;; a second time, after it has been consumed, is a hard error (TUR-E0101).  This
;; locks in that the lowering does not silently drop linearity enforcement.
(defstruct ^linear Handle [ptr : ptr<void>])

(defn eat-handle [h : Handle] : int
  ```c (void)h; return 1; ```)

(defn main [] : int
  (let [h (make-struct Handle 0)]
    (eat-handle h)
    (eat-handle h)   ;; second use of a consumed linear value -- rejected
    0))
