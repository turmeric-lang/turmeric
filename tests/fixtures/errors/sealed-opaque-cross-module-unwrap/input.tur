;; sealed-opaque: unwrapping a :sealed opaque to its representation from
;; OUTSIDE the declaring module is TUR-E0302.
;;
;; This is the half of the seal that makes the representation genuinely private
;; rather than merely hard to rebuild: once the raw carrier escapes, inline-C
;; anywhere can do what it likes with it. See docs/upcoming/sealed-opaque-plan.md
;; ("why both directions") and the motivating report
;; docs/archive/frozen-region-aliasing-via-coercing-cast.md.
(defmodule main
  (import sealedlib/world :refer [W w-new])
  (defn main [] : int
    (let [w (w-new)
          n (:: w :int)]        ;; TUR-E0302: cannot unwrap sealed 'W'
      (println n))
    0))
