;; caret-type-attributes-plan P5: the earlier spellings of these attributes are
;; an error (TUR-E0718) -- a defeffect's trailing ^extends / ^capability and a
;; defn's #[no-unwind] / #[used] / (export-as "c").  Each is reported once and
;; applied anyway, so the declarations still elaborate and nothing cascades.
(defeffect Disk [] : nil ^capability)
(defeffect Write [s : cstr] : nil ^extends Disk)
(defn #[no-unwind] #[used] first [x : int] : int {x + 1})
(defn (export-as "attrs_second") second [x : int] : int {x * 2})

(defn main [] : int
  (println (first 1))
  0)
