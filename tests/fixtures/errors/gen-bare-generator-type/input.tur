;;; generator-type-plan: the bare `generator` names no element, so nothing
;;; could read what the generator yields.  It used to become an implicit type
;;; variable and fail later at gen-next; it is an error at the annotation now.
(defn take1 [g : generator] : int (gen-unwrap (gen-next g)))

(defn main [] : int
  (println (take1 (gen [] (yield 1))))
  0)
