;; The right operand of `and` runs only when the left one is true, so a ref
;; it hands on is handed on along one path only.  This was accepted, and the
;; cell leaked when the operand was skipped.
(defn sink [r : ref<int>] : int
  (let [v @r]
    (drop! r)
    v))

(defn f [c : bool] : int
  (let [r (ref 41)]
    (and c (= 41 (sink r)))
    1))

(defn main [] : int
  (println (f false))
  0)
