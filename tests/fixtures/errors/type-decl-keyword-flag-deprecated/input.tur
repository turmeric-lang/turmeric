;; caret-type-attributes-plan P3: a flag written as a keyword after the name
;; (`:copy`) is deprecated (TUR-D0007) -- the flags are `^attr`s before it.  It
;; still compiles, with a warning; under --Werror=deprecated (flags) it is an
;; error, which is what this fixture pins.  Each form warns once, naming every
;; flag it spells the old way.
(defstruct Point :copy :heap [x : int y : int])
(defopaque Chan :ptr<void> :linear :sealed)
(defdata Shape :copy (Circle int) (Square int))

(defn main [] : int
  (println (.x (Point 1 2)))
  0)
