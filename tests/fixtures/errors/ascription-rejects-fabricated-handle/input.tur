;; The reverse of ascription-rejects-owning-erasure: an ordinary integer
;; ascribed TO a reference-counted type.
;;
;; One exception is allowed, and only one -- the literal 0, a null handle.  That
;; is how stdlib/rcchain.tur writes an empty chain, which keeps that module free
;; of inline-C entirely.
;;
;; Any other integer is a control-block pointer conjured out of arithmetic: the
;; first rc/clone or scope-exit drop through it writes to whatever that address
;; happens to be.
(defstruct ^move S [tag : int])

(defn main [] : int
  (println (rc/strong-count (:: 12345 rc<S>)))
  0)
