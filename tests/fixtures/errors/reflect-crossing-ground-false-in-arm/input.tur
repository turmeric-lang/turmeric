;; reflect-two-provable-facts-report-as-not-holding, half 2's guard: the
;; constructor facts are uninterpreted symbols, and refine_model_search
;; declines a VC carrying one -- so adding them to EVERY crossing in an arm
;; would turn this refutation (a ground, false argument) into an unknown.  They
;; are added only where the arm connects to a name the argument mentions; a
;; ground argument mentions none, so this stays TUR-E0371.
(defdata Lst [] (Cons [hd : int tl : Lst]) (Nil))

(defn ^reflect sorted? [xs : Lst] : bool
  (match xs
    (Nil) true
    (Cons h t) (match t
                 (Nil) true
                 (Cons h2 _) (and (<= h h2) (sorted? t)))))

(defn needs-sorted [ys : #refine{ v : Lst | (sorted? v) }] : int 1)

(defn false-in-arm [xs : Lst] : int
  (match xs
    (Nil) 0
    (Cons h t) (needs-sorted (Cons 2 (Cons 1 (Nil))))))

(defn main [] : int 0)
