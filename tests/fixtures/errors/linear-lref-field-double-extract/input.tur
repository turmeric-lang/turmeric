;; LT1/T3: Extracting an lref<T> field twice from the same :move struct.
;;
;; The first (.val b) transfers linear ownership of the lref<int> field out
;; of the struct, marking b as moved.  The second (.val b) is a use-after-move.
;;
;; Expected error: TUR-E0005 (use of moved value 'b')
(defstruct ^move Box [val : lref<int>])
(let [b (make-struct Box (lref/new 42))]
  (let [x (.val b)]
    (let [y (.val b)]
      (println (deref x)))))
