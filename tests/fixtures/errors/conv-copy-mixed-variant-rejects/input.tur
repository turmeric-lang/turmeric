;; CONV-S5 (struct/ADT convergence): a :copy ADT requires every variant's
;; payload to be copy-compatible.  Variant 'B' carries an `rc<int>` (a
;; move-only, refcounted ownership field), so the :copy annotation is rejected
;; with a diagnostic that pinpoints both the offending field and its variant.
(defdata ^copy Mixed
  (A [x : int])
  (B [o : rc<int>]))

(defn main [] : int 0)
