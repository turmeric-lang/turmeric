;; A class method parameter WITHOUT ^borrow still spends an affine argument:
;; calling it twice on one array is TUR-E0150 (class-method-borrow-param).
(load "stdlib/numvec.tur")
(defclass NA [v]
  (na-len [^borrow a : v] : int)
  (na-take [a : v] : int))
(definstance NA [F64Vec]
  (na-len [a] (f64vec-len a))
  (na-take [a] (let [n (f64vec-len a)] (f64vec-free a) n)))
(defn main [] : int
  (let [a (f64vec-new 3 1.25)]
    (println (na-take a))
    (println (na-take a))
    0))
