;; typed-ptr-pointee-not-checked-at-calls: a `ptr<Foo>` parameter accepted a
;; `ptr<Bar>` argument, so a typed pointer gave no more protection than
;; `ptr<void>`.  The pointee is compared now.
(defstruct Foo [a : int])
(defstruct Bar [b : int])
(defn mk-bar [] : ptr<Bar>
  ```c
  return 0;
  ```)
(defn f [x : ptr<Foo>] : int 0)
(defn main [] : int
  (println (f (mk-bar)))
  0)
