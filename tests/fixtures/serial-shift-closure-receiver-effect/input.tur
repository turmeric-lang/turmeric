;; serial-receiver-effect-under-if-closure-or-leaf (shape 2): a CAPTURING
;; closure receiver an effect escapes.
;;
;; A named receiver is called outward through its `__cps` twin; a capturing
;; lambda's twin takes its env first and existed only for lambdas in the
;; threadable set, so this shape was refused (TUR-E0706).  A closure used as
;; a serial-shift receiver is a threading use now (tier `now`: the call is a
;; tail call on the reset's continuation), its twin is registered, and the
;; outward call hands it the closure value as its env.  Every line matches
;; `tur --interpret`.
;;
;;   run 100       -- one int capture, resumes k: (100+(41+1))+1  = 143
;;   run-skip 5 hi -- int and cstr captures, never resumes k; its
;;                    value feeds the rest: (5+10)*2               = 30
;;   run-if true 7 -- under an `if` too (shapes 1 and 2): (7+42)+1 = 50
;;   run-if false 7 -- the pure arm                                = -7
;;   run 1         -- the handler keeps working after resuming:
;;                    100+((1+(1+1))+1)                            = 104

(load "stdlib/serial.tur")
(defeffect Ask [] :int)
(defeffect Tell [msg : cstr] :int)
(defn page [env : cstr hole : int] : int (+ hole 1))
(defn asks [] : int (+ (perform (Ask)) 1))

;; one capture, resumes k
(defn run [m : int] : int
  (serial-reset (page "" (serial-shift (fn [k : serial-cont] : int
                                          (k (+ m (asks)))) 0))))

;; two captures (int and cstr), never resumes k, and the reset's value
;; feeds the rest of the function
(defn run-skip [m : int tag : cstr] : int
  (let [x (serial-reset (+ 1000 (serial-shift (fn [k : serial-cont] : int
                                                 (+ m (perform (Tell tag)))) 0)))]
    (* x 2)))

;; a capturing receiver under an `if` (shapes 1 and 2 together)
(defn run-if [c : bool m : int] : int
  (serial-reset (if c (page "" (serial-shift (fn [k : serial-cont] : int
                                                (k (+ m (asks)))) 0))
                    (- 0 m))))

(defn main [] : int
  (println (handle (run 100) (Ask [] r) (resume r 41)))
  (println (handle (run-skip 5 "hi") (Tell [msg] r) (resume r 10)))
  (println (handle (run-if true 7) (Ask [] r) (resume r 41)))
  (println (handle (run-if false 7) (Ask [] r) (resume r 41)))
  (println (handle (run 1) (Ask [] r) (+ 100 (resume r 1))))
  0)
