;; declared-tyvars-are-not-rigid, the other half: what the rigid-variable check
;; must keep accepting.  A generic relaying its argument through another
;; generic (the callee's letters are substituted at the call), a two-variable
;; relay, a diverging body, a constructor whose slot the declared return fills,
;; a bare-ADT body under an applied return (stdlib `some`'s own shape), a
;; swapped pair put back in order, a callee's result variable no argument
;; binds (`(vec-new)` is `(Vec A)` in `mk`, nobody's declared variable there,
;; and the same `A` under a `[A B]` signature is renamed apart), and an
;; `#{Unsafe}` generic returning an int handle as `A` -- the carrier bridge
;; that stays deliberate.
(defn id [A] [x : A] : A x)
(defn mk [T] [] : (Vec T) (vec-new))
(defn mk2 [A B] [a : A] : (Vec B) (vec-new))
(defn raw [h : int] #fx{Unsafe} : int
  ```c
  return h;
  ```)
;; A generic callee's own variable is an instantiation, whatever its letter;
;; a diverging arm and a `(none)` arm join with anything; a parametric
;; constructor's field is the variable itself; and a SELF-CALL is typed by the
;; written `: A`, not the pass-1 int carrier it used to read.
(defn id2 [T] [x : T] : T x)
(defn relay3 [A] [a : A] : A (id2 a))
(defn pick [A] [a : A c : bool] : A (if c a (panic "no")))
(defn opt2 [A] [a : A c : bool] : (Option A) (if c (some a) (none)))
(defdata Bx :copy [X] (Mk X))
(defn boxed [A] [a : A] : (Bx A) (Mk a))
(defn go5 [A] [n : int a : A] : A (if (= n 0) a (go5 (- n 1) a)))
(defn relay [X] [x : X] : X (id x))
(defn relay2 [X Y] [x : X y : Y] : Y (id y))
(defn boom [A] [a : A] : A (panic "no"))
(defn empty [A] [a : A] : (Option A) (none))
(defn wrap [A] [a : A] : (Option A) (some a))
(defn sw [A B] [a : A b : B] : (Pair B A) (pair b a))
(defn handle-as [A] [h : int] #fx{Unsafe} : A (raw h))
(defn main [] : int
  (println (relay 7))
  (println (relay2 1 "y"))
  (println (unwrap-or (empty 3) 9))
  (println (unwrap (wrap 7.1)))
  (println (pair-fst (sw 1 "x")))
  (println (vec-len (:: (mk) (Vec int))))
  (println (vec-len (:: (mk2 1) (Vec cstr))))
  (println (:: (unsafe (handle-as 42)) :int))
  (println (relay3 3))
  (println (pick 7.1 true))
  (println (unwrap-or (opt2 4 true) 0))
  (match (boxed 5) (Mk v) (println v))
  (println (go5 3 7.1))
  (println (go5 2 "s"))
  0)
