;; bare-parametric-instance-ctor-arg-unbridged: an instance on the bare
;; parametric `:heap` type `Rose` emits its method once, at the erased carrier
;; signature, so `ks` is the int64 word -- while the `make-struct` in the body
;; calls the representative monomorph ctor, whose `kids` slot is the typed
;; `(Cons (Rose int))` pointer.  The argument went across unbridged:
;; -Wint-conversion under gcc 13, a hard error under clang 15+ and gcc 14.

(defclass Pl [a] (pr [x : a kids : (Cons a)] : a))
(defstruct Rose :heap :copy [A] (label A) (kids (Cons (Rose A))))

(definstance Pl [Rose]
  (pr [r ks] (make-struct Rose :label (.label r) :kids ks)))

(defn main [] : int
  (let [r  (make-struct Rose :label 1 :kids (tnil))
        r2 (:: (pr r (tcons-of r (tnil))) (Rose int))]
    (println (.label r2))                     ; 1
    (println (tlength (.kids r2))))           ; 1
  0)
