;;
;; Phase P1: HAMT collision test

(extern-c free [p :ptr] :void)

(defn ptr= [a : int b : int] : bool
  ```c
  return a == b;
  ```)

(defn alloc-int [x : int] : int
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  *p = (int64_t)x;
  return (int64_t)(intptr_t)p;
  ```)

;; Test: insert multiple keys with the same hash; all retrievable
(defn test-collision [] : int
  (let [fixed-hash 0x123456789ABCDEF0]
    (let [k1 (alloc-int 1)]
      (let [k2 (alloc-int 2)]
        (let [k3 (alloc-int 3)]
          (let [v1 (alloc-int 10)]
            (let [v2 (alloc-int 20)]
              (let [v3 (alloc-int 30)]
                (let [m1 (hamt/new)]
                  (let [m2 (hamt/set m1 fixed-hash k1 v1)]
                    (let [m3 (hamt/set m2 fixed-hash k2 v2)]
                      (let [m4 (hamt/set m3 fixed-hash k3 v3)]
                        (let [c (hamt/count m4)]
                          (let [r1 (hamt/get m4 fixed-hash k1)]
                            (let [r2 (hamt/get m4 fixed-hash k2)]
                              (let [r3 (hamt/get m4 fixed-hash k3)]
                                (hamt/free m1)
                                (hamt/free m2)
                                (hamt/free m3)
                                (hamt/free m4)
                                (free (:: k1 :ptr))
                                (free (:: k2 :ptr))
                                (free (:: k3 :ptr))
                                (free (:: v1 :ptr))
                                (free (:: v2 :ptr))
                                (free (:: v3 :ptr))
                                (if (and (= c 3)
                                         (ptr= r1 v1)
                                         (ptr= r2 v2)
                                         (ptr= r3 v3))
                                  1
                                  0)))))))))))))))))

(println (test-collision))
