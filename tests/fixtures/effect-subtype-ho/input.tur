;; ER4: pure closures passed to a #fx{Write}-row higher-order parameter are
;; accepted.  The closure's inferred row #fx{} is a subset of the parameter's
;; declared row #fx{Write}.  It returns a number rather than printing: a closure
;; that prints is #fx{IO} (W4: `println` is #fx{IO}), not pure.  run-twice sums
;; two calls, so the 42 shows both happened.

(defeffect Write [msg :cstr] :nil)

(defn run-twice [f :(fn [] #fx{Write} int)] #fx{Write} : int
  (+ (f) (f)))

(defn main [] : int
  (handle
    (do (println (run-twice (fn [] 21))) 0)
    (Write [msg] k) (do (println msg) (resume k 0))))
