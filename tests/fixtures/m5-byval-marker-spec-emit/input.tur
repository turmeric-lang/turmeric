;; M5 residual-straddle (docs/m5-residual-straddle-retirement.md):
;; pins the ^byval marker behavior end-to-end.  A ^byval-marked helper
;; with a (Vec A) param that's only called from a by-value spec body
;; should get a per-receiver-type spec interned AND its carrier-base body
;; should be suppressed (no observed carrier call, thanks to
;; emit_abi_fn_skip_generic).
;;
;; end-to-end-monomorphization (Vec typed-pointer slice): Vec is now a :heap
;; type, so the per-receiver spec receives `v` as the typed pointer
;; `Vec__int *` (not a by-value `Vec__int` struct).  The inline-C body
;; therefore derefs the header through `v->len` / `v->data`.  The ^byval
;; marker still routes the call through the spec path rather than the int64
;; carrier base; under the typed-pointer ABI the spec receiver and the
;; carrier both hold the same pointer value, so the marker is ABI-neutral
;; here but still exercises the spec-interning + carrier-skip machinery.

(defn ^byval vget-marker-byval [A]
  [v : (Vec A) i : int]
  : A
  ```c
  if (i >= 0 && (size_t)i < (size_t)v->len) {
    return (int64_t)((int64_t *)v->data)[i];
  }
  fprintf(stderr, "vget-marker-byval index out of bounds\n");
  exit(1);
  return 0;
  ```)

(defn third-byval [A] [v : (Vec A)] : A
  (vget-marker-byval v 2))

(defn main [] : int
  (let [a (:: (vec-of) (Vec int))]
    (vec-push! a 10)
    (vec-push! a 20)
    (vec-push! a 30)
    (third-byval a)))
