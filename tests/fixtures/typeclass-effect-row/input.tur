;; Phase 15: Typeclass method with an effect-row annotation.  `Write` is
;; declared here: an undeclared name in #fx{...} is TUR-E0026 (it used to be
;; dropped silently, which is how this file's row was empty for so long).
(defeffect Write [s :cstr] :nil)

(defclass IOShow [a]
  (io-show [x] #fx{Write} : cstr))

(definstance IOShow [int]
  (io-show [x] : cstr
    "int"))

(defn main [] : int
  (println (.io-show 42))
  0)
