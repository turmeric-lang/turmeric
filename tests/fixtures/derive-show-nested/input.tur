;; SI2: derive-show recurses into Show-able fields.
;; Tests that derive-show with three int fields calls Show [int] on each.
(defclass Show [a]
  (show [x] : cstr))

(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(32);
    snprintf(buf, 32, "%lld", (long long)x);
    return (const char *)(intptr_t)buf;
    ```))

(defn str-concat [a : cstr b : cstr] : cstr
  ```c
  const char *sa = (const char*)(intptr_t)a;
  const char *sb = (const char*)(intptr_t)b;
  size_t la = strlen(sa), lb = strlen(sb);
  char *out = (char *)malloc(la + lb + 1);
  memcpy(out, sa, la);
  memcpy(out + la, sb, lb);
  out[la + lb] = '\0';
  return (const char *)(intptr_t)out;
  ```)

(defstruct ^copy Triple [a : int b : int c : int])
(derive-show-cstr Triple a b c)

(defn main [] : int
  (let [t (make-struct Triple 1 2 3)]
    (println (.show t)))
  (let [t2 (make-struct Triple 10 20 30)]
    (println (.show t2)))
  0)
