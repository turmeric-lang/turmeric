; SZ8 non-GADT extension: cross-parameter size unification on a defopaque
; carrier whose phantom size index is pinned to a Size literal at both
; call sites.  Companion to errors/sized-cross-param-opaque-reject.
; Closes docs/archive/history/sz8-opaque-phantom-size-not-load-bearing.md.
;
; Both `(mk-dense-2)` calls return (Dense (Static 2) int); the call-site
; inference (sz_cross_param_unify's non-GADT path) recovers SZT_CONST 2
; from each callee's declared return form, binds the shared variable `n`
; in zip's signature to 2 once, and accepts the second arg trivially.

(defdata Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defopaque Dense [n A] :int)

; Literal-pinned: every call yields (Dense (Static 2) int).
(defn mk-dense-2 [A] [] : (Dense (Static 2) A)
  (:: 0 :Dense))

; Cross-parameter `n` -- the analogue of pairwise-sum in
; tests/fixtures/sized-cross-param-accept, but over an opaque carrier.
(defn zip [A B] [xs : (Dense n A) ys : (Dense n B)] : int
  0)

(defn main [] : int
  (println (zip (mk-dense-2) (mk-dense-2)))   ; 2 = 2: unifies cleanly
  0)
