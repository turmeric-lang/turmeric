;;
;; Phase P1: HAMT basic operations test

(extern-c free [p :ptr] :void)

(defn ptr= [a : int b : int] : bool
  ```c
  return a == b;
  ```)

(defn alloc-int [x : int] : int
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  *p = (int64_t)x;
  return (int64_t)(intptr_t)p;
  ```)

(defn test-empty [] : int
  (let [m (hamt/new)]
    (let [c (hamt/count m)]
      (hamt/free m)
      c)))

(defn test-single [] : int
  (let [k (alloc-int 42)]
    (let [v (alloc-int 100)]
      (let [m1 (hamt/new)]
        (let [h (hamt/hash-ptr (:: k ptr<void>))]
          (let [m2 (hamt/set m1 h k v)]
            (let [r (hamt/get m2 h k)]
              (hamt/free m1)
              (hamt/free m2)
              (free (:: k :ptr))
              (free (:: v :ptr))
              (if (ptr= r v) 1 0))))))))

(defn test-has [] : int
  (let [k (alloc-int 42)]
    (let [v (alloc-int 100)]
      (let [m1 (hamt/new)]
        (let [h (hamt/hash-ptr (:: k ptr<void>))]
          (let [m2 (hamt/set m1 h k v)]
            (let [found (hamt/has? m2 h k)]
              (hamt/free m1)
              (hamt/free m2)
              (free (:: k :ptr))
              (free (:: v :ptr))
              (if found 1 0))))))))

(defn test-count [] : int
  (let [k1 (alloc-int 1)]
    (let [k2 (alloc-int 2)]
      (let [v1 (alloc-int 10)]
        (let [v2 (alloc-int 20)]
          (let [h1 (hamt/hash-ptr (:: k1 ptr<void>))]
            (let [h2 (hamt/hash-ptr (:: k2 ptr<void>))]
              (let [m1 (hamt/new)]
                (let [m2 (hamt/set m1 h1 k1 v1)]
                  (let [m3 (hamt/set m2 h2 k2 v2)]
                    (let [c (hamt/count m3)]
                      (hamt/free m1)
                      (hamt/free m2)
                      (hamt/free m3)
                      (free (:: k1 :ptr))
                      (free (:: k2 :ptr))
                      (free (:: v1 :ptr))
                      (free (:: v2 :ptr))
                      c)))))))))))

(println (test-empty))
(println (test-single))
(println (test-has))
(println (test-count))
