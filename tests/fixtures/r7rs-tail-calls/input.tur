#lang r7rs
;; r7rs-lang-plan R6 / D6: proper tail calls on the compiled path, with the
;; `flags` file's --debug, 1,000,000 deep -- past the stack.  Every Scheme
;; procedure call lowers to the dynamic call the tail-calls plan's T6
;; trampoline drives (self, mutual and indirect through a value), and a
;; named let is a letrec-bound closure the same trampoline reaches.
;;
;; Why 1e6 and not less (stress-fixture-tiering-plan, measured 2026-10-04):
;; the same procedures WITHOUT the tail position, (+ 1 (f (- n 1))), survive
;; 250,000 frames on an 8 MB stack and crash by 300,000, compiled and under
;; `tur jit` alike.  1e6 is ~3.5x past that, so a tail-call regression still
;; crashes here.  1e5 would NOT: it fits on the stack, and the fixture would
;; pass with tail calls broken.  Do not lower these counts.
;;
;; The 1e7 version runs nightly as r7rs-tail-calls-stress (requires.stress).
;; requires.compiled: the interpreter has always had proper tail calls and
;; retains memory per trampolined step, so millions of steps are a
;; compiled-path assertion (see CLAUDE.md, "Memory, not CPU, inside a single
;; turi run").
(define (loop i) (if (= i 0) 0 (loop (- i 1))))
(display (loop 1000000)) (newline)
(define (ev? n) (if (= n 0) #t (od? (- n 1))))
(define (od? n) (if (= n 0) #f (ev? (- n 1))))
(display (ev? 1000000)) (newline)
(define (ind f n) (if (= n 0) 'done (f f (- n 1))))
(display (ind ind 1000000)) (newline)
(let lp ((i 1000000)) (if (= i 0) (display "named-let ok") (lp (- i 1)))) (newline)
