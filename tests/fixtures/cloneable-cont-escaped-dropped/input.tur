;; cloneable-cont-escaped-dropped: a cloneable continuation that leaves
;; its receiver (k-id returns it), dropped by the program itself -- which
;; docs/guides/delimited-control-operators-guide.md ("Who frees a cloneable
;; k") allows everywhere.  A let that would own a continuation it only reads
;; (cloneable-cont-escaped-owned) leaves one the program drops alone, so
;; nothing is dropped twice.  Leak-checked; a double free would fail it.
(defn k-id [k] : int k)
(defn make [base : int] : int
  (cloneable-reset (+ base (cloneable-shift k-id 0))))

(defn main [] : int
  (let [c (make 5)]
    (println (tur_cloneable_cont_resume c 1))   ; 6
    (println (tur_cloneable_cont_resume c 2))   ; 7
    (let [d (tur_cloneable_cont_clone c)]
      (println (tur_cloneable_cont_resume d 30)) ; 35
      (tur_cloneable_cont_drop d))
    (tur_cloneable_cont_drop c))
  0)
