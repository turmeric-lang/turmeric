;; cps-callback-registry-overflows-past-256: every threadable effectful
;; callback registers its CPS twin at startup, and the registry was a
;; 256-entry array that dropped the rest.  The 257th callback then took its
;; direct entry -- a fresh DK root -- and aborted with "unhandled effect".
;; 260 callbacks, each performing Ask through one effectful slot.
(defeffect Ask [] : int)
(defn apply-eff [f : (fn [] #fx{Ask} int)] : int (f))
(defn c0 [] : int (+ (apply-eff (fn [] : int (+ 0 (perform (Ask))))) (c1)))
