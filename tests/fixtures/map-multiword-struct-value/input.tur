;; collection-multiword-element-boxing (Map value): a Map[K V] whose VALUE type
;; V is a MULTI-WORD by-value :copy struct (Point is 16 bytes) cannot ride the
;; single int64 value carrier.  map-assoc heap-boxes the value (malloc + copy)
;; and stores the box pointer as the carrier; map-get returns the carrier, and
;; the `(:: (map-get m k) Point)` read reinterprets it as the box pointer and
;; loads the aggregate by value.  Before the boxing fix the by-value Point value
;; reached map-assoc-eq-o's int64 `val` carrier param as a hard cc type error.
;;
;; Runs on BOTH paths.  In the interpreter the struct value rides the int64 slot
;; as a TuriStruct pointer; `(:: (map-get m k) Point)` now retags that carrier to
;; a struct (eval.c try_retag_carrier_struct -- gated on a multi-word, >= 2 field
;; single-ctor record so a defopaque int newtype / single-word value is never
;; wrongly dereferenced), so field access reads the TuriStruct rather than its
;; raw header.
(load "stdlib/typeclass.tur")

(defstruct ^copy Point [x : int y : int])

(definstance Show [Point]
  (show [p]
    (let [b (builder/new)]
      (do
        (builder/push-cstr! b "(")
        (let [sx (show (.x p))] (do (builder/push-string! b sx) (string/release sx)))
        (builder/push-cstr! b ",")
        (let [sy (show (.y p))] (do (builder/push-string! b sy) (string/release sy)))
        (builder/push-cstr! b ")")
        (builder/finish b)))))

(defn main [] : int
  (let [m (map-assoc
            (map-assoc (:: (map-new) (Map int Point)) 1 (Point 7 8))
            2 (Point 30 40))]
    ;; field projection out of a boxed multi-word value
    (show-line (.x (:: (map-get m 1) Point)))   ;; 7
    (show-line (.y (:: (map-get m 2) Point)))   ;; 40
    ;; whole-value read-back + Show[Point]
    (show-line (:: (map-get m 1) Point))        ;; (7,8)
    ;; free the map: the boxed struct values are released via the HAMT's
    ;; value-box ownership (compiled) exactly once; the interpreter native
    ;; deep-frees too.  Exercises the release path on both paths (no crash).
    (map-free m)
    0))
