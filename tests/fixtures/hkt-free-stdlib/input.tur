;; Phase S4: Free monad -- extended operations (fmap, chained bind, interpreters).
;;
;; Exercises free-fmap, chained free-bind, and a constant interpreter.
;;
;; Tests:
;;   1. free-pure? is true for PureFree values.
;;   2. free-run on PureFree extracts the value.
;;   3. free-bind (3 + 4 = 7).
;;   4. free-run on Suspend with identity interp -> 99.
;;   5. free-fmap (* 5) on PureFree 11 -> 55.
;;   6. Chained free-bind: (1 + 3) * 2 = 8.
;;   7. Constant interpreter overrides Suspend value -> -1.

;; ---- Free monad (inline C, tag-based struct) --------------------------------
;;   Uses the preamble's tur_tagged_t: { int64_t tag; int64_t val }
;;   TUR_TAG(0, x)  => PureFree x
;;   TUR_TAG(1, x)  => Suspend  x
;; Accessor macros: TUR_PTAG(p) reads p->tag, TUR_PVAL(p) reads p->val.

(defn free-pure [x] : int
  ```c
  tur_tagged_t *r = malloc(sizeof(*r));
  r->tag = 0; r->val = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn free-lift [x] : int
  ```c
  tur_tagged_t *r = malloc(sizeof(*r));
  r->tag = 1; r->val = x;
  return (int64_t)(intptr_t)r;
  ```)

(defn free-pure? [m] : bool
  ```c
  tur_tagged_t *r = (tur_tagged_t *)(intptr_t)m;
  return TUR_PTAG(r) == 0;
  ```)

(defn free-run [interp m] : int
  ```c
  tur_tagged_t *fr = (tur_tagged_t *)(intptr_t)m;
  if (TUR_PTAG(fr) == 0) {
      return TUR_PVAL(fr);
  }
  int64_t *fat = (int64_t *)(intptr_t)interp;
  return TUR_APPLY1(fat, TUR_PVAL(fr));
  ```)

(defn free-bind [m kont] : int
  ```c
  tur_tagged_t *fr = (tur_tagged_t *)(intptr_t)m;
  if (TUR_PTAG(fr) == 0) {
      int64_t *fat = (int64_t *)(intptr_t)kont;
      return TUR_APPLY1(fat, TUR_PVAL(fr));
  }
  return m;
  ```)

;; free-fmap: functor map for Free.
;;   free-fmap (PureFree a) f = PureFree (f a)   (f is a fat closure)
;;   free-fmap (Suspend  x) f = Suspend x         (pass through)
(defn free-fmap [m f] : int
  ```c
  tur_tagged_t *fr = (tur_tagged_t *)(intptr_t)m;
  if (TUR_PTAG(fr) == 0) {
      int64_t *fat = (int64_t *)(intptr_t)f;
      tur_tagged_t *out = malloc(sizeof(*out));
      out->tag = 0; out->val = TUR_APPLY1(fat, TUR_PVAL(fr));
      return (int64_t)(intptr_t)out;
  }
  return m;
  ```)

;; ---- Tests ------------------------------------------------------------------

(defn main [] : int
  (do
    ;; Test 1: free-pure? is true for PureFree
    (println (free-pure? (free-pure 42)))   ;; true

    ;; Test 2: free-run on PureFree returns the value
    (let [z  0
          id (fn [x] (+ x z))]
      (println (free-run id (free-pure 42))))   ;; 42

    ;; Test 3: free-bind adds 4 to 3 -> 7
    (let [add4 4
          r    (free-bind (free-pure 3) (fn [x] (free-pure (+ x add4))))
          z    0
          id   (fn [x] (+ x z))]
      (println (free-run id r)))   ;; 7

    ;; Test 4: free-run on Suspend with identity interpreter -> 99
    (let [z  0
          id (fn [x] (+ x z))]
      (println (free-run id (free-lift 99))))   ;; 99

    ;; Test 5: free-fmap multiplies by 5: fmap (*5) (pure 11) = pure 55
    (let [m5     5
          mapped (free-fmap (free-pure 11) (fn [x] (* x m5)))
          z      0
          id     (fn [x] (+ x z))]
      (println (free-run id mapped)))   ;; 55

    ;; Test 6: chained free-bind: (1 + 3) * 2 = 8
    (let [step 3
          r1   (free-bind (free-pure 1) (fn [x] (free-pure (+ x step))))
          mul2 2
          r2   (free-bind r1 (fn [y] (free-pure (* y mul2))))
          z    0
          id   (fn [x] (+ x z))]
      (println (free-run id r2)))   ;; 8

    ;; Test 7: constant interpreter overrides Suspend payload -> -1
    (let [neg          -1
          const-interp (fn [x] neg)]
      (println (free-run const-interp (free-lift 42))))   ;; -1

    0))
