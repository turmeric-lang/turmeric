;; numvec-set-out-of-bounds-panics: the narrow-typed setters are macros (an
;; inline-C function with a narrow parameter warns TUR-W0037), and a macro
;; expands at the call, so the panic still names the caller's line.  A
;; negative index is out of bounds like a too-large one.
(load "stdlib/numvec.tur")

(defn main [] : int
  (let [a (u8vec-new 4 (as uint8 1))]
    (u8vec-set! a 3 (as uint8 9))
    (println (u8vec-ref a 3))
    (u8vec-set! a -1 (as uint8 9))
    (println "unreachable")
    0))
