;; Regression: kebab-case bindings must survive capture into defer thunks
;; and HKT fat-closure env structs. Before the fix, the C field name was
;; emitted raw (e.g. `int64_t base-val;`), producing invalid C.

(defn make-adder [base-val] : ptr
  (fn [x] : int (+ base-val x)))

(defn main [] : int
  ;; `my-y` is captured by value into the defer env; `my-x` is `^mut`, so
  ;; the defer reads it through its shared cell (defer-semantics-plan).
  (let [^mut my-x 10
        my-y      30]
    (defer (println my-x))
    (defer (println my-y))
    (set! my-x 20))
  (println (make-adder 100 5))
  0)
