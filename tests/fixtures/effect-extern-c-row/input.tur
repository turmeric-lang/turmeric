;; Phase 19 C5: extern-c with #{Effect} effect-row annotation.
;; Annotations on extern-c are advisory in v1 — the imported C function
;; ignores Turmeric effect semantics. The compiler accepts and discards them.

;; `IO` is a compiler-known capability effect (effect-row-honesty-plan W2),
;; so it needs no declaration.

;; Use a custom C function so there's no conflict with system headers.
;; The #{IO} row annotation is accepted and silently discarded.
(defn c-write-int [n : int] #fx{IO} : nil
  ```c
  char buf[32];
  snprintf(buf, sizeof(buf), "%lld", (long long)n);
  fputs(buf, stdout);
  fputc('\n', stdout);
  ```)

(defn main [] : int
  ;; Call the annotated function without a handler — annotation is advisory
  (c-write-int 42)
  (c-write-int 100)
  0)
