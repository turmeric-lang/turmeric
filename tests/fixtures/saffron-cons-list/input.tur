#lang saffron
;; saffron-lang-plan S6 (G7): the cons-list twin of the `[...]` and `#map{...}`
;; widens.  `(list 1 "two" 7.1)` was "function 'tur-list-homog__' arg 2:
;; expected tyvar, got cstr" -- the same wall, from the third of the three
;; homogeneity checks -- so each element is widened to `any` first.
;;
;; This one is a CALL, not a reader literal, so the widen hooks in `elab_form`'s
;; F_LIST case rather than beside the data literals; the widened form then goes
;; through the ordinary macro path unchanged.
;;
;; The ASCRIPTION on each tail is HISTORICAL and kept here to show it still
;; works.  `Cons` used to be `(defstruct ^heap Cons [A] (head A) (tail :int))`
;; -- the TAIL was an erased carrier -- so `.tail` handed back an `:int` and
;; the element type was gone one step in; `(:: (.tail l) (Cons any))`
;; recovered it.  The tail is the recursive occurrence `(Cons A)` now (M7 of
;; the Saffron surface pass), so `.tail` is a `(Cons any)` already and the
;; ascription is an identity; tests/fixtures/saffron-cons-list-walk-through-any
;; walks the same list with no ascription at all, statically and through an
;; unannotated parameter.
;;
;; NO requires.leak-check: cons cells are `:heap` and stdlib has no `list-free`
;; at all, so they are never freed.  Measured pre-existing -- a plain Turmeric
;; `(list 1 2 3)` leaks too, with no `any` anywhere.
;;
;; 7.1 rather than 7.0: a truncating path through the widen would print 7.

(defn main [] : int
  (let [l (list 1 "two" 7.1)]
    (println (type-of (.head l)))
    (let [l2 (:: (.tail l) (Cons any))]
      (println (type-of (.head l2)))
      (let [l3 (:: (.tail l2) (Cons any))]
        (println (type-of (.head l3)))
        (println (cast (.head l3) float)))))
  0)
