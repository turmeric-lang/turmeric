;; Phase 12: Struct field access via (.field s) and field borrowing via (& (.field s))

(defstruct ^copy Point [x : int y : int])

(defn main [] : int
  (let [p (make-struct Point 3 4)]
    ;; Direct field access
    (println (.x p))
    (println (.y p))
    ;; Immutable borrow of a field
    (let [rx &(.x p)]
      (println @rx))
    0))
