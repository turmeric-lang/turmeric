; Phase HRT1: rank-2 identity function.
; `apply-poly` takes a rank-2 polymorphic identity function and applies it to an int.
; Syntax: param-name followed by its type annotation (forall form).
(defn apply-poly [f (forall [a] (-> a a)) x : int] : int
  (f x))

; rank2-argument-genericity: the forall promises `a` at every type, so
; the function passed to it is generic.
(defn id [A] [x : A] : A x)

(defn main [] : int
  (println (apply-poly id 42))
  0)
