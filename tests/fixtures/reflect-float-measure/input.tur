;; reflected-measures RF3: a FLOAT-returning reflected measure is Real-sorted
;; (RM-B1), and its equations are Real equations.  The base one,
;; fsum(FNil) = 0.0, has no arithmetic in it, so `0.0 < 0.75` discharges with
;; no runtime check.  A longer list would not: `h + fsum(t)` rounds in double,
;; so S2 leaves it opaque (float-proofs-assume-exact-reals) and the call keeps
;; its check.  Every literal carries a non-zero fractional part on purpose --
;; the RM-B0 missort (an Int-declared measure integer-tightened against a Real
;; bound) is invisible at 3.0/4.0.  The sibling negative
;; errors/reflect-float-not-tightened pins the boundary case 1.5 + 1.75, which
;; the model search -- evaluating in double -- refutes.
(defdata FL [] (FCons [hd : float tl : FL]) (FNil))

(defn ^reflect fsum [xs : FL] : float
  (match xs
    (FNil) 0.0
    (FCons h t) (+ h (fsum t))))

(defn bounded [xs : #refine{ v : FL | (< (fsum v) 0.75) }] : float 1.5)

(defn main [] : int
  (println (bounded (FNil)))
  (println "reflect-float-measure")
  0)
