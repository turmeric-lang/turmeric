;; async-capturing-body-env-never-freed: a capturing lambda BOUND TO A LOCAL
;; and then spawned -- `(let [f (fn [] ...)] (async f))` -- leaked its env
;; box: the let could not drop it (the body may still be running, parked) and
;; the spawn owned nothing.  When the local's only use is that one spawn --
;; not under a `while`, not inside a closure, no `perform` in the let -- the
;; spawn owns the box now (Binding.spawn_owns_env) and drops it when the body
;; settles, as it does a lambda written at the spawn.  Leak-checked
;; (requires.leak-check): an inline body, a body that parks every turn, a
;; struct capture, and 200 spawns from a recursive loop (each call's let).

(defstruct P [a : int b : int])

(defn cur-cell [fresh : bool] : ptr<void>
  ```c
  static void *g = NULL;
  if (fresh) { g = tur_future_new(); }
  return g;
  ```)

(defn pending? [f : ptr<void>] : bool
  ```c
  return ((TurFuture *)f)->status == FUTURE_PENDING;
  ```)

(defn fulfill-future [f : ptr<void> v : int] : nil
  ```c
  tur_future_fulfill((TurFuture *)f, (int64_t)v);
  ```)

(defn future-value [f : ptr<void>] : int
  ```c
  return (int64_t)tur_future_get((TurFuture *)f);
  ```)

(defn free-future [f : ptr<void>] : nil
  ```c
  tur_future_free((TurFuture *)f);
  ```)

(defn next-value [] : int (await (cur-cell false)))
(defn sum-values [i : int n : int acc : int] : int
  (if (= i n) acc (sum-values (+ i 1) n (+ acc (next-value)))))

(defn drive [f : ptr<void>] : int
  (while (pending? f)
    (let [old (cur-cell false)]
      (cur-cell true)
      (fulfill-future old 2)
      (free-future old)))
  (let [v (future-value f)]
    (free-future f)
    v))

(defn spawn-inline [k : int] : int
  (let [body (fn [] : int (* k 2))]
    (drive (async body))))

(defn spawn-parking [k : int] : int
  (let [body (fn [] : int (+ k (sum-values 0 300 0)))]
    (drive (async body))))

(defn spawn-struct [k : int] : int
  (let [p    (P k 1)
        body (fn [] : int (+ (.a p) (.b p)))]
    (drive (async body))))

(defn loop [i : int acc : int] : int
  (if (= i 0) acc (loop (- i 1) (+ acc (spawn-inline i)))))

(defn main [] : nil
  (cur-cell true)
  (println (spawn-inline 5))
  (println (spawn-parking 7))
  (println (spawn-struct 40))
  (println (loop 200 0))
  (free-future (cur-cell false)))
