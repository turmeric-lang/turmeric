#lang r7rs
;; turi-dropped-closures-kept-until-teardown: under `tur --interpret` the pool
;; sweep hands back every frame, binding, closure and small struct nothing
;; reaches.  Each value below is a closure kept in one kind of place a program
;; can keep one, while `churn` makes enough garbage (a guard, a lambda and a
;; pair each time round) for sweeps to run in between; each is called
;; afterwards, so a place the sweep's marker cannot read hands back a value
;; the program still holds.  tests/check-turi-pool-sweep.py runs this with a
;; sweep every few KB and every object it hands back poisoned.
(import (scheme base) (scheme write) (scheme lazy) (srfi 69))

(define (churn n)
  (let loop ((i 0) (acc 0))
    (if (= i n) acc
        (loop (+ i 1) (+ acc (guard (e (#t 1)) ((lambda (x) (car (list x i))) 1)))))))

(define-record-type <box> (make-box v) box? (v box-v set-box-v!))
(define (adder k) (lambda (x) (+ x k)))

;; Top-level places.
(define vec (make-vector 3 #f))
(vector-set! vec 0 (adder 1))
(define lst (list (adder 2) (adder 3)))
(define rec (make-box (adder 4)))
(define clo (let ((f (adder 5))) (lambda (x) (f x))))
(define prom (delay (adder 6)))
(define param (make-parameter (adder 7)))
(define tbl (make-hash-table equal?))
(hash-table-set! tbl 'k (adder 8))
(define al (list (cons 'a (adder 9))))
(define nested (vector (list (vector (adder 16)))))
(churn 3000)
(write (list ((vector-ref vec 0) 0) ((car lst) 0) ((cadr lst) 0) ((box-v rec) 0) (clo 0)
             ((force prom) 0) ((param) 0) ((hash-table-ref tbl 'k (lambda () #f)) 0)
             ((cdr (assq 'a al)) 0) ((vector-ref (car (vector-ref nested 0)) 0) 0)))
(newline)

;; A call in progress: its arguments, and a caller's let.
(define (hold f g) (churn 3000) (list (f 0) (g 0)))
(write (let ((h (adder 12))) (append (hold (adder 10) (adder 11)) (list (h 0)))))
(newline)

;; The dynamic environment, a wind, a raised payload, a continuation.
(write (parameterize ((param (adder 20))) (churn 3000) ((param) 0)))
(newline)
(write (dynamic-wind (lambda () #f)
                     (lambda () (let ((f (adder 21))) (churn 3000) (f 0)))
                     (lambda () #f)))
(newline)
(write (guard (e ((procedure? e) (churn 3000) (e 0)))
         (raise (adder 22))))
(newline)
(write (call/cc (lambda (k) (let ((f (adder 23))) (churn 3000) (k (f 0))))))
(newline)

;; Deep recursion: a closure in every activation.
(define (deep n)
  (if (= n 0)
      (begin (churn 3000) 0)
      (let ((f (adder n))) (+ (f 0) (deep (- n 1))))))
(write (deep 200))
(newline)

;; Pairs and closures made by vector-map; state captured by set!.
(define v2 (vector-map (lambda (i) (cons i (adder i))) #(1 2 3)))
(define counter (let ((n 0)) (lambda () (set! n (+ n 1)) n)))
(churn 3000)
(counter)
(churn 3000)
(write (list (map (lambda (p) ((cdr p) (car p))) (vector->list v2)) (counter)))
(newline)

;; A record field set after the sweeps began, and a promise forced late.
(set-box-v! rec (adder 30))
(define late (delay (let ((f (adder 31))) (churn 3000) f)))
(churn 3000)
(write (list ((box-v rec) 0) ((force late) 0)))
(newline)
