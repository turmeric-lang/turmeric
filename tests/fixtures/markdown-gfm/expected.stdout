  paragraph [1-3]
    text [| a |]
    softbreak
    text [|---|]
    softbreak
    text [~~s~~ www.a.example x@y.zz]
  bullet list [4-4]
    item [4-4]
      paragraph [4-4]
        text [[ ] x]
