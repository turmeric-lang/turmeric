;; discontinue-plan fixture 3: nothing in the body catches the raise, so it
;; comes back to the clause at the `discontinue`, where a `catch-unwind` takes
;; it.  The body's defer runs first, as the body unwinds.  Compiled, the
;; catch is a catch prompt the clause holds (cps-catch-unwind-cannot-cross-
;; an-effect-capture); the interpreter runs it on the work stack.
(defeffect Ask [] : int)

(defn body [] : int
  (defer (println "body: defer ran"))
  (+ 1 (perform (Ask))))

;; The body catches the raise itself and goes on: the clause's catch sees
;; Ok of what the body answered.
(defn recovers [] : int
  (let [r (catch-unwind (fn [] : int (+ 1 (perform (Ask)))))]
    (if (err? r) 77 (ok-val r))))

(defn main [] : int
  ;; 1. caught in the clause
  (println (handle (body) (Ask [] k)
             (let [r (catch-unwind (fn [] : int (discontinue k "boom")))]
               (if (err? r) (do (println "clause: caught") 100) 200))))
  ;; 2. caught in the body first: the clause's catch gets Ok 77
  (println (handle (recovers) (Ask [] k)
             (let [r (catch-unwind (fn [] : int (discontinue k "boom")))]
               (if (err? r) 100 (+ 2000 (ok-val r))))))
  ;; 3. a catch-panic-of of another type in the clause lets it pass; the
  ;;    catch around the handle takes it
  (let [r (catch-unwind (fn [] : int
            (handle (body) (Ask [] k)
              (let [r2 (catch-panic-of :int (fn [] : int (discontinue k "boom")))]
                (if (err? r2) 300 400)))))]
    (println (if (err? r) "around the handle: caught" "not caught")))
  0)
