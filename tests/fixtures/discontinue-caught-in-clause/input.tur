;; discontinue-plan fixture 3: nothing in the body catches the raise, so it
;; comes back to the clause at the `discontinue`, where a `catch-unwind` takes
;; it.  The body's defer runs first, as the body unwinds.  Interpreter only for
;; now: the compiled backend cannot hold a catch-unwind in a handler clause
;; (cps-catch-unwind-cannot-cross-an-effect-capture); catching around the
;; handle (discontinue-caught-in-body case 4) is the compiled way.
(defeffect Ask [] : int)

(defn body [] : int
  (defer (println "body: defer ran"))
  (+ 1 (perform (Ask))))

(defn main [] : int
  (println (handle (body) (Ask [] k)
             (let [r (catch-unwind (fn [] : int (discontinue k "boom")))]
               (if (err? r) (do (println "clause: caught") 100) 200))))
  0)
