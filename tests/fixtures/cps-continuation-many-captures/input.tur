;; cps-continuation-many-captures -- a lifted continuation carries every
;; value it reads, however many.
;;
;; Each `perform` below lifts the rest of the sum into a continuation that
;; reads every earlier perform's result.  The capture set held 16 values;
;; past that the continuation was emitted with no env and cc failed on an
;; undeclared `__tN`.  `eighteen` is the report's repro, `forty` the sum
;; effect-row-forty-effects leaves out.
;; See docs/archive/cps-continuation-past-16-captures-loses-its-env.md.

(defeffect E0 [] : int)
(defeffect E1 [] : int)
(defeffect E2 [] : int)
(defeffect E3 [] : int)
(defeffect E4 [] : int)
(defeffect E5 [] : int)
(defeffect E6 [] : int)
(defeffect E7 [] : int)
(defeffect E8 [] : int)
(defeffect E9 [] : int)
(defeffect E10 [] : int)
(defeffect E11 [] : int)
(defeffect E12 [] : int)
(defeffect E13 [] : int)
(defeffect E14 [] : int)
(defeffect E15 [] : int)
(defeffect E16 [] : int)
(defeffect E17 [] : int)
(defeffect E18 [] : int)
(defeffect E19 [] : int)
(defeffect E20 [] : int)
(defeffect E21 [] : int)
(defeffect E22 [] : int)
(defeffect E23 [] : int)
(defeffect E24 [] : int)
(defeffect E25 [] : int)
(defeffect E26 [] : int)
(defeffect E27 [] : int)
(defeffect E28 [] : int)
(defeffect E29 [] : int)
(defeffect E30 [] : int)
(defeffect E31 [] : int)
(defeffect E32 [] : int)
(defeffect E33 [] : int)
(defeffect E34 [] : int)
(defeffect E35 [] : int)
(defeffect E36 [] : int)
(defeffect E37 [] : int)
(defeffect E38 [] : int)
(defeffect E39 [] : int)

(defn eighteen [] : int
  (+ (perform (E0)) (perform (E1)) (perform (E2)) (perform (E3)) (perform (E4)) (perform (E5))
     (perform (E6)) (perform (E7)) (perform (E8)) (perform (E9)) (perform (E10)) (perform (E11))
     (perform (E12)) (perform (E13)) (perform (E14)) (perform (E15)) (perform (E16)) (perform (E17))))

(defn forty [] : int
  (+ (perform (E0)) (perform (E1)) (perform (E2)) (perform (E3)) (perform (E4)) (perform (E5))
     (perform (E6)) (perform (E7)) (perform (E8)) (perform (E9)) (perform (E10)) (perform (E11))
     (perform (E12)) (perform (E13)) (perform (E14)) (perform (E15)) (perform (E16)) (perform (E17))
     (perform (E18)) (perform (E19)) (perform (E20)) (perform (E21)) (perform (E22)) (perform (E23))
     (perform (E24)) (perform (E25)) (perform (E26)) (perform (E27)) (perform (E28)) (perform (E29))
     (perform (E30)) (perform (E31)) (perform (E32)) (perform (E33)) (perform (E34)) (perform (E35))
     (perform (E36)) (perform (E37)) (perform (E38)) (perform (E39))))

(defn main [] : int
  (println (handle (eighteen)
    (E0 [] k) (resume k 0)
    (E1 [] k) (resume k 1)
    (E2 [] k) (resume k 2)
    (E3 [] k) (resume k 3)
    (E4 [] k) (resume k 4)
    (E5 [] k) (resume k 5)
    (E6 [] k) (resume k 6)
    (E7 [] k) (resume k 7)
    (E8 [] k) (resume k 8)
    (E9 [] k) (resume k 9)
    (E10 [] k) (resume k 10)
    (E11 [] k) (resume k 11)
    (E12 [] k) (resume k 12)
    (E13 [] k) (resume k 13)
    (E14 [] k) (resume k 14)
    (E15 [] k) (resume k 15)
    (E16 [] k) (resume k 16)
    (E17 [] k) (resume k 17)))
  (println (handle (forty)
    (E0 [] k) (resume k 0)
    (E1 [] k) (resume k 1)
    (E2 [] k) (resume k 2)
    (E3 [] k) (resume k 3)
    (E4 [] k) (resume k 4)
    (E5 [] k) (resume k 5)
    (E6 [] k) (resume k 6)
    (E7 [] k) (resume k 7)
    (E8 [] k) (resume k 8)
    (E9 [] k) (resume k 9)
    (E10 [] k) (resume k 10)
    (E11 [] k) (resume k 11)
    (E12 [] k) (resume k 12)
    (E13 [] k) (resume k 13)
    (E14 [] k) (resume k 14)
    (E15 [] k) (resume k 15)
    (E16 [] k) (resume k 16)
    (E17 [] k) (resume k 17)
    (E18 [] k) (resume k 18)
    (E19 [] k) (resume k 19)
    (E20 [] k) (resume k 20)
    (E21 [] k) (resume k 21)
    (E22 [] k) (resume k 22)
    (E23 [] k) (resume k 23)
    (E24 [] k) (resume k 24)
    (E25 [] k) (resume k 25)
    (E26 [] k) (resume k 26)
    (E27 [] k) (resume k 27)
    (E28 [] k) (resume k 28)
    (E29 [] k) (resume k 29)
    (E30 [] k) (resume k 30)
    (E31 [] k) (resume k 31)
    (E32 [] k) (resume k 32)
    (E33 [] k) (resume k 33)
    (E34 [] k) (resume k 34)
    (E35 [] k) (resume k 35)
    (E36 [] k) (resume k 36)
    (E37 [] k) (resume k 37)
    (E38 [] k) (resume k 38)
    (E39 [] k) (resume k 39)))
  0)
