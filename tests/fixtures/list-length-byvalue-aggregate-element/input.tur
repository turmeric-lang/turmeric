;; list-length-byvalue-aggregate-element -- consume a (Cons A) list whose
;; element A is a by-value aggregate (Option is a multi-word struct) through the
;; element-aware typed walker `tlength`.
;;
;; Gap G4 (docs/archive/history/heap-cons-byvalue-aggregate-head-breaks-int-carrier-list-helpers.md):
;; `Cons` is `(defstruct ^heap Cons [A] (head A) (tail :int))`. The generic
;; int-carrier list helpers (`list-length`, `list-head`, ...) walk the chain as a
;; fixed `struct { int64_t head; int64_t tail; }`. When A is a by-value aggregate
;; (`Option__int`), the real cell is `Cons__Option__int { Option__int head;
;; int64_t tail; }`, so `tail` no longer sits at offset 8 -- the carrier walk
;; reads `tail` from inside the head aggregate, follows a bogus pointer, and
;; SEGFAULTS:
;;
;;   (println (list-length (:: xs :int)))   ;; segfault (the list builds; the walk crashes)
;;
;; Fix (audit Option 2, the monomorphization direction): `tlength` is the
;; element-aware sibling of `list-length`, generic over `[A] [xs : (Cons A)]` and
;; written in pure Turmeric over the typed `(.tail xs)` read -- which the compiler
;; lowers at the concrete `(Cons A)` stride, so a by-value aggregate head no
;; longer misplaces the tail link. The scalar/pointer element path keeps the
;; identical concrete layout (no allocation, no carrier collapse), so it stays
;; correct too.

(defn opt-or [o : (Option int) d : int] : int
  (if (some? o) (unwrap o) d))

(defn main [] : int
  ;; Aggregate element: (Cons (Option int)). The carrier `list-length` segfaulted
  ;; here; `tlength` walks the concrete layout and counts correctly.
  (let [xs (:: (list (some 42) (some 7) (some 100)) (Cons (Option int)))]
    (println (tlength xs))                          ;; 3
    ;; Element round-trip through the typed accessors stays correct.
    (let [h0 (.head xs)
          t0 (:: (.tail xs) (Cons (Option int)))
          h1 (.head t0)
          t1 (:: (.tail t0) (Cons (Option int)))
          h2 (.head t1)]
      (println (opt-or h0 0))                        ;; 42
      (println (opt-or h1 0))                        ;; 7
      (println (opt-or h2 0))))                       ;; 100
  ;; Scalar element regression tripwire: (Cons int) walks the same way.
  (let [ys (:: (list 1 2 3 4 5) (Cons int))]
    (println (tlength ys)))                          ;; 5
  ;; Float element (non-zero fractional part, per the float-probe rule).
  (let [fs (:: (list 7.1 2.5) (Cons float))]
    (println (tlength fs)))                          ;; 2
  ;; The carrier helpers on the same list: list-length-on-cons-any-segfaults
  ;; routes them to tlength/thead/ttail for an inline aggregate head, so they
  ;; no longer read the tail out of the middle of the (Option int).
  (let [xs (:: (list (some 42) (some 7) (some 100)) (Cons (Option int)))]
    (println (list-length xs))                     ;; 3
    (println (length (list-tail xs)))              ;; 2
    (println (opt-or (list-head xs) 0)))           ;; 42
  ;; Empty list: zero, no walk.
  (let [es (:: (tnil) (Cons (Option int)))]
    (println (tlength es)))                          ;; 0
  0)
