;; ET1-F: handle correctly removes handled effects from the enclosing row.
;; The inner handle absorbs Write; only Log escapes to the outer handle.  The
;; Write clause prints, so `inner`'s row also names IO -- a capability, which
;; a handler never sees (W4: `println` is #fx{IO}).

(defeffect Write [s :cstr] :nil)
(defeffect Log [msg :cstr] :nil)

(defn inner [] #fx{Log IO} : nil
  (handle
    (do
      (perform (Write "handled internally"))
      (perform (Log "propagated out")))
    (Write [s] k) (do (println s) (resume k nil))))

(defn main [] : int
  (handle
    (do (inner) 0)
    (Log [msg] k) (do (println msg) (resume k nil))))
