;; ER4: a pure closure passed to a #fx{Write}-row parameter is accepted.
;; The closure's inferred row #fx{} is a subset of the parameter's declared row
;; #fx{Write}.  The closure returns its string rather than printing it: a
;; closure that prints is #fx{IO} (W4: `println` is #fx{IO}), not pure.

(defeffect Write [msg :cstr] :nil)

(defn run-with-write [f :(fn [] #fx{Write} cstr)] #fx{Write} : cstr
  (f))

(defn main [] : int
  (handle
    (do (println (run-with-write (fn [] "pure"))) 0)
    (Write [msg] k) (do (println msg) (resume k 0))))
