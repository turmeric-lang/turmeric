;;
;; Phase P1: HAMT large-scale test - 1000 unique keys

(defn test-large [] : int
  ```c
  int n = 1000;
  void **keys = malloc(n * sizeof(void *));
  void **vals = malloc(n * sizeof(void *));
  for (int i = 0; i < n; i++) {
    keys[i] = malloc(8);
    vals[i] = malloc(8);
    *(int64_t *)keys[i] = i;
    *(int64_t *)vals[i] = i * 2;
  }
  void *m = tur_hamt_new();
  for (int i = 0; i < n; i++) {
    int64_t h = tur_hamt_hash_ptr(keys[i]);
    void *m2 = tur_hamt_set(m, h, (int64_t)(intptr_t)keys[i], (int64_t)(intptr_t)vals[i]);
    tur_hamt_free(m);
    m = m2;
  }
  int64_t c = tur_hamt_count(m);
  if (c != n) {
    tur_hamt_free(m);
    for (int i = 0; i < n; i++) { free(keys[i]); free(vals[i]); }
    free(keys); free(vals);
    return 0;
  }
  int ok = 1;
  for (int i = 0; i < 100; i++) {
    int idx = (i * 97) % n;
    int64_t h = tur_hamt_hash_ptr(keys[idx]);
    void *r = (void *)(intptr_t)tur_hamt_get(m, h, (int64_t)(intptr_t)keys[idx]);
    if (r != vals[idx]) { ok = 0; break; }
  }
  tur_hamt_free(m);
  for (int i = 0; i < n; i++) { free(keys[i]); free(vals[i]); }
  free(keys); free(vals);
  return (int64_t)ok;
  ```)

(println (test-large))
