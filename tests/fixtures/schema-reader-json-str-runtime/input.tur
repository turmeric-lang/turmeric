;; RD2: #json-str<User>(body) desugars to (:: (decode! (json/decode body)) User),
;; round-tripping a runtime :cstr to a typed User struct.  -Xschema-reader
;; auto-loads json.tur + schema.tur and enables the reader family.

(defstruct ^copy User [name : cstr age : int])

(defn user-schema [] : int
  (schema/field
    (schema/field (schema/object-new) "name" (schema/str))
    "age" (schema/int)))

(definstance HasSchema [User]
  (decode! [node]
    (let [v (schema-decode! (user-schema) node)]
      (make-struct User
        (json/get-string (json/get! v "name"))
        (json/get-int    (json/get! v "age"))))))

(defn parse-user [body : cstr] : User
  #json-str<User>(body))

(defn main [] : int
  (let [u (parse-user "{\"name\": \"dave\", \"age\": 51}")]
    (println (.name u))
    (println (.age u)))
  0)
