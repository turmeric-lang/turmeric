;; generic-zipper-plan ZP1: zip/replace and zip/edit deep in the tree, then
;; zip/root rebuilds every edited level.  Persistence: the original tree, and
;; every location taken before an edit, are unchanged afterwards.
(load "stdlib/str-build.tur")
(load "stdlib/zip.tur")

;; A minimal rose-like tree: a leaf holds an int, a node holds its children.
(defdata Tree :heap :copy (Leaf int) (Node (Cons Tree)))

(defn tree-ops [] : (ZipOps Tree)
  (zip/ops (fn [t : Tree] : bool (match t (Leaf _) false (Node _) true))
           (fn [t : Tree] : (Cons Tree) (match t (Leaf _) (tnil) (Node cs) cs))
           (fn [t : Tree cs : (Cons Tree)] : Tree (Node cs))))

(defn n0 [] : Tree (Node (tnil)))
(defn n1 [a : Tree] : Tree (Node (tcons-of a (tnil))))
(defn n2 [a : Tree b : Tree] : Tree (Node (tcons-of a (tcons-of b (tnil)))))
(defn n3 [a : Tree b : Tree c : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tnil))))))
(defn n4 [a : Tree b : Tree c : Tree d : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tcons-of d (tnil)))))))

;; Clojure's vector-zip printing: a node is [k1 k2 ...].
(defn show-kids [cs : (Cons Tree)] : cstr
  (if (tnil? cs)
    ""
    (if (tnil? (ttail cs))
      (show (thead cs))
      (str-concat (str-concat (show (thead cs)) " ") (show-kids (ttail cs))))))

(defn show [t : Tree] : cstr
  (match t
    (Leaf v)  (int->str v)
    (Node cs) (str-concat (str-concat "[" (show-kids cs)) "]")))

(defn show-list [cs : (Cons Tree)] : cstr
  (str-concat (str-concat "(" (show-kids cs)) ")"))

(defn show-at [o : (Option (ZipLoc Tree))] : cstr
  (match o
    (None)   "None"
    (Some z) (show (zip/node z))))

(defn get [o : (Option (ZipLoc Tree))] : (ZipLoc Tree)
  (match o
    (Some z) z
    (None)   (panic "no such location")))

(defn times100 [x : Tree] : Tree
  (match x
    (Leaf v)  (Leaf (* v 100))
    (Node cs) x))

(defn main [] : int
  (let [t   (n3 (Leaf 1) (n2 (Leaf 2) (Leaf 3)) (Leaf 4))
        z   (zip/zipper (tree-ops) t)
        two (get (zip/down (get (zip/right (get (zip/down z))))))
        z2  (zip/replace two (Leaf 40))
        z3  (zip/edit (get (zip/right z2)) times100)]
    (println (show (zip/node z2)))
    (println (show (zip/root z2)))
    (println (show (zip/root z3)))
    ;; the level above an edit is rebuilt by zip/up
    (println (show-at (zip/up z3)))
    ;; the original tree and the pre-edit location are untouched
    (println (show t))
    (println (show (zip/root two)))
    (println (show (zip/node two)))
    ;; an edit, a move back left past it, and another edit
    (let [z4 (zip/edit (get (zip/left z3)) times100)]
      (println (show (zip/root z4))))
    ;; an edit on a branch, then further edits below the new node
    (let [b  (zip/replace (get (zip/right (get (zip/down z)))) (n2 (Leaf 7) (Leaf 8)))
          b2 (zip/edit (get (zip/down b)) times100)]
      (println (show (zip/root b)))
      (println (show (zip/root b2))))
    ;; a replace at the root
    (println (show (zip/root (zip/replace z (Leaf 9)))))
    (println (show (zip/root (zip/edit z times100))))
    (println (show t)))
  0)
