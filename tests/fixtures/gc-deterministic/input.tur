; gc-deterministic: predictable collection -- multiple zombies collected at once.
; Both a and b become zombies; a single gc! collects both.
; Subsequent upgrade calls return none for both (not alive).
(load "stdlib/weak.tur")

(defn main [] : int
  (gc-enable!)
  (let [a (rc/of 1)
        b (rc/of 2)]
    (let [wa (weak a)
          wb (weak b)]
      (rc/drop a)
      (rc/drop b)
      (gc!)
      (let [ua (weak/upgrade wa)
            ub (weak/upgrade wb)]
        (println (+ (if (some? ua) 1 0) (if (some? ub) 1 0))))))  ; expected: 0
  0)
