; Phase HRT3: annotation propagation — rank-2 poly fn passed via let and if.
; The poly fn parameter annotation on `apply-twice` must be visible at each call site.
(defn apply-twice [f (forall [a] (-> a a)) x : int] : int
  (let [y (f x)]
    (f y)))

; rank2-argument-genericity: the forall promises `a` at every type, so
; the function passed to it is generic.
(defn id [A] [x : A] : A x)

(defn main [] : int
  (let [result (apply-twice id 7)]
    (println result))
  0)
