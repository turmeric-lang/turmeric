;; Happy-path fixture for io-real-filesystem-and-list-dir-uncompilable
;; (moved off the deprecated write-file / file-exists? in stdlib-os-surface P1):
;; loads the full stdlib/io.tur and compiles+runs the runtime path that used to
;; be uncompilable. Exercises a file round-trip through file-open / file-read /
;; file-close, the directory listing helpers (list-dir / free-dir-listing), and
;; the FileSystem capability vtable (Real-FileSystem / Real-FileSystem-free) --
;; the last two are what triggered the nested-static-function and missing
;; <dirent.h> codegen errors before the fix.
;;
;; Expected output: io stdlib ok
(defn tmp-path [name : cstr] : cstr
  ```c
  /* Resolve a scratch path at RUN TIME instead of hardcoding "/tmp/...".
   *
   * A compiled fixture is a NATIVE Windows binary, so its CRT resolves a
   * leading "/tmp" against the CURRENT DRIVE ROOT (C:\tmp, D:\tmp) rather than
   * the way the MSYS shell does.  Where that directory does not exist the open
   * simply failed and the fixture printed nothing.  tests/run.sh exports
   * TUR_TEST_TMPDIR; the "/tmp" fallback keeps this runnable by hand on POSIX.
   *
   * Four rotating buffers so a call like (f (tmp-path "a") (tmp-path "b"))
   * does not have the second call clobber the first. */
  static char bufs[4][512];
  static int slot = 0;
  char *buf = bufs[slot];
  slot = (slot + 1) & 3;
  const char *d = getenv("TUR_TEST_TMPDIR");
  if (!d || !*d) d = "/tmp";
  snprintf(buf, sizeof bufs[0], "%s/%s", d, name);
  return buf;
  ```)

(load "stdlib/io.tur")

(defn cstr->ptr [s : cstr] : ptr<void>
  ```c return (void*)s; ```)

(defn make-buf [n : int] : ptr<void>
  ```c return malloc((size_t)n); ```)

(defn free-buf [p : ptr<void>] : void
  ```c free(p); ```)

(defn term-buf [p : ptr<void> n : int] : void
  ```c ((char*)p)[n] = '\0'; ```)

(defn emit [p : ptr<void>] : void
  ```c fputs((const char*)p, stdout); ```)

(defn read-back [path : cstr] : int
  (match (file-open path "rb")
    (Ok fh) (let [buf (make-buf 64)]
              (match (file-read fh buf 63)
                (Ok n) (do (term-buf buf n) (emit buf))
                (Err e) (println (io-error/message e)))
              (free-buf buf)
              (file-close fh)
              0)
    (Err e) (do (println (io-error/message e)) 1)))

(defn main [] : int
  (let [path (tmp-path "tur-io-stdlib-fixture.txt")
        msg  "io stdlib ok\n"]
    (match (file-open path "wb")
      (Ok fh) (do (file-write fh (cstr->ptr msg) 13) (file-close fh))
      (Err e) (Err e))
    (read-back path)
    (let [fs (Real-FileSystem)]
      (Real-FileSystem-free fs))
    (let [entries (list-dir "/tmp")]
      (free-dir-listing entries))
    0))
