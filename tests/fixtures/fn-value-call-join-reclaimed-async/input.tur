;; fn-value-call-cps-frames-held-until-outer-entry, async arm (the inline-C
;; future plumbing keeps it out of fn-value-call-join-reclaimed, which also
;; runs under --interpret).  A heap-join frame is handed back when it runs
;; uncopied; a PENDING await parks a COPY of the chain, so every join the park
;; crosses is copied, stays registered, and must still be intact when the copy
;; resumes after the outer entry has returned.
;;
;; Leak-checked (requires.leak-check) since
;; async-parked-body-chains-never-reaped was fixed: what the parked body had
;; registered moves to the park and is reaped once the resumed body settles.
;;
;; work-loop's non-tail call to the colored await-plus is a heap join each
;; turn.  The first await parks (the future is pending), which copies the joins
;; it crosses; fulfilling the future resumes the parked copy, which must still
;; find them intact -- a copied join is left alone.  Every later await finds
;; the future fulfilled and takes no shift, so the joins of later turns run
;; uncopied and are handed back as they run.
;;
;; The call is direct, not through a function value; the fn-value shapes are
;; tests/fixtures/await-through-fn-value
;; (docs/archive/await-through-fn-value-parks-only-the-callee.md).

(defn the-future [] : ptr<void>
  ```c
  static TurFuture *g = NULL;
  if (!g) g = tur_future_new();
  return (void *)g;
  ```)

(defn fulfill-future [f : ptr<void> v : int] : nil
  ```c
  tur_future_fulfill((TurFuture *)f, (int64_t)v);
  ```)

(defn future-value [f : ptr<void>] : int
  ```c
  return (int64_t)tur_future_get((TurFuture *)f);
  ```)

(defn free-future [f : ptr<void>] : nil
  ```c
  tur_future_free((TurFuture *)f);
  ```)

(defn future-pending? [f : ptr<void>] : bool
  ```c
  return ((TurFuture *)f)->status == FUTURE_PENDING;
  ```)

(defn await-plus [x : int] : int (+ x (await (the-future))))

(defn work-loop [i : int n : int acc : int] : int
  (if (= i n) acc (work-loop (+ i 1) n (+ acc (await-plus i)))))

(defn work [] : int (work-loop 0 50 0))

(defn main [] : nil
  (let [f (async work)]
    (if (future-pending? f)
      (do
        (fulfill-future (the-future) 41)
        (println (future-value f)))       ;; sum of i+41, i<50 = 1225 + 2050 = 3275
      (println -1))
    (free-future f)
    (free-future (the-future))))
