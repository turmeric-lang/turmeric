;; ER5 / PR5-2: Private effects of a module must not appear in the inferred
;; effect row of functions in other modules.
;;
;; provider defines a ^private InternalLog effect. run-internal performs it;
;; wrapper handles it so callers see a pure function. main annotates itself
;; #fx{IO} (it prints; W4) and calls wrapper -- this is accepted because
;; InternalLog is filtered from main's inferred row at the call-site boundary.

(defmodule provider
  (export wrapper)

  (defeffect ^private InternalLog [msg :cstr] :nil)

  (defn run-internal [] : int
    (do (perform (InternalLog "computing")) 42))

  (defn wrapper [] : int
    (handle
      (run-internal)
      (InternalLog [msg] k) (resume k nil))))

(defn main [] #fx{IO} : int
  (println (wrapper))
  0)
