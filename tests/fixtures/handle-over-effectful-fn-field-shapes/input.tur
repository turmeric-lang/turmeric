;; A `handle` over a call through an EFFECTFUL fn field, in the positions the
;; type fuzzer's `fn_field_eff` crossing generates.  Each was refused with
;; "this effect operation has no lowering here": the CPS backend evicted the
;; handler and the performer together.
;;   - the struct store sat under a builtin (`println`'s argument) or a field
;;     read's receiver, where the store walker never looked, so the fn-value
;;     was never registered and became a permanent fiber source;
;;   - a `handle` as a dict-dispatched method call's operand (an indirect
;;     callee to the CPS translation, which needs atomic operands);
;;   - a non-atomic argument to the field call, which the registry path
;;     atomizes anyway but refused up front.

(defeffect Ef [x :int] :int)
(defstruct ^copy FE [run : (fn [int] int) #fx{Ef}])
(defn fe [v : int] : int (perform (Ef v)))

(defeffect Eff [x :float] :float)
(defstruct ^copy FF [run : (fn [float] float) #fx{Eff}])
(defn ff [v : float] : float (perform (Eff v)))

(defeffect Ec [x :cstr] :cstr)
(defstruct ^copy FC [run : (fn [cstr] cstr) #fx{Ec}])
(defn fc [v : cstr] : cstr (perform (Ec v)))
(defclass Ps [a] (ps [self : a] : a))
(definstance Ps [cstr] (ps [self : cstr] : cstr self))

(defn main [] : int
  (println (let [s (make-struct FE fe)]
             (handle (.run s 3) (Ef [x] k) (resume k {x + 1}))))                 ; 4
  (println (handle (.run (make-struct FE fe) 3) (Ef [x] k) (resume k {x * 2})))  ; 6
  (println (handle (let [s (make-struct FE fe)] (.run s 5)) (Ef [x] k) (resume k x))) ; 5
  (println (= (handle (.run (make-struct FF ff) (let [v 1.25] v))
                (Eff [x] k) (resume k x))
              1.25))                                                               ; true
  (println (handle (.run (make-struct FF ff) 7.1) (Eff [x] k) (resume k {x + 1.25}))) ; 8.35
  (println (.ps (handle (.run (make-struct FC fc) "c3")
                  (Ec [x] k) (resume k x))))                                       ; c3
  0)
