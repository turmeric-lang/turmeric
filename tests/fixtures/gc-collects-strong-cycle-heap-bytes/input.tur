; The BYTE-LEVEL backstop for the collector's no-growth property.  The
; assertion that runs everywhere lives in gc-collects-strong-cycle, which reads
; the CG6 (gc-live-blocks) counter; this one keeps the malloc probe, because
; bytes can still catch a leak that does NOT leak an rc control block (a
; payload, or non-rc scaffolding) and the counter cannot see those.
;
; requires.cc, deliberately: the probe measures the PROCESS heap, which is only
; the program's heap on an unsanitized `cc` build that owns its own process.
; Under one-process `tur jit` it reads the compiler's heap; under ASan it reads
; the sanitizer's (blind on glibc, quarantine-inflated on Darwin).  See the
; comment in gc-collects-strong-cycle for the full table, and
; docs/archive/history/gc-leak-gate-darwin-sanitized-probe-drift.md.
;
; CG2 (gc-cycle-collection-plan): (gc!) must now RECLAIM a live strong rc<T>
; cycle -- the case the collector could never handle before.
;
; Pre-CG2 the mark phase treated every strong_count>0 block as a root, and every
; member of a self-sustaining cycle has strong_count>0 via its own back-edge, so
; a cycle was unconditionally marked live. Measured leak: 192 bytes per cycle,
; identical whether the collector was on or off
; (docs/archive/history/gc-strong-cycles-not-collected.md).
;
; Real trial deletion subtracts the internal edges first, so a block referenced
; only from within the candidate subgraph falls to a zero trial count and is
; collected. This builds many two-node cycles, collecting after each, and
; asserts the heap does not grow.
(defstruct ^move S [next : rc<S>])

(defn null-rc-s [] : ptr<void>
  ```c
  return NULL;
  ```)

(defn heap-uordblks [] : int
  ```c
  /* Bytes currently handed out by malloc.  Spelled per-platform: mallinfo2 is
     glibc-only (macOS has no <malloc.h> and no struct mallinfo2), and the
     Darwin equivalent is malloc_zone_statistics on the default zone.  Any
     other libc has no portable query, so the probe reports 0 there and the
     no-growth assertions below degrade to vacuously true -- CI covers glibc
     and Darwin, which are the two that actually measure.

     NOT meaningful under -fsanitize=address, on either platform, which is why
     tests/run-gc-leak-gate.sh skips this fixture's output checks and only
     tests/run.sh (unsanitized) asserts the printed value.  Measured:

              collector on   collector off
       plain        0           1087232
       ASan         0                 0     (glibc: ASan replaces the allocator)

     On Darwin the sanitized reading is worse than blind -- the probe reads
     whatever zone ASan installs, and the quarantine keeps freed blocks
     accounted as in-use, so this prints ~800000 (160 B/iteration of quarantined
     frees, not a leak).  See
     docs/archive/history/gc-leak-gate-darwin-sanitized-probe-drift.md. */
  #if defined(__APPLE__)
  #include <malloc/malloc.h>
  malloc_statistics_t ms;
  malloc_zone_statistics(malloc_default_zone(), &ms);
  return (int64_t)ms.size_in_use;
  #elif defined(__GLIBC__)
  #include <malloc.h>
  struct mallinfo2 mi = mallinfo2();
  return (int64_t)mi.uordblks;
  #else
  return 0;
  #endif
  ```)

(defn build-cycle [] : int
  (let [s1 (rc/of (make-struct S (null-rc-s)))
        s2 (rc/of (make-struct S (rc/clone s1)))]
    ; after the back-edge both nodes sit at strong=2: one external binding plus
    ; one in-cycle reference. Leaving this scope drops each to 1, which is the
    ; PossibleRoot edge CG1 buffers and CG2 then proves is garbage.
    (set! (.next s1) (rc/clone s2))
    0))

(defn run [n : int] : int
  (let [^mut i 0]
    (while (< i n)
      (build-cycle)
      (gc!)
      (set! i (+ i 1))))
  0)

(defn main [] : int
  (gc-enable!)
  (run 500)                       ; warm up allocator behaviour
  (let [before (heap-uordblks)]
    (run 5000)
    (let [after (heap-uordblks)]
      ; 0 == every cycle reclaimed. Pre-CG2 this was 192 bytes per cycle.
      (println (if (= (- after before) 0) 0 (- after before)))
      0)))
