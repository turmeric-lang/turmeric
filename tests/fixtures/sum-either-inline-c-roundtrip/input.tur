; Sum-types plan T8.7: construct a sum value in Turmeric, destructure it in an
; inline-C block via the documented tur_adt_Either layout, return to Turmeric.
(defdata ^copy Either [L R]
  (Left L)
  (Right R))

; Read the discriminant tag directly out of the C struct (0 = Left, 1 = Right).
(defn c-tag [e : int] #fx{Unsafe} : int
  ```c
  tur_adt_Either *p = (tur_adt_Either *)(intptr_t)e;
  return (int64_t)p->tag;
  ```)

; Read the Right payload directly from the union arm.
(defn c-right-payload [e : int] #fx{Unsafe} : int
  ```c
  tur_adt_Either *p = (tur_adt_Either *)(intptr_t)e;
  return p->as.Right._0;
  ```)

(defn main [] : int
  (let [r (Right 1234)]
    (println (unsafe (c-tag (Left 0))))
    (println (unsafe (c-tag r)))
    (println (unsafe (c-right-payload r))))
  0)
