;; Phase R1: result combinators — map, flat-map, map-err, or, or-else, expect

(defn u-ok [x : int] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = true; r->ok_val = x; r->err_val = 0; return r;
  ```)
(defn u-err [e : int] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *r = malloc(sizeof(*r));
  r->is_ok = false; r->ok_val = 0; r->err_val = e; return r;
  ```)
(defn u-ok? [r : ptr<void>] : bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result != NULL && result->is_ok;
  ```)
(defn u-err? [r : ptr<void>] : bool
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result == NULL || !result->is_ok;
  ```)
(defn u-ok-val [r : ptr<void>] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result->ok_val;
  ```)
(defn u-err-val [r : ptr<void>] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  return result->err_val;
  ```)
(defn u-result-unwrap-or [r : ptr<void> default_val : int] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  if (result != NULL && result->is_ok) return (int)result->ok_val;
  return default_val;
  ```)
(defn u-result-expect [r : ptr<void> msg : cstr] : int
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *result = (void*)r;
  if (result == NULL || !result->is_ok) { fprintf(stderr, "expect: %s\n", (const char*)msg); abort(); }
  return (int)result->ok_val;
  ```)
(defn u-result-map [r : ptr<void> f : ptr<void>] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  if (res == NULL || !res->is_ok) return r;
  int64_t new_val = ((int64_t (*)(int64_t))f)(res->ok_val);
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *out = malloc(sizeof(*out));
  out->is_ok = true; out->ok_val = new_val; out->err_val = 0; return out;
  ```)
(defn u-result-map-err [r : ptr<void> f : ptr<void>] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  if (res == NULL || res->is_ok) return r;
  int64_t new_err = ((int64_t (*)(int64_t))f)(res->err_val);
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *out = malloc(sizeof(*out));
  out->is_ok = false; out->ok_val = 0; out->err_val = new_err; return out;
  ```)
(defn u-result-flat-map [r : ptr<void> f : ptr<void>] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  if (res == NULL || !res->is_ok) return r;
  /* f returns a result handle (`ptr<void>`): call it at that type. */
  return ((void * (*)(int64_t))f)(res->ok_val);
  ```)
(defn u-result-or [r : ptr<void> alt : ptr<void>] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  if (res != NULL && res->is_ok) return r; return alt;
  ```)
(defn u-result-or-else [r : ptr<void> f : ptr<void>] : ptr<void>
  ```c
  struct { bool is_ok; int64_t ok_val; int64_t err_val; } *res = (void*)r;
  if (res != NULL && res->is_ok) return r;
  int64_t ev = res ? res->err_val : 0;
  return ((void * (*)(int64_t))f)(ev);
  ```)

(defn double-it [n : int] : int (* n 2))
(defn negate [n : int] : int (- 0 n))
(defn safe-double [n : int] : ptr<void> (u-ok (* n 2)))

(defn main [] : int
  ;; u-result-map: u-ok path applies f
  (println (u-ok-val (u-result-map (u-ok 5) double-it)))
  ;; u-result-map: u-err path propagates unchanged
  (println (u-err? (u-result-map (u-err 3) double-it)))
  ;; u-result-map-err: u-err path applies f
  (println (u-err-val (u-result-map-err (u-err 4) negate)))
  ;; u-result-map-err: u-ok path unchanged
  (println (u-ok? (u-result-map-err (u-ok 7) negate)))
  ;; u-result-flat-map: u-ok path chains
  (println (u-ok-val (u-result-flat-map (u-ok 6) safe-double)))
  ;; u-result-flat-map: u-err path propagates
  (println (u-err? (u-result-flat-map (u-err 9) safe-double)))
  ;; u-result-or: u-ok wins
  (println (u-ok-val (u-result-or (u-ok 11) (u-ok 99))))
  ;; u-result-or: u-err falls back
  (println (u-ok-val (u-result-or (u-err 0) (u-ok 22))))
  ;; u-result-or-else: u-ok wins
  (println (u-ok-val (u-result-or-else (u-ok 33) safe-double)))
  ;; u-result-or-else: u-err calls f
  (println (u-ok-val (u-result-or-else (u-err 5) safe-double)))
  ;; u-result-unwrap-or default
  (println (u-result-unwrap-or (u-err 0) 77))
  ;; u-result-expect success
  (println (u-result-expect (u-ok 42) "no panic"))
  0)
