;; reflected-measures: a FLOAT measure built only from comparisons proves at
;; depth.  Since float-proofs-assume-exact-reals, a real-sorted `+ - * /` is an
;; opaque term to S2 (double rounding breaks identities the rationals keep),
;; so a summing measure proves only at its base case (reflect-float-measure).
;; `slowest` selects with `>` and never rounds: comparisons are exact in
;; double, so `(< (slowest v) 20.75)` over three laps discharges.  The sibling
;; errors/reflect-float-comparison-false is a lap over the bound.
(defdata Laps [] (Lap [secs : float rest : Laps]) (NoLaps))

(defn ^reflect slowest [l : Laps] : float
  (match l
    (NoLaps) 0.0
    (Lap t r) (let [m (slowest r)]
                (if (> t m) t m))))

(defn all-under [l : #refine{ v : Laps | (< (slowest v) 20.75) }] : float 1.25)

(defn main [] : int
  (println (all-under (Lap 19.25 (Lap 20.5 (Lap 18.75 (NoLaps))))))
  (println "reflect-float-comparison-measure")
  0)
