;; typed-ptr-pointee-not-checked-at-calls: the shapes that must keep working
;; beside the new pointee check -- the same pointee, an untyped ptr<void> in
;; either direction, and an rc<S> given an rc<S>.
(defstruct Foo [a : int])
(defn mk-foo [] : ptr<Foo>
  ```c
  return 0;
  ```)
(defn mk-raw [] : ptr<void>
  ```c
  return 0;
  ```)
(defn takes-foo [x : ptr<Foo>] : int 1)
(defn takes-raw [x : ptr<void>] : int 2)
(defn pass-foo [] : ptr<Foo> (mk-foo))
(defn pass-raw-as-foo [] : ptr<Foo> (mk-raw))
(defstruct S [n : int])
(defn peek [^borrow st : rc<S>] : int (.n (deref st)))
(defn main [] : int
  (println (takes-foo (mk-foo)))
  (println (takes-raw (mk-foo)))
  (println (takes-foo (mk-raw)))
  (println (takes-foo (pass-foo)))
  (println (takes-foo (pass-raw-as-foo)))
  (println (peek (rc/of (S 9))))
  0)
