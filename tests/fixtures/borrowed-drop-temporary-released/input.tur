;; borrowed-drop-temporary-released: a fresh move-only Drop value passed
;; straight to a `^borrow` parameter -- `(f64vec-len (f64vec-new 4 0.0))` --
;; has no owner: the callee only borrows it and no binding holds it.  It is now
;; bound to a temp and released after the call, when that is plainly safe: the
;; call's result is a scalar (it cannot point into the temp) and every argument
;; before it is effect-free (hoisting it reorders nothing).  An effectful
;; argument before it no longer leaves it unowned when every non-literal
;; argument before it is a plain scalar: those are hoisted ahead of it, in
;; order (borrowed-drop-temporary-leaks-outside-the-hoist), and the `peek3`
;; line pins that a variable an effectful neighbour assigns is still read
;; first.  A move-only Drop result (`dup`) owns its own resource, so it cannot
;; point into the temp either: the temp is released, and the result goes to
;; the let that binds it, or to a further hoist.  A non-scalar result (a
;; `cstr`, a `Vec`) is released too when the callee's body uses the borrowed
;; parameter only as an argument of calls that return a scalar or that borrow
;; it on the same terms (`label`, `tagv`); a callee that may hand back a view
;; of it -- inline C (`viewc`), or a body that passes it to one (`viewt`) --
;; keeps the old behaviour, a leak rather than a dangling result.
;; ctr -- alloc/free counters (0 bump alloc, 1 bump free, 2 read alloc, 3 read free)
(defn ctr [op : int] : int
  ```c
  static int64_t a = 0, f = 0;
  if (op == 0) return ++a;
  if (op == 1) return ++f;
  if (op == 2) return a;
  return f;
  ```)
(defopaque ^affine Widget :int)
(defn mk [] : Widget (ctr 0) (:: 1 Widget))
(defn rel [w : Widget] : void (ctr 1) (:: w int) nil)
(definstance Drop [Widget] (drop [x] : void (rel x)))
(defn peek [^borrow w : Widget] : int 1)
(defn peek2 [k : int ^borrow w : Widget] : int k)
(defn peek3 [k : int j : int ^borrow w : Widget] : int (+ (* 10 k) j))
(defn dup [^borrow w : Widget] : Widget (mk))
(defn peekc [^borrow w : Widget] : int
  ```c
  return 5;
  ```)
(defn live [] : nil (println (- (ctr 2) (ctr 3))))
(defn label [^borrow w : Widget] : cstr (if (> (peek w) 0) "w" "v"))
(defn tagv-go [^borrow w : Widget v : (Vec int) n : int] : (Vec int)
  (if (= n 0) v (do (vec-push! v (peek w)) (tagv-go w v (- n 1)))))
(defn tagv [^borrow w : Widget] : (Vec int) (tagv-go w (:: (vec-new) (Vec int)) 2))
(defn viewc [^borrow w : Widget] : cstr
  ```c
  (void)w;
  return "c";
  ```)
(defn viewt [^borrow w : Widget] : cstr (viewc w))

(defn main [] : int
  (println (peek (mk)))        (live)   ;; 1 0
  (println (peekc (mk)))       (live)   ;; 5 0
  (let [k 3]
    (println (peek2 k (mk))))  (live)   ;; 3 0
  (println (+ (peek (mk)) (peek (mk)))) (live)   ;; 2 0
  (println (peek2 (ctr 2) (mk))) (live) ;; 5 0 -- effectful prefix, hoisted in order
  (let [^mut x 1]
    (println (peek3 x (do (set! x 7) (ctr 2)) (mk))) (live))   ;; 16 0
  (let [c (dup (mk))]
    (live)                               ;; 1 -- c alone is live
    (println (peek c)))                  ;; 1
  (live)                                 ;; 0
  (println (peek (dup (dup (mk))))) (live)   ;; 1 0
  (println (label (mk))) (live)              ;; w 0 -- cstr result, released
  (let [v (tagv (mk))]
    (live)                                   ;; 0
    (println (vec-len v)))                   ;; 2
  (println (viewc (mk))) (live)              ;; c 1 -- inline C may view it: kept
  (println (viewt (mk))) (live)              ;; c 2 -- so may a body that hands it there
  0)
