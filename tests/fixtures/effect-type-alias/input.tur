;; ET0-D: deftype with an explicit effect row in a fn type.
;; Verifies that type aliases containing effect-annotated fn types are
;; accepted syntactically and the aliased type can be stored in a struct field.

(defeffect Log [msg :cstr] :nil)

(deftype Logger (fn [cstr] #fx{Log}  nil))

(defstruct ^copy App [run : fn #fx{Log}])

(defn main [] : int
  (let [app (make-struct App (fn [msg : cstr] (perform (Log msg))))]
    (handle
      (do (.run app "type alias test") 0)
      (Log [msg] k) (do (println msg) (resume k nil)))))
