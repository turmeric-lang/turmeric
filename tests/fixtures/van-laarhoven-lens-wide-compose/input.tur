;; WF4 (van-laarhoven-wide-functor-carrier-plan): van Laarhoven lens COMPOSITION
;; focusing through a WIDE by-value functor.  `line-a-x` composes `line-a`
;; (Line -> Point) and `point-x` (Point -> int) via an adapter lambda handed to
;; `line-a`; the adapter captures the caller-chosen `Functor f` dictionary so the
;; inner `(point-x g p)` dispatches the same functor.  With `Identity` a two-word
;; `:copy` struct, the wide `(f Line)`/`(f Point)` aggregates cross the poly
;; carrier at BOTH composed stages -- the wide-functor bridge (WF1-WF3) threads
;; through the composition just as the opaque twin does.  view/set/over compose:
;; 7 / 700 / 2 / 0 / 42, identical to van-laarhoven-lens-compose.

(defopaque Const [r a] :int)
(defn mk-const [A] [x : A] : (Const A A) ```c return (int64_t)x; ```)
(defn get-const [R A] [c : (Const R A)] : R ```c return (int64_t)c; ```)
(definstance Functor [(Const r)]
  (fmap [c g] (mk-const (get-const c))))

;; Identity a -- WIDE: a two-word `:copy` struct, not the one-int64 opaque.
(defstruct ^copy Identity [A] (wrapped : A) (tag : int))
(defn mk-id  [A] [x : A]            : (Identity A) (make-struct Identity :wrapped x :tag 0))
(defn run-id [A] [i : (Identity A)] : A            (.wrapped i))
(definstance Functor [Identity]
  (fmap [i g] (mk-id (g (run-id i)))))

(defstruct ^copy ^heap Point [x : int y : int])
(defstruct ^copy ^heap Line [a : Point b : Point])

(defn point-x [^f] [^Functor f g : (-> int (f int)) s : Point] : (f Point)
  (fmap (g (.x s))
        (fn [nx : int] : Point (make-struct Point :x nx :y (.y s)))))

(defn line-a [^f] [^Functor f g : (-> Point (f Point)) s : Line] : (f Line)
  (fmap (g (.a s))
        (fn [np : Point] : Line (make-struct Line :a np :b (.b s)))))

;; The composed lens: Line -> a:Point -> x:int, via an adapter lambda.
(defn line-a-x [^f] [^Functor f g : (-> int (f int)) s : Line] : (f Line)
  (line-a (fn [p : Point] : (f Point) (point-x g p)) s))

(defn view [S A]
    [l (forall [(f :: * -> *)] [(Functor f)] (-> (-> A (f A)) S (f S)))
     s : S] : A
  (get-const (l (fn [x : A] : (Const A A) (mk-const x)) s)))

(defn over [S A]
    [l (forall [(f :: * -> *)] [(Functor f)] (-> (-> A (f A)) S (f S)))
     h : (-> A A) s : S] : S
  (run-id (l (fn [a : A] : (Identity A) (mk-id (h a))) s)))

(defn set [S A]
    [l (forall [(f :: * -> *)] [(Functor f)] (-> (-> A (f A)) S (f S)))
     b : A s : S] : S
  (run-id (l (fn [a : A] : (Identity A) (mk-id b)) s)))

(defn main [] : int
  (let [ln (make-struct Line :a (make-struct Point :x 7 :y 2)
                             :b (make-struct Point :x 0 :y 0))]
    (println (view line-a-x ln))                       ; 7
    (let [ln2 (over line-a-x (fn [v : int] : int (* v 100)) ln)]
      (println (view line-a-x ln2))                    ; 700
      (println (.y (.a ln2)))                          ; 2  -- sibling field preserved
      (println (.x (.b ln2))))                         ; 0  -- other branch preserved
    (let [ln3 (set line-a-x 42 ln)]
      (println (view line-a-x ln3))))                  ; 42
  0)
