;; numvec-new-negative-length-panics: a negative length is refused with a
;; panic rather than wrapping into a huge allocation under a recorded length
;; (the bug class security-audit WP5 closed for sized-buf-new).  The message
;; site is not pinned (no expected.stderr): `f64vec-new` is a Turmeric wrapper
;; over an inline-C allocator, so the compiled engine names the line inside
;; stdlib/numvec.tur while turi names the caller's.
(load "stdlib/numvec.tur")

(defn main [] : int
  (let [ok (i32vec-new 0 (as int32 5))]
    (println (i32vec-len ok)))
  (let [a (f64vec-new -3 7.1)]
    (println "unreachable")
    (println (f64vec-len a))
    0))
