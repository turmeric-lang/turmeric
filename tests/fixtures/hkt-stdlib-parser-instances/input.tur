;; stdlib-hkt-consolidation T2: HKT typeclass instances for stdlib Parser.
;;
;; Parser is exposed as a kind-(* -> *) opaque so it carries Functor /
;; Applicative / Monad / Alternative. Parser programs are written with the
;; generic do-m / for / bind / alt-or surface from stdlib/macros.tur instead of
;; the bespoke bind-parser / or-parser combinators.
;;
;; parsec-guide-plan: the surface is typed now -- `item` is a (Parser Char), a
;; do-m binder over it is a Char (typed from the receiver, no annotation), and
;; the runners hand back the value itself (`parse-first`) or an Option
;; (`run-parser-full`) instead of a raw result cell.

(load "stdlib/parsec.tur")

;; Monad [Parser] via do-m: parse two chars, return the sum of their codes.
(defn two-sum [] : (Parser int)
  (do-m
    a (item)
    b (item)
    (pure (+ (char->int a) (char->int b)))))

;; Monad [Parser] via bind directly: parse two chars, keep the second.
(defn second-char [] : (Parser Char)
  (bind (item) (fn [_a] (item))))

;; Functor [Parser]: map the successor over a single parsed char.
(defn succ-char [] : (Parser Char)
  (fmap (item) (fn [c] (int->char (+ (char->int c) 1)))))

;; Alternative [Parser]: match 'A' or 'B'.
(defn a-or-b [] : (Parser Char)
  (alt-or (pchar #\A) (pchar #\B)))

(defn main [] : int
  ;; do-m: 'A'(65) + 'B'(66) = 131, full input consumed
  (println (parse-first (two-sum) "AB"))                         ; 131
  ;; bind: second char of "AB" = 'B'(66)
  (println (char->int (parse-first (second-char) "AB")))         ; 66
  ;; fmap: succ of 'A'(65) = 66
  (println (char->int (parse-first (succ-char) "A")))            ; 66
  ;; alt-or: matches 'B'(66) on "B"
  (println (char->int (parse-first (a-or-b) "B")))               ; 66
  ;; alt-or: neither matches on "X" -> no parse at all
  (println (list-count (run-parser (a-or-b) "X")))               ; 0
  0)
