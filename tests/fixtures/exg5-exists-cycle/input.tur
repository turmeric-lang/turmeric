;; DS3 (defstruct-field-types-plan): cycle construction via
;; set!-on-rc-Struct-field, exercising the RCK_STRUCT walker.
;;
;; Builds a self-referential cycle s1 <-> s2 over a single struct shape
;; (defstruct ^move S [next :rc<S>]).  The forward edge is wired in at
;; make-struct time via rc/clone; the back-edge is installed with
;; (set! (.next s1) (rc/clone s2)).  After the install both nodes have
;; strong_count = 2 (1 from the let binding + 1 from the other node).
;;
;; This fixture exercises three pieces shipped in DS3:
;;   - rc<Name> field annotations on a self-referential struct that
;;     carry the StructDef through the type system (so .next resolves).
;;   - (set! (.field rc-of-s) v) -- struct field write through an rc<Struct>
;;     receiver, with ownership transfer (old rc decremented, new rc
;;     already at +1 from rc/clone).
;;   - rc/of on a struct with rc fields tagging the block RCK_STRUCT
;;     and attaching walk_glue_S so the cycle walker can trace through.
;;
;; CG7 (gc-cycle-collection-followup-plan): this fixture used to DOCUMENT
;; non-collection.  When it was written the trial deletion was zombie-only --
;; the suspect set was populated only when strong->0 with weak>0 -- so the
;; cycle survived gc! and all this could assert was that the RCK_STRUCT walker
;; ran without tripping.
;;
;; CG2 replaced that phase with real Bacon-Rajan trial deletion, so the cycle
;; below is now RECLAIMED, and CG6 added the counters needed to say so from
;; Turmeric rather than inferring it from a heap probe.  Promoted accordingly:
;; the assertions after gc! are the point of the fixture now.
;;
;; Note the let scope closes BEFORE gc!.  That is what makes this garbage
;; rather than a live cycle: each node drops to strong=1, held only by the
;; other.  (tests/fixtures/gc-live-cycle-survives covers the opposite
;; direction, where an external root must keep the cycle alive.)
(defstruct ^move S [next : rc<S>])

;; Initial sentinel for S.next at construction time -- the back-edge is
;; installed by the set! below.
(defn null-rc-s [] : ptr<void>
  ```c
  return NULL;
  ```)

(defn main [] : int
  (gc-enable!)
  (let [s1 (rc/of (make-struct S (null-rc-s)))
        s2 (rc/of (make-struct S (rc/clone s1)))]
    ;; Before back-edge: s1 has strong=2 (let + s2.next), s2 has strong=1.
    (println (rc/strong-count s1))   ; 2
    (println (rc/strong-count s2))   ; 1
    (set! (.next s1) (rc/clone s2))
    ;; After back-edge: both at strong=2.
    (println (rc/strong-count s1))   ; 2
    (println (rc/strong-count s2)))  ; 2
  ;; Force a collection.  The walker traverses the RCK_STRUCT payloads, trial
  ;; deletion subtracts the two in-cycle edges, and both nodes fall to a zero
  ;; trial count -- garbage.
  (gc!)
  (println "post-gc")
  (println (if (> (gc-objects-freed) 0) 1 0))   ; 1 -- the cycle was reclaimed
  (println (gc-live-blocks))                    ; 0 -- nothing survived it
  0)
