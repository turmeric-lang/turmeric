;;
;; Phase P2: Lisp bindings basic test
;; Tests basic API round-trip from Turmeric code.
;; Uses the same helper style as hamt-basic (inline C, ptr=).

(extern-c free [p :ptr] :void)

(defn ptr= [a : int b : int] : bool
  ```c
  return a == b;
  ```)

(defn alloc-key [x : int] : int
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  *p = (int64_t)x;
  return (int64_t)(intptr_t)p;
  ```)

;; Test: hamt/new creates empty map
(defn test-new [] : int
  (let [m (hamt/new)]
    (let [c (hamt/count m)]
      (hamt/free m)
      c)))

;; Test: hamt/set and hamt/get round-trip
(defn test-set-get [] : int
  (let [k1 (alloc-key 42)]
    (let [v1 (alloc-key 100)]
      (let [m1 (hamt/new)]
        (let [m2 (hamt/set m1 (hamt/hash-ptr (:: k1 ptr<void>)) k1 v1)]
          (let [result (hamt/get m2 (hamt/hash-ptr (:: k1 ptr<void>)) k1)]
            (hamt/free m1)
            (hamt/free m2)
            (free (:: k1 :ptr))
            (free (:: v1 :ptr))
            (if (ptr= result v1) 1 0)))))))

;; Test: hamt/has?
(defn test-has [] : int
  (let [k1 (alloc-key 42)]
    (let [v1 (alloc-key 100)]
      (let [m1 (hamt/new)]
        (let [m2 (hamt/set m1 (hamt/hash-ptr (:: k1 ptr<void>)) k1 v1)]
          (let [result (hamt/has? m2 (hamt/hash-ptr (:: k1 ptr<void>)) k1)]
            (hamt/free m1)
            (hamt/free m2)
            (free (:: k1 :ptr))
            (free (:: v1 :ptr))
            (if result 1 0)))))))

;; Test: hamt/count
(defn test-count [] : int
  (let [k1 (alloc-key 1)]
    (let [k2 (alloc-key 2)]
      (let [k3 (alloc-key 3)]
        (let [v1 (alloc-key 10)]
          (let [v2 (alloc-key 20)]
            (let [v3 (alloc-key 30)]
              (let [m1 (hamt/new)]
                (let [m2 (hamt/set m1 (hamt/hash-ptr (:: k1 ptr<void>)) k1 v1)]
                  (let [m3 (hamt/set m2 (hamt/hash-ptr (:: k2 ptr<void>)) k2 v2)]
                    (let [m4 (hamt/set m3 (hamt/hash-ptr (:: k3 ptr<void>)) k3 v3)]
                      (let [c (hamt/count m4)]
                        (hamt/free m1)
                        (hamt/free m2)
                        (hamt/free m3)
                        (hamt/free m4)
                        (free (:: k1 :ptr))
                        (free (:: k2 :ptr))
                        (free (:: k3 :ptr))
                        (free (:: v1 :ptr))
                        (free (:: v2 :ptr))
                        (free (:: v3 :ptr))
                        c))))))))))))

;; Test: hamt/del
(defn test-del [] : int
  (let [k1 (alloc-key 42)]
    (let [v1 (alloc-key 100)]
      (let [m1 (hamt/new)]
        (let [m2 (hamt/set m1 (hamt/hash-ptr (:: k1 ptr<void>)) k1 v1)]
          (let [m3 (hamt/del m2 (hamt/hash-ptr (:: k1 ptr<void>)) k1)]
            (let [c (hamt/count m3)]
              (let [has (hamt/has? m3 (hamt/hash-ptr (:: k1 ptr<void>)) k1)]
                (hamt/free m1)
                (hamt/free m2)
                (hamt/free m3)
                (free (:: k1 :ptr))
                (free (:: v1 :ptr))
                (if (and (= c 0) (not has)) 1 0)))))))))

(println (test-new))
(println (test-set-get))
(println (test-has))
(println (test-count))
(println (test-del))
