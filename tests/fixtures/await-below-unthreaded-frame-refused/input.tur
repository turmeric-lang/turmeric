;; await-parks-only-to-the-nearest-c-frame: the two shapes that still put a
;; direct-style frame between an async body and its await.  Both draw
;; TUR-W0044 at compile time, and the compiled program refuses the park at
;; run time rather than losing the rest of the body.
;;
;;   gen-cap   -- a capturing lambda inside a generic: the generic and its
;;                lambda are emitted only as their erased-carrier base, whose
;;                type-variable parameter / capture the CPS backend refuses.
;;   r2f-apply -- a rank-2 call with a float position: the slot carries a
;;                float at its own type, which the rank-2 wrapper does not
;;                declare, so the call takes the value's direct entry.
;;
;; main reaches the float shape first, and its refusal aborts the program;
;; the generic one is spawned after it, so it is reachable from an async body
;; (which TUR-W0044 requires) but never runs.  Both warnings are compile-time.


(defn cur-cell [fresh : bool] : ptr<void>
  ```c
  static void *g = NULL;
  if (fresh) { g = tur_future_new(); }
  return g;
  ```)

(defn pending? [f : ptr<void>] : bool
  ```c
  return ((TurFuture *)f)->status == FUTURE_PENDING;
  ```)

(defn fulfill-future [f : ptr<void> v : int] : nil
  ```c
  tur_future_fulfill((TurFuture *)f, (int64_t)v);
  ```)

(defn future-value [f : ptr<void>] : int
  ```c
  return (int64_t)tur_future_get((TurFuture *)f);
  ```)

(defn free-future [f : ptr<void>] : nil
  ```c
  tur_future_free((TurFuture *)f);
  ```)

(defn next-value [] : int (await (cur-cell false)))
(defn sum-values [i : int n : int acc : int] : int
  (if (= i n) acc (sum-values (+ i 1) n (+ acc (next-value)))))

(defn level3 [m : int] : int (+ m (sum-values 0 300 0)))
(defn apply3 [f : (fn [int] int) x : int] : int (f x))
(defn drive [f : ptr<void>] : int
  (while (pending? f)
    (let [old (cur-cell false)]
      (cur-cell true)
      (fulfill-future old 2)
      (free-future old)))
  (let [v (future-value f)]
    (free-future f)
    v))

(defn gen-cap [T] [v : T m : int] : int
  (* 2 (apply3 (fn [y : int] : int (let [w v] (level3 y))) (+ m 1))))
(defn gen-body [] : int (+ 7 (gen-cap true 2)))

(defn level3f [x : float] : float (+ x (as float (sum-values 0 300 0))))
(defn r2f-apply [f (forall [a] (-> a a)) x : float] : float (f x))
(defn float-body [] : int (as int (r2f-apply level3f 7.1)))

(defn main [] : nil
  (cur-cell true)
  (println (drive (async float-body)))
  (println (drive (async gen-body)))
  (free-future (cur-cell false)))
