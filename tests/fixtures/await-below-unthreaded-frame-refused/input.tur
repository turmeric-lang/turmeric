;; await-parks-only-to-the-nearest-c-frame: the shape that still puts a
;; direct-style frame between an async body and its await.  It draws
;; TUR-W0044 at compile time, and the compiled program refuses the park at
;; run time rather than losing the rest of the body.
;;
;; A CONSTRAINED GENERIC passed to a constrained rank-2 parameter runs as a
;; dict-clone (`same-and-wait__dict_N`): a copy taking the dictionary as a
;; real parameter, whose class-method calls dispatch through it.  That
;; dispatch is set up by the direct emitter after the CPS render is tried, so
;; the clone stays off the backend rather than bind the wrong instance.  (A
;; MONOMORPHIC function passed to the same parameter threads; see
;; await-through-rank2-param, r2-eq.)


(defn cur-cell [fresh : bool] : ptr<void>
  ```c
  static void *g = NULL;
  if (fresh) { g = tur_future_new(); }
  return g;
  ```)

(defn pending? [f : ptr<void>] : bool
  ```c
  return ((TurFuture *)f)->status == FUTURE_PENDING;
  ```)

(defn fulfill-future [f : ptr<void> v : int] : nil
  ```c
  tur_future_fulfill((TurFuture *)f, (int64_t)v);
  ```)

(defn future-value [f : ptr<void>] : int
  ```c
  return (int64_t)tur_future_get((TurFuture *)f);
  ```)

(defn free-future [f : ptr<void>] : nil
  ```c
  tur_future_free((TurFuture *)f);
  ```)

(defn next-value [] : int (await (cur-cell false)))
(defn sum-values [i : int n : int acc : int] : int
  (if (= i n) acc (sum-values (+ i 1) n (+ acc (next-value)))))

(defn level3 [m : int] : int (+ m (sum-values 0 300 0)))
(defn apply3 [f : (fn [int] int) x : int] : int (f x))
(defn drive [f : ptr<void>] : int
  (while (pending? f)
    (let [old (cur-cell false)]
      (cur-cell true)
      (fulfill-future old 2)
      (free-future old)))
  (let [v (future-value f)]
    (free-future f)
    v))

(defn same-and-wait [T] [(Eq T)] [x : T y : T] : bool
  (and (eq? x y) (> (sum-values 0 300 0) 0)))
(defn r2e-apply [f (forall [a] [(Eq a)] (-> a a bool)) x : int] : bool (f x x))
(defn body [] : int (if (r2e-apply same-and-wait 5) 1213 0))

(defn main [] : nil
  (cur-cell true)
  (println (drive (async body)))
  (free-future (cur-cell false)))
