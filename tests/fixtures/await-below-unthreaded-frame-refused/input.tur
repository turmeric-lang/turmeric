;; await-parks-only-to-the-nearest-c-frame: the floor.  An awaiting function
;; the CPS backend cannot take draws TUR-W0044 at compile time, and the
;; compiled program refuses the park at run time rather than losing the rest
;; of the async body.
;;
;; Here the awaiter takes an OWNING aggregate (a struct with a `(Vec int)`
;; field, so drop glue): a signature shape the backend does not thread, so
;; `level3o` is compiled direct-style and the await below it would park at its
;; root.  (Every rank-2 call shape this fixture used to pin now threads --
;; await-through-rank2-param, await-through-rank2-struct-position,
;; await-through-constrained-rank2-value.)


(defn cur-cell [fresh : bool] : ptr<void>
  ```c
  static void *g = NULL;
  if (fresh) { g = tur_future_new(); }
  return g;
  ```)

(defn pending? [f : ptr<void>] : bool
  ```c
  return ((TurFuture *)f)->status == FUTURE_PENDING;
  ```)

(defn fulfill-future [f : ptr<void> v : int] : nil
  ```c
  tur_future_fulfill((TurFuture *)f, (int64_t)v);
  ```)

(defn future-value [f : ptr<void>] : int
  ```c
  return (int64_t)tur_future_get((TurFuture *)f);
  ```)

(defn free-future [f : ptr<void>] : nil
  ```c
  tur_future_free((TurFuture *)f);
  ```)

(defn next-value [] : int (await (cur-cell false)))
(defn sum-values [i : int n : int acc : int] : int
  (if (= i n) acc (sum-values (+ i 1) n (+ acc (next-value)))))

(defn level3 [m : int] : int (+ m (sum-values 0 300 0)))
(defn apply3 [f : (fn [int] int) x : int] : int (f x))
(defn drive [f : ptr<void>] : int
  (while (pending? f)
    (let [old (cur-cell false)]
      (cur-cell true)
      (fulfill-future old 2)
      (free-future old)))
  (let [v (future-value f)]
    (free-future f)
    v))

(defstruct O [v : (Vec int) n : int])
(defn level3o [o : O] : O (O (.v o) (+ (.n o) (sum-values 0 300 0))))
(defn r2o-apply [f (forall [a] (-> a a)) o : O] : O (f o))
(defn owning [] : int (.n (r2o-apply (:: level3o (forall [a] (-> a a))) (O (vec-new) 13))))

(defn main [] : nil
  (cur-cell true)
  (println (drive (async owning)))
  (free-future (cur-cell false)))
