;; CONV-S1 (defstruct-as-defadt experiment): with --enable=defstruct-as-defadt,
;; a leaf-scalar `defstruct` is lowered to a single-variant record `defadt` and
;; flows through the by-value ADT path.  Every struct surface op -- keyword
;; construction (reorderable), positional construction, `with` update, `.field`
;; access, and `match` -- must behave exactly as it does for a struct.  The
;; `flags` file enables the experiment; output must match the struct path.
(defstruct ^copy P [a : int b : int])

(defn sum [p : P] : int
  (match p (P x y) (+ x y)))

(defn main [] : int
  (let [p  (P :b 32 :a 10)          ; keyword construction, reordered
        q  (with p [a 100])         ; functional update
        r  (P 1 2)]                 ; positional construction
    (println (.a p))                ; 10
    (println (.b p))                ; 32
    (println (.a q))                ; 100
    (println (.b q))                ; 32
    (println (sum p))               ; 42
    (println (sum r))               ; 3
    0))
