;; A lambda's captures are collected by one walk (collect_free_vars), which
;; used to give up silently on every expression kind it had no arm for: the
;; lambda lifted as captureless and its body named a variable that was not
;; there.  `(fn [] (atomically (stm (tvar/write tv 5))))` was invalid C
;; ('tv_5' undeclared) -- docs/archive/stm-inside-closure-captured-tvar-undeclared.md
;; -- and so was a dynamic `binding`, `with-handler` or `select` over a capture.
;;
;; Also pinned here: the walk's work stacks were a fixed 256 entries, so a
;; lambda whose body is a `do` of 300 forms overflowed the compiler's heap.
;;
;; The with-handler shapes this walk also missed are in
;; with-handler-literal-lowers-as-handle: a `handle` in this `main` would make
;; it a CPS candidate, and the CPS backend does not lower `tvar/new`.

(defdynamic *lvl* :int 0)

(defn run [f : (fn [] int)] : int (f))

(defn add5 [x : ptr] : ptr
  ```c
  return (void*)(intptr_t)((int64_t)(intptr_t)x + 5);
  ```)

(defn main [] : int
  (let [tv (tvar/new 0)
        k  40]
    ;; stm / atomically / tvar ops over a captured TVar
    (println (run (fn [] : int (do (atomically (stm (tvar/write tv 5))) 1))))   ; 1
    (println (atomically (stm (tvar/cas tv 5 6))))                              ; true
    (println (run (fn [] : int (if (atomically (stm (tvar/modify tv add5) (tvar/cas tv 11 12))) 1 0)))) ; 1
    ;; the same transaction inside a region bracket
    (println (with-region (fn [] : int (if (atomically (stm (tvar/cas tv 12 13))) 7 0))))   ; 7
    ;; dynamic binding whose override is a capture
    (println (run (fn [] : int (binding [*lvl* k] (+ *lvl* 1)))))               ; 41
    ;; a lambda body wider than the walk's old fixed stack
    (println (run (fn [] : int
                   (let [^mut acc k]
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
                   (set! acc (+ acc 1))
