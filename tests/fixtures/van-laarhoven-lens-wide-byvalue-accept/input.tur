;; VBM4 (van-laarhoven-monomorphization-plan): a van Laarhoven lens threads its
;; abstract functor `(f a)` through the mode-B int64 carrier (one word).  A
;; carrier-compatible functor -- a `defopaque ... :int` such as Const/Identity,
;; or a :heap type -- rides the carrier fine.  A WIDE by-value aggregate functor
;; (here Identity is a two-word `:copy` struct, not the one-int64 opaque) does
;; NOT fit in one word; it used to be rejected with TUR-E0309.  Since VBM4
;; graduated `vl-wide-functor` to default-on, it is ALWAYS accepted -- no flag.
;; This fixture runs the wide functor with only the forall/dict flags, proving
;; the graduation: `set-px point-x 99 p` returns a Point with x=99.
;;
;; Since vl-wide-mono also graduated (2026-07-05), this uniquely-resolved SIMPLE
;; lens site (`set-px point-x`) now redirects to a zero-overhead by-value mono
;; body (Path B) by default -- the runtime result is identical (x=99); see
;; van-laarhoven-lens-wide-mono.  The Path A carrier bridge remains the fallback
;; for COMPOSED lenses (van-laarhoven-lens-wide-compose).
(defopaque Const [r a] :int)
(defn mk-const [A] [x : A] : (Const A A) ```c return (int64_t)x; ```)
(defn get-const [R A] [c : (Const R A)] : R ```c return (int64_t)c; ```)
(definstance Functor [(Const r)]
  (fmap [c g] (mk-const (get-const c))))

;; WIDE functor: a two-word `:copy` struct rather than a one-int64 opaque.
(defstruct ^copy Identity [A] (wrapped : A) (tag : int))
(defn mk-id  [A] [x : A]            : (Identity A) (make-struct Identity :wrapped x :tag 0))
(defn run-id [A] [i : (Identity A)] : A            (.wrapped i))
(definstance Functor [Identity]
  (fmap [i g] (mk-id (g (run-id i)))))

(defstruct ^copy ^heap Point [x : int y : int])

(defn point-x [^f] [^Functor f g : (-> int (f int)) s : Point] : (f Point)
  (fmap (g (.x s))
        (fn [nx : int] : Point (make-struct Point :x nx :y (.y s)))))

;; set l b s = run-id (l (\_ -> Identity b) s) -- pins f := Identity (the wide
;; struct) through the nested functor-wrapping function `g`.
(defn set-px
    [l (forall [(f :: * -> *)] [(Functor f)] (-> (-> int (f int)) Point (f Point)))
     b : int s : Point] : Point
  (run-id (l (fn [a : int] : (Identity int) (mk-id b)) s)))

(defn main [] : int
  (let [p (make-struct Point :x 3 :y 4)]
    (let [p3 (set-px point-x 99 p)]
      (println (.x p3))))
  0)
