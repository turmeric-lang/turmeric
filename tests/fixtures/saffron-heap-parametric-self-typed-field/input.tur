#lang saffron
;; self-typed-heap-parametric-field-unsupported, Saffron arm: the monomorph
;; `(Node any)` is a typed pointer whose `val` slot is a two-word tagged box.
(defstruct ^heap Node [A] (val A) (next (Node A)))

(defn main [] : int
  (let [m (make-struct Node 8 (:: 0 (Node any)))
        n (make-struct Node "seven" m)]
    (println (.val n))
    (println (.val (.next n))))
  0)
