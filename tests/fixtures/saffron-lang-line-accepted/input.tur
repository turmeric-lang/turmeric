#lang saffron
;; saffron-lang-line-accepted -- `#lang saffron` is accepted, needs no enable,
;; and a FULLY ANNOTATED Saffron file compiles exactly as the same file under
;; `#lang turmeric` does.
;;
;; (The directive must be the first line -- detect_lang skips spaces and tabs
;; before it, not comments -- so these notes sit under it rather than above.)
;;
;; What this pins is D2: annotations stay legal in Saffron.  Saffron changes
;; exactly one thing -- an UNannotated parameter or return defaults to `any`
;; instead of `int` -- so a program that annotates everything has nothing left
;; for the dialect to change, and must produce identical output under both back
;; ends and under either #lang line.  The `any` defaulting itself is pinned by
;; saffron-default-any and its siblings.
;;
;; saffron GRADUATED at 0.46.0.  The directive is all that is needed: there is
;; no EXPERIMENTS[] row, `--enable=saffron` is TUR-E0310 (the name aged out
;; of GRADUATED[] at 0.71.0), a project
;; manifest can no longer refuse the dialect, and nothing is printed to stderr
;; (TUR-W0060, the prototype lifecycle warning, is gone).  What the `#lang`
;; line still does behind the scenes is set g_opt_dynamic_any, which tells the
;; emitter this build contains a Saffron TU.

(defn add [x : int y : int] : int (+ x y))

(defn describe [n : int] : cstr
  (if (> n 40) "big" "small"))

(defn main [] : int
  (println (add 1 41))
  (println (describe 42))
  (println (describe 1))
  ;; A float, so a reader or numeric-tower surprise would show here rather than
  ;; the fixture only ever exercising ints.
  (println (* 2.5 4.0))
  0)
