;;
;; Phase P1: HAMT structural sharing test

(extern-c free [p :ptr] :void)

(defn ptr= [a : int b : int] : bool
  ```c
  return a == b;
  ```)

(defn alloc-int [x : int] : int
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  *p = (int64_t)x;
  return (int64_t)(intptr_t)p;
  ```)

(defn test-structural-sharing [] : int
  (let [k1 (alloc-int 1)]
    (let [k2 (alloc-int 2)]
      (let [v1 (alloc-int 10)]
        (let [v2 (alloc-int 20)]
          (let [h1 (hamt/hash-ptr (:: k1 ptr<void>))]
            (let [h2 (hamt/hash-ptr (:: k2 ptr<void>))]
              (let [m1 (hamt/new)]
                (let [m2 (hamt/set m1 h1 k1 v1)]
                  (let [m3 (hamt/set m2 h2 k2 v2)]
                    (let [m1-count (hamt/count m1)]
                      (let [m2-count (hamt/count m2)]
                        (let [m2-val1 (hamt/get m2 h1 k1)]
                          (let [m3-count (hamt/count m3)]
                            (let [m3-val1 (hamt/get m3 h1 k1)]
                              (let [m3-val2 (hamt/get m3 h2 k2)]
                                (hamt/free m1)
                                (hamt/free m2)
                                (hamt/free m3)
                                (free (:: k1 :ptr))
                                (free (:: k2 :ptr))
                                (free (:: v1 :ptr))
                                (free (:: v2 :ptr))
                                (if (and (= m1-count 0)
                                         (= m2-count 1)
                                         (ptr= m2-val1 v1)
                                         (= m3-count 2)
                                         (ptr= m3-val1 v1)
                                         (ptr= m3-val2 v2))
                                  1
                                  0)))))))))))))))))

(println (test-structural-sharing))
