;; reflected-measures RF3 (docs/archive/reflected-measures-plan.md): the
;; motivating example.  `len` is a named measure -- an uninterpreted function
;; to the solver -- and `(> (len (Cons 1 (Nil))) 0)` used to fall to
;; TUR-W0372 because nothing related `len` to the STRUCTURE of its argument.
;;
;; `^reflect` opts `len` in.  It passes the totality gate (pure, structurally
;; recursive on `xs`, exhaustive match), so the encoder may UNFOLD it at a
;; constructor-headed argument: it asserts
;;   len(Cons(1, Nil)) = 1 + len(Nil)      and      len(Nil) = 0
;; -- two definitional equations, one unit of fuel each -- and linear
;; arithmetic settles `1 > 0`.  Under --strict-refine the crossing must prove,
;; so a missed unfolding is a build failure, not a silent runtime check.
(defdata Lst [] (Cons [hd : int tl : Lst]) (Nil))

(defn ^reflect len [xs : Lst] : int
  (match xs
    (Nil) 0
    (Cons _ t) (+ 1 (len t))))

(defn head-of [xs : #refine{ v : Lst | (> (len v) 0) }] : int
  (match xs
    (Nil) -1
    (Cons h _) h))

(defn main [] : int
  (println (head-of (Cons 1 (Nil))))
  (println "reflect-len-ground")
  0)
