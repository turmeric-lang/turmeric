;; generic-zipper-plan ZP1: the `changed` optimisation.  zip/up returns the
;; stored parent unless something below it was edited, so a walk with no edits
;; allocates no nodes and (zip/root (zip/zipper ops t)) is t itself -- compared
;; as pointers.  After an edit, only the edited path is rebuilt: an unedited
;; sibling subtree is shared between the old and the new tree.
(load "stdlib/str-build.tur")
(load "stdlib/zip.tur")

;; A minimal rose-like tree: a leaf holds an int, a node holds its children.
(defdata ^heap ^copy Tree (Leaf int) (Node (Cons Tree)))

(defn tree-ops [] : (ZipOps Tree)
  (zip/ops (fn [t : Tree] : bool (match t (Leaf _) false (Node _) true))
           (fn [t : Tree] : (Cons Tree) (match t (Leaf _) (tnil) (Node cs) cs))
           (fn [t : Tree cs : (Cons Tree)] : Tree (Node cs))))

(defn n0 [] : Tree (Node (tnil)))
(defn n1 [a : Tree] : Tree (Node (tcons-of a (tnil))))
(defn n2 [a : Tree b : Tree] : Tree (Node (tcons-of a (tcons-of b (tnil)))))
(defn n3 [a : Tree b : Tree c : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tnil))))))
(defn n4 [a : Tree b : Tree c : Tree d : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tcons-of d (tnil)))))))

;; Clojure's vector-zip printing: a node is [k1 k2 ...].
(defn show-kids [cs : (Cons Tree)] : cstr
  (if (tnil? cs)
    ""
    (if (tnil? (ttail cs))
      (show (thead cs))
      (str-concat (str-concat (show (thead cs)) " ") (show-kids (ttail cs))))))

(defn show [t : Tree] : cstr
  (match t
    (Leaf v)  (int->str v)
    (Node cs) (str-concat (str-concat "[" (show-kids cs)) "]")))

(defn show-list [cs : (Cons Tree)] : cstr
  (str-concat (str-concat "(" (show-kids cs)) ")"))

(defn show-at [o : (Option (ZipLoc Tree))] : cstr
  (match o
    (None)   "None"
    (Some z) (show (zip/node z))))

(defn get [o : (Option (ZipLoc Tree))] : (ZipLoc Tree)
  (match o
    (Some z) z
    (None)   (panic "no such location")))

(defn same? [a : Tree b : Tree] : bool (= (:: a :int) (:: b :int)))

(defn walk-to-end [z : (ZipLoc Tree)] : (ZipLoc Tree)
  (if (zip/end? z) z (walk-to-end (zip/next z))))

(defn second-child [t : Tree] : Tree
  (match t
    (Leaf _)  t
    (Node cs) (thead (ttail cs))))

(defn main [] : int
  (let [t (n3 (Leaf 1) (n2 (Leaf 2) (Leaf 3)) (n1 (Leaf 4)))
        z (zip/zipper (tree-ops) t)]
    (println (same? (zip/root z) t))
    ;; a down / right / down / up / up round trip
    (let [d (get (zip/down (get (zip/right (get (zip/down z))))))]
      (println (same? (zip/node (get (zip/up d))) (second-child t)))
      (println (same? (zip/node (get (zip/up (get (zip/up d))))) t))
      (println (same? (zip/root d) t)))
    ;; a full pre-order walk with no edits
    (println (same? (zip/root (walk-to-end z)) t))
    ;; an edit rebuilds its own path and shares the rest
    (let [e (zip/root (zip/replace (get (zip/down z)) (Leaf 100)))]
      (println (show e))
      (println (same? e t))
      (println (same? (second-child e) (second-child t))))
    ;; replacing a node with ITSELF still counts as an edit, as in Clojure:
    ;; the path is marked changed and rebuilt
    (let [d1 (get (zip/down z))
          r  (zip/root (zip/replace d1 (zip/node d1)))]
      (println (same? r t))
      (println (show r))))
  0)
