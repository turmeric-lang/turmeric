;; proper-tail-calls T2b (docs/archive/proper-tail-calls-plan.md, T-D2): a
;; mutual tail-call cycle that T5 does NOT fuse still runs in constant stack at
;; -O0 -- where the C compiler can promise it.
;;
;; Nine functions in a cycle: one more than T5's member cap (risk TR4), so no
;; fused group forms and each call stays T2's checkless `return c<k+1>(...);`.
;; With identical recorded signatures and nothing address-taken in either body,
;; that call is spelled `TUR_MUSTTAIL return ...;`, and clang (x86-64 /
;; aarch64) must make it a real tail call or reject the program.
;;
;; `requires.musttail` skips this fixture in tests/run.sh where the fixture
;; compiler does not honour the attribute: gcc 13 expands `TUR_MUSTTAIL` to
;; nothing, and there this cycle is ordinary recursion that overflows at -O0 --
;; exactly why T5's `goto` is the floor and musttail is not.  Under `tur jit`
;; c2mir defines __MIRC_MUSTTAIL__ and MIR makes the call a tail jump, and
;; tests/run-jit.sh runs this fixture twice: in the corpus, on the JIT's 1 GiB
;; entry thread, and again on an 8 MiB one, where the cycle overflows unless
;; the calls are jumps (jit-musttail-8mib; jit-musttail-expands-to-nothing).
;; The `flags`
;; file builds at -O0 (`--debug`): at -O2 clang would sibling-call the cycle
;; anyway and the fixture would measure the optimizer.
;;
;; 10,000,004 steps land on c5 (10,000,004 mod 9 = 5).
(defn c0 [n : int] : int (if (= n 0) 0 (c1 (- n 1))))
(defn c1 [n : int] : int (if (= n 0) 1 (c2 (- n 1))))
(defn c2 [n : int] : int (if (= n 0) 2 (c3 (- n 1))))
(defn c3 [n : int] : int (if (= n 0) 3 (c4 (- n 1))))
(defn c4 [n : int] : int (if (= n 0) 4 (c5 (- n 1))))
(defn c5 [n : int] : int (if (= n 0) 5 (c6 (- n 1))))
(defn c6 [n : int] : int (if (= n 0) 6 (c7 (- n 1))))
(defn c7 [n : int] : int (if (= n 0) 7 (c8 (- n 1))))
(defn c8 [n : int] : int (if (= n 0) 8 (c0 (- n 1))))

(defn main [] : int
  (println (c0 10000004))
  0)
