;; CY4: partial application of a rank-2 polymorphic function preserves the
;; forall annotation on its remaining parameter.
(defn apply-poly [x : int f (forall [a] (-> a a))] : int
  (f x))

;; rank2-argument-genericity: the forall promises `a` at every type, so
;; the function passed to it is generic.
(defn id [A] [y : A] : A y)

(defn main [] : int
  (let [g (apply-poly 42)]
    (println (g id)))
  0)
