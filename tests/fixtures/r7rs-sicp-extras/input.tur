#lang r7rs
;; r7rs-srfi-18-216-sicp-plan T0a: (sicp extras), the #lang sicp names SRFI
;; 216 leaves out -- inc, dec, identity, amb -- plus amb-reset!.  The amb
;; cases are sicp-guide.md's: SICP 4.3.2's multiple-dwelling puzzle, all
;; solutions by forced failure, and exhaustion caught by guard.  Runs on both
;; back ends (tests/run.sh and tests/run-turi.sh).
(import (scheme base) (scheme write) (srfi 216) (sicp extras))

(display (list (inc 41) (dec 43) (identity 'x))) (newline)
(display (map inc '(1 2 3))) (newline)

(define (require p) (if (not p) (amb)))

(define (distinct? items)
  (cond ((null? items) true)
        ((null? (cdr items)) true)
        ((member (car items) (cdr items)) false)
        (else (distinct? (cdr items)))))

;; SICP 4.3.2
(define (multiple-dwelling)
  (let ((baker (amb 1 2 3 4 5))
        (cooper (amb 1 2 3 4 5))
        (fletcher (amb 1 2 3 4 5))
        (miller (amb 1 2 3 4 5))
        (smith (amb 1 2 3 4 5)))
    (require
     (distinct? (list baker cooper fletcher miller smith)))
    (require (not (= baker 5)))
    (require (not (= cooper 1)))
    (require (not (= fletcher 5)))
    (require (not (= fletcher 1)))
    (require (> miller cooper))
    (require (not (= (abs (- smith fletcher)) 1)))
    (require (not (= (abs (- fletcher cooper)) 1)))
    (list (list 'baker baker)
          (list 'cooper cooper)
          (list 'fletcher fletcher)
          (list 'miller miller)
          (list 'smith smith))))

(display (multiple-dwelling)) (newline)

;; Every solution, by failing after recording each one.  The last (amb)
;; exhausts the search; guard catches it.
(amb-reset!)
(define found '())
(define (an-integer-between lo hi)
  (require (<= lo hi))
  (amb lo (an-integer-between (+ lo 1) hi)))
(define (pythagorean-triples n)
  (let* ((i (an-integer-between 1 n))
         (j (an-integer-between i n))
         (k (an-integer-between j n)))
    (require (= (+ (* i i) (* j j)) (* k k)))
    (list i j k)))
(guard (e ((error-object? e)
           (display (reverse found)) (newline)
           (display (error-object-message e)) (newline)))
  (let ((t (pythagorean-triples 15)))
    (set! found (cons t found))
    (amb)))

;; A fresh search after reset does not resume the old one.
(amb-reset!)
(display (let ((x (amb 1 2 3))) (require (> x 1)) x)) (newline)
