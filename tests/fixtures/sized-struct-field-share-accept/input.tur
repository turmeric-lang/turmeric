; P2 of docs/archive/history/ecs-e2c-sized-dense-needs-bounded-world.md asked
; whether `defstruct` threads a shared size parameter through every
; field's type at projection time.  This fixture demonstrates that it
; does -- the elaborator substitutes the struct's `m` parameter into
; both `(.pos w)` and `(.vel w)`, so a function declared on
; `(World (Static 2) A B)` can zip those projections through a
; signature whose shared size variable `n` unifies cleanly across
; both arguments.
;
; `make-world` constructs a World via `make-struct`.  This used to hit a
; codegen lowering bug: when a struct type parameter (`m`) does not appear
; directly as a field type -- only threaded through a field's opaque type
; application `(Dense m A)` -- make-struct collapsed the initializer cast to
; `(int64_t){.pos = ..., .vel = ...}`, an invalid designated initializer on a
; non-aggregate.  The fix keys the cast off the struct's mangled C name, so
; both the all-phantom World and a mixed phantom/by-value struct lower to their
; real aggregates.  See also tests/fixtures/make-struct-phantom-typeparam.

(defdata Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defopaque Dense [n A] :int)

; `m` is the shared size parameter; both fields carry it -- only ever inside
; the opaque `(Dense m A)` / `(Dense m B)` applications, never as a bare field
; type, so `m` is a phantom parameter.
(defstruct World [m A B] (pos (Dense m A)) (vel (Dense m B)))

; Mixed phantom/by-value struct: `m`/`A` are phantom (only inside the opaque
; `(Dense m A)`), but `B` is carried by value in `(raw B)`.  Once `B` resolves
; this must monomorphise to a real aggregate (`Cell__int__int__int`), not the
; int64 carrier.
(defstruct Cell [m A B] (idx (Dense m A)) (raw B))

(defn dn [n A] [] : (Dense n A)
  (:: 0 :Dense))

(defn dense->int [n A] [d : (Dense n A)] : int
  (:: d :int))

(defn zip [A B] [xs : (Dense n A) ys : (Dense n B)] : int
  0)

; The structural P2 probe: the function body type-checks because the
; elaborator substitutes `m` -> (Static 2) into both field types, so
; both projections have type `(Dense (Static 2) X)` and zip's `n`
; unifies to (Static 2) once across both arguments.
(defn use-world [A B] [w : (World (Static 2) A B)] : int
  (zip (.pos w) (.vel w)))

(defn main [] : int
  (let [w   (make-struct World (dn) (dn))
        c   (make-struct Cell (dn) 0)]
    (println (+ (dense->int (.pos w))
                (+ (dense->int (.vel w))
                   (+ (dense->int (.idx c)) (.raw c))))))
  0)
