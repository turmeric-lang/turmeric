;; Phase T24: async-file — async write to a temp file, read it back.
;;
;; Two fibers run under the scheduler:
;;   1. Writer: opens tur-async-file-test.txt under TUR_TEST_TMPDIR, writes "hello async world",
;;      closes the file, then prints "wrote".
;;   2. Reader: sleeps briefly to ensure writer finishes, opens the file,
;;      reads contents, prints them, closes the file.
;;
;; Note: On regular files, O_NONBLOCK doesn't actually make reads/writes
;; non-blocking on most OSes (including macOS/Linux). But the API still works
;; correctly — reads/writes just complete immediately rather than parking.
;;
;; Expected output:
;;   start
;;   wrote 17 bytes
;;   read 17 bytes: hello async world
;;   all done

;; Note: open/write/read/close are available via the headers included in the
;; runtime preamble (unistd.h, fcntl.h) — no extern-c needed.

(defn mk-scheduler [] : ptr<void>
  ```c
  TurScheduler *s = tur_scheduler_new();
  tur_scheduler = s;
  return (void *)s;
  ```)

(defn mk-fiber [fn : ptr<void>] : ptr<void>
  ```c
  return (void *)tur_fiber_block_new((void(*)(void))fn, 0);
  ```)

(defn sched-spawn [s : ptr<void> f : ptr<void>] : nil
  ```c
  tur_scheduler_spawn((TurScheduler *)s, (FiberBlock *)f);
  ```)

(defn sched-run [s : ptr<void>] : nil
  ```c
  tur_scheduler_run((TurScheduler *)s);
  ```)

(defn timer-sleep-ms [ms : int] : nil
  ```c
  if (ms <= 0) return;
  FiberBlock *me = tur_current_fiber;
  if (!me || !tur_scheduler) return;
  if (!tur_global_timers) tur_global_timers = tur_timer_wheel_new();
  int64_t deadline = tur_monotonic_ns() + (int64_t)ms * 1000000LL;
  tur_timer_wheel_insert(tur_global_timers, deadline,
      tur_scheduler_unpark_cb, me);
  me->parked = 1;
  tur_fiber_block_yield(0);
  ```)

;; --- Fiber bodies ---

(defn fiber-writer [] : nil
  ```c
  /* Scratch path resolved at run time -- see the tmp-path helper note.
   * A native Windows binary resolves a leading "/tmp" against the drive
   * root, which need not exist; tests/run.sh exports TUR_TEST_TMPDIR. */
  char __p[512];
  {
    const char *__d = getenv("TUR_TEST_TMPDIR");
    if (!__d || !*__d) __d = "/tmp";
    snprintf(__p, sizeof __p, "%s/%s", __d, "tur-async-file-test.txt");
  }
  int fd = open(__p, O_WRONLY | O_CREAT | O_TRUNC, 0644);
  if (fd < 0) { fprintf(stderr, "open write failed\n"); abort(); }
  const char *msg = "hello async world";
  ssize_t n = write(fd, msg, 17);
  close(fd);
  printf("wrote %d bytes\n", (int)n);
  ```)

(defn fiber-reader [] : nil
  ```c
  /* Sleep briefly to let writer finish */
  FiberBlock *me = tur_current_fiber;
  if (!tur_global_timers) tur_global_timers = tur_timer_wheel_new();
  int64_t deadline = tur_monotonic_ns() + 50LL * 1000000LL;
  tur_timer_wheel_insert(tur_global_timers, deadline,
      tur_scheduler_unpark_cb, me);
  me->parked = 1;
  tur_fiber_block_yield(0);

  /* Scratch path resolved at run time -- see the tmp-path helper note.
   * A native Windows binary resolves a leading "/tmp" against the drive
   * root, which need not exist; tests/run.sh exports TUR_TEST_TMPDIR. */
  char __p[512];
  {
    const char *__d = getenv("TUR_TEST_TMPDIR");
    if (!__d || !*__d) __d = "/tmp";
    snprintf(__p, sizeof __p, "%s/%s", __d, "tur-async-file-test.txt");
  }
  int fd = open(__p, O_RDONLY, 0);
  if (fd < 0) { fprintf(stderr, "open read failed\n"); abort(); }
  char buf[256];
  memset(buf, 0, 256);
  ssize_t n = read(fd, buf, 255);
  close(fd);
  printf("read %d bytes: %s\n", (int)n, buf);
  ```)

(defn main [] : int
  (println "start")
  (let [s (mk-scheduler)]
    (sched-spawn s (mk-fiber fiber-writer))
    (sched-spawn s (mk-fiber fiber-reader))
    (sched-run s)
    (println "all done")
    0))
