;; Typed Closure Invocation ABI (closure-typed-invocation-abi-plan, Phase 1):
;; round-trip a :ptr<void> -> :ptr<void> closure through TUR_APPLY1_T.  The
;; macro casts slot 0 to void * (*)(void *, int64_t) -- an untyped ptr<void>
;; PARAMETER is the word in a closure slot, its result stays void * -- so the
;; pointer passes through untouched and the cell it points at survives the
;; call.

(defn make-cell [v : int] : ptr<void>
  ```c
  int64_t *c = (int64_t *)malloc(sizeof(int64_t));
  *c = v;
  return (void *)c;
  ```)

(defn read-cell [p : ptr<void>] : int
  ```c
  return *(int64_t *)(intptr_t)p;
  ```)

(defn call-p [f : ptr<void> p : ptr<void>] : ptr<void>
  ```c
  return TUR_APPLY1_T(void *, int64_t, f, p);
  ```)

(defn make-pick [n : int] : ptr<void>
  (fn [p : ptr<void>] : ptr<void> (if (> n 0) p p)))

(defn main [] : int
  (let [f    (make-pick 1)
        cell (make-cell 99)
        out  (call-p f cell)]
    (println (read-cell out))
    0))
