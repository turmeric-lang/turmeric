; Phase SZ2: SizedBuf -- flat contiguous buffer with heap allocation.
; Tests sized-buf-new, sized-buf-new-zeroed, sized-buf-free, sized-buf-len,
; sized-buf-get, sized-buf-set!, sized-buf-fill!, sized-buf-sum,
; sized-buf-min, sized-buf-max, sized-buf-copy!, and sized-buf-size.

(defdata Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defn size-eval [s : Size] : int
  (match s (Static n) n (Add s1 s2) (+ (size-eval s1) (size-eval s2))
             (Mul s1 s2) (* (size-eval s1) (size-eval s2))))

(defn sized-buf-new [n] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *b = malloc(sizeof(*b));
  b->len  = n;
  b->data = n > 0 ? (int64_t *)malloc((size_t)n * sizeof(int64_t)) : NULL;
  return (int64_t)(intptr_t)b;
  ```)

(defn sized-buf-new-zeroed [n] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *b = malloc(sizeof(*b));
  b->len  = n;
  b->data = n > 0 ? (int64_t *)calloc((size_t)n, sizeof(int64_t)) : NULL;
  return (int64_t)(intptr_t)b;
  ```)

(defn sized-buf-free [b] #fx{Unsafe} : nil
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (buf->data) free(buf->data);
  free(buf);
  ```)

(defn sized-buf-len [b] #fx{Unsafe} : int
  ```c
  return ((struct { int64_t len; int64_t *data; } *)(intptr_t)b)->len;
  ```)

(defn sized-buf-get [b i] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (i >= 0 && i < buf->len) return buf->data[i];
  fprintf(stderr, "sized-buf-get: index out of bounds\n"); exit(1);
  ```)

(defn sized-buf-set! [b i v] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (i >= 0 && i < buf->len) { buf->data[i] = v; return b; }
  fprintf(stderr, "sized-buf-set!: index out of bounds\n"); exit(1);
  ```)

(defn sized-buf-fill! [b v] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  for (int64_t i = 0; i < buf->len; i++) buf->data[i] = v;
  return b;
  ```)

(defn sized-buf-copy! [dst src] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *d = (void*)(intptr_t)dst;
  struct { int64_t len; int64_t *data; } *s = (void*)(intptr_t)src;
  if (d->len != s->len) { fprintf(stderr, "sized-buf-copy!: length mismatch\n"); exit(1); }
  memcpy(d->data, s->data, (size_t)d->len * sizeof(int64_t));
  return dst;
  ```)

(defn sized-buf-sum [b] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  int64_t s = 0;
  for (int64_t i = 0; i < buf->len; i++) s += buf->data[i];
  return s;
  ```)

(defn sized-buf-min [b] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (buf->len == 0) { fprintf(stderr, "sized-buf-min: empty\n"); exit(1); }
  int64_t m = buf->data[0];
  for (int64_t i = 1; i < buf->len; i++) if (buf->data[i] < m) m = buf->data[i];
  return m;
  ```)

(defn sized-buf-max [b] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (buf->len == 0) { fprintf(stderr, "sized-buf-max: empty\n"); exit(1); }
  int64_t m = buf->data[0];
  for (int64_t i = 1; i < buf->len; i++) if (buf->data[i] > m) m = buf->data[i];
  return m;
  ```)

(defn sized-buf-size [b] #fx{Unsafe} : Size
  (Static (sized-buf-len b)))

(defn main [] : int
  ; new-zeroed + set + get
  (let [b (unsafe (sized-buf-new-zeroed 4))]
    (unsafe (sized-buf-set! b 0 100))
    (unsafe (sized-buf-set! b 1 200))
    (unsafe (sized-buf-set! b 2 300))
    (unsafe (sized-buf-set! b 3 400))
    (println (unsafe (sized-buf-len b)))
    (println (unsafe (sized-buf-get b 0)))
    (println (unsafe (sized-buf-get b 3)))
    (println (unsafe (sized-buf-sum b)))
    (println (unsafe (sized-buf-min b)))
    (println (unsafe (sized-buf-max b)))
    ; copy into a second buffer, verify
    (let [c (unsafe (sized-buf-new 4))]
      (unsafe (sized-buf-copy! c b))
      (println (unsafe (sized-buf-sum c)))
      (unsafe (sized-buf-free c)))
    (unsafe (sized-buf-free b)))
  ; fill
  (let [b2 (unsafe (sized-buf-new 5))]
    (unsafe (sized-buf-fill! b2 3))
    (println (unsafe (sized-buf-sum b2)))
    (unsafe (sized-buf-free b2)))
  ; empty buffer
  (let [b3 (unsafe (sized-buf-new-zeroed 0))]
    (println (unsafe (sized-buf-len b3)))
    (unsafe (sized-buf-free b3)))
  ; sized-buf-size returns Size
  (let [b4 (unsafe (sized-buf-new-zeroed 7))]
    (println (size-eval (unsafe (sized-buf-size b4))))
    (unsafe (sized-buf-free b4)))
  0)
