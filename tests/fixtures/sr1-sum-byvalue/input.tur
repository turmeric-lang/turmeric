;; SR1 (docs/archive/sum-representation-plan.md): a non-recursive multi-variant
;; sum flows BY VALUE as a tag + union aggregate, not the int64 heap carrier.
;; This is the fix for docs/archive/multi-variant-adts-always-heap-allocate.md:
;; the constructor no longer mallocs, and a value that is never boxed has
;; nothing to leak.  The expected.c snapshot pins the `static tur_adt_Shape
;; ctor_Circle(...)` shape -- a by-value return with no malloc in sight.
;;
;; What it exercises beyond the layout: the tag survives (a by-value sum still
;; dispatches on `tag`, and a NULLARY variant must store one -- the by-value
;; ctor emitter used to assume "byval implies single-variant flat product" and
;; returned an UNINITIALISED struct, printing the wrong arm's answer with no
;; build error); an inline by-value aggregate FIELD (Pt inside Dot) is read
;; straight out of the union slot rather than unboxed from a carrier; and a
;; float payload would show truncation if the field crossing were wrong.

(defdata Pt (Pt [x : float y : float]))

(defdata ^copy Shape
  (Circle [radius : int])
  (Rect   [w : int h : int])
  (Dot    [p : Pt])
  (Nowhere))

(defn area [s : Shape] : int
  (match s
    (Circle r)  (* 3 (* r r))
    (Rect w h)  (* w h)
    (Dot p)     0
    (Nowhere)   -1))

(defn dot-x [s : Shape] : float
  (match s
    (Dot p)     (match p (Pt x y) x)
    (Circle r)  0.0
    (Rect w h)  0.0
    (Nowhere)   0.0))

;; A construction-heavy loop: under the carrier representation every iteration
;; malloc'd a box nothing ever freed.  By value it allocates nothing at all.
(defn sum-areas [i : int acc : int] : int
  (if (= i 0)
    acc
    (sum-areas (- i 1) (+ acc (area (Circle :radius 2))))))

(defn main [] : int
  (println (area (Circle :radius 2)))     ; 12
  (println (area (Rect :w 3 :h 4)))       ; 12
  (println (area (Nowhere)))              ; -1  (nullary variant carries a tag)
  (println (dot-x (Dot :p (Pt 7.1 2.0)))) ; 7.1 (inline by-value field)
  (println (sum-areas 1000 0))            ; 12000
  0)
