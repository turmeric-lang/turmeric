;; caret-type-attributes-plan P3: the keyword spelling of a type declaration's
;; flags still compiles and means what the attribute does, but each declaration
;; warns once (TUR-D0007).  See errors/type-decl-keyword-flag-deprecated for
;; the --Werror=deprecated case.
(defstruct Point :copy [x : int y : int])
(defopaque Lease :int :affine)
(defdata Shape :copy (Circle int) (Square int))

(defn area [s : Shape] : int
  (match s
    (Circle r) (* r r)
    (Square w) (* w w)))

(defn main [] : int
  (let [p (Point 3 4)]
    (println (+ (.x p) (.y p)))
    (println (+ (.x p) (.y p))))
  (println (area (Circle 5)))
  0)
