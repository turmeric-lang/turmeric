; Phase HRT1: rank-2 apply — calls a rank-2 poly fn on two different arguments.
(defn apply-twice [f (forall [a] (-> a a)) x : int y : int] : int
  (let [r1 (f x)
        r2 (f y)]
    (+ r1 r2)))

(defn twice [x : int] : int
  (* x 2))

; The functions passed to the rank-2 parameters below are not generic, so
; each is ascribed to the parameter's forall type -- the trusted opt-out of
; rank2-argument-genericity, which asserts what the checker cannot see.
(defn main [] : int
  (println (apply-twice (:: twice (forall [a] (-> a a))) 3 5))
  0)
