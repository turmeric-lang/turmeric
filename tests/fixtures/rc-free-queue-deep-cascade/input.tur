; rc-free-queue-drain-quadratic
; (docs/archive/history/rc-free-queue-drain-is-quadratic.md).
;
; The deferred free queue exists so that releasing a deeply nested rc structure
; runs at CONSTANT stack depth instead of recursing once per link -- that is the
; promise in rc_free_queue.h.  Two things broke it:
;
;   1. The drain popped from the front and memmoved the remainder down one slot
;      on EVERY pop, so draining n blocks moved ~n^2/2 pointers.  Measured at
;      378 ms to free 65,000 blocks; 2M alloc/drop pairs took 11.5 s.
;
;   2. The struct-field drop glue calls rc_free_queue_drain() itself, and that
;      glue runs from INSIDE the drain.  The nested call carried on freeing, so
;      the cascade recursed one C stack frame per link after all -- a 200k-deep
;      chain died with an AddressSanitizer stack-overflow, in exactly the case
;      the queue was built to handle.
;
; Building a chain this deep and dropping it exercises both: the drain walks
; ~100k blocks, and every link's drop glue pushes its child and re-enters the
; drain.  A regression in either shows up here as a crash or a timeout rather
; than as a wrong number.
(defstruct ^move Node [next : rc<Node>])

(defn null-rc-node [] : ptr<void>
  ```c
  return NULL;
  ```)

(defn live [] : int
  ```c
  extern uint32_t gc_all_blocks_count;
  return (int64_t)gc_all_blocks_count;
  ```)

; Each link holds the previous head, so releasing the final head cascades all
; the way down.
(defn build [depth : int] : int
  (let [^mut h (rc/of (make-struct Node (null-rc-node)))
        ^mut i 0]
    (while (< i depth)
      (set! h (rc/of (make-struct Node (rc/clone h))))
      (set! i (+ i 1))))
  0)

(defn main [] : int
  (build 100000)
  (println (live))   ; every block released -> 0
  0)
