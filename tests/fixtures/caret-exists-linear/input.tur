;; caret-type-attributes-plan P0: `(exists ^linear [a] ...)` is the attribute
;; spelling of `(exists :linear [a] ...)` (see exg6-linear-ok).
(defclass Show [a]
  (show [x] : cstr))

(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(defn main [] : int
  (let [e (pack 7 (exists ^linear [a] [(Show a)] a))]
    (open e [_ v]
      (println (.show v))))
  0)
