;; Phase T24: async-echo-server — async TCP echo server + client.
;;
;; Two fibers run under the scheduler:
;;   1. Server: listens on a port, accepts one connection, reads a message,
;;      sends it back (echo), closes the connection.
;;   2. Client: sleeps briefly to let server start, connects, sends a message,
;;      reads the echo, prints it, closes.
;;
;; Expected output:
;;   start
;;   server listening
;;   client connected
;;   server got: hello echo
;;   client got: hello echo
;;   all done

(defn mk-scheduler [] : ptr<void>
  ```c
  TurScheduler *s = tur_scheduler_new();
  tur_scheduler = s;
  return (void *)s;
  ```)

(defn mk-fiber [fn : ptr<void>] : ptr<void>
  ```c
  return (void *)tur_fiber_block_new((void(*)(void))fn, 0);
  ```)

(defn sched-spawn [s : ptr<void> f : ptr<void>] : nil
  ```c
  tur_scheduler_spawn((TurScheduler *)s, (FiberBlock *)f);
  ```)

(defn sched-run [s : ptr<void>] : nil
  ```c
  tur_scheduler_run((TurScheduler *)s);
  ```)

(defn timer-sleep-ms [ms : int] : nil
  ```c
  if (ms <= 0) return;
  FiberBlock *me = tur_current_fiber;
  if (!me || !tur_scheduler) return;
  if (!tur_global_timers) tur_global_timers = tur_timer_wheel_new();
  int64_t deadline = tur_monotonic_ns() + (int64_t)ms * 1000000LL;
  tur_timer_wheel_insert(tur_global_timers, deadline,
      tur_scheduler_unpark_cb, me);
  me->parked = 1;
  tur_fiber_block_yield(0);
  ```)

;; We use port 0 to let the OS assign an ephemeral port, then store it
;; in a global so the client can connect.
;; For simplicity, use a fixed port with SO_REUSEADDR.

(defn fiber-server [] : nil
  ```c
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) { perror("socket"); abort(); }
  int opt = 1;
  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
  int flags = fcntl(fd, F_GETFL, 0);
  fcntl(fd, F_SETFL, flags | O_NONBLOCK);

  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family = AF_INET;
  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  addr.sin_port = htons(19847);
  if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) { perror("bind"); abort(); }
  if (listen(fd, 1) < 0) { perror("listen"); abort(); }
  printf("server listening\n");

  /* Accept — park until connection arrives */
  int cfd;
  while (1) {
    cfd = accept(fd, NULL, NULL);
    if (cfd >= 0) break;
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      FiberBlock *me = tur_current_fiber;
      tur_io_register(fd, TUR_IO_READ, me);
      me->parked = 1;
      tur_fiber_block_yield(0);
      continue;
    }
    perror("accept"); abort();
  }
  int cflags = fcntl(cfd, F_GETFL, 0);
  fcntl(cfd, F_SETFL, cflags | O_NONBLOCK);

  /* Read message */
  char buf[256];
  memset(buf, 0, 256);
  ssize_t n;
  while (1) {
    n = recv(cfd, buf, 255, 0);
    if (n > 0) break;
    if (n == 0) break; /* client closed */
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      FiberBlock *me = tur_current_fiber;
      tur_io_register(cfd, TUR_IO_READ, me);
      me->parked = 1;
      tur_fiber_block_yield(0);
      continue;
    }
    break;
  }
  printf("server got: %s\n", buf);

  /* Echo back */
  while (1) {
    ssize_t w = send(cfd, buf, (size_t)n, 0);
    if (w >= 0) break;
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      FiberBlock *me = tur_current_fiber;
      tur_io_register(cfd, TUR_IO_WRITE, me);
      me->parked = 1;
      tur_fiber_block_yield(0);
      continue;
    }
    break;
  }

  close(cfd);
  close(fd);
  ```)

(defn fiber-client [] : nil
  ```c
  /* Brief sleep to let server start listening */
  FiberBlock *me = tur_current_fiber;
  if (!tur_global_timers) tur_global_timers = tur_timer_wheel_new();
  int64_t deadline = tur_monotonic_ns() + 50LL * 1000000LL;
  tur_timer_wheel_insert(tur_global_timers, deadline,
      tur_scheduler_unpark_cb, me);
  me->parked = 1;
  tur_fiber_block_yield(0);

  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd < 0) { perror("socket"); abort(); }
  int flags = fcntl(fd, F_GETFL, 0);
  fcntl(fd, F_SETFL, flags | O_NONBLOCK);

  struct sockaddr_in addr;
  memset(&addr, 0, sizeof(addr));
  addr.sin_family = AF_INET;
  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  addr.sin_port = htons(19847);

  int ret = connect(fd, (struct sockaddr *)&addr, sizeof(addr));
  if (ret < 0 && errno == EINPROGRESS) {
    me = tur_current_fiber;
    tur_io_register(fd, TUR_IO_WRITE, me);
    me->parked = 1;
    tur_fiber_block_yield(0);
    /* Check connection result */
    int err = 0;
    socklen_t errlen = sizeof(err);
    getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &errlen);
    if (err != 0) { fprintf(stderr, "connect failed: %d\n", err); abort(); }
  } else if (ret < 0) {
    perror("connect"); abort();
  }
  printf("client connected\n");

  /* Send message */
  const char *msg = "hello echo";
  send(fd, msg, 10, 0);

  /* Read echo */
  char buf[256];
  memset(buf, 0, 256);
  while (1) {
    ssize_t n = recv(fd, buf, 255, 0);
    if (n > 0) break;
    if (n == 0) break;
    if (errno == EAGAIN || errno == EWOULDBLOCK) {
      me = tur_current_fiber;
      tur_io_register(fd, TUR_IO_READ, me);
      me->parked = 1;
      tur_fiber_block_yield(0);
      continue;
    }
    break;
  }
  printf("client got: %s\n", buf);
  close(fd);
  ```)

(defn main [] : int
  (println "start")
  (let [s (mk-scheduler)]
    (sched-spawn s (mk-fiber fiber-server))
    (sched-spawn s (mk-fiber fiber-client))
    (sched-run s)
    (println "all done")
    0))
