;; mxwalk -- mutually recursive Syntax walkers, the callee of each defined
;; after its caller (see input.tur).
(defmodule mxwalk
  (export count-syms first-sym)
  ;; count-list is called before it is defined.
  (defn count-syms [f : Syntax] : int
    (if (syntax-sym? f) 1 (count-list f 0)))
  (defn count-list [f : Syntax i : int] : int
    (if (syntax-list? f)
      (if (< i (syntax-len f))
        (+ (count-syms (syntax-nth f i)) (count-list f (+ i 1)))
        0)
      0))
  ;; a Syntax result through a forward reference: the first symbol, depth first
  (defn first-sym [f : Syntax] : Syntax
    (if (syntax-sym? f) f (first-in f 0)))
  (defn first-in [f : Syntax i : int] : Syntax
    (if (and (syntax-list? f) (< i (syntax-len f)))
      (let [s (first-sym (syntax-nth f i))]
        (if (syntax-sym? s) s (first-in f (+ i 1))))
      (int->syntax 0))))
