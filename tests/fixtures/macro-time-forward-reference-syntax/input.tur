;; macro-time-forward-reference-typed-int: macro-time code calling a helper
;; defined LATER typed its `Syntax` parameters as the `int` placeholder, so
;; a mutually recursive walker -- in a :for-macros module or in a defmacro*
;; letrec -- failed at its definition: "function 'count-list' arg 1:
;; expected int, got Syntax".  The forward-declare pre-pass commits `Syntax`
;; now, for parameters and results.
(defmodule main
  (import mxwalk :for-macros)
  (defmacro* nsyms [f] (int->syntax (count-syms f)))
  (defmacro* head-sym [f] (first-sym f))
  (defmacro* nsyms-letrec [f]
    (letrec [cs (fn [g : Syntax] : int (if (syntax-sym? g) 1 (cl g 0)))
             cl (fn [g : Syntax i : int] : int
                  (if (syntax-list? g)
                    (if (< i (syntax-len g)) (+ (cs (syntax-nth g i)) (cl g (+ i 1))) 0)
                    0))]
      (int->syntax (cs f))))
  (defn main [] : int
    (let [x 41]
      (println (nsyms (a (b c) 1)))          ; 3
      (println (nsyms-letrec (a (b (c d))))) ; 4
      (println (+ (head-sym (1 (2 x) y)) 1))) ; x + 1 = 42
    0))
