;; Slice 2 (constrained-hkt-forall-plan): a typeclass constraint on a rank-2
;; `forall` parameter.  `use-show` accepts a poly fn `forall a. Show a => a ->
;; cstr` and applies it at `a = int` inside its body.  The constraint is
;; re-discharged at that instantiation site: `Show int` must be in scope
;; (it is).  HRT is type-erased, so the passed monomorphic function carries
;; the behavior directly -- the constraint is a static obligation, not a
;; runtime dictionary.
(defclass Show [a] (show [x] : cstr))
(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

;; rank2-argument-genericity: the forall promises `a` at every type, so
;; the function passed to it is generic (and
;; carries the same constraint).
(defn my-show [A] [(Show A)] [x : A] : cstr (show x))

(defn use-show [f (forall [a] [(Show a)] (-> a cstr))] : cstr
  (f 42))

(defn main [] : int
  (println (use-show my-show))
  0)
