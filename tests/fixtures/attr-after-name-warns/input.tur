;; caret-type-attributes-plan P5: the earlier spellings still compile and mean
;; the same, with one TUR-D0008 warning per attribute: a defeffect's trailing
;; ^extends / ^capability, a defn's #[no-unwind] / #[used] and (export-as "c").
(defeffect Disk [] : nil ^capability)
(defeffect Write [s : cstr] : nil ^extends Disk)

(defn #[no-unwind] #[used] first [x : int] : int {x + 1})
(defn (export-as "attrs_second") second [x : int] : int {x * 2})

(defn main [] : int
  (println (first 1))
  (println (second 4))
  0)
