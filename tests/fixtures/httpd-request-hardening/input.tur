;; security-audit-plan M-4: the httpd request path, driven without a socket.
;;
;; httpd-parse-head is the one parser both server loops share (and the one
;; tests/fuzz drives).  It used to read Content-Length with `(int)strtol`, so
;; 4294967306 became 10, "10abc" became 10 and "-1" became 0; it ignored
;; Transfer-Encoding, so a chunked body was read as the next request; and it
;; sized the body malloc from the header with no cap.  Each refusal below is
;; the status the server now answers with before reading any body.
;;
;; Also here: response headers that would split the response are dropped,
;; the static handler keeps to its root (dotfiles, symlinks out, backslashes),
;; and a long cookie no longer overruns a 2 KiB stack buffer.

(load "stdlib/httpd.tur")

(defn new-conn [] : ptr<void>
  ```c return calloc(1, sizeof(HttpdConn)); ```)

(defn free-conn [c : ptr<void>] : void
  ```c httpd_hyconn_hyrelease(c); free(c); ```)

(defn parse [label : cstr req : cstr] : void
  ```c
  HttpdConn *c = (HttpdConn *)calloc(1, sizeof(HttpdConn));
  size_t n = strlen(req);
  char *buf = (char *)malloc(n + 1);
  memcpy(buf, req, n + 1);
  int64_t clen = -1;
  int64_t r = httpd_hyparse_hyhead((void *)c, (void *)buf, (int64_t)n, (void *)&clen);
  if (r < 0) printf("%s: refused %lld\n", label, (long long)-r);
  else printf("%s: %s %s clen=%lld\n", label, c->method, c->path, (long long)clen);
  httpd_hyconn_hyrelease((void *)c);
  free(buf);
  free(c);
  ```)

;; Print the response head with CRLF shown as " | ".
(defn show-resp-head [c : ptr<void>] : void
  ```c
  int64_t len = 0;
  char *h = (char *)httpd_hyresp_hyhead(c, 1, (void *)&len);
  for (int64_t i = 0; i < len; i++) {
    if (h[i] == '\r') continue;
    if (h[i] == '\n') fputs(" | ", stdout); else putchar(h[i]);
  }
  putchar('\n');
  free(h);
  ```)

;; A scratch tree: root/ok.txt, root/.env, root/link -> ../secret.txt.
(defn make-tree [] : cstr
  ```c
  #include <sys/stat.h>
  static char root[700];
  const char *d = getenv("TUR_TEST_TMPDIR");
  if (!d || !*d) d = "/tmp";
  char base[512];
  snprintf(base, sizeof base, "%s/tur-httpd-hardening-XXXXXX", d);
  if (!mkdtemp(base)) return "";
  snprintf(root, sizeof root, "%s/root", base);
  mkdir(root, 0700);
  char p[800];
  FILE *f;
  snprintf(p, sizeof p, "%s/ok.txt", root);     f = fopen(p, "w"); fputs("ok\n", f); fclose(f);
  snprintf(p, sizeof p, "%s/.env", root);       f = fopen(p, "w"); fputs("SECRET=1\n", f); fclose(f);
  snprintf(p, sizeof p, "%s/secret.txt", base); f = fopen(p, "w"); fputs("secret\n", f); fclose(f);
  snprintf(p, sizeof p, "%s/link", root);
  if (symlink("../secret.txt", p) != 0) return "";
  return root;
  ```)

(defn set-path! [c : ptr<void> path : cstr] : void
  ```c
  HttpdConn *conn = (HttpdConn *)c;
  snprintf(conn->path, sizeof conn->path, "%s", path);
  ```)

(defn serve [root : cstr path : cstr] : void
  (let [c (new-conn)]
    (do
      (set-path! c path)
      (println (if (= (httpd-mw-static-try c root) 1) "served" "refused"))
      (free-conn c))))

(defn long-value [n : int] : cstr
  ```c
  char *s = (char *)malloc((size_t)n + 1);
  memset(s, 'v', (size_t)n);
  s[n] = '\0';
  return s;
  ```)

(defn free-cstr [s : cstr] : void
  ```c free((void *)s); ```)

(defn set-cookie-len [c : ptr<void>] : int
  ```c
  HttpdHeader *h = (HttpdHeader *)((HttpdConn *)c)->resp_headers;
  return h && h->value ? (int64_t)strlen(h->value) : -1;
  ```)

;; WP4's residual items (docs/archive/httpd-residual-request-hardening.md):
;; the request line and keep-alive decision, printed by length so a 1 KiB path
;; does not land in expected.stdout.
(defn parse2 [label : cstr req : cstr] : void
  ```c
  HttpdConn *c = (HttpdConn *)calloc(1, sizeof(HttpdConn));
  size_t n = strlen(req);
  char *buf = (char *)malloc(n + 1);
  memcpy(buf, req, n + 1);
  int64_t clen = -1;
  int64_t r = httpd_hyparse_hyhead((void *)c, (void *)buf, (int64_t)n, (void *)&clen);
  if (r < 0) printf("%s: refused %lld\n", label, (long long)-r);
  else printf("%s: method=%zu path=%zu version=%s keep-alive=%d\n", label,
              strlen(c->method), strlen(c->path), c->version, c->client_keep_alive);
  httpd_hyconn_hyrelease((void *)c);
  free(buf);
  free(c);
  ```)

;; A request whose method (kind 0), path (1) or version (2) is n bytes.
(defn long-req [kind : int n : int] : cstr
  ```c
  char *f = (char *)malloc((size_t)n + 1);
  memset(f, kind == 1 ? 'a' : 'A', (size_t)n);
  if (kind == 1) f[0] = '/';
  f[n] = '\0';
  char *r = (char *)malloc((size_t)n + 64);
  if (kind == 0) sprintf(r, "%s /x HTTP/1.1\r\n\r\n", f);
  else if (kind == 1) sprintf(r, "GET %s HTTP/1.1\r\n\r\n", f);
  else sprintf(r, "GET /x %s\r\n\r\n", f);
  free(f);
  return r;
  ```)

;; mw-log's line for a request with control bytes in its method and path.
(defn log-line [method : cstr path : cstr] : void
  ```c
  HttpdConn *c = (HttpdConn *)calloc(1, sizeof(HttpdConn));
  snprintf(c->method, sizeof c->method, "%s", method);
  snprintf(c->path, sizeof c->path, "%s", path);
  httpd_hymw_hylog_hyemit((void *)c, 5);
  free(c);
  ```)

;; WP4 residual item 10: the multipart parser, driven with a body and a
;; Content-Type of our choosing.  Every '@' in `body` becomes a NUL byte, so a
;; binary part can be written as a literal.  Prints each part's name, filename
;; and byte length, or that no part was found.
(defn mp [label : cstr ctype : cstr body : cstr] : void
  ```c
  typedef struct __HttpdPart {
      char *name; char *filename; char *content_type;
      char *data; int data_len;
      struct __HttpdPart *next;
  } HttpdPart;
  HttpdConn *c = (HttpdConn *)calloc(1, sizeof(HttpdConn));
  char head[512];
  int hn = snprintf(head, sizeof head,
                    "POST /u HTTP/1.1\r\nContent-Type: %s\r\n\r\n", ctype);
  int64_t clen = -1;
  if (httpd_hyparse_hyhead((void *)c, (void *)head, (int64_t)hn, (void *)&clen) < 0) {
      printf("%s: head refused\n", label);
      free(c);
      return;
  }
  size_t bl = strlen(body);
  c->body = (char *)malloc(bl + 1);
  for (size_t i = 0; i <= bl; i++) c->body[i] = body[i] == '@' ? '\0' : body[i];
  c->body_len = (int)bl;
  if (!httpd_hyreq_hymultipart_hyparse((void *)c)) printf("%s: no parts\n", label);
  for (HttpdPart *pp = (HttpdPart *)c->req_multipart_parts; pp; pp = pp->next)
      printf("%s: name=%s filename=%s len=%d\n", label,
             pp->name ? pp->name : "-", pp->filename ? pp->filename : "-",
             pp->data_len);
  httpd_hyconn_hyrelease((void *)c);
  free(c);
  ```)

;; mw-rate-limit's table, driven without a socket: limit 1 per 60 s, so a
;; second request from an IP inside its window is refused.
(defn print-rl [label : cstr r : int] : void
  ```c printf("%s: %s\n", label, r > 0 ? "429" : "ok"); ```)

(defn rl [label : cstr st : int ip : cstr] : void
  (print-rl label (httpd-mw-ratelimit-check st ip)))

;; One request each from n distinct IPs.
(defn rl-flood [st : int n : int] : void
  ```c
  char ip[32];
  for (int64_t i = 0; i < n; i++) {
      snprintf(ip, sizeof ip, "10.9.%d.%d", (int)(i / 256), (int)(i % 256));
      (void)httpd_hymw_hyratelimit_hycheck(st, ip);
  }
  ```)

(defn main [] : int
  (do
    (parse "get"            "GET /a?b=1 HTTP/1.1\r\nHost: x\r\n\r\n")
    (parse "post"           "POST /f HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello")
    (parse "negative"       "POST / HTTP/1.1\r\nContent-Length: -1\r\n\r\n")
    (parse "trailing junk"  "POST / HTTP/1.1\r\nContent-Length: 10abc\r\n\r\n")
    (parse "plus sign"      "POST / HTTP/1.1\r\nContent-Length: +5\r\n\r\n")
    (parse "empty"          "POST / HTTP/1.1\r\nContent-Length: \r\n\r\n")
    (parse "int wrap"       "POST / HTTP/1.1\r\nContent-Length: 4294967306\r\n\r\n")
    (parse "huge"           "POST / HTTP/1.1\r\nContent-Length: 99999999999999999999999\r\n\r\n")
    (parse "dup same"       "POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\n")
    (parse "dup differ"     "POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 30\r\n\r\n")
    (parse "chunked"        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n")
    (parse "cl and te"      "POST / HTTP/1.1\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n")
    (parse "over default"   "POST / HTTP/1.1\r\nContent-Length: 8388609\r\n\r\n")
    (parse "at default"     "POST / HTTP/1.1\r\nContent-Length: 8388608\r\n\r\n")
    (httpd-set-max-body! 16)
    (parse "over 16"        "POST / HTTP/1.1\r\nContent-Length: 17\r\n\r\n")
    (parse "at 16"          "POST / HTTP/1.1\r\nContent-Length: 16\r\n\r\n")
    ;; response splitting: only X-Ok survives
    (let [c (new-conn)]
      (do
        (httpd-resp-header! c "X-Ok" "fine")
        (httpd-resp-header! c "X-Evil" "a\r\nSet-Cookie: pwned=1")
        (httpd-resp-header! c "Bad Name" "x")
        (httpd-resp-header! c "X-Colon:" "x")
        (show-resp-head c)
        (free-conn c)))
    ;; static files
    (let [root (make-tree)]
      (do
        (serve root "/ok.txt")
        (serve root "/ok.txt?v=2")
        (serve root "/.env")
        (serve root "/link")
        (serve root "/../secret.txt")
        (serve root "/a\\..\\ok.txt")
        (serve root "/.well-known/none")))
    ;; WP4 residual: an oversized request-line field is refused, not served
    ;; with the field left empty.
    (let [r (long-req 0 14)] (do (parse2 "method 14" r) (free-cstr r)))
    (let [r (long-req 0 15)] (do (parse2 "method 15" r) (free-cstr r)))
    (let [r (long-req 1 1022)] (do (parse2 "path 1022" r) (free-cstr r)))
    (let [r (long-req 1 1023)] (do (parse2 "path 1023" r) (free-cstr r)))
    (let [r (long-req 2 15)] (do (parse2 "version 15" r) (free-cstr r)))
    ;; Connection is a token list, matched whole.
    (parse2 "conn closed"     "GET / HTTP/1.1\r\nConnection: closed\r\n\r\n")
    (parse2 "conn close"      "GET / HTTP/1.1\r\nConnection: close\r\n\r\n")
    (parse2 "conn list close" "GET / HTTP/1.1\r\nConnection: Upgrade, close\r\n\r\n")
    (parse2 "1.0 keep-alive"  "GET / HTTP/1.0\r\nConnection: keep-alive, Upgrade\r\n\r\n")
    (parse2 "1.0 keep-alives" "GET / HTTP/1.0\r\nConnection: keep-alives\r\n\r\n")
    ;; mw-log escapes the client's control bytes.
    (log-line "GE\tT" "/a\r\nGET /forged 200")
    ;; multipart: the media type must be multipart, `boundary` is a parameter
    ;; matched by name, `name` is never read out of `filename`, and a NUL in
    ;; an uploaded file does not end the scan.
    (mp "mp basic"      "multipart/form-data; boundary=XB"
        "--XB\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nhi\r\n--XB--\r\n")
    (mp "mp not multi"  "text/plain; boundary=XB"
        "--XB\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nhi\r\n--XB--\r\n")
    (mp "mp case"       "Multipart/Form-Data; BOUNDARY=\"XB\""
        "--XB\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nhi\r\n--XB--\r\n")
    (mp "mp decoy"      "multipart/form-data; charset=\"boundary=YY\"; boundary=XB"
        "--XB\r\nContent-Disposition: form-data; name=\"t\"\r\n\r\nhi\r\n--XB--\r\n")
    (mp "mp filename"   "multipart/form-data; boundary=XB"
        "--XB\r\nContent-Disposition: form-data; filename=\"a.bin\"; name=\"up\"\r\n\r\nxyz\r\n--XB--\r\n")
    (mp "mp nul"        "multipart/form-data; boundary=XB"
        "--XB\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nab@cd\r\n--XB\r\nContent-Disposition: form-data; name=\"g\"\r\n\r\nzz\r\n--XB--\r\n")
    ;; a cookie far longer than the old 2 KiB stack buffer
    (let [c (new-conn)
          v (long-value 5000)]
      (do
        (httpd-set-cookie! c (cookie "session" v))
        (println (set-cookie-len c))
        (free-cstr v)
        (free-conn c)))
    ;; mw-rate-limit: the IP is the key -- 10.0.107.237 and 10.2.219.40 share
    ;; an FNV-1a hash and used to share a counter -- and a full table evicts
    ;; rather than failing open (4096 distinct IPs used to leave every later
    ;; IP unlimited).
    (let [st (httpd-mw-ratelimit-new 1 60)]
      (do
        (rl "rl first"             st "10.0.107.237")
        (rl "rl again"             st "10.0.107.237")
        (rl "rl colliding ip"      st "10.2.219.40")
        (rl-flood st 4096)
        (rl "rl after flood"       st "192.0.2.7")
        (rl "rl after flood again" st "192.0.2.7")))
    0))
