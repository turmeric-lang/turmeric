;; generic-zipper-plan ZP1: zip/down, up, left, right, leftmost, rightmost
;; over a user tree, including every None boundary: the root has no parent and
;; no siblings, a leaf has no children, an empty branch has none either, and
;; the ends of a sibling list have no further sibling.
(load "stdlib/str-build.tur")
(load "stdlib/zip.tur")

;; A minimal rose-like tree: a leaf holds an int, a node holds its children.
(defdata ^heap ^copy Tree (Leaf int) (Node (Cons Tree)))

(defn tree-ops [] : (ZipOps Tree)
  (zip/ops (fn [t : Tree] : bool (match t (Leaf _) false (Node _) true))
           (fn [t : Tree] : (Cons Tree) (match t (Leaf _) (tnil) (Node cs) cs))
           (fn [t : Tree cs : (Cons Tree)] : Tree (Node cs))))

(defn n0 [] : Tree (Node (tnil)))
(defn n1 [a : Tree] : Tree (Node (tcons-of a (tnil))))
(defn n2 [a : Tree b : Tree] : Tree (Node (tcons-of a (tcons-of b (tnil)))))
(defn n3 [a : Tree b : Tree c : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tnil))))))
(defn n4 [a : Tree b : Tree c : Tree d : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tcons-of d (tnil)))))))

;; Clojure's vector-zip printing: a node is [k1 k2 ...].
(defn show-kids [cs : (Cons Tree)] : cstr
  (if (tnil? cs)
    ""
    (if (tnil? (ttail cs))
      (show (thead cs))
      (str-concat (str-concat (show (thead cs)) " ") (show-kids (ttail cs))))))

(defn show [t : Tree] : cstr
  (match t
    (Leaf v)  (int->str v)
    (Node cs) (str-concat (str-concat "[" (show-kids cs)) "]")))

(defn show-list [cs : (Cons Tree)] : cstr
  (str-concat (str-concat "(" (show-kids cs)) ")"))

(defn show-at [o : (Option (ZipLoc Tree))] : cstr
  (match o
    (None)   "None"
    (Some z) (show (zip/node z))))

(defn get [o : (Option (ZipLoc Tree))] : (ZipLoc Tree)
  (match o
    (Some z) z
    (None)   (panic "no such location")))

(defn main [] : int
  (let [t (n4 (Leaf 1) (n2 (Leaf 2) (Leaf 3)) (n2 (Leaf 4) (n1 (Leaf 5))) (Leaf 6))
        z (zip/zipper (tree-ops) t)]
    (println (show (zip/node z)))
    ;; the root: no parent, no siblings
    (println (show-at (zip/up z)))
    (println (show-at (zip/left z)))
    (println (show-at (zip/right z)))
    (println (show (zip/node (zip/leftmost z))))
    (println (show (zip/node (zip/rightmost z))))
    (println (zip/depth z))
    (println (show-list (zip/lefts z)))
    (println (show-list (zip/rights z)))
    (println (show-list (zip/ancestors z)))
    (let [c1 (get (zip/down z))]
      ;; the first child: no left sibling, and a leaf has no children
      (println (show (zip/node c1)))
      (println (zip/depth c1))
      (println (zip/branch? c1))
      (println (show-at (zip/left c1)))
      (println (show-at (zip/down c1)))
      (println (show (zip/node (zip/leftmost c1))))
      (let [c2 (get (zip/right c1))
            c4 (zip/rightmost c1)]
        (println (show (zip/node c2)))
        (println (show-at (zip/down c2)))
        (println (show-at (zip/right (get (zip/right (get (zip/down c2)))))))
        ;; the last child: no right sibling
        (println (show (zip/node c4)))
        (println (show-at (zip/right c4)))
        (println (show (zip/node (zip/rightmost c4))))
        (println (show (zip/node (zip/leftmost c4))))
        (let [c3 (get (zip/left c4))]
          (println (show (zip/node c3)))
          (println (show-list (zip/lefts c3)))
          (println (show-list (zip/rights c3)))
          (let [five (get (zip/down (get (zip/right (get (zip/down c3))))))]
            (println (show (zip/node five)))
            (println (zip/depth five))
            (println (show-list (zip/ancestors five)))
            (println (show-at (zip/up five)))
            (println (show-at (zip/up (get (zip/up five)))))
            (let [top (get (zip/up (get (zip/up (get (zip/up five))))))]
              (println (show (zip/node top)))
              (println (show-at (zip/up top)))))))))
  ;; an empty branch is a branch with no children
  (let [e (zip/zipper (tree-ops) (n0))]
    (println (zip/branch? e))
    (println (show-at (zip/down e)))
    (println (tlength (zip/children e))))
  0)
