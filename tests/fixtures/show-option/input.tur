;; SI3: MyShow [MyOption] formats as "some(v)" or "none".
;; Uses a user-defined MyOption struct to avoid conflicts with the built-in option type.
(defclass MyShow [a]
  (show [x] : cstr))

;; MyOption struct: is_some=1 means some(value), is_some=0 means none.
(defstruct ^copy MyOption [is_some : int value : int])

(defn option-some [x] : int
  ```c
  struct { int64_t is_some; int64_t value; } *opt =
      malloc(sizeof(struct { int64_t is_some; int64_t value; }));
  opt->is_some = 1;
  opt->value = x;
  return (int64_t)(intptr_t)opt;
  ```)

(defn option-none [] : int
  ```c
  struct { int64_t is_some; int64_t value; } *opt =
      malloc(sizeof(struct { int64_t is_some; int64_t value; }));
  opt->is_some = 0;
  opt->value = 0;
  return (int64_t)(intptr_t)opt;
  ```)

(definstance MyShow [MyOption]
  (show [x] : cstr
    ```c
    // x is an MyOption struct value; x.is_some and x.value are int64_t.
    if (!x.is_some) return "none";
    char *buf = (char *)malloc(48);
    snprintf(buf, 48, "some(%lld)", (long long)x.value);
    return (const char *)(intptr_t)buf;
    ```))

(defn main [] : int
  (let [s (make-struct MyOption 1 99)]
    (println (.show s)))
  (let [n (make-struct MyOption 0 0)]
    (println (.show n)))
  0)
