;; The carrier bridges the new aggregate-vs-scalar return check must NOT reject.
;;
;; That check (docs/archive/struct-return-type-mismatch-unchecked-until-cc.md)
;; rejects a by-value record ADT under a scalar return, because the two are
;; different C types and the program cannot compile.  Everything below IS a
;; shared representation -- both sides are `int64_t` in the emitted C -- and is
;; the deliberate int64 carrier bridge the return position exists to tolerate.
;; Membership is decided by asking `type_c_name`, the same function codegen uses
;; to spell the type, so these stay accepted without the predicate enumerating
;; them.
;; Both paths must agree with hand evaluation on every line.
(defopaque Handle :int)

;; a transparent int newtype IS its int64 payload
(defn unhandle [h : Handle] : int h)

;; (A by-value parametric ADT under a scalar return, `[o : (Option int)] : int
;; o`, used to sit here as "accepted": it emitted clean only while nothing called
;; it -- a call was "aggregate value used where an integer was expected".  It is
;; rejected now; see tests/fixtures/errors/applied-param-returned-as-int-rejected/.
;; A :heap one is rejected too: tests/fixtures/errors/return-type-heap-app-vs-scalar/.)

;; (A generic returning its `A` as `int`, `(defn generic-carrier [A] [x : A] :
;; int x)`, used to sit here as "accepted" too.  It handed back 7.1's bit
;; pattern and a string's address as the int it declared, and the interpreter
;; disagreed on both.  A declared type variable matches only itself now; see
;; tests/fixtures/errors/declared-tyvar-returned-as-ground/.  `#{Unsafe}` keeps
;; the bridge: tests/fixtures/declared-tyvar-rigid-accepts/.)

;; and the identity case is not a mismatch at all
(defstruct S [a : int])
(defn same [x : S] : S x)

(defn main [] : int
  (println (unhandle (:: 7 :Handle)))          ; 7
  (println (.a (same (S 41))))               ; 41
  (println (.a (S (unhandle (:: 3 :Handle))))) ; 3
  0)
