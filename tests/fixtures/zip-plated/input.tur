;; generic-zipper-plan ZP3: the Plated typeclass.  An instance supplies the
;; three ZipOps functions once, and zip/plated opens a zipper with no ops
;; argument.  The stock instance makes every (Rose A) Plated too.  Each
;; navigation and edit then works exactly as with an explicit ZipOps.
(load "stdlib/str-build.tur")
(load "stdlib/zip.tur")

(defdata Tree :heap :copy (Leaf int) (Node (Cons Tree)))

(definstance Plated [Tree]
  (plate-branch? [t] (match t (Leaf _) false (Node _) true))
  (plate-children [t] (match t (Leaf _) (tnil) (Node cs) cs))
  (plate-rebuild [t cs] (Node cs)))

(defn show-kids [cs : (Cons Tree)] : cstr
  (if (tnil? cs)
    ""
    (if (tnil? (ttail cs))
      (show (thead cs))
      (str-concat (str-concat (show (thead cs)) " ") (show-kids (ttail cs))))))

(defn show [t : Tree] : cstr
  (match t
    (Leaf v)  (int->str v)
    (Node cs) (str-concat (str-concat "[" (show-kids cs)) "]")))

(defn get [o : (Option (ZipLoc Tree))] : (ZipLoc Tree)
  (match o
    (Some z) z
    (None)   (panic "no such location")))

(defn get-rose [o : (Option (ZipLoc (Rose int)))] : (ZipLoc (Rose int))
  (match o
    (Some z) z
    (None)   (panic "no such location")))

(defn double [t : Tree] : Tree
  (match t
    (Leaf v)  (Leaf (* v 2))
    (Node cs) t))

(defn label-sum [z : (ZipLoc (Rose int)) acc : int] : int
  (if (zip/end? z) acc (label-sum (zip/next z) (+ acc (.label (zip/node z))))))

(defn main [] : int
  (let [t (Node (tcons-of (Leaf 1)
                          (tcons-of (Node (tcons-of (Leaf 2) (tcons-of (Leaf 3) (tnil))))
                                    (tnil))))
        z (zip/plated t)]
    ;; the class methods, called directly
    (println (plate-branch? t))
    (println (tlength (plate-children t)))
    (println (show (plate-rebuild t (tnil))))
    ;; a zipper from the instance
    (println (show (zip/node z)))
    (println (zip/branch? (get (zip/down z))))
    (println (show (zip/node (get (zip/right (get (zip/down z)))))))
    (println (show (zip/root (zip/replace (get (zip/down z)) (Leaf 10)))))
    (println (show (zip/edit-all z double)))
    (println (show (zip/root (zip/append-child (get (zip/right (get (zip/down z)))) (Leaf 4)))))
    ;; the ops record built from the instance
    (println (show (zip/root (zip/zipper (:: (zip/plated-ops) (ZipOps Tree)) t))))
    (println (show t)))
  ;; the stock Rose instance
  (let [r (zip/rose 1 (tcons-of (zip/rose 2 (tnil)) (tcons-of (zip/rose 3 (tnil)) (tnil))))]
    (println (label-sum (zip/plated r) 0))
    (println (plate-branch? r))
    (println (.label (zip/node (get-rose (zip/down (zip/plated r)))))))
  0)
