;; defer-reads-let-local, for a Drop local when the scope is left by an early
;; `return` or by a panic: the defer runs, then the widget is released.
;;
;; Compiled only.  Under `tur --interpret` neither exit runs a let's injected
;; drop (docs/reported/turi-early-return-skips-injected-drops.md), so the two
;; engines print different things here for a reason this fixture is not about.
(defopaque ^affine Widget :int)
(defn mk [] : Widget (println "  mk") (:: 1 Widget))
(defn rel [w : Widget] : void (println "  rel") (:: w int) nil)
(definstance Drop [Widget] (drop [x] : void (rel x)))
(defn peek [^borrow w : Widget] : int 1)

(defn boom [c : bool] : int
  (if c (panic "boom") 0))

(defn drop-returns [c : bool] : int
  (let [h (mk)]
    (defer (do (println "  defer")
               (println (peek h))))
    (if c (return 1) nil)
    2))

(defn drop-panics [c : bool] : int
  (let [h (mk)]
    (defer (do (println "  defer")
               (println (peek h))))
    (boom c)
    2))

(defn main [] : int
  (println "returns") (println (drop-returns true)) (println (drop-returns false))
  (println "panics") (catch-unwind (fn [] : int (drop-panics true)))
  (println (drop-panics false))
  0)
