; Phase HRT4: poly fn parameter forwarded to another rank-2 poly fn (pass-through).
; `apply-twice` receives `f` as a poly fn param and re-passes it to `apply-once`.
; The is_poly_fn binding is passed via EX_POLY_WRAP pass-through (no new wrapper).
(defn apply-once [f (forall [a] (-> a a)) x : int] : int
  (f x))

(defn apply-twice [f (forall [a] (-> a a)) x : int] : int
  (apply-once f (apply-once f x)))

(defn inc [x : int] : int (+ x 1))

; The functions passed to the rank-2 parameters below are not generic, so
; each is ascribed to the parameter's forall type -- the trusted opt-out of
; rank2-argument-genericity, which asserts what the checker cannot see.
(defn main [] : int
  (println (apply-twice (:: inc (forall [a] (-> a a))) 10))
  0)
