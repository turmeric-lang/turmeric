;; KB-008 extension: spaced annotation with a forall-quantified (-> a a) type.
;; Ensures the arrow fix handles type-variable arguments inside the annotation.

(defn apply-poly [f : (forall [a] (-> a a)) x : int] : int
  (f x))

;; rank2-argument-genericity: the forall promises `a` at every type, so
;; the function passed to it is generic.
(defn id [A] [x : A] : A x)

(defn main [] : int
  (println (apply-poly id 42))
  0)
