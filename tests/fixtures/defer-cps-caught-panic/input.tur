;; defer-skipped-on-panic-in-cps-function: a `defer` in a CPS-converted
;; function (one that performs an effect, or calls something that does) runs
;; when a caught panic passes through it, exactly as in a function compiled
;; directly -- whichever C function the panic surfaces in.

(defn note [s : cstr] : int
  ```c printf("%s\n", s); fflush(stdout); return 0; ```)

(defn boom [x : int] : int
  (if (> x 0) (panic "boom") x))

;; A defer body that calls a Turmeric function with several statements: the
;; whole body runs on the panic path, not just its first call.
(defn cleanup [tag : cstr] : int
  (note tag)
  (note "  ...and the rest of cleanup")
  0)

(defeffect Ask [] : int)

;; 1. Direct function: the baseline.
(defn direct [x : int] : int
  (defer (cleanup "direct: defer ran"))
  (boom x))

;; 2. CPS function; the panic is in the perform's continuation (after resume).
(defn cps-after-perform [x : int] : int
  (defer (cleanup "cps-after-perform: defer ran"))
  (+ (perform (Ask)) (boom x)))

;; 3. CPS function; the panic is BEFORE the perform, in the entry body.
(defn cps-before-perform [x : int] : int
  (defer (note "cps-before-perform: defer ran"))
  (let [b (boom x)]
    (+ b (perform (Ask)))))

;; 4. The handler itself panics and never resumes: the perform continuation
;;    frame never runs, so its pending defer unwinds at the entry boundary.
(defn cps-handler-panics [x : int] : int
  (defer (note "cps-handler-panics: defer ran"))
  (+ 1 (perform (Ask))))

;; 5. A colored (CPS) callee panics inside a non-tail call: the caller's
;;    continuation is a heap-join frame that never runs.
(defn colored-callee [x : int] : int
  (+ (perform (Ask)) (boom x)))

(defn cps-colored-callee [x : int] : int
  (defer (note "cps-colored-callee: defer ran"))
  (let [r (colored-callee x)]
    (+ r 100)))

;; 6. Two defers fire LIFO; a defer declared AFTER the panicking statement is
;;    not pending yet and does not fire (the direct emitter's rule).  With no
;;    panic (x = 0) all three run at the normal exit, LIFO.
(defn cps-order [x : int] : int
  (defer (note "cps-order: first declared, fires last"))
  (defer (note "cps-order: second declared, fires first"))
  (boom x)
  (defer (note "cps-order: third declared, after the panic point"))
  (+ (perform (Ask)) x))

;; 7. The defer reads a local (`tag`) in a continuation that only delivers to
;;    a join: the local rides the frame's env for the fire.
(defn cps-captured [x : int tag : cstr] : int
  (defer (note tag))
  (if (> x -1)
    (+ (perform (Ask)) (boom x))
    0))

;; 9. A resumed perform earlier in the SAME entry, then a panic: the resumed
;;    continuation ran as a copy, and its original frame never ran -- the
;;    panic must not fire that original's defer a second time.
(defn cps-resumed-then-panic [x : int] : int
  (let [a (handle (cps-no-panic 0) (Ask [] k) (resume k 1))]
    (+ a (boom x))))

;; 10. An abortive handler (never resumes) abandons a frame with a pending
;;     defer, then a panic in the same entry.  The abandoned defer runs when
;;     the case returns (cps-defer-skipped-on-abortive-effect, archived;
;;     tests/fixtures/defer-cps-abortive-handler has the shapes), and the
;;     panic must not run it a second time.
(defeffect Abort [] : int)

(defn cps-aborted [] : int
  (defer (note "cps-aborted: defer ran at the abort"))
  (+ 1 (perform (Abort))))

(defn cps-abort-then-panic [x : int] : int
  (let [a (handle (cps-aborted) (Abort [] k) 0)]
    (+ a (boom x))))

;; 8. No panic: the defer runs exactly once, at the normal exit.
(defn cps-no-panic [x : int] : int
  (defer (note "cps-no-panic: defer ran"))
  (+ (perform (Ask)) (boom x)))

(defn run-direct [x : int] : int
  (let [r (catch-unwind (fn [] : int (direct x)))]
    (note (if (err? r) "direct: caught" "direct: no panic"))))

(defn run-after [x : int] : int
  (let [r (catch-unwind (fn [] : int (handle (cps-after-perform x) (Ask [] k) (resume k 1))))]
    (note (if (err? r) "cps-after-perform: caught" "cps-after-perform: no panic"))))

(defn run-before [x : int] : int
  (let [r (catch-unwind (fn [] : int (handle (cps-before-perform x) (Ask [] k) (resume k 1))))]
    (note (if (err? r) "cps-before-perform: caught" "cps-before-perform: no panic"))))

(defn run-handler-panics [x : int] : int
  (let [r (catch-unwind (fn [] : int (handle (cps-handler-panics x) (Ask [] k) (boom 1))))]
    (note (if (err? r) "cps-handler-panics: caught" "cps-handler-panics: no panic"))))

(defn run-colored [x : int] : int
  (let [r (catch-unwind (fn [] : int (handle (cps-colored-callee x) (Ask [] k) (resume k 1))))]
    (note (if (err? r) "cps-colored-callee: caught" "cps-colored-callee: no panic"))))

(defn run-order [x : int] : int
  (let [r (catch-unwind (fn [] : int (handle (cps-order x) (Ask [] k) (resume k 1))))]
    (note (if (err? r) "cps-order: caught" "cps-order: no panic"))))

(defn run-captured [x : int] : int
  (let [r (catch-unwind (fn [] : int (handle (cps-captured x "cps-captured: defer ran with its tag") (Ask [] k) (resume k 1))))]
    (note (if (err? r) "cps-captured: caught" "cps-captured: no panic"))))

(defn run-no-panic [x : int] : int
  (let [r (catch-unwind (fn [] : int (handle (cps-no-panic x) (Ask [] k) (resume k 1))))]
    (note (if (err? r) "cps-no-panic: caught" "cps-no-panic: no panic"))))

(defn run-resumed-then-panic [x : int] : int
  (let [r (catch-unwind (fn [] : int (cps-resumed-then-panic x)))]
    (note (if (err? r) "cps-resumed-then-panic: caught" "cps-resumed-then-panic: no panic"))))

(defn run-abort-then-panic [x : int] : int
  (let [r (catch-unwind (fn [] : int (cps-abort-then-panic x)))]
    (note (if (err? r) "cps-abort-then-panic: caught" "cps-abort-then-panic: no panic"))))

(defn main [] : int
  (run-direct 1)
  (run-order 0)
  (run-after 1)
  (run-before 1)
  (run-handler-panics 1)
  (run-colored 1)
  (run-order 1)
  (run-captured 1)
  (run-no-panic 0)
  (run-resumed-then-panic 1)
  (run-abort-then-panic 1)
  0)
