;; A `set!` in a `handle` body to an enclosing ^mut survives the handle.
(defeffect Ask [] : int)

(defn g [] : int
  (let [^mut c 0]
    (let [r (handle (do (set! c 5) (perform (Ask))) (Ask [] k) (resume k 1))]
      (+ (* 10 c) r))))

(defn h [] : int
  (let [^mut c 0]
    (handle (do (set! c 5) 1)
      (Ask [] k) (resume k 1))
    c))

(defn after-perform [] : int
  (let [^mut c 0]
    (let [r (handle (do (perform (Ask)) (set! c 7) 2) (Ask [] k) (resume k 1))]
      (+ (* 10 c) r))))

(defn twice [v : int] : int (* 2 v))

;; the same loss through a reset body
(defn in-reset [] : int
  (let [^mut c 0]
    (let [r (reset (do (set! c 5) (+ 1 (shift twice 4))))]
      (+ (* 10 c) r))))

;; and through a with-handler body (already correct; pinned)
(defn in-with-handler [] : int
  (let [^mut c 0]
    (let [r (with-handler (handler (Ask [] k) (resume k 1))
              (do (set! c 5) (perform (Ask))))]
      (+ (* 10 c) r))))

(defn main [] : int
  (println (g))
  (println (h))
  (println (after-perform))
  (println (in-reset))
  (println (in-with-handler))
  0)
