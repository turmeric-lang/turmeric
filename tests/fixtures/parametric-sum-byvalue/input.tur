;; parametric-sum-byvalue: SR2a on the DEFAULT path.  It carried a `flags` file
;; with `--enable=parametric-sum-byvalue` while the representation was an
;; EXPERIMENTS[] row; the row graduated 2026-08-27, so the enable is gone and
;; this asserts the same shapes with no opt-in at all.  If sr2_app_sum_byvalue
;; ever stops answering true by default, this fixture fails loudly.
;;
;; The shape is deliberately the whole SR2a gauntlet in miniature: direct
;; construction and match (both variants), the sum as a by-value argument, and
;; a Vec of the monomorph (the vec-of ICE's shape).  Values are asserted, not
;; just the build -- the failure class this family ships hides behind casts cc
;; cannot see through.

(defdata ^copy Opt2 [a] (Nah) (Yep a))

(defn get-or [o : (Opt2 int) d : int] : int
  (match o
    (Yep v) v
    (Nah)   d))

(defn main [] : int
  (println (get-or (Yep 7) -1))              ; 7    direct, by-value arg
  (println (get-or (Nah) -1))                ; -1   bare nullary ctor arg
  (let [v (vec-of (Yep 8) (:: (Nah) (Opt2 int)) (Yep 21))]
    (println (get-or (vec-get v 0) -1))      ; 8
    (println (get-or (vec-get v 1) -1))      ; -1
    (println (get-or (vec-get v 2) -1)))     ; 21
  0)
