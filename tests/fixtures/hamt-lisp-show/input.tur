;;
;; Phase P2: Lisp bindings show test
;; Tests hamt/show returns a string representation

(extern-c free [p :ptr] :void)
(extern-c strlen [s :cstr] :int)

(defn cstr-free [s : cstr] : void
  ```c
  free((void *)s);
  ```)

(defn alloc-key [x : int] : int
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  *p = (int64_t)x;
  return (int64_t)(intptr_t)p;
  ```)

;; Test: show empty map
(defn test-show-empty [] : int
  (let [m   (hamt/new)
        s   (hamt/show m)
        len (strlen s)]
    (hamt/free m)
    (cstr-free s)
    (if (= len 2) 1 0)))

;; Test: show non-empty map has content > 2 chars
(defn test-show-nonempty [] : int
  (let [k1  (alloc-key 1)
        v1  (alloc-key 100)
        m1  (hamt/new)
        m2  (hamt/set m1 (hamt/hash-ptr (:: k1 ptr<void>)) k1 v1)
        s   (hamt/show m2)
        len (strlen s)]
    (hamt/free m1)
    (hamt/free m2)
    (free (:: k1 :ptr))
    (free (:: v1 :ptr))
    (cstr-free s)
    (if (> len 2) 1 0)))

(println (test-show-empty))
(println (test-show-nonempty))
