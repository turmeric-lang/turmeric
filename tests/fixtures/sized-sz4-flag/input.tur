; Phase SZ4: the sized-types stdlib layer compiles under -Xsized-types alone.
;
; -Xsized-types implies -Xgadt, so the GADT-gated Size/SizedVec machinery is
; reachable with only -Xsized-types on the command line (this fixture's `flags`
; file lists -Xsized-types, NOT -Xgadt).

(defdata Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defn size-eval [s : Size] : int
  (match s
    (Static n)   n
    (Add s1 s2)  (+ (size-eval s1) (size-eval s2))
    (Mul s1 s2)  (* (size-eval s1) (size-eval s2))))

(defdata SizedVec [n a]
  (SVNil : (SizedVec Size int))
  (SVCons int (SizedVec Size int) : (SizedVec Size int)))

(defn sized-vec-len [v : SizedVec] : int
  (match v
    (SVNil)       0
    (SVCons _ xs) (+ 1 (sized-vec-len xs))))

(defn main [] : int
  (let [three (Add (Static 1) (Add (Static 1) (Static 1)))
        v     (SVCons 10 (SVCons 20 (SVCons 30 (SVNil))))]
    (println (size-eval three))
    (println (sized-vec-len v))
    0))
