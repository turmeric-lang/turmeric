;; The soundness control for the loop frozen-set question
;; (item 2 of docs/reported/reads-measure-rejected-in-invariant-and-pre.md).
;;
;; A live SHARED borrow of `v` does NOT mean `v` holds still across the body:
;; `vec-push!` is declared `[v : (Vec A) val : A]` -- by value, `#fx{}`, no
;; `#writes` -- so there is no conflicting borrow for TUR-E0200 to reject, and
;; the push is legal inside the marker region.
;;
;; So `(<= (vlen v) 3)` must NOT be proved preserved here.  It is false from
;; the first iteration on, and the kept re-establishment check fires: the
;; program must die, not print.  Publishing a crossing-style frozen set on the
;; loop's obligations proved this preserved -- measured, and the reason that
;; plumbing is not in li_obligation.
(defn vlen [^borrow v : (Vec int)] #reads v : #refine{ r : int | (>= r 0) }
  (vec-len v))

(defn walk [^mut v : (Vec int)] : int
  (let [__frozen (& v)]
    (let [^mut i 0]
      (while (< i 2) :invariant (<= (vlen v) 3)
        (vec-push! v 7)
        (set! i (+ i 1)))
      (vlen v))))

(defn main [] : int
  (let [^mut v (vec-of 1 2 3)]
    (println (walk v)))
  0)
