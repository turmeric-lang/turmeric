;; reflect-two-provable-facts-report-as-not-holding, half 2: a crossing inside
;; a `match` arm now carries the arm's constructor facts -- the tag
;; `(= (#dt/tag s) k)` and the record selectors `(= b (.field s))` -- spelled as
;; the return obligation already spells them, so RF4 selects the same arm.
;; `via-crossing` needs exactly the fact `via-return` already proved; it was
;; unknown before.  --strict-refine: compiles only because all three prove.
(defdata Lst [] (Cons [hd : int tl : Lst]) (Nil))

(defn ^reflect sorted? [xs : Lst] : bool
  (match xs
    (Nil) true
    (Cons h t) (match t
                 (Nil) true
                 (Cons h2 _) (and (<= h h2) (sorted? t)))))

(defn needs-sorted [ys : #refine{ v : Lst | (sorted? v) }] : int 1)

(defn via-return [xs : #refine{ v : Lst | (sorted? v) }] : #refine{ r : bool | r }
  (match xs
    (Nil) true
    (Cons h t) (match t
                 (Nil) true
                 (Cons h2 t2) (sorted? t))))

(defn via-crossing [xs : #refine{ v : Lst | (sorted? v) }] : int
  (match xs
    (Nil) 0
    (Cons h t) (match t
                 (Nil) 0
                 (Cons h2 t2) (needs-sorted t))))

(defn main [] : int
  (println (via-return (Cons 1 (Cons 2 (Cons 3 (Nil))))))
  (println (via-crossing (Cons 1 (Cons 2 (Cons 3 (Nil))))))
  0)
