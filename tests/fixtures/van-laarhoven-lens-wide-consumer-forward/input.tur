;; CM3-transitive (van-laarhoven-consumer-mono-plan): a SECOND-level consumer.
;; `tweak` forwards its lens param `l` to `set-px` and is itself called with two
;; distinct wide lenses (`point-x`, `point-y`).  `tweak` has no `(l g s)` pin of
;; its own, so the resolve pass registers a FORWARDING spec for `tweak`'s `l`
;; (inheriting set-px's functor/focus/whole); the CM1 fixpoint then resolves it to
;; `{point-x, point-y}` from `main`'s calls, `set-px` inherits that set through the
;; forward, and BOTH consumers are cloned.  `tweak__lens_<hash>` calls the matching
;; `set_px__lens_<hash>` (the inner `(set-px l ...)` sees the clone's bound lens),
;; so the whole chain is box-free -- no `emit_agg_box` / `dict_clone`.  The
;; expected.c snapshot pins that transitive chain.

(defstruct ^copy Identity [A] (wrapped : A) (tag : int))
(defn mk-id  [A] [x : A]            : (Identity A) (make-struct Identity :wrapped x :tag 0))
(defn run-id [A] [i : (Identity A)] : A            (.wrapped i))
(definstance Functor [Identity]
  (fmap [i g] (mk-id (g (run-id i)))))
(defstruct ^copy ^heap Point [x : int y : int])
(defn point-x [^f] [^Functor f g : (-> int (f int)) s : Point] : (f Point)
  (fmap (g (.x s)) (fn [nx : int] : Point (make-struct Point :x nx :y (.y s)))))
(defn point-y [^f] [^Functor f g : (-> int (f int)) s : Point] : (f Point)
  (fmap (g (.y s)) (fn [ny : int] : Point (make-struct Point :x (.x s) :y ny))))
(defn set-px [l (forall [(f :: * -> *)] [(Functor f)] (-> (-> int (f int)) Point (f Point))) b : int s : Point] : Point
  (run-id (l (fn [a : int] : (Identity int) (mk-id b)) s)))
;; tweak forwards its lens param l to set-px (a second-level consumer, no (l g s) pin of its own)
(defn tweak [l (forall [(f :: * -> *)] [(Functor f)] (-> (-> int (f int)) Point (f Point))) b : int s : Point] : Point
  (set-px l b s))
(defn main [] : int
  (let [p  (make-struct Point :x 3 :y 4)
        p1 (tweak point-x 99 p)
        p2 (tweak point-y 88 p)]
    (println (.x p1)) (println (.y p1))
    (println (.x p2)) (println (.y p2))
    0))
