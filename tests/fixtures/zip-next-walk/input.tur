;; generic-zipper-plan ZP1: zip/next visits every node once, depth-first in
;; pre-order, and past the last node returns the end marker (zip/end?), whose
;; zip/next is itself and whose zip/root is the tree.  Clojure's edit-all loop
;; rewrites every node; zip/prev walks back from the last node to the root.
(load "stdlib/str-build.tur")
(load "stdlib/zip.tur")

;; A minimal rose-like tree: a leaf holds an int, a node holds its children.
(defdata ^heap ^copy Tree (Leaf int) (Node (Cons Tree)))

(defn tree-ops [] : (ZipOps Tree)
  (zip/ops (fn [t : Tree] : bool (match t (Leaf _) false (Node _) true))
           (fn [t : Tree] : (Cons Tree) (match t (Leaf _) (tnil) (Node cs) cs))
           (fn [t : Tree cs : (Cons Tree)] : Tree (Node cs))))

(defn n0 [] : Tree (Node (tnil)))
(defn n1 [a : Tree] : Tree (Node (tcons-of a (tnil))))
(defn n2 [a : Tree b : Tree] : Tree (Node (tcons-of a (tcons-of b (tnil)))))
(defn n3 [a : Tree b : Tree c : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tnil))))))
(defn n4 [a : Tree b : Tree c : Tree d : Tree] : Tree
  (Node (tcons-of a (tcons-of b (tcons-of c (tcons-of d (tnil)))))))

;; Clojure's vector-zip printing: a node is [k1 k2 ...].
(defn show-kids [cs : (Cons Tree)] : cstr
  (if (tnil? cs)
    ""
    (if (tnil? (ttail cs))
      (show (thead cs))
      (str-concat (str-concat (show (thead cs)) " ") (show-kids (ttail cs))))))

(defn show [t : Tree] : cstr
  (match t
    (Leaf v)  (int->str v)
    (Node cs) (str-concat (str-concat "[" (show-kids cs)) "]")))

(defn show-list [cs : (Cons Tree)] : cstr
  (str-concat (str-concat "(" (show-kids cs)) ")"))

(defn show-at [o : (Option (ZipLoc Tree))] : cstr
  (match o
    (None)   "None"
    (Some z) (show (zip/node z))))

(defn get [o : (Option (ZipLoc Tree))] : (ZipLoc Tree)
  (match o
    (Some z) z
    (None)   (panic "no such location")))

(defn visit [z : (ZipLoc Tree)] : int
  (if (zip/end? z)
    0
    (do (println (show (zip/node z)))
        (+ 1 (visit (zip/next z))))))

(defn bump [t : Tree] : Tree
  (match t
    (Leaf v)  (Leaf (+ v 10))
    (Node cs) t))

(defn edit-all [z : (ZipLoc Tree)] : Tree
  (if (zip/end? z)
    (zip/root z)
    (edit-all (zip/next (zip/edit z bump)))))

(defn last-loc [z : (ZipLoc Tree)] : (ZipLoc Tree)
  (let [n (zip/next z)]
    (if (zip/end? n) z (last-loc n))))

(defn back [z : (ZipLoc Tree)] : int
  (do (println (show (zip/node z)))
      (match (zip/prev z)
        (None)   1
        (Some p) (+ 1 (back p)))))

(defn walk-end [z : (ZipLoc Tree)] : (ZipLoc Tree)
  (if (zip/end? z) z (walk-end (zip/next z))))

(defn main [] : int
  (let [t (n4 (Leaf 1) (n2 (Leaf 2) (n1 (Leaf 3))) (n0) (Leaf 4))
        z (zip/zipper (tree-ops) t)]
    (println (visit z))
    (let [e (walk-end z)]
      (println (zip/end? e))
      (println (zip/end? (zip/next e)))
      (println (show (zip/root e)))
      (println (show (zip/node e)))
      (println (show-at (zip/prev e))))
    (println (show (edit-all z)))
    (println (show t))
    (println (back (last-loc z))))
  ;; a single leaf: next of the root is already the end
  (let [l (zip/zipper (tree-ops) (Leaf 7))]
    (println (zip/end? (zip/next l)))
    (println (show (edit-all l))))
  0)
