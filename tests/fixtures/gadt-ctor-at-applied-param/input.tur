;; The HKT/G4 allowance a TY_ADT value keeps at a TY_APP parameter: a GADT
;; constructor of the SAME type (`Refl : (Equal a a)` at `(Equal int int)`),
;; and a nullary constructor of the parameter's own type.  Pins the boundary
;; of adt-arg-accepted-at-any-applied-param from the accepting side.
(defdata Equal [a b]
  (Refl : (Equal a a)))
(defn use-eq [p : (Equal int int)] : int 1)
(defn opt-or [o : (Option int) d : int] : int
  (match o (Some x) x (None) d))
(defn main [] : int
  (println (use-eq (Refl)))     ; 1
  (println (opt-or (None) 7))   ; 7
  (println (opt-or (some 3) 7)) ; 3
  0)
