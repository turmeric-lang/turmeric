;; stdlib-linearity-affinity-plan (L2): ChildHandle is a :linear resource handle.
;;
;; process/spawn returns a linear ChildHandle that must be reaped exactly once
;; with process/wait (which consumes it). Under -Xlinear, spawning then waiting
;; type-checks, while forgetting to wait (a leaked zombie) is a TUR-E0100 and
;; double-waiting is a TUR-E0101.
;;
;; Spawns `true` through PATH: macOS has no /bin/true (it is /usr/bin/true),
;; which the old spawn hid by reporting a failed exec as an ordinary child.
;;
;; Expected output: child ok
(load "stdlib/process.tur")

(defn main [] : int
  (match (process/spawn "true")
    ;; the single consumption -- reaps the child
    (Ok child) (match (process/wait child)
                 (Ok st) (do (println (if (exit-status/success? st) "child ok" "child failed")) 0)
                 (Err e) (do (println (io-error/message e)) 1))
    (Err e) (do (println (io-error/message e)) 1)))
