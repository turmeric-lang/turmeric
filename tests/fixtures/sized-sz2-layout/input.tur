; Phase SZ2: Memory layout -- SizedBuf flat array vs SizedVec linked list.
;
; Demonstrates that SizedBuf uses tighter, cache-friendlier memory layout:
;   SizedVec: one heap node per element (struct { int tag; union { ... } as; })
;   SizedBuf: one contiguous block for all elements (int64_t data[n])
;
; Also exercises sized-buf-from-sized-vec conversion and size integration.

(defdata Size []
  (Static (int) : (Size))
  (Add (Size) (Size) : (Size))
  (Mul (Size) (Size) : (Size)))

(defdata SizedVec [n a]
  (SVNil : (SizedVec Size int))
  (SVCons int (SizedVec Size int) : (SizedVec Size int)))

(defn size-eval [s : Size] : int
  (match s (Static n) n (Add s1 s2) (+ (size-eval s1) (size-eval s2))
             (Mul s1 s2) (* (size-eval s1) (size-eval s2))))

(defn sized-vec-of-4 [a : int b : int c : int d : int] : SizedVec
  (SVCons a (SVCons b (SVCons c (SVCons d (SVNil))))))

(defn sized-buf-new-zeroed [n] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *b = malloc(sizeof(*b));
  b->len  = n;
  b->data = n > 0 ? (int64_t *)calloc((size_t)n, sizeof(int64_t)) : NULL;
  return (int64_t)(intptr_t)b;
  ```)

(defn sized-buf-free [b] #fx{Unsafe} : nil
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (buf->data) free(buf->data);
  free(buf);
  ```)

(defn sized-buf-len [b] #fx{Unsafe} : int
  ```c
  return ((struct { int64_t len; int64_t *data; } *)(intptr_t)b)->len;
  ```)

(defn sized-buf-get [b i] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (i >= 0 && i < buf->len) return buf->data[i];
  fprintf(stderr, "sized-buf-get: out of bounds\n"); exit(1);
  ```)

(defn sized-buf-set! [b i v] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  if (i >= 0 && i < buf->len) { buf->data[i] = v; return b; }
  fprintf(stderr, "sized-buf-set!: out of bounds\n"); exit(1);
  ```)

(defn sized-buf-sum [b] #fx{Unsafe} : int
  ```c
  struct { int64_t len; int64_t *data; } *buf = (void*)(intptr_t)b;
  int64_t s = 0; for (int64_t i = 0; i < buf->len; i++) s += buf->data[i]; return s;
  ```)

(defn sized-buf-size [b] #fx{Unsafe} : Size (Static (sized-buf-len b)))

(defn sized-buf-from-sized-vec [v] #fx{Unsafe} : int
  ```c
  typedef struct {
    int tag;
    union {
      struct { char _d; } nil_;
      struct { int64_t _0; int64_t _1; } cons_;
    } as;
  } SVNode;
  int64_t count = 0;
  int64_t cur = v;
  while (cur != 0) {
    SVNode *node = (SVNode *)(intptr_t)cur;
    if (node->tag == 0) break;
    count++;
    cur = node->as.cons_._1;
  }
  struct { int64_t len; int64_t *data; } *b = malloc(sizeof(*b));
  b->len  = count;
  b->data = count > 0 ? (int64_t *)malloc((size_t)count * sizeof(int64_t)) : NULL;
  cur = v;
  for (int64_t i = 0; i < count; i++) {
    SVNode *node = (SVNode *)(intptr_t)cur;
    b->data[i] = node->as.cons_._0;
    cur = node->as.cons_._1;
  }
  return (int64_t)(intptr_t)b;
  ```)

(defn main [] : int
  ; Heap-allocated flat buffer: fill and read
  (let [b (unsafe (sized-buf-new-zeroed 4))]
    (unsafe (sized-buf-set! b 0 10))
    (unsafe (sized-buf-set! b 1 20))
    (unsafe (sized-buf-set! b 2 30))
    (unsafe (sized-buf-set! b 3 40))
    (println (unsafe (sized-buf-get b 0)))
    (println (unsafe (sized-buf-get b 3)))
    (println (unsafe (sized-buf-sum b)))
    ; Size integration: static size annotation on flat buffer
    (println (size-eval (unsafe (sized-buf-size b))))
    (unsafe (sized-buf-free b)))
  ; Convert SizedVec (linked list) to SizedBuf (flat array)
  (let [sv (sized-vec-of-4 5 10 15 20)]
    (let [b2 (unsafe (sized-buf-from-sized-vec sv))]
      (println (unsafe (sized-buf-len b2)))
      (println (unsafe (sized-buf-get b2 0)))
      (println (unsafe (sized-buf-get b2 3)))
      (println (unsafe (sized-buf-sum b2)))
      ; Both size annotations agree
      (println (size-eval (unsafe (sized-buf-size b2))))
      (unsafe (sized-buf-free b2))))
  0)
