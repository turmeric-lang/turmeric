;; effect-cont-aggregate-result-untyped: `effect-cont<T>` typed a resume by T
;; only when T was a scalar -- the cont type kept its result as a bare kind --
;; so a helper resuming a struct or ADT result was refused (TUR-E0709: declares
;; `P`, body returns int).  The cont type now carries the whole written type.
;; Covers the angle-bracket and list spellings, the two-argument form, the
;; `(k v)` sugar, a float-field struct, an ADT, and a cstr.
(defstruct P [x : int y : int])
(defstruct F [a : float b : float])
(defdata Shape (Circle :int) (Rect :int :int))
(defeffect Ask [] int)
(defeffect AskF [] float)
(defn h1 [k : effect-cont<P> v : int] : P (resume k v))
(defn h2 [k : (effect-cont P) v : int] : P (k v))
(defn h3 [k : effect-cont<F> v : float] : F (resume k v))
(defn h4 [k : effect-cont<Shape> v : int] : Shape (resume k v))
(defn h5 [k : effect-cont<cstr> v : int] : cstr (resume k v))
(defn h6 [k : (effect-cont int P) v : int] : P (resume k v))
(defn area [s : Shape] : int (match s (Circle r) (* 3 r) (Rect w h) (* w h)))
(defn s1 [] : int (let [p (handle (P (perform (Ask)) 2) (Ask [] k) (h1 k 5))] (+ (.x p) (.y p))))
(defn s2 [] : int (let [p (handle (P 1 (perform (Ask))) (Ask [] k) (h2 k 9))] (+ (.x p) (.y p))))
(defn s3 [] : float (let [f (handle (F (perform (AskF)) 0.5) (AskF [] k) (h3 k 3.25))] (+ (.a f) (.b f))))
(defn s4 [] : int (let [s (handle (Rect (perform (Ask)) 4) (Ask [] k) (h4 k 3))] (area s)))
(defn s5 [] : cstr (handle (if (> (perform (Ask)) 2) "big" "small") (Ask [] k) (h5 k 3)))
(defn s6 [] : int (let [p (handle (P (perform (Ask)) 20) (Ask [] k) (h6 k 7))] (+ (.x p) (.y p))))
(defn main [] : nil
  (println (s1)) (println (s2)) (println (s3)) (println (s4)) (println (s5)) (println (s6)))
