;; cps-catch-unwind-cannot-cross-an-effect-capture: a ^multishot continuation
;; whose body holds a catch-unwind around the perform.  Each resumed copy
;; carries its own catch prompt: the copy resumed with 0 returns normally (Ok,
;; 200), the copy resumed with 5 panics and its prompt turns that into Err
;; (100).  The interpreter runs it on the work stack: the captured slice
;; carries the catch boundary, a copy per resume
;; (turi-fiber-handle-defers-fire-at-the-wrong-time, case 5).
(defeffect Ask [] : int)

(defn body [] : int
  (let [r (catch-unwind (fn [] : int (let [v (perform (Ask))] (if (> v 0) (panic "boom") v))))]
    (if (err? r) 100 200)))

(defn main [] : int
  (println (handle (body) (Ask [] ^multishot k) (+ (resume k 0) (resume k 5))))
  0)
