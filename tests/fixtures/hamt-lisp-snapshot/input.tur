;;
;; Phase P2: Lisp bindings snapshot test
;; Tests that hamt/set returns a new map, leaving the original unchanged.

(extern-c free [p :ptr] :void)

(defn alloc-key [x : int] : int
  ```c
  int64_t *p = malloc(sizeof(int64_t));
  *p = (int64_t)x;
  return (int64_t)(intptr_t)p;
  ```)

;; Test: snapshot - m1 unchanged after m2 modification
(defn test-snapshot [] : int
  (let [k1 (alloc-key 1)]
    (let [k2 (alloc-key 2)]
      (let [v1 (alloc-key 100)]
        (let [v2 (alloc-key 200)]
          (let [m1 (hamt/new)]
            (let [m2 (hamt/set m1 (hamt/hash-ptr (:: k1 ptr<void>)) k1 v1)]
              (let [m3 (hamt/set m2 (hamt/hash-ptr (:: k2 ptr<void>)) k2 v2)]
                (let [m1-count (hamt/count m1)]
                  (let [m1-has-k1 (hamt/has? m1 (hamt/hash-ptr (:: k1 ptr<void>)) k1)]
                    (let [m2-count (hamt/count m2)]
                      (let [m2-has-k1 (hamt/has? m2 (hamt/hash-ptr (:: k1 ptr<void>)) k1)]
                        (let [m2-has-k2 (hamt/has? m2 (hamt/hash-ptr (:: k2 ptr<void>)) k2)]
                          (let [m3-count (hamt/count m3)]
                            (let [m3-has-k1 (hamt/has? m3 (hamt/hash-ptr (:: k1 ptr<void>)) k1)]
                              (let [m3-has-k2 (hamt/has? m3 (hamt/hash-ptr (:: k2 ptr<void>)) k2)]
                                (hamt/free m1)
                                (hamt/free m2)
                                (hamt/free m3)
                                (free (:: k1 :ptr))
                                (free (:: k2 :ptr))
                                (free (:: v1 :ptr))
                                (free (:: v2 :ptr))
                                (if (and (= m1-count 0)
                                         (not m1-has-k1)
                                         (= m2-count 1)
                                         m2-has-k1
                                         (not m2-has-k2)
                                         (= m3-count 2)
                                         m3-has-k1
                                         m3-has-k2)
                                  1
                                  0)))))))))))))))))

(println (test-snapshot))
