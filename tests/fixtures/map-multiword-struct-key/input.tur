;; collection-multiword-element-boxing (Map key): a MULTI-WORD by-value :copy
;; struct KEY (Point, 16 bytes) is content-keyed in a Map on BOTH the compiled
;; and interpreter paths via #?(:tur ... :turi ...) reader conditionals.
;;
;; Compiled (:tur): WKC2 boxed-key path -- mk-box copies the key into a
;; tur_hamt_box_key refcount box (mk-owned? = 1 frees it exactly once, LSan
;; clean), and mk-cmp returns the GENERIC size-aware comparator
;; tur_hamt_box_key_eq (reads each boxed payload's length from its header).
;;
;; Interpreter (:turi): the tree-walking interpreter stores the struct key as a
;; TuriStruct value; hash / mk-cmp use the generic interpreter natives
;; (struct-hash / struct-key-cmp) -- the interpreter analogues of the compiled
;; xxh64 / tur_hamt_box_key_eq.  Because struct-key-cmp returns a stampable C fn
;; pointer (not a closure), it is recovered by tur_hamt_keyeq, so structural
;; Eq[Map] over struct keys works too, not just assoc/get.  Both :turi bodies are
;; generic (no per-field code); only Eq[Point] mentions fields.
;;
;; Runs on both paths (whitelisted in tests/run-turi.sh TURI_INLINEC_RUN): the
;; two paths agree bit-for-bit.
(load "stdlib/typeclass.tur")

(defstruct ^copy Point [x : int y : int])

(definstance Hash [Point]
  (hash [p] : int
    #?(:tur ```c return (int64_t)tur_hamt_hash_xxh64((const void*)&p, sizeof(p)); ```
       :turi (struct-hash p))))
(definstance Eq [Point]
  (eq? [a b] (and (= (.x a) (.x b)) (= (.y a) (.y b)))))
(definstance MapKey [Point]
  (mk-box [p] : int
    #?(:tur ```c return (int64_t)(intptr_t)tur_hamt_box_key((const void*)&p, sizeof(p)); ```
       :turi p))
  (mk-cmp [p] : int
    #?(:tur ```c return (int64_t)(intptr_t)&tur_hamt_box_key_eq; ```
       :turi (struct-key-cmp)))
  (mk-owned? [p] #?(:tur 1 :turi 0)))

(defn main [] : int
  (let [m (map-assoc (map-assoc (:: (map-new) (Map Point int)) (Point 1 2) 99)
                                                               (Point 3 4) 77)]
    (show-line (map-get m (Point 1 2)))   ;; 99 -- content key hit (distinct box)
    (show-line (map-get m (Point 3 4)))   ;; 77
    (show-line (map-get m (Point 9 9)))   ;; 0  -- miss
    (let [a (map-assoc (:: (map-new) (Map Point int)) (Point 1 2) 5)
          b (map-assoc (:: (map-new) (Map Point int)) (Point 1 2) 5)
          c (map-assoc (:: (map-new) (Map Point int)) (Point 1 2) 6)]
      (println (if (.eq? a b) "eq" "ne"))       ;; eq -- content-equal, distinct boxes
      (println (if (.eq? a c) "eq" "ne")))      ;; ne -- value differs
    0))
