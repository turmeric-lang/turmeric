;; Phase T24: async-timer-basic — multiple timers fire in deadline order.
;;
;; Three fibers each sleep for different durations using the timer wheel.
;; The scheduler's timer-aware run loop ensures they wake up in the
;; correct order: shortest sleep first.
;;
;; Expected output:
;;   start
;;   fiber-fast done (50ms)
;;   fiber-medium done (100ms)
;;   fiber-slow done (150ms)
;;   all done

;; --- Inline scheduler + fiber wrappers (self-contained test) ---

(defn mk-scheduler [] : ptr<void>
  ```c
  TurScheduler *s = tur_scheduler_new();
  tur_scheduler = s;
  return (void *)s;
  ```)

(defn mk-fiber [fn : ptr<void>] : ptr<void>
  ```c
  return (void *)tur_fiber_block_new((void(*)(void))fn, 0);
  ```)

(defn sched-spawn [s : ptr<void> f : ptr<void>] : nil
  ```c
  tur_scheduler_spawn((TurScheduler *)s, (FiberBlock *)f);
  ```)

(defn sched-run [s : ptr<void>] : nil
  ```c
  tur_scheduler_run((TurScheduler *)s);
  ```)

;; --- Timer-based sleep (uses timer wheel + park/yield) ---

(defn timer-sleep-ms [ms : int] : nil
  ```c
  if (ms <= 0) return;
  FiberBlock *me = tur_current_fiber;
  if (!me || !tur_scheduler) { fprintf(stderr, "no scheduler\n"); abort(); }
  if (!tur_global_timers) tur_global_timers = tur_timer_wheel_new();
  int64_t deadline = tur_monotonic_ns() + (int64_t)ms * 1000000LL;
  tur_timer_wheel_insert(tur_global_timers, deadline,
      tur_scheduler_unpark_cb, me);
  me->parked = 1;
  tur_fiber_block_yield(0);
  ```)

;; --- Fiber bodies ---

(defn fiber-fast [] : nil
  (timer-sleep-ms 50)
  (println "fiber-fast done (50ms)"))

(defn fiber-medium [] : nil
  (timer-sleep-ms 100)
  (println "fiber-medium done (100ms)"))

(defn fiber-slow [] : nil
  (timer-sleep-ms 150)
  (println "fiber-slow done (150ms)"))

(defn main [] : int
  (println "start")
  (let [s (mk-scheduler)]
    (sched-spawn s (mk-fiber fiber-fast))
    (sched-spawn s (mk-fiber fiber-medium))
    (sched-spawn s (mk-fiber fiber-slow))
    (sched-run s)
    (println "all done")
    0))
