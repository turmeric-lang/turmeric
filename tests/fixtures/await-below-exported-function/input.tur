;; await-parks-only-to-the-nearest-c-frame: an awaiting function reached
;; through a function exported under a fixed C name (`export-as`).  Such a
;; function used to stay off the CPS backend, so its direct entry -- with a
;; root of its own -- sat between the async body and the await: the park was
;; refused at run time (and before that, captured only the part below it and
;; let the rest carry on with 0).  A may-await export-as function is now on
;; the backend: internal callers thread into `lvl2_export__cps`, and the
;; exported symbol keeps its C name, signature and linkage as the entry
;; wrapper (a C caller still enters at a fresh root, as before).
;; Leak-checked (requires.leak-check).

(defn cur-cell [fresh : bool] : ptr<void>
  ```c
  static void *g = NULL;
  if (fresh) { g = tur_future_new(); }
  return g;
  ```)

(defn pending? [f : ptr<void>] : bool
  ```c
  return ((TurFuture *)f)->status == FUTURE_PENDING;
  ```)

(defn fulfill-future [f : ptr<void> v : int] : nil
  ```c
  tur_future_fulfill((TurFuture *)f, (int64_t)v);
  ```)

(defn future-value [f : ptr<void>] : int
  ```c
  return (int64_t)tur_future_get((TurFuture *)f);
  ```)

(defn free-future [f : ptr<void>] : nil
  ```c
  tur_future_free((TurFuture *)f);
  ```)

(defn next-value [] : int (await (cur-cell false)))
(defn sum-values [i : int n : int acc : int] : int
  (if (= i n) acc (sum-values (+ i 1) n (+ acc (next-value)))))


(defn level3 [m : int] : int (+ m (sum-values 0 300 0)))
(defn (export-as "lvl2_export") level2 [m : int] : int (* 2 (level3 (+ m 1))))
(defn body [] : int (+ 7 (level2 1)))
(defn drive [f : ptr<void>] : int
  (while (pending? f)
    (let [old (cur-cell false)]
      (cur-cell true)
      (fulfill-future old 2)
      (free-future old)))
  (let [v (future-value f)]
    (free-future f)
    v))

;; 7 + 2 * ((1 + 1) + 600)
(defn main [] : nil
  (cur-cell true)
  (println (drive (async body)))
  (free-future (cur-cell false)))
