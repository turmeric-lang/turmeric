;; variadic-types-adt -- :Color rest (ADT) accepts Color constructor values.

(defdata ^copy Color (Red) (Green) (Blue))

(defn cons-list-len [lst : int] #fx{Unsafe} : int
  ```c
  typedef struct { int64_t head; int64_t tail; } __tur_cons_cell;
  int64_t n = 0;
  __tur_cons_cell *p = (__tur_cons_cell *)(intptr_t)lst;
  while (p) { n++; p = (__tur_cons_cell *)(intptr_t)p->tail; }
  return (int)n;
  ```)

(defn count-colors [& cs : Color] #fx{Unsafe} : int
  (cons-list-len cs))

(defn main [] : int
  (unsafe
    (let [n (count-colors (Red) (Green) (Blue))]
      (if (= n 3) 0 1))))
