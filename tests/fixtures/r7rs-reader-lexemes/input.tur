#lang r7rs
;; r7rs-lang-plan R1: the Scheme reader (READER_R7RS), exercised through the
;; lexemes that survive to runtime.  The forms that do not survive to runtime
;; on their own (dotted pairs, `,`/`,@`, `|sym|`, `#u8(...)`, `#!fold-case`)
;; are pinned by r7rs-reader-forms via parse-check.
;;
;; This was a Turmeric `(defn main [] : int (println ...))` until the
;; Turmeric forms and brackets stopped reading in a Scheme source
;; (docs/archive/r7rs-turmeric-syntax-leaks.md, items 1 and 7); it is plain
;; Scheme now, so the values print in Scheme's spelling (`#t`, `10.0`).
;;
;; r7rs GRADUATED at 0.57.0, so the directive is all that is needed and
;; nothing is printed to stderr: no EXPERIMENTS[] row (`--enable=r7rs` is
;; TUR-E0310 since the name aged out at 0.71.0), no manifest able to refuse the
;; dialect, and no TUR-W0061
;; (this file used to print one per compile, which the harness ignored because
;; it compares stdout only).
(import (scheme base) (scheme write) (scheme char))
(define (show x) (display x) (newline))
;; R7RS 6.3 booleans, both spellings.
(show #t)
(show #f)
(show #true)
(show #false)
;; R7RS 6.6 characters: a plain one, an R7RS-only name, the `#\x<hex>`
;; scalar-value form, a multi-byte UTF-8 character, and the shared names.
(show (char->integer #\a))
(show (char->integer #\alarm))
(show (char->integer #\x3bb))
(show (char->integer #\space))
;; R7RS 7.1.1 radix and exactness prefixes, alone and stacked.
(show #x1F)
(show #b101)
(show #o17)
(show #d10)
(show #x-1F)
(show #e10)
(show #i10)
(show #e#x10)
(show #e1e3)
;; Explicit `+` sign and a bare fraction, both Scheme-only spellings.
(show +5)
(show .5)
(show -.5)
;; R7RS 6.7 string escapes: `\x<hex>;`, `\t`, and the line continuation.
(show "a\x41;b")
(show "tab\there")
(show "one \
       two")
;; `#(...)` is a vector.
(show (vector-length #(1 2 3)))
;; A float with a fractional part, so a numeric-tower surprise would show.
(let ((x 7.1)) (show x))
;; Brackets are parentheses (as in Racket and Chez), and curly-infix is
;; SRFI 105.
(let ([k 42]) (show k))
(show {2.0 * 3.25})
