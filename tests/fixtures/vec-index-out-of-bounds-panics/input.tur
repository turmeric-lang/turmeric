;; panic-location-names-the-runtime-not-the-call-site: a vec index out of
;; bounds printed its message and called exit(1) -- no `panic at` line, not
;; catchable, and the interpreter's native did the same with _exit(1).  Both
;; engines raise a panic now (tur_panic / turi_runtime_panic): a catch-unwind
;; in scope catches it, and with none the process dies as any panic does.
;; Both engines name the call that panicked -- `input.tur:12` -- not the runtime.
(defn main [] : int
  (let [v (vec-of 1 2 3)
        r (catch-unwind (fn [] : int (vec-get v 7)))]
    (println (if (err? r) "caught" "not caught"))
    (println (vec-get v 1))
    (vec-get v 9)
    0))
