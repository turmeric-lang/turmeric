;; effect-row-merge-overflows-past-32-effects: the effect inference merged
;; rows into a 32-entry stack array, so one function performing more than
;; 32 distinct effects wrote past it (ASan: stack-buffer-overflow in
;; effect_row_merge).  The row counts were 8-bit as well.  `many` performs
;; 40; its continuations capture nothing.
(defeffect E0 [] : int)
(defeffect E1 [] : int)
(defeffect E2 [] : int)
(defeffect E3 [] : int)
(defeffect E4 [] : int)
(defeffect E5 [] : int)
(defeffect E6 [] : int)
(defeffect E7 [] : int)
(defeffect E8 [] : int)
(defeffect E9 [] : int)
(defeffect E10 [] : int)
(defeffect E11 [] : int)
(defeffect E12 [] : int)
(defeffect E13 [] : int)
(defeffect E14 [] : int)
(defeffect E15 [] : int)
(defeffect E16 [] : int)
(defeffect E17 [] : int)
(defeffect E18 [] : int)
(defeffect E19 [] : int)
(defeffect E20 [] : int)
(defeffect E21 [] : int)
(defeffect E22 [] : int)
(defeffect E23 [] : int)
(defeffect E24 [] : int)
(defeffect E25 [] : int)
(defeffect E26 [] : int)
(defeffect E27 [] : int)
(defeffect E28 [] : int)
(defeffect E29 [] : int)
(defeffect E30 [] : int)
(defeffect E31 [] : int)
(defeffect E32 [] : int)
(defeffect E33 [] : int)
(defeffect E34 [] : int)
(defeffect E35 [] : int)
(defeffect E36 [] : int)
(defeffect E37 [] : int)
(defeffect E38 [] : int)
(defeffect E39 [] : int)
(defn many [] : int
  (do
    (perform (E0))
    (perform (E1))
    (perform (E2))
    (perform (E3))
    (perform (E4))
    (perform (E5))
    (perform (E6))
    (perform (E7))
    (perform (E8))
    (perform (E9))
    (perform (E10))
    (perform (E11))
    (perform (E12))
    (perform (E13))
    (perform (E14))
    (perform (E15))
    (perform (E16))
    (perform (E17))
    (perform (E18))
    (perform (E19))
    (perform (E20))
    (perform (E21))
    (perform (E22))
    (perform (E23))
    (perform (E24))
    (perform (E25))
    (perform (E26))
    (perform (E27))
    (perform (E28))
    (perform (E29))
    (perform (E30))
    (perform (E31))
    (perform (E32))
    (perform (E33))
    (perform (E34))
    (perform (E35))
    (perform (E36))
    (perform (E37))
    (perform (E38))
    (perform (E39))
    7))
(defn main [] : int
  (println
    (handle (many)
      (E0 [] k) (resume k 0)
      (E1 [] k) (resume k 0)
      (E2 [] k) (resume k 0)
      (E3 [] k) (resume k 0)
      (E4 [] k) (resume k 0)
      (E5 [] k) (resume k 0)
      (E6 [] k) (resume k 0)
      (E7 [] k) (resume k 0)
      (E8 [] k) (resume k 0)
      (E9 [] k) (resume k 0)
      (E10 [] k) (resume k 0)
      (E11 [] k) (resume k 0)
      (E12 [] k) (resume k 0)
      (E13 [] k) (resume k 0)
      (E14 [] k) (resume k 0)
      (E15 [] k) (resume k 0)
      (E16 [] k) (resume k 0)
      (E17 [] k) (resume k 0)
      (E18 [] k) (resume k 0)
      (E19 [] k) (resume k 0)
      (E20 [] k) (resume k 0)
      (E21 [] k) (resume k 0)
      (E22 [] k) (resume k 0)
      (E23 [] k) (resume k 0)
      (E24 [] k) (resume k 0)
      (E25 [] k) (resume k 0)
      (E26 [] k) (resume k 0)
      (E27 [] k) (resume k 0)
      (E28 [] k) (resume k 0)
      (E29 [] k) (resume k 0)
      (E30 [] k) (resume k 0)
      (E31 [] k) (resume k 0)
      (E32 [] k) (resume k 0)
      (E33 [] k) (resume k 0)
      (E34 [] k) (resume k 0)
      (E35 [] k) (resume k 0)
      (E36 [] k) (resume k 0)
      (E37 [] k) (resume k 0)
      (E38 [] k) (resume k 0)
      (E39 [] k) (resume k 0)))
  0)
