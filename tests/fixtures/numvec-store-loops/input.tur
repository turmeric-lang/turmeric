;; numvec-store-loops: the store loops of simd-and-vectorization-plan Q7 --
;; views (`-view`, `-view-ref`, `-view-set!`), `-map!` over one source and
;; two (in place and into another array), `-build` through a view, and the
;; fixed-operation kernels `-sub!`, `-mul!`, `-add-scalar!`.  Float results
;; print as bit patterns, so every engine must agree to the last bit; integer
;; ones wrap.  An array argument that is not a name is freed after the loop
;; (leak-checked).  No inline C here, so tests/run-turi.sh runs it too and the
;; interpreter's view twins are held to the same output.
(load "stdlib/numvec.tur")
(load "stdlib/bits.tur")

(defn pf [x : float] : nil
  (println (float->bits x)))

(defn fresh [] : F64Vec
  (f64vec-of 0.5 0.25 4.0 -8.125))

(defn main [] : int
  (let [a (f64vec-of 7.1 3.25 -1.5 2.0)
        b (f64vec-of 0.5 0.25 4.0 -8.125)
        c (f64vec-new 4 0.0)]
    ;; two sources into a third array
    (f64vec-map! c [x a y b] {x * y})
    (f64vec-for [x c] (pf x))
    ;; in place
    (f64vec-map! a [x a] {x + 1.1})
    (f64vec-for [x a] (pf x))
    ;; a call as a source: freed after
    (f64vec-map! c [x (fresh)] {x - 0.3})
    (f64vec-for [x c] (pf x))
    ;; the kernels
    (f64vec-sub! a b)
    (f64vec-mul! a b)
    (f64vec-add-scalar! a 0.1)
    (f64vec-for [x a] (pf x)))
  ;; build through a view, then a view by hand
  (let [d (f64vec-build 5 [i] {(as float i) * 0.3})]
    (f64vec-for [x d] (pf x))
    (let [w (unsafe (f64vec-view d))]
      (unsafe (f64vec-view-set! w 2 9.9))
      (pf (unsafe (f64vec-view-ref w 2)))
      (pf (f64vec-ref d 2))))
  ;; float32
  (let [s (f32vec-of (:: 7.1 float32) (:: 3.25 float32))
        t (f32vec-of (:: 0.5 float32) (:: 2.5 float32))]
    (f32vec-map! s [x s y t] {x / y})
    (f32vec-sub! s t)
    (f32vec-mul! s t)
    (f32vec-add-scalar! s (:: 0.25 float32))
    (f32vec-for [x s] (pf (as float x))))
  ;; integers wrap
  (let [p (i64vec-build 3 [i] {i * 7})
        q (i64vec-of 9223372036854775807 3 4)]
    (i64vec-mul! p q)
    (i64vec-add-scalar! p 9223372036854775807)
    (i64vec-map! p [x p y q] {x - y})
    (i64vec-for [x p] (println x)))
  (let [p (i32vec-build 3 [i] (as int32 {i * 7}))
        q (i32vec-of (as int32 2147483647) (as int32 3) (as int32 4))]
    (i32vec-mul! p q)
    (i32vec-sub! p q)
    (i32vec-add-scalar! p (as int32 1))
    (i32vec-for [x p] (println (as int x))))
  (let [u (u8vec-of (as uint8 250) (as uint8 3))
        v (u8vec-of (as uint8 10) (as uint8 5))]
    (u8vec-add-scalar! u (as uint8 10))
    (u8vec-sub! v u)
    (u8vec-map! u [x u y v] (as uint8 {(as int x) + (as int y)}))
    (u8vec-for [x u] (println (as int x)))
    (u8vec-for [x v] (println (as int x))))
  0)
