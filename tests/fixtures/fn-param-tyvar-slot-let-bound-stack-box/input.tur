;; fn-param-tyvar-slot-let-bound-stack-box: the let-bound twin of
;; fn-param-tyvar-slot-invoked-stack-box.  `(let [f (ident d)] (f 10))` -- a
;; `(fn ...)`-typed parameter boxed for a generic's type-variable slot, by a
;; callee that only hands it back, held by a local that is only ever invoked.
;; The box is dead when the let ends, so it lives on the stack
;; (docs/reported/fn-param-at-type-variable-slot-boxed-per-call.md).
;; Leak-checked: 32 B a call before, over 100 turns of each.
(defn ident [A] [a : A] : A a)
(defn pick [A] [a : A b : A] : A b)
(defn plus1 [x : int] : int (+ x 1))
(defn halve [x : float] : float (/ x 2.0))
(defn add [a : int b : int] : int (+ a b))

(defn once [d : (fn [int] int)] : int
  (let [f (ident d)] (f 10)))
(defn twice [d : (fn [int] int)] : int
  (let [f (ident d)
        g (pick d d)]
    (+ (f 1) (g 2) (f 3))))
(defn via-float [d : (fn [float] float)] : float
  (let [h (ident d)] (h 7.1)))
(defn via-2 [d : (fn [int int] int)] : int
  (let [k (ident d)
        r (k 3 4)]
    (* r 2)))

(defn turns [n : int acc : int] : int
  (if (= n 0)
    acc
    (turns (- n 1) (+ acc (once plus1) (twice plus1) (via-2 add)))))

(defn main [] : int
  (println (once plus1))        ; 11
  (println (twice plus1))       ; 2 + 3 + 4 = 9
  (println (via-float halve))   ; 3.55
  (println (via-2 add))         ; 14
  (println (turns 100 0))       ; 100 * (11 + 9 + 14)
  0)
