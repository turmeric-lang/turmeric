;; discontinue-plan fixture 1: `(discontinue k payload)` raises a panic at the
;; `perform` k captured.  Nothing in the body catches it, so the body's defer
;; runs as it unwinds, the panic is raised again at the `discontinue` in the
;; clause, and from there it is an ordinary uncaught panic: the message names
;; the payload and the program aborts.  Behind --enable=discontinue (`flags`).
(defeffect Ask [] : int)

(defn body [] : int
  (defer (println "body: defer ran"))
  (+ 1 (perform (Ask))))

(defn main [] : int
  (defer (println "main: defer ran"))
  (println (handle (body) (Ask [] k) (do (discontinue k "boom") 0)))
  (println "not reached")
  0)
