;; sum-closure-payload-never-dropped, the other half: by-value Option locals
;; holding a fresh capturing closure that must NOT be dropped at scope exit,
;; because something else can still reach the closure.  Each still leaks its
;; env, as before the drop existed (so this fixture carries no
;; requires.leak-check); what it pins is that none is freed early.  A free in
;; `kept-by-callee` was a use-after-free (a segfault even without ASan) during
;; development: keep-opt's inferred nonretain_sum_param_mask covers the sum
;; BOX, not a closure taken out of one, so the drop now admits a callee only
;; when it is a tag predicate.
;;
;;   returned        -- the Option leaves the let
;;   binder-escapes  -- the match arm returns the closure
;;   kept-by-callee  -- handed to a callee that stores the closure it matches out
;;   kept-deeper     -- handed to a callee that hands it to keep-opt
;;   echoed          -- handed to a callee that returns the Option itself
;;   recursive       -- handed to a self-recursive callee (never admitted)
;;   c-callee        -- handed to a callee whose body is inline C (which could
;;                      stash the closure where no walk can see it)
;;   aliased         -- `(let [g ff] ...)`
;;   unwrap-returned -- the closure `unwrap` projects is bound, then returned
;;   unwrap-stored   -- the projected closure is pushed into a vector
;;   unwrap-let-kept -- bound in a nested let, and that binding is stored
;;   unwrap-or-kept  -- `unwrap-or`'s result pushed into a vector

(defn returned [k : int] : (Option (fn [int] int))
  (let [ff (some (fn [x : int] : int (+ x k)))]
    ff))

(defn binder-escapes [k : int] : (fn [int] int)
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (match ff
      (Some f) f
      (None) (fn [x : int] : int x))))

(defn keep-opt [o : (Option (fn [int] int)) v : (Vec (fn [int] int))] : int
  (match o
    (Some f) (do (vec-push! v f) 1)
    (None) 0))

(defn kept-by-callee [k : int v : (Vec (fn [int] int))] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (keep-opt ff v)))

(defn kept-deeper [k : int v : (Vec (fn [int] int))] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (+ 1 (keep-opt ff v))))

(defn echo-opt [o : (Option (fn [int] int))] : (Option (fn [int] int)) o)

(defn echoed [k : int] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (match (echo-opt ff)
      (Some f) (f 2)
      (None) 0)))

(defn count-down [o : (Option (fn [int] int)) n : int] : int
  (if (= n 0)
    (match o (Some f) (f 0) (None) 0)
    (count-down o (- n 1))))

(defn recursive [k : int] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (count-down ff 3)))

(defn c-stash [o : (Option (fn [int] int))] : int
  ```c
  (void)o;
  return 1;
  ```)

(defn c-callee [k : int] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (+ 41 (c-stash ff))))

(defn aliased [k : int] : int
  (let [ff (some (fn [x : int] : int (+ x k)))
        g ff]
    (match g
      (Some f) (f 3)
      (None) 0)))

(defn unwrap-returned [k : int] : (fn [int] int)
  (let [ff (some (fn [x : int] : int (+ x k)))
        f (unwrap ff)]
    f))

(defn unwrap-stored [k : int v : (Vec (fn [int] int))] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (vec-push! v (unwrap ff))
    1))

(defn unwrap-let-kept [k : int v : (Vec (fn [int] int))] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (let [g (unwrap ff)]
      (vec-push! v g)
      (g 0))))

(defn unwrap-or-kept [k : int v : (Vec (fn [int] int))] : int
  (let [ff (some (fn [x : int] : int (+ x k)))]
    (vec-push! v (unwrap-or ff (fn [x : int] : int x)))
    1))

(defn main [] : int
  (println (match (returned 2) (Some f) (f 40) (None) 0))   ;; 42
  (println ((binder-escapes 40) 2))                          ;; 42
  (println (aliased 39))                                     ;; 42
  (println (echoed 40))                                      ;; 42
  (println (recursive 42))                                   ;; 42
  (println (c-callee 40))                                    ;; 1 + 41 = 42
  (let [v : (Vec (fn [int] int)) (vec-new)]
    (println (kept-by-callee 40 v))                          ;; 1
    (println (kept-deeper 10 v))                             ;; 2
    (println ((vec-get v 0) 2))                              ;; 42 -- the kept closures
    (println ((vec-get v 1) 32))                             ;; 42
    (let [u (unwrap-returned 40)]
      (println ((binder-escapes 1000) 0))                    ;; reuse the heap
      (println (u 2)))                                       ;; 42
    (println (unwrap-stored 30 v))                           ;; 1
    (println (unwrap-let-kept 20 v))                         ;; 20
    (println (unwrap-or-kept 10 v))                          ;; 1
    (println (kept-by-callee 1000 v))                        ;; reuse the heap
    (println ((vec-get v 2) 12))                             ;; 42
    (println ((vec-get v 3) 22))                             ;; 42
    (println ((vec-get v 4) 32))                             ;; 42
    0))
