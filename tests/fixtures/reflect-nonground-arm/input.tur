;; reflected-measures RF4: unfolding at a NON-ground argument, through the
;; hypotheses a caller's own `match` arm supplies.
;;
;; A return obligation is proved one arm at a time, and each arm knows its
;; constructor as a TAG fact, `(= (#dt/tag xs) 0)`, and its binders as field
;; selectors, `(= t (.tl xs))` -- never as `xs = (Cons h t)`.  So RF3's
;; syntactic reduction had no constructor term to select an arm against and
;; `(sorted? xs)` stayed opaque wherever `xs` was a variable.
;;
;; RF4 selects the arm from the tag fact and binds the arm's variables to the
;; same `.hd`/`.tl` selectors the hypotheses are written with, comparing forms
;; modulo the binder equations (`t` and `(.tl xs)` are one value here).  In
;; the Cons/Cons arm below that gives
;;   sorted?(xs) <=> (.hd xs <= .hd (.tl xs)) and sorted?(.tl xs)
;; from the precondition, and the goal `sorted?(t)` closes by congruence with
;; `t = (.tl xs)`.  The sibling errors/reflect-nonground-no-tag drops the
;; inner match so nothing pins `t`, and must stay unknown.  (The result is a
;; bool rather than the refined list itself because a refined ADT RETURN type
;; miscompiles today -- docs/archive/refined-adt-return-type-miscompiles.md
;; -- which is unrelated to reflection.)
(defdata Lst [] (Cons [hd : int tl : Lst]) (Nil))

(defn ^reflect sorted? [xs : Lst] : bool
  (match xs
    (Nil) true
    (Cons h t) (match t
                 (Nil) true
                 (Cons h2 _) (and (<= h h2) (sorted? t)))))

(defn tail-sorted? [xs : #refine{ v : Lst | (sorted? v) }] : #refine{ r : bool | r }
  (match xs
    (Nil) true
    (Cons h t) (match t
                 (Nil) true
                 (Cons h2 t2) (sorted? t))))

(defn main [] : int
  (println (tail-sorted? (Cons 1 (Cons 2 (Cons 3 (Nil))))))
  (println "reflect-nonground-arm")
  0)
