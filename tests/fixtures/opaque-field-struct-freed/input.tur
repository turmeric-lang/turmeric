;; opaque-field-struct-box-never-freed: a struct with a `defopaque` field --
;; `String` among them -- was laid out on the carrier ABI, a heap box per
;; construction that nothing freed.  An opaque field is one word, so the struct
;; is a by-value product now and there is no box.  Leak-checked: every shape
;; below leaked before (a let, a copy, a function result, a nested struct, Vec
;; elements).
(load "stdlib/string.tur")

(defopaque Key :int)
(defstruct ^copy Node [key : Key weight : int depth : int])
(defstruct Person [name : String age : int])
(defstruct Team [lead : Person size : int])

(defn node-at [i : int] : Node (Node (:: i Key) (* i 10) (+ i 1)))
(defn key-of [n : Node] : int (:: (.key n) int))

(defn person [name : cstr age : int] : Person (Person (string/from-cstr name) age))

(defn main [] : int
  (let [n     (Node (:: 3 Key) 1 2)
        m     n
        p     (person "ann" 41)
        t     (Team (person "bo" 29) 5)
        nodes (vec-new)
        ^mut i 0]
    (do
      (while (< i 4)
        (do (vec-push! nodes (node-at i)) (set! i (+ i 1))))
      (println (key-of n))
      (println (.weight m))
      (println (string/to-cstr (.name p)))
      (println (.age p))
      (println (string/to-cstr (.name (.lead t))))
      (println (.size t))
      (println (key-of (vec-get nodes 3)))
      (println (.weight (vec-get nodes 2)))
      (string/release (.name p))
      (string/release (.name (.lead t)))
      (vec-free nodes)
      0)))
