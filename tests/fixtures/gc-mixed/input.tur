; gc-mixed: mix of live and dead objects -- GC collects only zombies.
; x stays alive (strong_count=1), y becomes a zombie.
; After gc!, x's strong_count should still be 1, y's upgrade should return none.
(load "stdlib/weak.tur")

(defn main [] : int
  (gc-enable!)
  (let [x (rc/of 10)
        y (rc/of 20)]
    (let [wy (weak y)]
      (rc/drop y)
      (gc!)
      (println (rc/strong-count x))          ; expected: 1
      (let [uy (weak/upgrade wy)]
        (println (if (some? uy) 1 0)))        ; expected: 0 -- y was collected
      (rc/drop x)
      0)))
