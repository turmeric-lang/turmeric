; #dedent"""...""": indent-aware, verbatim multi-line string literal.  The
; closing delimiter's indent is what gets stripped; the line break before it
; is not part of the string.  No load or #use-reader-macros is needed.
(defn show [label : cstr s : cstr] : int
  (println label)
  (println s)
  0)

(defn main [] : int
  ; basic: relative indentation survives, source indentation does not
  (show "basic" #dedent"""
      Usage: tool [options]
        -h  show help
      """)
  ; code is verbatim: braces, quotes and backslashes need no escaping
  (show "code" #dedent"""
      int main(void) {
          printf("a\tb\n");
          return 0;
      }
      """)
  ; leading blank lines are dropped
  (show "blanks" #dedent"""


      a
      b
      """)
  ; interior blank line kept, whitespace-only lines become empty
  (show "gap" #dedent"""
      one
   
      two
      """)
  ; a blank line before the closer gives a final newline
  (show "final-newline" #dedent"""
      a

      """)
  ; an indented closer strips less: the extra indent stays in the string
  (show "closer-left" #dedent"""
        kept
      """)
  ; a closer inline after text: the first line sets the indent
  (show "inline-closer" #dedent"""
      first
        second""")
  ; hash escalation lets the body contain three quotes
  (show "hashes" #dedent#"""
      say """hi"""
      """#)
  (show "hashes2" #dedent##"""
      "#" and """# stay
      """##)
  ; empty body
  (show "empty" #dedent"""
      """)
  0)
