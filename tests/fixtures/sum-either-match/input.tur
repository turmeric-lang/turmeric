; Sum-types plan T8.2: match over both arms with payload extraction.
(defdata ^copy Either [L R]
  (Left L)
  (Right R))

(defn show [e : int] : int
  (match e
    (Left l)  l
    (Right r) r))

(defn main [] : int
  (let [a (Left 42)
        b (Right 7)]
    (println (show a))
    (println (show b)))
  0)
