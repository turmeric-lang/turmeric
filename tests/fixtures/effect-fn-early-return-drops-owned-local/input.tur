;; The same early `return`, leaving a Drop local the path still owns: the
;; enclosing let's scope-exit drop runs, unless the return's own value handed
;; the local on.  (`e7 true` never released its widget.)
;;
;; Compiled only: under `tur --interpret` an early `return` skips a let's
;; injected drop in ANY function, effects or not
;; (docs/reported/turi-early-return-skips-injected-drops.md).  The shapes the
;; interpreter does agree on are in effect-fn-early-return-runs-scope-exits.
(defopaque ^affine Widget :int)
(defn mk [] : Widget (println "  mk") (:: 7 Widget))
(defn rel [w : Widget] : void (println "  rel") (:: w int) nil)
(definstance Drop [Widget] (drop [x] : void (rel x)))
(defn peek [^borrow w : Widget] : int 1)
(defn take [w : Widget] : int (println "  take") (:: w int))
(defeffect Ask [] : int)

(defn e7 [c : bool] : int
  (let [h (mk)
        a (perform (Ask))]
    (if c (return 0) nil)
    (+ a (peek h))))

(defn handed-on [c : int] : int
  (let [h (mk)
        a (perform (Ask))]
    (if (= c 0) (return (take h)) nil)
    (if (= c 1) (return 30) nil)
    (+ a (peek h))))

(defn run7 [c : bool] : int (handle (e7 c) (Ask [] k) (resume k 100)))
(defn run-handed [c : int] : int (handle (handed-on c) (Ask [] k) (resume k 100)))

(defn main [] : int
  (println "e7 true") (println (run7 true))
  (println "e7 false") (println (run7 false))
  (println "handed-on 0") (println (run-handed 0))
  (println "handed-on 1") (println (run-handed 1))
  (println "handed-on 2") (println (run-handed 2))
  0)
