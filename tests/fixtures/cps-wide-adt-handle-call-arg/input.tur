;; A `handle` whose value is a WIDE by-value aggregate, passed straight to an
;; uncolored callee: `(area (handle (Rect ...) ...))`.  The callee's direct C
;; signature takes the aggregate as `const tur_adt_Shape *` (over 16 bytes:
;; type_struct_pass_by_ptr), and the CPS call gate admitted only a narrow one,
;; so the caller evicted -- "this effect operation has no lowering here" at the
;; `perform` -- and so did every function sharing the effect (BODY-TAINT).
;; The `let`-bound twin built.  The CPS emitter now passes `&(atom)`, as the
;; direct emitter does.  See
;; docs/archive/adt-handle-result-as-call-arg-evicts.md.
;;
;;   tail-arg     the call in tail position (the cps->direct tail arm)
;;   nontail-arg  under `+` (CT_LETCALL)
;;   float-arg    a 16-byte product of floats, still passed by value
;;   struct-arg   a wide defstruct between two scalar arguments
;;   sibling      shares Ask; it was evicted along with the rest
;;
;; 3*4 = 12; 100 + 2*5 = 110; (7.1 + 2.5) - 1.25 = 8.35;
;; 1000 + (4 + 20 + 300) + 5000 = 6324; 41 + 1 = 42.

(defdata Shape (Circle :int) (Rect :int :int))
(defdata Seg (Seg2 :float :float))
(defstruct Box3 [a : int b : int c : int])
(defeffect Ask [] int)
(defeffect AskF [] float)

(defn area [s : Shape] : int
  (match s
    (Circle r) (* 3 r)
    (Rect w h) (* w h)))
(defn seg-len [s : Seg] : float
  (match s
    (Seg2 a b) (- b a)))
(defn box-sum [x : int b : Box3 y : int] : int
  (+ x (+ (.a b) (+ (.b b) (+ (.c b) y)))))

(defn tail-arg [] : int
  (area (handle (Rect (perform (Ask)) 4) (Ask [] k) (resume k 3))))
(defn nontail-arg [] : int
  (+ 100 (area (handle (Rect (perform (Ask)) 5) (Ask [] k) (resume k 2)))))
(defn float-arg [] : float
  (seg-len (handle (Seg2 1.25 (+ 7.1 (perform (AskF)))) (AskF [] k) (resume k 2.5))))
(defn struct-arg [] : int
  (box-sum 1000 (handle (Box3 (perform (Ask)) 20 300) (Ask [] k) (resume k 4)) 5000))
(defn sibling [] : int
  (handle (+ (perform (Ask)) 1) (Ask [] k) (resume k 41)))

(defn main [] : nil
  (println (tail-arg))
  (println (nontail-arg))
  (println (float-arg))
  (println (struct-arg))
  (println (sibling)))
