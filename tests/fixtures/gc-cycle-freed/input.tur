; gc-cycle-freed: a zombie (strong=0, weak>0) is freed by explicit gc/collect.
; After rc/drop, r's strong_count reaches 0 while weak_count=1 (zombie state).
; gc! should free the zombie value; upgrade then returns none (not alive).
(load "stdlib/weak.tur")

(defn main [] : int
  (gc-enable!)
  (let [r (rc/of 99)]
    (let [w (weak r)]
      (rc/drop r)
      (gc!)
      (let [u (weak/upgrade w)]
        (println (if (some? u) 1 0)))))  ; expected: 0 -- rc was collected
  0)
