; CG2 (gc-cycle-collection-plan): (gc!) must now RECLAIM a live strong rc<T>
; cycle -- the case the collector could never handle before.
;
; Pre-CG2 the mark phase treated every strong_count>0 block as a root, and every
; member of a self-sustaining cycle has strong_count>0 via its own back-edge, so
; a cycle was unconditionally marked live. Measured leak: 192 bytes per cycle,
; identical whether the collector was on or off
; (docs/archive/history/gc-strong-cycles-not-collected.md).
;
; Real trial deletion subtracts the internal edges first, so a block referenced
; only from within the candidate subgraph falls to a zero trial count and is
; collected. This builds many two-node cycles, collecting after each, and
; asserts the heap does not grow.
(defstruct ^move S [next : rc<S>])

(defn null-rc-s [] : ptr<void>
  ```c
  return NULL;
  ```)

; The no-growth assertion reads the CG6 collector counter, not a malloc probe.
; Every cycle this fixture builds is a pair of rc<S> control blocks, and each
; one is registered with the collector at rc_cb_alloc_kinded and unregistered
; when it is freed -- by the collector OR by plain refcounting -- so
; (gc-live-blocks) is exactly "cycles not yet reclaimed, times two".
;
; It replaced a malloc probe (mallinfo2 / malloc_zone_statistics) that measured
; the PROCESS heap.  That probe was blind or wrong in three separate ways, and
; the third is what forced the change:
;
;   glibc + ASan     reads 0 on both sides -- ASan replaces the allocator, so
;                    the check was vacuous (docs/archive/history/
;                    gc-leak-gate-darwin-sanitized-probe-drift.md)
;   Darwin + ASan    reads ~800000 -- ASan's quarantine keeps freed blocks
;                    accounted as in-use, so a fixture that frees everything
;                    still shows a large positive delta
;   any `tur jit`    reads the COMPILER's heap: under one-process jit the
;                    program has no process of its own to measure
;   any other libc   returns 0 unconditionally -- vacuously true
;
; The counter has none of those failure modes: it is program-scoped (nothing in
; the compiler or interpreter allocates rc blocks), exact rather than
; tolerance-based, and portable.  tests/fixtures/gc-collects-strong-cycle-heap-bytes
; keeps the byte-level probe as an unsanitized-cc-only backstop, since bytes can
; still catch a payload leak that does not leak a control block.

(defn build-cycle [] : int
  (let [s1 (rc/of (make-struct S (null-rc-s)))
        s2 (rc/of (make-struct S (rc/clone s1)))]
    ; after the back-edge both nodes sit at strong=2: one external binding plus
    ; one in-cycle reference. Leaving this scope drops each to 1, which is the
    ; PossibleRoot edge CG1 buffers and CG2 then proves is garbage.
    (set! (.next s1) (rc/clone s2))
    0))

(defn run [n : int] : int
  (let [^mut i 0]
    (while (< i n)
      (build-cycle)
      (gc!)
      (set! i (+ i 1))))
  0)

(defn main [] : int
  (gc-enable!)
  (run 500)                       ; reach steady state before sampling
  (let [before (gc-live-blocks)]
    (run 5000)
    (let [after (gc-live-blocks)]
      ; 0 == every cycle reclaimed. Pre-CG2 this leaked both blocks of every
      ; pair, i.e. 10000 here (and 192 bytes per cycle on the old probe).
      (println (if (= (- after before) 0) 0 (- after before)))
      0)))
