;; cps-local-fn-alias-or-lambda-called-in-place-refused (the mutual `letrec`):
;; a capturing `letrec` of SEVERAL members -- `ev` and `od` capturing one
;; another and a local of the enclosing function -- whose members are only
;; ever called, saturated, was refused ("no lowering here").  The group is
;; lowered like a `let` of a local closure, member by member: a call through a
;; member, from the body or from a sibling's lambda, is the member lambda's own
;; CPS call with its env box first, so a `perform` inside reaches the caller's
;; handler.  The boxes are built under the direct emitter's letrec knot (a slot
;; for a member bound later is zeroed, then patched) and reaped together at the
;; entry boundary.  Every line equals `tur --interpret`.
(defeffect Ask [] :int)
(defeffect Tick [] :nil)
(defstruct Pt [x : int y : int])

;; two members, the effect performed in one, tail calls
(defn v3 [m : int] : int
  (letrec [ev (fn [i : int] : int (if (= i 0) (+ m (perform (Ask))) (od (- i 1))))
           od (fn [i : int] : int (if (= i 0) m (ev (- i 1))))]
    (ev 4)))

;; non-tail calls between the members, and a non-tail call from the body
(defn nt [m : int] : int
  (letrec [ev (fn [i : int] : int (if (= i 0) (perform (Ask)) (+ m (od (- i 1)))))
           od (fn [i : int] : int (if (= i 0) 0 (+ 1 (ev (- i 1)))))]
    (* 2 (ev 5))))

;; a three-member chain
(defn chain [m : int] : int
  (letrec [a (fn [i : int] : int (if (= i 0) (perform (Ask)) (b (- i 1))))
           b (fn [i : int] : int (if (= i 0) m (c (- i 1))))
           c (fn [i : int] : int (if (= i 0) (* 2 m) (a (- i 1))))]
    (+ (a 3) (a 4) (a 5))))

;; both members perform, different effects
(defn both [m : int] : int
  (letrec [ev (fn [i : int] : int
                (do (perform (Tick))
                    (if (= i 0) (+ m (perform (Ask))) (od (- i 1)))))
           od (fn [i : int] : int (if (= i 0) (perform (Ask)) (ev (- i 1))))]
    (+ (ev 3) (od 3))))

;; a member that calls itself as well as its sibling
(defn selfsib [m : int] : int
  (letrec [ev (fn [i : int] : int
                (if (= i 0) (perform (Ask))
                  (if (= (mod i 2) 0) (ev (- i 1)) (+ m (od (- i 1))))))
           od (fn [i : int] : int (if (= i 0) m (ev (- i 1))))]
    (ev 6)))

;; float capture and float result
(defn fl [m : float] : float
  (letrec [ev (fn [i : int] : float (if (= i 0) (+ m (as float (perform (Ask)))) (od (- i 1))))
           od (fn [i : int] : float (if (= i 0) (* 2.5 m) (ev (- i 1))))]
    (+ (ev 2) (ev 3))))

;; a struct capture
(defn st [p : Pt] : int
  (letrec [ev (fn [i : int] : int (if (= i 0) (+ (.x p) (perform (Ask))) (od (- i 1))))
           od (fn [i : int] : int (if (= i 0) (.y p) (ev (- i 1))))]
    (+ (ev 2) (od 2))))

;; the body performs around the calls; both members called from the body
(defn around [m : int] : int
  (letrec [ev (fn [i : int] : int (if (= i 0) (+ m (perform (Ask))) (od (- i 1))))
           od (fn [i : int] : int (if (= i 0) m (ev (- i 1))))]
    (let [a (perform (Ask))
          b (ev 2)
          c (perform (Ask))
          d (od 2)]
      (+ a b c d))))

;; two-parameter members
(defn two [m : int] : int
  (letrec [ev (fn [i : int acc : int] : int
                (if (= i 0) (+ acc (perform (Ask))) (od (- i 1) (+ acc m))))
           od (fn [i : int acc : int] : int
                (if (= i 0) acc (ev (- i 1) (+ acc 1))))]
    (ev 5 0)))

;; the group nested in a capturing lambda, itself called in place
(defn nested [m : int] : int
  (let [h (fn [x : int] : int
            (letrec [ev (fn [i : int] : int (if (= i 0) (+ m x (perform (Ask))) (od (- i 1))))
                     od (fn [i : int] : int (if (= i 0) x (ev (- i 1))))]
              (ev 2)))]
    (+ (h 1) (h 2))))

;; a mutual loop that performs on every turn (the 1,000,000-turn twin is
;; cps-capturing-letrec-mutual-deep, compiled only)
(defn ping [m : int n : int] : int
  (letrec [ev (fn [i : int acc : int] : int
                (if (= i 0) acc (od (- i 1) (+ acc m (perform (Ask))))))
           od (fn [i : int acc : int] : int
                (if (= i 0) acc (ev (- i 1) (+ acc (perform (Ask))))))]
    (ev n 0)))

;; one counting handler over 100 calls from a loop
(defn count-loop [i : int acc : int] : int
  (if (= i 0) acc (count-loop (- i 1) (+ acc (v3 i)))))

(defn main [] : int
  (println (handle (v3 1) (Ask [] k) (resume k 10)))          ; 11
  (println (handle (nt 3) (Ask [] k) (resume k 10)))          ; 2*(3+1+3+1+3+10) = 42
  (println (handle (chain 1) (Ask [] k) (resume k 10)))       ; a3->b->c->a=10, a4->b->c->a->b=1, a5->...c=2 => 13
  (let [^mut ticks 0]
    (println (handle (handle (both 2) (Ask [] k) (resume k 10))
                     (Tick [] k) (do (set! ticks (+ ticks 1)) (resume k nil))))   ; 12 + 10 = 22
    (println ticks))                                          ; 4 (ev 3 twice: ev3,ev1 ; od3->ev2->od1->ev0: 2)
  (println (handle (selfsib 1) (Ask [] k) (resume k 10)))     ; 6->5(ev)->od4->ev3->od2... compute
  (println (handle (fl 1.25) (Ask [] k) (resume k 3)))        ; ev2->od1->ev0 = 4.25 ; ev3->od2->ev1->od0 = 3.125 => 7.375
  (println (handle (st (Pt 3 4)) (Ask [] k) (resume k 10)))   ; ev2->od1->ev0 = 13 ; od2->ev1->od0 = 4 => 17
  (println (handle (around 1) (Ask [] k) (resume k 10)))      ; 10 + 11 + 10 + 1 = 32
  (println (handle (two 1) (Ask [] k) (resume k 10)))         ; ev5->od4(1)->ev3(2)->od2(3)->ev1(4)->od0(5) = 5
  (println (handle (nested 1) (Ask [] k) (resume k 10)))      ; h1: ev2->od1->ev0=12 ; h2: 13 => 25
  (println (handle (ping 1 2000) (Ask [] k) (resume k 1)))    ; 1000*(1+1) + 1000*1 = 3000
  (let [^mut n 0]
    (println (handle (count-loop 100 0) (Ask [] k) (do (set! n (+ n 1)) (resume k n))))
    (println n))                                              ; 100
  0)
