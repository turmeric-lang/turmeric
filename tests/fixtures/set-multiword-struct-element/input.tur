;; collection-multiword-element-boxing (Set element): a MULTI-WORD by-value
;; :copy struct element (Point, 16 bytes) in a Set is a boxed MapKey -- Set
;; content-keys through Hash[A] + MapKey[A] exactly like a Map key.  Works on
;; BOTH the compiled and interpreter paths via #?(:tur ... :turi ...) reader
;; conditionals (see map-multiword-struct-key for the mechanism).  The set _eq_o
;; interpreter natives handle the struct comparator symmetrically with the map
;; natives, so membership, dedup, and structural Eq[Set] all agree bit-for-bit.
;;
;; Runs on both paths (whitelisted in tests/run-turi.sh TURI_INLINEC_RUN).
(load "stdlib/typeclass.tur")

(defstruct ^copy Point [x : int y : int])

(definstance Hash [Point]
  (hash [p] : int
    #?(:tur ```c return (int64_t)tur_hamt_hash_xxh64((const void*)&p, sizeof(p)); ```
       :turi (struct-hash p))))
(definstance Eq [Point]
  (eq? [a b] (and (= (.x a) (.x b)) (= (.y a) (.y b)))))
(definstance MapKey [Point]
  (mk-box [p] : int
    #?(:tur ```c return (int64_t)(intptr_t)tur_hamt_box_key((const void*)&p, sizeof(p)); ```
       :turi p))
  (mk-cmp [p] : int
    #?(:tur ```c return (int64_t)(intptr_t)&tur_hamt_box_key_eq; ```
       :turi (struct-key-cmp)))
  (mk-owned? [p] #?(:tur 1 :turi 0)))

(defn main [] : int
  (let [s (set-add1 (set-add1 (:: (set-new) (Set Point)) (Point 1 2)) (Point 3 4))]
    (println (if (set-member? s (hash (Point 1 2)) (Point 1 2)) "in" "out"))   ;; in
    (println (if (set-member? s (hash (Point 3 4)) (Point 3 4)) "in" "out"))   ;; in
    (println (if (set-member? s (hash (Point 9 9)) (Point 9 9)) "in" "out"))   ;; out
    (show-line (set-count s))                                             ;; 2
    (show-line (set-count (set-add1 s (Point 1 2))))                       ;; 2 -- dedup
    (let [a (set-add1 (:: (set-new) (Set Point)) (Point 5 6))
          b (set-add1 (:: (set-new) (Set Point)) (Point 5 6))
          c (set-add1 (:: (set-new) (Set Point)) (Point 7 8))]
      (println (if (.eq? a b) "eq" "ne"))    ;; eq
      (println (if (.eq? a c) "eq" "ne")))   ;; ne
    0))
