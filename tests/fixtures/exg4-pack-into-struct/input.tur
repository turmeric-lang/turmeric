;; Phase F1-1-6 / F8-6 (cross-plan-followups): EXG4-5's third
;; fixture, previously blocked on the `defstruct` parser only
;; accepting simple keyword/sym types.  F8 extended the field-type
;; parser to accept compound forms (TY_APP, TY_EXISTS, TY_FORALL)
;; via `type_expr_from_form` and stored the full Type on
;; StructField.full_type so consumers (open, .eq?, etc.) see the
;; right payload.
;;
;; The fixture stores a packed constrained existential in a struct
;; field, then opens it back out through `(.payload b)` and
;; dispatches `.show` on the bound value.  Without F8, the field's
;; type would erase to bare int64 and open would either be rejected
;; or read the rc-block pointer as the bound value instead of
;; dereferencing through to the existential record.
(defclass Show [a]
  (show [x] : cstr))

(definstance Show [int]
  (show [x] : cstr
    ```c
    char *buf = (char *)malloc(24);
    snprintf(buf, 24, "%lld", (long long)x);
    return (const char *)buf;
    ```))

(defstruct ^move Box
  [payload (exists [a] [(Show a)] a)])

(defn main [] : int
  (let [b (make-struct Box (pack 42 (exists [a] [(Show a)] a)))]
    (open (.payload b) [_ v]
      (println (.show v))))
  0)
