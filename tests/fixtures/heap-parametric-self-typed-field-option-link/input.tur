;; self-typed-heap-parametric-field-unsupported: the self-reference behind an
;; `Option`.  `(Option (Node int))` is a by-value sum holding `tur_adt_Node__int *`,
;; and `Node__int` holds that sum BY VALUE -- a two-node typedef cycle.  The
;; dependency pre-pass used to recurse from Option into Node and emit Node's
;; body before Option was complete (`unknown type name
;; 'tur_adt_Option__Node__int'`); a dependency held by pointer now gets a
;; forward `typedef struct X X;` instead, so Option finishes first.
(defstruct ^heap Node [A] (val A) (next (Option (Node A))))

(defn main [] : int
  (let [m (make-struct Node 8 (:: (none) (Option (Node int))))
        n (make-struct Node 7 (some m))]
    (match (.next n)
      (Some x) (println (.val x))
      (None) (println 0))
    (match (.next m)
      (Some x) (println (.val x))
      (None) (println 0)))
  0)
