;; Prompt turns for `run.js --turns` (wasm-jit-plan P6): C1 compiles each
;; inline-C defn the interpreter cannot run on its first call.  Expected:
;; 7, 128, 5.22015, 70.
---
(defn seven [] : int
  ```c
  return 7;
  ```)
---
(seven)
---
(defn c-mix [a : int b : int] : int
  ```c
  int64_t t = a;
  for (int i = 0; i < 2; i++) t += i;
  return t * 31 + b;
  ```)
---
(c-mix 3 4)
---
(defn hyp [a : float b : float] : float
  ```c
  double sqrt(double);
  return sqrt(a * a + b * b);
  ```)
---
(hyp 3.1 4.2)
---
(+ (c-mix 1 1) (seven))
