{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Turmeric",
  "scopeName": "source.turmeric",
  "patterns": [
    {
      "include": "#scheme-file"
    },
    {
      "include": "#lang-directive"
    },
    {
      "include": "#inline-c"
    },
    {
      "include": "#doc-comment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#special-form"
    },
    {
      "include": "#else-clause"
    },
    {
      "include": "#dispatch"
    },
    {
      "include": "#type-annotation"
    },
    {
      "include": "#effect-row"
    },
    {
      "include": "#param-attribute"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword-literal"
    }
  ],
  "repository": {
    "lang-directive": {
      "comment": "`#lang <base>[/<dialect>] <layer>*` -- must be the first line. The base is highlighted distinctly from the layers so `#lang saffron` reads as a language choice rather than a comment.",
      "match": "^(#lang)[ \\t]+([a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)?)((?:[ \\t]+[a-z][a-z0-9-]*)*)[ \\t]*$",
      "captures": {
        "1": {
          "name": "keyword.control.directive.lang.turmeric"
        },
        "2": {
          "name": "entity.name.type.lang-base.turmeric"
        },
        "3": {
          "name": "entity.other.attribute-name.lang-layer.turmeric"
        }
      }
    },
    "inline-c": {
      "comment": "A ```c ... ``` fence inside a defn body is C, not Turmeric.",
      "begin": "(```)(c)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.turmeric"
        },
        "2": {
          "name": "entity.name.tag.embedded.turmeric"
        }
      },
      "end": "(```)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.raw.turmeric"
        }
      },
      "contentName": "meta.embedded.block.c",
      "patterns": [
        {
          "include": "source.c"
        }
      ]
    },
    "doc-comment": {
      "comment": ";;; is the docstring marker (see CLAUDE.md), distinct from an ordinary ;; comment.",
      "match": ";;;.*$",
      "name": "comment.block.documentation.turmeric"
    },
    "comment": {
      "match": ";.*$",
      "name": "comment.line.semicolon.turmeric"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.turmeric",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.turmeric"
        }
      ]
    },
    "char": {
      "match": "\\\\(?:space|newline|tab|return|[^\\s()\\[\\]{}])",
      "name": "constant.character.turmeric"
    },
    "definition": {
      "comment": "Definition forms and the name each binds. Ordered longest-first inside the alternation so `defn` cannot shadow `defnative`-style names.",
      "match": "(\\()(defprotocol|definstance|defdynamic|defrecord|defstruct|defopaque|defmodule|defmacro|defalias|defclass|defeffect|defimage|defworld|defgadt|defdata|deftype|defkind|defrec|define|defn|def)\\b[ \\t]*([^\\s()\\[\\]{};]+)?",
      "captures": {
        "1": {
          "name": "punctuation.section.parens.begin.turmeric"
        },
        "2": {
          "name": "storage.type.turmeric"
        },
        "3": {
          "name": "entity.name.function.turmeric"
        }
      }
    },
    "special-form": {
      "match": "(?<=\\()(with-handler|compose-handlers|cloneable-reset|cloneable-shift|serial-reset|serial-shift|catch-unwind|discontinue|with-region|use-reader-macros|panic-with|bt-scope|call/cc|handle|resume|perform|reset|shift0|shift|escape|import|export|match|letrec|loop|while|when|unless|cond|case|let|fn|if|do|for|set!|and|or|not|quote|quasiquote|unquote|lambda|recur|return|defer|await|async|spawn|yield|try|catch|throw|is\\?|cast|type-of)(?![A-Za-z0-9_/!?<>=*+-])",
      "name": "keyword.control.turmeric",
      "comment": "Special forms. The terminator is a negative lookahead, not `\\b`: a form ending in `?` or `!` (`is?`, `set!`) has no word boundary after it, so `\\b` silently matched nothing for them."
    },
    "else-clause": {
      "comment": "The `cond` / `case` fallback clause head. `:else` falls out of #keyword-literal; the bare spelling is an ordinary symbol to the reader, so it needs its own rule to read as the clause it is. Not part of #special-form: that rule requires a preceding `(`, and a clause head never has one.",
      "match": "(?<![A-Za-z0-9_/!?<>=*+-])else(?![A-Za-z0-9_/!?<>=*+-])",
      "name": "keyword.control.turmeric"
    },
    "dispatch": {
      "comment": "Reader dispatch: #map{...} #set{...} #refine{...} #fx{...} #writes #reads, and the [..] vector literal's own brackets are punctuation.",
      "match": "#(map|set|refine|fx|writes|reads|s)\\b",
      "name": "keyword.other.dispatch.turmeric"
    },
    "type-annotation": {
      "comment": "Both spellings: fused `x :int` and spaced `x : int`. The spaced form is what CLAUDE.md's style guide uses; a grammar that only knew the fused one would leave half the stdlib unhighlighted.",
      "match": "(?<=[\\s\\[])(:)[ \\t]*([A-Za-z_][A-Za-z0-9_/<>-]*)",
      "captures": {
        "1": {
          "name": "punctuation.separator.type.turmeric"
        },
        "2": {
          "name": "entity.name.type.turmeric"
        }
      }
    },
    "effect-row": {
      "match": "#\\{[^}]*\\}",
      "name": "entity.other.attribute-name.effect.turmeric"
    },
    "param-attribute": {
      "comment": "^mut ^linear ^unique ^borrow ^fat -- parameter disciplines.",
      "match": "\\^[a-z][a-z0-9-]*",
      "name": "storage.modifier.turmeric"
    },
    "constant": {
      "match": "\\b(true|false|nil|nil-value)\\b",
      "name": "constant.language.turmeric"
    },
    "number": {
      "comment": "Floats before ints, so 7.1 is one token rather than 7 and .1.",
      "match": "(?<![A-Za-z0-9_-])-?(?:0[xX][0-9a-fA-F]+|[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?|[0-9]+)\\b",
      "name": "constant.numeric.turmeric"
    },
    "keyword-literal": {
      "comment": "A bare :keyword in value position -- distinct from a type annotation, which is preceded by whitespace inside a binder.",
      "match": ":[A-Za-z_][A-Za-z0-9_-]*",
      "name": "constant.other.keyword.turmeric"
    },
    "scheme-file": {
      "comment": "r7rs-lang-plan R9: a `#lang r7rs` file. Begins at the directive and never ends, so the Scheme lexemes apply to that file only -- two of them collide with Turmeric (a `|...|` symbol would swallow the `|` of `#refine{x : T | pred}`, and `#|` is not a Turmeric comment). The Scheme rules come first so they win at a shared position.",
      "begin": "^(?=#lang[ \\t]+r7rs\\b)",
      "end": "(?!)",
      "patterns": [
        {
          "include": "#lang-directive"
        },
        {
          "include": "#scheme-block-comment"
        },
        {
          "include": "#scheme-datum-comment"
        },
        {
          "include": "#scheme-bar-symbol"
        },
        {
          "include": "#scheme-char"
        },
        {
          "include": "#scheme-boolean"
        },
        {
          "include": "#scheme-number"
        },
        {
          "include": "#scheme-vector"
        },
        {
          "include": "#scheme-special-form"
        },
        {
          "include": "#inline-c"
        },
        {
          "include": "#doc-comment"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#char"
        },
        {
          "include": "#definition"
        },
        {
          "include": "#special-form"
        },
        {
          "include": "#else-clause"
        },
        {
          "include": "#dispatch"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#effect-row"
        },
        {
          "include": "#param-attribute"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#number"
        },
        {
          "include": "#keyword-literal"
        }
      ]
    },
    "scheme-block-comment": {
      "begin": "#\\|",
      "end": "\\|#",
      "name": "comment.block.scheme.turmeric",
      "patterns": [
        {
          "include": "#scheme-block-comment"
        }
      ]
    },
    "scheme-datum-comment": {
      "match": "#;",
      "name": "comment.datum.scheme.turmeric"
    },
    "scheme-bar-symbol": {
      "begin": "\\|",
      "end": "\\|",
      "name": "variable.other.symbol.scheme.turmeric",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.turmeric"
        }
      ]
    },
    "scheme-char": {
      "match": "#\\\\(?:x[0-9a-fA-F]+|alarm|backspace|delete|escape|newline|null|return|space|tab|.)",
      "name": "constant.character.scheme.turmeric"
    },
    "scheme-boolean": {
      "match": "#(?:true|false|t|f)(?![A-Za-z0-9_/!?<>=*+-])",
      "name": "constant.language.boolean.scheme.turmeric"
    },
    "scheme-number": {
      "match": "#[eEiIxXbBoOdD](?:#[eEiIxXbBoOdD])?[-+]?[0-9a-fA-F.]+(?:[eE][-+]?[0-9]+)?",
      "name": "constant.numeric.scheme.turmeric"
    },
    "scheme-vector": {
      "match": "#(?:u8)?(?=\\()",
      "name": "keyword.operator.vector.scheme.turmeric"
    },
    "scheme-special-form": {
      "match": "(?<=\\()(define-library|define-syntax|define-record-type|define-values|let-syntax|letrec-syntax|syntax-rules|syntax-error|let\\*-values|let-values|letrec\\*|let\\*|begin|delay-force|delay|make-promise|guard|parameterize|case-lambda|cond-expand|include-ci|include|dynamic-wind|call-with-current-continuation|with-exception-handler|raise-continuable|raise|error)(?![A-Za-z0-9_/!?<>=*+-])",
      "name": "keyword.control.scheme.turmeric"
    }
  }
}
