{
  "name": "turmeric-syntax",
  "displayName": "Turmeric Syntax Highlighting",
  "description": "Syntax highlighting for Turmeric (.tur) files with sweet-exp support",
  "version": "0.2.0",
  "publisher": "fith-lang",
  "license": "MIT",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.82.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "activationEvents": [
    "onLanguage:turmeric",
    "onDebugResolve:turmeric",
    "onDebugDynamicConfigurations:turmeric"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers"
  ],
  "keywords": [
    "turmeric",
    "tur",
    "lisp",
    "scheme",
    "sweet-exp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "turmeric.serverPath"
      ],
      "description": "turmeric.serverPath names the executable started as the language server, and a launch configuration's `tur` names the debug adapter executable. In an untrusted workspace the folder's own serverPath is ignored and your user setting is used, so a repository cannot redirect the server to another binary by shipping a .vscode/settings.json; starting a debug session means trusting the repository, because the adapter path comes from its launch configuration. Syntax highlighting, formatting and breakpoint registration are declarative and safe in an untrusted workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "turmeric.formatDocument",
        "title": "Format Turmeric Document"
      }
    ],
    "languages": [
      {
        "id": "turmeric",
        "aliases": [
          "Turmeric",
          "turmeric"
        ],
        "extensions": [
          ".tur",
          ".tur.sweet"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "turmeric"
      }
    ],
    "debuggers": [
      {
        "type": "turmeric",
        "label": "Turmeric (interpreter)",
        "languages": [
          "turmeric"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .tur file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the program (visible as *args*).",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first executable node.",
                "default": true
              },
              "tur": {
                "type": "string",
                "description": "Path to the tur binary (defaults to 'tur' on PATH).",
                "default": "tur"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "turmeric",
            "request": "launch",
            "name": "Debug current Turmeric file",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Turmeric: Launch current file",
            "description": "Debug the active .tur file under the interpreter",
            "body": {
              "type": "turmeric",
              "request": "launch",
              "name": "Debug ${1:current} Turmeric file",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      },
      {
        "type": "lldb",
        "label": "Turmeric Native (CodeLLDB)",
        "configurationSnippets": [
          {
            "label": "Turmeric: Debug Native (CodeLLDB)",
            "description": "Debug a compiled Turmeric binary using CodeLLDB with pretty-printers",
            "body": {
              "type": "lldb",
              "request": "launch",
              "name": "Debug Turmeric Native (CodeLLDB)",
              "program": "^\"\\${workspaceFolder}/build/\\${fileBasenameNoExtension}\"",
              "initCommands": [
                "command script import ^\"\\${workspaceFolder}/tools/debug/turmeric_lldb.py\""
              ]
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Turmeric",
      "properties": {
        "turmeric.serverPath": {
          "type": "string",
          "default": "tur",
          "description": "Path to the tur executable used for the language server."
        }
      }
    },
    "grammars": [
      {
        "language": "turmeric",
        "scopeName": "source.turmeric",
        "path": "./syntaxes/turmeric.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.c": "c"
        }
      },
      {
        "scopeName": "markdown.embedding.turmeric",
        "path": "./syntaxes/turmeric.markdown-injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.turmeric": "turmeric"
        }
      }
    ],
    "themes": [
      {
        "label": "Turmeric Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/turmeric-dark-color-theme.json"
      },
      {
        "label": "Turmeric Light",
        "uiTheme": "vs",
        "path": "./themes/turmeric-light-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fith-lang/fith"
  },
  "bugs": {
    "url": "https://github.com/fith-lang/fith/issues"
  },
  "homepage": "https://github.com/fith-lang/fith#readme"
}
