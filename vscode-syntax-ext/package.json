{
  "name": "turmeric-syntax",
  "displayName": "Turmeric Syntax Highlighting",
  "description": "Syntax highlighting for Turmeric (.tur) files with sweet-exp support",
  "version": "0.2.0",
  "publisher": "fith-lang",
  "license": "MIT",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.82.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "activationEvents": [
    "onLanguage:turmeric"
  ],
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "turmeric",
    "tur",
    "lisp",
    "scheme",
    "sweet-exp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "turmeric.serverPath"
      ],
      "description": "turmeric.serverPath names the executable started as the language server. In an untrusted workspace the folder's own value is ignored and your user setting is used, so a repository cannot redirect the server to another binary by shipping a .vscode/settings.json. Syntax highlighting and formatting are unaffected."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "turmeric.formatDocument",
        "title": "Format Turmeric Document"
      }
    ],
    "languages": [
      {
        "id": "turmeric",
        "aliases": [
          "Turmeric",
          "turmeric"
        ],
        "extensions": [
          ".tur"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Turmeric",
      "properties": {
        "turmeric.serverPath": {
          "type": "string",
          "default": "tur",
          "description": "Path to the tur executable used for the language server."
        }
      }
    },
    "grammars": [
      {
        "language": "turmeric",
        "scopeName": "source.turmeric",
        "path": "./syntaxes/turmeric.tmLanguage.json"
      },
      {
        "scopeName": "markdown.embedding.turmeric",
        "path": "./syntaxes/turmeric.markdown-injection.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.turmeric": "turmeric"
        }
      }
    ],
    "themes": [
      {
        "label": "Turmeric Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/turmeric-dark-color-theme.json"
      },
      {
        "label": "Turmeric Light",
        "uiTheme": "vs",
        "path": "./themes/turmeric-light-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fith-lang/fith"
  },
  "bugs": {
    "url": "https://github.com/fith-lang/fith/issues"
  },
  "homepage": "https://github.com/fith-lang/fith#readme"
}
